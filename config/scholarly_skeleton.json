{
  "version": "optomind.scholarly_skeleton.v0",
  "note": "所有阈值集中在此，代码中不得散落硬编码。",
  "edge_collection": {
    "references_limit_per_paper": 300,
    "citations_limit_per_paper": 300,
    "provider": "semantic_scholar",
    "max_workers": 12
  },
  "boundary_admission": {
    "min_core_papers_referencing_it": 2,
    "min_core_papers_it_references": 2,
    "admit_if_in_snippet_ref_mentions": true,
    "admit_if_frontier_recent": true,
    "frontier_recent_year_offset": 2,
    "max_boundary_papers": 4000,
    "min_field_share": 0.01,
    "min_object_relatedness": 1
  },
  "layers": {
    "bibliographic_coupling_min_shared": 2,
    "co_citation_min_count": 2,
    "contextual_min_mentions": 1,
    "max_pair_fanout": 60,
    "bibliographic_coupling_min_weight": 1
  },
  "fusion": {
    "layer_weights": {
      "citation": 1,
      "bibliographic_coupling": 0.7,
      "co_citation": 0.7,
      "contextual_reference": 1.2,
      "retrieval": 0.8
    },
    "normalisation": "per_layer_max"
  },
  "communities": {
    "algorithm": "leiden",
    "seeds": [
      1,
      7,
      13,
      29,
      42,
      77,
      101,
      202
    ],
    "resolutions": [
      0.6,
      0.8,
      1,
      1.2,
      1.5
    ],
    "stability_pairs_sample": 200000
  },
  "temporal": {
    "current_year": 2026,
    "frontier_max_age": 3
  },
  "roles": {
    "top_n_per_role_per_facet": 10,
    "min_role_score_percentile": 0.6,
    "role_weights": {
      "direct_evidence": {
        "query_coverage": 0.45,
        "rrf_percentile": 0.4,
        "topical_fit": 0.15
      },
      "foundational": {
        "earliness": 0.3,
        "reference_consensus": 0.3,
        "pagerank": 0.25,
        "coreness": 0.15
      },
      "landmark": {
        "pagerank": 0.35,
        "local_in_degree": 0.3,
        "growth": 0.2,
        "cross_community": 0.15
      },
      "bridge_breakthrough": {
        "betweenness": 0.35,
        "participation": 0.35,
        "bridge_communities": 0.15,
        "emergence": 0.15
      },
      "frontier": {
        "recency": 0.35,
        "citation_velocity": 0.3,
        "age_normalized_impact": 0.2,
        "community_growth": 0.15
      },
      "community_representative": {
        "within_module_z": 0.6,
        "local_pagerank": 0.4
      },
      "review_synthesis": {
        "is_review": 0.4,
        "community_breadth": 0.25,
        "citation_breadth": 0.2,
        "facet_relevance": 0.15
      },
      "context_gateway": {
        "contextual_consensus": 0.45,
        "distinct_sources": 0.3,
        "distinct_queries": 0.25
      },
      "cross_facet_connector": {
        "cross_facet_bridge": 0.6,
        "cross_facet_count": 0.4
      },
      "emerging_niche": {
        "community_smallness": 0.25,
        "community_growth": 0.35,
        "recency": 0.25,
        "low_lifetime_citation": 0.15
      }
    }
  },
  "portfolio": {
    "target_size": 30,
    "size_range": [
      20,
      40
    ],
    "greedy_lambda_redundancy": 0.45,
    "coverage_weights": {
      "facet": 0.2,
      "query": 0.12,
      "community": 0.3,
      "roleany": 0.15,
      "role@facet": 0.1,
      "year": 0.05,
      "contextual": 0.12,
      "domain": 0.08,
      "tier": 0.03,
      "novelty": 0.35,
      "default": 0.03
    },
    "paper_value_weight": 0.35,
    "saturation_scales": {
      "facet": 3.0,
      "query": 1.0,
      "community": 8.0,
      "roleany": 5.0,
      "role@facet": 2.0,
      "year": 1.0,
      "contextual": 2.0,
      "domain": 3.0,
      "tier": 2.0
    },
    "domain_class_weight": {
      "IN_DOMAIN": 1.0,
      "ADJACENT": 0.45,
      "UNCERTAIN": 0.2
    },
    "semantic_cluster_count": 40,
    "semantic_cluster_scale": 3.0
  },
  "domain_relevance": {
    "prototype_seed_papers": 12,
    "prototype_requires_snippet": true,
    "vocabulary_seed_papers": 30,
    "vocabulary_min_count": 3,
    "semantic_high": 0.55,
    "semantic_low": 0.28,
    "vocabulary_high": 1.2,
    "vocabulary_low": 0.15,
    "off_topic_max_semantic": 0.22,
    "generic_tool_max_field_share": 0.02,
    "generic_tool_min_citations": 800,
    "semantic_high_percentile": 0.7,
    "semantic_low_percentile": 0.25,
    "vocabulary_high_percentile": 0.85,
    "vocabulary_low_percentile": 0.25,
    "off_topic_max_semantic_percentile": 0.2,
    "vocabulary_max_ngram": 3,
    "vocabulary_top_n": 30,
    "strong_field_share": 0.05,
    "min_core_papers_citing": 2,
    "signals_required_with_semantic": 1,
    "contextual_rescue_min_sources": 2,
    "retrieval_strong_threshold": 0.25
  },
  "pools": {
    "eligible_classes": [
      "IN_DOMAIN",
      "ADJACENT",
      "UNCERTAIN"
    ],
    "note": "GENERIC_TOOL and OFF_TOPIC stay in the graph support pool but not in the eligible pool.",
    "portfolio_stopping": {
      "min_marginal_gain": 0.02,
      "stop_gain_fraction_of_first": 0.15,
      "priority_gain_fraction_of_first": 0.35,
      "max_size": 400,
      "min_size": 8
    },
    "must_cover_communities": true,
    "seed_community_representatives": true,
    "priority_classes": [
      "IN_DOMAIN"
    ]
  }
}