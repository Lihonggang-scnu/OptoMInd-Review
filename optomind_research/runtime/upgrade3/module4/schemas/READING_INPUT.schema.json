{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optomind.module4.reading_input.v1",
  "title": "OptoMind Module 4 Reading Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_run_id", "paper_identity", "research_question", "facets", "global_constraints", "navigation_context", "document_manifest_ref", "document_snapshot_ref", "upstream_snapshot_refs", "reading_policy", "runtime_profile_ref", "output_preferences", "extensions", "input_fingerprint"],
  "properties": {
    "schema_version": {"const": "optomind.module4.reading_input.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "project_run_id": {"type": "string"},
    "paper_identity": {"type": "object", "required": ["canonical_paper_id"], "properties": {"canonical_paper_id": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "research_question": {"type": "object", "required": ["original_text"], "properties": {"original_text": {"type": "string", "minLength": 1}, "question_en": {}, "source_ref": {}}, "additionalProperties": true},
    "facets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["facet_id", "ask_original"], "properties": {"facet_id": {"type": "string", "minLength": 1}, "ask_original": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "global_constraints": {"type": "object"},
    "navigation_context": {"type": "object"},
    "document_manifest_ref": {"type": "object", "required": ["snapshot_id", "sha256"], "properties": {"snapshot_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "document_snapshot_ref": {"type": "object", "required": ["snapshot_id", "manifest_sha256"], "properties": {"snapshot_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "upstream_snapshot_refs": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "reading_policy": {"type": "object", "required": ["scope"], "properties": {"scope": {"type": "string"}}, "additionalProperties": true},
    "runtime_profile_ref": {"type": "object"},
    "output_preferences": {"type": "object"},
    "extensions": {"type": "object"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
