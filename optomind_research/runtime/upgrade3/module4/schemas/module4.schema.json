{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optomind.module4.contracts.v1",
  "title": "OptoMind Module 4 contract index",
  "description": "The three standalone schemas in this directory are the authoritative JSON contracts. Document snapshots remain immutable and are referenced by snapshot_id plus manifest hash.",
  "type": "object",
  "required": ["reading_input_schema", "dossier_schema", "feedback_schema", "document_snapshot_constraints"],
  "properties": {
    "reading_input_schema": {"const": "READING_INPUT.schema.json"},
    "dossier_schema": {"const": "PAPER_READING_DOSSIER.schema.json"},
    "feedback_schema": {"const": "SKELETON_FEEDBACK.schema.json"},
    "document_snapshot_constraints": {"type": "object", "required": ["immutable", "manifest_sha256", "block_text_coordinate_space", "source_anchor_policy"], "properties": {"immutable": {"const": true}, "manifest_sha256": {"type": "string"}, "block_text_coordinate_space": {"const": "text_normalized exact Unicode code points [start,end)"}, "source_anchor_policy": {"const": "program_owned_exact_quote_resolution"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
