\",\n      \"source_id\": \"source::P0270\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531\",\n        \"record::153a59be1d09157a4ef3f70816efa0c7f6788de60095c609bebda9e7b57a3c59\"\n      ],\n      \"chapter_ids\": [\n        \"Ch1\",\n        \"Ch2\"\n      ],\n      \"title\": \"Composition of gastrointestinal microbiota in association with treatment response in individuals with metastatic castrate resistant prostate cancer progressing on enzalutamide and initiating treatment with anti-PD-1 (pembrolizumab)\",\n      \"doi\": \"10.1016/j.neo.2022.100822\",\n      \"paper_id\": \"74786f8df0c7648840756833a4b4bc49ace34be6\"\n    },\n    \"P0393\": {\n      \"source_handle\": \"P0393\",\n      \"source_id\": \"source::P0393\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"record::3cdad2d48d4bf97ae9b840521b9daee5693ee31da53ab53a98c9725795cc021b\"\n      ],\n      \"chapter_ids\": [\n        \"Ch1\"\n      ],\n      \"title\": \"Multi-Kingdom Gut Microbiome Interaction Characteristics Predict Immune Checkpoint Inhibitor Efficacy Across Pan-Cancer Cohorts\",\n      \"doi\": \"10.3390/microorganisms13112595\",\n      \"paper_id\": \"a9e58de949ced186b4882146c14b79b306ae9ef5\"\n    },\n    \"P0565\": {\n      \"source_handle\": \"P0565\",\n      \"source_id\": \"source::P0565\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"record::08de776306040abe73aecd87d2fabdbd99227dd11a0c0b0866dc9fe657088a28\",\n        \"record::31f74040652c3a10bffa6be1ae51e3b3753dde2c941d62f4e374dfa95a684d6c\"\n      ],\n      \"chapter_ids\": [\n        \"Ch1\",\n        \"Ch7\"\n      ],\n      \"title\": \"Gut Microbiome Composition and Response to Immune Checkpoint Inhibitors in Melanoma: A Systematic Review\",\n      \"doi\": \"10.7759/cureus.113248\",\n      \"paper_id\": \"f9a9ef8d406ee51983cd285f9e60fc41574ae937\"\n    },\n    \"P0545\": {\n      \"source_handle\": \"P0545\",\n      \"source_id\": \"source::P0545\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"record::1bb80f168552ffb9a6448494df1485fd1e32c886ba6c242a17b324b2dd9e89a7\",\n        \"record::f8979429b0413510bd6a75a462efc3524c95b7d8a8eef31dbe5f5d84300106c4\"\n      ],\n      \"chapter_ids\": [\n        \"Ch1\",\n        \"Ch7\"\n      ],\n      \"title\": \"A Clinical Outcome of the Anti-PD-1 Therapy of Melanoma in Polish Patients Is Mediated by Population-Specific Gut Microbiome Composition\",\n      \"doi\": \"10.3390/cancers14215369\",\n      \"paper_id\": \"f31246cd559d1a06b99a32b0ee47bb1ce0265772\"\n    },\n    \"P0478\": {\n      \"source_handle\": \"P0478\",\n      \"source_id\": \"source::P0478\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144\",\n        \"record::6cbf5c2e297396b264657b8ee9f3b0d7563b927fc99a785abd805b74c3b66cd1\"\n      ],\n      \"chapter_ids\": [\n        \"Ch1\",\n        \"Ch7\"\n      ],\n      \"title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\",\n      \"doi\": \"10.1038/s41591-022-01695-5\",\n      \"paper_id\": \"d4c18d58cffce0cab6831c84535e02c608d4db49\"\n    },\n    \"P0170\": {\n      \"source_handle\": \"P0170\",\n      \"source_id\": \"source::P0170\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"record::f43e442780a4b5a132af9350ba6631299cdb484f88c84a7f17cea3f912a9657a\"\n      ],\n      \"chapter_ids\": [\n        \"Ch1\"\n      ],\n      \"title\": \"Enterotype-specific microbial biomarkers of immune checkpoint inhibitor response revealed by large-scale integrated metagenomic analysis\",\n      \"doi\": \"10.1007/s00262-026-04432-w\",\n      \"paper_id\": \"4a1e10851c0bf838d11646a65bc0ee57b10b940a\"\n    },\n    \"P0289\": {\n      \"source_handle\": \"P0289\",\n      \"source_id\": \"source::P0289\",\n      \"aliases\": [],\n      \"record_ids\": [\n        \"rec