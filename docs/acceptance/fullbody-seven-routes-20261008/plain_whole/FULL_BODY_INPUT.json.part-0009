    "Ch3::U3_2::U3_2_P03": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_2::U3_2_P03",
      "original_task_id": "U3_2_P03",
      "unit_id": "U3_2",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_2_P03",
        "point": "区分肌苷的肿瘤内在作用（UBA6 抑制）与 T 细胞外在作用（A2AR 激活/碳源补充）。",
        "development": "结合 P0124 与 P0584，对比肌苷在肿瘤细胞内直接抑制 UBA6 与在 T 细胞内通过 A2AR/cAMP 通路或替代糖酵解途径发挥作用的平行机制，避免机制混淆。",
        "source_uses": [
          {
            "source_handle": "P0124",
            "role": "主论据",
            "use": "阐释双歧杆菌来源肌苷经 A2AR/cAMP 通路促进 Th1 分化及作为替代碳源维持效应 T 细胞存活"
          },
          {
            "source_handle": "P0251",
            "role": "比较",
            "use": "对比生态与还原论方法，明确双歧杆菌通过肌苷-A2AR 轴增强 T 细胞活性的分子路径"
          },
          {
            "source_handle": "P0584",
            "role": "背景",
            "use": "提供腺苷脱氨酶将免疫抑制性腺苷转化为肌苷的药代动力学数据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_2_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_2_P03",
            "unit_id": "U3_2",
            "ordinal": 3,
            "point": "区分肌苷的肿瘤内在作用（UBA6 抑制）与 T 细胞外在作用（A2AR 激活/碳源补充）。",
            "development": "结合 P0124 与 P0584，对比肌苷在肿瘤细胞内直接抑制 UBA6 与在 T 细胞内通过 A2AR/cAMP 通路或替代糖酵解途径发挥作用的平行机制，避免机制混淆。",
            "source_handles": [
              "P0124",
              "P0251",
