            "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\04d758358071fe0987733466b05a84fae0fcde9f\\49f9c0284a7b62f92e8abf52fe383e6c\\attempt-01\\PAPER_READING_CARD.json"
