        {
          "source_handle": "P0367",
          "title": "Coupling culturomics and metagenomics sequencing to characterize the gut microbiome of patients with cancer treated with immune checkpoint inhibitors",
          "year": "2025",
          "doi": "10.1186/s13099-025-00694-4",
          "paper_id": "9e9bf2bb52117d8548594524043c72e02b8754d7",
          "material_depth": "",
          "material_status": "no_material",
          "aliases": [],
          "locator": {
            "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch7.json",
            "source_handle": "P0367",
            "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\9e9bf2bb52117d8548594524043c72e02b8754d7\\20c57122dfe91ae8d27ff6eefe070cef\\attempt-01\\PAPER_READING_CARD.json"
          },
          "study_summary_A": {
            "approach": "研究设计采用横断面比较分析。首先，从22名接受ICI治疗的NSCLC和黑色素瘤患者及7名健康志愿者中收集粪便样本。其次，使用高通量培养组学技术（包括直接接种和富集培养，结合MALDI-TOF MS鉴定）分离细菌。同时，对部分NSCLC患者样本进行鸟枪法宏基因组测序。最后，通过统计检验（如Mann-Whitney检验、PERMANOVA、Chi-squared检验等）比较各组间的微生物组成、多样性和特定物种的富集情况，并分析培养组学与宏基因组结果的重叠与差异。",
            "contribution_and_limits": [
              {
                "contribution": "提供了癌症患者与健康人之间肠道微生物组成的具体差异图谱，特别是通过培养组学验证了特定菌属（如Bifidobacterium, Bacteroides）在健康状态下的富集，以及Enterocloster等在癌症中的富集。",
                "limits": "所给摘要未交代具体的机制验证实验，仅基于观察性数据提出假设。"
              },
              {
                "contribution": "证实了培养组学与宏基因组测序在表征肠道微生物组时的互补性，指出了宏基因组可能遗漏的特定物种。",
                "limits": "样本量较小（N=22患者，N=7健康对照），统计效力有限，可能导致校正后的p值不显著。"
