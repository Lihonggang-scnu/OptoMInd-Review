    "Ch3::U3_3::U3_3_P02": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_3::U3_3_P02",
      "original_task_id": "U3_3_P02",
      "unit_id": "U3_3",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_3_P02",
        "point": "解析色氨酸代谢物（IPA, Kynurenine）通过 AhR 与 RORγt 受体调控 T 细胞亚群分化与骨髓细胞极化的路径。",
        "development": "基于 P0180 与 P0209，对比保护性吲哚衍生物（激活 AhR 维持 T 细胞干性）与致病性犬尿氨酸（抑制 T 细胞/促进 Treg）的双向调节作用。",
        "source_uses": [
          {
            "source_handle": "P0180",
            "role": "主论据",
            "use": "揭示次级胆汁酸结合非经典核受体 RORγt 与 NR4A1，精细调控 Th17/Treg 平衡的分子细节"
          },
          {
            "source_handle": "P0209",
            "role": "主论据",

