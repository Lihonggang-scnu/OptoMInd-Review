          }
        ],
        "facet_contributions": [
          {
            "boundaries": "主要基于CRC背景，其他实体瘤的数据较少；多为观察性关联或小样本研究，因果链条需结合其他实证研究确认。",
            "contribution": "提供了微生物组影响ICI疗效的具体临床关联和现象描述。指出高丰度的Fn与抗PD-1耐药相关，而B. fragilis和多糖类物质可增强免疫治疗响应。",
            "facet_id": "F1",
            "possible_uses": "用于综述中关于“微生物组成如何预测或改变ICI疗效”的部分，提供具体的正反例证（Fn vs B. fragilis）。"
          },
          {
            "boundaries": "许多机制细节来自小鼠模型（如MC38, AOM/DSS），在人体内的适用性存在不确定性；部分机制（如AhR）涉及复杂的转录调控，需结合其他研究验证其在人类患者中的普遍性。",
            "contribution": "详细阐述了介导微生物-IICI互作的分子机制。包括：1) Fn通过抑制cGAS-IFN-β通路减少CD8+ T细胞浸润；2) NaB通过HDAC抑制调节Treg/Th17平衡；3) IDO1-Kyn-AhR轴调节T细胞分化；4) 工程菌分泌细胞因子（IL-15, FLT3L）直接激活免疫细胞。",
            "facet_id": "F2",
            "possible_uses": "用于解释“机制”部分，具体说明微生物代谢物和抗原如何物理性地改变肿瘤微环境的免疫状态，从而影响ICI的药物效应。"
          },
          {
            "boundaries": "大部分干预数据来自临床前研究或早期II期试验，缺乏III期确证性数据；供体选择和标准化问题尚未解决。",
            "contribution": "提出了基于微生物的干预策略（如抗生素清除Fn、FMT、工程菌）作为克服ICI耐药的潜在手段。",
            "facet_id": "F1",
