      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\da741d94b4d509b96c9490a118677edf3d1417a7\\4ab9d9e02ebf1376682b52cd6cfc5c1d\\attempt-01\\PAPER_READING_CARD.json"
