          {
            "boundaries": "许多机制细节主要基于动物模型或体外研究，在人体内的确切效力和剂量依赖性尚需验证；部分代谢物（如肌苷）的作用具有情境依赖性。",
            "contribution": "详细阐述了微生物群调节抗肿瘤免疫的具体分子和细胞机制。包括：1) 代谢物（SCFAs, Inosine, Tryptophan derivatives）对T细胞功能的重编程；2) PRR信号通路（TLR/NOD）对DC成熟和抗原呈递的增强；3) 肠-肺轴介导的远端器官免疫调节。",
            "facet_id": "F2",
            "possible_uses": "直接用于回答“哪些机制介导了该效应”，提供从微生物代谢产物到宿主免疫细胞信号转导的详细路径描述。"
          },
          {
            "boundaries": "机制多为推测性或基于间接证据，直接证明特定微生物导致特定irAEs的人类数据有限。",
            "contribution": "提供了微生物群介导ICI毒性（irAEs）的机制解释，特别是结肠炎和肺炎。指出 dysbiosis 通过破坏屏障、改变代谢物和调节Th17/Treg平衡导致系统性炎症。",
            "facet_id": "F1",
            "possible_uses": "用于解释为何微生物群不仅影响疗效，还影响安全性，为综述中讨论“疗效-毒性权衡”提供素材。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "背景与转化前景",
            "material": "讨论了FMT作为挽救疗法的短期有效性与长期不确定性，对比了UC和CDI的复发率以推断ICI相关结肠炎的预后。",
            "purpose": "用于综述中讨论微生物群干预的临床转化挑战，特别是FMT的标准化问题和长期随访数据的缺失。"
          },
          {
            "connection_to_review": "领域局限性与未来方向",
            "material": "指出当前研究在样本采集、测序和分析方法上的不标准化限制了可重复性，呼吁多中心长期队列和AI辅助的多组学研究。",
            "purpose": "用于综述的讨论部分，强调当前证据等级的局限性，并提示未来研究需要解决的技术和方法学瓶颈。"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述主要关注固体肿瘤，虽然提及了黑色素瘤和非小细胞肺癌，但不一定涵盖血液肿瘤或所有实体瘤亚型。",
          "对于Bacteroides的作用，文中明确指出证据不一致，需谨慎解读，避免将其简单归类为“有益”或“有害”，应强调菌株特异性和情境依赖性。",
          "FMT的数据主要来自病例报告和小型系列研究，证据等级较低，不能代表标准护理方案，仅作为探索性治疗手段讨论。",
          "机制部分大量引用动物模型数据，在应用于人类临床解释时需注意种属差异和体内环境的复杂性。"
        ],
        "topic_handles": [
