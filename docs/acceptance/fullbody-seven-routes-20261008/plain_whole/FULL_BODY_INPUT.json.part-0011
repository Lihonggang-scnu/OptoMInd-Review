        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\b7d5f0bd4b9b2ff5ccb0fca4182d84c2111a7fdf\\84819ef96c228c12e35b772e57656dfc\\attempt-01\\PAPER_READING_CARD.json"
