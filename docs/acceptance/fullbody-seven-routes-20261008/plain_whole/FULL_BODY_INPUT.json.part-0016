      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\b68d0c2836362527000931b8f1fefbb2a4f2dd3b\\13fe85fee68ba8bc87a352b7cff74693\\attempt-01\\PAPER_READING_CARD.json"
