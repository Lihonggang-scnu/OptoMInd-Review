      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\d9c8811c9fe1a30956b5b250c0de876c0e270551\\fa70e709e6785a92a457c285e571602a\\attempt-01\\PAPER_READING_CARD.json"
