      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\progressive_review_plan\\20260926_adaptive_retrieval\\03_external_closure\\runs\\case_E_phase3_rct\\source_units\\SU01_search_candidate_dcbe39b3d2\\card\\PAPER_READING_CARD.json"
