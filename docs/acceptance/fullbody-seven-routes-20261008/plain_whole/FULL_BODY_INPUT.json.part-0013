    {
      "source_handle": "P0061",
      "title": "Abstract A28: Concomitant use of antibiotics and immune checkpoint inhibitors in patients with solid neoplasms: Retrospective data from real-world settings",
      "year": "2020",
      "doi": "10.1158/1538-7445.mvc2020-a28",
      "paper_id": "1802c54fde7426f92c3e5e6d085590592e3f2f66",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "这是一项回顾性审计研究。数据来源为前瞻性收集的患者数据库。纳入标准为在指定时间段内接受CPI治疗的晚期实体瘤患者。暴露变量为抗生素的使用情况（记录CPI前两周及同期使用的抗生素）。主要结局指标为中位PFS和中位OS。统计分析使用SPSS软件进行，包括生存分析和比较两组间的差异。",
        "contribution_and_limits": [
          {
            "contribution": "提供了来自印度单一中心真实世界环境中，抗生素与CPI联用对晚期实体瘤患者生存影响的初步数据，特别是揭示了抗生素使用时长与OS之间的关联。",
            "limits": "所给摘要未交代具体的统计调整方法（如是否校正了基线特征、肿瘤类型、CPI种类等混杂因素）；样本量较小（N=155）；单中心回顾性设计可能存在选择偏倚；PFS结果不显著，仅OS显示趋势或亚组显著；无法直接推断因果关系，仅能提示关联。"
          }
        ],
        "key_findings": [
          {
            "conditions": "总体队列对比：抗生素使用组 vs. 非使用组",
            "finding": "中位PFS在抗生素组为1.7个月（95% CI: 1.1-2.3），非抗生素组为3.6个月（95% CI: 2.3-4.8），差异无统计学意义（p=0.912）。"
          },
          {
            "conditions": "总体队列对比：抗生素使用组 vs. 非使用组",
            "finding": "中位OS在抗生素组为3.9个月（95% CI: 1.8-11.4），非抗生素组为9.2个月（95% CI: 4.2-12.3），呈现显著性趋势（p=0.053，HR-1.023; 95%CI: 1.00-1.04）。"
          },
          {
            "conditions": "抗生素使用时长亚组分析：≤10天 vs. >10天",
            "finding": "在抗生素使用者中，使用≤10天的患者中位OS为8.8个月（95% CI: 4.2-11.2），而使用>10天的患者中位OS仅为2.8个月（95% CI: 1.2-4.4），差异具有统计学意义（p=0.025，HR 2.0, 95% CI: 1.1-3.7）。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "已知抗生素会改变肠道微生物群，假设其也可能改变对CPI的反应。由于来自真实世界环境的数据有限，本研究试图回答：在真实世界临床实践中，伴随使用抗生素是否影响CPI在晚期实体瘤患者中的疗效？",
        "research_scope": "印度孟买Tata纪念医院接受免疫检查点抑制剂（CPI）治疗的晚期实体瘤患者；回顾性审计前瞻性收集的数据库；抗生素使用记录涵盖CPI开始前两周及治疗期间。",
        "work_summary": "本研究旨在探讨在真实世界背景下，抗生素与免疫检查点抑制剂（CPI）的联合使用对晚期实体瘤患者疗效的影响。研究基于2015年8月至2018年11月间在印度孟买Tata纪念医院接受CPI治疗的患者队列，通过回顾性分析评估抗生素使用对无进展生存期（PFS）和总生存期（OS）的影响。研究发现，虽然总体抗生素使用组与非使用组的PFS无显著差异，但OS存在显著趋势，且抗生素使用时长与OS密切相关，提示需谨慎使用抗生素。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于抗生素使用（特别是使用时长）如何影响实体瘤患者免疫检查点抑制剂（CPI）疗效的真实世界观察数据。它直接关联到“肠道微生物群”作为潜在中介机制的假设，因为抗生素是破坏微生物群的主要干预手段。对于综述而言，这篇材料的关键价值在于区分了“任何抗生素使用”与“长期/高强度抗生素使用”对生存结果的差异化影响，为解释微生物群介导的疗效调节提供了临床表型证据。",
        "facet_contributions": [
          {
            "boundaries": "仅限晚期实体瘤患者；单中心数据；回顾性性质；未提供微生物群直接测量数据，仅通过抗生素使用作为代理指标；PFS无显著差异，限制了其对疾病控制能力的全面评价。",
            "contribution": "提供了抗生素使用与CPI疗效关联的临床观察证据。具体发现：总体抗生素使用与OS呈负向趋势（p=0.053）；更关键的是，抗生素使用时长>10天与显著缩短的OS（2.8个月 vs. 8.8个月, p=0.025）相关。",
            "facet_id": "F1",
            "possible_uses": "可用于支持“抗生素使用可能损害CPI疗效”的观点，并细化为“长期使用抗生素的危害更大”。帮助解释为何在某些临床情境下观察到CPI疗效降低，特别是在合并感染需要长期抗菌治疗时。"
          },
          {
            "boundaries": "不能证明因果机制；未检测微生物群组成变化；未排除其他混杂因素（如抗生素使用的指征本身可能与病情严重程度相关）；无法区分不同类别抗生素的影响。",
            "contribution": "间接支持微生物群介导机制的假说。通过展示抗生素（已知破坏微生物群的因素）与较差生存结果的关联，尤其是剂量/时长依赖性效应，为微生物群可能是CPI疗效调节器的理论提供了间接临床支持。",
            "facet_id": "F2",
            "possible_uses": "在讨论机制时，可作为临床相关性证据，说明干扰微生物群（通过抗生素）会对治疗结果产生可测量的负面影响。有助于构建“抗生素->微生物群扰动->CPI疗效下降”的逻辑链条中的临床后果部分。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "背景与临床实践启示",
            "material": "研究结论建议在对CPI治疗或计划开始CPI治疗的患者中谨慎使用抗生素。",
            "purpose": "用于综述中讨论临床管理策略的部分，强调在肿瘤免疫治疗期间避免不必要的抗生素处方的重要性，特别是长期处方。"
          },
          {
            "connection_to_review": "领域现状与数据缺口",
            "material": "摘要指出“来自真实世界环境的数据有限”，本研究填补了这一部分空白，但仅限于印度特定人群。",
            "purpose": "用于综述中描述现有证据的局限性，指出需要更多多中心、前瞻性或包含微生物组测序的研究来验证这些观察结果。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为回顾性观察性研究，发现的关联不等于因果关系。抗生素使用可能与更严重的感染或更晚期的疾病状态相关，从而混淆生存结果。",
          "仅报告了总体队列和按使用时长的亚组分析，未报告按抗生素类别、肿瘤类型或CPI类型的分层分析，限制了结果的泛化性。",
          "PFS结果不显著，仅OS显示趋势或亚组显著，解读时需避免过度强调抗生素对疾病控制的直接影响。",
          "样本量较小，置信区间较宽，结果可能存在偶然性。",
          "所给摘要未交代是否进行了多变量回归分析以校正混杂因素，因此观察到的关联可能受到未测量混杂因素的影响。"
        ],
        "topic_handles": [
          "antibiotic exposure duration (short-term ≤10 days vs. long-term >10 days)",
          "solid tumors treated with immune checkpoint inhibitors (ICIs/CPIs)",
          "overall survival (OS) as an efficacy endpoint",
          "real-world retrospective audit data from a single center in India",
          "gut microbiome modulation hypothesis via antibiotic intervention"
        ]
      },
