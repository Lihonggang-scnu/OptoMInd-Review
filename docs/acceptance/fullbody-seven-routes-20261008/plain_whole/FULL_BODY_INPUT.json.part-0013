    {
      "source_handle": "P0537",
      "title": "Impact of proton pump inhibitors on immunotherapy is modulated by prior chemotherapy and linked to gut microbiome–immune cell signatures",
      "year": "2026",
      "doi": "10.1007/s00262-026-04346-7",
      "paper_id": "ef3aa04c443ab46a0b126661b9aab2a6d8239655",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "研究设计分为两部分： 1. 回顾性生存分析：从电子病历中提取1078名接受ICI治疗的晚期癌症患者数据，手动审查确认PPI使用情况。使用Kaplan-Meier曲线和单变量/多变量Cox比例风险模型评估PPI使用与OS的关联，并按治疗线数、既往化疗状态（有/无）、化疗到ICI的时间间隔（<1年 vs ≥1年）进行分层分析。同时对比H2受体阻滞剂（H2B）的效果。 2. 探索性微生物组与免疫学分析： - 黑色素瘤队列（n=42）：收集基线粪便样本，使用Shannon指数评估Alpha多样性，Bray-Curtis距离和PERMANOVA评估Beta多样性，使用ANCOM-BC2进行差异丰度分析，比较PPI使用者与非使用者的微生物组成。 - NSCLC/RCC队列（n=8）：收集基线及随访期的粪便和血液样本。使用宏基因组全基因组鸟枪法测序分析微生物组；使用CyTOF质谱流式细胞术检测40种循环免疫细胞的丰度。使用Spearman秩相关分析微生物与免疫细胞之间的关联。",
        "contribution_and_limits": [
          {
            "contribution": "提供了大样本回顾性证据，证实PPI使用与ICI治疗后OS缩短相关，并揭示了这一效应受既往化疗及其时间间隔的调节（即近期化疗可能掩盖或抵消PPI的负面影响）。",
            "limits": "回顾性研究存在残余混杂风险；无法确立因果关系。"
          },
          {
            "contribution": "通过前瞻性小样本队列，初步描绘了PPI使用对肠道微生物组组成的具体影响（如乳酸杆菌科和韦荣球菌属富集），并提出了微生物-免疫细胞关联的假设（Enterocloster clostridioformis与CD4 T细胞）。",
            "limits": "前瞻性队列样本量极小（n=42和n=8），统计效力不足，结果仅为假设生成性质，不能确证机制。"
          },
          {
            "contribution": "区分了PPI与H2B的不同效果，提示H2B可能是ICI治疗期间更安全的替代药物。",
            "limits": "H2B使用者数量较少，结论需更大规模验证。"
          }
        ],
        "key_findings": [
          {
            "conditions": "所有癌症类型，无论治疗线数",
            "finding": "PPI使用与较短的OS显著相关（HR 1.39, p < 0.001），在黑色素瘤中效应最强。"
          },
          {
            "conditions": "既往未接受化疗的患者",
            "finding": "PPI使用与较短的OS显著相关（HR 1.57）。"
          },
          {
            "conditions": "既往接受过化疗的患者",
            "finding": "PPI使用与较短的OS相关，但效应较弱（HR 1.20）。"
          },
          {
            "conditions": "化疗结束至ICI开始时间间隔≥1年",
            "finding": "PPI使用与较短的OS显著相关（HR 1.79）。"
          },
          {
            "conditions": "化疗结束至ICI开始时间间隔<1年",
            "finding": "PPI使用与OS无显著关联（HR 1.09, p = 0.36）。"
          },
          {
            "conditions": "调整协变量后",
            "finding": "控制癌症分期和CCI后，PPI的风险增加依然显著；但控制抗生素使用后，显著性丧失。H2B在各模型中均不显著。"
          },
          {
            "conditions": "黑色素瘤队列（n=42）",
            "finding": "PPI使用者与非使用者在Alpha/Beta多样性上无显著差异，但特定菌属丰度不同：PPI使用者乳酸杆菌科（Lactobacillaceae）和韦荣球菌属（Veillonella）相对丰度较高，而非使用者梭菌科（Clostridiaceae）和拟杆菌属（Bacteroides）较多，且部分双歧杆菌仅在非使用者中发现。"
          },
          {
            "conditions": "NSCLC/RCC小样本队列（n=8）",
            "finding": "PPI使用者与非使用者在主要免疫细胞亚群丰度上无显著差异。发现Enterocloster clostridioformis的相对丰度与终末效应CD4 T细胞的丰度呈显著正相关。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "动机在于尽管ICI改善了癌症患者的OS，但仅不到40%的患者获得持久临床获益，且已知肠道微生物组影响ICI反应。PPI作为广泛使用的药物，已知会改变微生物组，但其对ICI疗效的具体影响、作用机制以及与其它治疗（如化疗、抗生素）的交互作用尚不明确。本研究试图回答：PPI使用是否影响ICI疗效？如果是，这种影响是否与微生物组或免疫细胞的变化有关？",
        "research_scope": "研究对象为接受免疫检查点抑制剂（ICI）治疗的晚期实体瘤患者。研究情境包括三个队列：1）回顾性大样本队列（n=1078，涵盖多种癌症类型，主要为非小细胞肺癌和黑色素瘤），用于评估质子泵抑制剂（PPI）使用与总生存期（OS）的关系；2）前瞻性黑色素瘤队列（n=42），用于分析PPI对肠道微生物组的影响；3）前瞻性非小细胞肺癌（NSCLC）和肾细胞癌（RCC）队列（n=8），用于探索PPI相关的微生物变化与循环免疫细胞组成的关联。",
        "work_summary": "本研究旨在确定PPI使用是否与接受ICI治疗的晚期癌症患者总生存期缩短相关，并探讨这种关联是否由改变的微生物组和免疫细胞组成介导。研究首先通过回顾性数据分析PPI使用对OS的影响，并分层考察治疗线数、既往化疗及用药时机。随后，利用两个前瞻性小样本队列，结合宏基因组测序和CyTOF技术，探索PPI使用者与非使用者在微生物组多样性、特定菌属丰度以及外周血免疫细胞亚群上的差异及相关性。研究发现PPI使用总体与OS缩短相关，但在近期接受过化疗的患者中该效应消失；同时观察到PPI使用者微生物组特征改变，且某些菌群与特定免疫细胞存在相关性。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于“伴随用药（特别是酸抑制剂）如何调节ICI疗效”的重要实证素材。其核心价值在于不仅确认了PPI的负面关联，还引入了“化疗时序”这一关键调节变量，解释了既往研究中结果的异质性。此外，它提供了从微生物组变化到免疫细胞表型的初步关联线索，有助于构建“药物-微生物-免疫-疗效”的作用路径假设。",
        "facet_contributions": [
          {
            "boundaries": "该证据来自回顾性观察研究，存在混杂因素（如疾病严重程度、生活方式等），不能直接推断因果机制。",
            "contribution": "提供了PPI使用与ICI疗效负相关的流行病学证据，并量化了这种关联在不同癌症类型（尤其是黑色素瘤）和治疗线数中的强度。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中讨论“宿主因素/伴随用药”对ICI疗效的整体影响部分，作为支持“某些药物降低ICI疗效”的证据之一。"
