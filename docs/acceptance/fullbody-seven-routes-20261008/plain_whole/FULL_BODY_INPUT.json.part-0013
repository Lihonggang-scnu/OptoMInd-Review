    },
    {
      "source_handle": "P0547",
      "title": "Disrupting the microbiome, disrupting immunity: Antibiotic exposure and survival outcomes with immune checkpoint inhibitors—A systematic review.",
      "year": "2026",
      "doi": "10.1200/jco.2026.44.16_suppl.e23430",
      "paper_id": "f35b573335f00cb26d5316eda7d52df639464dbd",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统综述设计。检索策略基于MeSH术语，限定为过去10年内发表的英语人类研究，关键词组合包括抗生素、免疫检查点抑制剂、癌症及治疗结局。从576条记录中筛选出175篇进行详细审查，最终纳入25项报告了按抗生素暴露分层生存结局的研究。分析重点在于比较抗生素暴露组与非暴露组的总体生存率，并考察肿瘤类型、抗生素类别及合并感染状态对结果的调节作用。",
        "contribution_and_limits": [
          {
            "contribution": "提供了关于抗生素暴露与ICI疗效关联的大规模汇总证据（25项研究，~73,567例），明确了在非黑色素瘤实体瘤中的负面关联趋势，并识别了黑色素瘤和HCC作为潜在的特异性情境。",
            "limits": "所给摘要未交代具体的数据综合方法（如是否进行Meta分析）、偏倚风险评估细节以及各单项研究的基线特征差异。结论主要基于观察性数据的汇总，因果推断能力受限。作者提出的临床建议（如延迟ICI启动）属于推测性指导，需进一步前瞻性研究验证。"
          }
        ],
        "key_findings": [
          {
            "conditions": "除黑色素瘤和特定HCC外的多数实体瘤",
            "finding": "抗生素暴露（治疗前30-60天或期间）与较差的总生存期（OS）显著相关，风险比（HR）范围通常在1.08至2.55之间，个别研究报道风险极高（HR 7.4）。"
          },
          {
            "conditions": "黑色素瘤队列",
            "finding": "大型黑色素瘤队列未显示抗生素暴露与生存率之间存在显著关联，构成主要例外情况。"
          },
          {
            "conditions": "肝细胞癌（HCC）",
            "finding": "关联结果可变，取决于肝炎感染状态。"
          },
          {
            "conditions": "不同抗生素类别",
            "finding": "部分分析显示氟喹诺酮类与其他类别相比与更差的生存率相关，提示可能存在类别特异性效应而非统一的抗生素风险。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管肠道微生物群在塑造抗肿瘤免疫和ICI反应中起关键作用，但抗生素暴露可能破坏微生物多样性从而损害免疫疗法疗效。然而，这种关联在不同实体瘤中的一致性和magnitude尚不清楚。本研究旨在明确抗生素暴露与ICI治疗生存结局之间的关联及其异质性。",
        "research_scope": "成人实体瘤患者接受免疫检查点抑制剂（ICI）治疗的情境；聚焦抗生素暴露（治疗前30-60天或治疗期间）与临床生存结局的关联。",
        "work_summary": "该研究通过系统综述方法，评估了抗生素暴露对实体瘤患者ICI疗效的影响。基于PubMed数据库检索过去10年的人类研究，最终纳入25项涉及约73,567名患者的研究。结果显示，在大多数实体瘤中，抗生素暴露与较差的总生存期（OS）相关，但在黑色素瘤和特定肝细胞癌（HCC）亚组中存在例外。研究还提示不同类别抗生素可能存在特异性影响，并据此提出了临床用药建议。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为“肠道微生物群如何调节ICI疗效”这一主题提供了关键的流行病学证据支持，特别是证实了抗生素干扰（作为微生物群破坏的代理指标）与不良预后之间的广泛关联。它有助于解释为什么在某些肿瘤类型中ICI疗效受损，并为机制假设（微生物介导）提供了间接的临床相关性证据。同时，其识别出的例外情况（黑色素瘤、HCC）为探讨情境依赖性机制提供了切入点。",
        "facet_contributions": [
          {
            "boundaries": "仅证明关联性，不直接展示微生物群的具体变化机制。黑色素瘤中的阴性结果提示该关联并非普适，需结合其他文献解释为何黑色素瘤对微生物群扰动相对不敏感或存在补偿机制。",
            "contribution": "提供了抗生素暴露（微生物群破坏的主要诱因）与ICI疗效负相关的实证数据。具体而言，它量化了在多数实体瘤中抗生素使用导致生存率下降的风险幅度（HR 1.08-2.55），并指出了黑色素瘤中无显著关联的反例。",
            "facet_id": "F1",
            "possible_uses": "可用于论证微生物群完整性对ICI疗效的重要性，特别是在非黑色素瘤实体瘤中。可作为背景证据说明为何保护微生物群对维持ICI疗效至关重要。"
          },
          {
            "boundaries": "摘要未提供具体的分子机制或微生物物种层面的数据，仅停留在临床结局和药物类别层面。不能直接用于解释具体的免疫细胞浸润或信号通路变化，需引用其他机制研究论文补充。",
            "contribution": "提示了抗生素类别特异性（如氟喹诺酮类）和宿主因素（HCC中的肝炎状态）可能调节抗生素对免疫治疗的影响。这暗示了不同的微生物群扰动模式或宿主-微生物互作机制可能导致不同的临床结局。",
            "facet_id": "F2",
            "possible_uses": "可用于讨论机制的复杂性，即并非所有抗生素对微生物群的破坏程度相同，且宿主基础疾病（如慢性病毒感染）可能改变微生物群-免疫轴的平衡。有助于解释为何单一机制模型可能无法涵盖所有临床现象。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "作为“微生物群-免疫轴”在临床应用中的重要影响因素，支持综述中关于“外部干预（如抗生素）可破坏免疫稳态”的论点。",
            "material": "25项研究汇总的生存数据及HR范围，以及关于氟喹诺酮类高风险的发现。",
            "purpose": "提供临床实践中的现实世界证据，说明抗生素滥用或不当使用对免疫治疗效果的潜在危害。"
          },
          {
            "connection_to_review": "提醒综述在归纳普遍规律时需注意肿瘤类型的异质性。这些例外可能指向特定的免疫微环境特征或微生物群组成差异，值得在机制讨论部分作为对比案例提及。",
            "material": "黑色素瘤无关联、HCC依赖肝炎状态的例外发现。",
            "purpose": "界定综述的适用范围和异质性来源。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为观察性系统综述，发现的关联不等于因果关系。抗生素使用可能与疾病严重程度或共病有关，而不仅仅是微生物群破坏所致。",
          "黑色素瘤中的阴性结果不应被忽视，它挑战了“抗生素必然损害ICI疗效”的简单假设，需在综述中谨慎处理以避免过度概括。",
          "所给材料未提供原始研究的详细质量评估，因此汇总结果的可靠性依赖于纳入研究的整体质量，阅读时需保持适度谨慎。",
          "作者提出的“延迟ICI启动”建议是基于回顾性数据的推测，尚未得到随机对照试验证实，不应作为既定事实陈述。"
        ],
        "topic_handles": [
          "抗生素暴露窗口（治疗前30-60天 vs 治疗期间）",
          "肿瘤类型特异性响应（实体瘤整体 vs 黑色素瘤 vs HCC）",
          "抗生素类别特异性效应（氟喹诺酮类 vs 其他）",
          "合并感染状态（HCC中的肝炎状态）",
          "临床干预时机（ICI启动前的抗生素使用史）"
        ]
      },
