      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\planning_support\\20260923\\practical_refresh\\supplement_live\\source_units\\SU01_search_candidate_2ec5a3c2b3\\card\\PAPER_READING_CARD.json"
