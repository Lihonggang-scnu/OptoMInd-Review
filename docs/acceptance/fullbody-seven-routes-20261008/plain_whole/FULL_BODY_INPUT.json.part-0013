      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\8211fc48bb00f738157c8859ad0748cc7d220f09\\5faefb771e9af4b8f1b5bd10a8bf9492\\attempt-01\\PAPER_READING_CARD.json"
