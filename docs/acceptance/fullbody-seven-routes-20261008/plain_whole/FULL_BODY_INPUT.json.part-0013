    {
      "source_handle": "P0155",
      "title": "Dietary compounds and patterns associated with immune checkpoint inhibitor (ICI) outcomes in advanced non-small cell lung cancer (NSCLC).",
      "year": "2025",
      "doi": "10.1200/jco.2025.43.16_suppl.2567",
      "paper_id": "448f3d956dc7cb74cd1bee3958ce828f79d4e1c7",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "这是一项观察性临床研究设计。首先，在CHUM微生物组中心，由营养师使用经过验证的DHQ-II问卷前瞻性收集147名晚期NSCLC患者的饮食史。其次，采用单变量和多变量Cox回归分析，考察全球饮食模式和72种宏微观营养素（以中位数为截断值）与PFS的关联，并调整BMI等协变量。同时，分析饮食与irAEs发生率的关联。最后，对69名患者的粪便样本进行鸟枪法宏基因组测序（WMS），利用线性判别分析、热图和MaAsLin2工具确定细菌丰度的差异，以建立饮食-微生物组-临床结局的联系。",
        "contribution_and_limits": [
          {
            "contribution": "提供了在晚期NSCLC人群中，特定饮食模式（特别是高脂/低淀粉）和单一营养素（维生素K）与ICI治疗PFS及irAEs关联的临床证据。",
            "limits": "研究为观察性设计，无法确立因果关系；样本量相对较小（尤其是微生物组子集仅69人）；未控制所有潜在混杂因素（如抗生素使用、其他生活方式因素）；结果需在随机对照试验中验证。"
          },
          {
            "contribution": "通过宏基因组测序揭示了饮食-微生物组-临床结局的潜在生物学机制线索，将临床表型与特定细菌丰度变化联系起来。",
            "limits": "微生物组分析仅为相关性信号，未进行功能验证或因果推断；所发现的细菌标志物需在其他队列中复现。"
          }
        ],
        "key_findings": [
          {
            "conditions": "全队列（N=147），调整基础代谢率后",
            "finding": "总热量摄入与PFS无显著关联（p = 0.3）。"
          },
          {
            "conditions": "单变量分析",
            "finding": "维生素K（HR 0.62, p=0.03）和脂肪（HR 0.65, p=0.04）摄入与改善的PFS相关；淀粉（HR 1.61, p=0.03）、碳水化合物（HR 1.56, p=0.04）、蔗糖（HR 1.62, p=0.03）和铁（HR 1.7, p=0.016）摄入与较差的PFS相关。"
          },
          {
            "conditions": "多变量分析（调整BMI）",
            "finding": "维生素K摄入仍显著关联于改善的PFS（HR 0.60, 95% CI 0.37-0.97, p=0.04）。"
          },
          {
            "conditions": "饮食模式比较",
            "finding": "基于脂肪的饮食（如类生酮饮食：高脂、低淀粉）在单变量（HR 0.47, p=0.008）和多变量分析（HR 0.37, 95% CI 0.2-0.68, p=0.001）中均与改善的PFS相关。相比之下，西方饮食（高脂、高淀粉）相比高淀粉饮食，与任何等级irAEs风险增加相关（54% vs 24%, p=0.01）。"
          },
          {
            "conditions": "微生物组关联（N=69）",
            "finding": "基于脂肪的饮食与有益共生菌（如Ruminococcus lactaris, Butyricimonas faecihominis, Lachnospiraceae spp）的富集相关，低脂饮食与有害菌Veillonella atypica相关。基于淀粉的饮食与高Prevotella spp相关。富含蔗糖的饮食与已知发酵蔗糖的Candidatus saccharibacteria富集相关。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "尽管已知肠道微生物组调节ICI活性且饮食是其主要影响因素，但此前关于高纤维饮食在NSCLC中的效果尚不明确（与黑色素瘤不同）。本研究旨在解决：特定的饮食模式（如高脂/低碳水化合物 vs 高淀粉）和具体营养素（如维生素K、铁、蔗糖等）如何影响晚期NSCLC患者ICI治疗的无进展生存期（PFS）及免疫相关不良事件（irAEs），以及这种影响是否由肠道微生物组介导。",
        "research_scope": "研究对象为接受免疫检查点抑制剂（ICI）单药或联合化疗治疗的晚期非小细胞肺癌（NSCLC）患者。研究情境涉及临床营养评估、生存结局分析以及肠道微生物组测序，旨在探索饮食因素对ICI疗效及毒性的影响。",
        "work_summary": "该研究针对既往发现高纤维饮食在黑色素瘤中有益但在NSCLC中无关联的差异，进一步探究饮食模式和特定营养素对NSCLC患者ICI治疗预后的影响。研究团队通过前瞻性收集147例患者的饮食历史数据，结合72种宏微观营养素的系统筛查，分析其与无进展生存期（PFS）及免疫相关不良事件（irAEs）的关联。同时，对其中69例患者的粪便样本进行鸟枪法宏基因组测序，以揭示饮食与微生物组变化之间的生物学联系。结果显示，基于脂肪的饮食模式与改善的PFS相关，而维生素K摄入亦独立关联于更好的预后；相反，淀粉和蔗糖摄入与较差的PFS相关。微生物组分析支持了饮食通过调节肠道菌群（如增加有益菌或促进蔗糖发酵菌）来介导这些临床结果的假设。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于肠道微生物组调节固体肿瘤（特别是NSCLC）中ICI疗效的具体临床证据和机制假设。其核心价值在于区分了不同饮食模式（高脂vs高淀粉）对ICI预后的差异化影响，并通过微生物组测序数据提出了“饮食-菌群-疗效”的中介路径。这有助于回答综述中关于“微生物组如何调节ICI疗效”及“介导机制”的问题，特别是提供了来自NSCLC这一特定癌种的实证数据，填补了此前仅关注黑色素瘤或泛癌种的空白。",
        "facet_contributions": [
          {
            "boundaries": "仅限观察性关联，非因果证明；结果受BMI等因素影响；微生物组数据仅来自部分亚组。",
            "contribution": "提供了晚期NSCLC患者中，基于脂肪的饮食（高脂低淀粉）与显著改善的无进展生存期（PFS）相关的临床数据，以及高淀粉/蔗糖饮食与较差预后的关联。同时指出西方饮食（高脂高淀粉）可能增加免疫相关不良事件（irAEs）的风险。",
            "facet_id": "F1",
            "possible_uses": "用于论证饮食模式作为调节ICI疗效的可变因素，特别是在NSCLC背景下，高脂饮食可能优于传统高碳水饮食。可用于对比不同癌种（如黑色素瘤）中饮食影响的异质性。"
          },
          {
            "boundaries": "仅为相关性分析，未证明这些细菌直接导致疗效改善；需要功能实验验证细菌的作用；样本量有限，可能存在批次效应或个体差异。",
            "contribution": "通过宏基因组测序揭示了特定饮食与肠道菌群组成的关联：高脂饮食富集有益共生菌（如Ruminococcus lactaris, Lachnospiraceae spp），低脂饮食与潜在有害菌（Veillonella atypica）相关；高淀粉饮食与Prevotella spp相关；高蔗糖饮食与蔗糖发酵菌（Candidatus saccharibacteria）相关。",
            "facet_id": "F2",
            "possible_uses": "用于解释饮食影响ICI疗效的潜在微生物组机制。这些细菌标志物可作为后续研究中验证“菌群介导疗效”的具体靶点或生物标志物。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供NSCLC特异性背景下的饮食-微生物组-ICI疗效关联实例。",
            "material": "NSCLC患者中膳食纤维先前未被证实有效，但本研究发现其他饮食成分（脂肪、维生素K）有效，提示癌种特异性。",
            "purpose": "用于讨论不同实体瘤中饮食干预效果的异质性，避免将黑色素瘤结论外推至所有固体肿瘤。"
          },
          {
            "connection_to_review": "提供irAEs与饮食关联的新视角。",
            "material": "西方饮食（高脂高淀粉）与更高的irAEs发生率相关。",
            "purpose": "用于探讨饮食不仅影响疗效，还可能影响免疫治疗的安全性/毒性谱，丰富综述对ICI副作用管理的讨论。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为观察性队列，发现的饮食与PFS/微生物组的关联不能直接解释为因果关系，需谨慎用于指导临床实践。",
          "微生物组分析仅涵盖69名患者，代表性有限，且MaAsLin2等统计方法仅揭示丰度差异，未提供功能通路的确凿证据。",
          "作者建议进行随机试验，表明当前证据等级不足以确立推荐饮食方案。",
