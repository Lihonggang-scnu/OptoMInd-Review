    {
      "source_handle": "P0578",
      "title": "Safety and efficacy of fecal microbiota transplantation in solid cancers resistant to immune checkpoint inhibitors: results of the MITRIC trial",
      "year": "2026",
      "doi": "10.1136/jitc-2026-015122",
      "paper_id": "d9577b3a29bd8aec60c9e27c6a56a63faf3f4a27",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用单臂、开放标签的IIa期篮子试验设计。纳入标准包括ICI治疗后疾病进展、ECOG评分0-1及可测量病灶。供体需为ICI长期响应者（>12个月响应）。干预措施包括基线后第1周和第5周通过结肠镜进行两次FMT，随后在第14、30、78周可通过灌肠进行最多三次补充FMT。ICI治疗保持不变或重新引入。主要终点评估安全性和ORR（基于iRECIST）。次要终点包括可行性、临床获益率、无进展生存期（PFS）、总生存期（OS）、微生物定植（16S rRNA测序）、免疫反应（质谱流式细胞术分析PBMCs）及生物标志物（血清细胞因子）。统计分析采用描述性统计、Kaplan-Meier生存分析及Cox比例风险模型探索免疫特征与预后的关联，未进行多重检验校正。",
        "contribution_and_limits": [
          {
            "contribution": "证实了在ICI耐药的晚期实体瘤患者中，使用ICI响应者供体的FMT是安全和可行的。提供了关于FMT后微生物定植动力学（短暂性）和系统性免疫景观（髓系抑制与T细胞活化）的详细生物标志物数据。",
            "limits": "样本量小（n=12），试验因入组缓慢提前终止。单臂设计无法确立因果关系，缺乏对照组。未能实现预期的临床疗效（无ORR），限制了对其机制解释的确定性。结果可能受到快速进展性疾病背景的影响，未能在足够长的时间内观察FMT的潜在延迟效应。"
          }
        ],
        "key_findings": [
          {
            "conditions": "12名ICI耐药晚期实体瘤患者，接受来自ICI响应者的FMT联合ICI治疗",
            "finding": "FMT安全性良好，无严重FMT相关不良事件导致停药，但50%患者出现免疫相关不良事件（irAEs），多数为轻度。客观缓解率（ORR）为0%，中位PFS为1.5个月，中位OS为10.1个月。"
          },
          {
            "conditions": "微生物组分析",
            "finding": "首次FMT后一周，大多数受体的微生物组向供体方向偏移（定植成功），但这种相似性在后续时间点大多下降，表明定植多为暂时性。仅1名获得临床获益的患者实现了持久的供体-受体微生物相似性。"
          },
          {
            "conditions": "免疫微环境分析",
            "finding": "基线时高度分化的T细胞环境（CD8+效应记忆T细胞和TEMRA）与改善的PFS和OS相关；而髓系偏倚环境和幼稚T细胞表型预后较差。CD14+单核细胞和血清IL-8水平随时间增加，高水平的CD14+单核细胞与较短的PFS和OS相关。这些免疫特征与预后的关联在使用ICI治疗起始日期重新计算时依然成立，提示其反映的是宿主对免疫治疗的固有反应能力，而非FMT的直接因果效应。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "早期研究表明FMT可能逆转ICI耐药，但其适用性在其他肿瘤类型中尚不明确，且关于患者选择、供体选择及给药方案的问题仍未解决。本研究试图回答：在ICI耐药的晚期实体瘤患者中，重复FMT是否安全可行，以及是否能通过微生物定植和免疫重塑来恢复ICI的疗效。",
        "research_scope": "针对晚期实体瘤（黑色素瘤、头颈部鳞癌、肾细胞癌、微卫星不稳定性高胰腺癌）中免疫检查点抑制剂（ICI）耐药或进展的患者，评估来自ICI长期响应者的粪菌移植（FMT）联合ICI治疗的安全性和有效性。",
        "work_summary": "本研究是一项单臂IIa期篮子试验（MITRIC），旨在验证通过FMT调节肠道微生物群能否克服已建立的ICI耐药性。研究纳入了12名在转移性阶段对ICI治疗进展的患者，使用ICI长期响应者作为供体，给予患者最多五次FMT（前两次通过结肠镜，后续通过灌肠），并继续原有ICI治疗。主要终点为FMT相关不良事件和客观缓解率（ORR）。结果显示FMT安全性良好，但未能观察到客观肿瘤反应（ORR为0%），仅5名患者达到疾病稳定。尽管缺乏总体疗效证据，研究发现FMT诱导了短暂的微生物定植，且外周血中的免疫细胞特征（如分化T细胞与髓系细胞的平衡）与生存期显著相关，但这些免疫特征似乎更多反映疾病本身状态而非FMT的特异性干预效果。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于FMT在ICI耐药实体瘤中应用的阴性疗效结果及详细的转化医学发现。对于综述而言，其核心价值在于反驳了“FMT能普遍逆转ICI耐药”的简单假设，并指出了患者选择（如疾病进展速度、既往免疫状态）和供体匹配的重要性。同时，它提供了关于肠道微生物定植持久性与临床获益之间潜在联系的生物学见解，以及系统性免疫景观（特别是髓系细胞和T细胞亚群）作为预后生物标志物的证据。",
        "facet_contributions": [
          {
            "boundaries": "仅适用于ICI耐药/进展人群，不能外推至一线治疗场景。样本量极小，结果可能存在偶然性，但趋势明确。",
            "contribution": "提供了FMT在广泛ICI耐药实体瘤队列中的真实世界疗效数据：ORR为0%，中位PFS仅为1.5个月。这表明在非选择性、快速进展的耐药人群中，FMT联合ICI并非有效的挽救疗法。",
            "facet_id": "F1",
            "possible_uses": "用于支持综述中关于“FMT疗效具有高度情境依赖性”或“需严格筛选患者群体”的论点。对比其他阳性研究，说明患者基线状态（如疾病负荷、进展速度）对FMT结局的关键影响。"
          },
          {
            "boundaries": "免疫关联分析为探索性，未校正多重检验，且缺乏对照组，无法证明FMT改变了这些免疫特征从而改善了预后。仅描述了相关性，未证明因果机制。",
            "contribution": "揭示了FMT干预后系统性免疫景观的变化及其与预后的关联：(1) FMT诱导的微生物定植多为暂时性，仅持久定植者与临床获益相关；(2) 基线高分化T细胞表型预示更好预后，而高髓系细胞（CD14+）和高IL-8水平预示不良预后；(3) 这些免疫特征似乎反映了宿主固有的免疫反应能力，而非FMT直接重塑的结果。",
            "facet_id": "F2",
            "possible_uses": "用于解释FMT起效的潜在机制（需要持久定植和特定的宿主免疫背景）。提供生物标志物候选项（如CD14+单核细胞、IL-8、T细胞分化状态）以预测哪些患者可能从微生物调节中受益。帮助区分“药物直接效应”与“宿主背景效应”。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供FMT在临床转化中的实际挑战案例，特别是供体选择和患者异质性问题。",
            "material": "研究讨论了使用ICI响应者作为供体的局限性（微生物组成差异大），以及不同研究间供体数量（单供体vs多供体）对结果的潜在影响。",
            "purpose": "用于讨论“供体选择标准”对FMT疗效的影响，指出单一供体或多供体混合策略的优劣尚无共识，且供体与受体的匹配度可能是关键因素。"
          },
          {
            "connection_to_review": "提供关于FMT给药途径和频率的可行性数据。",
            "material": "比较了结肠镜给药（前两次）和灌肠给药（后续）的可行性及耐受性。",
            "purpose": "用于综述中关于“FMT最佳给药方案”的部分，说明多次、重复给药在技术上可行，但在临床实践中受限于患者状况和疾病进展。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究的阴性结果主要归因于患者群体的快速进展特性和小样本量，不应将其解读为FMT在所有情况下均无效，而应视为特定情境下的失败尝试。",
          "免疫生物标志物的发现是探索性的，且可能与ICI治疗本身的效应混淆，需谨慎解读其作为FMT特异性机制的作用。",
          "微生物定植的暂时性并不必然意味着临床无效，因为唯一获益患者的持久定植提示了两者间的潜在联系，但这仅是个案观察。"
        ],
        "topic_handles": [
          "fecal microbiota transplantation (FMT)",
          "immune checkpoint inhibitors (ICIs) resistance",
          "solid tumors (melanoma, HNSCC, RCC, pancreatic cancer)",
          "microbiota engraftment kinetics",
          "peripheral blood mononuclear cells (PBMCs)",
          "myeloid-derived suppressor cells / CD14+ monocytes",
          "T-cell differentiation phenotypes",
          "serum cytokines (IL-8)"
        ]
      },
