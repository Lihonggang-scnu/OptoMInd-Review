    {
      "source_handle": "P0343",
      "title": "Integrative Oncology Approaches to Supporting Immune Checkpoint Inhibitor Treatment of Solid Tumours",
      "year": "2024",
      "doi": "10.1007/s11912-023-01492-4",
      "paper_id": "93c5dd39ff702a807d9b564fd630d241e76ebcba",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "作为一篇叙述性综述，作者基于现有文献（包括观察性研究、临床试验、指南和机制研究），系统性地归纳了影响ICI疗效的非肿瘤内在因素（如炎症、微生物群、生活方式），并据此分类讨论了各类整合肿瘤学干预手段（营养、运动、微生物调节、补充剂、心理干预、草药等）的证据等级、潜在机制及临床建议。",
        "contribution_and_limits": [
          {
            "contribution": "提供了整合肿瘤学策略支持ICI治疗的全面概览，特别强调了从“预测”转向“响应行动”的转化医学思路（如利用炎症标志物指导干预时机）。",
            "limits": "所引用的多数证据来自观察性研究或小样本试验，缺乏大规模随机对照试验（RCT）的确证；对于许多干预措施（如特定益生菌、中草药、身心疗法），其因果效应和最佳剂量/方案尚未明确。"
          },
          {
            "contribution": "明确了医疗大麻在ICI治疗中的潜在负面信号，以及维生素D补充的具体获益阈值。",
            "limits": "对某些新兴领域（如真菌疗法、具体中药方剂）仅提及预临床证据或正在进行的试验，缺乏直接的临床结果支持。"
          }
        ],
        "key_findings": [
          {
            "conditions": "成人实体瘤患者，基线或治疗期间",
            "finding": "系统性炎症标志物（如NLR, CRP, LIPI）升高与较差的ICI预后相关；CRP flare（治疗后初期CRP升高后下降）可能与良好的免疫反应相关。"
          },
          {
            "conditions": "饮食干预",
            "finding": "摄入至少20g/天膳食纤维的地中海式饮食与晚期黑色素瘤患者的无进展生存期（PFS）延长相关；避免超加工食品和高糖饮料有助于维持健康的肠道微生物群。"
          },
          {
            "conditions": "运动干预",
            "finding": "回顾性研究显示，接受仑伐替尼联合抗PD-1治疗的肝细胞癌患者中，活跃运动组比久坐组具有更长的总生存期（OS）和无进展生存期（PFS）；但针对ICI的特异性RCT数据仍有限。"
          },
          {
            "conditions": "肠道微生物群调节",
            "finding": "粪菌移植（FMT）可使部分ICI耐药患者产生客观缓解；口服活体生物疗法（LBTs，如MRx0518, CBM588）显示出免疫调节和增强ICI疗效的潜力，且可能减轻胃肠道irAEs。益生菌效果存在争议，取决于菌株特异性。"
          },
          {
            "conditions": "维生素D补充",
            "finding": "PROVIDENCE前瞻性研究表明，将血清25-羟基维生素D水平补充至≥75 nmol/l可显著延长晚期癌症患者的OS，降低疾病控制失败风险，并减少甲状腺irAEs的发生率。"
          },
          {
            "conditions": "医疗大麻使用",
            "finding": "一项前瞻性观察性研究发现，医疗大麻的使用与时间至肿瘤进展缩短及总生存期（OS）显著降低相关；尽管另一项小样本研究未达统计学显著差异，但鉴于潜在风险，建议谨慎使用。"
          },
          {
            "conditions": "慢性压力与身心疗法",
            "finding": "治疗前的情绪困扰和慢性心理压力被证实是黑色素瘤和非小细胞肺癌（NSCLC）患者ICI疗效差的独立预后因素；身心疗法（瑜伽、太极等）在此领域尚需进一步临床研究。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "随着ICI在实体瘤中的广泛应用，如何识别并利用低成本、低毒性的整合肿瘤学策略来支持ICI治疗，以提高疗效、改善预后并最小化免疫相关不良事件（irAEs）。",
        "research_scope": "成人实体瘤患者接受免疫检查点抑制剂（ICI）治疗期间，整合肿瘤学（Integrative Oncology, IO）策略的应用与潜力。涵盖营养、运动、微生物组调节、补充剂及心理干预等支持性措施。",
        "work_summary": "本文是一篇综述，旨在评估整合肿瘤学策略在支持成人实体瘤患者进行免疫检查点抑制剂（ICI）治疗中的作用和实际应用。文章指出，除了肿瘤内在因素外，宿主相关的系统性炎症、肠道微生物群、饮食和遗传背景显著影响ICI疗效。综述梳理了当前有前景的支持性干预措施，包括地中海式高纤维饮食、规律运动、活体生物疗法、减少质子泵抑制剂（PPI）和抗生素使用、维生素D补充等，并警告医疗大麻可能带来的生存期缩短风险。文章强调通过多模式术前康复（prehabilitation）和术中支持来优化患者状态，以改善治疗效果并最小化不良反应。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物群如何调节ICI疗效提供了重要的临床背景和机制线索。它汇总了关于微生物群组成、饮食纤维、活体生物疗法（LBTs）、粪菌移植（FMT）以及抗生素/PPI使用对ICI反应影响的证据。虽然它本身不提出新的分子机制实验数据，但它清晰地指出了微生物群作为关键中介变量的地位，并列出了具体的干预手段（如特定菌株、纤维摄入量）及其对应的临床结局变化，可直接用于回答“微生物群如何调节ICI疗效”及其背后的临床关联。",
        "facet_contributions": [
          {
            "boundaries": "这些发现主要基于观察性研究和小型试点研究，因果关系的确立程度不一；不同癌症类型（主要是黑色素瘤、NSCLC、HCC）的结果不能直接泛化到所有实体瘤。",
            "contribution": "提供了肠道微生物群调节ICI疗效的临床证据链：包括FMT诱导缓解的案例、LBTs（如MRx0518, CBM588）增强疗效和减轻irAEs的数据、以及饮食纤维（>20g/d）与PFS延长的关联。同时指出了益生菌效果的菌株特异性和矛盾性。",
            "facet_id": "F1",
            "possible_uses": "用于描述肠道微生物群作为ICI疗效关键调节因子的临床表现；列举具体的微生物干预策略及其对肿瘤反应（ORR, PFS, OS）的影响方向。"
          },
          {
            "boundaries": "机制部分多为动物模型或体外研究推论（如L. reuteri的机制），临床人体内的确切分子通路细节在所给材料中未完全展开；压力机制主要基于动物研究和人类相关性观察，直接因果链条需结合其他文献验证。",
            "contribution": "阐述了微生物群影响ICI疗效的部分机制路径：包括短链脂肪酸（SCFAs）驱动CD4/CD8 T细胞激活、促进IFN表达；特定菌株代谢物（如I3A）促进肿瘤内CD8+ T细胞浸润；以及系统性炎症（IL-6, IL-8）作为负向调节因子。同时提到了慢性压力通过HPA轴/SNS改变肿瘤微环境（TME）的间接机制。",
            "facet_id": "F2",
            "possible_uses": "用于解释微生物群介导ICI疗效的生物学机制，特别是免疫细胞活化、细胞因子释放和肿瘤微环境重塑方面的通路。"
          }
        ],
        "broader_review_uses": [
