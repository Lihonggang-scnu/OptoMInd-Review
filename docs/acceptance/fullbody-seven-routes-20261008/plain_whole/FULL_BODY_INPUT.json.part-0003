        },
        {
          "source_handle": "P0195",
          "title": "The microbial metabolite desaminotyrosine enhances T-cell priming and cancer immunotherapy with immune checkpoint inhibitors",
          "year": "2023",
          "doi": "10.1016/j.ebiom.2023.104834",
          "paper_id": "556c1f84751da3bea2bca5a9336429ad72962add",
          "material_depth": "fulltext",
          "material_status": "resolved",
          "aliases": [],
          "study_summary_A": {
            "approach": "体内实验：建立B16.OVA黑色素瘤和Panc02胰腺癌皮下移植模型。设置对照组、DAT单药组、ICI单药组及DAT+ICI联合组。引入广谱抗生素（Abx）混合液饮水处理以诱导肠道菌群失调，评估DAT对菌群失调导致的ICI抵抗的补偿作用。使用Ifnar1-/-小鼠验证宿主IFN-I信号在DAT介导的免疫增强中的必要性。体外实验：分离脾脏T细胞和骨髓来源树突状细胞（DC），在TCR刺激或LPS共刺激条件下，检测DAT对细胞活化标志物（如CD25, IFNγ, CD80/86）的影响。分析手段包括流式细胞术（TME免疫细胞图谱）、16S-rRNA测序（肠道菌群组成变化）、靶向代谢组学（粪便DAT水平测定）及生存分析。",
            "contribution_and_limits": [
              {
                "contribution": "识别了细菌代谢物DAT作为IFN-I调节剂，能够协同ICI增强抗肿瘤T细胞免疫的具体表型和机制依赖关系。",
                "limits": "所给摘要未交代DAT在体内的确切受体或上游感知机制；仅在小鼠模型中验证，尚未在人类临床试验中证实安全性和有效性；DAT对菌群组成的改变是因果还是伴随现象尚不明确。"
              }
            ],
            "key_findings": [
              {
                "conditions": "B16.OVA黑色素瘤模型 + 抗CTLA-4治疗",
                "finding": "口服DAT显著延迟肿瘤生长并提高长期生存率，表现为肿瘤微环境（TME）中IFNγ+ CD4+和CD8+ T细胞以及NK细胞的频率和活性增加。"
              },
              {
                "conditions": "Ifnar1-/-小鼠模型 + 抗CTLA-4治疗",
                "finding": "DAT的协同增效作用完全消失，表明DAT增强ICI疗效严格依赖于宿主完整的IFN-I信号通路。"
              },
              {
                "conditions": "广谱抗生素（Abx）诱导的菌群失调模型 + 抗CTLA-4治疗",
                "finding": "虽然DAT不能阻止抗生素引起的肠道细菌耗竭，但能部分恢复抗CTLA-4的抗肿瘤疗效，延长生存期，并促进循环中抗原特异性T细胞的扩增。"
              },
              {
                "conditions": "体外T细胞培养 + TCR/CD28刺激",
                "finding": "DAT直接增强TCR刺激下的CD8+ T细胞活化（IFNγ+和CD25+表达增加）及CD4+ T细胞向Th1分化（T-bet+）。"
              },
              {
                "conditions": "体外DC培养 + LPS刺激",
                "finding": "DAT仅在存在LPS（TLR4配体）共刺激时，才能促进DC表面共刺激分子CD80/CD86的表达成熟。"
              },
              {
                "conditions": "口服DAT干预7天",
                "finding": "改变肠道菌群组成，降低α多样性，增加拟杆菌目（Bacteroidales）和伯克霍尔德菌目（Burkholderiales）的相对丰度，减少梭菌纲（Clostridia）丰度。"
              }
            ],
            "paper_kind": "empirical",
            "problem_or_question": "尽管肠道微生物群影响ICI疗效，但其具体分子机制尚不明确，且临床常因抗生素使用导致菌群失调从而降低免疫治疗效果。本研究试图确定特定的细菌代谢物DAT是否能作为一种可调控的手段，通过调节IFN-I信号来克服ICI治疗的个体差异和耐药性。",
            "research_scope": "C57Bl/6j小鼠及Ifnar1-/-基因缺陷小鼠；恶性黑色素瘤（B16.OVA）和胰腺腺癌（Panc02）模型；肠道微生物群与宿主免疫系统的相互作用。",
            "work_summary": "本研究旨在探讨细菌代谢物脱氨酪氨酸（DAT）作为I型干扰素（IFN-I）调节剂，能否增强实体瘤对免疫检查点抑制剂（ICI，如抗CTLA-4或抗PD-1）的治疗反应。研究通过口服补充DAT，在多种小鼠肿瘤模型中评估其抗肿瘤效果，并利用广谱抗生素诱导菌群失调模型模拟临床耐药情境，同时利用IFN-I信号缺失小鼠解析其分子机制。研究发现DAT能协同ICI增强T细胞活化，且该效应依赖于宿主IFN-I信号通路，并能部分逆转抗生素引起的治疗抵抗。"
          },
          "review_planning_B": {
            "broader_review_uses": [
              {
                "connection_to_review": "帮助构建综述的背景框架，说明为何研究微生物代谢物是解决ICI疗效异质性的关键方向。",
                "material": "引言部分引用了多项关于抗生素使用、菌群失调与ICI抵抗相关的临床研究及基础研究发现。",
                "purpose": "提供背景信息：肠道微生物群与ICI疗效关联的临床挑战及现有知识空白。"
