          "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\eea4059be35526f75d745cc8d16db8ec33658f69\\2f1ce1a9369099b358891cd1b16e0d5a\\attempt-01\\PAPER_READING_CARD.json"
        },
        {
          "source_handle": "P0388",
          "title": "Microbiota-induced T cell plasticity enables immune-mediated tumour control",
          "year": "2026",
          "doi": "10.1038/s41586-025-09913-z",
          "paper_id": "a85afdff22ae96afa7e975dddb2b63ea9aa9cd29",
          "material_depth": "fulltext",
          "material_status": "resolved",
          "aliases": [],
          "study_summary_A": {
            "approach": "1. 模型构建：工程化B16-F10、LLC1和MC-38细胞系稳定表达SFB抗原片段（SFB-3340），建立合成新抗原模拟肿瘤模型。 2. 体内干预：比较SFB定植（SFB+）与无菌（SFB-）小鼠在植入上述肿瘤后，接受或不接受抗PD-1抗体治疗的肿瘤生长情况。 3. 免疫表型分析：利用流式细胞术、MHC II类四聚体染色分析肿瘤浸润淋巴细胞（TILs）和肠道固有层（SILP）T细胞的亚群分布、转录因子表达（如RORγt, T-bet）及细胞因子分泌（IFN-γ, TNF, IL-17A）。 4. 克隆谱系追踪：结合scRNA-seq和scTCR-seq，配对分析SILP和肿瘤组织中CD4+ T细胞的TCR克隆型重叠，验证肠道到肿瘤的迁移关系。 5. 功能验证：使用Il17a-Cre;ROSA-LSL-DTA小鼠条件性清除IL-17A+ T细胞，评估其对ICB疗效及CD8+ T细胞功能的影响；进行过继转移实验追踪标记T细胞的命运。 6. 对照比较：使用诱导Foxp3+调节性T细胞的Helicobacter hepaticus (Hh)作为阴性对照，比较不同菌群诱导的T细胞程序对ICB疗效的差异。",
            "contribution_and_limits": [
              {
                "contribution": "提供了肠道共生菌通过分子模拟增强ICB疗效的因果机制证据，定义了“肠道T_H17 -> 肿瘤ex-T_H17 -> CD8+ T细胞辅助”这一细胞通路。",
                "limits": "所给摘要未交代该机制在人类癌症患者中的普遍性或临床相关性；模型依赖于人工设计的抗原匹配，可能不反映自然感染或复杂菌群互作的全部情况；主要在小鼠模型中验证，外推到人体需谨慎。"
              }
            ],
            "key_findings": [
              {
                "conditions": "SFB定植 + 抗PD-1治疗 + SFB抗原表达肿瘤",
                "finding": "显著抑制肿瘤生长并延长生存期，且产生持久的记忆样保护；单独SFB定植或单独抗PD-1治疗无此效果。"
              },
              {
                "conditions": "SFB定植小鼠的肿瘤组织",
                "finding": "发现大量源自肠道的SFB特异性CD4+ T细胞浸润，其表型从肠道中的T_H17（IL-17A+）转变为肿瘤中的T_H1-like（IFN-γ+, TNF+, T-bet+, RORγt部分保留），即ex-T_H17细胞。"
              },
              {
                "conditions": "scTCR-seq与谱系追踪",
                "finding": "证实肿瘤中的ex-T_H17细胞与肠道SILP中的T_H17细胞共享相同的TCR克隆型，证明存在从肠道到肿瘤的迁移及表型重编程。"
              },
              {
                "conditions": "条件性清除IL-17A+ T细胞",
                "finding": "消除SFB诱导的IL-17A+ T细胞前体后，抗PD-1介导的肿瘤控制被完全取消，肿瘤内CD8+ T细胞招募和功能受损，表明ex-T_H17细胞是疗效的关键介质。"
              },
              {
                "conditions": "H. hepaticus定植 + 抗PD-1治疗 + Hh抗原表达肿瘤",
                "finding": "未观察到肿瘤生长抑制。虽然Hh特异性T细胞也迁移至肿瘤，但其维持Foxp3+调节性表型，缺乏促炎效应功能，无法协同增强ICB。"
              }
            ],
            "paper_kind": "empirical",
            "problem_or_question": "尽管临床数据显示肠道菌群组成与ICB疗效相关，但特定共生菌如何具体影响抗肿瘤免疫反应的因果机制尚不明确。特别是，肠道来源的抗原特异性T细胞是否能通过分子模拟识别肿瘤抗原并远程调控肿瘤免疫微环境？",
            "research_scope": "小鼠模型（C57BL/6J及转基因品系），聚焦肠道共生菌分段丝状菌（SFB）与表达其抗原表位的工程化肿瘤细胞（B16-F10黑色素瘤、LLC1肺癌、MC-38结肠癌）之间的相互作用，评估抗PD-1免疫检查点阻断（ICB）疗效。",
            "work_summary": "本研究旨在阐明肠道微生物群如何通过分子模拟机制增强免疫检查点阻断（ICB）的抗肿瘤疗效。研究构建了合成新抗原模拟模型，将SFB的一个免疫显性CD4+ T细胞表位（SFB-3340）引入肿瘤细胞。结果显示，仅在SFB定植的小鼠中，抗PD-1治疗能有效抑制表达该抗原的肿瘤生长。通过单细胞测序、谱系追踪和条件性消融实验，研究发现SFB诱导的肠道固有层T_H17细胞迁移至远端肿瘤，在ICB作用下发生表型可塑性，转化为产生IFN-γ和TNF的T_H1-like效应细胞（ex-T_H17）。这些细胞通过重塑肿瘤微环境，促进CD8+细胞毒性T淋巴细胞的招募和活化，从而协同实现肿瘤控制。相比之下，诱导调节性T细胞程序的另一种细菌（H. hepaticus）未能增强ICB疗效。"
          },
          "review_planning_B": {
            "broader_review_uses": [
              {
                "connection_to_review": "提供微生物调节ICI疗效的时间窗口信息。",
                "material": "治疗后早期（植入后8-12天）给予SFB定植效果最佳，晚期给药效果递减，提示微生物抗原暴露与治疗启动之间存在狭窄的协同时间窗。",
                "purpose": "用于讨论微生物干预的最佳时机或ICI治疗期间微生物生态变化的动态影响。"
              },
              {
                "connection_to_review": "提供关于CD4+ T细胞在抗肿瘤免疫中非传统角色的背景知识。",
                "material": "肿瘤浸润的ex-T_H17细胞表现出类似细胞毒性CD4+ T细胞的基因特征（如Prf1, Klrc1），并在多种人类癌症中被报道与良好预后相关。",
                "purpose": "用于丰富综述中关于肿瘤浸润淋巴细胞（TILs）异质性和功能多样性的讨论，特别是CD4+ T细胞在ICI响应中的作用。"
              }
            ],
            "facet_contributions": [
              {
                "boundaries": "仅限于SFB这一特定菌种及与其抗原匹配的肿瘤模型；未涵盖其他常见益生菌或致病菌的作用。",
                "contribution": "提供了肠道微生物增强ICI疗效的具体生物学路径：SFB定植通过抗原交叉反应，使肠道T_H17细胞迁移至肿瘤并转化为效应状态，从而增强抗肿瘤免疫。",
                "facet_id": "F1",
                "possible_uses": "用于解释“哪些类型的肠道菌群有助于ICI疗效”以及“微生物如何远程影响肿瘤免疫”的子问题。可作为微生物调节ICI疗效的正向机制案例。"
              },
              {
                "boundaries": "机制基于合成抗原模型，实际人体内是否存在完全相同的克隆型迁移和表型转换尚需临床数据支持；未涉及髓系细胞或其他免疫细胞的具体贡献细节。",
                "contribution": "揭示了具体的细胞机制：肠道源性ex-T_H17细胞通过分泌IFN-γ和TNF重塑TME，促进CD8+ TILs的招募和活化；并阐明了CD4+与CD8+ T细胞在微生物辅助的ICI治疗中的协同必要性。",
                "facet_id": "F2",
                "possible_uses": "用于回答“微生物调节ICI疗效的机制是什么”。特别适用于描述T细胞亚群的可塑性、肠道-肿瘤轴通讯以及CD4/CD8协作机制。"
              },
              {
                "boundaries": "仅针对Hh这一特定菌种；结果取决于该菌在稳态下诱导调节性T细胞的特性。",
                "contribution": "提供了阴性对照证据：H. hepaticus虽能诱导抗原特异性T细胞迁移至肿瘤，但因诱导Foxp3+调节性表型而非效应表型，故不能增强ICI疗效。",
                "facet_id": "F1",
                "possible_uses": "用于说明并非所有能与肿瘤抗原交叉反应的微生物都能改善预后，强调初始免疫程序（Th17 vs Treg）的重要性。可用于讨论微生物疗法的选择标准或失败案例的分析框架。"
              }
            ],
            "planning_summary": "该论文为综述提供了关于肠道微生物组调节免疫检查点抑制剂（ICI）疗效的具体分子机制素材。它详细阐述了“分子模拟”假说下的细胞级联反应：特定共生菌（SFB）诱导的肠道T_H17细胞迁移至肿瘤部位，在ICI作用下发生表型可塑性转化为促炎的T_H1-like细胞，进而辅助CD8+ T细胞发挥抗肿瘤作用。同时，通过与诱导调节性T细胞的细菌（Hh）对比，强调了菌群诱导的初始T细胞程序类型（促炎vs调节）对最终治疗结局的决定性作用。",
            "scope_interpretation_cautions": [
