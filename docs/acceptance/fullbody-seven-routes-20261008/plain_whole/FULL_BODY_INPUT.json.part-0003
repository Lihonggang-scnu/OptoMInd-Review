        {
          "unit_id": "U3_4",
          "focus": "微生物代谢物通过重塑免疫细胞的能量代谢通路与表观遗传景观，实现抗肿瘤免疫功能的系统性整合，其中功能性通路特征比单一物种分类更具预测价值。",
          "paragraph_tasks": [
            {
              "paragraph_id": "U3_4_P01",
              "point": "论证宏基因组功能通路（如 MEP、核黄素合成）与特定 T 细胞亚群（Vδ2, MAIT）活化的直接关联。",
              "development": "基于 P0444 的 PDTO 共培养与纵向队列数据，说明为何关注代谢通路丰度比单一菌属更能准确预测 ICI 反应。",
              "source_uses": [
                {
                  "source_handle": "P0444",
