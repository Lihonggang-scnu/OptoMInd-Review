          "table_tasks": [],
          "owner_unit_context": {
            "evidence_conditions": "",
            "synthesis": "肌苷的作用具有明确的靶点特异性：它并非单纯作用于免疫细胞，而是通过直接抑制肿瘤细胞 UBA6 来解除对 MHC-I 与炎症通路的转录后抑制（P0582），同时作为 T 细胞的代谢燃料与 A2AR 配体协同增效（P0124, P0584）。CheckMate 025 队列提供了循环肌苷预测 OS 的强临床关联（P0582），但所有研究均受限于无法在人体活检组织中直接定量肌苷浓度，目前仅能依赖血浆水平或 UBA6 表达作为间接代理指标。这一缺口阻碍了确定 TME 内有效抑制 UBA6 所需的肌苷浓度阈值。",
            "transition": "除了直接靶向肿瘤细胞或作为 T 细胞燃料外，更多微生物代谢物通过激活宿主核受体网络，远程调控髓系与淋巴系细胞的极化平衡。",
            "supporting_studies": [
              {
                "contribution": "核心文献，证实肌苷直接结合UBA6解除MHC-I抑制，并指出人体肿瘤内实测浓度缺失的关键转化缺口。",
                "paper_id": "CorpusId:252309032",
                "source_handle": "P0582"
              },
              {
                "contribution": "阐释双歧杆菌来源肌苷经A2AR/cAMP通路促进Th1分化及作为替代碳源维持效应T细胞存活的平行机制。",
                "paper_id": "364d5abc343a02132e4f3f24c0b441cb277190f2",
                "source_handle": "P0124"
              },
              {
                "contribution": "提供腺苷脱氨酶将免疫抑制性腺苷转化为肌苷的药代动力学数据，说明肌苷半衰期延长对微环境暴露的意义。",
                "paper_id": "CorpusId:290154100",
                "source_handle": "P0584"
              },
              {
                "contribution": "对比生态与还原论方法，明确双歧杆菌通过肌苷-A2AR轴增强T细胞活性的分子路径，支撑机制解析。",
                "paper_id": "68b67449fc944c707f68e31b629b3909e59b29ea",
                "source_handle": "P0251"
              },
              {
                "contribution": "提供肌苷联合ICI治疗晚期实体瘤的首个随机对照临床II期数据，证实了肌苷在延长PFS方面的统计学显著性，并为“肠道代谢物调节免疫治疗”假说提供了初步临床支持。",
                "paper_id": "CorpusId:272644866",
                "source_handle": "P0588"
              },
              {
                "contribution": "建立基于单细胞分辨率的药物诱导TME重塑量化框架，发现别嘌醇通过嘌呤补救途径增加肌苷分泌、增强肿瘤免疫原性和T细胞功能的分子机制。",
                "paper_id": "CorpusId:286644045",
                "source_handle": "P0593"
              }
            ]
          },
