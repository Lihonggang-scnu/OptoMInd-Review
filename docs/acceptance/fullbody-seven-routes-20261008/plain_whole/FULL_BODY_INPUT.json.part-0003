        },
        {
          "source_handle": "P0154",
          "title": "Symbiotic bacteria-mediated imbalance and repair of immune homeostasis: exploring novel mechanisms of microbiome-host interactions in atopic dermatitis",
          "year": "2025",
          "doi": "10.3389/fimmu.2025.1649857",
          "paper_id": "443d395fc74f8084d7e8e04c6f91a23b5e25f08d",
          "material_depth": "fulltext",
          "material_status": "resolved",
          "aliases": [],
          "study_summary_A": {
            "approach": "作为一篇综述，本研究未进行新的实验数据采集，而是通过系统性文献回顾，整合了关于皮肤微生物组组成、空间异质性、免疫调节机制以及临床干预措施的多学科证据。作者将材料组织为：1) 皮肤共生菌的组成与空间分布；2) 共生菌在免疫稳态中的作用机制；3) AD的免疫特征与失衡；4) 菌群-免疫-屏障的恶性循环；5) 基于微生物组的临床应用与未来疗法。",
            "contribution_and_limits": [
              {
                "contribution": "提供了AD病理中“菌群-免疫-屏障”三角关系的综合机制框架，特别是明确了共生菌代谢物（SCFAs, 色氨酸衍生物）对AHR和HDAC通路的调控作用。",
                "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及质量评价方法；部分机制描述基于动物模型或体外研究，其在人体内的确切效力尚需更多临床数据验证。"
