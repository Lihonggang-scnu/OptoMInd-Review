        {
          "source_handle": "P0582",
          "title": "Inhibition of UBA6 by inosine augments tumour immunogenicity and responses",
          "year": "2022",
          "doi": "10.1038/s41467-022-33116-z",
          "paper_id": "CorpusId:252309032",
          "material_depth": "fulltext",
          "material_status": "resolved",
          "aliases": [],
          "study_summary_A": {
            "approach": "1. 代谢组学筛选：对接受抗PD-1/抗CTLA-4联合治疗的B16-F0荷瘤小鼠血浆进行非靶向代谢组学分析；重分析人肾细胞癌（RCC）患者CheckMate 025临床试验的血浆代谢数据。 2. 体内药效学评估：在B16-F0（敏感）、B16-GMCSF（抵抗）和4T1（抵抗）小鼠模型中，评估单独使用肌苷、ICB或两者联合治疗的肿瘤生长和生存率。 3. 单细胞转录组与流式细胞术：对4T1肿瘤浸润免疫细胞进行scRNA-seq和流式分析，评估免疫微环境（TIME）的变化（如CD8+ T细胞、巨噬细胞极化）。 4. 体外共培养与机制验证：建立T细胞介导的肿瘤细胞杀伤实验，区分肌苷对T细胞和肿瘤细胞的直接作用；使用LiP-SMap化学蛋白质组学筛选肌苷结合蛋白；通过CRISPR筛选和基因敲除验证UBA6的功能。 5. 生化与分子机制：体外纯化UBA6和USE1蛋白，检测肌苷对UBA6-USE1相互作用及FAT10硫酯键形成的影响；通过RNA-seq和Western Blot分析UBA6缺失对炎症信号和抗原呈递的影响。 6. 临床相关性分析：利用TIDE数据库和自建的人体组织队列（食管癌、肺癌等），分析UBA6表达水平与ICB疗效、患者生存期及CD8+ T细胞浸润的关系。",
            "contribution_and_limits": [
              {
                "contribution": "识别出肌苷作为连接肠道微生物/代谢与ICB疗效的关键代谢物，并揭示其通过直接抑制肿瘤细胞UBA6来增强肿瘤内在免疫原性的新机制。",
                "limits": "所给摘要未交代肌苷在人体内的药代动力学细节及最佳给药剂量；所给摘要未交代肌苷对非嘌呤代谢途径或其他潜在脱靶效应的全面评估；临床验证队列规模较小（n=22用于IHC，部分公共数据），且缺乏对患者内源性肌苷水平的直接测量（因腺苷快速降解为肌苷，测量存在技术挑战）。"
              }
            ],
            "key_findings": [
              {
                "conditions": "B16-F0小鼠模型及人RCC患者队列",
                "finding": "ICB治疗后血浆中嘌呤代谢物（包括肌苷）水平升高；在人RCC患者中，基线高水平肌苷与尼莫单抗（anti-PD1）治疗后的更长总生存期（mOS 33 vs 22个月）相关，但与mTOR抑制剂无关。"
              },
              {
                "conditions": "B16-GMCSF和4T1小鼠模型（ICB抵抗模型）",
                "finding": "肌苷补充剂与ICB联合治疗克服了内在耐药性，显著延长生存期并诱导完全缓解；肌苷不引起系统性炎症或肝毒性。"
              },
              {
                "conditions": "4T1肿瘤微环境",
                "finding": "肌苷+ICB组合治疗将免疫抑制性TIME转化为炎症性TIME，增加M1型巨噬细胞、效应CD8+ T细胞比例，减少M2型巨噬细胞和Treg。"
              },
              {
                "conditions": "体外T细胞-肿瘤细胞共培养",
                "finding": "肌苷预处理肿瘤细胞而非T细胞，显著增强肿瘤细胞对T细胞介导的细胞毒性的敏感性；肌苷上调肿瘤细胞表面MHC-I表达及抗原加工/呈递相关基因。"
              },
              {
                "conditions": "LiP-SMap筛选与CRISPR筛选",
                "finding": "肌苷直接结合并抑制UBA6活性；UBA6缺失使肿瘤细胞对T细胞和NK细胞介导的杀伤更敏感。"
              },
              {
                "conditions": "UBA6功能缺失模型",
                "finding": "UBA6缺失模拟肌苷效应，上调TNF-α、IFN响应基因及MHC-I表达；UBA6缺失消除了肌苷对基因表达的进一步诱导作用，表明肌苷通过抑制UBA6发挥作用。"
              },
              {
                "conditions": "不同肿瘤细胞系（MC38 vs 4T1/B16）",
                "finding": "肌苷仅在高表达UBA6的肿瘤细胞（4T1, B16）中增强免疫原性；在低表达UBA6的MC38细胞中无效，但在过表达UBA6的MC38细胞中恢复效应。"
              },
              {
                "conditions": "人类肿瘤队列（黑色素瘤、NSCLC等）",
                "finding": "肿瘤细胞中高UBA6表达与ICB治疗后的较差无进展生存期（PFS）和总生存期（OS）相关；低UBA6表达与较高的客观缓解率（ORR）和CD8+ T细胞浸润正相关。"
              }
            ],
            "paper_kind": "empirical",
            "problem_or_question": "尽管免疫检查点阻断（ICB）疗法在某些癌症中取得显著成效，但大多数患者无响应或产生耐药性。肿瘤内在因素（如低突变负荷、局部免疫抑制）和宿主因素导致响应异质性。具体而言，肿瘤代谢环境的改变如何调节抗肿瘤免疫反应并影响ICB疗效？特别是肠道微生物群产生的代谢物是否通过特定分子机制直接作用于肿瘤细胞以克服内在耐药性？",
            "research_scope": "小鼠黑色素瘤（B16-F0, B16-GMCSF）和三阴性乳腺癌（4T1）模型，以及人类肾细胞癌（CheckMate 025队列）、黑色素瘤和实体瘤篮式试验患者队列。研究聚焦于免疫检查点阻断（ICB）治疗下的肿瘤代谢微环境与内在免疫原性。",
            "work_summary": "本研究旨在阐明肿瘤代谢状态如何影响免疫检查点阻断（ICB）的疗效。通过小鼠模型的代谢组学筛选和临床队列分析，发现嘌呤代谢物肌苷（inosine）水平与ICB敏感性正相关。机制研究表明，肌苷直接抑制肿瘤细胞内的泛素激活酶UBA6，从而增强肿瘤细胞的抗原呈递能力和对T细胞介导的细胞毒性的敏感性，进而改善抗肿瘤免疫反应。该通路在多种ICB抵抗的小鼠模型中验证了肌苷联合ICB的治疗潜力，并在人类肿瘤样本中证实了UBA6高表达与不良预后及低CD8+ T细胞浸润的相关性。"
          },
          "review_planning_B": {
            "planning_summary": "该论文提供了关于肠道微生物群衍生代谢物（肌苷）如何通过直接靶向肿瘤细胞内在机制（UBA6抑制）来增强免疫检查点抑制剂（ICB）疗效的具体证据。它填补了“微生物代谢物-肿瘤细胞内在属性-免疫响应”这一链条中的关键分子机制空白，特别强调了肿瘤细胞并非被动受体，而是通过代谢感应主动调节其免疫原性。这对于解释为何某些微生物组成有利于ICB响应，以及如何通过代谢干预克服肿瘤内在耐药性具有重要参考价值。",
            "facet_contributions": [
              {
                "boundaries": "主要基于小鼠模型和有限的临床队列；肌苷的来源不仅限于肠道微生物（也可由癌细胞分泌），需结合其他文献明确其在不同情境下的主要来源。",
                "contribution": "提供了肌苷（一种由肠道微生物群产生或受其影响的代谢物）与ICB疗效正相关的临床和体内证据。展示了肌苷水平可作为预测ICB响应的生物标志物。",
                "facet_id": "F1",
                "possible_uses": "用于综述中讨论肠道微生物群代谢产物如何作为系统性信号调节抗肿瘤免疫，特别是那些能够进入血液循环并作用于远端器官（如肿瘤）的代谢物。"
              },
              {
                "boundaries": "机制主要在黑色素瘤和乳腺癌模型中验证；UBA6在其他类型实体瘤中的作用可能不同（如MC38结肠癌模型中UBA6低表达导致肌苷无效）。",
                "contribution": "揭示了肌苷增强ICB疗效的具体分子机制：直接结合并抑制肿瘤细胞内的UBA6（泛素激活酶），从而解除其对炎症信号和抗原呈递通路的抑制，增强肿瘤细胞对T细胞介导杀伤的敏感性。",
                "facet_id": "F2",
                "possible_uses": "用于综述中阐述代谢物调节肿瘤细胞内在状态的机制案例，特别是通过调控泛素化系统或表观遗传/转录后修饰来改变肿瘤免疫原性的路径。"
              },
              {
                "boundaries": "UBA6作为靶点的普适性需在不同肿瘤类型中进一步验证；目前证据显示其效果依赖于肿瘤细胞的基础UBA6表达水平。",
                "contribution": "证明了UBA6是肿瘤内在的免疫检查点，其高表达导致免疫抑制性微环境和ICB耐药，而UBA6缺失或抑制可逆转这一过程。",
                "facet_id": "F2",
                "possible_uses": "用于综述中讨论肿瘤内在因素（如特定酶的表达）如何决定肿瘤对免疫治疗的敏感性，以及这些内在因子作为治疗靶点的潜力。"
              }
            ],
            "broader_review_uses": [
              {
                "connection_to_review": "背景与概念框架",
                "material": "论文指出肿瘤代谢环境改变（如营养短缺、腺苷积累）导致免疫抑制性TME，而肌苷作为腺苷代谢物，其水平受肠道微生物群失调影响。",
                "purpose": "用于综述中构建‘代谢-免疫’交互作用的背景，说明代谢物不仅是能量底物，也是调节免疫微环境的关键信号分子。"
              },
              {
                "connection_to_review": "实例与反例",
