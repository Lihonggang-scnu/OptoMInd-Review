ansition\": \"微生物干预在增强抗肿瘤免疫的同时，亦伴随特定的毒性风险，尤其是当供体特征与强效免疫骨架发生交互时。下一单元将聚焦干预相关安全性与情境依赖性毒性。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供还原论视角下的分子机制证据（如cdAMP-STING、肌苷-A2AR通路），对比生态方法（FMT）与定义菌群的优劣，支撑“菌株特异性决定疗效上限”的综合判断。\",\n                  \"paper_id\": \"68b67449fc944c707f68e31b629b3909e59b29ea\",\n                  \"source_handle\": \"P0251\"\n                },\n                {\n                  \"contribution\": \"汇总早期临床试验中CBM588等定义菌群的探索性信号，强调监管标准化与质控优势的同时，指出缺乏OS/PFS确证数据，平衡安全性收益与疗效不确定性。\",\n                  \"paper_id\": \"6f9060daa22a7c9efcd4a92919035c5e5c24367a\",\n                  \"source_handle\": \"P0261\"\n                },\n                {\n                  \"contribution\": \"提供别嘌醇通过肌苷轴重塑TME并增强ICI疗效的临床前机制与回顾性临床证据，作为非微生物代谢干预案例，对比定义菌群在靶向微环境重塑方面的异同。\",\n                  \"paper_id\": \"CorpusId:286644045\",\n                  \"source_handle\": \"P0593\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0006\",\n              \"P0143\",\n              \"P0125\",\n              \"P0230\",\n              \"P0244\",\n              \"P0251\",\n              \"P0593\",\n              \"P0122\",\n              \"P0387\",\n              \"P0261\",\n              \"P0152\",\n              \"P0578\",\n              \"P0577\",\n              \"P0583\",\n              \"P0212\",\n              \"P0590\",\n              \"P0273\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U03::Ch5_U03_P01\",\n                \"Ch5::Ch5_U03::Ch5_U03_P02\",\n                \"Ch5::Ch5_U03::Ch5_U03_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch5_U04\",\n            \"focus\": \"微生物干预相关的安全性风险及其情境依赖性（ICI 方案、供体特征）。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U04_P01\",\n                \"point\": \"对比 NSCLC 单药与黑色素瘤双药背景下 FMT 联合 ICI 的毒性发生率与起病时间。\",\n                \"development\": \"指出 NSCLC 组无 3 级以上 AEs，而黑色素瘤组 65% 发生 3 级以上 AEs，其中心肌炎发生率 15%（文献报道<1%），且中位起病时间提前至 40 天，提示双免疫骨架放大毒性风险。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 FMT-LUMINate 试验中不同 ICI 方案下的毒性谱差异、心肌炎发生率及起病时间数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U04_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U04_P01\",\n                    \"unit_id\": \"Ch5_U04\",\n                    \"ordinal\": 1,\n                    \"point\": \"对比 NSCLC 单药与黑色素瘤双药背景下 FMT 联合 ICI 的毒性发生率与起病时间。\",\n                    \"development\": \"指出 NSCLC 组无 3 级以上 AEs，而黑色素瘤组 65% 发生 3 级以上 AEs，其中心肌炎发生率 15%（文献报道<1%），且中位起病时间提前至 40 天，提示双免疫骨架放大毒性风险。\",\n                    \"source_handles\": [\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U04_P02\",\n                \"point\": \"揭示供体微生物组特征与 irAEs 的因果关联：Cluster B 供体与 S. copri 定植驱动毒性。\",\n                \"development\": \"说明无监督聚类将供体分为 Cluster A 与 B，后者富含 Prevotella spp.；接受 Cluster B 供体（尤其供体 5）的患者均发生 3 级以上 AEs，且 S. copri 定植与 CD4+ T 细胞亚群增加相关，该关联仅在双 ICI 背景下成立。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供供体聚类分析、Prevotella 富集与心肌炎风险的关联数据及 CD4+ T 细胞亚群变化\"\n                  },\n                  {\n                    \"source_handle\": \"P0250\",\n                    \"role\": \"发展\",\n                    \"use\": \"详述黑色素瘤双 ICI 背景下特定供体引发严重 irAEs 的队列数据，完善毒性情境依赖性的实证链条\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U04_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U04_P02\",\n                    \"unit_id\": \"Ch5_U04\",\n                    \"ordinal\": 2,\n                    \"point\": \"揭示供体微生物组特征与 irAEs 的因果关联：Cluster B 供体与 S. copri 定植驱动毒性。\",\n                    \"development\": \"说明无监督聚类将供体分为 Cluster A 与 B，后者富含 Prevotella spp.；接受 Cluster B 供体（尤其供体 5）的患者均发生 3 级以上 AEs，且 S. copri 定植与 CD4+ T 细胞亚群增加相关，该关联仅在双 ICI 背景下成立。\",\n                    \"source_handles\": [\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U04_P03\",\n                \"point\": \"汇总 FMT 联合 ICI 的总体不良事件谱与文献共识。\",\n                \"development\": \"引用荟萃分析数据（1-2 级 AE 42%，3-4 级 AE 37%），指出双药组毒性更高；同时强调 FDA 对 FMT 传播耐药菌/病毒的警告，凸显供体筛查与制造控制的必要性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0212\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 FMT 联合 ICI 的荟萃分析数据，包括 AE 发生率及异质性分析\"\n                  },\n                  {\n                    \"source_handle\": \"P0178\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 FMT、LBPs 和定义菌群三类干预的安全性汇总及生态药理学因素分析\"\n                  },\n                  {\n                    \"source_handle\": \"P0231\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供跨癌种微生物特征与 irAEs 发生率的对照清单，区分不同免疫骨架下的毒性预测价值\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U04_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U04_P03\",\n                    \"unit_id\": \"Ch5_U04\",\n                    \"ordinal\": 3,\n                    \"point\": \"汇总 FMT 联合 ICI 的总体不良事件谱与文献共识。\",\n                    \"development\": \"引用荟萃分析数据（1-2 级 AE 42%，3-4 级 AE 37%），指出双药组毒性更高；同时强调 FDA 对 FMT 传播耐药菌/病毒的警告，凸显供体筛查与制造控制的必要性。\",\n                    \"source_handles\": [\n                      \"P0212\",\n                      \"P0178\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"安全性数据表明微生物干预并非绝对无害，其毒性谱受 ICI 治疗方案强烈调制；供体特异性菌群（如 Prevotella）在双阻断背景下可能过度激活 CD4+ T 细胞网络并破坏肠道屏障，提示未来试验必须建立基于 ICI 骨架的供体排除标准。\",\n              \"transition\": \"综合初治增效、难治局限、LBPs 探索与毒性警示，本章最后单元将统整当前证据等级，明确缺乏 III 期 RCT 的现状，并指出标准化与人群分层是下一阶段的核心任务。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"详述黑色素瘤双ICI背景下特定供体（Cluster B）引发严重irAEs的队列数据，揭示Prevotella富集与心肌炎风险的因果关联，完善毒性情境依赖性的实证链条。\",\n                  \"paper_id\": \"67a11dcbb1430387e3630bb0ffa834eccc29fa4f\",\n                  \"source_handle\": \"P0250\"\n                },\n                {\n                  \"contribution\": \"提供跨癌种微生物特征与irAEs发生率的对照清单，区分厚壁菌门/拟杆菌门在不同免疫骨架下的毒性预测价值，避免将单一菌属的副作用风险泛化至所有干预场景。\",\n                  \"paper_id\": \"608ca9e37ce71dcbbe9281286a7b96096c05b73c\",\n                  \"source_handle\": \"P0231\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0583\",\n              \"P0250\",\n              \"P0212\",\n              \"P0178\",\n              \"P0231\",\n              \"P0578\",\n              \"P0577\",\n              \"P0590\",\n              \"P0152\",\n              \"P0273\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U04::Ch5_U04_P01\",\n                \"Ch5::Ch5_U04::Ch5_U04_P02\",\n                \"Ch5::Ch5_U04::Ch5_U04_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch5_U05\",\n            \"focus\": \"当前证据等级局限（缺乏 III 期 RCT）与转化瓶颈（标准化、供体匹配、方法学）。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U05_P01\",\n                \"point\": \"确认尚无已完成的大型随机对照 III 期临床试验证实微生物干预在 ICI 治疗中的确切疗效。\",\n                \"development\": \"明确指出 TACITO 为 Phase 2a，MITRIC/MIMIC/LUMINate 均为单臂或早期设计；多项系统评价一致呼吁开展大规模、多中心、标准化的 III 期 RCT 以验证生存获益并优化方案。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0212\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供荟萃分析结论，指出当前缺乏标准化协议及大样本 RCT 证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供优化 FMT 以增强 ICI 疗效的概念图，强调从混乱到秩序的标准化需求\"\n                  },\n                  {\n                    \"source_handle\": \"P0333\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供肠道 - 代谢物 - 免疫轴综述，指出当前临床转化阶段的证据局限\"\n                  },\n                  {\n                    \"source_handle\": \"P0590\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供结直肠癌领域微生物组临床意义的综述，强调 FMT 仍处于实验性阶段\"\n                  },\n                  {\n                    \"source_handle\": \"P0417\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供肠道微生物组对 ICI 疗效影响的系统评价，确认当前证据等级与异质性\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"负责人指定\",\n                    \"use\": \"\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U05_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U05_P01\",\n                    \"unit_id\": \"Ch5_U05\",\n                    \"ordinal\": 1,\n                    \"point\": \"确认尚无已完成的大型随机对照 III 期临床试验证实微生物干预在 ICI 治疗中的确切疗效。\",\n                    \"development\": \"明确指出 TACITO 为 Phase 2a，MITRIC/MIMIC/LUMINate 均为单臂或早期设计；多项系统评价一致呼吁开展大规模、多中心、标准化的 III 期 RCT 以验证生存获益并优化方案。\",\n                    \"source_handles\": [\n                      \"P0212\",\n                      \"P0573\",\n                      \"P0584\",\n                      \"P0590\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U05_P02\",\n                \"point\": \"剖析影响疗效可重复性的关键变量：供体来源、预处理策略与给药途径的异质性。\",\n                \"development\": \"比较健康供体与 ICI 响应者供体的优劣争议；指出抗生素预处理（如 SER-401 试验）可能破坏保护性免疫准备；口服胶囊与内镜给药的定植效率差异尚未统一。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0178\",\n                    \"role\": \"主论据\",\n                    \"use\": \"分析影响干预效果的生态学和药理学因素（如抗生素使用、基线菌群状态）\"\n                  },\n                  {\n                    \"source_handle\": \"P0304\",\n                    \"role\": \"主论据\",\n                    \"use\": \"系统评价肠道微生物组改变药物及 FMT 对 ICI 疗效与毒性的影响，指出抗生素负面影响的例外情况\"\n                  },\n                  {\n                    \"source_handle\": \"P0546\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述肠道微生物组调节 ICI 的机制，指出临床疗效数据主要来自早期试验，效力证据等级有限\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U05_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U05_P02\",\n                    \"unit_id\": \"Ch5_U05\",\n                    \"ordinal\": 2,\n                    \"point\": \"剖析影响疗效可重复性的关键变量：供体来源、预处理策略与给药途径的异质性。\",\n                    \"development\": \"比较健康供体与 ICI 响应者供体的优劣争议；指出抗生素预处理（如 SER-401 试验）可能破坏保护性免疫准备；口服胶囊与内镜给药的定植效率差异尚未统一。\",\n                    \"source_handles\": [\n                      \"P0178\",\n                      \"P0304\",\n                      \"P0546\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U05_P03\",\n                \"point\": \"提出解决转化瓶颈的方法学路径：纵向监测、功能预测模型与生态药理学框架。\",\n                \"development\": \"强调单次基线测序不足以捕捉动态演变；建议整合宏基因组功能注释、宿主免疫表型与机器学习构建预测模型；倡导将微生物干预视为\\\"生态扰动\\\"而非简单药物添加，需制定统一的报告与安全监测标准。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0363\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 gut microbiome–TME axis 综述，界定当前领域边界及识别研究空白（如缺乏前瞻性验证）\"\n                  },\n                  {\n                    \"source_handle\": \"P0329\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供设计性活体生物疗法恢复响应者样微生物组特征的预测模型概念验证\"\n                  },\n                  {\n                    \"source_handle\": \"P0357\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述益生菌在癌症免疫治疗中的应用，指出当前证据局限性和未来研究方法学建议\"\n                  },\n                  {\n                    \"source_handle\": \"P0273\",\n                    \"role\": \"发展\",\n                    \"use\": \"批判性评估当前领域缺乏前瞻性验证与技术标准化的现状，呼吁开展大型多中心队列研究与随机干预试验\"\n                  },\n                  {\n                    \"source_handle\": \"P0303\",\n                    \"role\": \"发展\",\n                    \"use\": \"指出测序平台、样本采集时间点及地理饮食混杂因素导致的结果异质性，提出整合宏基因组功能注释与宿主免疫表型的纵向监测协议\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U05_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U05_P03\",\n                    \"unit_id\": \"Ch5_U05\",\n                    \"ordinal\": 3,\n                    \"point\": \"提出解决转化瓶颈的方法学路径：纵向监测、功能预测模型与生态药理学框架。\",\n                    \"development\": \"强调单次基线测序不足以捕捉动态演变；建议整合宏基因组功能注释、宿主免疫表型与机器学习构建预测模型；倡导将微生物干预视为\\\"生态扰动\\\"而非简单药物添加，需制定统一的报告与安全监测标准。\",\n                    \"source_handles\": [\n                      \"P0363\",\n                      \"P0329\",\n                      \"P0357\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"微生物干预已从现象观察步入机制驱动的干预设计阶段，但临床转化仍受制于证据等级偏低与操作规范缺失。唯有通过严格设计的 III 期 RCT、标准化的供体 - 受体匹配算法以及针对特定 ICI 骨架的安全阈值界定，方能将该领域的概念验证转化为可常规应用的精准医疗手段。\",\n              \"transition\": \"本章对微生物干预临床现状的系统评估，自然过渡至下一章对微生物组与免疫治疗毒性（irAEs）深层关联的探讨，并为后续方法学挑战章节奠定实证基础。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"批判性评估当前领域缺乏前瞻性验证与技术标准化的现状，呼吁开展大型多中心队列研究与随机干预试验，为转化瓶颈提供方法论层面的改进路径。\",\n                  \"paper_id\": \"759b176490dcac135bff0b645dc106c3df8f4059\",\n                  \"source_handle\": \"P0273\"\n                },\n                {\n                  \"contribution\": \"指出测序平台、样本采集时间点及地理饮食混杂因素导致的结果异质性，提出整合宏基因组功能注释与宿主免疫表型的纵向监测协议，作为解决可重复性危机的具体方案。\",\n                  \"paper_id\": \"847cf10f8ac760ce125802cd31697c58f8dbf822\",\n                  \"source_handle\": \"P0303\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0212\",\n              \"P0573\",\n              \"P0333\",\n              \"P0590\",\n              \"P0417\",\n              \"P0584\",\n              \"P0178\",\n              \"P0304\",\n              \"P0546\",\n              \"P0363\",\n              \"P0329\",\n              \"P0357\",\n              \"P0273\",\n              \"P0303\",\n              \"P0578\",\n              \"P0577\",\n              \"P0583\",\n              \"P0152\",\n              \"P0585\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U05::Ch5_U05_P01\",\n                \"Ch5::Ch5_U05::Ch5_U05_P02\",\n                \"Ch5::Ch5_U05::Ch5_U05_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch6\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"微生物组与免疫治疗毒性的关联\",\n          \"chapter_purpose\": \"明确微生物组作为 ICI 毒性预测标志物的临床潜力与局限，理解疗效与毒性耦合/解耦的生物学基础，并掌握基于供体特征与 ICI 方案的情境化安全性管理策略。特别需注意非结肠炎 irAEs（如心肌炎、神经毒性）的微生物组证据仍受限于样本量，当前结论主要基于结肠炎数据。\",\n          \"chapter_scope\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因癌种特异性、毒性表型（结肠炎 vs 心肌炎）及干预情境（供体特征、ICI 骨架方案）而异。观察性关联在结肠炎中证据最强，心肌炎等罕见 irAEs 仍受限于样本量；微生物干预（如 FMT）的获益与风险高度依赖于供体菌群组成与联合用药方案的交互作用。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用。\",\n          \"chapter_thesis\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因癌种特异性、毒性表型（结肠炎 vs 心肌炎）及干预情境（供体特征、ICI 骨架方案）而异。观察性关联在结肠炎中证据最强，心肌炎等罕见 irAEs 仍受限于样本量；微生物干预（如 FMT）的获益与风险高度依赖于供体菌群组成与联合用药方案的交互作用。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用。\",\n          \"chapter_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因癌种特异性、毒性表型（结肠炎 vs 心肌炎）及干预情境（供体特征、ICI 骨架方案）而异。观察性关联在结肠炎中证据最强，心肌炎等罕见 irAEs 仍受限于样本量；微生物干预（如 FMT）的获益与风险高度依赖于供体菌群组成与联合用药方案的交互作用。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用。\",\n          \"reader_objective\": \"明确微生物组作为 ICI 毒性预测标志物的临床潜力与局限，理解疗效与毒性耦合/解耦的生物学基础，并掌握基于供体特征与 ICI 方案的情境化安全性管理策略。特别需注意非结肠炎 irAEs（如心肌炎、神经毒性）的微生物组证据仍受限于样本量，当前结论主要基于结肠炎数据。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"Ch6_U1\",\n            \"focus\": \"特定菌属与 irAEs 的癌种特异性关联及预测模型困境\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch6_U1_P01\",\n                \"point\": \"结肠炎型 irAEs 的微生物指纹与整体多样性下降\",\n                \"development\": \"比较结肠炎型与非结肠炎型 irAE 患者的粪便宏基因组/16S 特征，指出主要产丁酸菌丰度降低、拟杆菌门/双歧杆菌减少及肠球菌富集是结肠炎的核心表型。P0017 通过抗生素预处理小鼠 FMT 实验验证其因果致病潜力：接受结肠炎型患者菌群移植的小鼠出现致命性严重结肠炎（3/9 死亡），而非结肠炎型菌群移植小鼠全部存活。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0017\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供结肠炎型患者菌群移植小鼠出现致命性严重结肠炎的因果证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0600\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供肺癌及多癌种队列中结肠炎与非结肠炎 irAEs 的微生物指纹差异，并通过人源化小鼠 FMT 实验确立菌群致结肠炎的因果性\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U1_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U1_P01\",\n                    \"unit_id\": \"Ch6_U1\",\n                    \"ordinal\": 1,\n                    \"point\": \"结肠炎型 irAEs 的微生物指纹与整体多样性下降\",\n                    \"development\": \"比较结肠炎型与非结肠炎型 irAE 患者的粪便宏基因组/16S 特征，指出主要产丁酸菌丰度降低、拟杆菌门/双歧杆菌减少及肠球菌富集是结肠炎的核心表型。P0017 通过抗生素预处理小鼠 FMT 实验验证其因果致病潜力：接受结肠炎型患者菌群移植的小鼠出现致命性严重结肠炎（3/9 死亡），而非结肠炎型菌群移植小鼠全部存活。\",\n                    \"source_handles\": [\n                      \"P0017\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U1_P02\",\n                \"point\": \"胃肠道癌症的保护性菌群与器官特异性毒性差异\",\n                \"development\": \"聚焦食管癌、胃癌、结直肠癌队列（P0011，n=95），指出 Ruminococcus callidus 和 Bacteroides xylanisolvens 在无重症 irAEs 患者中显著富集，且尿素循环/精氨酸生物合成通路与低毒性相关。同时强调皮肤、血液、内分泌及肝脏毒性各自呈现独立的微生物通路特征，反驳单一通用标志物假设。但需注意该研究样本量有限且缺乏外部验证。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0011\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供胃肠道癌症队列中 Ruminococcus callidus 和 Bacteroides xylanisolvens 富集与低毒性相关的实证数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U1_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U1_P02\",\n                    \"unit_id\": \"Ch6_U1\",\n                    \"ordinal\": 2,\n                    \"point\": \"胃肠道癌症的保护性菌群与器官特异性毒性差异\",\n                    \"development\": \"聚焦食管癌、胃癌、结直肠癌队列（P0011，n=95），指出 Ruminococcus callidus 和 Bacteroides xylanisolvens 在无重症 irAEs 患者中显著富集，且尿素循环/精氨酸生物合成通路与低毒性相关。同时强调皮肤、血液、内分泌及肝脏毒性各自呈现独立的微生物通路特征，反驳单一通用标志物假设。但需注意该研究样本量有限且缺乏外部验证。\",\n                    \"source_handles\": [\n                      \"P0011\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U1_P03\",\n                \"point\": \"预测模型的构建困境与非结肠炎 irAEs 证据不足\",\n                \"development\": \"评估基于机器学习（如 RF14 分类器，P0308）的 irAEs 预测模型性能，指出尽管 AUC 可达 0.88，但在多重检验校正后部分特征显著性不足。P0312 综述指出，即使在大样本队列中，非结肠炎 irAEs（如心肌炎、神经毒性）的样本量仍不足以支持独立的微生物组分析，当前证据主要集中于结肠炎。不同研究间测序平台、CTCAE 分级版本及队列异质性导致模型泛化能力受限。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0308\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 RF14 分类器性能数据及多重检验校正后特征显著性不足的证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0312\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述指出非结肠炎 irAEs 样本量不足以支持独立微生物组分析的限制\"\n                  },\n                  {\n                    \"source_handle\": \"P0049\",\n                    \"role\": \"局限\",\n                    \"use\": \"揭示 F. prausnitzii 等标志物在多重检验下的不一致性及大样本队列中非结肠炎亚组样本量极小（n=2）的现状\"\n                  },\n                  {\n                    \"source_handle\": \"P0605\",\n                    \"role\": \"局限\",\n                    \"use\": \"量化心肌炎/脑膜炎等亚组样本量极小，直接支撑预测模型构建困境及非结肠炎毒性证据不足的论述\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U1_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U1_P03\",\n                    \"unit_id\": \"Ch6_U1\",\n                    \"ordinal\": 3,\n                    \"point\": \"预测模型的构建困境与非结肠炎 irAEs 证据不足\",\n                    \"development\": \"评估基于机器学习（如 RF14 分类器，P0308）的 irAEs 预测模型性能，指出尽管 AUC 可达 0.88，但在多重检验校正后部分特征显著性不足。P0312 综述指出，即使在大样本队列中，非结肠炎 irAEs（如心肌炎、神经毒性）的样本量仍不足以支持独立的微生物组分析，当前证据主要集中于结肠炎。不同研究间测序平台、CTCAE 分级版本及队列异质性导致模型泛化能力受限。\",\n                    \"source_handles\": [\n                      \"P0308\",\n                      \"P0312\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"微生物组对 irAEs 的预测价值呈现显著的癌种与器官特异性，结肠炎表型的微生物驱动证据最为坚实（包括动物因果验证），而其他毒性类型（心肌炎、神经毒性等）的独立预测标志物仍需大样本前瞻性队列验证。当前非结肠炎 irAEs 的微生物组证据受限于样本量，不能外推为领域层面的确定性结论。\",\n              \"transition\": \"在确认特定菌群与毒性关联的基础上，需进一步解析为何某些微生物特征既能促进抗肿瘤响应，又会引发过度免疫激活，从而引出疗效与毒性的耦合与解耦机制。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供肺癌及多癌种队列中结肠炎与非结肠炎irAEs的微生物指纹差异，并通过人源化小鼠FMT实验确立菌群致结肠炎的因果性，直接支撑癌种特异性关联与样本量局限性的论述。\",\n                  \"paper_id\": \"CorpusId:257062954\",\n                  \"source_handle\": \"P0600\"\n                },\n                {\n                  \"contribution\": \"基于大样本前瞻性队列揭示Ruminococcaceae科动态下降与严重irAEs的关联，并剖析F. prausnitzii等标志物在多重检验下的不一致性，用于论证预测模型构建的方法学困境。\",\n                  \"paper_id\": \"1607ffdb79bd5dbb1f94932e27410c55f0aa8290\",\n                  \"source_handle\": \"P0049\"\n                },\n                {\n                  \"contribution\": \"提供大样本前瞻性纵向队列数据，证实Ruminococcaceae动态耗竭与严重irAEs关联，并量化心肌炎/脑膜炎等亚组样本量极小（n=2），直接支撑预测模型构建困境及非结肠炎毒性证据不足的论述。\",\n                  \"paper_id\": \"CorpusId:275340168\",\n                  \"source_handle\": \"P0605\"\n                }\n              ]\n            },\n            \"unit_notes\": \"将 P0600 从 case_level_uses 整合进 P01，强化因果证据；将 P0049/P0605 整合进 P03，明确样本量局限。\",\n            \"source_handles\": [\n              \"P0017\",\n              \"P0600\",\n              \"P0011\",\n              \"P0308\",\n              \"P0312\",\n              \"P0049\",\n              \"P0605\",\n              \"P0601\",\n              \"P0595\",\n              \"P0597\",\n              \"P0596\",\n              \"P0261\",\n              \"P0319\",\n              \"P0447\",\n              \"P0297\",\n              \"P0146\",\n              \"P0609\",\n              \"P0460\",\n              \"P0486\",\n              \"P0604\",\n              \"P0602\",\n              \"P0462\",\n              \"P0284\",\n              \"P0067\",\n              \"P0314\",\n              \"P0409\",\n              \"P0197\",\n              \"P0598\",\n              \"P0578\",\n              \"P0212\",\n              \"P0590\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch6::Ch6_U1::Ch6_U1_P01\",\n                \"Ch6::Ch6_U1::Ch6_U1_P02\",\n                \"Ch6::Ch6_U1::Ch6_U1_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch6_U2\",\n            \"focus\": \"疗效与毒性的耦合及解耦关系与免疫稳态中介\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch6_U2_P01\",\n                \"point\": \"共享免疫激活通路的\\\"双刃剑\\\"效应\",\n                \"development\": \"指出高丰度 Akkermansia muciniphila 在 NSCLC 队列中与延长 OS 正相关，但同时增加 irAEs 风险（P0260），提示微生物介导的 CD8+ T 细胞活化与 IFN-γ分泌是疗效提升与自身免疫毒性共有的上游驱动力。这种关联是观察性的，不能推断因果。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0260\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 Akkermansia muciniphila 与 OS 正相关但增加 irAEs 风险的观察性关联证据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U2_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U2_P01\",\n                    \"unit_id\": \"Ch6_U2\",\n                    \"ordinal\": 1,\n                    \"point\": \"共享免疫激活通路的\\\"双刃剑\\\"效应\",\n                    \"development\": \"指出高丰度 Akkermansia muciniphila 在 NSCLC 队列中与延长 OS 正相关，但同时增加 irAEs 风险（P0260），提示微生物介导的 CD8+ T 细胞活化与 IFN-γ分泌是疗效提升与自身免疫毒性共有的上游驱动力。这种关联是观察性的，不能推断因果。\",\n                    \"source_handles\": [\n                      \"P0260\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U2_P02\",\n                \"point\": \"解耦路径：特定菌属与无毒性响应的共存\",\n                \"development\": \"对比黑色素瘤纵向队列数据（P0239），发现 Eubacterium siraeum 高丰度与无 irAEs 的客观缓解状态显著相关，且短链脂肪酸产生菌（如 Coprococcus comes, Blautia glucerasea）在未发生 irAEs 的患者中同样富集（P0428），挑战\\\"毒性必然预示疗效\\\"的直觉假设。但需注意这些发现主要来自回顾性分析。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0239\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 Eubacterium siraeum 高丰度与无 irAEs 的客观缓解状态显著相关的纵向队列数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0428\",\n                    \"role\": \"例证\",\n                    \"use\": \"证实 SCFA 产生菌在无 irAEs 响应者中显著富集，为解耦疗效与毒性提供直接的表型证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0314\",\n                    \"role\": \"例证\",\n                    \"use\": \"识别 Blautia luti 等 Lachnospiraceae 成员与“有效且无 irAE\\\"状态的独立关联，补充代谢功能菌群线索\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U2_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U2_P02\",\n                    \"unit_id\": \"Ch6_U2\",\n                    \"ordinal\": 2,\n                    \"point\": \"解耦路径：特定菌属与无毒性响应的共存\",\n                    \"development\": \"对比黑色素瘤纵向队列数据（P0239），发现 Eubacterium siraeum 高丰度与无 irAEs 的客观缓解状态显著相关，且短链脂肪酸产生菌（如 Coprococcus comes, Blautia glucerasea）在未发生 irAEs 的患者中同样富集（P0428），挑战\\\"毒性必然预示疗效\\\"的直觉假设。但需注意这些发现主要来自回顾性分析。\",\n                    \"source_handles\": [\n                      \"P0239\",\n                      \"P0428\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U2_P03\",\n                \"point\": \"基线免疫稳态与纵向动态变化的中介作用\",\n                \"development\": \"整合黑色素瘤配对粪便与外周血 PBMC 纵向数据（P0098，n=126），显示基线拟杆菌属（Bacteroides）高丰度与治疗后 Tregs 频率显著下降相关，且 Tregs 耗竭程度直接预测严重 irAEs 的发生；相反，瘤胃球菌科（Ruminococcaceae）主导的基线状态则与更好的治疗响应及较低的毒性风险同步出现。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0098\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供基线拟杆菌属高丰度与 Tregs 频率下降及严重 irAEs 相关的纵向免疫细胞动态数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0049\",\n                    \"role\": \"发展\",\n                    \"use\": \"揭示基线病原共生菌富集与治疗早期产丁酸菌耗竭的时序特征，为免疫稳态失衡提供临床动态证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0605\",\n                    \"role\": \"发展\",\n                    \"use\": \"通过纵向宏基因组数据证实 Ruminococcaceae 动态耗竭与严重 irAEs 关联，补充免疫稳态失衡的微生物组证据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U2_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U2_P03\",\n                    \"unit_id\": \"Ch6_U2\",\n                    \"ordinal\": 3,\n                    \"point\": \"基线免疫稳态与纵向动态变化的中介作用\",\n                    \"development\": \"整合黑色素瘤配对粪便与外周血 PBMC 纵向数据（P0098，n=126），显示基线拟杆菌属（Bacteroides）高丰度与治疗后 Tregs 频率显著下降相关，且 Tregs 耗竭程度直接预测严重 irAEs 的发生；相反，瘤胃球菌科（Ruminococcaceae）主导的基线状态则与更好的治疗响应及较低的毒性风险同步出现。\",\n                    \"source_handles\": [\n                      \"P0098\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"疗效与毒性的耦合源于微生物驱动的广谱免疫激活，而解耦则依赖于特定共生菌维持的 Treg 稳态与屏障完整性；基线免疫细胞亚群比例可作为区分\\\"有益激活\\\"与\\\"病理性炎症\\\"的关键中介指标。但解耦证据主要来自回顾性分析，尚未通过干预试验证实。\",\n              \"transition\": \"当微生物干预被用于逆转耐药或增强疗效时，其安全性表现并非均一，而是强烈依赖于供体来源特征与联合使用的 ICI 药物骨架，这构成了本章第三部分的实证核心。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"通过对比晚期黑色素瘤响应亚组基线特征，证实SCFA产生菌（如Coprococcus comes, Blautia glucerasea）在无irAEs响应者中显著富集，为解耦疗效与毒性提供直接的表型证据。\",\n                  \"paper_id\": \"bb6b1be372fbcd8282307d93b91745ca4c844e92\",\n                  \"source_handle\": \"P0428\"\n                },\n                {\n                  \"contribution\": \"前瞻性纵向数据识别Blautia luti等Lachnospiraceae成员与“有效且无irAE”状态的独立关联，补充了特定代谢功能菌群实现疗效-毒性解耦的分子线索。\",\n                  \"paper_id\": \"873fa8f3f156b691e03d1431a71f79cf1fa30374\",\n                  \"source_handle\": \"P0314\"\n                },\n                {\n                  \"contribution\": \"通过纵向宏基因组数据揭示基线病原共生菌富集与治疗早期产丁酸菌耗竭的时序特征，为微生物组介导的免疫稳态失衡及疗效-毒性耦合关系提供具体的临床动态证据。\",\n                  \"paper_id\": \"CorpusId:275340168\",\n                  \"source_handle\": \"P0605\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0260\",\n              \"P0239\",\n              \"P0428\",\n              \"P0314\",\n              \"P0098\",\n              \"P0049\",\n              \"P0605\",\n              \"P0601\",\n              \"P0595\",\n              \"P0597\",\n              \"P0596\",\n              \"P0261\",\n              \"P0319\",\n              \"P0447\",\n              \"P0297\",\n              \"P0146\",\n              \"P0609\",\n              \"P0460\",\n              \"P0486\",\n              \"P0604\",\n              \"P0600\",\n              \"P0602\",\n              \"P0462\",\n              \"P0284\",\n              \"P0017\",\n              \"P0011\",\n              \"P0067\",\n              \"P0409\",\n              \"P0197\",\n              \"P0598\",\n              \"P0578\",\n              \"P0212\",\n              \"P0590\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch6::Ch6_U2::Ch6_U2_P01\",\n                \"Ch6::Ch6_U2::Ch6_U2_P02\",\n                \"Ch6::Ch6_U2::Ch6_U2_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch6_U3\",\n            \"focus\": \"微生物干预的安全性与供体特征的情境依赖性\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch6_U3_P01\",\n                \"point\": \"FMT-LUMINate 试验的疗效分化与毒性起病时间提前\",\n                \"development\": \"报告 NSCLC 队列（抗 PD-1 单药，n=20）ORR 达 80% 且无≥3 级 AEs；而黑色素瘤队列（抗 PD-1+ 抗 CTLA-4 双免，n=20）ORR 为 75%，但 65% 患者经历≥3 级 AEs，其中腹泻/结肠炎占 20%，心肌炎发生率高达 15%（文献报道通常<1%），且严重毒性中位起病时间提前至 40 天（P0583）。需明确这是 Phase II 单臂试验，非 Phase III RCT。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"报告 FMT-LUMINate 试验中双免背景下 ORR 75% 但 65% 患者经历≥3 级 AEs 及心肌炎发生率高达 15% 的数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0578\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供 MITRIC 试验在难治人群中 ORR 0% 的结果，对比显示干预效果在初治与难治人群中的异质性\"\n                  },\n                  {\n                    \"source_handle\": \"P0212\",\n                    \"role\": \"背景\",\n                    \"use\": \"荟萃分析量化 FMT 联合 ICI 的总体 ORR 及 3-4 级 AE 发生率，为安全性边界提供定量基准\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U3_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U3_P01\",\n                    \"unit_id\": \"Ch6_U3\",\n                    \"ordinal\": 1,\n                    \"point\": \"FMT-LUMINate 试验的疗效分化与毒性起病时间提前\",\n                    \"development\": \"报告 NSCLC 队列（抗 PD-1 单药，n=20）ORR 达 80% 且无≥3 级 AEs；而黑色素瘤队列（抗 PD-1+ 抗 CTLA-4 双免，n=20）ORR 为 75%，但 65% 患者经历≥3 级 AEs，其中腹泻/结肠炎占 20%，心肌炎发生率高达 15%（文献报道通常<1%），且严重毒性中位起病时间提前至 40 天（P0583）。需明确这是 Phase II 单臂试验，非 Phase III RCT。\",\n                    \"source_handles\": [\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U3_P02\",\n                \"point\": \"供体微生物组聚类与特定毒性事件的因果关联\",\n                \"development\": \"基于 Bray-Curtis 指数无监督聚类将健康供体分为 Cluster A 与 Cluster B（含供体 5、11）。Cluster B 以 Segatella copri、Prevotella sp. Marseille-P4119 等高丰度为特征。接受 Cluster B 供体 FMT 的黑色素瘤患者中，这些菌属显著富集并与≥3 级 AEs 强相关；进一步流式分析显示 S. copri 定植与外周血 CD4+ T 细胞亚群比例增加相关，且该毒性仅在双 ICI 背景下显现，单药抗 PD-1 治疗中未观察到类似风险（P0583）。但 Prevotella 诱导心肌炎的具体分子机制（抗原或代谢物）尚未解析。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供供体无监督聚类结果及 Cluster B（Prevotella 富集）与≥3 级 AEs 强相关的因果关联证据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U3_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U3_P02\",\n                    \"unit_id\": \"Ch6_U3\",\n                    \"ordinal\": 2,\n                    \"point\": \"供体微生物组聚类与特定毒性事件的因果关联\",\n                    \"development\": \"基于 Bray-Curtis 指数无监督聚类将健康供体分为 Cluster A 与 Cluster B（含供体 5、11）。Cluster B 以 Segatella copri、Prevotella sp. Marseille-P4119 等高丰度为特征。接受 Cluster B 供体 FMT 的黑色素瘤患者中，这些菌属显著富集并与≥3 级 AEs 强相关；进一步流式分析显示 S. copri 定植与外周血 CD4+ T 细胞亚群比例增加相关，且该毒性仅在双 ICI 背景下显现，单药抗 PD-1 治疗中未观察到类似风险（P0583）。但 Prevotella 诱导心肌炎的具体分子机制（抗原或代谢物）尚未解析。\",\n                    \"source_handles\": [\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U3_P03\",\n                \"point\": \"益生菌的双向调节与伴随用药的干扰效应\",\n                \"development\": \"指出特定共生菌（如 LGG）可通过释放脂磷壁酸激活巨噬细胞保护肠上皮，但在免疫抑制状态下存在机会性感染风险（P0040）；同时汇总药物警戒数据，显示 PPI 联用可能增加肝胆及皮肤毒性报告率（P0088），而近期广谱抗生素暴露不仅削弱疗效，还独立增加严重结肠炎风险（P0310）。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0040\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出 LGG 激活巨噬细胞保护肠上皮但在免疫抑制状态下存在机会性感染风险\"\n                  },\n                  {\n                    \"source_handle\": \"P0088\",\n                    \"role\": \"例证\",\n                    \"use\": \"汇总药物警戒数据，显示 PPI 联用可能增加肝胆及皮肤毒性报告率\"\n                  },\n                  {\n                    \"source_handle\": \"P0310\",\n                    \"role\": \"例证\",\n                    \"use\": \"显示近期广谱抗生素暴露独立增加严重结肠炎风险\"\n                  },\n                  {\n                    \"source_handle\": \"P0357\",\n                    \"role\": \"发展\",\n                    \"use\": \"系统梳理益生菌菌株特异性效应及商业制剂异质性，阐明其在调节 irAEs 中的双向作用及定植挑战\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U3_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U3_P03\",\n                    \"unit_id\": \"Ch6_U3\",\n                    \"ordinal\": 3,\n                    \"point\": \"益生菌的双向调节与伴随用药的干扰效应\",\n                    \"development\": \"指出特定共生菌（如 LGG）可通过释放脂磷壁酸激活巨噬细胞保护肠上皮，但在免疫抑制状态下存在机会性感染风险（P0040）；同时汇总药物警戒数据，显示 PPI 联用可能增加肝胆及皮肤毒性报告率（P0088），而近期广谱抗生素暴露不仅削弱疗效，还独立增加严重结肠炎风险（P0310）。\",\n                    \"source_handles\": [\n                      \"P0040\",\n                      \"P0088\",\n                      \"P0310\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [\n              {\n                \"table_id\": \"Ch6_U3_T01\",\n                \"purpose\": \"比较 FMT 供体聚类特征与 ICI 方案交互下的毒性风险\",\n                \"columns\": [\n                  \"供体聚类\",\n                  \"特征菌属\",\n                  \"ICI 方案背景\",\n                  \"主要毒性事件\",\n                  \"发生率/关联强度\"\n                ],\n                \"row_tasks\": [\n                  {\n                    \"content\": \"Cluster A (非 Prevotella 富集)\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0583\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 Cluster A 供体在双免背景下的安全性基线数据\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"Cluster B (Prevotella/Segatella 富集)\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0583\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 Cluster B 供体与加速发作心肌炎及≥3 级 AEs 的强关联数据\"\n                      }\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"微生物干预的安全性具有严格的情境依赖性：供体菌群特征（如 Prevotella 富集）与 ICI 骨架（双免 vs 单免）的交互作用是触发加速发作心肌炎等严重 irAEs 的决定性因素，提示未来 FMT 试验必须建立基于供体聚类的风险分层筛选标准。但目前证据主要来自 Phase II 试验，缺乏 Phase III RCT 验证，且 Prevotella 诱导心肌炎的具体分子通路未完全解析。\",\n              \"transition\": \"上述临床表型与干预结果的背后，隐藏着从肠道屏障破坏到远端器官免疫风暴的多层次分子通路，下一章将系统拆解介导这些毒性效应的具体生物学机制。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"荟萃分析量化FMT联合ICI的总体ORR(43%)及3-4级AE发生率(37%)，明确双药方案下毒性风险显著升高，为评估供体选择与免疫骨架交互的安全性边界提供定量基准。\",\n                  \"paper_id\": \"5af3aee4ca5f3778325d44c8432c8b71b95ca531\",\n                  \"source_handle\": \"P0212\"\n                },\n                {\n                  \"contribution\": \"系统梳理益生菌菌株特异性效应及商业制剂异质性，阐明其在调节irAEs中的双向作用及定植挑战，用于支撑干预策略安全性讨论中的菌株依赖性与监管障碍。\",\n                  \"paper_id\": \"9bda8266e0dc2c5949effec25ef1dea48f7de6ee\",\n                  \"source_handle\": \"P0357\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0583\",\n              \"P0578\",\n              \"P0212\",\n              \"P0040\",\n              \"P0088\",\n              \"P0310\",\n              \"P0357\",\n              \"P0601\",\n              \"P0595\",\n              \"P0597\",\n              \"P0596\",\n              \"P0261\",\n              \"P0319\",\n              \"P0447\",\n              \"P0297\",\n              \"P0146\",\n              \"P0609\",\n              \"P0460\",\n              \"P0486\",\n              \"P0604\",\n              \"P0600\",\n              \"P0602\",\n              \"P0462\",\n              \"P0284\",\n              \"P0017\",\n              \"P0011\",\n              \"P0067\",\n              \"P0314\",\n              \"P0409\",\n              \"P0197\",\n              \"P0598\",\n              \"P0590\",\n              \"P0049\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch6::Ch6_U3::Ch6_U3_P01\",\n                \"Ch6::Ch6_U3::Ch6_U3_P02\",\n                \"Ch6::Ch6_U3::Ch6_U3_P03\"\n              ],\n              \"table_tasks\": [\n                \"Ch6::Ch6_U3::Ch6_U3_T01\"\n              ]\n            }\n          },\n          {\n            \"unit_id\": \"Ch6_U4\",\n            \"focus\": \"介导毒性的分子与免疫通路机制\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch6_U4_P01\",\n                \"point\": \"肠道屏障受损与内毒素易位的促炎级联\",\n                \"development\": \"描述 Akkermansia 等黏液降解菌减少或致病菌扩张导致的紧密连接蛋白（ZO-1, Occludin）表达下调，促使 LPS 入血并持续激活 TLR4/NF-κB 通路，为全身性 irAEs 提供持续的先天免疫刺激背景（P0217）。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0217\",\n                    \"role\": \"主论据\",\n                    \"use\": \"描述 Akkermansia 等黏液降解菌减少致 LPS 入血并激活 TLR4/NF-κB 通路的机制\"\n                  },\n                  {\n                    \"source_handle\": \"P0284\",\n                    \"role\": \"例证\",\n                    \"use\": \"揭示 Paraclostridium bifermentans 通过活菌破坏上皮屏障致结肠炎的具体机制\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U4_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U4_P01\",\n                    \"unit_id\": \"Ch6_U4\",\n                    \"ordinal\": 1,\n                    \"point\": \"肠道屏障受损与内毒素易位的促炎级联\",\n                    \"development\": \"描述 Akkermansia 等黏液降解菌减少或致病菌扩张导致的紧密连接蛋白（ZO-1, Occludin）表达下调，促使 LPS 入血并持续激活 TLR4/NF-κB 通路，为全身性 irAEs 提供持续的先天免疫刺激背景（P0217）。\",\n                    \"source_handles\": [\n                      \"P0217\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U4_P02\",\n                \"point\": \"代谢物介导的表观遗传重编程与炎症抑制/促进\",\n                \"development\": \"指出非 irAEs 患者肠道中甲萘醌（维生素 K2）生物合成途径（menH/menC 基因）显著富集，血清甲萘醌水平更高，其可能通过抑制 NF-κB 通路发挥抗炎保护作用（P0308）；反之，SCFAs 在特定浓度下可通过 HDAC 抑制影响 Treg/Th17 分化平衡，剂量依赖性决定了其是维持稳态还是加剧炎症（P0472）。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0308\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出甲萘醌生物合成途径富集与血清甲萘醌水平更高及抗炎保护作用的关联\"\n                  },\n                  {\n                    \"source_handle\": \"P0472\",\n                    \"role\": \"主论据\",\n                    \"use\": \"阐述 SCFAs 通过 HDAC 抑制影响 Treg/Th17 分化平衡的剂量依赖性效应\"\n                  },\n                  {\n                    \"source_handle\": \"P0462\",\n                    \"role\": \"发展\",\n                    \"use\": \"补充肠道微生物组代谢物与分子模拟驱动长期疗效和不良事件结局的机制线索\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U4_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U4_P02\",\n                    \"unit_id\": \"Ch6_U4\",\n                    \"ordinal\": 2,\n                    \"point\": \"代谢物介导的表观遗传重编程与炎症抑制/促进\",\n                    \"development\": \"指出非 irAEs 患者肠道中甲萘醌（维生素 K2）生物合成途径（menH/menC 基因）显著富集，血清甲萘醌水平更高，其可能通过抑制 NF-κB 通路发挥抗炎保护作用（P0308）；反之，SCFAs 在特定浓度下可通过 HDAC 抑制影响 Treg/Th17 分化平衡，剂量依赖性决定了其是维持稳态还是加剧炎症（P0472）。\",\n                    \"source_handles\": [\n                      \"P0308\",\n                      \"P0472\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U4_P03\",\n                \"point\": \"MyD88 依赖的髓系激活与心肌炎中的 CD8+ T 细胞 TNF 轴\",\n                \"development\": \"综合临床前与转录组证据，阐明微生物抗原通过 MyD88 通路激活巨噬细胞分泌 TNFα/IL-6 导致肝损伤（P0126），或在 ICI 心肌炎中驱动 CD8+ T 细胞释放 TNF 并通过 TNFR2 信号招募髓系细胞、诱发心律失常（P0149）。结合 HLA 限制性抗原呈递框架，指出细菌肽段（如β-半乳糖苷酶）与心脏肌球蛋白的分子模拟可交叉激活自体反应性 CD4+/CD8+ T 细胞（P0597），但 Prevotella 特异性机制尚未解析。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0126\",\n                    \"role\": \"主论据\",\n                    \"use\": \"阐述肠道微生物通过 MyD88 通路激活巨噬细胞/CD8+ T 细胞引发肝损伤的炎症级联\"\n                  },\n                  {\n                    \"source_handle\": \"P0149\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 ICI 心肌炎中 CD8+ T 细胞释放 TNF 并通过 TNFR2 信号诱发心律失常的机制证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0597\",\n                    \"role\": \"主论据\",\n                    \"use\": \"结合 HLA 限制性抗原呈递框架，指出细菌肽段与心脏肌球蛋白的分子模拟机制\"\n                  },\n                  {\n                    \"source_handle\": \"P0602\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供 PD-1 抑制剂诱导心肌炎的动物实验证据，阐明肠道菌群失调通过抑制心脏局部 Treg 功能导致炎症的机制\"\n                  },\n                  {\n                    \"source_handle\": \"P0604\",\n                    \"role\": \"发展\",\n                    \"use\": \"综述 TN-C 介导的树突状细胞激活与 Th17 极化通路，以及特定肠道菌群通过分子模拟触发心脏自身免疫反应的实例\"\n                  },\n                  {\n                    \"source_handle\": \"P0598\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供肠道微生物组作为 ICI 相关心肌炎新兴治疗靶点的理论框架与机制综述\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U4_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U4_P03\",\n                    \"unit_id\": \"Ch6_U4\",\n                    \"ordinal\": 3,\n                    \"point\": \"MyD88 依赖的髓系激活与心肌炎中的 CD8+ T 细胞 TNF 轴\",\n                    \"development\": \"综合临床前与转录组证据，阐明微生物抗原通过 MyD88 通路激活巨噬细胞分泌 TNFα/IL-6 导致肝损伤（P0126），或在 ICI 心肌炎中驱动 CD8+ T 细胞释放 TNF 并通过 TNFR2 信号招募髓系细胞、诱发心律失常（P0149）。结合 HLA 限制性抗原呈递框架，指出细菌肽段（如β-半乳糖苷酶）与心脏肌球蛋白的分子模拟可交叉激活自体反应性 CD4+/CD8+ T 细胞（P0597），但 Prevotella 特异性机制尚未解析。\",\n                    \"source_handles\": [\n                      \"P0126\",\n                      \"P0149\",\n                      \"P0597\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"微生物介导的 irAEs 并非单一通路所致，而是屏障完整性丧失、代谢物信号失衡、分子模拟触发的交叉反应以及 MyD88/TNF 炎症级联共同作用的结果；理解这些通路有助于开发靶向特定节点（如 TNFR2 阻断、甲萘醌补充）的精准毒性管理策略。但机制证据多来自动物模型或体外实验，人体内直接验证有限，特别是 Prevotella 诱导心肌炎的具体分子机制尚未解析。\",\n              \"transition\": \"综上所述，微生物组对 ICI 毒性的调节是一个多层次、情境依赖的系统工程。后续章节将基于本章确立的证据等级与机制框架，转向方法学挑战与未来标准化研究方向。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"结合宏基因组与培养组学揭示Paraclostridium bifermentans通过活菌破坏上皮屏障致结肠炎、同时分泌低分子量代谢物增强疗效的双重机制，为介导毒性的物理屏障与代谢通路提供实证对照。\",\n                  \"paper_id\": \"7cdc8a62c7a781f0b9a88abe52934ab9b889134d\",\n                  \"source_handle\": \"P0284\"\n                },\n                {\n                  \"contribution\": \"阐述肠道微生物通过MyD88通路激活巨噬细胞/CD8+ T细胞引发肝损伤的炎症级联，区分不同免疫激动剂背景下的髓系激活路径，补充系统性毒性介导的先天免疫机制细节。\",\n                  \"paper_id\": \"378cf66d179d103b23a392cdb8e99a650e346e11\",\n                  \"source_handle\": \"P0126\"\n                },\n                {\n                  \"contribution\": \"提供PD-1抑制剂诱导心肌炎的动物实验证据，阐明肠道菌群失调通过抑制心脏局部Treg功能、打破Th17/Treg平衡导致炎症的具体机制，补充“肠道-心脏轴”介导毒性的分子细节。\",\n                  \"paper_id\": \"CorpusId:279792240\",\n                  \"source_handle\": \"P0602\"\n                },\n                {\n                  \"contribution\": \"综述TN-C介导的树突状细胞激活与Th17极化通路，以及特定肠道菌群（如Bacteroides）通过分子模拟触发心脏自身免疫反应的实例，为解释非结肠炎irAEs的免疫病理机制提供理论框架。\",\n                  \"paper_id\": \"CorpusId:231980805\",\n                  \"source_handle\": \"P0604\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0217\",\n              \"P0284\",\n              \"P0308\",\n              \"P0472\",\n              \"P0462\",\n              \"P0126\",\n              \"P0149\",\n              \"P0597\",\n              \"P0602\",\n              \"P0604\",\n              \"P0598\",\n              \"P0601\",\n              \"P0595\",\n              \"P0596\",\n              \"P0261\",\n              \"P0319\",\n              \"P0447\",\n              \"P0297\",\n              \"P0146\",\n              \"P0609\",\n              \"P0460\",\n              \"P0486\",\n              \"P0600\",\n              \"P0017\",\n              \"P0011\",\n              \"P0067\",\n              \"P0314\",\n              \"P0409\",\n              \"P0197\",\n              \"P0578\",\n              \"P0212\",\n              \"P0590\",\n              \"P0049\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch6::Ch6_U4::Ch6_U4_P01\",\n                \"Ch6::Ch6_U4::Ch6_U4_P02\",\n                \"Ch6::Ch6_U4::Ch6_U4_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch7\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"方法学挑战与未来研究方向\",\n          \"chapter_purpose\": \"帮助读者识别当前领域内关键的方法学瓶颈与证据等级差异，理解为何单一菌种难以成为通用预测因子，并为后续临床转化研究提供可操作的设计原则、优先级排序及边界认知。\",\n          \"chapter_scope\": \"肠道微生物组调节实体瘤免疫检查点抑制剂（ICI）疗效的证据虽已积累，但受限于测序技术异质性、观察性研究的混杂偏倚、动物模型向人类转化的局限，以及缺乏大型III期随机对照试验验证，目前仍无法确立普适性生物标志物或常规干预方案。未来研究需转向功能导向的多组学整合、严格的前瞻性队列设计、标准化供体/制剂管理，并明确区分关联证据与因果机制，以推动从描述性关联向精准临床转化的跨越。\",\n          \"chapter_thesis\": \"肠道微生物组调节实体瘤免疫检查点抑制剂（ICI）疗效的证据虽已积累，但受限于测序技术异质性、观察性研究的混杂偏倚、动物模型向人类转化的局限，以及缺乏大型III期随机对照试验验证，目前仍无法确立普适性生物标志物或常规干预方案。未来研究需转向功能导向的多组学整合、严格的前瞻性队列设计、标准化供体/制剂管理，并明确区分关联证据与因果机制，以推动从描述性关联向精准临床转化的跨越。\",\n          \"chapter_argument\": \"肠道微生物组调节实体瘤免疫检查点抑制剂（ICI）疗效的证据虽已积累，但受限于测序技术异质性、观察性研究的混杂偏倚、动物模型向人类转化的局限，以及缺乏大型III期随机对照试验验证，目前仍无法确立普适性生物标志物或常规干预方案。未来研究需转向功能导向的多组学整合、严格的前瞻性队列设计、标准化供体/制剂管理，并明确区分关联证据与因果机制，以推动从描述性关联向精准临床转化的跨越。\",\n          \"reader_objective\": \"帮助读者识别当前领域内关键的方法学瓶颈与证据等级差异，理解为何单一菌种难以成为通用预测因子，并为后续临床转化研究提供可操作的设计原则、优先级排序及边界认知。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"Ch7_U01\",\n            \"focus\": \"测序平台、生信流程及样本处理的技术变异是导致跨队列生物标志物难以复现的核心原因，低生物量样本污染与分辨率不足进一步削弱了分类学结论的可靠性。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch7_U01_P01\",\n                \"point\": \"确立技术演进背景与标准化紧迫性\",\n                \"development\": \"结合文献计量趋势，说明领域已从早期物种普查进入功能解析阶段，但技术碎片化导致知识整合困难。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0001\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供领域宏观结构与研究热点演变的全景式背景，定位知识边界与核心议题。\"\n                  },\n                  {\n                    \"source_handle\": \"P0027\",\n                    \"role\": \"背景\",\n                    \"use\": \"补充肿瘤内微生物对 ICI 疗效影响的研究热点分布及干预证据的结构化概览。\"\n                  },\n                  {\n                    \"source_handle\": \"P0534\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供定性综述证据，说明领域正从物种鉴定转向功能机制与生态韧性理论，支撑方法学标准化对揭示真实微生物信号的必要性。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U01_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U01_P01\",\n                    \"unit_id\": \"Ch7_U01\",\n                    \"ordinal\": 1,\n                    \"point\": \"确立技术演进背景与标准化紧迫性\",\n                    \"development\": \"结合文献计量趋势，说明领域已从早期物种普查进入功能解析阶段，但技术碎片化导致知识整合困难。\",\n                    \"source_handles\": [\n                      \"P0001\",\n                      \"P0027\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U01_P02\",\n                \"point\": \"剖析测序策略分歧与分辨率限制\",\n                \"development\": \"对比16S与宏基因组的技术参数，阐明引物偏好、宿主DNA占比及生信管道差异如何导致菌种列表不一致。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0055\",\n                    \"role\": \"主论据\",\n                    \"use\": \"综述微生物组在癌症免疫治疗中的新兴角色，整理多个独立研究发现的共性模式和潜在通路。\"\n                  },\n                  {\n                    \"source_handle\": \"P0295\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供经过筛选的、跨多种癌症类型的细菌清单，作为后续机制探讨的基础背景。\"\n                  },\n                  {\n                    \"source_handle\": \"P0565\",\n                    \"role\": \"比较\",\n                    \"use\": \"通过黑色素瘤系统综述展示测序平台与生信管道差异导致的菌种列表不一致性，为剖析技术变异削弱结论可靠性提供具体案例。\"\n                  },\n                  {\n                    \"source_handle\": \"P0302\",\n                    \"role\": \"局限\",\n                    \"use\": \"以口腔局部微环境为例，展示低生物量样本检测中的污染控制难题及宿主蛋白互作对菌群信号的干扰，补充空间异质性带来的分析局限。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U01_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U01_P02\",\n                    \"unit_id\": \"Ch7_U01\",\n                    \"ordinal\": 2,\n                    \"point\": \"剖析测序策略分歧与分辨率限制\",\n                    \"development\": \"对比16S与宏基因组的技术参数，阐明引物偏好、宿主DNA占比及生信管道差异如何导致菌种列表不一致。\",\n                    \"source_handles\": [\n                      \"P0055\",\n                      \"P0295\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U01_P03\",\n                \"point\": \"展示标准化重分析的实证启示\",\n                \"development\": \"引用统一管道重分析案例，论证控制方法学变量后，无响应相关信号的可重复性显著提升，反驳“微生物信号纯属噪音”的极端观点。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0354\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供大规模标准化重分析现有微生物组数据的实证，建立稳健的无响应微生物生物标志物集。\"\n                  },\n                  {\n                    \"source_handle\": \"P0264\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供免疫监测中微生物样本采集与测序流程标准化的专家共识建议，直接回应技术变异导致跨队列结论不可复现的方法学挑战。\"\n                  },\n                  {\n                    \"source_handle\": \"P0436\",\n                    \"role\": \"例证\",\n                    \"use\": \"通过黏膜黑色素瘤多部位同步采样设计，说明区分全身肠道与局部肿瘤微生物信号的方法学必要性，为标准化空间组学整合提供范例。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U01_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U01_P03\",\n                    \"unit_id\": \"Ch7_U01\",\n                    \"ordinal\": 3,\n                    \"point\": \"展示标准化重分析的实证启示\",\n                    \"development\": \"引用统一管道重分析案例，论证控制方法学变量后，无响应相关信号的可重复性显著提升，反驳“微生物信号纯属噪音”的极端观点。\",\n                    \"source_handles\": [\n                      \"P0354\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U01_P04\",\n                \"point\": \"提出培养组学与多界检测的补位路径\",\n                \"development\": \"指出纯测序方法的局限性，引入培养组学与真菌/病毒组检测作为提升功能注释完整性的必要补充。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0367\",\n                    \"role\": \"主论据\",\n                    \"use\": \"论证耦合培养组学与宏基因组测序以表征 ICI 治疗患者肠道微生物组的必要性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0566\",\n                    \"role\": \"比较\",\n                    \"use\": \"对比肠道与口腔微生物组预测效力的差异，补充空间异质性带来的分析局限，支持多部位采样与标准化流程的必要性。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U01_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U01_P04\",\n                    \"unit_id\": \"Ch7_U01\",\n                    \"ordinal\": 4,\n                    \"point\": \"提出培养组学与多界检测的补位路径\",\n                    \"development\": \"指出纯测序方法的局限性，引入培养组学与真菌/病毒组检测作为提升功能注释完整性的必要补充。\",\n                    \"source_handles\": [\n                      \"P0367\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"技术噪音不仅放大了队列间的表观差异，也掩盖了真实的生物学信号。标准化重分析表明，当控制测序深度、去噪算法与参考数据库时，部分微生物特征展现出跨队列的稳健性，这提示未来的生物标志物开发必须优先建立统一的元数据采集协议与开源生信工作流，而非依赖单一中心的探索性发现。\",\n              \"transition\": \"技术标准化的推进仅是第一步，即便获得高质量数据，观察性研究中普遍存在的混杂偏倚与因果倒置风险仍会阻碍机制的确证。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供免疫监测中微生物样本采集与测序流程标准化的专家共识建议，直接回应技术变异导致跨队列结论不可复现的方法学挑战。\",\n                  \"paper_id\": \"705d021ac660029794f037498bc1ffea03cbe239\",\n                  \"source_handle\": \"P0264\"\n                },\n                {\n                  \"contribution\": \"以口腔局部微环境为例，展示低生物量样本检测中的污染控制难题及宿主蛋白互作对菌群信号的干扰，补充空间异质性带来的分析局限。\",\n                  \"paper_id\": \"83ee66187aff0ae19e2706481c06aa696e21465b\",\n                  \"source_handle\": \"P0302\"\n                },\n                {\n                  \"contribution\": \"通过黏膜黑色素瘤多部位同步采样设计，说明区分全身肠道与局部肿瘤微生物信号的方法学必要性，为标准化空间组学整合提供范例。\",\n                  \"paper_id\": \"bf7682bc64d82a0342f438a261f4ce8de81ed9c0\",\n                  \"source_handle\": \"P0436\"\n                },\n                {\n                  \"contribution\": \"提供定性综述证据，说明领域正从物种鉴定转向功能机制与生态韧性理论，支撑方法学标准化对揭示真实微生物信号的必要性。\",\n                  \"paper_id\": \"ee8eab6a2dc467e53087607197bbc6701429b8ae\",\n                  \"source_handle\": \"P0534\"\n                },\n                {\n                  \"contribution\": \"通过黑色素瘤系统综述展示测序平台与生信管道差异导致的菌种列表不一致性，为剖析技术变异削弱结论可靠性提供具体案例。\",\n                  \"paper_id\": \"f9a9ef8d406ee51983cd285f9e60fc41574ae937\",\n                  \"source_handle\": \"P0565\"\n                },\n                {\n                  \"contribution\": \"对比肠道与口腔微生物组预测效力的差异，补充空间异质性带来的分析局限，支持多部位采样与标准化流程的必要性。\",\n                  \"paper_id\": \"f9ac47c0add070f4c39ec8ed763518f941ddf164\",\n                  \"source_handle\": \"P0566\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0001\",\n              \"P0027\",\n              \"P0534\",\n              \"P0055\",\n              \"P0295\",\n              \"P0565\",\n              \"P0302\",\n              \"P0354\",\n              \"P0264\",\n              \"P0436\",\n              \"P0367\",\n              \"P0566\",\n              \"P0478\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch7::Ch7_U01::Ch7_U01_P01\",\n                \"Ch7::Ch7_U01::Ch7_U01_P02\",\n                \"Ch7::Ch7_U01::Ch7_U01_P03\",\n                \"Ch7::Ch7_U01::Ch7_U01_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch7_U02\",\n            \"focus\": \"现有证据高度依赖观察性关联，抗生素使用、饮食结构、宿主遗传及肿瘤类型等混杂因素严重干扰因果链条的构建，且孟德尔随机化等方法在工具变量强度与人群代表性上存在固有缺陷。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch7_U02_P01\",\n                \"point\": \"界定观察性关联的因果倒置风险\",\n                \"development\": \"强调多数发现源于横断面或回顾性队列，解释为何“有益菌富集”可能是疗效良好的结果而非原因。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0031\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供宏观背景与机制概览，指出肠道微生物组与 ICI 疗效关联的因果性不明及异质性大的局限性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0433\",\n                    \"role\": \"主论据\",\n                    \"use\": \"整合多个关键临床队列和基础研究的发现，指出许多机制证据来自小鼠模型，直接外推到人类需谨慎。\"\n                  },\n                  {\n                    \"source_handle\": \"P0561\",\n                    \"role\": \"发展\",\n                    \"use\": \"提出“分子模拟”假说及量化方法（TAS），解释观察性关联背后的潜在因果机制，同时指出其验证局限性与 HLA LOH 等负面调节因素。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U02_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U02_P01\",\n                    \"unit_id\": \"Ch7_U02\",\n                    \"ordinal\": 1,\n                    \"point\": \"界定观察性关联的因果倒置风险\",\n                    \"development\": \"强调多数发现源于横断面或回顾性队列，解释为何“有益菌富集”可能是疗效良好的结果而非原因。\",\n                    \"source_handles\": [\n                      \"P0031\",\n                      \"P0433\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U02_P02\",\n                \"point\": \"评估药物与生活方式暴露的混杂干扰\",\n                \"development\": \"列举抗生素、PPI及饮食对微生物组的广泛重塑作用，指出其可能掩盖或模拟微生物-ICI的真实关联。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0012\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供抗生素干扰抗肿瘤治疗疗效的具体反面案例，提示肠道菌群失调可能通过多种机制影响药物疗效。\"\n                  },\n                  {\n                    \"source_handle\": \"P0171\",\n                    \"role\": \"主论据\",\n                    \"use\": \"系统列出被报道与疗效相关或无关的具体微生物分类群，分析临床前与临床数据不一致性的方法学局限。\"\n                  },\n                  {\n                    \"source_handle\": \"P0375\",\n                    \"role\": \"发展\",\n                    \"use\": \"提出“抗性/易感”微生物群概念框架，指出饮食模式与合并用药的交互作用会重塑菌群功能，警示观察性关联中未控暴露的混杂风险。\"\n                  },\n                  {\n                    \"source_handle\": \"P0558\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供 ICI 给药时间与生存结局的观察性数据，作为非微生物因素（时间生物学）干扰疗效的对照证据，警示混杂控制的复杂性。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U02_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U02_P02\",\n                    \"unit_id\": \"Ch7_U02\",\n                    \"ordinal\": 2,\n                    \"point\": \"评估药物与生活方式暴露的混杂干扰\",\n                    \"development\": \"列举抗生素、PPI及饮食对微生物组的广泛重塑作用，指出其可能掩盖或模拟微生物-ICI的真实关联。\",\n                    \"source_handles\": [\n                      \"P0012\",\n                      \"P0171\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U02_P03\",\n                \"point\": \"剖析跨物种机制外推的生理鸿沟\",\n                \"development\": \"对比无菌小鼠定植实验与人类复杂生态系统的差异，说明单一菌株效应可能在人体中被网络冗余或宿主遗传所缓冲。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0229\",\n                    \"role\": \"主论据\",\n                    \"use\": \"详细阐述微生物调节 ICI 和化疗反应的具体机制和潜在生物标志物列表，指出许多机制主要基于小鼠模型。\"\n                  },\n                  {\n                    \"source_handle\": \"P0525\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供计算模型视角，说明特定预测标记物 derived from simulation outputs 可能依赖模型假设。\"\n                  },\n                  {\n                    \"source_handle\": \"P0024\",\n                    \"role\": \"比较\",\n                    \"use\": \"借助慢性病毒感染模型展示治疗干预后代谢通路的持续性异常，类比说明宿主病理状态可能掩盖或模拟微生物介导的真实效应。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U02_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U02_P03\",\n                    \"unit_id\": \"Ch7_U02\",\n                    \"ordinal\": 3,\n                    \"point\": \"剖析跨物种机制外推的生理鸿沟\",\n                    \"development\": \"对比无菌小鼠定植实验与人类复杂生态系统的差异，说明单一菌株效应可能在人体中被网络冗余或宿主遗传所缓冲。\",\n                    \"source_handles\": [\n                      \"P0229\",\n                      \"P0525\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U02_P04\",\n                \"point\": \"审视统计推断工具的适用边界\",\n                \"development\": \"指出MR等方法在工具变量强度、人群代表性及终点匹配（发病vs疗效）上的局限，主张将其定位为假设生成器。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0059\",\n                    \"role\": \"主论据\",\n                    \"use\": \"通过孟德尔随机化方法从遗传角度证实肠道微生物及其代谢产物对多种实体瘤的潜在因果影响，但指出未直接涉及 ICI 疗效临床终点。\"\n                  },\n                  {\n                    \"source_handle\": \"P0005\",\n                    \"role\": \"主论据\",\n                    \"use\": \"作为高层概念图，链接肠道微生物组组成与 ICI 疗效，提供具体有益细菌例子及作用机制。\"\n                  },\n                  {\n                    \"source_handle\": \"P0010\",\n                    \"role\": \"局限\",\n                    \"use\": \"揭示青少年与老年患者基线菌群结构的显著差异，论证年龄发育阶段作为关键混杂变量如何干扰因果链条构建，支持分龄分层分析的必要性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0545\",\n                    \"role\": \"局限\",\n                    \"use\": \"提供波兰队列实证，揭示特定菌属与疗效关联的人群依赖性，论证年龄、饮食等混杂变量干扰因果链条构建的风险。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U02_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U02_P04\",\n                    \"unit_id\": \"Ch7_U02\",\n                    \"ordinal\": 4,\n                    \"point\": \"审视统计推断工具的适用边界\",\n                    \"development\": \"指出MR等方法在工具变量强度、人群代表性及终点匹配（发病vs疗效）上的局限，主张将其定位为假设生成器。\",\n                    \"source_handles\": [\n                      \"P0059\",\n                      \"P0005\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"混杂偏倚与模型外推的不确定性要求未来研究必须采用严格的纵向设计、详细记录共用药史与饮食基线，并在人类队列中验证动物模型提出的机制假说。统计推断工具（如MR）可作为生成假设的辅助手段，但不能替代前瞻性干预试验提供的因果确证。\",\n              \"transition\": \"即便明确了因果路径，若缺乏大规模随机对照试验的支持与特定人群的表征数据，这些机制仍难以转化为可常规执行的临床指南。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"揭示青少年与老年患者基线菌群结构的显著差异，论证年龄发育阶段作为关键混杂变量如何干扰因果链条构建，支持分龄分层分析的必要性。\",\n                  \"paper_id\": \"035c34646887b9612a3901c1b65bb5659e6881bb\",\n                  \"source_handle\": \"P0010\"\n                },\n                {\n                  \"contribution\": \"借助慢性病毒感染模型展示治疗干预后代谢通路的持续性异常，类比说明宿主病理状态可能掩盖或模拟微生物介导的真实效应。\",\n                  \"paper_id\": \"0ccad85a9f6c41d50296628847b3ffd3596af8ee\",\n                  \"source_handle\": \"P0024\"\n                },\n                {\n                  \"contribution\": \"提出“抗性/易感”微生物群概念框架，指出饮食模式与合并用药的交互作用会重塑菌群功能，警示观察性关联中未控暴露的混杂风险。\",\n                  \"paper_id\": \"a23415cfd3d02f562c74b0a4d6569499690c5ecb\",\n                  \"source_handle\": \"P0375\"\n                },\n                {\n                  \"contribution\": \"提供波兰队列实证，揭示特定菌属（如P. copri）与疗效关联的人群依赖性，论证年龄、饮食等混杂变量干扰因果链条构建的风险。\",\n                  \"paper_id\": \"f31246cd559d1a06b99a32b0ee47bb1ce0265772\",\n                  \"source_handle\": \"P0545\"\n                },\n                {\n                  \"contribution\": \"提供ICI给药时间与生存结局的观察性数据，作为非微生物因素（时间生物学）干扰疗效的对照证据，警示混杂控制的复杂性。\",\n                  \"paper_id\": \"f7345b03e8a5419417513da6cf1833522f3be7ed\",\n                  \"source_handle\": \"P0558\"\n                },\n                {\n                  \"contribution\": \"提出“分子模拟”假说及量化方法（TAS），解释观察性关联背后的潜在因果机制，同时指出其验证局限性与HLA LOH等负面调节因素。\",\n                  \"paper_id\": \"f845fe79c73bf04f15c7ab75115b887691b09e53\",\n                  \"source_handle\": \"P0561\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0031\",\n              \"P0433\",\n              \"P0561\",\n              \"P0012\",\n              \"P0171\",\n              \"P0375\",\n              \"P0558\",\n              \"P0229\",\n              \"P0525\",\n              \"P0024\",\n              \"P0059\",\n              \"P0005\",\n              \"P0010\",\n              \"P0545\",\n              \"P0478\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch7::Ch7_U02::Ch7_U02_P01\",\n                \"Ch7::Ch7_U02::Ch7_U02_P02\",\n                \"Ch7::Ch7_U02::Ch7_U02_P03\",\n                \"Ch7::Ch7_U02::Ch7_U02_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch7_U03\",\n            \"focus\": \"微生物干预策略的临床证据主要停留在 I/II 期概念验证阶段，缺乏大型 III 期 RCT 支持；特定人群（如老年、儿科、不同种族）数据匮乏，且肿瘤微环境（TME）内关键代谢物的浓度数据缺失，限制了干预方案的精准落地。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch7_U03_P01\",\n                \"point\": \"盘点早期试验信号与III期验证的缺席\",\n                \"development\": \"汇总I/II期FMT与益生菌的概念验证结果，明确指出缺乏大型RCT支持常规临床应用。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0026\",\n                    \"role\": \"主论据\",\n                    \"use\": \"汇总支持微生物组影响 ICI 疗效的主要菌属及 FMT 克服 ICI 耐药的临床尝试，指出当前证据的方法学局限。\"\n                  },\n                  {\n                    \"source_handle\": \"P0215\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供微生物组调节在 ICI 治疗实体瘤中的基础概述，列举成功和失败的干预例子。\"\n                  },\n                  {\n                    \"source_handle\": \"P0178\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供结构化的临床证据框架，汇总 FMT、LBPs 和定义菌群三类干预的具体试验结果。\"\n                  },\n                  {\n                    \"source_handle\": \"P0534\",\n                    \"role\": \"局限\",\n                    \"use\": \"汇总 FMT 与活体细菌产品的概念验证结果，明确指出缺乏大型 RCT 支持常规临床应用，支撑早期试验信号与 III 期验证缺席的判断。\"\n                  },\n                  {\n                    \"source_handle\": \"P0439\",\n                    \"role\": \"例证\",\n                    \"use\": \"系统梳理结直肠癌 FMT 与益生菌早期临床试验数据，指出供体筛选困难、定植效率波动及安全性监管缺口。\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"局限\",\n                    \"use\": \"梳理早期临床试验（I/II 期）数据，强调供体筛选困难、定植效率波动及安全性监管缺口，支撑干预策略尚未成为标准护理的判断。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U03_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U03_P01\",\n                    \"unit_id\": \"Ch7_U03\",\n                    \"ordinal\": 1,\n                    \"point\": \"盘点早期试验信号与III期验证的缺席\",\n                    \"development\": \"汇总I/II期FMT与益生菌的概念验证结果，明确指出缺乏大型RCT支持常规临床应用。\",\n                    \"source_handles\": [\n                      \"P0026\",\n                      \"P0215\",\n                      \"P0178\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U03_P02\",\n                \"point\": \"揭示纵向前瞻性数据的结构性短缺\",\n                \"development\": \"以正在进行的新辅助治疗研究为例，说明基线多样性与动态变化指标的预测价值仍需前瞻性队列确证。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0045\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供正在进行中的研究摘要，主要价值在于其研究设计的描述和可行性报告，而非实证结果。\"\n                  },\n                  {\n                    \"source_handle\": \"P0008\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供儿科肿瘤中微生物组作用的宏观背景和具体临床关联素材，指出许多关联多为观察性结果。\"\n                  },\n                  {\n                    \"source_handle\": \"P0030\",\n                    \"role\": \"例证\",\n                    \"use\": \"作为肝癌辅助治疗试验方案，明确短程免疫给药窗口与动态监测节点的设计逻辑，反衬当前缺乏大型 RCT 验证及标准化临床路径的现状。\"\n                  },\n                  {\n                    \"source_handle\": \"P0329\",\n                    \"role\": \"局限\",\n                    \"use\": \"展示基于回顾性数据的计算模拟预测结果，强调从算法优化到菌株分离培养的临床转化断层，凸显早期概念验证向 III 期确证试验跨越的障碍。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U03_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U03_P02\",\n                    \"unit_id\": \"Ch7_U03\",\n                    \"ordinal\": 2,\n                    \"point\": \"揭示纵向前瞻性数据的结构性短缺\",\n                    \"development\": \"以正在进行的新辅助治疗研究为例，说明基线多样性与动态变化指标的预测价值仍需前瞻性队列确证。\",\n                    \"source_handles\": [\n                      \"P0045\",\n                      \"P0008\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U03_P03\",\n                \"point\": \"剖析年龄与种族维度的表征盲区\",\n                \"development\": \"指出老年微生物组偏移特征与临床试验代表性不足的矛盾，强调人口统计学分层设计的必要性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0484\",\n                    \"role\": \"主论据\",\n                    \"use\": \"解释为何老年人群可能对 ICIs 反应较差，连接宿主年龄、微生物组构成与治疗结局。\"\n                  },\n                  {\n                    \"source_handle\": \"P0008\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供儿科特异性章节和讨论当前证据局限性的重要基础材料，区分人群差异。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U03_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U03_P03\",\n                    \"unit_id\": \"Ch7_U03\",\n                    \"ordinal\": 3,\n                    \"point\": \"剖析年龄与种族维度的表征盲区\",\n                    \"development\": \"指出老年微生物组偏移特征与临床试验代表性不足的矛盾，强调人口统计学分层设计的必要性。\",\n                    \"source_handles\": [\n                      \"P0484\",\n                      \"P0008\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U03_P04\",\n                \"point\": \"呈现临床决策对预测因子的迫切需求与现实落差\",\n                \"development\": \"引用医生调查数据，说明临床端对标准化生物标志物与干预协议的强烈渴望，反衬当前转化能力的不足。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0524\",\n                    \"role\": \"主论据\",\n                    \"use\": \"通过调查肿瘤科医生的意见，量化了 ICI 单药治疗 NSCLC 中未被充分研究的临床场景的重要性排序。\"\n                  },\n                  {\n                    \"source_handle\": \"P0544\",\n                    \"role\": \"发展\",\n                    \"use\": \"评估不同干预策略（饮食、FMT、LBPs）的临床成熟度与技术挑战，反衬当前缺乏标准化临床路径及预测因子的现状。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U03_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U03_P04\",\n                    \"unit_id\": \"Ch7_U03\",\n                    \"ordinal\": 4,\n                    \"point\": \"呈现临床决策对预测因子的迫切需求与现实落差\",\n                    \"development\": \"引用医生调查数据，说明临床端对标准化生物标志物与干预协议的强烈渴望，反衬当前转化能力的不足。\",\n                    \"source_handles\": [\n                      \"P0524\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"证据等级的断层与人群异质性表明，微生物疗法不能简单套用“一刀切”模式。TME代谢物浓度的缺失进一步切断了全身循环标志物与局部效应的桥梁。未来必须建立基于基线生态特征、疾病分期与宿主年龄的动态监测体系，并通过多中心协作解决样本量与长期随访的瓶颈。\",\n              \"transition\": \"面对上述缺口，单一的分类学追踪或经验性补充已无法满足精准医疗需求，研究范式亟需向多组学整合与工程化精准干预转型。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"作为肝癌辅助治疗试验方案，明确短程免疫给药窗口与动态监测节点的设计逻辑，反衬当前缺乏大型RCT验证及标准化临床路径的现状。\",\n                  \"paper_id\": \"0e52b2409fa157d1812995e5c089e1e03b4bad34\",\n                  \"source_handle\": \"P0030\"\n                },\n                {\n                  \"contribution\": \"展示基于回顾性数据的计算模拟预测结果，强调从算法优化到菌株分离培养的临床转化断层，凸显早期概念验证向III期确证试验跨越的障碍。\",\n                  \"paper_id\": \"8c58a2c58d069dea4a7b1ef304fff55a4640d079\",\n                  \"source_handle\": \"P0329\"\n                },\n                {\n                  \"contribution\": \"系统梳理结直肠癌FMT与益生菌早期临床试验数据，指出供体筛选困难、定植效率波动及安全性监管缺口，支撑干预策略尚未成为标准护理的判断。\",\n                  \"paper_id\": \"c0d5128fb69f9f60402c1c706b6276fd527e51fd\",\n                  \"source_handle\": \"P0439\"\n                },\n                {\n                  \"contribution\": \"汇总FMT与活体细菌产品的概念验证结果，明确指出缺乏大型RCT支持常规临床应用，支撑早期试验信号与III期验证缺席的判断。\",\n                  \"paper_id\": \"ee8eab6a2dc467e53087607197bbc6701429b8ae\",\n                  \"source_handle\": \"P0534\"\n                },\n                {\n                  \"contribution\": \"评估不同干预策略（饮食、FMT、LBPs）的临床成熟度与技术挑战，反衬当前缺乏标准化临床路径及预测因子的现状。\",\n                  \"paper_id\": \"f2eed100d2b1243d762c69b5b04f8a2a7e2cc82c\",\n                  \"source_handle\": \"P0544\"\n                },\n                {\n                  \"contribution\": \"梳理早期临床试验（I/II期）数据，强调供体筛选困难、定植效率波动及安全性监管缺口，支撑干预策略尚未成为标准护理的判断。\",\n                  \"paper_id\": \"CorpusId:290154100\",\n                  \"source_handle\": \"P0584\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0026\",\n              \"P0215\",\n              \"P0178\",\n              \"P0534\",\n              \"P0439\",\n              \"P0584\",\n              \"P0045\",\n              \"P0008\",\n              \"P0030\",\n              \"P0329\",\n              \"P0484\",\n              \"P0524\",\n              \"P0544\",\n              \"P0478\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch7::Ch7_U03::Ch7_U03_P01\",\n                \"Ch7::Ch7_U03::Ch7_U03_P02\",\n                \"Ch7::Ch7_U03::Ch7_U03_P03\",\n                \"Ch7::Ch7_U03::Ch7_U03_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch7_U04\",\n            \"focus\": \"未来研究需转向功能导向（代谢通路、基因水平）而非单纯分类学分析，整合 AI、多组学（宏基因组 + 代谢组）及先进模型（类器官、芯片）以解析复杂互作；个性化干预策略需结合宿主基线特征及标准化方案，并建立严格的安全监管框架。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch7_U04_P01\",\n                \"point\": \"论证功能导向与基因水平分析的方法学必然性\",\n                \"development\": \"说明分类学标签的局限性，强调代谢通路、酶活性及基因水平特征更能反映微生物的功能输出。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0323\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出微生物组是“癌症暗物质”的重要组成部分，并通过代谢产物、免疫调节和表观遗传修饰影响 TME。\"\n                  },\n                  {\n                    \"source_handle\": \"P0416\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供临床关联的策划摘要，说明为何需要先进的体外模型如免疫反应性类器官来研究微生物组 -ICI 相互作用。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U04_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U04_P01\",\n                    \"unit_id\": \"Ch7_U04\",\n                    \"ordinal\": 1,\n                    \"point\": \"论证功能导向与基因水平分析的方法学必然性\",\n                    \"development\": \"说明分类学标签的局限性，强调代谢通路、酶活性及基因水平特征更能反映微生物的功能输出。\",\n                    \"source_handles\": [\n                      \"P0323\",\n                      \"P0416\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U04_P02\",\n                \"point\": \"介绍AI与多模态数据整合的应用潜力与局限\",\n                \"development\": \"展示机器学习在特征降维与非线性关系挖掘中的优势，同时警示过拟合风险与跨队列泛化挑战。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0050\",\n                    \"role\": \"主论据\",\n                    \"use\": \"综述 AI 整合多组学预测 ICI 疗效的潜力与泛化挑战，为未来利用机器学习解析非线性微生物 - 免疫互作及开发可解释性数字孪生模型提供技术背景。\"\n                  },\n                  {\n                    \"source_handle\": \"P0054\",\n                    \"role\": \"主论据\",\n                    \"use\": \"汇总微生物组特征与 ICI 响应之间的关联，并指出了 AI 在解析这种关联中的作用。\"\n                  },\n                  {\n                    \"source_handle\": \"P0574\",\n                    \"role\": \"发展\",\n                    \"use\": \"介绍 TOPOSCORE 等多组学评分模型及 ONCOBIOME 倡议，展示超越分类学的功能导向分析方法及国际协作标准化努力的前景。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U04_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U04_P02\",\n                    \"unit_id\": \"Ch7_U04\",\n                    \"ordinal\": 2,\n                    \"point\": \"介绍AI与多模态数据整合的应用潜力与局限\",\n                    \"development\": \"展示机器学习在特征降维与非线性关系挖掘中的优势，同时警示过拟合风险与跨队列泛化挑战。\",\n                    \"source_handles\": [\n                      \"P0050\",\n                      \"P0054\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U04_P03\",\n                \"point\": \"评估先进体外模型在机制解析中的定位\",\n                \"development\": \"对比类器官/器官芯片与传统动物模型的优劣，指出其在保留患者异质性与模拟空间梯度方面的独特价值。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0172\",\n                    \"role\": \"主论据\",\n                    \"use\": \"评估类器官在模拟微生物-TME 轴中的优势与免疫组分缺失局限，论证结合微流控芯片实现动态梯度与空间异质性捕获的方法学演进方向。\"\n                  },\n                  {\n                    \"source_handle\": \"P0416\",\n                    \"role\": \"比较\",\n                    \"use\": \"对比类器官/器官芯片与传统动物模型的优劣，指出其在保留患者异质性与模拟空间梯度方面的独特价值。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U04_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U04_P03\",\n                    \"unit_id\": \"Ch7_U04\",\n                    \"ordinal\": 3,\n                    \"point\": \"评估先进体外模型在机制解析中的定位\",\n                    \"development\": \"对比类器官/器官芯片与传统动物模型的优劣，指出其在保留患者异质性与模拟空间梯度方面的独特价值。\",\n                    \"source_handles\": [\n                      \"P0172\",\n                      \"P0416\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch7_U04_P04\",\n                \"point\": \"提出精准干预的标准化路径与安全框架\",\n                \"development\": \"总结工程菌、定义菌群及生态药理学的前景，强调供体标准化、制剂工艺优化、昼夜节律同步及长期安全性监测的必要性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0532\",\n                    \"role\": \"主论据\",\n                    \"use\": \"列举工程菌递送微型抗体及 AI 辅助靶点发现的临床前案例，提示需建立严格的供体筛查、制剂工艺优化与长期安全性监测框架以推动精准干预落地。\"\n                  },\n                  {\n                    \"source_handle\": \"P0544\",\n                    \"role\": \"发展\",\n                    \"use\": \"引入昼夜节律新维度及方法学局限性，支持未来标准化研究需求，强调时间生物学对微生物定植及 ICI 疗效的影响。\"\n                  },\n                  {\n                    \"source_handle\": \"P0555\",\n                    \"role\": \"局限\",\n                    \"use\": \"批判性分析从临床前到临床转化的障碍，指出个体异质性、技术标准化缺失和还原论局限性，为精准干预的标准化路径提供背景。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch7_U04_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch7_U04_P04\",\n                    \"unit_id\": \"Ch7_U04\",\n                    \"ordinal\": 4,\n                    \"point\": \"提出精准干预的标准化路径与安全框架\",\n                    \"development\": \"总结工程菌、定义菌群及生态药理学的前景，强调供体标准化、制剂工艺优化、昼夜节律同步及长期安全性监测的必要性。\",\n                    \"source_handles\": [\n                      \"P0532\",\n                      \"P0544\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"多组学整合与人工智能并非万能解药，其效能高度依赖于底层数据的标准化质量与生物学先验知识的注入。类器官与芯片技术为机制验证提供了更接近人体的平台，但仍需克服免疫重建与长期培养的瓶颈。个性化干预的成功将取决于能否建立涵盖供体筛选、制剂冻干工艺、给药时序及宿主基线分层的闭环监管体系。\",\n              \"transition\": \"综上所述，方法学的严谨性、因果推断的透明度与临床转化的阶梯式验证，共同构成了该领域迈向成熟的核心支柱。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"综述AI整合多组学预测ICI疗效的潜力与泛化挑战，为未来利用机器学习解析非线性微生物-免疫互作及开发可解释性数字孪生模型提供技术背景。\",\n                  \"paper_id\": \"164f89ae032b4a17e939d4531f3f7f8ddb4c81ee\",\n                  \"source_handle\": \"P0050\"\n                },\n                {\n                  \"contribution\": \"评估类器官在模拟微生物-TME轴中的优势与免疫组分缺失局限，论证结合微流控芯片实现动态梯度与空间异质性捕获的方法学演进方向。\",\n                  \"paper_id\": \"4a8bc3da652bbd783e7ea5c1dbde908e5124c442\",\n                  \"source_handle\": \"P0172\"\n                },\n                {\n                  \"contribution\": \"列举工程菌递送微型抗体及AI辅助靶点发现的临床前案例，提示需建立严格的供体筛查、制剂工艺优化与长期安全性监测框架以推动精准干预落地。\",\n                  \"paper_id\": \"ed9f49b6f8cea1ce51cbf797f10d7a01e6835e15\",\n                  \"source_handle\": \"P0532\"\n                },\n                {\n                  \"contribution\": \"引入昼夜节律新维度及方法学局限性，支持未来标准化研究需求，强调时间生物学对微生物定植及ICI疗效的影响。\",\n                  \"paper_id\": \"f2eed100d2b1243d762c69b5b04f8a2a7e2cc82c\",\n                  \"source_handle\": \"P0544\"\n                },\n                {\n                  \"contribution\": \"批判性分析从临床前到临床转化的障碍，指出个体异质性、技术标准化缺失和还原论局限性，为精准干预的标准化路径提供背景。\",\n                  \"paper_id\": \"f661d588e0fee18c37ed1d46fd697c2ad01c4394\",\n                  \"source_handle\": \"P0555\"\n                },\n                {\n                  \"contribution\": \"介绍TOPOSCORE等多组学评分模型及ONCOBIOME倡议，展示超越分类学的功能导向分析方法及国际协作标准化努力的前景。\",\n                  \"paper_id\": \"ff5504ec23a09bb1d577854219dadfe3c7772ece\",\n                  \"source_handle\": \"P0574\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0323\",\n              \"P0416\",\n              \"P0050\",\n              \"P0054\",\n              \"P0574\",\n              \"P0172\",\n              \"P0532\",\n              \"P0544\",\n              \"P0555\",\n              \"P0478\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch7::Ch7_U04::Ch7_U04_P01\",\n                \"Ch7::Ch7_U04::Ch7_U04_P02\",\n                \"Ch7::Ch7_U04::Ch7_U04_P03\",\n                \"Ch7::Ch7_U04::Ch7_U04_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\"\n        ]\n      }\n    ],\n    \"task_roles\": [\n      {\n        \"task_id\": \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P01\",\n        \"chapter_id\": \"Ch1\",\n        \"unit_id\": \"U1_跨癌种关联图谱\",\n        \"local_task_id\": \"U1_跨癌种关联图谱::U1_跨癌种关联图谱_P01\",\n        \"kind\": \"paragraph\",\n        \"editable\": false\n      },\n      {\n        \"task_id\": \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P02\",\n        \"chapter_id\": \"Ch1\",\n        \"unit_id\": \"U1_跨癌种关联图谱\",\n        \"local_task_i