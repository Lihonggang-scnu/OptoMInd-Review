45912fee23845cfc64d0fcec9315b7\",\n              \"title\": \"Interaction of bacterial genera associated with therapeutic response to immune checkpoint PD-1 blockade in a United States cohort\",\n              \"year\": \"2022\",\n              \"doi\": \"10.1186/s13073-022-01037-7\",\n              \"original_source_handle\": \"P0604\",\n              \"identity_status\": \"conflicting_handle\"\n            },\n            {\n              \"source_handle\": \"P0474\",\n              \"paper_id\": \"d227bde3dc62e02cfe87a58fa5173e149048ed4e\",\n              \"title\": \"Tumor microenvironment-mediated resistance to immune checkpoint inhibitors in non-small cell lung cancer: Mechanisms, combination strategies and clinical perspectives (Review)\",\n              \"year\": \"2026\",\n              \"doi\": \"10.3892/mco.2026.2971\"\n            },\n            {\n              \"source_handle\": \"P0271\",\n              \"paper_id\": \"753e796b9f6fe2fe78f1b4c6074d39441710eda7\",\n              \"title\": \"The role of the gut microbiome on the efficacy of immune checkpoint inhibitors in Japanese responder patients with advanced non-small cell lung cancer.\",\n              \"year\": \"2019\",\n              \"doi\": \"10.21037/tlcr.2019.10.23\"\n            },\n            {\n              \"source_handle\": \"P0583\",\n              \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n              \"title\": \"Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial\",\n              \"year\": \"2026\",\n              \"doi\": \"10.1038/s41591-025-04186-5\"\n            },\n            {\n              \"paper_id\": \"CorpusId:290154100\",\n              \"title\": \"Navigating the gut–metabolite–immune axis: enhancing efficacy and mitigating toxicity of immune checkpoint inhibitors\",\n              \"year\": \"2026\",\n              \"doi\": \"10.3389/fimmu.2026.1803970\",\n              \"original_source_handle\": \"P0584\",\n              \"identity_status\": \"conflicting_identity\"\n            },\n            {\n              \"source_handle\": \"P0585\",\n              \"paper_id\": \"8016df1aa5a8160b7ccd412fa6851a6a508e2731\",\n              \"title\": \"Gut Microbiota in Advanced Non-small-cell Lung Cancer Receiving Chemo-immunotherapy: An Ancillary Biomarker Study from the Phase III trial JCOG2007 (NIPPON).\",\n              \"year\": \"2025\",\n              \"doi\": \"10.1016/j.jtho.2025.02.026\"\n            },\n            {\n              \"paper_id\": \"CorpusId:285298099\",\n              \"title\": \"Engineering microbial metabolites to modulate tumor immunity and advance cancer immunotherapy\",\n              \"year\": \"2026\",\n              \"doi\": \"10.1007/s44368-026-00019-w\",\n              \"original_source_handle\": \"P0600\",\n              \"identity_status\": \"conflicting_handle\"\n            },\n            {\n              \"paper_id\": \"69b4c5f84be199181be6ab5d3124f306462234f3\",\n              \"title\": \"Fecal microbiota transplantation plus pembrolizumab and axitinib in metastatic renal cell carcinoma: the randomized phase 2 TACITO trial\",\n              \"year\": \"2026\",\n              \"doi\": \"10.1038/s41591-025-04189-2\",\n              \"original_source_handle\": \"P0593\",\n              \"identity_status\": \"conflicting_handle\"\n            },\n            {\n              \"source_handle\": \"P0096\",\n              \"paper_id\": \"261e0a3618ae7acf6e831646379929eff88857d5\",\n              \"title\": \"The Gut Microbiome from a Biomarker to a Novel Therapeutic Strategy for Immunotherapy Response in Patients with Lung Cancer\",\n              \"year\": \"2023\",\n              \"doi\": \"10.3390/curroncol30110681\"\n            }\n          ],\n          \"chapter_ids\": [],\n          \"unit_key\": \"\"\n        }\n      ],\n      \"local_editable_task_ids\": [\n        \"U1_跨癌种关联图谱::U1_跨癌种关联图谱_P01\",\n        \"U1_跨癌种关联图谱::U1_跨癌种关联图谱_P02\",\n        \"U1_跨癌种关联图谱::U1_跨癌种关联图谱_P03\",\n        \"U2_外部干扰与宿主背景::U2_外部干扰与宿主背景_P01\",\n        \"U2_外部干扰与宿主背景::U2_外部干扰与宿主背景_P02\",\n        \"U2_外部干扰与宿主背景::U2_外部干扰与宿主背景_P03\",\n        \"U3_动态监测与纵向演变::U3_动态监测与纵向演变_P01\",\n        \"U3_动态监测与纵向演变::U3_动态监测与纵向演变_P02\",\n        \"U3_动态监测与纵向演变::U3_动态监测与纵向演变_P03\",\n        \"U4_证据阶梯与转化边界::U4_证据阶梯与转化边界_P01\",\n        \"U4_证据阶梯与转化边界::U4_证据阶梯与转化边界_P02\",\n        \"U4_证据阶梯与转化边界::U4_证据阶梯与转化边界_P03\",\n        \"U4_证据阶梯与转化边界::U4_证据阶梯与转化边界_T01\"\n      ],\n      \"fullbody_task_ids\": [\n        \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P01\",\n        \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P02\",\n        \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P03\",\n        \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P01\",\n        \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P02\",\n        \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P03\",\n        \"Ch1::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98_P01\",\n        \"Ch1::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98_P02\",\n        \"Ch1::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98_P03\",\n        \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_P01\",\n        \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_P02\",\n        \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_P03\",\n        \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_T01\"\n      ],\n      \"source_pool_reference\": \"sources\"\n    }\n  ],\n  \"sources\": [\n    {\n      \"source_handle\": \"P0096\",\n      \"title\": \"The Gut Microbiome from a Biomarker to a Novel Therapeutic Strategy for Immunotherapy Response in Patients with Lung Cancer\",\n      \"year\": \"2023\",\n      \"doi\": \"10.3390/curroncol30110681\",\n      \"paper_id\": \"261e0a3618ae7acf6e831646379929eff88857d5\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用叙事性综述方法，综合分析了近年来关于NSCLC患者微生物组与ICI反应关联的临床研究、回顾性队列分析以及动物模型实验。重点比较了响应者与无响应者的微生物组成差异，分析了抗生素使用对预后的影响机制，并汇总了正在进行的或已完成的涉及FMT、益生菌、饮食等干预措施的临床试验结果。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了NSCLC患者微生物组特征与ICI疗效关联的最新证据汇总，明确了关键的保护性和风险性菌属。\",\n            \"limits\": \"作为综述，其结论依赖于所引用的原始研究，这些研究多为回顾性或单中心小规模试验，存在地理偏倚（主要来自中国和日本）和方法学异质性。\"\n          },\n          {\n            \"contribution\": \"详细阐述了抗生素和PPI对ICI疗效的负面干扰机制，为临床合理用药提供依据。\",\n            \"limits\": \"对于微生物组调节的具体分子机制（如抗原特异性与非特异性机制的细节）尚未完全阐明，文中指出“大部分机制仍未知”。\"\n          },\n          {\n            \"contribution\": \"评估了FMT、MET、益生菌、饮食等多种干预策略的临床转化潜力。\",\n            \"limits\": \"大多数微生物组干预措施仍处于早期临床试验阶段，缺乏针对NSCLC的大规模随机对照试验结果，长期安全性和有效性尚不确定。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"接受抗PD-1/PD-L1治疗的NSCLC患者\",\n            \"finding\": \"特定细菌丰度与疗效相关：A. muciniphila、Ruminococcus、Faecalibacterium、Blautia等通常与良好预后相关；而Parabacteroides、Fusobacterium、Hungatella等则与耐药相关。值得注意的是，A. muciniphila丰度过高（超过第77百分位）可能与较短的总生存期相关。\"\n          },\n          {\n            \"conditions\": \"ICI治疗前近期使用抗生素（特别是β-内酰胺酶抑制剂、氟喹诺酮类）\",\n            \"finding\": \"抗生素使用导致肠道菌群失调，显著缩短NSCLC患者的中位总生存期（OS）和无进展生存期（PFS），且这种负面影响在ICI治疗前30天内最为明显。\"\n          },\n          {\n            \"conditions\": \"动物模型及初步临床试验\",\n            \"finding\": \"FMT从ICI响应者转移至小鼠可恢复ICI疗效；口服A. muciniphila可逆转耐药。部分临床试验显示FMT联合ICI在黑色素瘤和NSCLC中具有安全性和初步疗效，但针对NSCLC的大规模数据仍有限。益生菌的效果在不同研究中存在不一致性。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管ICI在NSCLC中取得了显著疗效，但许多患者出现原发或继发耐药及免疫相关不良事件（irAEs）。目前尚缺乏有效的预测生物标志物和克服耐药的策略。本研究旨在阐明微生物组如何影响ICI疗效，并探索基于微生物组的新型治疗途径。\",\n        \"research_scope\": \"非小细胞肺癌（NSCLC）患者，聚焦于肠道微生物组、肺部微生物组及其代谢产物与免疫检查点抑制剂（ICI）疗效及毒性的关系。\",\n        \"work_summary\": \"本文是一篇综述，系统梳理了肠道和肺部微生物组作为预测生物标志物及辅助治疗策略在NSCLC免疫治疗中的应用现状。文章首先回顾了抗生素（ATB）和质子泵抑制剂（PPI）等合并用药对微生物组的破坏作用及其对ICI疗效的负面影响；其次，总结了多项临床研究中确定的与ICI响应相关的特定细菌特征（如Akkermansia muciniphila、Faecalibacterium等）；最后，评估了通过粪便微生物移植（FMT）、益生菌、益生元、饮食干预及噬菌体疗法等调节微生物组的潜在治疗手段及其临床试验进展。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该综述为理解肠道微生物组如何调节固体肿瘤（特别是NSCLC）中的ICI疗效提供了全面的背景素材。它涵盖了从生物标志物识别（哪些菌有益/有害）到干预策略（FMT、益生菌、饮食）的完整链条，特别强调了抗生素使用的危害和特定菌属（如Akkermansia）的双刃剑效应。可用于构建综述中关于“微生物组作为预测因子”、“环境因素（药物/饮食）的影响”以及“微生物组靶向治疗”的核心章节。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"这些关联主要基于观察性研究和回顾性队列，因果关系需结合机制研究确认。不同研究间的菌属定义可能存在技术差异（16S vs WGS）。\",\n            \"contribution\": \"提供了NSCLC患者中与ICI响应和非响应相关的特定微生物特征列表。例如，响应者富集Akkermansia muciniphila, Faecalibacterium prausnitzii, Bifidobacterium spp., Blautia等；非响应者富集Parabacteroides, Fusobacterium, Hungatella等。同时指出了A. muciniphila丰度过高的潜在风险。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物组如何调节ICI疗效”中的相关性部分，即确定哪些微生物群落结构与疗效改善或恶化有关。\"\n          },\n          {\n            \"boundaries\": \"许多机制细节来自小鼠模型或体外实验，直接外推到人类NSCLC患者需谨慎。作者明确指出大部分机制“仍 largely unknown”，现有解释多为假说或初步证据。\",\n            \"contribution\": \"提出了几种可能的机制路径：1) 抗生素通过下调MAdCAM-1表达，促进Enterocloster增殖，进而抑制Th17/Treg细胞向肿瘤迁移；2) 某些细菌（如E. hirae）携带的噬菌体蛋白可与肿瘤抗原发生交叉反应，激活CD8+ T细胞；3) 短链脂肪酸（如丁酸）由有益菌产生，可能增强抗肿瘤免疫反应；4) 肺部微生物（如Veillonella）通过上调PI3K/Akt和ERK/MAPK通路促进肿瘤进展。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于回答“介导该效应的机制是什么”，提供具体的分子和细胞生物学解释框架。\"\n          },\n          {\n            \"boundaries\": \"多数试验处于I/II期，样本量小，且部分结果来自其他癌种（如黑色素瘤、肾细胞癌），不能直接等同于NSCLC的最终结论。益生菌效果在不同研究中存在矛盾。\",\n            \"contribution\": \"总结了当前针对NSCLC的微生物组干预临床试验（NCT编号），包括FMT、MET、益生菌（如C. butyricum, Bifidobacterium）和饮食补充剂（如Castalagin, MicrSoy-20）的进展和初步结果。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于展示将微生物组发现转化为临床实践的现状和挑战，特别是在讨论治疗策略时提供具体案例。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供NSCLC免疫治疗背景下微生物组研究的整体图景和最新进展。\",\n            \"material\": \"综述了从传统化疗到ICI治疗的转变，以及微生物组作为“癌症新标志物”的地位确立过程。\",\n            \"purpose\": \"作为综述的背景介绍，说明为什么关注微生物组是当前的热点和未满足的临床需求。\"\n          },\n          {\n            \"connection_to_review\": \"提供关于合并用药（抗生素、PPI）对免疫治疗影响的详细数据。\",\n            \"material\": \"引用了多个大型队列研究，显示ATB和PPI使用显著降低OS和PFS，并讨论了时间窗和药物类别的影响。\",\n            \"purpose\": \"用于讨论外部因素（药物暴露）如何干扰微生物组介导的治疗效果，强调临床管理的重要性。\"\n          },\n          {\n            \"connection_to_review\": \"提供关于肺部微生物组与肠道微生物组关系的初步见解。\",\n            \"material\": \"指出肺部微生物组（如Veillonella, Streptococcus）与肿瘤进展相关，并提示其与肠道微生物组的联系有待探索。\",\n            \"purpose\": \"扩展综述的范围，不仅限于肠道，还涵盖肺部局部微环境，体现多部位微生物互作的复杂性。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该综述主要聚焦于NSCLC，虽然提及黑色素瘤和肾细胞癌的FMT数据，但不能直接将其结果推广到其他实体瘤或所有肺癌亚型。\",\n          \"文中提到的微生物组与疗效的关联多为相关性，因果机制大多仍在假设阶段，特别是关于具体菌株的作用机制。\",\n          \"抗生素对ICI疗效的负面影响在大多数研究中得到证实，但也存在少数相反结果的报道，需注意这一争议性。\",\n          \"益生菌的效果在不同研究中不一致，部分研究显示有益，部分显示无效甚至有害，需谨慎解读其作为常规辅助治疗的潜力。\",\n          \"微生物组检测技术（16S rRNA vs WGS）和分析方法的差异可能导致不同研究间结果的不可比性。\"\n        ],\n        \"topic_handles\": [\n          \"肠道微生物组组成与ICI疗效的相关性\",\n          \"肺部微生物组在肺癌中的作用\",\n          \"抗生素诱导的菌群失调对免疫治疗的影响\",\n          \"粪便微生物移植（FMT）在实体瘤中的应用\",\n          \"益生菌、益生元及饮食干预对免疫微环境的调节\",\n          \"短链脂肪酸（SCFA）在抗肿瘤免疫中的作用\",\n          \"噬菌体疗法与微生物抗原交叉反应\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0096\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\261e0a3618ae7acf6e831646379929eff88857d5\\\\f2397cb158bb42a6eda954d2993a8748\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-403bce67afb0fdb07c1f\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\261e0a3618ae7acf6e831646379929eff88857d5\\\\f2397cb158bb42a6eda954d2993a8748\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0146\",\n      \"title\": \"Gut microbiota shapes cancer immunotherapy responses\",\n      \"year\": \"2025\",\n      \"doi\": \"10.1038/s41522-025-00786-8\",\n      \"paper_id\": \"4171288ecca93c6bca3eee61295418d704bb00fd\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"As a narrative review, this paper does not employ a systematic search protocol described in the text. Instead, it synthesizes findings from a broad range of sources including: 1) Historical timeline analysis of key advancements; 2) Summary of clinical trial data (Tables 1-5) linking specific microbial taxa to ICI/ACT outcomes; 3) Mechanistic discussion based on preclinical models (mouse studies) and human cohort analyses regarding immune cell activation, metabolite pathways (SCFAs, bile acids, etc.), and intratumoral interactions; 4) Evaluation of intervention strategies (antibiotics, FMT, probiotics, diet, engineered microbes) by summarizing results from ongoing and completed clinical trials.\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"Provides a structured synthesis of clinical and preclinical evidence linking specific gut microbial taxa to ICI and ACT outcomes across multiple cancer types. It categorizes mechanisms into innate/adaptive immunity modulation, metabolite effects, and intratumoral interactions. It also catalogs numerous ongoing clinical trials for FMT, probiotics, and dietary interventions.\",\n            \"limits\": \"As a narrative review, it lacks a systematic methodology for study selection, potentially introducing selection bias. Many findings are derived from small-scale clinical studies or animal models, limiting generalizability. The field faces significant heterogeneity in sequencing methods, sample handling, and lack of standardized protocols, making cross-study comparisons difficult. Causal relationships between specific microbes and clinical outcomes are often correlational rather than proven causal.\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"ICI therapy (anti-PD-1/PD-L1/CTLA-4)\",\n            \"finding\": \"Specific gut microbial compositions correlate with ICI response. Beneficial taxa include Bifidobacterium, Akkermansia muciniphila, Ruminococcaceae, and Faecalibacterium prausnitzii, which are associated with improved survival and tumor regression in melanoma, NSCLC, and RCC. Conversely, antibiotic use generally reduces ICI efficacy.\"\n          },\n          {\n            \"conditions\": \"ACT therapy (CAR-T, TCR-T)\",\n            \"finding\": \"Gut microbiota influences ACT efficacy and toxicity. Certain microbes (e.g., Ruminococcus, Bacteroides) are linked to CAR-T efficacy, while others may predict neurotoxicity or cytokine release syndrome (CRS). Microbial metabolites like SCFAs can enhance CD8+ T cell cytotoxicity.\"\n          },\n          {\n            \"conditions\": \"Mechanisms of Immune Modulation\",\n            \"finding\": \"Microbiota modulate immunity via direct interaction with dendritic cells and macrophages (PRR activation), metabolite signaling (SCFAs, bile acids, tryptophan metabolites influencing T cell differentiation), and molecular mimicry (cross-reactive T cells). Intratumoral microbiota can remodel the TME, promoting TLS formation or inducing immunosuppression.\"\n          },\n          {\n            \"conditions\": \"Intervention Strategies\",\n            \"finding\": \"FMT from ICI responders can overcome resistance in refractory melanoma patients. Probiotics (e.g., Clostridium butyricum CBM588) and dietary interventions (high-fiber, ketogenic) show promise in enhancing ICI response and reducing toxicity, though clinical evidence is still emerging.\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"Despite the success of immunotherapies like ICIs and ACTs, patient responses vary widely due to primary or acquired resistance and adverse events. This review aims to elucidate the role of the gut microbiota in shaping these outcomes, identify potential biomarkers for predicting response, and explore microbiota-based strategies to enhance efficacy and mitigate toxicity.\",\n        \"research_scope\": \"The review focuses on the gut microbiota and its influence on cancer immunotherapy, specifically immune checkpoint inhibitors (ICIs) and adoptive cell therapies (ACTs). It covers clinical correlations, preclinical mechanisms, intratumoral microbiota, and intervention strategies across various solid tumors and hematologic malignancies.\",\n        \"work_summary\": \"This paper provides a comprehensive overview of how the gut microbiome modulates the efficacy and toxicity of cancer immunotherapies. It traces the historical evolution from early animal studies to recent clinical trials, detailing specific microbial signatures associated with response or resistance to ICIs and ACTs. The authors synthesize mechanistic insights involving innate and adaptive immune modulation, metabolite production, and tumor microenvironment remodeling. Furthermore, it evaluates therapeutic interventions such as fecal microbiota transplantation (FMT), probiotics, dietary modifications, and engineered bacteria, while highlighting challenges in standardization and clinical translation.\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"This review serves as a foundational resource for mapping the relationship between gut microbiome composition and ICI efficacy in solid tumors. It provides specific microbial markers (taxa) associated with response/resistance, details mechanistic pathways (metabolites, immune cell crosstalk), and outlines current intervention strategies (FMT, probiotics, diet). It is particularly useful for identifying candidate biomarkers and understanding the biological plausibility of microbiome-mediated modulation, while also highlighting the methodological challenges and variability that complicate definitive conclusions.\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"Associations are largely correlative from retrospective or small prospective cohorts. Specificity varies by cancer type and ICI agent. Lack of standardized detection methods limits direct comparison. Does not establish causality.\",\n            \"contribution\": \"Identifies specific gut microbial taxa associated with ICI response or resistance in solid tumors. For example, Akkermansia muciniphila, Bifidobacterium, and Ruminococcaceae are linked to better outcomes in melanoma and NSCLC, while certain Proteobacteria or high abundance of Bacteroides intestinalis may correlate with resistance or toxicity. It also notes that beneficial taxa vary by ICI type (anti-PD-1 vs. anti-CTLA-4) and cancer type.\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"Can be used to list candidate microbial biomarkers for predicting ICI efficacy in solid tumors. Helps explain inter-patient variability in treatment response.\"\n          },\n          {\n            \"boundaries\": \"Many mechanisms are primarily demonstrated in mouse models (preclinical). Human validation is often indirect or observational. Some mechanisms (e.g., molecular mimicry) are proposed but require further confirmation in humans. Effects can be bidirectional (promoting or suppressing immunity depending on context).\",\n            \"contribution\": \"Details mechanisms by which gut microbiota modulate ICI efficacy: 1) Direct immune modulation via PRR activation (TLR/NLR) leading to DC maturation and T-cell activation; 2) Metabolite-mediated regulation (SCFAs inhibiting HDAC, bile acids affecting Th17/Treg balance, tryptophan metabolites via AhR); 3) Molecular mimicry where bacterial antigens cross-react with tumor antigens; 4) Remodeling of the tumor microenvironment (TME) through intratumoral bacteria or systemic metabolites influencing tertiary lymphoid structures (TLS).\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"Provides mechanistic explanations for how the microbiome influences ICI response. Supports the biological rationale for microbiome-targeted interventions.\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"Contextual background on the evolution of microbiome-immunotherapy research\",\n            \"material\": \"Historical perspective section tracing discoveries from 2007 to 2025, highlighting the shift from correlation to mechanistic understanding and clinical trials.\",\n            \"purpose\": \"To provide a timeline of key advancements and justify the current interest in microbiome modulation as a critical factor in immunotherapy success.\"\n          },\n          {\n            \"connection_to_review\": \"Discussion of intervention strategies beyond just biomarkers\",\n            \"material\": \"Sections on FMT, probiotics, antibiotics, diet, and engineered microbes, including tables of clinical trials.\",\n            \"purpose\": \"To illustrate potential therapeutic avenues for overcoming ICI resistance and managing toxicity, providing examples of how microbiome modulation is being translated into clinical practice.\"\n          },\n          {\n            \"connection_to_review\": \"Challenges and limitations in the field\",\n            \"material\": \"Section on 'Challenges and future directions' discussing technical variability, donor effects in FMT, host genetics, and lack of standardization.\",\n            \"purpose\": \"To highlight methodological hurdles and confounding factors that must be considered when interpreting microbiome-ICI associations, explaining why consistent biomarkers are hard to identify.\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"The review covers both gut and intratumoral microbiota; ensure distinction is maintained when applying findings to 'gut microbiome' specific facets.\",\n          \"Findings on specific bacterial taxa are highly dependent on the cancer type (e.g., melanoma vs. NSCLC) and the specific ICI agent (anti-PD-1 vs. anti-CTLA-4); avoid over-generalizing across all solid tumors.\",\n          \"Many mechanistic insights are derived from murine models; caution is needed when extrapolating to human physiology without explicit human validation mentioned in the text.\",\n          \"Clinical trial data cited are often from early-phase (I/II) or small cohorts; results should not be interpreted as definitive proof of efficacy for interventions like FMT or probiotics.\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiota composition and diversity\",\n          \"immune checkpoint inhibitors (ICIs)\",\n          \"solid tumors (melanoma, NSCLC, RCC, HCC, CRC)\",\n          \"fecal microbiota transplantation (FMT)\",\n          \"probiotics and prebiotics\",\n          \"dietary interventions (high-fiber, ketogenic)\",\n          \"microbial metabolites (SCFAs, bile acids, tryptophan metabolites)\",\n          \"intratumoral microbiota\",\n          \"predictive biomarkers for ICI response\",\n          \"immune-related adverse events (irAEs)\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0146\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\4171288ecca93c6bca3eee61295418d704bb00fd\\\\92125422c10f28cdb7938d2658870c58\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\4171288ecca93c6bca3eee61295418d704bb00fd\\\\92125422c10f28cdb7938d2658870c58\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0585\",\n      \"title\": \"Gut Microbiota in Advanced Non-small-cell Lung Cancer Receiving Chemo-immunotherapy: An Ancillary Biomarker Study from the Phase III trial JCOG2007 (NIPPON).\",\n      \"year\": \"2025\",\n      \"doi\": \"10.1016/j.jtho.2025.02.026\",\n      \"paper_id\": \"8016df1aa5a8160b7ccd412fa6851a6a508e2731\",\n      \"material_depth\": \"abstract\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"这是一项嵌入在随机对照III期临床试验（JCOG2007, NIPPON）中的辅助生物标志物研究。研究设计包括：1. 队列选择：从入组的295名患者中筛选出270名提供基线粪便样本的患者进行分析。2. 分组比较：比较两种一线治疗方案（PC vs NIC）。3. 微生物分析：对基线粪便样本进行16S rDNA测序，进行α/β多样性分析和LEfSe差异丰度分析。4. 临床关联分析：将微生物特征（多样性、特定菌属丰度）与主要临床终点（OS超过12或18个月的亚群区分、总体OS、≥Grade 4严重不良事件发生率）进行统计学关联分析，并进行了按治疗方案的亚组分析。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了在大型III期临床试验背景下，肠道微生物群与NSCLC化疗-免疫治疗预后及安全性关联的具体实证数据。识别了特定的细菌属（如Fusicatenibacter, Butyricicoccus）作为潜在的预后和安全性标志物，并提示了方案特异性的微生物效应。\",\n            \"limits\": \"仅基于摘要信息，无法评估多变量校正模型的完整性、多重检验校正方法、16S测序的具体流程细节及批次效应处理。结果主要关联观察性，因果机制未阐明。NIC组中Prevotellaceae NK3B31的结果需结合具体统计显著性和置信区间解读。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"整体队列（n=270），根据OS是否超过12或18个月划分的亚群\",\n            \"finding\": \"β多样性分析显示不同生存时间亚群具有不同的微生物结构。LEfSe分析发现，Fusicatenibacter、Butyricicoccus和Blautia在长生存患者中富集。\"\n          },\n          {\n            \"conditions\": \"整体队列，关注严重不良事件（≥ Grade 4 AEs）\",\n            \"finding\": \"较低的微生物α多样性及某些特定菌属的存在与较高的严重AE风险相关。相反，有益菌属（如Fusicatenibacter和Butyricicoccus）的高丰度与较低的严重AE风险相关。\"\n          },\n          {\n            \"conditions\": \"按治疗方案分层（NIC臂 vs CP/PC臂）\",\n            \"finding\": \"在NIC组中，Fusicatenibacter和Butyricicoccus的高丰度与更好的OS相关（HR分别为0.56和0.52），优于CP组。而在NIC组中，Prevotellaceae NK3B31的高丰度与更高的死亡风险相关（HR=2.33）。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"尽管免疫治疗改变了NSCLC的治疗格局，但缺乏可靠的生物标志物来指导治疗选择。肠道微生物群虽被视为潜在生物标志物，但其在NSCLC化疗-免疫联合治疗中的具体作用尚不清楚。本研究试图回答：肠道微生物群的组成和多样性是否能预测晚期NSCLC患者在接受不同化疗-免疫联合方案时的预后（OS）和治疗安全性（严重AEs）？\",\n        \"research_scope\": \"针对无驱动基因改变的晚期非小细胞肺癌（NSCLC）患者，基于JCOG2007（NIPPON）III期临床试验的辅助生物标志物研究。研究对象为接受培美曲塞+铂类化疗联合帕博利珠单抗（PC组）或纳武利尤单抗+伊匹木单抗联合铂类化疗（NIC组）的患者，分析基线粪便样本中的肠道微生物群。\",\n        \"work_summary\": \"本研究旨在探索肠道微生物群作为晚期NSCLC化疗-免疫治疗疗效和安全性生物标志物的潜力。研究利用JCOG2007试验中270名有基线粪便样本患者的16S rDNA测序数据，分析了微生物多样性及特定菌属丰度与总生存期（OS）及严重不良事件（AEs）之间的关联。结果显示，微生物结构随生存时间延长而变化，特定产丁酸菌属富集于长生存患者，且与较低的严重AE风险相关；此外，不同治疗方案下微生物对预后的影响存在差异。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于肠道微生物群如何调节实体瘤（特别是NSCLC）免疫检查点抑制剂（ICI）疗效及安全性的直接临床证据。其核心价值在于不仅关联了微生物与疗效（OS），还关联了与免疫治疗密切相关的毒性（严重AEs），并揭示了不同免疫检查点抑制剂组合（PD-1 vs PD-1+CTLA-4）下的微生物响应差异，有助于回答“哪些微生物有益/有害”以及“机制是否受药物类型影响”的问题。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"结果来自NSCLC特定人群，且为观察性关联。NIC组中Prevotellaceae NK3B31显示负面关联，提示微生物效应具有复杂性和情境依赖性。不能直接外推至所有实体瘤或所有ICI单药治疗。\",\n            \"contribution\": \"提供了肠道微生物群与ICI疗效关联的临床队列证据。具体发现：Fusicatenibacter和Butyricicoccus的高丰度与更长的OS相关，特别是在NIC（纳武利尤单抗+伊匹木单抗）方案中效果显著（HR 0.56/0.52）。同时，这些菌属也与较低的严重AE风险相关。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持综述中关于“有益微生物促进ICI疗效”的论点。可用于举例说明特定菌属（产丁酸菌）在改善预后中的作用。可用于讨论微生物与免疫治疗毒性的关联（安全性维度）。\"\n          },\n          {\n            \"boundaries\": \"本研究未提供直接的机制验证（如动物模型、体外实验或代谢产物测量）。关联不等于因果。方案特异性结果的生物学解释需谨慎，可能涉及药物代谢、免疫微环境改变等多重因素。\",\n            \"contribution\": \"提供了微生物群落结构与临床结局（生存期和毒性）的关联数据，暗示了微生物可能通过调节宿主免疫反应（进而影响疗效和毒性）发挥作用，但未直接测定分子机制。指出了不同免疫检查点阻断策略（PD-1 vs CTLA-4+PD-1）下微生物效应的差异性（方案特异性）。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于综述中讨论“微生物效应的情境依赖性”或“药物-微生物相互作用”。虽然不直接揭示分子机制，但其发现的特定菌属（如产丁酸菌）可作为后续机制研究的候选靶点或生物标志物。可用于论证为何需要针对不同免疫方案定制微生物干预策略。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"为综述提供引言部分的背景支持，强调开发微生物生物标志物的临床需求和紧迫性。\",\n            \"material\": \"研究背景指出免疫治疗改变了NSCLC治疗格局，但缺乏可靠生物标志物，肠道微生物群被视为潜在标志物。\",\n            \"purpose\": \"背景与概念框架\"\n          },\n          {\n            \"connection_to_review\": \"用于展示微生物效应的异质性，避免过度简化“好菌/坏菌”的二元论。提示在整合微生物数据时需要考虑具体的菌群组成和可能的拮抗作用。\",\n            \"material\": \"NIC组中Prevotellaceae NK3B31高丰度与高死亡风险（HR=2.33）相关，而Fusicatenibacter等则有益。\",\n            \"purpose\": \"实例与反例\"\n          },\n          {\n            \"connection_to_review\": \"反映领域内对于微生物指导临床决策的展望，可用于综述的讨论部分，探讨未来转化医学的方向和挑战。\",\n            \"material\": \"结论建议将肠道微生物谱分析整合到临床实践中以优化一线治疗策略。\",\n            \"purpose\": \"实践知识\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究为观察性附属研究，关联结果不能直接推断因果关系。\",\n          \"结果基于16S rDNA测序，分辨率限于属水平，且未提供功能基因组或代谢组数据，机制解释受限。\",\n          \"NIC组中Prevotellaceae NK3B31的负面结果需警惕，可能与样本量、统计效力或特定亚群特征有关，不宜简单概括为该类菌普遍有害。\",\n          \"方案特异性结果（NIC vs PC）的差异可能受药物相互作用、患者基线特征或其他混杂因素影响，需谨慎解读。\",\n          \"摘要未提供详细的统计校正方法（如多重检验校正、协变量调整），影响结果的确信度评估。\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiota composition\",\n          \"immune checkpoint inhibitors (ICIs)\",\n          \"non-small-cell lung cancer (NSCLC)\",\n          \"chemo-immunotherapy\",\n          \"overall survival (OS)\",\n          \"adverse events (AEs)\",\n          \"16S rDNA sequencing\",\n          \"Fusicatenibacter\",\n          \"Butyricicoccus\",\n          \"Blautia\",\n          \"Prevotellaceae NK3B31\",\n          \"microbial diversity (alpha/beta)\"\n        ]\n      },\n      \"supplement_material\": {\n        \"auxiliary_material\": \"The study highlights regimen-specific effects, noting that microbial associations with outcomes differed between the PD-1 inhibitor-based regimen (PC) and the dual checkpoint blockade regimen (NIC). It identifies specific bacterial genera (Fusicatenibacter, Butyricicoccus, Blautia) enriched in patients with longer OS (>12 or >18 months). It also notes that lower microbial alpha diversity and presence of certain taxa were linked to a higher risk of serious (≥ Grade 4) AEs. The authors conclude that gut microbiota may serve as a biomarker for chemo-immunotherapy in advanced NSCLC.\",\n        \"evidence\": [],\n        \"gap_id\": \"case_E_phase3_rct\",\n        \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU03_search_candidate_3636101ad7\\\\FULFILLMENT_JUDGMENT.json\",\n        \"limitations\": [],\n        \"material_ready\": true,\n        \"material_usefulness\": \"direct\",\n        \"outline_action\": \"No further action required; the gap is fulfilled by the existence of the JCOG2007 phase III RCT described in this study.\",\n        \"outline_action_recovered_by_policy\": false,\n        \"remaining_gap\": \"\",\n        \"remaining_gap_recovered_by_policy\": false,\n        \"status\": \"fulfilled\",\n        \"useful_material\": \"This study reports on the JCOG2007 trial, a completed phase III randomized controlled trial comparing pembrolizumab plus platinum doublet chemotherapy (PC) and nivolumab-ipilimumab plus platinum doublet chemotherapy (NIC) in treatment-naïve advanced non-small cell lung cancer (NSCLC) patients. The trial enrolled 295 patients, with an ancillary biomarker analysis performed on baseline fecal samples from 270 patients using 16S rDNA sequencing. The study found that gut microbiota composition was associated with overall survival (OS) and adverse events (AEs). Specifically, higher abundance of Fusicatenibacter and Butyricicoccus was linked to better OS in the NIC arm compared to the PC arm, and these genera were also associated with a lower risk of serious AEs. Conversely, higher abundance of Prevotellaceae NK3B31 was associated with higher mortality risk in the NIC arm.\"\n      },\n      \"supplement_materials\": [\n        {\n          \"auxiliary_material\": \"The study highlights regimen-specific effects, noting that microbial associations with outcomes differed between the PD-1 inhibitor-based regimen (PC) and the dual checkpoint blockade regimen (NIC). It identifies specific bacterial genera (Fusicatenibacter, Butyricicoccus, Blautia) enriched in patients with longer OS (>12 or >18 months). It also notes that lower microbial alpha diversity and presence of certain taxa were linked to a higher risk of serious (≥ Grade 4) AEs. The authors conclude that gut microbiota may serve as a biomarker for chemo-immunotherapy in advanced NSCLC.\",\n          \"evidence\": [],\n          \"gap_id\": \"case_E_phase3_rct\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU03_search_candidate_3636101ad7\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"direct\",\n          \"outline_action\": \"No further action required; the gap is fulfilled by the existence of the JCOG2007 phase III RCT described in this study.\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"fulfilled\",\n          \"useful_material\": \"This study reports on the JCOG2007 trial, a completed phase III randomized controlled trial comparing pembrolizumab plus platinum doublet chemotherapy (PC) and nivolumab-ipilimumab plus platinum doublet chemotherapy (NIC) in treatment-naïve advanced non-small cell lung cancer (NSCLC) patients. The trial enrolled 295 patients, with an ancillary biomarker analysis performed on baseline fecal samples from 270 patients using 16S rDNA sequencing. The study found that gut microbiota composition was associated with overall survival (OS) and adverse events (AEs). Specifically, higher abundance of Fusicatenibacter and Butyricicoccus was linked to better OS in the NIC arm compared to the PC arm, and these genera were also associated with a lower risk of serious AEs. Conversely, higher abundance of Prevotellaceae NK3B31 was associated with higher mortality risk in the NIC arm.\"\n        }\n      ],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0585\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU03_search_candidate_3636101ad7\\\\card\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"kind\": \"identity\",\n            \"reason\": \"source identity was not independently verified\",\n            \"status\": \"input_attributed\"\n          },\n          {\n            \"kind\": \"coverage\",\n            \"reason\": \"no complete research body was indexed\",\n            \"status\": \"partial\"\n          },\n          {\n            \"kind\": \"html\",\n            \"reason\": \"html_empty\",\n            \"status\": \"partial\"\n          },\n          {\n            \"kind\": \"html\",\n            \"reason\": \"html_challenge_or_login\",\n            \"status\": \"partial\"\n          },\n          {\n            \"kind\": \"coverage\",\n            \"reason\": \"only abstract or non-title snippets were available\",\n            \"status\": \"partial\"\n          }\n        ],\n        \"material_scope\": \"abstract_only\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU03_search_candidate_3636101ad7\\\\card\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0298\",\n      \"title\": \"Gut microbial signatures and immunotherapy outcomes in NSCLC and melanoma: a systematic review and meta-analysis\",\n      \"year\": \"2026\",\n      \"doi\": \"10.1186/s12885-026-15763-3\",\n      \"paper_id\": \"82318ae05cff1667b2348961675db67dee4d8360\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用系统综述和荟萃分析方法。文献检索涵盖PubMed, Embase, Web of Science, Scopus。纳入标准为成人NSCLC或黑色素瘤患者，接受ICI治疗，有基线肠道微生物组数据（16S rRNA或宏基因组测序），并报告OS, PFS, ORR或irAEs。数据提取后，对α多样性、特定菌属丰度、抗生素使用等暴露因素进行荟萃分析，使用DerSimonian and Laird随机效应模型合并HR和OR。进行亚组分析（癌症类型、测序方法）。使用NOS评估研究质量，使用GRADE评估证据确定性。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了关于肠道微生物组特征（多样性、特定菌属）与NSCLC和黑色素瘤患者ICI疗效及安全性之间关联的综合定量证据。确认了高多样性、Akkermansia、Faecalibacterium的有益关联以及抗生素使用的有害关联。区分了不同ICI类型（抗CTLA-4 vs. 抗PD-1）在irAEs方面的不同微生物关联。\",\n            \"limits\": \"纳入的研究均为观察性研究，无法确立因果关系。证据确定性被评定为“中等”，主要因研究设计的观察性质和部分结果的不一致性。由于原始数据不可用，无法进行个体参与者数据（IPD）分析，限制了更精细的混杂因素调整。术语上只能界定为“预后”关联，难以严格区分“预测”价值。对于抗PD-1/PD-L1治疗相关的irAEs，因数据异质性过大，未能进行荟萃分析。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"基线高肠道微生物α多样性 vs. 低多样性\",\n            \"finding\": \"显著改善OS (pooled HR 0.52, 95% CI 0.41–0.66) 和 PFS (pooled HR 0.58, 95% CI 0.47–0.71)。在NSCLC和黑色素瘤亚组中均稳健，且不受测序方法（16S vs. 宏基因组）影响。\"\n          },\n          {\n            \"conditions\": \"基线存在 Akkermansia\",\n            \"finding\": \"显著增加客观缓解率 (ORR) (pooled OR 2.15, 95% CI 1.38–3.35)。\"\n          },\n          {\n            \"conditions\": \"基线高丰度 Faecalibacterium\",\n            \"finding\": \"显著改善无进展生存期 (PFS) (pooled HR 0.68, 95% CI 0.54–0.85)。\"\n          },\n          {\n            \"conditions\": \"ICI治疗前1-2个月内使用抗生素\",\n            \"finding\": \"显著恶化总生存期 (OS) (pooled HR 1.72, 95% CI 1.34–2.21)。\"\n          },\n          {\n            \"conditions\": \"黑色素瘤患者接受抗CTLA-4治疗，基线高丰度 Bacteroidetes\",\n            \"finding\": \"显著降低严重（≥3级）结肠炎风险 (pooled OR 0.34, 95% CI 0.18–0.64)。\"\n          },\n          {\n            \"conditions\": \"黑色素瘤患者接受抗CTLA-4治疗，基线高丰度 Bacteroides intestinalis\",\n            \"finding\": \"一项研究提示与严重毒性风险增加相关（未纳入荟萃分析）。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管已有证据表明肠道微生物组影响ICI疗效，但现有证据碎片化且存在不一致。本研究旨在定量综合基线肠道微生物组特征（多样性和特定菌属）与NSCLC和黑色素瘤患者ICI临床结局（生存、响应、不良反应）之间的关联，并评估证据质量，以明确其作为预后生物标志物的潜力。\",\n        \"research_scope\": \"非小细胞肺癌（NSCLC）和黑色素瘤患者；接受免疫检查点抑制剂（ICIs，包括抗PD-1/PD-L1或抗CTLA-4治疗）；基线肠道微生物组特征与临床结局（OS, PFS, ORR, irAEs）的关联。\",\n        \"work_summary\": \"本研究是一项系统综述和荟萃分析，旨在综合评估基线肠道微生物组特征与非小细胞肺癌和黑色素瘤患者免疫检查点抑制剂（ICI）疗效及安全性之间的预后关联。研究遵循PRISMA指南，检索了截至2025年4月的多项数据库，纳入26项涉及1,542名患者的观察性研究。通过随机效应模型汇总了风险比（HR）和比值比（OR），并使用GRADE框架评估证据质量。结果显示，高肠道微生物α多样性与改善的总生存期和无进展生存期显著相关；特定菌属（如Akkermansia、Faecalibacterium）的存在与更好的客观缓解率或无进展生存期相关；近期抗生素使用与较差的生存结果相关；而在接受抗CTLA-4治疗的黑色素瘤患者中，拟杆菌门的高丰度与严重结肠炎风险降低相关。整体证据确定性为中等。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述F1（微生物组如何调节ICI疗效）提供了关键的定量综合证据，证实了肠道微生物组特征（多样性、特定菌属）与NSCLC和黑色素瘤患者ICI临床结局（生存、响应）的显著预后关联，并指出了抗生素使用的负面影响。同时，它为F2（机制）提供了部分支持性背景，讨论了特定菌属（如Akkermansia, Faecalibacterium）可能的免疫调节功能（T细胞招募、短链脂肪酸产生），但主要贡献在于表型关联而非机制验证。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅证明预后关联，不证明因果调节。证据等级为中等。主要针对NSCLC和黑色素瘤，外推至其他实体瘤需谨慎。对于irAEs，仅针对抗CTLA-4诱导的结肠炎有定量证据，其他irAEs证据不足。\",\n            \"contribution\": \"提供了肠道微生物组特征（高α多样性、Akkermansia存在、Faecalibacterium高丰度）与ICI疗效（OS, PFS, ORR）改善之间的定量关联证据（HR/OR值）。提供了抗生素使用与疗效下降关联的证据。提供了特定微生物特征（Bacteroidetes高丰度）与特定irAEs（抗CTLA-4诱导的结肠炎）风险降低的关联证据。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物组如何调节ICI疗效”中的“关联性”部分。可作为支持“某些微生物特征与更好疗效相关”这一观点的核心证据。可用于对比不同癌症类型（NSCLC vs. 黑色素瘤）或不同ICI药物（抗CTLA-4 vs. 抗PD-1）下微生物组影响的异同。\"\n          },\n          {\n            \"boundaries\": \"这些是作者基于现有文献提出的机制假说，并非本荟萃分析直接验证的机制。本综述本身不提供新的机制实验数据。机制解释具有推测性，需结合其他基础研究论文进行验证。\",\n            \"contribution\": \"在讨论部分提出了可能的机制解释：Akkermansia可能通过增强肿瘤微环境中CD4+和CD8+ T细胞的招募和激活来增强PD-1阻断疗效；Faecalibacterium作为丁酸盐的主要生产者，可能通过支持肠道屏障完整性和抗炎特性发挥作用；抗生素的有害影响可能与耗竭这些有益细菌有关。还提到了功能趋同的概念（如短链脂肪酸、次级胆汁酸代谢）。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于回答“哪些机制介导了这种效应”时，提供作者提出的假设性机制和文献支持的潜在通路。可用于引出“从分类学向功能分析转变”的讨论。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供领域背景和现状总结\",\n            \"material\": \"指出传统生物标志物（PD-L1, TMB）预测准确性有限，凸显寻找新生物标志物的需求。回顾了2018年两项开创性临床研究（Gopalakrishnan et al., Routy et al.）首次提供人体直接证据。\",\n            \"purpose\": \"用于综述引言或背景部分，说明研究肠道微生物组与ICI疗效关联的必要性和历史脉络。\"\n          },\n          {\n            \"connection_to_review\": \"提供方法论参考和局限性警示\",\n            \"material\": \"详细描述了系统综述和荟萃分析的方法，包括数据标准化策略（处理不同多样性指标和阈值）、效应量提取层级、亚组分析设计、以及GRADE证据质量评估。强调了观察性研究的因果推断限制和术语精确性（预后vs预测）。\",\n            \"purpose\": \"用于综述的方法论部分，展示如何综合观察性研究证据，或作为评估其他类似综述质量的参照。警示在解读微生物组-疗效关联时需考虑混杂因素和研究设计局限。\"\n          },\n          {\n            \"connection_to_review\": \"提供未来研究方向建议\",\n            \"material\": \"建议未来研究应关注微生物组的功能潜力（而非仅分类学），采用宏基因组测序，并进行前瞻性干预试验（如饮食、益生菌、FMT）以验证因果性和治疗潜力。\",\n            \"purpose\": \"用于综述的讨论或展望部分，指出当前领域的不足和未来突破方向。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究结论仅限于NSCLC和黑色素瘤，不能直接外推到其他实体瘤或血液肿瘤。\",\n          \"发现的关联是预后的，不等于预测性的；即微生物组特征与结局相关，但不一定特异性地预测ICI相对于其他治疗的额外获益。\",\n          \"证据确定性为“中等”，主要受限于观察性研究设计和结果异质性，解读时应保持谨慎，避免过度强调因果性。\",\n          \"对于irAEs，仅抗CTLA-4诱导的结肠炎有明确的定量保护关联证据，其他irAEs（尤其是抗PD-1相关）的证据不足或矛盾，不宜泛化。\",\n          \"机制解释是作者基于文献的推测，并非本综述的直接发现，引用时需明确区分关联证据和机制假说。\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiome alpha diversity\",\n          \"Akkermansia muciniphila\",\n          \"Faecalibacterium prausnitzii\",\n          \"Bacteroidetes\",\n          \"antibiotic use\",\n          \"immune checkpoint inhibitors (ICIs)\",\n          \"non-small cell lung cancer (NSCLC)\",\n          \"melanoma\",\n          \"overall survival (OS)\",\n          \"progression-free survival (PFS)\",\n          \"objective response rate (ORR)\",\n          \"immune-related adverse events (irAEs)\",\n          \"colitis\",\n          \"prognostic biomarker\",\n          \"systematic review and meta-analysis\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0298\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\82318ae05cff1667b2348961675db67dee4d8360\\\\1532f36597ac2d9671072fd86aa91df4\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\82318ae05cff1667b2348961675db67dee4d8360\\\\1532f36597ac2d9671072fd86aa91df4\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0204\",\n      \"title\": \"Characterizations of multi-kingdom gut microbiota in immune checkpoint inhibitor-treated hepatocellular carcinoma\",\n      \"year\": \"2024\",\n      \"doi\": \"10.1136/jitc-2023-008686\",\n      \"paper_id\": \"58ddfd822378599d43b877cd0905dfe067a4375f\",\n      \"material_depth\": \"abstract\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用前瞻性观察性研究设计。纳入2018年11月至2022年4月期间接受ICI治疗的80例晚期HCC患者。通过宏基因组测序分析细菌群落，通过ITS2测序分析真菌群落，并通过代谢组学分析代谢产物。将患者分为持久临床获益（DCB）和非持久临床获益（NDB）两组，比较两组间微生物多样性、物种组成及代谢物的差异。利用统计建模筛选预测ICI持续获益的细菌物种模型，并识别预测生存的预后生物标志物。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"首次在多组学水平描述了ICI治疗HCC患者中肠道细菌、真菌及其代谢物的状态和特征。\",\n            \"limits\": \"所给摘要未交代具体的统计校正方法、样本量计算依据、外部验证情况以及潜在的混杂因素控制细节。\"\n          },\n          {\n            \"contribution\": \"提供了基于多界微生物群的ICI疗效预测和预后评估的生物标志物候选列表。\",\n            \"limits\": \"预测模型的泛化能力仅限于当前80人的单中心或特定队列，缺乏独立验证集的支持；作者声称的“首次”描述需结合领域内其他类似研究进行核实，且单一队列的结果可能存在情境依赖性。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"DCB组 vs NDB组\",\n            \"finding\": \"细菌和代谢物在DCB与NDB组之间差异显著，而真菌的差异较小。\"\n          },\n          {\n            \"conditions\": \"治疗前基线状态\",\n            \"finding\": \"DCB组的细菌和真菌整体多样性高于NDB组；这种多样性差异在治疗6-8周后开始发生变化。\"\n          },\n          {\n            \"conditions\": \"预测模型构建\",\n            \"finding\": \"建立了包含18个细菌物种的模型，用于预测免疫治疗是否带来持续获益，曲线下面积（AUC）为75.63%。\"\n          },\n          {\n            \"conditions\": \"预后生物标志物筛选\",\n            \"finding\": \"筛选出两种细菌（Actinomyces_sp_ICM47, Senegalimassilia_anaerobia）和一种代谢物（galanthaminone）作为ICI治疗HCC患者生存的预后生物标志物。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"尽管已有研究探讨肠道细菌与ICI反应的联系，但ICI治疗HCC队列中多界（细菌、真菌）微生物组的改变及其相互作用尚不完全清楚。本研究试图填补这一知识空白，探索多界微生物群作为ICI疗效预测和预后生物标志物的潜力。\",\n        \"research_scope\": \"接受免疫检查点抑制剂（ICI）治疗的晚期肝细胞癌（HCC）患者队列，涉及肠道细菌、真菌及其代谢产物的多组学分析。\",\n        \"work_summary\": \"该研究旨在阐明多界肠道微生物群在ICI治疗HCC中的特征及其与临床疗效的关系。研究前瞻性纳入了80名接受ICI治疗的晚期HCC患者，利用宏基因组学、ITS2测序和代谢组学数据，对患者的肠道细菌、真菌及代谢物进行了多组学表征。研究比较了具有持久临床获益（DCB）与非持久临床获益（NDB）患者在治疗前后的微生物多样性变化，并尝试建立基于微生物特征的预测模型。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文提供了关于肠道多界微生物群（细菌+真菌+代谢物）如何关联ICI在实体瘤（HCC）中疗效的具体实证数据。其核心价值在于不仅关注细菌，还引入了真菌和代谢物视角，并区分了疗效预测（DCB/NDB）和生存预后两个维度。这有助于综述理解微生物组干预或监测的多维复杂性，特别是真菌和代谢物在其中的潜在角色，以及不同微生物类群对疗效影响的异质性。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"结果来自HCC特定人群，外推至其他实体瘤需谨慎；预测模型未经外部验证；仅展示了关联性，未直接证明因果机制。\",\n            \"contribution\": \"提供了肠道细菌和代谢物多样性及组成与ICI疗效（DCB vs NDB）关联的具体证据，显示细菌/代谢物差异显著而真菌差异较小；同时提供了基于18种细菌的预测模型（AUC=75.63%）。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"可用于支持“肠道微生物组调节ICI疗效”的观点，特别是强调细菌和代谢物的关键作用，以及真菌可能起次要或不同作用的角色。可作为具体案例说明微生物特征如何预测临床结局。\"\n          },\n          {\n            \"boundaries\": \"摘要未提供这些生物标志物具体的生物学作用机制或实验验证路径；仅为观察性关联，不能直接推断因果机制；样本量有限，可能存在假阳性风险。\",\n            \"contribution\": \"识别了与生存相关的特定细菌物种（Actinomyces_sp_ICM47, Senegalimassilia_anaerobia）和代谢物（galanthaminone），暗示这些分子可能与免疫治疗的长期效果或患者生存有关。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"可作为讨论“介导效应的机制”时的潜在线索，提示特定代谢物或菌种可能参与调节抗肿瘤免疫或宿主反应。可用于举例说明多组学整合在发现机制相关生物标志物中的应用。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"有助于综述引入或强化“肠道微生物组不仅是细菌，还包括真菌和代谢网络”的整体视角，丰富对微生物组复杂性的理解。\",\n            \"material\": \"研究强调了“多界”（multi-kingdom）微生物组的概念，即细菌、真菌和代谢物共同构成复杂的生态系统。\",\n            \"purpose\": \"背景与概念框架\"\n          },\n          {\n            \"connection_to_review\": \"可用于讨论微生物组各组成部分在免疫治疗响应中的异质性影响，避免将所有微生物效应简单归因于细菌。\",\n            \"material\": \"研究发现真菌在DCB/NDB间的差异小于细菌，提示不同微生物类群对ICI反应的贡献度可能不同。\",\n            \"purpose\": \"实例与反例/差异性分析\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究针对的是肝细胞癌（HCC）这一特定实体瘤，其微生物组特征和治疗反应可能与其他实体瘤存在差异，外推时需考虑肿瘤类型特异性。\",\n          \"预测模型基于80人的队列，缺乏独立验证，其临床实用性和泛化能力有待进一步证实。\",\n          \"作者声称的“首次”多组学描述需结合领域现状谨慎解读，可能存在其他类似研究未被本摘要涵盖。\",\n          \"观察性研究设计无法确立因果关系，发现的生物标志物仅为潜在关联，需后续功能实验验证。\"\n        ],\n        \"topic_handles\": [\n          \"multi-kingdom microbiota (bacteria, fungi)\",\n          \"immune checkpoint inhibitors (ICI) in hepatocellular carcinoma (HCC)\",\n          \"durable clinical benefit (DCB) vs non-durable clinical benefit (NDB)\",\n          \"predictive biomarkers for ICI efficacy\",\n          \"prognostic biomarkers for survival\",\n          \"metagenomics and metabolomics integration\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0204\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\58ddfd822378599d43b877cd0905dfe067a4375f\\\\5b464303e56a340ad06b12774df0952c\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"kind\": \"identity\",\n            \"reason\": \"source identity was not independently verified\",\n            \"status\": \"input_attributed\"\n          },\n          {\n            \"kind\": \"coverage\",\n            \"reason\": \"no complete research body was indexed\",\n            \"status\": \"partial\"\n          },\n          {\n            \"kind\": \"html\",\n            \"reason\": \"html_not_scholarly_body\",\n            \"status\": \"partial\"\n          },\n          {\n            \"kind\": \"html\",\n            \"reason\": \"html_challenge_or_login\",\n            \"status\": \"partial\"\n          },\n          {\n            \"kind\": \"coverage\",\n            \"reason\": \"only abstract or non-title snippets were available\",\n            \"status\": \"partial\"\n          }\n        ],\n        \"material_scope\": \"abstract_only\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\58ddfd822378599d43b877cd0905dfe067a4375f\\\\5b464303e56a340ad06b12774df0952c\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0270\",\n      \"title\": \"Composition of gastrointestinal microbiota in association with treatment response in individuals with metastatic castrate resistant prostate cancer progressing on enzalutamide and initiating treatment with anti-PD-1 (pembrolizumab)\",\n      \"year\": \"2022\",\n      \"doi\": \"10.1016/j.neo.2022.100822\",\n      \"paper_id\": \"74786f8df0c7648840756833a4b4bc49ace34be6\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用前瞻性观察性队列设计。收集23名mCRPC患者在基线及治疗期间的直肠拭子（粪便）和口腔漱口水样本。使用Ion Torrent平台进行16S rRNA基因多重高变区测序，结合DADA2去噪和QIIME2分析流程进行物种分类。使用GLM整合多区域数据以评估差异丰度。通过qPCR独立验证关键菌种（S. salivarius, A. muciniphila）。纵向分析了9名患者的全程治疗样本以评估时间效应。将结果与既往文献及Shaikh等人的“综合指数”进行比较。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了首个针对mCRPC患者在接受ICI治疗前/初期微生物组特征的系统描述，揭示了该人群中特有的微生物-反应关联模式（如S. salivarius的正向关联和A. muciniphila的负向关联）。\",\n            \"limits\": \"样本量较小（n=23），统计效力有限；仅使用16S rRNA测序而非宏基因组，分辨率受限；未深入探讨具体的代谢机制或因果路径；结果可能受既往恩杂鲁胺治疗、饮食、地理因素等混杂因素影响；作者承认部分分类学鉴定存在不确定性（如Roseburia属）。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"First Timepoint cohort (n=23), 16S sequencing & qPCR\",\n            \"finding\": \"整体α和β多样性在反应者与非反应者间无显著差异；个体间变异占主导（~50%）。\"\n          },\n          {\n            \"conditions\": \"First Timepoint cohort, GLM analysis of multiple hypervariable regions\",\n            \"finding\": \"Streptococcus salivarius在反应者粪便中显著富集（p=0.004），且qPCR证实该趋势；但该菌在口腔漱口水中的水平与反应无关，且口腔与粪便水平不相关。\"\n          },\n          {\n            \"conditions\": \"First Timepoint cohort, 16S sequencing (V6-7 region) & qPCR\",\n            \"finding\": \"Akkermansia muciniphila在反应者中显著降低（与黑色素瘤等其他癌症报道相反），qPCR确认了这一减少趋势。\"\n          },\n          {\n            \"conditions\": \"Longitudinal analysis (n=9 patients across treatment cycles)\",\n            \"finding\": \"帕博利珠单抗治疗未引起全局微生物组成的显著变化；个体内样本聚类紧密，时间点对变异贡献极小（<3%）。\"\n          },\n          {\n            \"conditions\": \"Application of Shaikh et al. integrated index\",\n            \"finding\": \"该综合指数未能区分本队列中的反应者与非反应者，表明不同癌症类型或治疗史可能导致微生物信号的特异性。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"既往研究表明肠道微生物影响ICI疗效，但在mCRPC背景下，特别是经过雄激素受体抑制剂（如恩杂鲁胺）预处理后的患者中，微生物组特征如何预测帕博利珠单抗的治疗反应？是否存在不同于其他实体瘤（如黑色素瘤）的微生物标志物？\",\n        \"research_scope\": \"转移性去势抵抗性前列腺癌（mCRPC）患者，在恩杂鲁胺治疗进展后接受抗PD-1免疫检查点抑制剂（帕博利珠单抗）治疗。样本为粪便和口腔漱口水DNA。\",\n        \"work_summary\": \"本研究旨在探究肠道微生物组组成与mCRPC患者对免疫检查点抑制剂（ICI）治疗反应的关联。研究纳入了23名在恩杂鲁胺治疗下疾病进展并即将开始帕博利珠单抗治疗的mCRPC患者。通过16S rRNA基因测序（覆盖多个高变区）和定量PCR（qPCR），比较了治疗反应者（PSA下降>50%或影像学缓解）与非反应者的微生物特征。研究发现，尽管整体α和β多样性在主要队列中无显著差异，但特定菌属存在差异：反应者中粪肠球菌、拟杆菌等富集，而此前在其他癌症中被认为促进ICI疗效的黏蛋白降解菌Akkermansia muciniphila在反应者中反而减少。此外，发现口腔共生菌Streptococcus salivarius在粪便中的丰度与反应正相关，但在口腔样本中无此关联，提示其作用具有部位特异性。研究还验证了一个综合微生物指数在本队列中无效，并观察到治疗期间微生物组总体稳定。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于“癌症类型特异性微生物标志物”的关键实证素材。它挑战了跨癌种通用的微生物预测模型（如A. muciniphila作为通用增效菌的假设），并提出了“既往内分泌治疗史”可能重塑微生物组对ICI反应的影响这一重要视角。同时，其纵向数据证明了ICI治疗本身对微生物组的稳定性，排除了药物急性干扰作为主要混淆因素的可能性。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅限mCRPC人群，且处于恩杂鲁胺治疗失败后阶段；不能直接外推至初治前列腺癌或其他早期癌症。\",\n            \"contribution\": \"提供了mCRPC背景下特定的微生物标志物列表：S. salivarius（正向关联）、Bacteroides thetaiotaomicron（正向关联）、Enterococcaceae（正向关联）以及Akkermansia muciniphila（负向关联）。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“哪些细菌与ICI疗效相关”，特别是用于对比不同实体瘤（如黑色素瘤、肺癌）中的通用标志物，论证标志物的异质性。\"\n          },\n          {\n            \"boundaries\": \"指数构建依赖于原始研究的分类学一致性，本研究中因分类差异进行了修正，结果反映的是修正后的指数表现。\",\n            \"contribution\": \"展示了基于多癌种数据的“综合指数”在本队列中失效的结果，强调了单一通用指数可能不适用于所有癌症类型。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于讨论现有微生物预测模型的局限性，支持需要针对特定癌症亚型开发个性化生物标志物的观点。\"\n          },\n          {\n            \"boundaries\": \"这些机制多为基于文献的推测或体外/动物模型证据，本研究本身未直接测定肌苷水平或进行功能实验，属于作者的解释性讨论而非直接实验证据。\",\n            \"contribution\": \"探讨了A. muciniphila产生肌苷（inosine）的可能机制，并提出在前列腺癌中肌苷可能促进转移的相反假说，解释了为何其在反应者中减少。同时提及S. salivarius可能通过调节PPAR gamma发挥免疫调节作用。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于解释微生物影响ICI疗效的潜在分子机制，特别是提供与经典机制（如肌苷-T细胞激活）相悖的案例，丰富机制部分的复杂性讨论。\"\n          },\n          {\n            \"boundaries\": \"仅涵盖短期治疗周期（4个周期+监测期），长期效应未知。\",\n            \"contribution\": \"纵向数据显示ICI治疗期间微生物组高度稳定，排除了治疗药物本身导致微生物组剧烈波动从而间接影响疗效的主要可能性。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持“基线微生物组决定疗效”而非“治疗诱导的微生物组变化决定疗效”的观点，或用于排除治疗时间点的混杂效应。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"背景与概念：既往雄激素剥夺疗法（ADT）对肠道微生物组的影响。\",\n            \"material\": \"文中提到既往研究显示恩杂鲁胺等雄激素受体轴靶向治疗会增加A. muciniphila水平，这可能构成了本研究中患者基线微生物组的背景状态。\",\n            \"purpose\": \"帮助解释为何本研究中A. muciniphila的表现与其他ICI研究不同，提示既往内分泌治疗可能是塑造微生物组-ICI反应关系的关键情境变量。\"\n          },\n          {\n            \"connection_to_review\": \"实例：口腔与肠道微生物组的解耦。\",\n            \"material\": \"S. salivarius在粪便中与疗效相关，但在口腔样本中无关联，且两者水平不相关。\",\n            \"purpose\": \"作为实例说明非侵入性口腔采样可能无法准确代表肠道微生物状态，特别是在涉及特定口腔来源但定植于肠道的细菌时，强调采样部位选择的重要性。\"\n          },\n          {\n            \"connection_to_review\": \"反例：通用预测模型的失效。\",\n            \"material\": \"Shaikh等人的综合指数在本队列中无预测价值。\",\n            \"purpose\": \"作为反例，证明并非所有癌症都对相同的微生物组合产生反应，反对过度泛化的微生物生物标志物主张。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究结果严格限定于“恩杂鲁胺治疗进展后”的mCRPC患者，其微生物组状态深受既往内分泌治疗影响，不能直接推广至未经内分泌治疗的前列腺癌患者或初治实体瘤患者。\",\n          \"A. muciniphila在反应者中的减少与多数其他ICI研究相反，这可能与前列腺癌的特定病理生理环境（如肌苷促转移风险）或既往用药有关，解读时需避免将其视为普适规律。\",\n          \"S. salivarius的发现虽显著，但其具体免疫调节机制在本研究中仅为推测，需结合其他功能学研究谨慎引用。\",\n          \"样本量较小（n=23），发现的差异丰度菌群可能存在假阳性风险，尤其是qPCR验证仅针对少数几个菌种。\"\n        ],\n        \"topic_handles\": [\n          \"metastatic castrate resistant prostate cancer (mCRPC)\",\n          \"anti-PD-1 therapy (pembrolizumab)\",\n          \"prior androgen receptor axis-targeted therapy (enzalutamide)\",\n          \"fecal microbiome composition\",\n          \"oral vs. gut microbiome dissociation\",\n          \"microbiome stability during ICI treatment\",\n          \"integrated microbiome prediction index failure\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0270\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\74786f8df0c7648840756833a4b4bc49ace34be6\\\\c1940e865b3b0f03711a8874b089c162\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\74786f8df0c7648840756833a4b4bc49ace34be6\\\\c1940e865b3b0f03711a8874b089c162\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0393\",\n      \"title\": \"Multi-Kingdom Gut Microbiome Interaction Characteristics Predict Immune Checkpoint Inhibitor Efficacy Across Pan-Cancer Cohorts\",\n      \"year\": \"2025\",\n      \"doi\": \"10.3390/microorganisms13112595\",\n      \"paper_id\": \"a9e58de949ced186b4882146c14b79b306ae9ef5\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"1. 数据收集与预处理：从NCBI数据库获取10个队列的宏基因组原始数据，进行质控、宿主DNA去除、标准化测序深度（rarefaction至915,968 reads）及物种丰度估算（Kraken2/Bracken）。2. 多界聚类分析：对各微生物域的相对丰数据进行Hellinger转换，计算Bray-Curtis距离矩阵并转换为相似性矩阵，赋予权重后使用WSNF算法进行样本聚类，通过轮廓系数确定最佳聚类数（分为C1和C2两个亚型）。3. 多样性与临床关联分析：使用Shannon和Observed species指数评估Alpha多样性，PCoA和PERMANOVA评估Beta多样性；结合Kaplan-Meier生存分析和卡方检验分析亚型与治疗反应（Responder/Non-Responder）、无进展生存期（PFS）及总生存期（OS）的关系。4. 差异物种鉴定与建模：在训练集（70%样本）中使用DESeq2进行跨亚型差异分析，设定阈值筛选显著差异属，构建包含32个属的多界诊断模型。5. 机器学习验证：在独立测试集（30%样本）中应用随机森林和支持向量机算法，比较多界模型与单界模型的分类性能（ROC曲线/AUC）。6. 共现网络分析：使用FastSpar工具计算SparCC相关性，构建微生物共现网络，分析节点连接度和核心菌属。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了首个基于大规模多队列整合的多界微生物组（细菌+真菌+古菌+病毒）ICI疗效预测模型，证实多界联合特征比单一细菌特征具有更高的预测精度。\",\n            \"limits\": \"所给摘要未交代具体的外部验证队列细节（仅提及内部70/30划分）；未提供因果机制的实验验证，仅为观察性关联；不同癌症类型和治疗方案（如抗PD-1 vs 联合疗法）的异质性处理情况未详细展开。\"\n          },\n          {\n            \"contribution\": \"揭示了高微生物多样性和稳定网络结构与良好ICI预后之间的关联，提出了“多界生态稳定性”作为疗效预测的新视角。\",\n            \"limits\": \"所给摘要未交代网络分析是否控制了混杂因素（如抗生素使用、饮食等）；具体微生物介导免疫调节的分子机制仍属于推测，需后续实验验证。\"\n          },\n          {\n            \"contribution\": \"识别了跨界的潜在生物标志物组合（如Bacteroides与Kluyveromyces的组合），为个性化微生态干预提供了候选靶点。\",\n            \"limits\": \"所给摘要未交代这些标志物在不同种族、地理区域人群中的普适性验证结果；部分低丰度微生物界（如病毒、古菌）的信号可能受测序深度和技术偏差影响。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"基于WSNF聚类的两个亚型（C1 vs C2），涉及965例多癌种ICI治疗患者\",\n            \"finding\": \"C2亚型表现出显著更高的Alpha多样性（Shannon和Observed species指数）和更复杂的Beta多样性结构；C2亚型中响应者比例更高，且总体生存期（OS）和无进展生存期（PFS > 6个月）显著优于C1亚型。\"\n          },\n          {\n            \"conditions\": \"多界微生物组成差异分析\",\n            \"finding\": \"C2亚型富集有益菌属，如细菌界的Bacteroides、Parabacteroides，真菌界的Kluyveromyces；C1亚型富集潜在有害菌属，如Malassezia。古菌和病毒界也显示出显著的亚型特异性分布。\"\n          },\n          {\n            \"conditions\": \"机器学习模型预测效能比较\",\n            \"finding\": \"由32个多界微生物属组成的诊断模型在区分ICI疗效方面表现出优于单一细菌、真菌、古菌或病毒模型的预测准确性（更高的AUC值）。\"\n          },\n          {\n            \"conditions\": \"微生物共现网络分析\",\n            \"finding\": \"C2亚型的微生物共现网络更为密集和稳健，强正相关连接（|ρ| > 0.5）的数量显著多于C1亚型；拟杆菌属（Bacteroides）在C2中为核心枢纽菌属，而Komagataella在C1中更具中心性。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"既往关于肠道微生物组与ICI疗效的研究主要局限于细菌领域，忽略了真菌、古菌和病毒等其他微生物界的作用。本研究试图解决以下问题：1. 多界微生物组的整体特征是否存在特定的分型模式？2. 这些多界微生物特征是否能比单一细菌特征更准确地预测ICI治疗的疗效？3. 不同微生物界之间的相互作用网络如何影响治疗效果？\",\n        \"research_scope\": \"该研究针对接受免疫检查点抑制剂（ICI）治疗的多种实体瘤患者，研究对象为肠道多界微生物组（包括细菌、真菌、古菌和病毒）。数据来源于全球7个国家的10个队列，共1712名患者的粪便宏基因组测序数据。最终纳入分析的有效样本为965例，涵盖黑色素瘤、非小细胞肺癌、胃肠道肿瘤和肾细胞癌等。\",\n        \"work_summary\": \"本研究旨在评估多界微生物组及其相互作用对ICI治疗疗效的预测价值。作者整合了来自多个队列的大规模宏基因组数据，利用加权相似性网络融合（WSNF）方法将四种微生物域的数据整合并进行聚类，识别出两种患者亚型（C1和C2）。研究发现，C2亚型具有更高的微生物多样性、更稳定的共现网络结构，且与更好的ICI治疗反应和预后显著相关。通过差异分析和机器学习模型，作者筛选出包含32个属的多界微生物特征组合，其预测ICI疗效的准确性优于单一界别的模型。此外，研究还揭示了特定有益菌属（如拟杆菌属、克鲁维酵母属）和潜在有害菌属（如马拉色菌属）在不同亚型中的分布差异及其与免疫调节机制的关联。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于“多界微生物组（Multi-Kingdom Microbiome）”在ICI疗效预测中价值的实证素材。它超越了传统的单一细菌视角，通过整合细菌、真菌、古菌和病毒数据，证明了多界联合特征能提升预测精度，并强调了微生物网络稳定性和多样性的重要性。这对于综述中讨论“超越细菌的微生物组作用”、“多界互作机制”以及“复杂生态特征作为生物标志物”的子问题具有直接参考价值。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"该结论基于回顾性队列数据的观察性关联，不能直接推断因果关系；不同癌症类型和治疗方案的混合可能引入异质性，需谨慎外推至特定单一癌种或特定药物类别。\",\n            \"contribution\": \"提供了多界微生物组特征（特别是高多样性和特定属的组合）与ICI疗效正相关的实证证据。指出C2亚型（高多样性、富含Bacteroides/Kluyveromyces）与更好的治疗反应和生存率相关，而C1亚型（低多样性、富含Malassezia）与较差预后相关。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持综述中关于“肠道微生物组特征如何影响ICI疗效”的论述，特别是强调多界微生物而非单一细菌的重要性。可作为“微生物多样性/网络稳定性促进疗效”这一观点的具体案例。\"\n          },\n          {\n            \"boundaries\": \"所给材料未提供直接的机制实验数据（如动物模型或体外细胞实验），所有机制解释均为基于文献的推测和关联分析，属于理论假说层面，需注明其为作者的解释而非已验证的因果链条。\",\n            \"contribution\": \"提出了多界微生物通过维持肠道生态稳定性和产生免疫调节代谢物（如短链脂肪酸）来增强抗肿瘤免疫的潜在机制假设。讨论了Bacteroides fragilis诱导树突状细胞成熟和Th1细胞浸润，以及Malassezia激活补体级联反应导致免疫抑制的可能路径。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于综述中探讨“微生物介导ICI疗效的机制”部分，提供多界微生物互作影响宿主免疫的微环境背景。可与其他研究共同构建“微生物-免疫-肿瘤”轴的理论框架。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"方法论参考\",\n            \"material\": \"使用了WSNF方法整合多界宏基因组数据，并通过机器学习（随机森林/SVM）构建预测模型。\",\n            \"purpose\": \"在综述的方法学部分或讨论中，可作为处理多组学或多界微生物数据整合策略的一个实例，展示如何利用高级统计学习方法挖掘复杂微生物组数据的预测潜力。\"\n          },\n          {\n            \"connection_to_review\": \"临床干预启示\",\n            \"material\": \"讨论了抗生素使用对微生物多样性的负面影响，以及粪菌移植（FMT）、益生菌（Clostridium butyricum）和益生元（inulin-type fructans）在改善ICI疗效中的潜在应用。\",\n            \"purpose\": \"为综述中关于“基于微生物组的临床干预策略”提供背景支持和现有证据汇总，说明当前从观察性研究向干预性转化研究的趋势。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究为观察性回顾性分析，发现的是微生物特征与疗效的统计学关联，而非因果证明。\",\n          \"数据来自多个国家和癌种，存在潜在的批次效应和人群异质性，尽管作者进行了标准化处理，但外推至特定单一群体时需考虑情境依赖性。\",\n          \"多界微生物中病毒和古菌的丰度较低，其检测灵敏度和生物学意义可能受技术限制，解读时需注意低丰度信号的不确定性。\",\n          \"作者提出的机制（如Bacteroides诱导Th1，Malassezia激活补体）引用自其他研究，并非本研究的直接实验发现，需明确区分为本研究的关联发现与文献支持的机制假设。\"\n        ],\n        \"topic_handles\": [\n          \"multi-kingdom microbiome (bacteria, fungi, archaea, virus)\",\n          \"immune checkpoint inhibitor (ICI) efficacy prediction\",\n          \"weighted similarity network fusion (WSNF) clustering\",\n          \"microbial co-occurrence networks and stability\",\n          \"pan-cancer cohorts (melanoma, NSCLC, GI cancer, RCC)\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0393\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\a9e58de949ced186b4882146c14b79b306ae9ef5\\\\0d2d554bf04c73844ba0235b3e8cee2f\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\a9e58de949ced186b4882146c14b79b306ae9ef5\\\\0d2d554bf04c73844ba0235b3e8cee2f\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0565\",\n      \"title\": \"Gut Microbiome Composition and Response to Immune Checkpoint Inhibitors in Melanoma: A Systematic Review\",\n      \"year\": \"2026\",\n      \"doi\": \"10.7759/cureus.113248\",\n      \"paper_id\": \"f9a9ef8d406ee51983cd285f9e60fc41574ae937\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"遵循PRISMA 2020指南进行系统综述。单一评审员执行文献搜索、筛选、数据提取和偏倚风险评估。使用ROBINS-I工具评估观察性研究的偏倚风险。由于临床、方法和统计异质性过大，无法进行定量荟萃分析，因此采用基于效应方向和一致性的叙事综合（Narrative Synthesis）。重点分析了特定菌属/种、代谢通路、饮食因素以及纵向动态变化。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了截至2025年关于肠道微生物组与黑色素瘤ICI反应关联的全面定性综合，明确了SCFA产生菌的积极角色和真菌失调的消极角色，并指出了微生物组作为预测生物标志物和潜在治疗靶点的潜力。\",\n            \"limits\": \"由于严重的异质性，无法提供定量效应估计。证据主要来自观察性研究，存在显著的混杂和选择偏倚。结论受限于纳入研究的规模小、单中心设计以及分析方法的不一致性。不能直接外推至其他癌症类型或不同免疫疗法组合。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"多数队列中\",\n            \"finding\": \"产短链脂肪酸（SCFA）的菌属（如Faecalibacterium prausnitzii, Akkermansia muciniphila, Bifidobacterium）丰度增加通常与治疗反应改善相关；而病原体或真菌（如Candida albicans, Malassezia restricta）富集或与失调相关的特征则与疗效降低和不良生存结局相关。\"\n          },\n          {\n            \"conditions\": \"跨队列比较时\",\n            \"finding\": \"微生物组-反应关联具有高度异质性和队列依赖性。没有单一的微生物签名能一致地预测所有队列的反应。例如，F. prausnitzii在某些队列中与无反应相关，而在其他大型再分析中被识别为一致的阳性生物标志物。\"\n          },\n          {\n            \"conditions\": \"机制层面\",\n            \"finding\": \"微生物衍生的代谢物（如SCFA、钴胺素）可能通过调节树突状细胞功能、抗原呈递和T细胞激活来影响抗肿瘤免疫。纵向数据显示，治疗期间A. muciniphila的丢失可能与早期耐药性相关。\"\n          },\n          {\n            \"conditions\": \"证据质量\",\n            \"finding\": \"纳入的25项研究中，17项（68%）被评定为中度偏倚风险，8项（32%）为严重偏倚风险。主要偏倚来源包括残留混杂因素和小样本单中心设计。没有研究被评为低风险。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管免疫检查点抑制剂改善了黑色素瘤患者的临床结局，但治疗反应差异巨大且缺乏可靠的预测生物标志物。本研究旨在解决：肠道微生物组的哪些特征（组成、多样性、功能）与ICI的治疗反应相关？其潜在的生物学机制是什么？当前的证据基础质量如何？\",\n        \"research_scope\": \"人类黑色素瘤患者，接受免疫检查点抑制剂（ICI，包括抗PD-1、抗PD-L1或抗CTLA-4）治疗。聚焦于肠道微生物组（组成、多样性、代谢功能）与治疗反应（疗效及免疫相关不良事件irAEs）之间的关联。纳入2015-2025年间发表的观察性研究和数据集二次分析，排除干预性试验和仅暴露研究。\",\n        \"work_summary\": \"这是一篇系统综述，旨在评估肠道微生物组特征与黑色素瘤患者免疫检查点抑制剂治疗反应之间的关联及其潜在机制。作者通过PubMed数据库检索并筛选出25项符合条件的观察性研究，采用定性综合而非定量荟萃分析的方法，因为各研究在测序平台、分类方法、结果定义和分析流程上存在显著异质性。研究评估了微生物组成、多样性及代谢功能对治疗结局的影响，并使用了ROBINS-I工具对纳入研究的偏倚风险进行了正式评估。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该综述为“肠道微生物组如何调节实体瘤中免疫检查点抑制剂的疗效”这一核心问题提供了关键的背景框架和具体证据汇总。它详细列举了与疗效正负相关的特定微生物类群（如F. prausnitzii, A. muciniphila vs. Candida），阐述了潜在的免疫调节机制（SCFA、DC成熟、T细胞激活），并强调了当前证据的异质性和局限性。这对于构建综述中关于“微生物组作为生物标志物的现状与挑战”以及“机制解释”的部分至关重要。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"这些关联主要基于观察性研究，存在混杂因素。不同队列间结果不一致，不能简单地将某一菌属视为通用生物标志物。\",\n            \"contribution\": \"提供了具体的微生物特征与ICI疗效关联的证据汇总：产SCFA菌（F. prausnitzii, A. muciniphila）通常与良好反应相关，而真菌失调（Candida, Malassezia）与较差反应相关。同时指出这种关联是异质的，没有单一的一致性签名。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“哪些微生物特征与疗效相关”，支持综述中关于“微生物组作为疗效预测因子”的论述，特别是强调其非普适性和情境依赖性。\"\n          },\n          {\n            \"boundaries\": \"许多机制证据来自动物模型或体外研究，在黑色素瘤患者中的直接因果证据有限。综述本身未提供新的实验数据，而是综合现有解释。\",\n            \"contribution\": \"阐述了微生物组影响免疫治疗的潜在机制：SCFA促进树突状细胞成熟、抗原呈递和CD8+ T细胞激活；微生物屏障完整性受损可能导致免疫抑制。还提到了纵向动态变化（如A. muciniphila丢失预示耐药）作为早期指标。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于回答“机制是什么”，为综述中的机制部分提供具体的分子和细胞层面的解释路径，连接微生物特征与宿主免疫反应。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"可用于综述中讨论“为什么目前缺乏标准化的微生物组生物标志物”或“未来研究需要标准化方法”的部分，强调方法论进步的重要性。\",\n            \"material\": \"综述指出当前研究存在严重的异质性，包括测序平台、生物信息学管道、差异丰度分析方法（如LEfSe, DESeq2, ANCOM）的不一致，以及组成型数据的统计陷阱。这解释了为什么难以获得统一的生物标志物。\",\n            \"purpose\": \"提供领域现状和方法论挑战的背景\"\n          },\n          {\n            \"connection_to_review\": \"可用于综述中讨论“影响微生物组-疗效关联的外部因素”或“从基础研究到临床应用的障碍”，提醒读者注意观察性研究的局限性。\",\n            \"material\": \"提到饮食（纤维、Omega-3）、抗生素使用、地理变异和宿主遗传是常见的混杂因素。大多数研究是小样本单中心设计，偏倚风险高。\",\n            \"purpose\": \"提供混杂因素和临床转化障碍的实例\"\n          },\n          {\n            \"connection_to_review\": \"用于平衡综述观点，避免过度简化微生物组的作用，强调“上下文依赖性”和“队列特异性”。\",\n            \"material\": \"指出某些研究发现α多样性与反应无关，或特定菌属在不同队列中表现相反（如F. prausnitzii在某些情况下与无反应相关）。\",\n            \"purpose\": \"提供负面或阴性结果的参考\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该综述仅针对黑色素瘤，虽然机制可能与其他实体瘤有重叠，但不能直接假设其在所有实体瘤中具有相同的效力或特异性。\",\n          \"纳入的研究均为观察性设计，因此发现的关联不等于因果关系。尽管引用了一项小鼠干预研究支持因果性，但这属于外部证据，非本综述的主要发现。\",\n          \"由于异质性，综述未提供合并效应量。任何关于特定菌属效应的解读都应谨慎，避免将其视为确定的预测标准。\",\n          \"综述承认未进行定量荟萃分析，因此其结论是基于叙事综合，可能存在选择偏倚或主观解释。\"\n        ],\n        \"topic_handles\": [\n          \"Gut microbiome composition (taxa abundance: F. prausnitzii, A. muciniphila, Bifidobacterium, Candida)\",\n          \"Microbial diversity (alpha diversity heterogeneity)\",\n          \"Metabolic function (SCFA production, cobalamin pathways)\",\n          \"Mechanisms of action (DC maturation, antigen presentation, CD8+ T-cell activation, barrier integrity)\",\n          \"Predictive biomarkers (baseline vs. longitudinal changes)\",\n          \"Methodological heterogeneity (sequencing platforms, analytical pipelines, compositional data issues)\",\n          \"Confounding factors (diet, antibiotics, geography)\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0565\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\f9a9ef8d406ee51983cd285f9e60fc41574ae937\\\\db5022dafdd72bdf3a6676f8f888159f\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\f9a9ef8d406ee51983cd285f9e60fc41574ae937\\\\db5022dafdd72bdf3a6676f8f888159f\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0545\",\n      \"title\": \"A Clinical Outcome of the Anti-PD-1 Therapy of Melanoma in Polish Patients Is Mediated by Population-Specific Gut Microbiome Composition\",\n      \"year\": \"2022\",\n      \"doi\": \"10.3390/cancers14215369\",\n      \"paper_id\": \"f31246cd559d1a06b99a32b0ee47bb1ce0265772\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用前瞻性队列研究设计。纳入标准：组织学确诊的不可切除III期或IV期皮肤黑色素瘤患者，接受抗PD-1单药治疗（纳武利尤单抗或帕博利珠单抗）。对照组为患者的直系亲属（健康人）。主要终点：根据RECIST v.1.1标准评估的治疗反应（完全缓解CR、部分缓解PR定义为响应者；疾病稳定SD、进展PD定义为非响应者）。数据采集：治疗前通过问卷收集社会人口学、临床、生活方式和饮食变量；采集基线粪便样本。实验室分析：使用DNeasy PowerSoil Pro提取DNA，扩增16S rRNA基因V3-V4区进行Illumina MiSeq测序，使用DADA2流程生成ASVs并基于SILVA数据库进行分类；对部分样本进行宏基因组鸟枪法测序以重建MAGs。统计分析：比较各组间的菌群多样性（Alpha/Beta）、相对丰度及临床特征差异，使用Kruskal-Wallis检验、Fisher精确检验及limma线性模型识别差异物种。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了波兰这一特定欧洲人群背景下，肠道微生物组特征与抗PD-1治疗反应的关联证据，指出了与该人群饮食模式（如高植物摄入）相关的潜在有益菌属（P. copri, B. uniformis）。\",\n            \"limits\": \"样本量较小（尤其是对照组仅10人，且年龄显著小于患者组）；观察性研究设计无法确立因果关系；饮食数据依赖自我报告问卷，可能存在回忆偏倚；未直接测量微生物代谢产物机制；不同研究间关于特定菌属（如Faecalibacterium）作用的矛盾结果提示人群异质性，限制了单一生物标志物的普适性。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"波兰黑色素瘤患者队列，基线状态\",\n            \"finding\": \"响应者（n=25）的拟杆菌门/厚壁菌门比值显著高于非响应者（n=32），且响应者的细菌物种丰富度（Richness）显著低于非响应者。\"\n          },\n          {\n            \"conditions\": \"波兰黑色素瘤患者队列，基线状态\",\n            \"finding\": \"响应者肠道中普雷沃氏菌（Prevotella copri）和均匀拟杆菌（Bacteroides uniformis）的丰度显著升高；非响应者中普拉梭菌（Faecalibacterium prausnitzii）、肠脱硫弧菌（Desulfovibrio intestinalis）及部分未分类厚壁菌显著富集。\"\n          },\n          {\n            \"conditions\": \"波兰黑色素瘤患者队列，基线饮食调查\",\n            \"finding\": \"高植物性食物（水果和蔬菜总和）摄入与响应概率增加2.9倍相关；低乳制品摄入（每日≤1份）与响应概率增加2.0倍相关。\"\n          },\n          {\n            \"conditions\": \"波兰黑色素瘤患者队列，基线状态\",\n            \"finding\": \"响应者的粪便钙卫蛋白水平（炎症标志物）中位数低于非响应者，但组间差异无统计学意义。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"在波兰人群中，基线肠道微生物组的组成以及饮食等外在因素是否与黑色素瘤患者对抗PD-1治疗的临床反应（响应 vs. 非响应）相关？是否存在人群特异性的微生物标志物？\",\n        \"research_scope\": \"波兰人群中的转移性黑色素瘤患者（接受抗PD-1治疗）及健康对照，聚焦基线肠道微生物组组成、饮食模式与免疫检查点抑制剂（ICI）疗效的关联。\",\n        \"work_summary\": \"本研究旨在探讨波兰裔黑色素瘤患者对抗PD-1治疗的反应与其基线肠道微生物组及外在修饰因素（如饮食）之间的关联。研究招募了64名接受抗PD-1治疗的患者和10名健康对照，通过问卷调查收集人口统计学、生活方式和饮食数据，并在治疗前采集粪便样本进行16S rRNA基因测序（metataxonomics）及部分宏基因组鸟枪法测序。结果显示，响应者（R）与非响应者（NR）在肠道菌群结构上存在显著差异：响应者的拟杆菌门/厚壁菌门（Bacteroidota/Firmicutes）比值较高，物种丰富度较低；响应者肠道中普雷沃氏菌（Prevotella copri）和均匀拟杆菌（Bacteroides uniformis）丰度较高，而非响应者则富集普拉梭菌（Faecalibacterium prausnitzii）、肠脱硫弧菌（Desulfovibrio intestinalis）及部分未分类厚壁菌。此外，高植物摄入和低乳制品摄入与更好的治疗反应相关。该研究强调了肠道微生物组和饮食对ICI疗效的影响具有人群特异性。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于肠道微生物组影响免疫检查点抑制剂（ICI）疗效的人群特异性证据。其核心价值在于揭示了在波兰人群中，特定的微生物组合（P. copri, B. uniformis）和饮食模式（高植物、低乳制品）与治疗响应正相关，这与部分其他队列（如Chaput et al.发现Faecalibacterium有益）的结果形成对比，有助于综述讨论“微生物标志物的人群依赖性”和“饮食-微生物-免疫”交互作用。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅限波兰人群，不能直接外推至其他种族或地理区域；观察性关联，非因果证明。\",\n            \"contribution\": \"提供了波兰人群中与抗PD-1治疗响应正相关的特定微生物类群（P. copri, B. uniformis）和负相关类群（F. prausnitzii, D. intestinalis）的具体数据。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持综述中关于“不同人群中存在不同的微生物预测标志物”的论点，或作为特定菌属在治疗响应中作用的实例。\"\n          },\n          {\n            \"boundaries\": \"基于自我报告问卷，缺乏对具体营养成分或代谢产物的直接测量；混杂因素（如整体生活方式）未完全控制。\",\n            \"contribution\": \"提供了饮食模式（高植物摄入、低乳制品摄入）与ICI治疗响应相关的流行病学证据。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于综述中讨论饮食干预或自然饮食状态如何可能通过调节微生物组来影响免疫治疗效果的背景信息。\"\n          },\n          {\n            \"boundaries\": \"钙卫蛋白差异无统计学意义；未直接测定免疫细胞浸润或细胞因子水平；机制链条不完整。\",\n            \"contribution\": \"探讨了肠道菌群组成与宿主肠道炎症状态（通过粪便钙卫蛋白衡量）的潜在联系，尽管统计上不显著，但趋势显示响应者炎症水平较低。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于讨论肠道局部免疫环境（如炎症水平）可能与全身抗肿瘤免疫反应相关的假设，作为机制探讨的背景素材。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供关于肠道微生物组与ICI疗效关联中“人群特异性”的重要案例。\",\n            \"material\": \"作者指出与其他队列（如中国NSCLC患者中P. copri有益，或某些黑色素瘤队列中Faecalibacterium有益）结果的矛盾，强调单一物种不能作为跨人群的通用生物标志物。\",\n            \"purpose\": \"用于综述中论证微生物标志物开发的复杂性，支持需要结合人群背景、饮食和生活习惯进行个性化分析的结论。\"\n          },\n          {\n            \"connection_to_review\": \"提供饮食与微生物组互作影响免疫治疗的实证数据。\",\n            \"material\": \"研究发现高植物摄入和低乳制品摄入与良好预后相关，并引用文献说明膳食纤维可能通过产生短链脂肪酸（SCFAs）增强T细胞反应。\",\n            \"purpose\": \"用于综述中讨论饮食因素作为调节微生物组进而影响免疫治疗疗效的可干预靶点。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的发现基于波兰特定人群，其微生物组特征受当地饮食和文化影响，结果不能直接推广到其他种族或地区。\",\n          \"对照组年龄显著小于患者组，且样本量小，这可能影响基线微生物组比较的解释力，需谨慎对待与健康对照的比较结果。\",\n          \"饮食数据来自问卷，存在主观性和回忆偏差，且未量化具体营养素摄入量，仅能反映大致饮食模式。\",\n          \"虽然发现了微生物与响应的关联，但未阐明具体的分子机制（如代谢产物、抗原模拟等），因此不能用于解释确切的生物学通路。\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiome composition in melanoma patients\",\n          \"anti-PD-1 therapy response prediction\",\n          \"population-specific microbial signatures\",\n          \"dietary impact on ICI efficacy\",\n          \"Prevotella copri and Bacteroides uniformis abundance\",\n          \"Bacteroidota/Firmicutes ratio\",\n          \"intestinal inflammation (calprotectin)\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0545\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\f31246cd559d1a06b99a32b0ee47bb1ce0265772\\\\a1da9943002238adab3f796903973274\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"kind\": \"identity\",\n            \"reason\": \"source identity was not independently verified\",\n            \"status\": \"input_attributed\"\n          },\n          {\n            \"kind\": \"pdf\",\n            \"reason\": \"full-page text extracted; page positions retained\",\n            \"status\": \"fitz\"\n          },\n          {\n            \"kind\": \"fitz\",\n            \"reason\": \"layout, table relations, formulas, figure pixels, and scanned text may be lost\",\n            \"status\": \"known_gap\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\f31246cd559d1a06b99a32b0ee47bb1ce0265772\\\\a1da9943002238adab3f796903973274\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0478\",\n      \"title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\",\n      \"year\": \"2022\",\n      \"doi\": \"10.1038/s41591-022-01695-5\",\n      \"paper_id\": \"d4c18d58cffce0cab6831c84535e02c608d4db49\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"The study utilized a multi-cohort design combining prospective observational cohorts (PRIMM-UK, PRIMM-NL) and retrospective cohorts (Manchester, Leeds, Barcelona) alongside public datasets. Baseline stool samples were subjected to shotgun metagenomic sequencing. Taxonomic profiling was performed using MetaPhlAn 3.0, and functional potential using HUMAnN 3.0. Statistical associations were tested using PERMANOVA, ANCOM-BC, and various differential abundance methods within a meta-analysis framework. Machine learning prediction capabilities were assessed using Lasso logistic regression with nested cross-validation for within-cohort accuracy and leave-one-cohort-out validation for cross-cohort generalizability.\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"Provides one of the largest integrated metagenomic analyses of ICI response in melanoma, demonstrating that while microbiome-response links exist, they are strongly context-dependent and lack universal single-species biomarkers.\",\n            \"limits\": \"Sample sizes per cohort remain relatively small for robust strain-level resolution. The study focuses on cutaneous melanoma, limiting generalizability to other solid tumors or mucosal/uveal melanoma subtypes. Confounding factors like diet and medication use were adjusted for but residual confounding cannot be fully excluded. The inability to establish universal biomarkers suggests current methodological and biological complexities prevent simple translation to clinical practice without larger, standardized trials.\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"Within individual cohorts (PRIMM-UK vs PRIMM-NL)\",\n            \"finding\": \"Microbiome composition showed significant association with ORR in PRIMM-UK (PERMANOVA P=0.05) but not in PRIMM-NL (P=0.61). Prediction accuracy varied by endpoint and cohort (e.g., AUC-ROC 0.78 for ORR in UK vs 0.53 in NL).\"\n          },\n          {\n            \"conditions\": \"Cross-cohort integration and meta-analysis\",\n            \"finding\": \"Cohort effects explained nearly ten times more variance than clinical variables. No single bacterial species served as a fully consistent biomarker across all datasets. However, a panel of species including Bifidobacterium pseudocatenulatum, Roseburia spp., and Akkermansia muciniphila were consistently enriched in responders.\"\n          },\n          {\n            \"conditions\": \"Machine learning prediction across cohorts\",\n            \"finding\": \"Models trained on one cohort generally failed to predict response in another (AUC-ROC often <0.6). Leave-one-cohort-out validation yielded modest average performance (AUC ~0.59-0.60), indicating limited cross-population reproducibility of microbiome-based signatures.\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"To determine if there are consistent, reproducible gut microbiome biomarkers (taxonomic or functional) associated with response to ICIs in melanoma patients, and to assess the extent of cohort-specific variability that may explain lack of consensus in previous literature.\",\n        \"research_scope\": \"Advanced cutaneous melanoma patients treated with immune checkpoint inhibitors (ICIs); gut microbiome composition and functional potential; multiple observational cohorts across UK, Netherlands, Spain, and public datasets.\",\n        \"work_summary\": \"This study investigates the association between baseline gut microbiome features and clinical response to ICIs in advanced melanoma. By integrating shotgun metagenomic sequencing data from five newly recruited cohorts (n=165) with 147 samples from previously published studies, the authors aimed to reconcile conflicting findings from smaller single-cohort studies. The research employed multivariate statistical analyses, machine learning models (Lasso), and meta-analysis approaches to identify microbial taxa and functions associated with overall response rate (ORR) and progression-free survival at 12 months (PFS12). The work highlights that while the microbiome is relevant to ICI response, these associations are highly cohort-dependent, with limited reproducibility of specific biomarkers or predictive signatures across different populations.\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"This paper serves as a critical counter-narrative to early claims of universal microbiome biomarkers for ICI efficacy. It provides empirical evidence of high inter-cohort heterogeneity and low cross-cohort reproducibility of predictive signatures. For the review, it offers concrete examples of 'negative' or 'null' results regarding universal biomarkers, details specific microbial panels that show partial consistency, and discusses methodological challenges (batch effects, cohort bias) in microbiome-immunotherapy research.\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"These associations are not perfect predictors; no single species is a definitive biomarker. The effect size and consistency vary, and the study emphasizes complexity over simple presence/absence rules.\",\n            \"contribution\": \"Identifies a panel of species (Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila) consistently associated with responders across multiple datasets, providing specific taxonomic candidates for further investigation rather than dismissing the microbiome's role entirely.\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"Can be used to illustrate that while universal biomarkers are elusive, certain beneficial taxa appear repeatedly, suggesting a core set of potentially helpful microbes.\"\n          },\n          {\n            \"boundaries\": \"Performance metrics are specific to this dataset combination; other studies might find better generalization with different preprocessing or larger sample sizes.\",\n            \"contribution\": \"Demonstrates limited cross-cohort reproducibility of machine learning models trained on microbiome data, with AUC-ROC values dropping significantly when applied to external cohorts.\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"Supports arguments about the difficulty of translating microbiome-based diagnostics across diverse populations and highlights the need for large-scale, standardized data collection.\"\n          },\n          {\n            \"boundaries\": \"These are correlative associations based on metagenomic potential; actual functional activity and host interaction mechanisms are not directly measured or proven in this study.\",\n            \"contribution\": \"Discusses functional pathways (e.g., glycosyltransferases, DNA adenine methylases) associated with response, offering mechanistic hypotheses beyond taxonomy.\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"Provides leads for mechanistic exploration (F2) by linking specific KOs to responder status, although causal mechanisms are not established here.\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"Contextualizes the field's transition from discovery of initial biomarkers to understanding their limitations.\",\n            \"material\": \"Discussion of cohort effects explaining variance more than clinical parameters; comparison with colorectal cancer meta-analyses showing stronger consistency.\",\n            \"purpose\": \"To highlight methodological and biological sources of heterogeneity in microbiome-Ici studies, serving as a cautionary example for interpreting positive findings in other papers.\"\n          },\n          {\n            \"connection_to_review\": \"Provides data on clinical covariates (PPIs, antibiotics) and their independent association with microbiome composition.\",\n            \"material\": \"Analysis showing PPI use strongly links to microbiome structure but is independent of ICI response.\",\n            \"purpose\": \"To discuss how common clinical interventions and patient characteristics confound microbiome measurements, necessitating careful adjustment in review synthesis.\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"Findings are specific to advanced cutaneous melanoma; do not generalize to other cancer types or ICI regimens without caution.\",\n          \"The 'lack of universal biomarkers' conclusion is based on the specific cohorts and analytical methods used; it does not prove that no such biomarkers exist, but rather that they are difficult to identify with current data scales.\",\n          \"Associations identified are correlational; causal mechanisms are inferred or hypothesized but not demonstrated.\"\n        ],\n        \"topic_handles\": [\n          \"cross-cohort heterogeneity\",\n          \"reproducibility of microbiome biomarkers\",\n          \"machine learning generalization in microbiome studies\",\n          \"cohort-specific vs universal microbial signatures\",\n          \"methodological confounders (diet, medication, batch effects)\"\n        ]\n      },\n      \"deep_read_material\": {\n        \"_progressive_task_requirements\": {\n          \"knowledge_gaps\": [\n            \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\"\n          ],\n          \"questions\": [\n            {\n              \"gap_key\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n              \"purpose\": \"Supply a concrete, attributed case for the coordinated review.\",\n              \"question\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n              \"question_id\": \"Q01\",\n              \"required_output_ids\": [\n                \"O01\"\n              ]\n            }\n          ],\n          \"required_outputs\": [\n            {\n              \"description\": \"Source-based findings, conditions, methods and limits useful to the review.\",\n              \"output_id\": \"O01\",\n              \"output_type\": \"practical_material\"\n            }\n          ]\n        },\n        \"_progressive_task_signature\": \"b52d0f73a30cd0a1\",\n        \"current_question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为接受ICI治疗的晚期皮肤黑色素瘤患者；终点指标为客观缓解率（ORR）和12个月无进展生存期（PFS12）；分析方法包括PERMANOVA、Lasso机器学习模型（100次重复五折分层交叉验证）、以及包含8种差异丰度方法的随机效应荟萃分析；比较对象包括PRIMM-UK、PRIMM-NL、Manchester、Leeds、Barcelona队列及4个公开数据集（Matson et al., Gopalakrishnan et al., Frankel et al., WindTT_2020等）。\",\n                \"finding\": \"在整合5个新测序队列（n=165）和4个公开队列（n=147）后，PERMANOVA分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量（包括临床参数）的近十倍。机器学习模型验证显示，基于物种丰度的预测能力在不同队列间缺乏可重复性：仅在PRIMM-NL中PFS12预测AUC-ROC为0.64，在PRIMM-UK中ORR预测AUC-ROC为0.78；而在跨队列测试中，仅约31.4%的情况AUC-ROC超过0.6，且留一法交叉验证的平均AUC-ROC仅为0.59-0.60。尽管通过荟萃分析识别出与反应者相关的物种面板（如Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila），但没有任何单一细菌在所有数据集中成为完全一致的生物标志物。相比之下，结直肠癌数据的相同方法显示出强且一致的生物标志物，证明该结果并非由分析方法导致。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供跨队列黑色素瘤免疫检查点抑制剂（ICI）治疗反应研究中‘无通用标志物’的具体统计证据及异质性来源分析，作为直接材料。\"\n              },\n              {\n                \"attribution\": \"Routy et al. (2018)\",\n                \"conditions\": \"针对上皮肿瘤患者的PD-1免疫疗法反应研究；使用宏基因组测序分析粪便样本。\",\n                \"finding\": \"发现ICI反应者中Akermansia muciniphila、Alistipes属和厚壁菌门（Firmicutes）的相对丰度显著高于非反应者。\",\n                \"reference_ids\": [\n                  \"R11\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示早期单队列研究中发现的特定菌种关联，用于对比说明当前研究中观察到的不一致性和缺乏共识的现象。\"\n              },\n              {\n                \"attribution\": \"Gopalakrishnan et al. (2018)\",\n                \"conditions\": \"针对黑色素瘤患者抗PD-1免疫疗法反应的研究；使用宏基因组测序分析肠道微生物组。\",\n                \"finding\": \"发现ICI反应者中Faecalibacterium prausnitzii的相对丰度高于非反应者。\",\n                \"reference_ids\": [\n                  \"R6\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示另一项早期独立研究发现的不同菌种关联，进一步佐证不同研究间结果的差异性。\"\n              },\n              {\n                \"attribution\": \"Matson et al. (2018)\",\n                \"conditions\": \"针对转移性黑色素瘤患者抗PD-1疗法反应的研究；关注共生微生物组。\",\n                \"finding\": \"发现PD-1治疗的反应性由一组八个物种的增加定义，主要由Bifidobacterium longum驱动。\",\n                \"reference_ids\": [\n                  \"R5\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示第三项独立研究发现的菌种组合关联，强调人类环境中缺乏统一共识的现状。\"\n              },\n              {\n                \"attribution\": \"Frankel et al. (2017)\",\n                \"conditions\": \"针对黑色素瘤患者的宏基因组鸟枪法和代谢组学分析；关注不同ICI方案下的微生物组和代谢物。\",\n                \"finding\": \"报告微生物组因ICI治疗方案而异，但在接受任何ICI方案的反应者中，Bacteroides caccae的富集是常见的。\",\n                \"reference_ids\": [\n                  \"R12\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示微生物组差异可能取决于ICI治疗方案，并指出某些菌种（如Bacteroides caccae）在不同方案中普遍富集，但同样未形成跨研究的通用标志物。\"\n              }\n            ],\n            \"explanation\": \"跨队列黑色素瘤研究中‘无通用标志物’的统计依据主要源于巨大的队列间异质性。首先，PERMANOVA分析证实“队列”本身是解释微生物群落组成变异的最大因素，其影响远超临床或人口统计学变量。其次，机器学习模型的跨队列泛化能力极差，内部验证表现尚可但外部验证（跨队列测试）的AUC-ROC值普遍较低且波动大，表明基于特定队列训练的微生物特征无法可靠地预测其他队列的反应。最后，尽管荟萃分析能识别出一些在多个队列中趋势一致的物种（如Roseburia spp.、Akkermansia muciniphila），但没有任何单一物种在所有数据集中达到统计学显著性并成为普适性生物标志物。这种不一致性被归因于人群特异性特征、样本处理和分析的方法学选择、饮食和药物使用的差异，以及微生物信号的功能相关性与队列内在特性。作者通过结直肠癌数据的对照分析排除了方法学缺陷的可能性，确认了黑色素瘤ICI反应中微生物关联的复杂性和队列依赖性。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"具体哪些临床协变量（如PPI使用、既往治疗）在多大程度上介导了队列间的微生物差异及其对ICI反应的混淆作用，虽有提及但未深入量化其交互机制。\",\n              \"菌株水平的特异性如何具体影响跨队列的一致性，文中提到需要数千人的样本量来解析菌株多样性，但未提供具体的菌株水平跨队列分析数据。\"\n            ]\n          }\n        ],\n        \"fulfilled\": false,\n        \"paper_identity\": {\n          \"canonical_paper_id\": \"d4c18d58cffce0cab6831c84535e02c608d4db49\",\n          \"doi\": \"10.1038/s41591-022-01695-5\",\n          \"title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\"\n        },\n        \"paper_title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\",\n        \"plain_text\": \"\",\n        \"prior_question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为接受ICI治疗的晚期皮肤黑色素瘤患者；终点指标为客观缓解率（ORR）和12个月无进展生存期（PFS12）；分析方法包括PERMANOVA、Lasso机器学习模型（100次重复五折分层交叉验证）、以及包含8种差异丰度方法的随机效应荟萃分析；比较对象包括PRIMM-UK、PRIMM-NL、Manchester、Leeds、Barcelona队列及4个公开数据集（Matson et al., Gopalakrishnan et al., Frankel et al., WindTT_2020等）。\",\n                \"finding\": \"在整合5个新测序队列（n=165）和4个公开队列（n=147）后，PERMANOVA分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量（包括临床参数）的近十倍。机器学习模型验证显示，基于物种丰度的预测能力在不同队列间缺乏可重复性：仅在PRIMM-NL中PFS12预测AUC-ROC为0.64，在PRIMM-UK中ORR预测AUC-ROC为0.78；而在跨队列测试中，仅约31.4%的情况AUC-ROC超过0.6，且留一法交叉验证的平均AUC-ROC仅为0.59-0.60。尽管通过荟萃分析识别出与反应者相关的物种面板（如Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila），但没有任何单一细菌在所有数据集中成为完全一致的生物标志物。相比之下，结直肠癌数据的相同方法显示出强且一致的生物标志物，证明该结果并非由分析方法导致。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供跨队列黑色素瘤免疫检查点抑制剂（ICI）治疗反应研究中‘无通用标志物’的具体统计证据及异质性来源分析，作为直接材料。\"\n              },\n              {\n                \"attribution\": \"Routy et al. (2018)\",\n                \"conditions\": \"针对上皮肿瘤患者的PD-1免疫疗法反应研究；使用宏基因组测序分析粪便样本。\",\n                \"finding\": \"发现ICI反应者中Akermansia muciniphila、Alistipes属和厚壁菌门（Firmicutes）的相对丰度显著高于非反应者。\",\n                \"reference_ids\": [\n                  \"R11\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示早期单队列研究中发现的特定菌种关联，用于对比说明当前研究中观察到的不一致性和缺乏共识的现象。\"\n              },\n              {\n                \"attribution\": \"Gopalakrishnan et al. (2018)\",\n                \"conditions\": \"针对黑色素瘤患者抗PD-1免疫疗法反应的研究；使用宏基因组测序分析肠道微生物组。\",\n                \"finding\": \"发现ICI反应者中Faecalibacterium prausnitzii的相对丰度高于非反应者。\",\n                \"reference_ids\": [\n                  \"R6\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示另一项早期独立研究发现的不同菌种关联，进一步佐证不同研究间结果的差异性。\"\n              },\n              {\n                \"attribution\": \"Matson et al. (2018)\",\n                \"conditions\": \"针对转移性黑色素瘤患者抗PD-1疗法反应的研究；关注共生微生物组。\",\n                \"finding\": \"发现PD-1治疗的反应性由一组八个物种的增加定义，主要由Bifidobacterium longum驱动。\",\n                \"reference_ids\": [\n                  \"R5\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示第三项独立研究发现的菌种组合关联，强调人类环境中缺乏统一共识的现状。\"\n              },\n              {\n                \"attribution\": \"Frankel et al. (2017)\",\n                \"conditions\": \"针对黑色素瘤患者的宏基因组鸟枪法和代谢组学分析；关注不同ICI方案下的微生物组和代谢物。\",\n                \"finding\": \"报告微生物组因ICI治疗方案而异，但在接受任何ICI方案的反应者中，Bacteroides caccae的富集是常见的。\",\n                \"reference_ids\": [\n                  \"R12\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示微生物组差异可能取决于ICI治疗方案，并指出某些菌种（如Bacteroides caccae）在不同方案中普遍富集，但同样未形成跨研究的通用标志物。\"\n              }\n            ],\n            \"explanation\": \"跨队列黑色素瘤研究中‘无通用标志物’的统计依据主要源于巨大的队列间异质性。首先，PERMANOVA分析证实“队列”本身是解释微生物群落组成变异的最大因素，其影响远超临床或人口统计学变量。其次，机器学习模型的跨队列泛化能力极差，内部验证表现尚可但外部验证（跨队列测试）的AUC-ROC值普遍较低且波动大，表明基于特定队列训练的微生物特征无法可靠地预测其他队列的反应。最后，尽管荟萃分析能识别出一些在多个队列中趋势一致的物种（如Roseburia spp.、Akkermansia muciniphila），但没有任何单一物种在所有数据集中达到统计学显著性并成为普适性生物标志物。这种不一致性被归因于人群特异性特征、样本处理和分析的方法学选择、饮食和药物使用的差异，以及微生物信号的功能相关性与队列内在特性。作者通过结直肠癌数据的对照分析排除了方法学缺陷的可能性，确认了黑色素瘤ICI反应中微生物关联的复杂性和队列依赖性。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"具体哪些临床协变量（如PPI使用、既往治疗）在多大程度上介导了队列间的微生物差异及其对ICI反应的混淆作用，虽有提及但未深入量化其交互机制。\",\n              \"菌株水平的特异性如何具体影响跨队列的一致性，文中提到需要数千人的样本量来解析菌株多样性，但未提供具体的菌株水平跨队列分析数据。\"\n            ]\n          }\n        ],\n        \"question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为接受ICI治疗的晚期皮肤黑色素瘤患者；终点指标为客观缓解率（ORR）和12个月无进展生存期（PFS12）；分析方法包括PERMANOVA、Lasso机器学习模型（100次重复五折分层交叉验证）、以及包含8种差异丰度方法的随机效应荟萃分析；比较对象包括PRIMM-UK、PRIMM-NL、Manchester、Leeds、Barcelona队列及4个公开数据集（Matson et al., Gopalakrishnan et al., Frankel et al., WindTT_2020等）。\",\n                \"finding\": \"在整合5个新测序队列（n=165）和4个公开队列（n=147）后，PERMANOVA分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量（包括临床参数）的近十倍。机器学习模型验证显示，基于物种丰度的预测能力在不同队列间缺乏可重复性：仅在PRIMM-NL中PFS12预测AUC-ROC为0.64，在PRIMM-UK中ORR预测AUC-ROC为0.78；而在跨队列测试中，仅约31.4%的情况AUC-ROC超过0.6，且留一法交叉验证的平均AUC-ROC仅为0.59-0.60。尽管通过荟萃分析识别出与反应者相关的物种面板（如Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila），但没有任何单一细菌在所有数据集中成为完全一致的生物标志物。相比之下，结直肠癌数据的相同方法显示出强且一致的生物标志物，证明该结果并非由分析方法导致。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供跨队列黑色素瘤免疫检查点抑制剂（ICI）治疗反应研究中‘无通用标志物’的具体统计证据及异质性来源分析，作为直接材料。\"\n              },\n              {\n                \"attribution\": \"Routy et al. (2018)\",\n                \"conditions\": \"针对上皮肿瘤患者的PD-1免疫疗法反应研究；使用宏基因组测序分析粪便样本。\",\n                \"finding\": \"发现ICI反应者中Akermansia muciniphila、Alistipes属和厚壁菌门（Firmicutes）的相对丰度显著高于非反应者。\",\n                \"reference_ids\": [\n                  \"R11\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示早期单队列研究中发现的特定菌种关联，用于对比说明当前研究中观察到的不一致性和缺乏共识的现象。\"\n              },\n              {\n                \"attribution\": \"Gopalakrishnan et al. (2018)\",\n                \"conditions\": \"针对黑色素瘤患者抗PD-1免疫疗法反应的研究；使用宏基因组测序分析肠道微生物组。\",\n                \"finding\": \"发现ICI反应者中Faecalibacterium prausnitzii的相对丰度高于非反应者。\",\n                \"reference_ids\": [\n                  \"R6\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示另一项早期独立研究发现的不同菌种关联，进一步佐证不同研究间结果的差异性。\"\n              },\n              {\n                \"attribution\": \"Matson et al. (2018)\",\n                \"conditions\": \"针对转移性黑色素瘤患者抗PD-1疗法反应的研究；关注共生微生物组。\",\n                \"finding\": \"发现PD-1治疗的反应性由一组八个物种的增加定义，主要由Bifidobacterium longum驱动。\",\n                \"reference_ids\": [\n                  \"R5\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示第三项独立研究发现的菌种组合关联，强调人类环境中缺乏统一共识的现状。\"\n              },\n              {\n                \"attribution\": \"Frankel et al. (2017)\",\n                \"conditions\": \"针对黑色素瘤患者的宏基因组鸟枪法和代谢组学分析；关注不同ICI方案下的微生物组和代谢物。\",\n                \"finding\": \"报告微生物组因ICI治疗方案而异，但在接受任何ICI方案的反应者中，Bacteroides caccae的富集是常见的。\",\n                \"reference_ids\": [\n                  \"R12\"\n                ],\n                \"use_in_review\": \"作为背景研究，展示微生物组差异可能取决于ICI治疗方案，并指出某些菌种（如Bacteroides caccae）在不同方案中普遍富集，但同样未形成跨研究的通用标志物。\"\n              }\n            ],\n            \"explanation\": \"跨队列黑色素瘤研究中‘无通用标志物’的统计依据主要源于巨大的队列间异质性。首先，PERMANOVA分析证实“队列”本身是解释微生物群落组成变异的最大因素，其影响远超临床或人口统计学变量。其次，机器学习模型的跨队列泛化能力极差，内部验证表现尚可但外部验证（跨队列测试）的AUC-ROC值普遍较低且波动大，表明基于特定队列训练的微生物特征无法可靠地预测其他队列的反应。最后，尽管荟萃分析能识别出一些在多个队列中趋势一致的物种（如Roseburia spp.、Akkermansia muciniphila），但没有任何单一物种在所有数据集中达到统计学显著性并成为普适性生物标志物。这种不一致性被归因于人群特异性特征、样本处理和分析的方法学选择、饮食和药物使用的差异，以及微生物信号的功能相关性与队列内在特性。作者通过结直肠癌数据的对照分析排除了方法学缺陷的可能性，确认了黑色素瘤ICI反应中微生物关联的复杂性和队列依赖性。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"具体哪些临床协变量（如PPI使用、既往治疗）在多大程度上介导了队列间的微生物差异及其对ICI反应的混淆作用，虽有提及但未深入量化其交互机制。\",\n              \"菌株水平的特异性如何具体影响跨队列的一致性，文中提到需要数千人的样本量来解析菌株多样性，但未提供具体的菌株水平跨队列分析数据。\"\n            ]\n          }\n        ],\n        \"questions\": [\n          {\n            \"gap_key\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n            \"purpose\": \"Supply a concrete, attributed case for the coordinated review.\",\n            \"question\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n            \"question_id\": \"Q01\",\n            \"required_output_ids\": [\n              \"O01\"\n            ]\n          }\n        ],\n        \"reading_mode\": \"focused_local_search\",\n        \"required_outputs\": [\n          {\n            \"description\": \"Source-based findings, conditions, methods and limits useful to the review.\",\n            \"output_id\": \"O01\",\n            \"output_type\": \"practical_material\"\n          }\n        ],\n        \"source_hash\": \"4cdf58a599e11ca7b93baf2c267e1b30189b0393a89b9875f38140bd7574ba3f\",\n        \"task_hash\": \"a71dcc1b5ddfee261ccada9c9f7edbb5042e134009909bfd315f039f5f5b5be8\"\n      },\n      \"deep_read_material_trimmed\": {\n        \"dropped_keys\": {\n          \"material_ready\": 4,\n          \"paper_id\": 42,\n          \"references\": 992,\n          \"review_id\": 23,\n          \"schema_version\": 46,\n          \"status\": 9,\n          \"task_id\": 34,\n          \"workflow\": 21\n        },\n        \"dropped_chars\": 1171,\n        \"note\": \"深读材料里的记账字段与论文自带的参考文献表已省略；科学内容（问句材料/发现/条件）保留。需要时可用 locator 读原文。\"\n      },\n      \"tool_supplement_materials\": [\n        {\n          \"allowed_use\": [],\n          \"conditions\": [],\n          \"decision\": \"stop\",\n          \"intended_use\": \"\",\n          \"limits\": [],\n          \"need_id\": \"N6202b6492ea8-fb99a64ac28c133a\",\n          \"question\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n          \"sources\": [\n            {\n              \"doi\": \"10.1038/s41591-022-01695-5\",\n              \"paper_id\": \"d4c18d58cffce0cab6831c84535e02c608d4db49\",\n              \"source_handle\": \"P0478\",\n              \"title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\",\n              \"year\": \"2022\"\n            }\n          ],\n          \"still_missing\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n          \"usable_content\": \"{\\\"question_material\\\": [{\\\"examples\\\": [{\\\"attribution\\\": \\\"本研究\\\", \\\"conditions\\\": \\\"研究对象为接受ICI治疗的晚期皮肤黑色素瘤患者；终点指标为客观缓解率（ORR）和12个月无进展生存期（PFS12）；分析方法包括PERMANOVA、Lasso机器学习模型（100次重复五折分层交叉验证）、以及包含8种差异丰度方法的随机效应荟萃分析；比较对象包括PRIMM-UK、PRIMM-NL、Manchester、Leeds、Barcelona队列及4个公开数据集（Matson et al., Gopalakrishnan et al., Frankel et al., WindTT_2020等）。\\\", \\\"finding\\\": \\\"在整合5个新测序队列（n=165）和4个公开队列（n=147）后，PERMANOVA分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量（包括临床参数）的近十倍。机器学习模型验证显示，基于物种丰度的预测能力在不同队列间缺乏可重复性：仅在PRIMM-NL中PFS12预测AUC-ROC为0.64，在PRIMM-UK中ORR预测AUC-ROC为0.78；而在跨队列测试中，仅约31.4%的情况AUC-ROC超过0.6，且留一法交叉验证的平均AUC-ROC仅为0.59-0.60。尽管通过荟萃分析识别出与反应者相关的物种面板（如Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila），但没有任何单一细菌在所有数据集中成为完全一致的生物标志物。相比之下，结直肠癌数据的相同方法显示出强且一致的生物标志物，证明该结果并非由分析方法导致。\\\", \\\"reference_ids\\\": [], \\\"use_in_review\\\": \\\"提供跨队列黑色素瘤免疫检查点抑制剂（ICI）治疗反应研究中‘无通用标志物’的具体统计证据及异质性来源分析，作为直接材料。\\\"}, {\\\"attribution\\\": \\\"Routy et al. (2018)\\\", \\\"conditions\\\": \\\"针对上皮肿瘤患者的PD-1免疫疗法反应研究；使用宏基因组测序分析粪便样本。\\\", \\\"finding\\\": \\\"发现ICI反应者中Akermansia muciniphila、Alistipes属和厚壁菌门（Firmicutes）的相对丰度显著高于非反应者。\\\", \\\"reference_ids\\\": [\\\"R11\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示早期单队列研究中发现的特定菌种关联，用于对比说明当前研究中观察到的不一致性和缺乏共识的现象。\\\"}, {\\\"attribution\\\": \\\"Gopalakrishnan et al. (2018)\\\", \\\"conditions\\\": \\\"针对黑色素瘤患者抗PD-1免疫疗法反应的研究；使用宏基因组测序分析肠道微生物组。\\\", \\\"finding\\\": \\\"发现ICI反应者中Faecalibacterium prausnitzii的相对丰度高于非反应者。\\\", \\\"reference_ids\\\": [\\\"R6\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示另一项早期独立研究发现的不同菌种关联，进一步佐证不同研究间结果的差异性。\\\"}, {\\\"attribution\\\": \\\"Matson et al. (2018)\\\", \\\"conditions\\\": \\\"针对转移性黑色素瘤患者抗PD-1疗法反应的研究；关注共生微生物组。\\\", \\\"finding\\\": \\\"发现PD-1治疗的反应性由一组八个物种的增加定义，主要由Bifidobacterium longum驱动。\\\", \\\"reference_ids\\\": [\\\"R5\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示第三项独立研究发现的菌种组合关联，强调人类环境中缺乏统一共识的现状。\\\"}, {\\\"attribution\\\": \\\"Frankel et al. (2017)\\\", \\\"conditions\\\": \\\"针对黑色素瘤患者的宏基因组鸟枪法和代谢组学分析；关注不同ICI方案下的微生物组和代谢物。\\\", \\\"finding\\\": \\\"报告微生物组因ICI治疗方案而异，但在接受任何ICI方案的反应者中，Bacteroides caccae的富集是常见的。\\\", \\\"reference_ids\\\": [\\\"R12\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示微生物组差异可能取决于ICI治疗方案，并指出某些菌种（如Bacteroides caccae）在不同方案中普遍富集，但同样未形成跨研究的通用标志物。\\\"}], \\\"explanation\\\": \\\"跨队列黑色素瘤研究中‘无通用标志物’的统计依据主要源于巨大的队列间异质性。首先，PERMANOVA分析证实“队列”本身是解释微生物群落组成变异的最大因素，其影响远超临床或人口统计学变量。其次，机器学习模型的跨队列泛化能力极差，内部验证表现尚可但外部验证（跨队列测试）的AUC-ROC值普遍较低且波动大，表明基于特定队列训练的微生物特征无法可靠地预测其他队列的反应。最后，尽管荟萃分析能识别出一些在多个队列中趋势一致的物种（如Roseburia spp.、Akkermansia muciniphila），但没有任何单一物种在所有数据集中达到统计学显著性并成为普适性生物标志物。这种不一致性被归因于人群特异性特征、样本处理和分析的方法学选择、饮食和药物使用的差异，以及微生物信号的功能相关性与队列内在特性。作者通过结直肠癌数据的对照分析排除了方法学缺陷的可能性，确认了黑色素瘤ICI反应中微生物关联的复杂性和队列依赖性。\\\", \\\"question_id\\\": \\\"Q01\\\", \\\"remaining_points\\\": [\\\"具体哪些临床协变量（如PPI使用、既往治疗）在多大程度上介导了队列间的微生物差异及其对ICI反应的混淆作用，虽有提及但未深入量化其交互机制。\\\", \\\"菌株水平的特异性如何具体影响跨队列的一致性，文中提到需要数千人的样本量来解析菌株多样性，但未提供具体的菌株水平跨队列分析数据。\\\"]}], \\\"plain_text\\\": \\\"\\\"}\"\n        },\n        {\n          \"allowed_use\": [],\n          \"conditions\": [],\n          \"decision\": \"stop\",\n          \"intended_use\": \"\",\n          \"limits\": [],\n          \"need_id\": \"N6202b6492ea8-fb99a64ac28c133a\",\n          \"question\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n          \"sources\": [\n            {\n              \"doi\": \"10.1038/s41591-022-01695-5\",\n              \"paper_id\": \"d4c18d58cffce0cab6831c84535e02c608d4db49\",\n              \"source_handle\": \"P0478\",\n              \"title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\",\n              \"year\": \"2022\"\n            }\n          ],\n          \"still_missing\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n          \"usable_content\": \"{\\\"question_material\\\": [{\\\"question_id\\\": \\\"Q01\\\", \\\"examples\\\": [{\\\"attribution\\\": \\\"本研究\\\", \\\"use_in_review\\\": \\\"提供跨队列黑色素瘤免疫检查点抑制剂（ICI）治疗反应研究中‘无通用标志物’的具体统计证据及异质性来源分析，作为直接材料。\\\", \\\"finding\\\": \\\"在整合5个新测序队列（n=165）和4个公开队列（n=147）后，PERMANOVA分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量（包括临床参数）的近十倍。机器学习模型验证显示，基于物种丰度的预测能力在不同队列间缺乏可重复性：仅在PRIMM-NL中PFS12预测AUC-ROC为0.64，在PRIMM-UK中ORR预测AUC-ROC为0.78；而在跨队列测试中，仅约31.4%的情况AUC-ROC超过0.6，且留一法交叉验证的平均AUC-ROC仅为0.59-0.60。尽管通过荟萃分析识别出与反应者相关的物种面板（如Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila），但没有任何单一细菌在所有数据集中成为完全一致的生物标志物。相比之下，结直肠癌数据的相同方法显示出强且一致的生物标志物，证明该结果并非由分析方法导致。\\\", \\\"conditions\\\": \\\"研究对象为接受ICI治疗的晚期皮肤黑色素瘤患者；终点指标为客观缓解率（ORR）和12个月无进展生存期（PFS12）；分析方法包括PERMANOVA、Lasso机器学习模型（100次重复五折分层交叉验证）、以及包含8种差异丰度方法的随机效应荟萃分析；比较对象包括PRIMM-UK、PRIMM-NL、Manchester、Leeds、Barcelona队列及4个公开数据集（Matson et al., Gopalakrishnan et al., Frankel et al., WindTT_2020等）。\\\", \\\"reference_ids\\\": []}, {\\\"attribution\\\": \\\"Routy et al. (2018)\\\", \\\"use_in_review\\\": \\\"作为背景研究，展示早期单队列研究中发现的特定菌种关联，用于对比说明当前研究中观察到的不一致性和缺乏共识的现象。\\\", \\\"finding\\\": \\\"发现ICI反应者中Akermansia muciniphila、Alistipes属和厚壁菌门（Firmicutes）的相对丰度显著高于非反应者。\\\", \\\"conditions\\\": \\\"针对上皮肿瘤患者的PD-1免疫疗法反应研究；使用宏基因组测序分析粪便样本。\\\", \\\"reference_ids\\\": [\\\"R11\\\"]}, {\\\"attribution\\\": \\\"Gopalakrishnan et al. (2018)\\\", \\\"use_in_review\\\": \\\"作为背景研究，展示另一项早期独立研究发现的不同菌种关联，进一步佐证不同研究间结果的差异性。\\\", \\\"finding\\\": \\\"发现ICI反应者中Faecalibacterium prausnitzii的相对丰度高于非反应者。\\\", \\\"conditions\\\": \\\"针对黑色素瘤患者抗PD-1免疫疗法反应的研究；使用宏基因组测序分析肠道微生物组。\\\", \\\"reference_ids\\\": [\\\"R6\\\"]}, {\\\"attribution\\\": \\\"Matson et al. (2018)\\\", \\\"use_in_review\\\": \\\"作为背景研究，展示第三项独立研究发现的菌种组合关联，强调人类环境中缺乏统一共识的现状。\\\", \\\"finding\\\": \\\"发现PD-1治疗的反应性由一组八个物种的增加定义，主要由Bifidobacterium longum驱动。\\\", \\\"conditions\\\": \\\"针对转移性黑色素瘤患者抗PD-1疗法反应的研究；关注共生微生物组。\\\", \\\"reference_ids\\\": [\\\"R5\\\"]}, {\\\"attribution\\\": \\\"Frankel et al. (2017)\\\", \\\"use_in_review\\\": \\\"作为背景研究，展示微生物组差异可能取决于ICI治疗方案，并指出某些菌种（如Bacteroides caccae）在不同方案中普遍富集，但同样未形成跨研究的通用标志物。\\\", \\\"finding\\\": \\\"报告微生物组因ICI治疗方案而异，但在接受任何ICI方案的反应者中，Bacteroides caccae的富集是常见的。\\\", \\\"conditions\\\": \\\"针对黑色素瘤患者的宏基因组鸟枪法和代谢组学分析；关注不同ICI方案下的微生物组和代谢物。\\\", \\\"reference_ids\\\": [\\\"R12\\\"]}], \\\"explanation\\\": \\\"跨队列黑色素瘤研究中‘无通用标志物’的统计依据主要源于巨大的队列间异质性。首先，PERMANOVA分析证实“队列”本身是解释微生物群落组成变异的最大因素，其影响远超临床或人口统计学变量。其次，机器学习模型的跨队列泛化能力极差，内部验证表现尚可但外部验证（跨队列测试）的AUC-ROC值普遍较低且波动大，表明基于特定队列训练的微生物特征无法可靠地预测其他队列的反应。最后，尽管荟萃分析能识别出一些在多个队列中趋势一致的物种（如Roseburia spp.、Akkermansia muciniphila），但没有任何单一物种在所有数据集中达到统计学显著性并成为普适性生物标志物。这种不一致性被归因于人群特异性特征、样本处理和分析的方法学选择、饮食和药物使用的差异，以及微生物信号的功能相关性与队列内在特性。作者通过结直肠癌数据的对照分析排除了方法学缺陷的可能性，确认了黑色素瘤ICI反应中微生物关联的复杂性和队列依赖性。\\\", \\\"remaining_points\\\": [\\\"具体哪些临床协变量（如PPI使用、既往治疗）在多大程度上介导了队列间的微生物差异及其对ICI反应的混淆作用，虽有提及但未深入量化其交互机制。\\\", \\\"菌株水平的特异性如何具体影响跨队列的一致性，文中提到需要数千人的样本量来解析菌株多样性，但未提供具体的菌株水平跨队列分析数据。\\\"]}], \\\"plain_text\\\": \\\"\\\"}\"\n        },\n        {\n          \"allowed_use\": [],\n          \"conditions\": [],\n          \"decision\": \"stop\",\n          \"intended_use\": \"\",\n          \"limits\": [],\n          \"need_id\": \"N6202b6492ea8-fb99a64ac28c133a\",\n          \"question\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n          \"sources\": [\n            {\n              \"doi\": \"10.1038/s41591-022-01695-5\",\n              \"material_depth\": \"\",\n              \"paper_id\": \"d4c18d58cffce0cab6831c84535e02c608d4db49\",\n              \"reading_role\": \"\",\n              \"section_path\": [],\n              \"source_handle\": \"P0478\",\n              \"title\": \"Cross-cohort gut microbiome associations with immune checkpoint inhibitor response in advanced melanoma\",\n              \"year\": \"2022\"\n            }\n          ],\n          \"still_missing\": \"跨队列黑色素瘤研究，需详细提取其关于‘无通用标志物’的具体统计依据及队列间异质性来源分析。\",\n          \"usable_content\": \"{\\\"question_material\\\": [{\\\"examples\\\": [{\\\"attribution\\\": \\\"本研究\\\", \\\"conditions\\\": \\\"研究对象为接受ICI治疗的晚期皮肤黑色素瘤患者；终点指标为客观缓解率（ORR）和12个月无进展生存期（PFS12）；分析方法包括PERMANOVA、Lasso机器学习模型（100次重复五折分层交叉验证）、以及包含8种差异丰度方法的随机效应荟萃分析；比较对象包括PRIMM-UK、PRIMM-NL、Manchester、Leeds、Barcelona队列及4个公开数据集（Matson et al., Gopalakrishnan et al., Frankel et al., WindTT_2020等）。\\\", \\\"finding\\\": \\\"在整合5个新测序队列（n=165）和4个公开队列（n=147）后，PERMANOVA分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量（包括临床参数）的近十倍。机器学习模型验证显示，基于物种丰度的预测能力在不同队列间缺乏可重复性：仅在PRIMM-NL中PFS12预测AUC-ROC为0.64，在PRIMM-UK中ORR预测AUC-ROC为0.78；而在跨队列测试中，仅约31.4%的情况AUC-ROC超过0.6，且留一法交叉验证的平均AUC-ROC仅为0.59-0.60。尽管通过荟萃分析识别出与反应者相关的物种面板（如Bifidobacterium pseudocatenulatum, Roseburia spp., Akkermansia muciniphila），但没有任何单一细菌在所有数据集中成为完全一致的生物标志物。相比之下，结直肠癌数据的相同方法显示出强且一致的生物标志物，证明该结果并非由分析方法导致。\\\", \\\"reference_ids\\\": [], \\\"use_in_review\\\": \\\"提供跨队列黑色素瘤免疫检查点抑制剂（ICI）治疗反应研究中‘无通用标志物’的具体统计证据及异质性来源分析，作为直接材料。\\\"}, {\\\"attribution\\\": \\\"Routy et al. (2018)\\\", \\\"conditions\\\": \\\"针对上皮肿瘤患者的PD-1免疫疗法反应研究；使用宏基因组测序分析粪便样本。\\\", \\\"finding\\\": \\\"发现ICI反应者中Akermansia muciniphila、Alistipes属和厚壁菌门（Firmicutes）的相对丰度显著高于非反应者。\\\", \\\"reference_ids\\\": [\\\"R11\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示早期单队列研究中发现的特定菌种关联，用于对比说明当前研究中观察到的不一致性和缺乏共识的现象。\\\"}, {\\\"attribution\\\": \\\"Gopalakrishnan et al. (2018)\\\", \\\"conditions\\\": \\\"针对黑色素瘤患者抗PD-1免疫疗法反应的研究；使用宏基因组测序分析肠道微生物组。\\\", \\\"finding\\\": \\\"发现ICI反应者中Faecalibacterium prausnitzii的相对丰度高于非反应者。\\\", \\\"reference_ids\\\": [\\\"R6\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示另一项早期独立研究发现的不同菌种关联，进一步佐证不同研究间结果的差异性。\\\"}, {\\\"attribution\\\": \\\"Matson et al. (2018)\\\", \\\"conditions\\\": \\\"针对转移性黑色素瘤患者抗PD-1疗法反应的研究；关注共生微生物组。\\\", \\\"finding\\\": \\\"发现PD-1治疗的反应性由一组八个物种的增加定义，主要由Bifidobacterium longum驱动。\\\", \\\"reference_ids\\\": [\\\"R5\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示第三项独立研究发现的菌种组合关联，强调人类环境中缺乏统一共识的现状。\\\"}, {\\\"attribution\\\": \\\"Frankel et al. (2017)\\\", \\\"conditions\\\": \\\"针对黑色素瘤患者的宏基因组鸟枪法和代谢组学分析；关注不同ICI方案下的微生物组和代谢物。\\\", \\\"finding\\\": \\\"报告微生物组因ICI治疗方案而异，但在接受任何ICI方案的反应者中，Bacteroides caccae的富集是常见的。\\\", \\\"reference_ids\\\": [\\\"R12\\\"], \\\"use_in_review\\\": \\\"作为背景研究，展示微生物组差异可能取决于ICI治疗方案，并指出某些菌种（如Bacteroides caccae）在不同方案中普遍富集，但同样未形成跨研究的通用标志物。\\\"}], \\\"explanation\\\": \\\"跨队列黑色素瘤研究中‘无通用标志物’的统计依据主要源于巨大的队列间异质性。首先，PERMANOVA分析证实“队列”本身是解释微生物群落组成变异的最大因素，其影响远超临床或人口统计学变量。其次，机器学习模型的跨队列泛化能力极差，内部验证表现尚可但外部验证（跨队列测试）的AUC-ROC值普遍较低且波动大，表明基于特定队列训练的微生物特征无法可靠地预测其他队列的反应。最后，尽管荟萃分析能识别出一些在多个队列中趋势一致的物种（如Roseburia spp.、Akkermansia muciniphila），但没有任何单一物种在所有数据集中达到统计学显著性并成为普适性生物标志物。这种不一致性被归因于人群特异性特征、样本处理和分析的方法学选择、饮食和药物使用的差异，以及微生物信号的功能相关性与队列内在特性。作者通过结直肠癌数据的对照分析排除了方法学缺陷的可能性，确认了黑色素瘤ICI反应中微生物关联的复杂性和队列依赖性。\\\", \\\"question_id\\\": \\\"Q01\\\", \\\"remaining_points\\\": [\\\"具体哪些临床协变量（如PPI使用、既往治疗）在多大程度上介导了队列间的微生物差异及其对ICI反应的混淆作用，虽有提及但未深入量化其交互机制。\\\", \\\"菌株水平的特异性如何具体影响跨队列的一致性，文中提到需要数千人的样本量来解析菌株多样性，但未提供具体的菌株水平跨队列分析数据。\\\"]}], \\\"plain_text\\\": \\\"\\\"}\"\n        }\n      ],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0478\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\d4c18d58cffce0cab6831c84535e02c608d4db49\\\\bdf750fa3e2ab9b7ac325b8826bd0308\\\\attempt-02\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\d4c18d58cffce0cab6831c84535e02c608d4db49\\\\bdf750fa3e2ab9b7ac325b8826bd0308\\\\attempt-02\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0170\",\n      \"title\": \"Enterotype-specific microbial biomarkers of immune checkpoint inhibitor response revealed by large-scale integrated metagenomic analysis\",\n      \"year\": \"2026\",\n      \"doi\": \"10.1007/s00262-026-04432-w\",\n      \"paper_id\": \"4a1e10851c0bf838d11646a65bc0ee57b10b940a\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"1. **数据整合**：从NCBI SRA下载9个研究的宏基因组数据，筛选仅包含响应者（CR/PR）和非响应者（PD/D）的样本，排除稳定疾病患者，最终纳入569个样本。 2. **预处理与分类**：使用Kraken2和Bracken进行物种水平丰度估计；使用QIIME2进行Alpha/Beta多样性分析。 3. **肠型聚类**：基于Bray-Curtis距离矩阵，使用PAM算法将样本聚类为两个主要肠型（E1, E2）及四个亚群（E1.1, E1.2, E2.1, E2.2）。 4. **标志物识别**：在每个肠型及整体数据集中使用LEfSe分析寻找区分R和NR的差异物种。 5. **独立验证**：在独立的MOC队列（n=19，仅含卓越响应者）中，计算样本所属肠型及差异物种丰度与发现数据集响应者分布的一致性（Bootstrap置信评分）。 6. **机器学习预测**：测试7种机器学习算法（包括集成学习）在物种和属水平上区分R/NR的性能，并在MOC队列中进行外部测试。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提出了基于肠型分层来识别ICI反应生物标志物的概念验证框架，揭示了不同肠型中响应标志物的异质性（如*Collinsella*在E2，*Bacteroides*在E1）。\",\n            \"limits\": \"数据集存在严重的肿瘤类型混杂（E2几乎全为MM），导致肠型间的反应率差异无法独立于肿瘤类型进行因果推断。\"\n          },\n          {\n            \"contribution\": \"通过独立队列（MOC）初步验证了部分标志物（如*Blautia A*）在不同人群中的信号一致性。\",\n            \"limits\": \"MOC队列仅包含卓越响应者，缺乏非响应者对照，无法评估模型的鉴别诊断能力或预测性能，仅能证明信号的存在而非预测效力。\"\n          },\n          {\n            \"contribution\": \"展示了机器学习在捕捉复杂微生物模式方面的潜力，特别是在同质化亚组中。\",\n            \"limits\": \"整体预测性能中等（AUC/Accuracy ~0.64），且受限于回顾性数据的批次效应和技术异质性，尚不具备直接临床应用价值。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"整体数据集（WD, n=569）\",\n            \"finding\": \"未发现响应者与未响应者在Alpha多样性上的显著差异；Beta多样性显示两组重叠但存在统计学差异（PERMANOVA p=0.043）。聚类得到E1（主要包含MM和NSCLC）和E2（高度富集MM，无RCC）。\"\n          },\n          {\n            \"conditions\": \"肠型特异性分析\",\n            \"finding\": \"E1主要由拟杆菌科驱动，E2由毛螺菌科、肠杆菌科等驱动。E2.1亚群的反应率显著低于E2.2（31.9% vs 56.7%），但该结果受肿瘤类型分布不均（E2主要为MM）的限制，不能独立解释为肠型效应。\"\n          },\n          {\n            \"conditions\": \"生物标志物识别\",\n            \"finding\": \"共鉴定出166种肠型特异性响应生物标志物。*Collinsella*属在E2.1中为主要阳性标志物；*Bacteroides*属主要在E1中作为标志物；*Blautia A*属在多个肠型中均显示出稳健的响应关联。\"\n          },\n          {\n            \"conditions\": \"独立队列一致性评估 (MOC, n=19)\",\n            \"finding\": \"在仅有卓越响应者的MOC队列中，*Blautia A*、*Collinsella*和部分*Bacteroides*物种显示出与发现数据集中的响应者分布一致的模式。由于缺乏非响应者对照，这仅作为探索性一致性证据，而非预测验证。\"\n          },\n          {\n            \"conditions\": \"机器学习预测\",\n            \"finding\": \"在整体测试集上，集成模型最高准确率为0.640。在仅包含完全响应者（CR）的子集或MOC队列中，准确率提升至0.80-0.95，表明模型能捕捉强治疗获益的信号，但在异质性人群中区分能力有限。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"尽管有证据表明肠道微生物群调节抗肿瘤免疫反应，但不同研究中识别出的微生物生物标志物缺乏共识和一致性。本研究旨在解决这一挑战，探究是否通过基于肠型的分层可以减少生物学噪声，从而识别出在特定微生物背景下与免疫治疗反应相关的特异性生物标志物，并评估其预测潜力。\",\n        \"research_scope\": \"本研究针对接受免疫检查点抑制剂（ICI）治疗的实体瘤患者，整合了来自9个公共数据库研究的569份粪便宏基因组样本。研究对象涵盖恶性黑色素瘤（MM）、非小细胞肺癌（NSCLC）和肾细胞癌（RCC）。研究情境为多中心、多队列的回顾性数据整合分析，旨在解决不同研究中微生物标志物不一致的问题。\",\n        \"work_summary\": \"该研究提出肠道菌群并非均匀分布，而是组织为不同的“肠型”（enterotypes），假设这种分层可以揭示对免疫治疗反应的特定微生物标志物。作者首先通过PAM算法将569个样本聚类为两个主要肠型（E1和E2）及其亚群。随后，利用LEfSe分析识别各肠型中响应者（R）与非响应者（NR）的特异性物种标志物，共发现166种特异性物种。为了初步验证这些标志物的稳健性，作者在意大利Modena癌症中心的一个包含19名具有卓越且持久反应患者的独立队列（MOC）中进行了探索性一致性评估。此外，研究还应用多种机器学习算法构建分类模型，以评估基于微生物组特征预测治疗反应的潜力。结果显示，虽然整体预测性能中等，但在特定亚组和独立队列中表现出一定的一致性，支持了基于肠型进行患者分层的探索性框架。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于“如何通过微生物群落结构分层（肠型）来解决免疫治疗生物标志物不一致性”的重要实证素材。它具体展示了在异质性实体瘤队列中，响应相关的微生物信号并非普适，而是依赖于特定的群落背景（肠型）。这对于解释为何单一物种标志物在不同研究中表现不一提供了机制层面的解释（即上下文依赖性），并为综述中讨论“微生物组分层策略”和“标志物的情境特异性”提供了具体的案例和数据支持。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"该结论基于回顾性整合数据，且E2肠型严重偏向黑色素瘤，因此不能直接外推至所有肿瘤类型或独立于肿瘤类型的纯微生物效应。\",\n            \"contribution\": \"提供了具体的实证数据，表明肠道微生物群对ICI疗效的调节作用具有肠型特异性。例如，*Collinsella*丰度增加与E2肠型（富含肠杆菌科）中的响应相关，而*Bacteroides*则在E1肠型中与响应相关。这帮助解释为什么某些物种在某些研究中是标志物，而在其他研究中不是——因为它们的作用可能依赖于整个群落的环境。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于论证微生物标志物的识别需要考虑群落背景（context），支持综述中关于‘标志物异质性’部分的讨论。可用于举例说明不同肠型中优势菌群如何塑造不同的免疫微环境。\"\n          },\n          {\n            \"boundaries\": \"这些机制描述主要基于文献综述和作者的推测，本研究本身并未进行功能实验或动物模型验证来确证这些因果关系。\",\n            \"contribution\": \"讨论了潜在机制联系，如*Collinsella aerofaciens*产生的pH响应脂质免疫原可激活TLR2通路，以及*Bacteroides*物种产生短链脂肪酸（SCFAs）和调节胆汁酸代谢的能力。同时指出*Escherichia coli*（在E2.1中丰富）可能通过LPS促进炎症和屏障破坏，从而抑制免疫治疗反应。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"为综述中“介导机制”部分提供具体的分子和代谢途径示例，特别是关于有益菌（如*Collinsella*, *Bacteroides*）与有害/促炎菌（如*Enterobacteriaceae*）之间的平衡如何影响ICI疗效。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"当综述讨论“如何标准化微生物组数据以进行跨研究比较”或“生物信息学流程对结果的影响”时，可作为具体案例引用。\",\n            \"material\": \"论文描述了从SRA下载数据、统一使用Kraken2/Bracken流程、以及使用PAM聚类和LEfSe分析的方法论。\",\n            \"purpose\": \"作为方法学参考，展示如何处理多中心宏基因组数据的异质性和批次效应。\"\n          },\n          {\n            \"connection_to_review\": \"用于支持综述中关于“当前AI模型在临床转化中的挑战”的论点，强调需要更严格的验证设计和考虑患者异质性。\",\n            \"material\": \"研究显示在异质性全数据集中预测性能中等（0.64），但在同质化亚组（CR患者）中性能提升。\",\n            \"purpose\": \"提供关于机器学习在微生物组预测中局限性的反面教材或边界条件。\"\n          },\n          {\n            \"connection_to_review\": \"用于批评现有研究中常见的验证偏差，强调未来研究需要包含平衡的响应/非响应队列以评估真正的鉴别能力。\",\n            \"material\": \"MOC队列仅包含卓越响应者，缺乏非响应者对照，导致无法进行真正的预测验证。\",\n            \"purpose\": \"提供关于独立验证队列设计局限性的警示。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"E2肠型及其亚群几乎全部由黑色素瘤患者组成，因此观察到的反应率差异可能是肿瘤类型、微生物群落和队列效应的混合结果，不能简单归因于肠型本身。\",\n          \"独立验证队列（MOC）仅包含卓越响应者，没有非响应者，因此所谓的“一致性”仅表示这些标志物在卓越响应者中存在，并不代表它们能区分响应者和非响应者。\",\n          \"机器学习的高准确率仅在高度选择性的子集（如仅CR患者）中获得，不代表其在真实世界异质性人群中的通用预测能力。\"\n        ],\n        \"topic_handles\": [\n          \"Enterotype stratification (E1/E2)\",\n          \"Context-dependent biomarkers (Collinsella in E2, Bacteroides in E1)\",\n          \"Multi-cohort integration heterogeneity\",\n          \"Machine learning prediction limits in heterogeneous cohorts\",\n          \"Exploratory concordance assessment without non-responder controls\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0170\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\4a1e10851c0bf838d11646a65bc0ee57b10b940a\\\\81f8436015b28b46bd5042e05e013d7a\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\4a1e10851c0bf838d11646a65bc0ee57b10b940a\\\\81f8436015b28b46bd5042e05e013d7a\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0289\",\n      \"title\": \"Microbiome Landscape and Association with Response to Immune Checkpoint Inhibitors in Advanced Solid Tumors: A SCRUM-Japan MONSTAR-SCREEN Study\",\n      \"year\": \"2025\",\n      \"doi\": \"10.1158/2767-9764.crc-24-0543\",\n      \"paper_id\": \"7fe882e8b39d1a041fd2fee47d9321c965f01aa5\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用观察性队列研究设计。Cohort 1（n=817）为一线全身治疗前的化疗初治患者，用于分析微生物组基线分布及其与临床特征（癌症类型、生活方式、合并用药）的关系；Cohort 2（n=333）为接受ICI治疗的患者，用于评估微生物组特征与ICI疗效（PFS、OS）的关联。样本采集后通过16S rRNA扩增子测序进行微生物组分析，定义“口腔细菌”为基于Atarashi等人研究的24个OTUs对应的10个菌属。统计分析包括α/β多样性比较、ALDEx2差异丰度分析、Kaplan-Meier生存分析及Cox比例风险模型，并使用倾向性评分匹配调整混杂因素。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了跨多种晚期实体瘤类型的微生物组基线图谱，证实了上消化道肿瘤和PPI使用与粪便中口腔细菌富集的关联。\",\n            \"limits\": \"所给摘要未交代具体的多变量模型构建细节及所有协变量的平衡情况；仅使用16S rRNA测序，无法提供物种水平的精确功能注释或菌株水平变异；ICI治疗队列样本量相对较小且包含多种治疗线和联合方案，可能引入异质性。\"\n          },\n          {\n            \"contribution\": \"挑战了“高α多样性总是预测良好ICI疗效”的普遍观点，指出其预测价值可能依赖于癌症类型和治疗背景。\",\n            \"limits\": \"α多样性的亚组分析多为探索性，统计效力不足，不能确立因果机制。\"\n          },\n          {\n            \"contribution\": \"提出了PPI通过增加粪便口腔细菌从而削弱ICI疗效的潜在机制假设，并为临床干预（如口腔护理）提供了依据。\",\n            \"limits\": \"观察性研究设计无法确证因果关系；公共数据集验证样本量小且仅部分OTU可比，结果仅为支持性而非决定性证据。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"化疗初治晚期实体瘤患者 (n=817)\",\n            \"finding\": \"上消化道肿瘤（特别是胃/胰腺癌术后）及PPI使用者粪便中口腔细菌比例显著高于其他人群；抗生素和益生菌使用降低α多样性并改变菌群组成。\"\n          },\n          {\n            \"conditions\": \"接受ICI治疗的晚期实体瘤患者 (n=333)\",\n            \"finding\": \"整体肠道微生物组α多样性（ASV计数、Shannon指数）与ICI疗效无显著关联（HR=0.94, 95% CI 0.73–1.21）；仅Simpson指数与较好疗效相关。\"\n          },\n          {\n            \"conditions\": \"接受ICI治疗的晚期实体瘤患者 (n=333)\",\n            \"finding\": \"粪便中高比例口腔细菌与较短的PFS显著相关（中位4.34 vs 6.97个月; HR=1.38, 95% CI 1.07–1.78）。\"\n          },\n          {\n            \"conditions\": \"接受ICI治疗且使用PPI的患者\",\n            \"finding\": \"高口腔细菌比例在PPI使用者中与更差的PFS趋势相关（中位3.15 vs 2.04个月; P=0.08），而在非PPI使用者中无此关联（P=0.74），提示PPI与口腔细菌存在交互作用。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"尽管已知肠道微生物组影响癌症发展和ICI疗效，但其在不同癌症类型中的普遍性作用尚不明确，且伴随药物（如PPI）如何通过改变微生物组进而影响ICI疗效的机制缺乏跨癌种的系统性证据。\",\n        \"research_scope\": \"日本全国范围内晚期实体瘤患者（SCRUM-Japan MONSTAR-SCREEN项目），重点分析化疗未治疗队列（n=817）的微生物组基线特征，以及接受免疫检查点抑制剂（ICI）治疗队列（n=333）的疗效关联。涵盖多种癌症类型，特别关注上消化道肿瘤与质子泵抑制剂（PPI）使用的影响。\",\n        \"work_summary\": \"本研究利用大规模全国性筛查项目的数据，旨在阐明晚期实体瘤患者肠道微生物组的景观及其对ICI疗效的影响。研究首先分析了化疗前患者的微生物组特征，发现上消化道肿瘤（尤其是术后胃癌和胰腺癌）及PPI使用者粪便中口腔细菌比例显著升高。随后，在ICI治疗队列中，研究发现整体α多样性（ASV计数、Shannon指数）与ICI疗效无显著关联，这与部分既往单一癌种研究的结论不同。然而，粪便中高比例的口腔细菌与较短的无进展生存期（PFS）显著相关。进一步分析显示，这种负面影响在同时使用PPI的患者中更为明显，提示PPI诱导的口腔细菌易位可能是降低ICI疗效的重要机制之一。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文提供了关于肠道微生物组如何受癌症类型和合并用药（特别是PPI）影响的跨癌种实证数据，并指出了粪便中口腔细菌作为ICI疗效负面预测因子的潜力。对于综述而言，其核心价值在于解构了“微生物组-ICI疗效”关系的复杂性，特别是揭示了常规药物（PPI）通过改变微生物组成分（口腔细菌易位）干扰免疫治疗的具体情境，这有助于解释为何不同研究中微生物组标志物的表现不一致。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"该结果基于观察性队列，且亚组分析统计效力有限；不能直接外推至所有治疗场景（如联合免疫疗法）。\",\n            \"contribution\": \"提供了跨多种实体瘤类型的微生物组基线数据，显示α多样性（ASV/Shannon）与ICI疗效的整体关联不显著，仅在特定癌种（食管、尿路上皮、肾细胞癌）或特定治疗模式（单药vs联合化疗）下呈现异质性。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"可用于综述中讨论“微生物组作为通用生物标志物的局限性”，或解释为何不同研究间关于α多样性与ICI疗效的关系存在矛盾。\"\n          },\n          {\n            \"boundaries\": \"口腔细菌的定义基于特定参考集；关联性强但因果机制需进一步验证；主要适用于接受ICI治疗的晚期实体瘤患者。\",\n            \"contribution\": \"识别出粪便中高比例口腔细菌与ICI治疗后较短PFS的显著关联，特别是在PPI使用者中这一关联更强。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"可作为“特定微生物特征（口腔细菌）负向调节ICI疗效”的证据，支持综述中关于微生物组组成而非单纯多样性影响疗效的观点。\"\n          },\n          {\n            \"boundaries\": \"机制假说基于相关性分析和文献引用，缺乏直接的分子机制实验验证；需区分PPI的直接药理作用与间接微生物组效应。\",\n            \"contribution\": \"提出了PPI使用导致胃酸抑制，进而促进口腔细菌在粪便中富集，并可能由此削弱ICI疗效的机制路径。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于综述中阐述“合并用药通过微生物组介导影响ICI疗效”的具体机制案例，特别是PPI的作用途径。\"\n          },\n          {\n            \"boundaries\": \"对照组为其他实体瘤患者而非健康人，限制了与健康基线的直接比较；手术影响的结论仅限于胃/胰腺癌术后患者。\",\n            \"contribution\": \"展示了不同癌症类型（如上消化道肿瘤vs结直肠癌）中微生物组特征的差异，以及手术（胃/胰腺切除术）对口腔细菌富集的额外影响。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于说明“癌症类型和解剖位置”是微生物组-宿主互作的重要分层因素，解释为何某些癌种中观察到特定的微生物变化。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"帮助综述建立“临床实践因素（用药/生活方式）如何塑造患者基线微生物组”的背景知识，为理解后续疗效分析的混杂因素提供依据。\",\n            \"material\": \"Cohort 1中关于PPI、抗生素、益生菌使用率及其对α/β多样性影响的描述性统计和差异分析结果。\",\n            \"purpose\": \"提供晚期实体瘤患者基线微生物组特征的流行病学数据，特别是PPI和抗生素使用的普遍性及其对菌群的影响。\"\n          },\n          {\n            \"connection_to_review\": \"为综述中讨论不同微生物组研究的方法学异质性及结果可比性提供具体案例，特别是关于OTU/ASV定义和多样性指标选择的讨论。\",\n            \"material\": \"材料与方法中关于DNA提取、16S V3-V4区域测序、QIIME2处理、ALDEx2分析及口腔细菌定义的详细描述。\",\n            \"purpose\": \"展示16S rRNA测序在大型临床队列中的应用局限性和优势，以及数据处理流程。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的“口腔细菌”定义为基于Saliva微生物组数据的24个OTUs对应的10个菌属，并非所有粪便中的口腔来源细菌，解读时需限定范围。\",\n          \"α多样性与ICI疗效无整体关联的发现可能与既往研究冲突，需谨慎归因于癌症类型异质性或治疗背景差异，而非否定多样性本身的价值。\",\n          \"PPI与口腔细菌的交互作用分析中，PPI使用者的亚组样本量较小，P值接近显著性阈值（0.08），应视为提示性发现而非确证性证据。\",\n          \"公共数据集验证仅使用了7个可比的OTUs，样本量小且统计效力低，结果仅为方向性支持，不能作为独立证据链。\"\n        ],\n        \"topic_handles\": [\n          \"immune checkpoint inhibitors efficacy modulation\",\n          \"gut microbiome landscape across cancer types\",\n          \"proton pump inhibitors (PPI) impact on microbiome\",\n          \"oral bacteria translocation to gut\",\n          \"alpha diversity as ICI biomarker variability\",\n          \"fecal microbiome sampling in advanced solid tumors\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0289\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\7fe882e8b39d1a041fd2fee47d9321c965f01aa5\\\\1fd7534431edf9e5132a17934fe40bec\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\7fe882e8b39d1a041fd2fee47d9321c965f01aa5\\\\1fd7534431edf9e5132a17934fe40bec\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0364\",\n      \"title\": \"Functional convergence amid taxonomic variability in gut microbiome–immune checkpoint inhibitor research: a bibliometric and mechanistic synthesis\",\n      \"year\": \"2026\",\n      \"doi\": \"10.3389/fimmu.2026.1883259\",\n      \"paper_id\": \"9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用混合方法：首先进行文献计量学映射，包括关键词共现网络、引用共现分析、主题演化分析和战略主题图，以描绘科学产出、智力结构和主题演变；其次，检索ClinicalTrials.gov评估干预性临床试验的活动；最后，进行定性的跨队列功能综合，选取具有明确响应者/非响应者定义的代表性临床研究（Level 4）和临床前研究（Level 2），比较其微生物特征、代谢通路和免疫机制，构建概念框架。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了将文献计量学结构与跨队列功能解释相结合的综合视角，解释了分类学不一致背后的功能趋同可能性，并为基于功能的生物标志物开发提供了理论依据。\",\n            \"limits\": \"所给摘要未交代具体的统计检验细节；定性综合依赖于单作者筛选，可能存在选择偏差；未能提供合并效应量；依赖单一数据库（WoSCC）和英语文献，可能存在语言和数据库偏差；因果推断仍受限于观察性研究和混杂因素。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"2013-2025年文献计量学与临床试验数据\",\n            \"finding\": \"研究产出呈指数增长，2018年标志性人类队列研究后出现转化激增，临床试验启动在2021年达到峰值。主题从早期的机制探索和特定药物关注转向以FMT、微生物代谢物和多组学为核心的临床干预导向。\"\n          },\n          {\n            \"conditions\": \"跨队列代表性临床及临床前研究（n=8）\",\n            \"finding\": \"响应者相关的微生物群表现出支持代谢和免疫有利的特征，如短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏；而非响应者则显示失调和免疫抑制特征。尽管具体菌种不同，但免疫通路呈现功能趋同。\"\n          },\n          {\n            \"conditions\": \"概念框架综合\",\n            \"finding\": \"提出了一个统一框架，将宿主因素、微生物组成、代谢物信号和免疫反应联系起来，表明微生物-ICI相互作用由功能趋同通路驱动，而非单一菌种。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"针对微生物群-ICI研究中分类学发现缺乏可重复性且结果不一致的问题，探讨这种不一致是否源于底层的功能趋同机制，并梳理该领域的研究演变、转化趋势及当前面临的挑战。\",\n        \"research_scope\": \"肠道微生物群与免疫检查点抑制剂（ICIs）在实体瘤治疗中的相互作用研究，时间跨度为2013年至2025年。\",\n        \"work_summary\": \"该综述旨在解决肠道微生物群与ICI疗效关联研究中存在的分类学不一致性问题。作者通过整合Web of Science核心合集的文献计量学分析（2,195篇文献）和ClinicalTrials.gov的临床试验数据，结合对代表性临床及临床前研究的定性跨队列功能综合，探讨了微生物-ICI相互作用是否在共享免疫通路层面存在功能趋同。研究发现，尽管不同队列中响应相关的细菌物种差异显著，但功能上均指向短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏等免疫调节通路。文章提出，分类学的变异可能反映了功能冗余而非生物学矛盾，并建议向基于功能的生物标志物和干预策略转变。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于微生物群-ICI领域从分类学描述向功能机制和临床干预转型的关键背景证据。它特别适用于解释为何不同研究中微生物标志物不一致，并提出“功能趋同”作为整合这些不一致发现的理论框架。此外，它提供了该领域临床试验活动的时间线数据和主要干预策略（如FMT）的现状，有助于评估该领域的成熟度和转化瓶颈。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅基于定性综合，未提供定量效应估计；主要涵盖黑色素瘤、NSCLC等实体瘤，但未详细区分所有亚型的具体差异。\",\n            \"contribution\": \"提供了微生物群影响ICI疗效的临床证据图谱，指出响应者相关菌群虽物种各异，但均富集于免疫调节共生菌。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物群如何调节实体瘤中ICI的疗效”，特别是解释不同研究中微生物标志物不一致的现象，支持微生物群作为疗效调节因子的观点。\"\n          },\n          {\n            \"boundaries\": \"机制解释主要基于文献回顾和概念框架，部分机制（如inosine的作用）主要来自临床前模型，其在人体中的确切贡献尚需更多验证；因果关系受限于观察性研究的混杂因素。\",\n            \"contribution\": \"详细阐述了微生物-ICI相互作用的潜在机制，包括短链脂肪酸产生、树突状细胞成熟、Th1极化和CD8+ T细胞激活等通路。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于回答“哪些机制介导了这种效应”，提供具体的分子和细胞机制路径，支持微生物代谢物和免疫细胞互作在ICI疗效中的核心作用。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供领域发展脉络和转化现状的背景信息。\",\n            \"material\": \"文献计量学显示的主题演变（从机制到干预）、临床试验活动的时间线（2018-2021激增）、主要干预策略（FMT为主，益生菌为辅）。\",\n            \"purpose\": \"用于综述的背景部分，展示该领域从基础关联研究向临床转化研究的快速过渡，以及当前面临的标准化和监管挑战。\"\n          },\n          {\n            \"connection_to_review\": \"提供关于因果推断局限性和混杂因素的讨论素材。\",\n            \"material\": \"文章讨论了抗生素、PPI、皮质类固醇、饮食、肿瘤类型等混杂因素对微生物群和ICI疗效的影响，以及反向因果的可能性。\",\n            \"purpose\": \"用于综述的方法学或讨论部分，强调在解读微生物群-ICI关联时需要考虑的复杂背景和因果推断的挑战。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该论文的“功能趋同”结论是基于定性综合提出的假设生成性模型，并非经过严格统计验证的普适规律，需谨慎引用。\",\n          \"引用的机制证据多来自临床前模型或早期临床队列，其在广泛人群中的适用性和因果效力尚未完全确立。\",\n          \"文献计量学反映的是学术关注度，不完全等同于临床疗效或生物学真实性。\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiome\",\n          \"immune checkpoint inhibitors (ICIs)\",\n          \"functional convergence\",\n          \"taxonomic variability\",\n          \"short-chain fatty acids (SCFAs)\",\n          \"dendritic cell activation\",\n          \"CD8+ T-cell priming\",\n          \"fecal microbiota transplantation (FMT)\",\n          \"biomarker discovery\",\n          \"tumor microenvironment\"\n        ]\n      },\n      \"local_passages\": {\n        \"external_calls\": 0,\n        \"passages\": [\n          {\n            \"best_sentence\": \"ency, and link thickness represents co-occurrence strength.Earlieremerging terms are predominantly associated with specific immune checkpoint inhibitor (ICI) agents (e.g., ipilimumab, pembrolizumab), treatment modifiers (e.g., antibiotics, proton pump inhibitors), and outcome-oriented concepts (e.g., overall survival, progression-free survival).More recent terms cluster around microbiome modulation strategies (e.g., fecal microbiota transplantation, microbial metabolites) and advanced profiling techniques (e.g., metagenomics, metabolomics), illustrating the temporal evolution of research priorities within the gut microbiome-immune checkpoint inhibitor field from foundational outcome studies toward targeted interventions.\",\n            \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\\\\087ed47cfe6952f4d934d87e8dd43399\\\\attempt-01\\\\PAPER_READING_CARD.json\",\n            \"doi\": \"10.3389/fimmu.2026.1883259\",\n            \"limits\": [],\n            \"match_terms\": [\n              \"微生物组\",\n              \"抗生素\",\n              \"质子泵抑制剂\",\n              \"gut microbiome modulate efficacy immune checkpoint inhibitors solid tumours\",\n              \"ici\"\n            ],\n            \"material_depth\": \"fulltext\",\n            \"paper_id\": \"9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\",\n            \"pool_action\": \"already_in_pool\",\n            \"reading_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\materials\\\\9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\\\\snapshot-eb0632c06695c138d8c4eef1\",\n            \"score\": 49.151244,\n            \"section_path\": [\n              \"FIGURE 3\"\n            ],\n            \"segment_kind\": \"document_block\",\n            \"source_handle\": \"P0364\",\n            \"text\": \"2023.5).Node size reflects keyword frequency, and link thickness represents co-occurrence strength.Earlieremerging terms are predominantly associated with speci ency, and link thickness represents co-occurrence strength.Earlieremerging terms are predominantly associated with specific immune checkpoint inhibitor (ICI) agents (e.g., ipilimumab, pembrolizumab), treatment modifiers (e.g., antibiotics, proton pump inhibitors), and outcome-oriented concepts (e.g., overall survival, progression-free survival).More recent terms cluster around microbiome modulation strategies (e.g., fecal microbiota transplantation, microbial metabolites) and advanced profiling techniques (e.g., metagenomics, metabolomics), illustrating the temporal evolution of research priorities within the gut microbiome-immune checkpoint inhibitor field from foundational outcome studies toward targeted interventions. (11) and Gopalakrishnan et al.\",\n            \"title\": \"Functional convergence amid taxonomic variability in gut microbiome–immune checkpoint inhibitor research: a bibliometric and mechanistic synthesis\",\n            \"usable_fields\": [],\n            \"year\": \"2026\"\n          }\n        ],\n        \"question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect? 外部因素对微生物 - 免疫轴的干扰 评估抗生素、PPIs、饮食等外部因素如何通过改变微生物组进而影响 ICI 疗效，特别是时间窗口和药物类别的特异性。 涵盖抗生素、质子泵抑制剂、其他合并用药（阿片类、类固醇、二甲双胍等）、饮食模式、生活方式（睡眠、节律）对 ICI 疗效的观察性关联证据及潜在机制。明确区分观察性关联与因果推断，标注肿瘤类型特异性及混杂因素限制。\",\n        \"reading_mode\": \"focused_local_search\"\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0364\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\\\\087ed47cfe6952f4d934d87e8dd43399\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-403bce67afb0fdb07c1f\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-8c71e871c7aa5482d545\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-f85da31c482f020fe5f7\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\\\\087ed47cfe6952f4d934d87e8dd43399\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0437\",\n      \"title\": \"Gene-level gut microbiome signatures as predictive biomarkers for response to immune checkpoint inhibitors across multiple cancer types\",\n      \"year\": \"2026\",\n      \"doi\": \"10.1080/19490976.2026.2662690\",\n      \"paper_id\": \"bfb5efeaf486304583ce74567d60f84cf138a0ae\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"研究设计采用多队列回顾性数据分析路线。首先，对来自四个独立研究的347个粪便样本进行宏基因组测序数据的预处理（质控、去宿主DNA）。其次，构建自定义参考基因组集：从Ashray_2024队列中提取contigs，生成两类参考集——用于提取生物先验知识的“Top 1”最长contig集（1269个）和用于计算基因丰度的“Top 200”最长contig集（161,107个）。接着，使用CoverM计算每个样本相对于自定义参考集的RPKM基因水平丰度矩阵；同时使用ESM-2模型将“Top 1”contigs的蛋白序列编码为320维嵌入向量作为生物先验知识。最后，构建变分自编码器（VAE）架构的BioP-VAE模型，通过注意力机制融合生物先验知识与RPKM特征，进行ICI反应和二分类预测。评估指标包括AUC、AUPR和准确率，并使用集成梯度（IG）方法进行特征归因分析。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提出了BioP-VAE模型，证明基因水平微生物丰度结合生物先验知识在预测ICI反应方面优于传统的分类学特征，特别是在CICB治疗背景下具有跨癌种泛化潜力。\",\n            \"limits\": \"所给摘要未交代具体的统计检验细节（如多重比较校正）。跨队列泛化能力受限于治疗策略（CICB vs 单药）和队列间的异质性，模型在单药治疗间的泛化效果不佳。未包含真菌、病毒等非细菌微生物组数据，也未整合宿主多维生物学信息（如肿瘤突变负荷、免疫微环境）。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"Ashray_2024队列（CICB治疗，罕见实体瘤）内部验证\",\n            \"finding\": \"整合生物先验知识的过滤后RPKM特征在预测ICI反应中表现最佳，平均AUC为0.89，准确率为92.68%，显著优于所有层级的分类学丰度特征（最高AUC 0.72）。\"\n          },\n          {\n            \"conditions\": \"跨队列评估（训练集与测试集分离）\",\n            \"finding\": \"在CICB治疗背景下，模型展现出一定的跨队列泛化能力（Ashray_2024训练，Frankel_2017 CICB子集测试，AUC=0.88）。但在单药治疗队列（Lee_2022, Matson_2018）之间或向单药子集的泛化能力较差（AUC < 0.60-0.64）。\"\n          },\n          {\n            \"conditions\": \"单药治疗队列内部验证\",\n            \"finding\": \"在抗PD-1/CTLA-4单药治疗的内部队列中，BioP-VAE实现了极高的预测性能，平均AUC达到0.97。\"\n          },\n          {\n            \"conditions\": \"12个月无进展生存期（PFS）预测\",\n            \"finding\": \"在Ashray_2024队列中，整合生物先验知识的RPKM特征预测12个月PFS的AUC为0.88，优于仅使用临床因素或传统分类学特征。\"\n          },\n          {\n            \"conditions\": \"年龄分层分析（>60岁 vs ≤60岁）\",\n            \"finding\": \"年轻患者的预测性能略高于老年患者（AUC 0.91 vs 0.87）。归因分析显示不同年龄组的贡献微生物存在差异：老年响应者中Bifidobacterium属贡献为正，而年轻响应者中UBA11524等未培养属贡献显著；非响应者中两组的特征分布也截然不同。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"现有的基于参考基因组数据库的分类学丰度方法限制了未表征微生物的发现和功能解释，且缺乏跨队列和癌症类型的高分辨率、可泛化的预测生物标志物。如何构建更有效的预测模型以区分ICI治疗响应者与非响应者？\",\n        \"research_scope\": \"研究对象为接受免疫检查点抑制剂（ICI）治疗的实体瘤患者，涵盖黑色素瘤及多种罕见实体瘤。情境包括不同地理区域、不同治疗策略（联合免疫检查点阻断 CICB 与单药治疗）以及不同年龄层（>60岁与≤60岁）。范围聚焦于利用粪便宏基因组数据预测治疗反应和12个月无进展生存期（PFS）。\",\n        \"work_summary\": \"本研究旨在解决现有ICI疗效预测生物标志物依赖分类学丰度、难以捕捉未表征微生物功能异质性的问题。作者整合了四个公开可用的粪便宏基因组队列（Ashray_2024, Lee_2022, Matson_2018, Frankel_2017），开发了一种名为BioP-VAE的深度学习模型。该模型以基因水平微生物丰度（RPKM特征）为输入，并引入基于蛋白质序列嵌入的生物先验知识。研究比较了基因水平特征与传统分类学特征在预测ICI反应及12个月PFS中的性能，并通过特征归因分析和年龄分层分析揭示了关键微生物基因及其潜在的生物学机制。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文提供了关于肠道微生物组预测ICI疗效的高分辨率证据，重点在于‘基因水平’而非‘物种水平’的特征优势。它直接回应了综述中关于微生物组如何调节ICI疗效的问题，特别是通过提供具体的微生物基因通路（如nitrilase）和特定菌群（如Ruminococcaceae, Desulfovibrionaceae）的贡献证据。此外，其关于治疗策略（CICB vs 单药）和年龄分层对微生物信号影响的发现，为理解效应的情境依赖性提供了重要素材。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"结果主要基于Ashray_2024（罕见实体瘤+CICB）和黑色素瘤队列。跨队列泛化仅在CICB背景下成立，单药背景下的泛化性差，因此不能推广为通用的单一微生物标志物。\",\n            \"contribution\": \"提供了基因水平微生物丰度作为预测生物标志物的实证数据，证明其在CICB治疗下优于分类学特征。具体识别出在响应者中富集的Rikenellaceae, Ruminococcaceae, Lachnospiraceae家族，以及在非响应者中富集的Desulfovibrionaceae, Bacteroidaceae家族。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"可用于支持‘特定微生物类群与ICI疗效正/负相关’的论点，特别是强调功能基因层面比分类学层面更具预测力。\"\n          },\n          {\n            \"boundaries\": \"这些是相关性分析（特征归因后的富集），并非因果实验验证。机制解释依赖于作者的理论推导，需注明为假设性关联。\",\n            \"contribution\": \"通过KEGG和GO富集分析揭示了潜在机制：响应者中富集的nitrilase基因参与氮代谢和T细胞调节；非响应者中富集的lipoic acid metabolism可能通过调节氧化应激影响免疫。年龄分层显示老年响应者与Bifidobacterium相关，年轻响应者与UBA11524等相关。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于解释微生物组调节ICI疗效的潜在生化机制（如氮代谢、氧化应激）以及宿主年龄对微生物-免疫互作的影响。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"方法论参考\",\n            \"material\": \"BioP-VAE模型架构，整合蛋白序列嵌入（ESM-2）与宏基因组RPKM特征，使用集成梯度进行可解释性分析。\",\n            \"purpose\": \"作为机器学习在微生物组预测中应用的方法论案例，展示如何结合生物先验知识提升模型性能及可解释性。\"\n          },\n          {\n            \"connection_to_review\": \"异质性讨论\",\n            \"material\": \"跨队列验证结果显示，基于CICB训练的模型在单药测试中失效，反之亦然；不同年龄组的关键预测菌属不同。\",\n            \"purpose\": \"用于论证微生物组生物标志物的‘情境依赖性’，说明为何单一通用标志物难以实现，需考虑治疗 regimen 和宿主因素（如年龄）。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的泛化性结论严格限定在治疗策略上：CICB背景下的基因特征具有跨癌种一致性，但单药背景下的特征不具备同等泛化性。\",\n          \"‘基因水平优于分类学水平’的结论基于特定自定义参考基因组集，其他研究使用的标准数据库可能得出不同结果。\",\n          \"年龄分层的结果提示微生物-免疫互作的复杂性，但不能直接推断因果关系。\"\n        ],\n        \"topic_handles\": [\n          \"gene-level microbial abundance (RPKM)\",\n          \"BioP-VAE deep learning model\",\n          \"biological prior knowledge (protein embeddings)\",\n          \"combination immune checkpoint blockade (CICB) vs monotherapy\",\n          \"age-stratified microbiome signatures\",\n          \"feature attribution analysis (Integrated Gradients)\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0437\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\bfb5efeaf486304583ce74567d60f84cf138a0ae\\\\6694c9c6127b2152f7338759876ffe22\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-4dcc7c19ae5301df5638\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-d48cd64bd12b302ad2ba\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-bf2c49938586226d6774\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-76a4a344a1a9861e53c5\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-2fe067d7e5a8cb6b9923\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"kind\": \"assets\",\n            \"reason\": \"supplementaryFiles_fetch_transport_TimeoutError\",\n            \"status\": \"missing\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\bfb5efeaf486304583ce74567d60f84cf138a0ae\\\\6694c9c6127b2152f7338759876ffe22\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0511\",\n      \"title\": \"Meta-analysis of the gut microbiota in predicting response to cancer immunotherapy in metastatic melanoma\",\n      \"year\": \"2020\",\n      \"doi\": \"10.1172/jci.insight.140940\",\n      \"paper_id\": \"e533262a6b45c7d00cff83bd889cdc367c85f377\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"1. 数据筛选：从PubMed检索并纳入4项包含人类MM患者基线粪便MGS数据的公开研究，排除肾细胞癌和非小细胞肺癌数据以确保一致性。2. 统一重处理：使用自定义生物信息学流程（mOTUs2进行物种丰度定量，HUMAnN2进行功能通路定量）对所有原始数据进行标准化重分析。3. 统计比较：采用Wilcoxon秩和检验（未校正多重比较）识别差异丰度物种和MetaCyc通路；使用加权UniFrac距离进行Beta多样性分析；构建共现网络分析微生物互作。4. 机器学习验证：利用差异特征训练随机森林（RF）分类器，并在独立的Peters队列中进行外部验证，评估分类性能（AUC）及预后价值（Kaplan-Meier生存分析与Log-rank检验）。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"通过荟萃分析整合多中心数据，识别出跨队列一致的微生物签名（如Faecalibacterium和B. intestinihominis）及功能特征（维生素B代谢），为ICI疗效的生物标志物提供了综合证据。\",\n            \"limits\": \"差异丰度分析未进行多重检验校正，可能存在假阳性；模型在独立队列中的预测性能有限（AUC~0.62），且预后关联未达到统计显著性；未能阐明具体的因果机制，仅提出假设。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"pooled MM patients (N=130), unadjusted Wilcoxon test\",\n            \"finding\": \"响应者（R）中富集的物种包括Faecalibacterium属、Ruminococcaceae科未知种、Barnesiella intestinihominis和Ruminococcus bicirculans；非响应者（NR）中富集Bacteroides thetaiotaomicron、Adlercreutzia equolifaciens等。\"\n          },\n          {\n            \"conditions\": \"pooled MM patients, MetaCyc pathways\",\n            \"finding\": \"响应者中富集29个差异代谢通路，主要涉及维生素B代谢（硫胺素、钴胺素）、淀粉/糖苷降解及肽聚糖成熟；非响应者中富集核苷酸生物合成和好氧呼吸通路（部分由Campylobacter和Citrobacter驱动）。\"\n          },\n          {\n            \"conditions\": \"independent validation cohort (Peters et al., N=27)\",\n            \"finding\": \"基于训练集特征训练的RF分类器在验证集上达到AUC=0.624 (95% CI: 0.348-0.899)。根据分类结果分组，响应者组的无进展生存期（PFS）风险比HR=0.35，但未达到统计学显著性（P=0.081），作者归因于样本量不足导致的统计效力低。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"肠道微生物组的特征在不同患者队列中是否具有普遍适用性以预测癌症免疫治疗（ICI）的疗效？是否存在一致的微生物组成或功能签名来区分ICI治疗的响应者与未响应者？\",\n        \"research_scope\": \"转移性黑色素瘤（MM）患者，接受抗PD-1、抗CTLA-4或联合免疫检查点抑制剂（ICI）治疗。研究基于4项已发表的粪便宏基因组鸟枪法测序（MGS）数据，共130名患者（66名响应者R，64名非响应者NR），并使用Peters等的一项独立队列（27名MM患者）进行验证。\",\n        \"work_summary\": \"本研究旨在通过荟萃分析确定跨不同患者队列预测ICI治疗响应的肠道微生物组特征。作者对来自4项研究的公开MGS数据进行重新处理和分析，比较响应者与未响应者在分类学组成和功能代谢通路上的差异。研究发现，尽管整体群落结构（Alpha/Beta多样性）在组间无显著差异，但存在一组特定的物种和代谢通路在响应者中富集。基于这些差异特征构建的随机森林分类器在训练集中表现适度，并在独立验证队列中以AUC=0.625区分了响应状态，且该分类预测与无进展生存期（PFS）呈趋势性相关（HR=0.35, P=0.081）。结论认为存在一个跨研究的粪便微生物组签名，可能用于诊断或治疗目的，但需进一步验证。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文提供了关于肠道微生物组预测实体瘤（特别是黑色素瘤）免疫检查点抑制剂疗效的综合实证数据。其核心价值在于通过荟萃分析确认了特定菌属（Faecalibacterium, Barnesiella）和维生素B代谢通路与治疗响应的关联，并展示了跨队列验证的可能性。对于综述而言，它支持“微生物组可作为ICI疗效预测因子”的观点，并提示功能层面（代谢）可能比单一物种更具泛化性，同时也指出了当前预测模型的精度局限性和机制解释的缺失。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"研究对象仅限于转移性黑色素瘤；使用的是回顾性荟萃分析数据，非前瞻性干预试验；统计方法未校正多重比较。\",\n            \"contribution\": \"提供了跨多个独立队列一致的微生物分类学和功能性特征列表，证明某些微生物特征（如Faecalibacterium富集和维生素B代谢增强）与ICI响应正相关。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物组如何调节ICI疗效”中的相关性证据部分，列举具体的预测性微生物标志物。\"\n          },\n          {\n            \"boundaries\": \"这是基于基因含量推断的功能潜力，而非直接测量的代谢物浓度或免疫细胞活性；因果关系尚未证实，仅为相关性观察和推测。\",\n            \"contribution\": \"提出了潜在的机制线索：响应者中富集的维生素B代谢通路（特别是硫胺素和钴胺素）可能与免疫系统激活有关；非响应者中的好氧呼吸通路可能与机会性病原体相关。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于探讨“介导效应的机制”，提供微生物代谢产物影响宿主免疫系统的假设性解释，特别是维生素B的作用。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"作为背景材料，说明当前领域内利用微生物组预测ICI疗效的研究现状和挑战。\",\n            \"material\": \"讨论了全球微生物结构（Alpha/Beta多样性）在响应者和非响应者之间缺乏显著差异，指出个体异质性、地理因素和实验设计偏差的影响。\",\n            \"purpose\": \"用于综述中讨论为什么简单的多样性指标不足以预测疗效，以及为什么需要更精细的分类学或功能特征。\"\n          },\n          {\n            \"connection_to_review\": \"提供关于机器学习在微生物组预测中应用的实例。\",\n            \"material\": \"描述了使用随机森林分类器结合分类和功能特征进行预测的方法及其在独立队列中的验证结果（AUC 0.625）。\",\n            \"purpose\": \"用于综述中评估现有预测模型的准确性水平，指出当前模型性能的局限性（中等准确度），并引出未来需要整合多组学数据以提高预测力的方向。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的发现主要针对转移性黑色素瘤患者，不能直接外推至其他类型的实体瘤或早期癌症。\",\n          \"差异丰度分析未进行多重检验校正，因此列出的差异物种和通路应视为探索性发现，需谨慎解读其特异性。\",\n          \"验证队列样本量较小（N=27），导致预后分析的统计效力不足，P值不显著不代表无关联，而是无法拒绝零假设。\",\n          \"功能分析基于宏基因组测序推断的基因潜力，不等于实际表达的蛋白质或代谢物水平。\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiome composition in melanoma\",\n          \"immune checkpoint inhibitors (ICI) response prediction\",\n          \"metagenomic meta-analysis\",\n          \"Faecalibacterium abundance\",\n          \"Barnesiella intestinihominis\",\n          \"vitamin B metabolism pathways\",\n          \"random forest classifier for immunotherapy response\",\n          \"microbiome network hubs\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0511\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\e533262a6b45c7d00cff83bd889cdc367c85f377\\\\f6de46c7c66bef98ac97c02eb8f0b562\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"kind\": \"identity\",\n            \"reason\": \"source identity was not independently verified\",\n            \"status\": \"conflict\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\e533262a6b45c7d00cff83bd889cdc367c85f377\\\\f6de46c7c66bef98ac97c02eb8f0b562\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0015\",\n      \"title\": \"A gut microbial signature for combination immune checkpoint blockade across cancer types\",\n      \"year\": \"2024\",\n      \"doi\": \"10.1038/s41591-024-02823-z\",\n      \"paper_id\": \"08a484e3c782bc9552d2df812bad2ec86f231edc\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"1. 发现队列分析：对CA209-538试验（n=106）的基线粪便样本进行深度鸟枪法宏基因组测序，采用基因组解析宏基因组学方法（MAG组装+GTDB参考补充）构建菌株级参考库，量化菌株丰度。2. 机器学习建模：使用随机森林算法，比较临床因素、不同分类层级（科、属、种、株）的微生物特征及其组合对最佳总体反应（BOR）和12个月无进展生存期（PFS12）的预测性能（AUC）。3. 内部泛化验证：执行留一组织学队列交叉验证，评估签名在UGB、NEN和GYN三种罕见癌症亚型间的通用性。4. 外部荟萃分析：检索并重新分析6个公开的外部ICB宏基因组队列（共364名患者），统一映射至同一菌株参考库，分别评估签名在CICB队列和抗PD-1单药队列中的外部泛化能力，并比较“同方案”与“异方案”训练/测试对的预测差异。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了证据表明，在ICB疗效预测中，菌株分辨率比物种分辨率更具预测力，且这种微生物签名是‘泛癌种’但‘治疗方案特异’的。\",\n            \"limits\": \"外部验证仅在黑色素瘤队列中进行，尚未在更多样化的实体瘤类型中验证；模型在外部队列中的绝对预测精度（AUC~0.65）尚不足以直接用于临床决策；因果机制仅基于代谢通路存在与否的相关性推断，未通过体外或体内实验确证因果关系。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"CA209-538发现队列 (n=106, CICB治疗)\",\n            \"finding\": \"菌株水平的微生物特征显著优于物种水平及临床因素，预测CICB反应的最佳AUC为0.73。\"\n          },\n          {\n            \"conditions\": \"内部交叉验证 (UGB, NEN, GYN)\",\n            \"finding\": \"菌株响应签名在三种不同的罕见癌症组织学亚型间表现出稳健的预测能力（平均AUC=0.75），提示其具有泛癌种特性。\"\n          },\n          {\n            \"conditions\": \"外部荟萃分析 (6个独立队列, n=364)\",\n            \"finding\": \"当训练集和测试集均为CICB方案时，签名具有中等程度的外部泛化能力（平均AUC=0.65）；但当应用于抗PD-1单药队列时，预测能力丧失（平均AUC=0.51）。\"\n          },\n          {\n            \"conditions\": \"关键驱动菌株功能分析\",\n            \"finding\": \"正向关联的主要菌株属于Firmicutes门Ruminococcaceae科，特别是Faecalibacterium属，且这些菌株普遍拥有完整的乙酰辅酶A丁酸生成途径；而负向关联菌株中部分缺乏该途径。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"既往基于物种水平的肠道微生物标志物在预测ICB疗效时缺乏跨队列的可重复性；同时，不同ICB方案（如联合治疗vs单药）是否共享相同的微生物预测机制尚不明确。\",\n        \"research_scope\": \"针对接受联合免疫检查点阻断（CICB，即抗PD-1加抗CTLA-4）治疗的多种罕见实体瘤患者，以及外部验证队列中的黑色素瘤患者，研究基线肠道微生物组对治疗反应的预测价值。\",\n        \"work_summary\": \"本研究旨在解决既往基于物种水平的微生物标志物在跨队列中可重复性差的问题，提出菌株水平分辨率可能更精准地捕捉与免疫检查点阻断（ICB）反应相关的微生物特征。作者利用CA209-538临床试验的106名罕见实体瘤患者的基线粪便样本进行深度鸟枪法宏基因组测序，构建了一个包含1,397个菌株基因组的自定义参考数据库。通过监督机器学习模型，发现菌株水平的微生物丰度比物种水平或临床因素更能预测CICB的治疗反应和12个月无进展生存期。进一步通过对六个外部独立研究的荟萃分析，证实了该菌株响应签名在不同癌症类型和国家间具有泛癌种有效性，但其预测能力严格依赖于训练集和测试集使用相同的ICB治疗方案（CICB或抗PD-1单药），表明微生物-宿主关系具有治疗方案的特异性而非肿瘤类型的特异性。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于肠道微生物组预测ICB疗效的关键方法论启示和分层策略素材。它证明了单纯依赖物种水平分类会导致信息丢失，强调了菌株分辨率的重要性；同时，它有力地支持了将ICB疗效按治疗方案（CICB vs 单药）进行细分分析的必要性，反驳了单一通用微生物标志物的假设。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"该结论主要基于罕见实体瘤的CICB治疗数据，外推至其他癌症类型或单药治疗时需保持谨慎。\",\n            \"contribution\": \"提供了具体的实证数据，证明在CICB治疗背景下，菌株水平的微生物特征能显著提升预测准确率（AUC从物种级的较低值提升至0.73），且该签名跨越不同罕见癌症类型有效。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于论证在综述中应强调高分辨率微生物分析的价值，以及解释为何某些跨癌种的微生物信号可能存在但被低分辨率分析所掩盖。\"\n          },\n          {\n            \"boundaries\": \"这一发现限制了跨治疗方案直接比较微生物标志物的可行性，提示在综合不同研究结果时必须考虑治疗方案的匹配性。\",\n            \"contribution\": \"揭示了微生物预测签名的‘治疗方案特异性’：针对CICB训练的模型无法预测抗PD-1单药的反应，反之亦然（尽管文中主要展示了CICB模型在单药上的失败）。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持综述中关于‘需根据具体免疫治疗 regimen 定制微生物生物标志物’的观点，避免笼统地讨论‘ICB与微生物的关系’。\"\n          },\n          {\n            \"boundaries\": \"这仅是基于基因组潜力的相关性观察，未提供直接的因果机制证据（如代谢物测量或动物模型验证），不能单独作为机制确定的依据。\",\n            \"contribution\": \"通过功能注释发现，与CICB反应正相关的菌株（如特定Faecalibacterium菌株）富含完整的丁酸合成基因簇，而负相关菌株则缺失，提出了丁酸代谢作为潜在机制线索。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"作为机制探讨部分的背景材料，提供具体的代谢通路（丁酸生成）与特定菌株关联的证据，供后续结合其他文献深入讨论短链脂肪酸作用时使用。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"可用于综述的方法学部分，讨论当前微生物组研究中分辨率不足的问题，以及标准化菌株级分析流程的重要性。\",\n            \"material\": \"论文指出既往物种水平标志物重现性差，并展示了如何通过构建自定义菌株参考库和严格的QC流程来解决这一问题。\",\n            \"purpose\": \"领域现状与方法论批判\"\n          },\n          {\n            \"connection_to_review\": \"用于提醒综述作者在整合不同研究时，必须严格控制治疗方案这一混杂因素，否则可能导致错误的综合结论。\",\n            \"material\": \"论文显示，即使在同一类癌症（黑色素瘤）中，如果治疗方案不同（CICB vs 单药），微生物预测模型也会失效。\",\n            \"purpose\": \"反例或边界条件\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的‘泛癌种’结论仅限于三种罕见实体瘤（UGB, NEN, GYN）及外部黑色素瘤队列，不代表所有实体瘤。\",\n          \"‘菌株特异性’结论是基于计算生物学预测和统计关联，非实验验证的因果机制。\",\n          \"外部验证队列主要来自工业化国家，地理多样性有限。\"\n        ],\n        \"topic_handles\": [\n          \"菌株分辨率 vs 物种分辨率的预测效能差异\",\n          \"泛癌种微生物签名 (Pan-cancer microbiome signatures)\",\n          \"治疗方案特异性 (Regimen-specificity: CICB vs Anti-PD-1 monotherapy)\",\n          \"丁酸产生途径与免疫反应关联\",\n          \"Faecalibacterium spp. 在CICB中的角色\"\n        ]\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0015\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\08a484e3c782bc9552d2df812bad2ec86f231edc\\\\21f509eb3bb18adea1edf730e615b6fb\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\08a484e3c782bc9552d2df812bad2ec86f231edc\\\\21f509eb3bb18adea1edf730e615b6fb\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0583\",\n      \"title\": \"Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial\",\n      \"year\": \"2026\",\n      \"doi\": \"10.1038/s41591-025-04186-5\",\n      \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"研究设计为前瞻性、多中心、单臂II期临床试验。入组标准包括：NSCLC患者需PD-L1 TPS ≥50%且无一线可操作基因改变；黑色素瘤患者不限BRAF状态。所有患者在开始ICI治疗前一周内接受来自健康供体的单次FMT（口服胶囊）。主要终点是NSCLC队列的ORR。次要终点包括黑色素瘤ORR、1年无进展生存期（PFS）、总生存期（OS）、疾病控制率（DCR）及安全性。微生物组分析采用鸟枪法宏基因组测序，结合定量PCR和高通量培养组学验证细菌变化。此外，通过血浆代谢组学和流式细胞术分析免疫代谢景观，并在抗生素处理的荷瘤小鼠模型中通过回输“丢失”的细菌混合物来验证因果机制。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了FMT联合ICI在NSCLC和黑色素瘤一线治疗中的临床活性证据，证实FMT可提高ORR。识别出“基线有害菌清除”作为潜在的药效学生物标志物，并揭示了其与色氨酸代谢抑制及CD8+ T细胞扩增的关联。\",\n            \"limits\": \"研究为单臂设计，缺乏安慰剂对照，难以完全排除自然病程或其他混杂因素。样本量较小（每队列20人），限制了亚组分析和统计效力。黑色素瘤队列中观察到的严重毒性信号（如心肌炎）需要更大规模的随机试验进一步确认。供体选择对毒性的影响提示个体化差异，但具体筛选标准尚未确立。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"NSCLC患者接受FMT+抗PD-1\",\n            \"finding\": \"ORR达到80%（16/20），满足主要终点；1年OS为100%；未观察到3级及以上与治疗相关的不良事件。\"\n          },\n          {\n            \"conditions\": \"黑色素瘤患者接受FMT+抗PD-1+抗CTLA-4\",\n            \"finding\": \"ORR为75%（15/20）；观察到较文献报道更早发生的严重免疫相关不良反应（irAEs），包括心肌炎；部分严重AEs与富含Prevotella的供体有关。\"\n          },\n          {\n            \"conditions\": \"微生物组分析与临床响应关联\",\n            \"finding\": \"响应者（R）与非响应者（NR）相比，在FMT后表现出显著更高的基线细菌物种丢失幅度。这种丢失主要由有害菌（如Enterocloster, Clostridium, Streptococcus）构成，而非供体菌株的定植。\"\n          },\n          {\n            \"conditions\": \"机制验证（动物实验）\",\n            \"finding\": \"在抗生素处理的小鼠中，将FMT响应者基线样本中丢失的有害细菌混合物重新引入，抵消了FMT联合ICI的抗肿瘤效应，证实消除有害菌是治疗获益的必要条件。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"尽管免疫检查点抑制剂改善了NSCLC和黑色素瘤的预后，但超过半数的患者存在原发性耐药。目前尚不清楚健康供体FMT联合抗PD-1（NSCLC）或抗PD-1联合抗CTLA-4（黑色素瘤）在一线治疗中的临床活性和安全性，以及FMT增强ICI疗效的人类机制。\",\n        \"research_scope\": \"该研究针对晚期非小细胞肺癌（NSCLC）和皮肤黑色素瘤患者，评估健康供体粪便微生物群移植（FMT）联合一线免疫检查点抑制剂（ICI）治疗的临床疗效、安全性及机制。NSCLC队列接受抗PD-1单药治疗，黑色素瘤队列接受抗PD-1联合抗CTLA-4双免疫检查点抑制治疗。\",\n        \"work_summary\": \"这是一项多中心、开放标签的II期临床试验（FMT-LUMINate），旨在评估单次口服胶囊FMT在启动ICI治疗前对原发性耐药患者的影响。研究纳入20名NSCLC患者和20名黑色素瘤患者。主要终点为NSCLC队列的客观缓解率（ORR）。结果显示，NSCLC队列ORR为80%，超过预设阈值；黑色素瘤队列ORR为75%。安全性方面，NSCLC组无3级及以上不良事件，而黑色素瘤组出现较早发的严重免疫相关不良反应（irAEs），特别是心肌炎，且与特定供体菌群有关。机制研究发现，响应者并非通过获得特定的供体菌株定植获益，而是通过显著清除基线存在的有害细菌物种（如Enterocloster和Clostridium属），从而降低色氨酸代谢途径活性并改善全身免疫微环境。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文为综述提供了关于FMT联合ICI治疗实体瘤的关键临床数据，特别是其在克服原发性耐药方面的潜力。更重要的是，它提出了一个区别于传统“有益菌定植”假说的新机制框架：即治疗获益主要源于FMT诱导的基线有害病原体（pathobionts）的清除，进而调节宿主代谢和免疫微环境。此外，它还揭示了供体菌群特征（如Prevotella丰度）与特定ICI方案（双免疫检查点抑制）相互作用下的安全性风险。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅适用于未经过ICI治疗的原发性耐药患者；NSCLC结果基于高PD-L1表达人群；黑色素瘤结果包含不同BRAF状态。\",\n            \"contribution\": \"提供了FMT联合ICI在NSCLC（抗PD-1）和黑色素瘤（抗PD-1/CTLA-4）中的具体ORR数据（分别为80%和75%），证明了其在一线治疗中提高临床活性的能力。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物群如何调节实体瘤中ICI的疗效”，提供具体的临床响应率证据，支持FMT作为增敏策略的有效性。\"\n          },\n          {\n            \"boundaries\": \"机制主要在人类队列中通过相关性分析发现，并通过小鼠模型进行功能验证；不同肿瘤类型中富集的有益菌种类有限重叠，但有害菌清除模式一致。\",\n            \"contribution\": \"阐明了FMT起效的潜在机制：响应者的获益主要依赖于基线有害细菌物种（如Enterocloster, Clostridium）的大量丢失，而非供体菌株的成功定植。这种丢失与血浆中色氨酸代谢产物（喹啉酸、犬尿氨酸）水平的降低以及效应性CD8+ T细胞的增加相关。动物实验证实，重新引入这些丢失的有害菌会阻断ICI疗效。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于回答“介导该效应的机制是什么”，提供微生物组重塑的具体分子和免疫学路径，挑战传统的“益生菌定植”主导观点，强调“去致病化”的重要性。\"\n          },\n          {\n            \"boundaries\": \"仅在黑色素瘤双免疫治疗队列中观察到显著的毒性信号；在NSCLC单药治疗或未使用双免疫治疗的既往研究中未观察到相同程度的毒性。\",\n            \"contribution\": \"揭示了特定供体菌群特征（富含Prevotella spp.）与双免疫检查点抑制（抗PD-1/CTLA-4）背景下严重免疫相关不良反应（如心肌炎、早期发作的3级以上AEs）之间的关联。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于讨论ICI疗效与安全性之间的权衡，以及微生物组在预测和管理irAEs中的作用，提示未来FMT研究中供体筛选的重要性。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"为综述中关于“FMT作用机制的争议”提供反面证据或补充视角，即定植效率可能不是决定疗效的唯一或主要因素。\",\n            \"material\": \"研究指出FMT疗效不依赖于供体-宿主相似性或菌株水平定植，而是依赖于基线微生物组的整体重塑和有害菌清除。\",\n            \"purpose\": \"背景信息，用于对比不同研究中关于FMT机制的解释（定植vs清除）。\"\n          },\n          {\n            \"connection_to_review\": \"跨研究的一致性证据，支持“有害菌清除”作为FMT疗效通用机制的假设。\",\n            \"material\": \"提到TACITO试验也观察到类似的结果，即在FMT组中观察到基线物种的消除，而在安慰剂组中没有。\",\n            \"purpose\": \"作为外部验证，增强综述中关于机制结论的可信度。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的机制结论（有害菌清除导致疗效）是基于观察性关联和小鼠功能验证，需谨慎推断其在所有FMT场景下的普适性。\",\n          \"黑色素瘤队列中的严重毒性信号可能与双免疫检查点抑制的背景有关，不能直接外推至单药ICI治疗。\",\n          \"供体选择对毒性的影响提示个体化差异，但本研究未建立标准化的供体筛选算法，仅作为警示。\",\n          \"NSCLC队列的高ORR可能受限于高PD-L1表达人群的预后较好，需注意人群特异性。\"\n        ],\n        \"topic_handles\": [\n          \"FMT联合ICI的临床疗效（NSCLC, Melanoma）\",\n          \"FMT介导的微生物组重塑机制（有害菌清除 vs 有益菌定植）\",\n          \"肠道微生物-免疫代谢轴（色氨酸代谢, 喹啉酸, 犬尿氨酸）\",\n          \"ICI相关不良反应（irAEs）的微生物驱动因素\",\n          \"供体选择对治疗安全性和有效性的影响\"\n        ]\n      },\n      \"deep_read_material\": {\n        \"_progressive_task_requirements\": {\n          \"knowledge_gaps\": [\n            \"FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。\"\n          ],\n          \"questions\": [\n            {\n              \"gap_key\": \"FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。\",\n              \"purpose\": \"Supply a concrete, attributed case for the coordinated review.\",\n              \"question\": \"FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。\",\n              \"question_id\": \"Q01\",\n              \"required_output_ids\": [\n                \"O01\"\n              ]\n            }\n          ],\n          \"required_outputs\": [\n            {\n              \"description\": \"Source-based findings, conditions, methods and limits useful to the review.\",\n              \"output_id\": \"O01\",\n              \"output_type\": \"practical_material\"\n            }\n          ]\n        },\n        \"_progressive_task_signature\": \"37c81ea7cb18384d\",\n        \"current_question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为FMT-LUMINate试验中的非小细胞肺癌（NSCLC, n=20）和黑色素瘤（n=20）患者。黑色素瘤患者接受FMT联合抗PD-1（nivolumab）和抗CTLA-4（ipilimumab）治疗；NSCLC患者接受FMT联合抗PD-1（pembrolizumab）治疗。供体聚类基于41个来自9名供体的样本进行Bray-Curtis不相似度分析。AEs分级依据CTCAE v5.0。\",\n                \"finding\": \"在黑色素瘤队列中，19名患者（95%）出现任何级别的与治疗相关的不良事件（AEs），其中12名（60%）出现3级或更高级别的AEs，1名出现4级AEs。最常见的3级或以上AE是腹泻或结肠炎（20%的患者）。有3名患者（15%）发生心肌炎，这高于文献报道的<1%的发生率。严重毒性的中位发作时间为开始抗PD-1和抗CTLA-4治疗后的40天，早于文献报告的60天。独立数据和安全监测委员会（DSMC）认为这些严重AEs比既往文献报道的发作更早。在NSCLC队列中，没有患者出现3级或更高级别的AEs。通过非监督聚类分析，健康供体的肠道微生物组被分为两个截然不同的簇（P = 0.001）。B簇（包含供体5和供体11）以高丰度的Prevotella spp.为特征。差异丰度分析证实，P. sp. Marseille-P4119、P. stercorea和Prevotellaceae GGB1146 SGB1472在接受双免疫检查点抑制剂治疗的黑色素瘤患者中，若发生3级或以上AEs则显著富集。后FMT定植的P. sp. Marseille-P4119、P. stercorea和Prevotellaceae SGB1472与3级或以上AEs显著相关（P < 0.001, P = 0.023, P < 0.001）。供体5提供的粪便在所有接受双ICI治疗的黑色素瘤患者中均导致3级或以上AEs，且两名发生快速发作心肌炎的患者均接受了来自供体5的FMT。然而，当仅使用抗PD-1单药治疗时（如之前的MIMIC试验中的供体5数据或本研究的NSCLC队列），来自Cluster B的供体并未引起毒性。综合所有经历3级或以上AEs的患者（包括当前研究和之前的MIMIC试验），来自Cluster B供体的粪便仅在联合PD-1和CTLA-4阻断的患者中引起毒性（P = 0.051）。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供FMT-LUMINate试验中关于安全性数据的具体统计结果、毒性事件临床特征（特别是心肌炎和腹泻/结肠炎的发作时间），以及供体微生物组聚类分析与免疫相关不良事件（irAEs）关联的详细机制证据。\"\n              }\n            ],\n            \"explanation\": \"本研究揭示了FMT结合不同免疫检查点抑制剂（ICI）背景下的安全性差异及其潜在的微生物机制。首先，FMT联合抗PD-1在NSCLC中表现出良好的安全性，无3级或以上AEs；而在联合抗PD-1和抗CTLA-4的黑色素瘤中，虽然总体安全性被DSMC判定为可接受，但出现了加速发作的严重免疫相关不良事件（irAEs），特别是心肌炎和中位发作时间提前至40天。其次，供体微生物组的组成决定了这种毒性风险。通过非监督聚类，供体被分为富含Prevotella spp.的Cluster B和其他Cluster A。Cluster B供体（特别是供体5）与严重的irAEs（包括心肌炎）密切相关，但这种关联具有严格的上下文依赖性：它仅在抗CTLA-4存在的情况下显现，而在抗PD-1单药治疗背景下不引发毒性。这表明特定的微生物类群（如Prevotella spp.）与ICI骨架之间存在情境依赖性的相互作用，可能驱动了双重阻断下的过度免疫反应。因此，供体选择对于未来FMT试验的安全性至关重要，特别是当联合使用抗CTLA-4时。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"心肌炎的具体病理生理机制尚需进一步探索，尽管观察到其与特定菌属定植及CD4+ T细胞亚群变化的关联。\",\n              \"供体筛选标准如何具体量化以避免Cluster B供体，目前仅指出需排除此类供体。\"\n            ]\n          }\n        ],\n        \"fulfilled\": false,\n        \"paper_identity\": {\n          \"canonical_paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n          \"doi\": \"10.1038/s41591-025-04186-5\",\n          \"title\": \"Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial\"\n        },\n        \"paper_title\": \"Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial\",\n        \"plain_text\": \"\",\n        \"prior_question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究人群：NSCLC队列（n=20，一线治疗，PD-L1 TPS ≥ 50%，无既往抗PD-1暴露）；黑色素瘤队列（n=20，一线治疗，允许既往辅助抗PD-1但需停药>6个月）。干预措施：单次健康供体粪便微生物移植（FMT，口服胶囊）后紧接着启动ICI治疗。NSCLC组使用帕博利珠单抗（pembrolizumab）单药；黑色素瘤组使用纳武利尤单抗（nivolumab）联合伊匹木单抗（ipilimumab）。\",\n                \"finding\": \"在NSCLC队列中，FMT联合抗PD-1治疗的客观缓解率（ORR）为80%（16/20），超过了预设的64%主要终点阈值。在黑色素瘤队列中，FMT联合抗PD-1加抗CTLA-4（双ICI）治疗的ORR为75%（15/20）。关于毒性信号，在黑色素瘤双ICI组中观察到严重不良事件（AEs）的发生率较高且起病更早：13名患者（65%）经历了3级或更高级别的AEs，其中腹泻或结肠炎是最常见的3级及以上AE（20%的患者），另有15%的患者出现心肌炎。严重毒性的中位起病时间为开始抗PD-1和抗CTLA-4治疗后40天，早于文献报道的60天。相比之下，NSCLC单药抗PD-1组无3级或以上AEs发生。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供FMT联合免疫检查点抑制剂（ICI）在非小细胞肺癌（NSCLC）和黑色素瘤中的具体客观缓解率（ORR），以及双免疫检查点抑制剂（dual ICI）治疗下的毒性信号特征。\"\n              }\n            ],\n            \"explanation\": \"该研究通过FMT-LUMINate II期临床试验评估了FMT联合ICI在两种不同癌症背景下的临床活性与安全性。结果显示，FMT显著提高了NSCLC患者对单药抗PD-1治疗的反应率（80%），并改善了黑色素瘤患者对双免疫检查点阻断（抗PD-1+抗CTLA-4）的反应率（75%）。然而，在黑色素瘤双ICI背景下，FMT联合治疗伴随着更高的免疫相关不良事件（irAEs）风险，特别是心肌炎和早期发作的严重毒性。这种毒性信号与特定供体来源的微生物群（富含Prevotella spp.）有关，且仅在双ICI背景下出现，而在单药抗PD-1背景下未观察到类似毒性。这表明FMT的安全性与特定的ICI治疗方案及供体微生物特征存在交互作用。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": []\n          },\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为FMT-LUMINate试验中的NSCLC（n=20）和黑色素瘤（n=20）患者。NSCLC组接受单药抗PD-1（pembrolizumab），黑色素瘤组接受双免疫检查点抑制剂（nivolumab + ipilimumab）。供体聚类基于 shotgun metagenomic sequencing 数据，使用 Bray-Curtis 指数进行无监督聚类，并通过 PERMANOVA 评估组间差异。AEs分级依据 CTCAE v5.0。\",\n                \"finding\": \"在NSCLC队列中，接受FMT联合抗PD-1治疗的患者未出现3级或更高不良事件（AEs），仅15%患者因2级AE使用皮质类固醇；而在黑色素瘤队列中，65%患者经历3级或更高AEs，其中腹泻/结肠炎占20%，心肌炎发生率为15%（3例），显著高于文献报道的<1%。独立数据和安全监测委员会（DSMC）判定该组合总体安全，但指出黑色素瘤队列中的严重AEs起病更早（中位40天 vs 文献60天）。聚类分析显示，来自富含普雷沃菌属（Prevotella spp.）的供体（特别是供体5）与3级及以上AEs的发生密切相关：所有由供体5提供的粪便导致黑色素瘤患者出现3级+ AEs，且2/3例心肌炎患者接受了供体5的FMT。这些毒性仅在双免疫检查点抑制剂（anti-PD-1 + anti-CTLA-4）背景下观察到，而在单药抗PD-1治疗中未出现。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供FMT-LUMINate试验中安全性数据的详细统计结果、毒性事件的具体临床特征（如心肌炎发生率、起病时间）以及与供体微生物组相关的因果关联分析，作为核心证据支持关于FMT安全性的讨论。\"\n              },\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"分析对象包括FMT-LUMINate黑色素瘤队列及之前发表的MIMIC试验（Phase 1, melanoma, anti-PD-1 monotherapy）数据。统计方法包括 Fisher's exact test 比较组间差异，LEfSe 进行线性判别分析效应大小，以及 Spearman's r 相关性分析微生物定植与免疫细胞频率的关系。\",\n                \"finding\": \"通过无监督聚类分析，健康供体的肠道微生物组被分为两个 distinct clusters (P = 0.001)。Cluster B（包含供体5和11）以高丰度的普雷沃菌属（如 Segatella copri, Prevotella sp. Marseille-P4119, P. stercorea）为特征。在黑色素瘤患者中，接受 Cluster B 供体FMT后，出现3级+ AEs的患者中这些菌属显著富集（LDA score > 2, P < 0.05）。进一步分析显示，在接受双免疫检查点抑制剂治疗的患者中，S. copri 的定植与外周血中 CD4+ T细胞亚群比例增加相关（P = 0.026），而这种关联在单药抗PD-1治疗中不存在。这表明普雷沃菌属的定植是双免疫检查点抑制背景下毒性增加的驱动因素。\",\n                \"reference_ids\": [\n                  \"R23\"\n                ],\n                \"use_in_review\": \"展示供体微生物组特征与免疫相关不良反应（irAEs）之间的机制性联系，特别是普雷沃菌属定植与特定T细胞亚群变化的关联，用于解释为何某些供体会增加毒性风险。\"\n              }\n            ],\n            \"explanation\": \"本研究揭示了FMT联合ICI治疗的安全性与供体微生物组特征及ICI治疗方案之间的复杂相互作用。首先，FMT本身在NSCLC（单药抗PD-1）中表现出良好的耐受性，无3级以上AEs。然而，在黑色素瘤（双药抗PD-1/CTLA-4）中，虽然总体安全性被DSMC认可，但出现了加速发作的严重AEs，特别是心肌炎。这种毒性信号并非随机分布，而是与特定的供体微生物组特征紧密相关。通过供体聚类分析，研究发现富含普雷沃菌属（Prevotella spp.）的供体（Cluster B）与3级以上AEs的发生显著相关。机制上，这种关联依赖于ICI的治疗背景：普雷沃菌属的定植及其引发的CD4+ T细胞变化仅在双免疫检查点抑制（anti-PD-1 + anti-CTLA-4）条件下导致毒性，而在单药抗PD-1条件下不表现。这提示普雷沃菌属可能是双免疫检查点抑制背景下免疫相关不良反应的潜在驱动因子，强调了根据ICI方案选择合适供体的重要性。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"心肌炎的具体病理生理机制尚需进一步探索，尽管已将其列为特殊关注AE。\",\n              \"供体筛选标准如何具体量化‘普雷沃菌属丰富度’阈值以排除高风险供体，文中未给出明确操作指南。\",\n              \"长期随访中，这些早期AEs对最终肿瘤疗效是否有负面影响，文中提到数值上有关联但统计不显著，需更大样本验证。\"\n            ]\n          }\n        ],\n        \"question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究人群：NSCLC队列（n=20，一线治疗，PD-L1 TPS ≥ 50%，无既往抗PD-1暴露）；黑色素瘤队列（n=20，一线治疗，允许既往辅助抗PD-1但需停药>6个月）。干预措施：单次健康供体粪便微生物移植（FMT，口服胶囊）后紧接着启动ICI治疗。NSCLC组使用帕博利珠单抗（pembrolizumab）单药；黑色素瘤组使用纳武利尤单抗（nivolumab）联合伊匹木单抗（ipilimumab）。\",\n                \"finding\": \"在NSCLC队列中，FMT联合抗PD-1治疗的客观缓解率（ORR）为80%（16/20），超过了预设的64%主要终点阈值。在黑色素瘤队列中，FMT联合抗PD-1加抗CTLA-4（双ICI）治疗的ORR为75%（15/20）。关于毒性信号，在黑色素瘤双ICI组中观察到严重不良事件（AEs）的发生率较高且起病更早：13名患者（65%）经历了3级或更高级别的AEs，其中腹泻或结肠炎是最常见的3级及以上AE（20%的患者），另有15%的患者出现心肌炎。严重毒性的中位起病时间为开始抗PD-1和抗CTLA-4治疗后40天，早于文献报道的60天。相比之下，NSCLC单药抗PD-1组无3级或以上AEs发生。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供FMT联合免疫检查点抑制剂（ICI）在非小细胞肺癌（NSCLC）和黑色素瘤中的具体客观缓解率（ORR），以及双免疫检查点抑制剂（dual ICI）治疗下的毒性信号特征。\"\n              }\n            ],\n            \"explanation\": \"该研究通过FMT-LUMINate II期临床试验评估了FMT联合ICI在两种不同癌症背景下的临床活性与安全性。结果显示，FMT显著提高了NSCLC患者对单药抗PD-1治疗的反应率（80%），并改善了黑色素瘤患者对双免疫检查点阻断（抗PD-1+抗CTLA-4）的反应率（75%）。然而，在黑色素瘤双ICI背景下，FMT联合治疗伴随着更高的免疫相关不良事件（irAEs）风险，特别是心肌炎和早期发作的严重毒性。这种毒性信号与特定供体来源的微生物群（富含Prevotella spp.）有关，且仅在双ICI背景下出现，而在单药抗PD-1背景下未观察到类似毒性。这表明FMT的安全性与特定的ICI治疗方案及供体微生物特征存在交互作用。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": []\n          },\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为FMT-LUMINate试验中的NSCLC（n=20）和黑色素瘤（n=20）患者。NSCLC组接受单药抗PD-1（pembrolizumab），黑色素瘤组接受双免疫检查点抑制剂（nivolumab + ipilimumab）。供体聚类基于 shotgun metagenomic sequencing 数据，使用 Bray-Curtis 指数进行无监督聚类，并通过 PERMANOVA 评估组间差异。AEs分级依据 CTCAE v5.0。\",\n                \"finding\": \"在NSCLC队列中，接受FMT联合抗PD-1治疗的患者未出现3级或更高不良事件（AEs），仅15%患者因2级AE使用皮质类固醇；而在黑色素瘤队列中，65%患者经历3级或更高AEs，其中腹泻/结肠炎占20%，心肌炎发生率为15%（3例），显著高于文献报道的<1%。独立数据和安全监测委员会（DSMC）判定该组合总体安全，但指出黑色素瘤队列中的严重AEs起病更早（中位40天 vs 文献60天）。聚类分析显示，来自富含普雷沃菌属（Prevotella spp.）的供体（特别是供体5）与3级及以上AEs的发生密切相关：所有由供体5提供的粪便导致黑色素瘤患者出现3级+ AEs，且2/3例心肌炎患者接受了供体5的FMT。这些毒性仅在双免疫检查点抑制剂（anti-PD-1 + anti-CTLA-4）背景下观察到，而在单药抗PD-1治疗中未出现。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供FMT-LUMINate试验中安全性数据的详细统计结果、毒性事件的具体临床特征（如心肌炎发生率、起病时间）以及与供体微生物组相关的因果关联分析，作为核心证据支持关于FMT安全性的讨论。\"\n              },\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"分析对象包括FMT-LUMINate黑色素瘤队列及之前发表的MIMIC试验（Phase 1, melanoma, anti-PD-1 monotherapy）数据。统计方法包括 Fisher's exact test 比较组间差异，LEfSe 进行线性判别分析效应大小，以及 Spearman's r 相关性分析微生物定植与免疫细胞频率的关系。\",\n                \"finding\": \"通过无监督聚类分析，健康供体的肠道微生物组被分为两个 distinct clusters (P = 0.001)。Cluster B（包含供体5和11）以高丰度的普雷沃菌属（如 Segatella copri, Prevotella sp. Marseille-P4119, P. stercorea）为特征。在黑色素瘤患者中，接受 Cluster B 供体FMT后，出现3级+ AEs的患者中这些菌属显著富集（LDA score > 2, P < 0.05）。进一步分析显示，在接受双免疫检查点抑制剂治疗的患者中，S. copri 的定植与外周血中 CD4+ T细胞亚群比例增加相关（P = 0.026），而这种关联在单药抗PD-1治疗中不存在。这表明普雷沃菌属的定植是双免疫检查点抑制背景下毒性增加的驱动因素。\",\n                \"reference_ids\": [\n                  \"R23\"\n                ],\n                \"use_in_review\": \"展示供体微生物组特征与免疫相关不良反应（irAEs）之间的机制性联系，特别是普雷沃菌属定植与特定T细胞亚群变化的关联，用于解释为何某些供体会增加毒性风险。\"\n              }\n            ],\n            \"explanation\": \"本研究揭示了FMT联合ICI治疗的安全性与供体微生物组特征及ICI治疗方案之间的复杂相互作用。首先，FMT本身在NSCLC（单药抗PD-1）中表现出良好的耐受性，无3级以上AEs。然而，在黑色素瘤（双药抗PD-1/CTLA-4）中，虽然总体安全性被DSMC认可，但出现了加速发作的严重AEs，特别是心肌炎。这种毒性信号并非随机分布，而是与特定的供体微生物组特征紧密相关。通过供体聚类分析，研究发现富含普雷沃菌属（Prevotella spp.）的供体（Cluster B）与3级以上AEs的发生显著相关。机制上，这种关联依赖于ICI的治疗背景：普雷沃菌属的定植及其引发的CD4+ T细胞变化仅在双免疫检查点抑制（anti-PD-1 + anti-CTLA-4）条件下导致毒性，而在单药抗PD-1条件下不表现。这提示普雷沃菌属可能是双免疫检查点抑制背景下免疫相关不良反应的潜在驱动因子，强调了根据ICI方案选择合适供体的重要性。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"心肌炎的具体病理生理机制尚需进一步探索，尽管已将其列为特殊关注AE。\",\n              \"供体筛选标准如何具体量化‘普雷沃菌属丰富度’阈值以排除高风险供体，文中未给出明确操作指南。\",\n              \"长期随访中，这些早期AEs对最终肿瘤疗效是否有负面影响，文中提到数值上有关联但统计不显著，需更大样本验证。\"\n            ]\n          },\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为FMT-LUMINate试验中的非小细胞肺癌（NSCLC, n=20）和黑色素瘤（n=20）患者。黑色素瘤患者接受FMT联合抗PD-1（nivolumab）和抗CTLA-4（ipilimumab）治疗；NSCLC患者接受FMT联合抗PD-1（pembrolizumab）治疗。供体聚类基于41个来自9名供体的样本进行Bray-Curtis不相似度分析。AEs分级依据CTCAE v5.0。\",\n                \"finding\": \"在黑色素瘤队列中，19名患者（95%）出现任何级别的与治疗相关的不良事件（AEs），其中12名（60%）出现3级或更高级别的AEs，1名出现4级AEs。最常见的3级或以上AE是腹泻或结肠炎（20%的患者）。有3名患者（15%）发生心肌炎，这高于文献报道的<1%的发生率。严重毒性的中位发作时间为开始抗PD-1和抗CTLA-4治疗后的40天，早于文献报告的60天。独立数据和安全监测委员会（DSMC）认为这些严重AEs比既往文献报道的发作更早。在NSCLC队列中，没有患者出现3级或更高级别的AEs。通过非监督聚类分析，健康供体的肠道微生物组被分为两个截然不同的簇（P = 0.001）。B簇（包含供体5和供体11）以高丰度的Prevotella spp.为特征。差异丰度分析证实，P. sp. Marseille-P4119、P. stercorea和Prevotellaceae GGB1146 SGB1472在接受双免疫检查点抑制剂治疗的黑色素瘤患者中，若发生3级或以上AEs则显著富集。后FMT定植的P. sp. Marseille-P4119、P. stercorea和Prevotellaceae SGB1472与3级或以上AEs显著相关（P < 0.001, P = 0.023, P < 0.001）。供体5提供的粪便在所有接受双ICI治疗的黑色素瘤患者中均导致3级或以上AEs，且两名发生快速发作心肌炎的患者均接受了来自供体5的FMT。然而，当仅使用抗PD-1单药治疗时（如之前的MIMIC试验中的供体5数据或本研究的NSCLC队列），来自Cluster B的供体并未引起毒性。综合所有经历3级或以上AEs的患者（包括当前研究和之前的MIMIC试验），来自Cluster B供体的粪便仅在联合PD-1和CTLA-4阻断的患者中引起毒性（P = 0.051）。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供FMT-LUMINate试验中关于安全性数据的具体统计结果、毒性事件临床特征（特别是心肌炎和腹泻/结肠炎的发作时间），以及供体微生物组聚类分析与免疫相关不良事件（irAEs）关联的详细机制证据。\"\n              }\n            ],\n            \"explanation\": \"本研究揭示了FMT结合不同免疫检查点抑制剂（ICI）背景下的安全性差异及其潜在的微生物机制。首先，FMT联合抗PD-1在NSCLC中表现出良好的安全性，无3级或以上AEs；而在联合抗PD-1和抗CTLA-4的黑色素瘤中，虽然总体安全性被DSMC判定为可接受，但出现了加速发作的严重免疫相关不良事件（irAEs），特别是心肌炎和中位发作时间提前至40天。其次，供体微生物组的组成决定了这种毒性风险。通过非监督聚类，供体被分为富含Prevotella spp.的Cluster B和其他Cluster A。Cluster B供体（特别是供体5）与严重的irAEs（包括心肌炎）密切相关，但这种关联具有严格的上下文依赖性：它仅在抗CTLA-4存在的情况下显现，而在抗PD-1单药治疗背景下不引发毒性。这表明特定的微生物类群（如Prevotella spp.）与ICI骨架之间存在情境依赖性的相互作用，可能驱动了双重阻断下的过度免疫反应。因此，供体选择对于未来FMT试验的安全性至关重要，特别是当联合使用抗CTLA-4时。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"心肌炎的具体病理生理机制尚需进一步探索，尽管观察到其与特定菌属定植及CD4+ T细胞亚群变化的关联。\",\n              \"供体筛选标准如何具体量化以避免Cluster B供体，目前仅指出需排除此类供体。\"\n            ]\n          }\n        ],\n        \"questions\": [\n          {\n            \"gap_key\": \"FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。\",\n            \"purpose\": \"Supply a concrete, attributed case for the coordinated review.\",\n            \"question\": \"FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。\",\n            \"question_id\": \"Q01\",\n            \"required_output_ids\": [\n              \"O01\"\n            ]\n          }\n        ],\n        \"reading_mode\": \"focused_local_search\",\n        \"required_outputs\": [\n          {\n            \"description\": \"Source-based findings, conditions, methods and limits useful to the review.\",\n            \"output_id\": \"O01\",\n            \"output_type\": \"practical_material\"\n          }\n        ],\n        \"source_hash\": \"8dd08b84648262841f9d35af692160252692383791e7c7d076ecd654063fb0f3\",\n        \"task_hash\": \"4fcf708140bdb8b00ce198191a4362b1ee8545d9d5569d77e4118fb1833a9f61\"\n      },\n      \"deep_read_material_trimmed\": {\n        \"dropped_keys\": {\n          \"material_ready\": 4,\n          \"paper_id\": 42,\n          \"references\": 413,\n          \"review_id\": 23,\n          \"schema_version\": 46,\n          \"status\": 9,\n          \"task_id\": 34,\n          \"workflow\": 21\n        },\n        \"dropped_chars\": 592,\n        \"note\": \"深读材料里的记账字段与论文自带的参考文献表已省略；科学内容（问句材料/发现/条件）保留。需要时可用 locator 读原文。\"\n      },\n      \"supplement_material\": {\n        \"auxiliary_material\": \"The authors explicitly state that this is a phase 2 trial, not a phase 3 trial. They mention that the findings will be assessed as part of the CanBiome2 randomized trial (NCT06623461), which is described as a randomized trial evaluating FMT in combination with ICI in 128 patients, but the current paper does not report the results of this phase 3 trial. The study design was open-label and single-arm for the cohorts reported here, lacking the randomization required for a phase 3 RCT status.\",\n        \"evidence\": [],\n        \"gap_id\": \"case_E_phase3_rct\",\n        \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU01_search_candidate_dcbe39b3d2\\\\FULFILLMENT_JUDGMENT.json\",\n        \"limitations\": [],\n        \"material_ready\": true,\n        \"material_usefulness\": \"supporting\",\n        \"outline_action\": \"Search for published results from the CanBiome2 trial (NCT06623461) or other large-scale randomized phase III trials of microbiome interventions in ICI-treated cancer patients to determine if any have been completed and reported since this publication.\",\n        \"outline_action_recovered_by_policy\": false,\n        \"remaining_gap\": \"The gap requires evidence of a completed large randomised phase III trial. This material provides only a phase 2 trial. While the authors reference an ongoing/forthcoming phase 3 trial (CanBiome2), they do not provide its results or confirm its completion within this text.\",\n        \"remaining_gap_recovered_by_policy\": false,\n        \"status\": \"unmet\",\n        \"useful_material\": \"This study reports the results of FMT-LUMINate, a multicenter, open-label, phase 2 trial evaluating healthy donor fecal microbiota transplantation (FMT) combined with immune checkpoint inhibitors (ICI) in patients with non-small cell lung cancer (NSCLC) or melanoma. The trial enrolled 40 patients (20 NSCLC, 20 melanoma). In the NSCLC cohort receiving anti-PD-1 monotherapy, the objective response rate (ORR) was 80%. In the melanoma cohort receiving dual anti-PD-1 and anti-CTLA-4 therapy, the ORR was 75%. The study found that clinical response was associated with the loss of baseline deleterious bacterial species rather than the engraftment of donor-specific strains. Safety data indicated no grade 3+ adverse events in the NSCLC cohort, but a higher incidence of severe immune-related adverse events (including myocarditis) in the melanoma cohort, particularly among recipients of donors rich in Prevotella spp.\"\n      },\n      \"supplement_materials\": [\n        {\n          \"auxiliary_material\": \"The authors explicitly state that this is a phase 2 trial, not a phase 3 trial. They mention that the findings will be assessed as part of the CanBiome2 randomized trial (NCT06623461), which is described as a randomized trial evaluating FMT in combination with ICI in 128 patients, but the current paper does not report the results of this phase 3 trial. The study design was open-label and single-arm for the cohorts reported here, lacking the randomization required for a phase 3 RCT status.\",\n          \"evidence\": [],\n          \"gap_id\": \"case_E_phase3_rct\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU01_search_candidate_dcbe39b3d2\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action\": \"Search for published results from the CanBiome2 trial (NCT06623461) or other large-scale randomized phase III trials of microbiome interventions in ICI-treated cancer patients to determine if any have been completed and reported since this publication.\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"The gap requires evidence of a completed large randomised phase III trial. This material provides only a phase 2 trial. While the authors reference an ongoing/forthcoming phase 3 trial (CanBiome2), they do not provide its results or confirm its completion within this text.\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"This study reports the results of FMT-LUMINate, a multicenter, open-label, phase 2 trial evaluating healthy donor fecal microbiota transplantation (FMT) combined with immune checkpoint inhibitors (ICI) in patients with non-small cell lung cancer (NSCLC) or melanoma. The trial enrolled 40 patients (20 NSCLC, 20 melanoma). In the NSCLC cohort receiving anti-PD-1 monotherapy, the objective response rate (ORR) was 80%. In the melanoma cohort receiving dual anti-PD-1 and anti-CTLA-4 therapy, the ORR was 75%. The study found that clinical response was associated with the loss of baseline deleterious bacterial species rather than the engraftment of donor-specific strains. Safety data indicated no grade 3+ adverse events in the NSCLC cohort, but a higher incidence of severe immune-related adverse events (including myocarditis) in the melanoma cohort, particularly among recipients of donors rich in Prevotella spp.\"\n        }\n      ],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0583\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU01_search_candidate_dcbe39b3d2\\\\card\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-a91f0ed643887e9f1b1d\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-ef95a97dcd7bd8c151c4\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-501f35983c2f020a5c71\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-81ec1ef0c2a046851171\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-d46f32b2af56fa1c47e2\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-02757a568956f4b210b5\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-47775c7896730e2260bc\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-b08d87be9985923039c9\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-4d651eaa044aee02c8ec\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-1294ef6fcf50c0be4a42\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-6e217865835c2f670e17\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-b1f79ce65e003459f3ed\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-786845b1cd45dd24fdc8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-f0ebbdf389d42cf46d30\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"kind\": \"assets\",\n            \"reason\": \"supplementaryFiles_fetch_transport_TimeoutError\",\n            \"status\": \"missing\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260926_adaptive_retrieval\\\\03_external_closure\\\\runs\\\\case_E_phase3_rct\\\\source_units\\\\SU01_search_candidate_dcbe39b3d2\\\\card\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0273\",\n      \"title\": \"The Gut Microbiome and Cancer Immunotherapy: Can We Use the Gut Microbiome as a Predictive Biomarker for Clinical Response in Cancer Immunotherapy?\",\n      \"year\": \"2021\",\n      \"doi\": \"10.3390/cancers13194824\",\n      \"paper_id\": \"759b176490dcac135bff0b645dc106c3df8f4059\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用叙述性综述方法。电子数据库搜索策略包括关键词“cancer”、“immunotherapy/immune checkpoint inhibitor”和“microbiome/microbiota”。纳入标准限定为：成人（>18岁）、英文全文、同行评审期刊发表的研究。排除动物模型研究以专注于临床应用证据。对纳入的10项研究进行定性综合，按癌症类型（黑色素瘤、HCC、NSCLC等）和治疗结果（疗效、irAEs、FMT干预）分类整理发现。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"首次专门针对临床研究的综述，汇总了肠道微生物组作为ICIs疗效预测生物标志物和irAEs风险因子的证据，强调了FMT在逆转耐药性方面的初步临床可行性。\",\n            \"limits\": \"所纳入的研究样本量普遍较小（多数n≤42），存在异质性（不同癌症类型、不同ICI药物、不同测序方法如16S rRNA与宏基因组）。观察性研究无法确立因果关系。未对纳入的非随机研究进行严格的质量偏倚风险评估。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"接受ICIs治疗的晚期癌症患者（黑色素瘤、HCC、NSCLC等）\",\n            \"finding\": \"基线肠道微生物组的多样性和组成与ICIs疗效显著相关。高α-多样性通常与较长的PFS和OS相关。特定菌属富集与响应正相关（如Fecalibacterium prausnitzii, Bifidobacterium longum, Akkermansia muciniphila），而某些拟杆菌目（Bacteroidales）丰度高则与非响应相关。\"\n          },\n          {\n            \"conditions\": \"接受CTLA-4抑制剂治疗的黑色素瘤患者\",\n            \"finding\": \"低丰度的Bacteroidetes门细菌与免疫检查点抑制剂诱导的结肠炎（GI毒性）相关；相反，较高的Bacteroidetes丰度与抵抗结肠炎发生相关。\"\n          },\n          {\n            \"conditions\": \"抗PD-1难治性转移性黑色素瘤患者接受来自响应者的FMT\",\n            \"finding\": \"两项突破性临床试验显示，将来自免疫治疗响应者的粪菌移植给难治性患者，结合抗PD-1治疗，可使部分患者重新获得临床响应（Baruch et al. 3/10响应；Davar et al. 6/15响应），且安全性良好。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管免疫疗法提高了部分晚期癌症患者的生存率，但仅少数患者受益且常伴随严重免疫相关不良事件（irAEs）。目前尚缺乏基于临床证据的指导方针来利用肠道微生物组预测治疗反应或管理副作用。本研究试图厘清肠道微生物组作为预测生物标志物的潜力及其在增强疗效和减少副作用中的作用。\",\n        \"research_scope\": \"临床癌症患者（晚期转移性黑色素瘤、肝细胞癌、非小细胞肺癌及肾细胞癌），聚焦于免疫检查点抑制剂（ICIs）治疗前后的肠道微生物组特征及其与疗效和不良事件的关系。\",\n        \"work_summary\": \"该综述旨在评估肠道微生物组对癌症患者免疫检查点抑制剂（ICIs）临床结局及相关不良事件（AEs）的影响。作者检索了截至2021年3月的PubMed、Medline和ScienceDirect数据库，筛选出10项涉及成年人的临床研究。研究综合分析了基线微生物组的多样性（α/β多样性）和组成成分与ICIs疗效（无进展生存期PFS、总生存期OS）及胃肠道毒性（如结肠炎）之间的关联，并探讨了粪菌移植（FMT）在难治性患者中的潜在调节作用。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文提供了关于肠道微生物组如何影响实体瘤免疫治疗疗效的临床证据汇总，特别指出了特定菌群（如Faecalibacterium, Akkermansia）与疗效的正向关联，以及抗生素使用或特定菌群缺失与疗效不佳或毒性的关联。此外，它提供了FMT作为克服免疫耐药的临床干预案例，是讨论微生物组调控机制和临床转化潜力的重要素材。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"这些关联主要基于观察性研究，存在癌症类型异质性和样本量小的限制，不能直接推断因果机制。不同研究中具体差异菌种存在不一致性。\",\n            \"contribution\": \"提供了多项临床研究数据，表明基线肠道微生物组的特定组成（如Faecalibacterium prausnitzii, Bifidobacterium longum, Akkermansia muciniphila的高丰度）和较高多样性与ICIs治疗的良好临床响应（延长PFS/OS）相关。同时指出Bacteroidales的高丰度与非响应相关。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持“肠道微生物组特征可预测免疫治疗疗效”的观点，列举具体有益菌和有害菌作为证据。\"\n          },\n          {\n            \"boundaries\": \"仅两项研究涉及此方面，且主要针对CTLA-4抑制剂，推广至其他ICI需谨慎。\",\n            \"contribution\": \"揭示了肠道微生物组与免疫治疗不良反应（特别是结肠炎）的联系。低Bacteroidetes丰度与CTLA-4诱导的结肠炎风险增加相关。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于说明微生物组不仅影响疗效，还影响安全性/耐受性，可作为全面评估免疫治疗预后的维度。\"\n          },\n          {\n            \"boundaries\": \"样本量极小，仅为概念验证性质。供体和受体间的个体差异、预处理抗生素的使用等因素可能影响结果。尚未阐明具体的分子机制或关键菌株。\",\n            \"contribution\": \"通过FMT临床试验（Baruch et al., Davar et al.）展示了从响应者向难治者移植微生物组可恢复部分患者的治疗响应，并观察到CD8+ T细胞激活增加和IL-8表达髓系细胞减少。这为微生物组介导免疫治疗效应的因果假设提供了最强的临床间接证据。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于论证微生物组在介导免疫治疗效应中的潜在因果作用，以及通过微生物组调节（如FMT）改善预后的可能性。\"\n          },\n          {\n            \"boundaries\": \"主要是相关性观察，未详细区分抗生素种类、使用时机及具体影响的菌群通路。\",\n            \"contribution\": \"指出抗生素使用（尤其是ICIs期间）与较差的PFS和OS相关，提示抗生素引起的菌群失调可能是导致免疫治疗耐药的一个因素。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于解释环境因素（如抗生素）如何通过改变微生物组进而影响治疗机制，补充机制部分的背景。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"用于阐述当前领域从基础机制研究向临床转化过渡的现状与挑战，强调本综述关注临床数据的必要性。\",\n            \"material\": \"综述指出目前尚无基于临床证据的指南来利用微生物组指导免疫治疗，且既往综述多包含动物模型，导致临床应用存在差距。\",\n            \"purpose\": \"背景与现状概述\"\n          },\n          {\n            \"connection_to_review\": \"用于讨论当前证据等级的局限性，并为未来需要标准化、大规模RCT研究提供依据。\",\n            \"material\": \"提到现有研究在测序方法（16S vs 宏基因组）、样本采集时间点上的异质性，以及缺乏标准化的偏倚评估工具。\",\n            \"purpose\": \"方法论局限性与未来方向\"\n          },\n          {\n            \"connection_to_review\": \"可用于分析微生物组-宿主互作是否具有癌症类型特异性，还是存在通用的“响应型”菌群特征。\",\n            \"material\": \"汇总了黑色素瘤、HCC、NSCLC中不同的优势菌种（如黑色素瘤中Faecalibacterium，HCC中Akkermansia/Ruminococcaceae，NSCLC中Akkermansia/Alistipes）。\",\n            \"purpose\": \"对比不同癌症类型的微生物组特征\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该综述仅纳入临床研究，排除了动物实验，因此其关于机制的解释（如T细胞激活）主要基于人类临床样本的相关性或FMT后的表型变化，而非直接的分子通路解析。\",\n          \"发现的菌群与疗效的关联多为观察性结果，存在混杂因素（如饮食、生活方式、合并用药），不能直接视为因果证据，除非有FMT等干预性研究的支持。\",\n          \"不同研究间使用的测序区域（V3-V4, V4, V4-V5）和分析方法不同，导致具体菌种鉴定可能存在偏差，比较时需考虑技术异质性。\",\n          \"FMT研究样本量极小（n=10, n=15），结果仅代表初步安全性和可行性，不能代表普遍疗效。\"\n        ],\n        \"topic_handles\": [\n          \"肠道微生物组多样性（Alpha/Beta diversity）\",\n          \"特定菌属丰度（Fecalibacterium, Bifidobacterium, Akkermansia, Bacteroides）\",\n          \"免疫检查点抑制剂（ICIs）疗效（PFS, OS, Response Rate）\",\n          \"免疫相关不良事件（irAEs, Colitis）\",\n          \"粪菌移植（FMT）干预\",\n          \"抗生素使用对微生物组及疗效的影响\"\n        ]\n      },\n      \"supplement_materials\": [\n        {\n          \"auxiliary_material\": \"The review details methodological heterogeneity across the included studies, such as variations in sequencing regions (V3-V4, V4, V4-V5), sample collection times, and cancer types, which complicates direct comparison. It also notes that only two studies examined gastrointestinal toxicity (colitis), finding low Bacteroidetes abundance associated with higher risk. The authors mention that while FMT response rates in these small studies are comparable to RCTs for Clostridioides difficile infection, the cancer FMT studies themselves are described as 'breakthrough clinical studies' rather than large-scale Phase III trials. The review excludes animal models to focus on clinical applicability but acknowledges that most included studies are observational (retrospective or prospective cohorts) rather than randomized interventions.\",\n          \"evidence\": [],\n          \"gap_id\": \"phase_iii_rct_evidence\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\level2\\\\external\\\\N48436b3aa73aea86f35f-f45b87be8e30256e\\\\round_1\\\\supplements\\\\phase_iii_rct_evidence\\\\attempt-c7j_i2fn\\\\source_units\\\\SU03_search_candidate_2d56a11919\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action\": \"Use this material to characterize the current evidence landscape as primarily observational with emerging but limited interventional data. Cite the authors' explicit statement that well-designed RCTs are still required to establish causality and clinical guidelines. Use the details of the Baruch and Davar studies to illustrate the proof-of-concept stage of FMT in oncology, contrasting their small sample sizes and specific indication (refractory melanoma) against the gap's requirement for large-scale Phase III trials in solid tumors. This supports the conclusion that the gap remains unresolved due to the immaturity of interventional trial data.\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"The specific evidence requested—completed large-scale randomized controlled Phase III clinical trials confirming microbiome intervention (FMT) efficacy in ICI-treated solid tumors—is not present in this material. The available FMT data is limited to small-sample (n=10, n=15), early-phase studies restricted to refractory melanoma, not broad solid tumors. The authors' call for future robust RCTs and multicentre trials indicates that such Phase III evidence does not yet exist or was not captured in this review (search up to March 2021).\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"This study is a clinical review analyzing 10 studies (total n=467 patients) regarding the gut microbiome and immune checkpoint inhibitor (ICI) outcomes in solid tumors (melanoma, HCC, NSCLC, RCC). It reports that baseline microbiome diversity and composition (e.g., enrichment of Faecalibacterium, Akkermansia, Bifidobacterium) are associated with improved progression-free survival (PFS) and overall survival (OS), while Bacteroidales abundance often correlates with non-response. Crucially for the gap, the authors highlight two FMT clinical studies (Baruch et al., n=10; Davar et al., n=15) in anti-PD-1 refractory metastatic melanoma. These studies demonstrated safety and potential efficacy (30-40% response rate) when combining FMT from responders with ICI re-challenge. However, the authors explicitly state that 'further well-designed RCTs are required to explore the causal effects' and that 'future international multicentre trials will be required to provide comprehensive and reliable data.' They note that up-to-date practice guidelines based on clinical evidence are not yet available.\"\n        }\n      ],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0273\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\759b176490dcac135bff0b645dc106c3df8f4059\\\\c3429e894a9546214bd063ce941ed466\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-403bce67afb0fdb07c1f\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\759b176490dcac135bff0b645dc106c3df8f4059\\\\c3429e894a9546214bd063ce941ed466\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0417\",\n      \"title\": \"Impact of the gut microbiome on immune checkpoint inhibitor efficacy-a systematic review.\",\n      \"year\": \"2019\",\n      \"doi\": \"10.3747/co.26.5177\",\n      \"paper_id\": \"b6efedbc1ffd0d54c8ed8ce3eb0a38c148e45450\",\n      \"material_depth\": \"\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0417\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\b6efedbc1ffd0d54c8ed8ce3eb0a38c148e45450\\\\aab60b62006cb6c9d5403e0993070595\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"study_summary_A\": {\n        \"approach\": \"遵循PRISMA指南进行系统综述。在Medline数据库中搜索“cancer immunotherapy”或“immune checkpoint inhibitors”与“microbiome”、“probiotic”、“antibiotic”、“dysbiosis”的组合词。纳入标准为英语或法语出版物，描述可量化的微生物组组成/修饰与ICI反应或irAEs之间的联系。排除综述、评论和专家意见（但筛查其参考文献）。数据提取变量包括患者数量、ICI类型、癌症类型、微生物组评估方法、干预措施及量化效应。未进行定量合成（Meta分析），而是进行定性综合。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了截至2018年底关于肠道微生物组如何影响ICI疗效和毒性的临床证据的综合视图。确认了抗生素使用的负面影响，并指出了特定微生物特征（如多样性、特定菌属比例）与疗效的潜在联系。\",\n            \"limits\": \"仅检索Medline数据库，可能遗漏其他来源的研究。纳入的研究多为回顾性、样本量小且异质性高，缺乏前瞻性试验数据。未能确定具体的因果机制，且无法精确定义抗生素暴露的最佳时间窗口或优先避免的抗生素类别。所给摘要未交代具体的统计学检验细节及偏倚风险评估过程。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"实体瘤患者（NSCLC, RCC为主），接受ICI治疗前后使用抗生素（ABt组 vs ABn组）\",\n            \"finding\": \"抗生素使用与较低的ICI疗效相关。在RCC患者中，抗生素显著缩短PFS和OS，降低ORR；在NSCLC患者中，抗生素显著降低OS，但对PFS和ORR的影响不一致或无显著差异。\"\n          },\n          {\n            \"conditions\": \"不同癌症类型（黑色素瘤、NSCLC、RCC、SCCHN），基线粪便或唾液样本\",\n            \"finding\": \"微生物组组成与ICI疗效存在显著关联，但具体细菌物种在不同研究中不一致（如Bifidobacterium longum, Akkermansia muciniphila, Ruminococcaceae等）。高细菌多样性和“响应者相关”细菌与“非响应者相关”细菌的良好比例似乎与更好的患者预后相关。口腔微生物组与ICI疗效无明显关联。\"\n          },\n          {\n            \"conditions\": \"黑色素瘤患者，接受Ipilimumab治疗\",\n            \"finding\": \"微生物组组成与irAEs（特别是结肠炎）的发生相关。某些细菌（如Faecalibacterium prausnitzii）的高丰度与结肠炎风险增加相关，而其他细菌（如Bacteroidetes）的高丰度则与低发生率相关。\"\n          },\n          {\n            \"conditions\": \"ICI诱导的难治性结肠炎患者\",\n            \"finding\": \"在两例个案报告中，粪便微生物群移植（FMT）成功缓解了ICI相关的结肠炎症状。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管前体模型显示肠道微生物组显著影响ICI疗效，但在临床实践中这种相互作用尚不清楚。本研究试图确定：(1)抗生素是否影响ICI疗效；(2)基线微生物组组成是否与ICI疗效相关；(3)基线微生物组组成是否与irAEs发生相关；(4)微生物组操纵是否能减轻irAEs。\",\n        \"research_scope\": \"人类实体瘤患者（主要为非小细胞肺癌、肾细胞癌、黑色素瘤等）接受免疫检查点抑制剂（ICIs，包括抗CTLA-4、抗PD-1和抗PD-L1抗体）治疗期间，肠道微生物组（GM）及其修饰（如抗生素使用、粪便微生物群移植FMT）对ICI疗效及免疫相关不良事件（irAEs）的影响。\",\n        \"work_summary\": \"这是一篇2019年发表的系统综述，旨在评估临床实践中肠道微生物组与免疫检查点抑制剂疗效之间的关联。作者通过Medline检索，筛选出13项符合纳入标准的人类研究（包括全文文章和摘要），分别分析了抗生素使用对ICI疗效的影响、基线微生物组组成与ICI疗效的相关性、以及微生物组组成与irAEs（特别是结肠炎）的相关性。研究发现抗生素使用普遍与ICI疗效降低相关，而特定的微生物组成或多样性与更好的临床结局有关；此外，FMT在个别案例中显示出缓解ICI诱导的结肠炎的潜力。\"\n      },\n      \"review_planning_B\": {\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供临床实践中的管理建议背景：避免在使用ICI期间使用抗生素。\",\n            \"material\": \"综述结论建议尽可能避免在ICI治疗前或使用期间使用抗生素，因为其对ICI抗癌疗效有负面影响。\",\n            \"purpose\": \"作为临床干预策略的背景信息，说明当前临床决策中考虑微生物组因素的紧迫性。\"\n          },\n          {\n            \"connection_to_review\": \"介绍FMT作为潜在治疗手段的现状。\",\n            \"material\": \"FMT在动物模型中恢复ICI疗效并减少结肠炎，在人类个案中成功缓解难治性结肠炎，但尚无改善ICI疗效的人体数据。\",\n            \"purpose\": \"作为未来研究方向和潜在干预措施的例子，展示从微生物组调控角度改善治疗结果的潜力。\"\n          },\n          {\n            \"connection_to_review\": \"区分口腔与肠道微生物组的作用。\",\n            \"material\": \"口腔微生物组与ICI疗效无明显关联，而肠道微生物组有显著关联。\",\n            \"purpose\": \"明确研究对象范围，强调肠道微生物组在ICI疗效中的特异性作用，排除口腔微生物组的干扰。\"\n          }\n        ],\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"相关性不等于因果性；具体菌种的预测价值在不同研究中存在冲突，不能直接确立单一通用生物标志物。样本量较小，多为回顾性研究。\",\n            \"contribution\": \"提供了抗生素使用与ICI疗效降低之间关联的多项临床研究汇总，包括ORR、PFS和OS的具体变化趋势。同时列举了不同癌症类型中微生物组组成与疗效关联的具体菌种（如Akkermansia muciniphila, Bifidobacterium等），尽管这些菌种在不同研究中不一致。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物组如何调节ICI疗效”中的现象学部分，即哪些因素（抗生素、特定菌群）与疗效正负相关。可用于对比不同研究中预测标志物的异质性。\"\n          },\n          {\n            \"boundaries\": \"这些主要是基于动物模型或观察性数据的推测，文中明确指出人类患者中尚未进行类似的机制验证研究。无法直接证明具体的分子机制路径。\",\n            \"contribution\": \"讨论了抗生素可能通过改变微生物组选择不利菌种、或通过抗生素本身的抗炎特性（如降低促炎细胞因子、减少T细胞反应）来拮抗ICI疗效的潜在机制。指出微生物组与irAEs（结肠炎）的关联可能反映了ICI疗效与免疫介导毒性之间的正相关（表型伴随现象）。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"为解释“机制”提供理论假设和间接证据。特别是关于抗生素非特异性抗炎作用的讨论，以及微生物组介导的免疫激活导致疗效和毒性并存的假说。\"\n          }\n        ],\n        \"planning_summary\": \"该综述为理解肠道微生物组对ICI疗效的双向调节作用提供了关键的临床背景素材。它汇总了抗生素作为负面调节因子的证据，以及特定微生物特征作为疗效预测指标的初步发现。对于综述而言，此文有助于构建“微生物组-免疫疗法相互作用”的临床现状图景，特别是关于抗生素干扰和微生物组成预测价值的讨论，可作为机制探讨前的现象学基础。\",\n        \"scope_interpretation_cautions\": [\n          \"该综述主要涵盖实体瘤，特别是NSCLC、RCC和黑色素瘤，结果可能不适用于血液肿瘤或其他类型癌症。\",\n          \"关于特定细菌物种与疗效的关联在不同研究中存在不一致，这可能与检测方法、人群特征和医疗史差异有关，需谨慎解读单一菌种的预测价值。\",\n          \"抗生素的影响可能是多方面的（微生物组改变+直接抗炎作用），综述未区分具体抗生素种类的影响差异，仅指出广谱抗生素影响更显著。\",\n          \"FMT在缓解irAEs中的效果仅基于个案报告，不能推广为常规治疗建议。\"\n        ],\n        \"topic_handles\": [\n          \"抗生素对ICI疗效的负面影响\",\n          \"基线微生物组组成与ICI疗效的相关性\",\n          \"微生物组多样性与临床预后的关系\",\n          \"微生物组组成与irAEs（结肠炎）的关联\",\n          \"粪便微生物群移植（FMT）在缓解irAEs中的应用\"\n        ]\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"kind\": \"identity\",\n            \"reason\": \"source identity was not independently verified\",\n            \"status\": \"input_attributed\"\n          },\n          {\n            \"kind\": \"pdf\",\n            \"reason\": \"full-page text extracted; page positions retained\",\n            \"status\": \"fitz\"\n          },\n          {\n            \"kind\": \"fitz\",\n            \"reason\": \"layout, table relations, formulas, figure pixels, and scanned text may be lost\",\n            \"status\": \"known_gap\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\b6efedbc1ffd0d54c8ed8ce3eb0a38c148e45450\\\\aab60b62006cb6c9d5403e0993070595\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0148\",\n      \"title\": \"Response to immune checkpoint inhibition is associated with the gut microbiome in advanced KRAS-mutated non-small cell lung cancer\",\n      \"year\": \"2023\",\n      \"doi\": \"10.1101/2023.10.30.23297712\",\n      \"paper_id\": \"42b8755a18f7ff2ebb90765b502a37b6f6e868e5\",\n      \"material_depth\": \"\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0148\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\42b8755a18f7ff2ebb90765b502a37b6f6e868e5\\\\51a215242479c34d622b6d11c5525875\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"study_summary_A\": {\n        \"approach\": \"Observational cohort study. 1. Participant selection: 40 recruited, 33 eligible (KRAS-mutated NSCLC, baseline stool collected). 2. Sequencing: Shotgun metagenomics (Illumina HiSeq 2000). 3. Processing: KneadData for host removal, HUMAnN3 for functional profiles, MetaPhlAn3 for taxonomy. Normalization via arcsine square-root (taxa) and log (pathways). 4. Statistical Analysis: Shannon index for alpha-diversity; PCA on clr-transformed data for beta-diversity; PERMANOVA for variance explanation; Bayesian logistic-normal linear regression (Pibble model) to identify differential abundance of species/pathways associated with DCR, PFS12, and irAEs, adjusting for covariates. Credible intervals used for significance (75% and 90%).\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"First study to profile the gut microbiome exclusively in KRAS-mutated NSCLC patients treated with ICI. Identifies specific microbial signatures (SCFA-producers, Akkermansia) overlapping with findings in other tumor types (melanoma, RCC), suggesting potential tumor-independent mechanisms.\",\n            \"limits\": \"Small sample size (n=33), single time-point (baseline only), limited statistical power (wide credible intervals for some associations like Akkermansia). Cannot establish causality. Regional/methodological differences may limit generalizability compared to larger multi-center cohorts.\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"Responders (DCR/PFS12) vs Non-responders\",\n            \"finding\": \"No significant difference in alpha or beta diversity. Responders enriched in SCFA-producing species (Agathobaculum butyriciproducens, Clostridium leptum, Bifidobacterium longum, Eubacterium ramulus, Fusicatenibacter saccharivorans) and Akkermansia muciniphila (wider CI). Responders also showed higher abundance of pro-inflammatory pathways (LPS, heme synthesis). Non-responders enriched in Bacteroides spp. and Blautia genus.\"\n          },\n          {\n            \"conditions\": \"Patients with irAEs vs Patients without irAEs\",\n            \"finding\": \"No diversity differences. Patients unaffected by irAEs enriched in biotin and SCFA synthesis pathways. Patients developing irAEs enriched in Alistipes finegoldii, Bifidobacterium longum, and Bacteroides uniformis, and amino acid synthesis pathways.\"\n          },\n          {\n            \"conditions\": \"Covariate analysis (PERMANOVA)\",\n            \"finding\": \"Metastatic disease stage and sex explained most variation in species composition. Response, ICI regimen, stage, and age explained 4-6% of pathway variation, but none reached statistical significance.\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"To determine if the gut microbiome composition and function are associated with response to anti-PD-1 immunotherapy and the development of irAEs specifically in patients with KRAS-mutated NSCLC, a population where such associations have not been previously established.\",\n        \"research_scope\": \"Advanced KRAS-mutated non-small cell lung cancer (NSCLC) patients treated with anti-PD-1 immune checkpoint inhibitors (ICI). Cohort: 33 patients, baseline stool samples only.\",\n        \"work_summary\": \"This study investigates the association between the gut microbiome and clinical outcomes in a homogeneous cohort of advanced KRAS-mutated NSCLC patients receiving ICI therapy. The authors performed shotgun metagenomic sequencing on baseline stool samples to analyze microbial composition and functional pathways. They compared responders versus non-responders (defined by DCR and PFS12) and patients with vs. without immune-related adverse events (irAEs), adjusting for confounders like ICI regimen, metastatic stage, age, sex, and BMI. The study found no differences in overall alpha or beta diversity but identified specific species and metabolic pathways differentially abundant between groups.\"\n      },\n      \"review_planning_B\": {\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"Useful for a section discussing why microbiome biomarkers may vary across populations and the need for standardized methodologies or large multi-center validation.\",\n            \"material\": \"Discussion compares findings with studies from China, Japan, and other European cohorts, noting differences in associated species (e.g., Bacteroides massiliensis in Chinese cohort vs. Bacteroides in this cohort). Attributes differences to diet, geography, and methodological factors.\",\n            \"purpose\": \"Contextualize regional/methodological heterogeneity in microbiome studies.\"\n          },\n          {\n            \"connection_to_review\": \"Supports the argument that microbiome effects might be modified by host genetics or tumor genotype, necessitating stratified analyses in future reviews.\",\n            \"material\": \"Focuses exclusively on KRAS-mutated NSCLC, a subgroup with poor prognosis and heterogeneous response to standard therapies.\",\n            \"purpose\": \"Highlight the importance of genetic subgroups in NSCLC.\"\n          }\n        ],\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"Study is limited to KRAS-mutated NSCLC. Sample size is small (n=33). Associations are observational. Some findings (e.g., Akkermansia) did not reach high statistical confidence (90% BCL) due to sample size.\",\n            \"contribution\": \"Identifies specific microbial features associated with ICI response in KRAS-mutated NSCLC: enrichment of SCFA-producing species (e.g., Agathobaculum, Bifidobacterium) and Akkermansia in responders; enrichment of Bacteroides/Blautia in non-responders.\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"Can be used as evidence for the association between beneficial microbes (SCFA producers) and improved ICI efficacy in solid tumors. Supports the hypothesis that certain microbial signatures predict response across different cancer types.\"\n          },\n          {\n            \"boundaries\": \"Pathway-level inference from metagenomics. Causality of these pathways in driving response is not established.\",\n            \"contribution\": \"Reports that responders also had higher abundance of pro-inflammatory pathways (LPS, heme synthesis), challenging the notion that only 'healthy' microbiomes predict response.\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"Useful for discussing the complexity of microbial mechanisms in ICI response, indicating that inflammatory signals may also be part of the effective anti-tumor immune activation.\"\n          },\n          {\n            \"boundaries\": \"Mechanisms are inferred from correlation. Direct causal links between specific bacterial metabolites and immune checkpoint blockade efficacy are not demonstrated in this study.\",\n            \"contribution\": \"Suggests potential mechanisms involving fiber fermentation (SCFA production) and vitamin synthesis (biotin) as mediators of ICI efficacy and protection from irAEs.\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"Provides mechanistic hypotheses (dietary fiber -> SCFA -> enhanced immunity) that can be discussed in the context of how the microbiome modulates ICI efficacy.\"\n          },\n          {\n            \"boundaries\": \"Cross-sectional association at baseline. Does not prove these microbes cause irAEs.\",\n            \"contribution\": \"Associates irAE development with specific microbes (Alistipes, Bifidobacterium, Bacteroides uniformis) and amino acid synthesis pathways.\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"Helps explore the link between microbiome and immune toxicity (irAEs), which is a key aspect of ICI modulation. May inform strategies to manage side effects.\"\n          }\n        ],\n        \"planning_summary\": \"Provides empirical evidence linking specific gut microbial taxa (SCFA producers, Akkermansia) and pathways to ICI response in KRAS-mutated NSCLC. Offers a comparative perspective on whether microbial biomarkers are tumor-type specific or universal, and highlights the complexity of 'pro-inflammatory' vs 'health-associated' signatures in responders.\",\n        \"scope_interpretation_cautions\": [\n          \"The study is observational; associations do not imply causation.\",\n          \"Small sample size limits statistical power and generalizability.\",\n          \"Single time-point sampling cannot capture dynamic changes in the microbiome during treatment.\",\n          \"Findings are specific to KRAS-mutated NSCLC; extrapolation to other NSCLC subtypes or cancers requires caution, although overlaps with other tumor types are noted.\"\n        ],\n        \"topic_handles\": [\n          \"KRAS-mutated NSCLC\",\n          \"Anti-PD-1 Immunotherapy\",\n          \"Gut Microbiome Composition\",\n          \"Short Chain Fatty Acid (SCFA) Producers\",\n          \"Akkermansia muciniphila\",\n          \"Bacteroides/Blautia Genus\",\n          \"Immune-related Adverse Events (irAEs)\",\n          \"Metabolic Pathways (Biotin, LPS, Heme)\"\n        ]\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-8a2eafa351c193b6e72f\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\42b8755a18f7ff2ebb90765b502a37b6f6e868e5\\\\51a215242479c34d622b6d11c5525875\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0474\",\n      \"title\": \"Tumor microenvironment-mediated resistance to immune checkpoint inhibitors in non-small cell lung cancer: Mechanisms, combination strategies and clinical perspectives (Review)\",\n      \"year\": \"2026\",\n      \"doi\": \"10.3892/mco.2026.2971\",\n      \"paper_id\": \"d227bde3dc62e02cfe87a58fa5173e149048ed4e\",\n      \"material_depth\": \"\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0474\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\d227bde3dc62e02cfe87a58fa5173e149048ed4e\\\\627d038304660198900f99576a1ce6c8\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"study_summary_A\": {\n        \"approach\": \"采用叙事性文献回顾方法。检索PubMed索引的英文出版物（1946-2026年）、主要肿瘤学指南、关键II/III期临床试验、荟萃分析及机制研究。检索词涵盖NSCLC、ICI、TME、耐药及相关分子靶点。对临床证据按试验阶段、人群相关性、终点成熟度及监管意义进行加权；对临床前和假设生成性研究主要用于支持机制概念。通过分类归纳TME组成、分子通路、物理化学抑制因素及系统性因素，构建耐药机制框架，并据此评估不同组合疗法的临床转化潜力。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了NSCLC中TME介导耐药的整合性框架，强调从孤立因素转向相互连接的生物学过程视角；明确了不同联合疗法（免疫-免疫、免疫-抗血管、免疫-放化疗、免疫-靶向）的临床证据层级和适用情境。\",\n            \"limits\": \"作为叙事性综述，其结论依赖于作者对纳入文献的选择和解释；未提供新的原始实验数据；部分机制（如微生物组干预）仅基于初步研究，缺乏大规模临床验证；特定生物标志物（如ctDNA阈值）尚待标准化。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"TME细胞成分异质性\",\n            \"finding\": \"巨噬细胞并非简单的M1/M2二元模型，而是存在激活状态的连续谱系；MDSCs亚型特异性功能不同（单核型通过ARG1/iNOS抑制，多形核型通过ROS抑制）；CAF和ECM重塑通过增加间质硬度促进免疫排斥。\"\n          },\n          {\n            \"conditions\": \"内在肿瘤机制\",\n            \"finding\": \"STK11缺失抑制I型干扰素信号，KEAP1缺失激活抗氧化程序，两者共同导致低PD-L1表达和低CD8+ T细胞浸润；EGFR/ALK驱动突变通常伴随低TMB和不活跃的免疫微环境。\"\n          },\n          {\n            \"conditions\": \"联合治疗证据等级\",\n            \"finding\": \"纳武利尤单抗+伊匹木单抗在CheckMate 227中显示疗效（受PD-L1/TMB影响）；阿替利珠单抗+贝伐珠单抗+化疗在IMpower150中证实对转移性非鳞状NSCLC有效，包括肝转移和EGFR突变TKI失败后人群；LAG-3/TIM-3抑制剂在NSCLC中的临床采纳仍需成熟试验确认。\"\n          },\n          {\n            \"conditions\": \"生物标志物应用\",\n            \"finding\": \"PD-L1检测存在空间异质性和平台间不完全互换性；高TMB预测价值受测序平台和肿瘤纯度影响；空间转录组学可区分免疫表型；液体活检（ctDNA/exosome）需前瞻性验证阈值。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"解决NSCLC中ICI原发性和获得性耐药限制长期临床获益的问题；阐明TME各组分如何协同导致不同免疫表型，并厘清当前联合治疗策略的证据等级与局限性。\",\n        \"research_scope\": \"非小细胞肺癌（NSCLC）患者中，肿瘤微环境（TME）介导的免疫检查点抑制剂（ICI）耐药机制、联合治疗策略及生物标志物框架。\",\n        \"work_summary\": \"本文是一篇叙事性综述，旨在将TME介导的ICI耐药视为一个相互连接的生物学过程，而非孤立因素的集合。文章系统梳理了免疫抑制细胞群、基质重塑、血管功能障碍、缺氧、代谢重编程以及抗原呈递缺陷和致癌驱动信号如何协同作用，形成免疫沙漠、免疫排斥或耗竭性炎症表型。在此基础上，综述评估了针对这些机制的联合治疗策略，区分了III期支持的临床标准与早期探索性方法，并提出了整合PD-L1、TMB、干扰素γ特征、空间组学、ctDNA等指标的操作化生物标志物框架，以指导NSCLC的精准免疫治疗。\"\n      },\n      \"review_planning_B\": {\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"作为背景材料，帮助读者理解肠道微生物组只是影响ICI疗效的众多系统性因素之一，且其作用受到肿瘤类型和局部微环境的制约。\",\n            \"material\": \"介绍了NSCLC中ICI耐药的多维度机制，包括内在肿瘤基因改变、局部TME抑制和系统性因素。\",\n            \"purpose\": \"提供NSCLC中ICI治疗的临床背景和耐药复杂性，说明为何单一靶点治疗往往失败，从而引出多因素（包括微生物组）调控的重要性。\"\n          },\n          {\n            \"connection_to_review\": \"在评估微生物组 biomarker 的价值时，可作为参照系，说明新型生物标志物面临的挑战（如标准化、验证），并提示未来可能需要多组学整合模型。\",\n            \"material\": \"讨论了PD-L1、TMB、空间组学和液体活检等生物标志物的现状、局限性和整合需求。\",\n            \"purpose\": \"提供关于生物标志物和患者分层的信息，特别是当讨论微生物组作为预测因子时，需要与其他已知生物标志物（如PD-L1, TMB）进行比较和整合。\"\n          },\n          {\n            \"connection_to_review\": \"明确指出微生物组相关干预目前仍处于“有强烈机制吸引力但需要前瞻性临床验证”的阶段，避免将其过度解读为已确立的标准治疗。\",\n            \"material\": \"区分了III期支持的联合疗法（如双免疫、免疫+抗血管）与早期探索性疗法（如微生物组调节、IDO抑制）。\",\n            \"purpose\": \"提供关于联合治疗策略的证据分级，帮助判断基于微生物组的干预措施在当前临床实践中的地位。\"\n          }\n        ],\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅限NSCLC人群；关联多为观察性，因果机制未详述；Fusobacterium的作用在其他癌种更明确，此处仅为对比提示。\",\n            \"contribution\": \"提供了NSCLC队列中与ICI疗效相关的特定肠道微生物菌群信息：Akkermansia muciniphila、Bifidobacterium spp. 和 Ruminococcus 被报道有助于促进有利的免疫微环境；而 Fusobacterium 的关联在结直肠癌中更强，在NSCLC中需谨慎外推。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物组如何调节ICI疗效”的具体实例，展示有益菌和潜在有害菌在NSCLC中的不同表现。\"\n          },\n          {\n            \"boundaries\": \"机制描述较为概括，未深入具体的微生物-宿主分子互作细节；主要基于综述转述的其他研究结果；强调需要前瞻性验证。\",\n            \"contribution\": \"阐述了系统性因素（包括微生物组、营养状态、全身炎症）如何作为TME介导耐药的一部分影响ICI疗效。指出微生物组特征可能通过塑造有利的免疫微环境来增强ICI反应，但同时也强调了这种关联需要NSCLC特异性数据集的支持，且目前微生物组干预（如FMT、益生菌）仍属探索性阶段，缺乏标准化评估和安全监测。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于解释微生物组影响ICI疗效的系统性背景机制，以及当前干预手段的局限性。帮助区分已观察到的关联与尚未验证的因果机制。\"\n          }\n        ],\n        \"planning_summary\": \"该综述为理解Gut Microbiome如何影响ICI疗效提供了关键的宿主背景框架。虽然其主要焦点是NSCLC的TME，但它详细阐述了系统性因素（包括肠道微生物组）与局部TME及ICI疗效之间的关联，并指出了当前研究的局限性和未来方向。对于综述而言，它提供了关于微生物组在NSCLC中具体菌种作用的实证数据，以及关于系统性炎症和营养状态如何调节免疫应答的背景知识，同时强调了需要疾病特异性验证的重要性。\",\n        \"scope_interpretation_cautions\": [\n          \"该综述聚焦于NSCLC，其关于微生物组的发现不能直接外推到所有实体瘤或其他癌症类型，尽管文中提到了结直肠癌的对比。\",\n          \"文中提到的微生物组与ICI疗效的关联主要基于观察性研究和初步数据，因果关系尚未完全确立，干预效果也未经验证。\",\n          \"综述本身是叙事性的，其结论依赖于作者对文献的选择和综合，可能存在选择偏倚。\",\n          \"对于Fusobacterium等菌种，文中明确指出其在NSCLC中的作用不如在结直肠癌中明确，需谨慎解读。\"\n        ],\n        \"topic_handles\": [\n          \"NSCLC肿瘤微环境（TME）\",\n          \"免疫检查点抑制剂（ICI）耐药机制\",\n          \"肠道微生物组（Gut Microbiome）与ICI疗效\",\n          \"系统性炎症与宿主状态\",\n          \"联合治疗策略证据分级\",\n          \"生物标志物框架（PD-L1, TMB, Spatial Omics, ctDNA）\"\n        ]\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\d227bde3dc62e02cfe87a58fa5173e149048ed4e\\\\627d038304660198900f99576a1ce6c8\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0271\",\n      \"title\": \"The role of the gut microbiome on the efficacy of immune checkpoint inhibitors in Japanese responder patients with advanced non-small cell lung cancer.\",\n      \"year\": \"2019\",\n      \"doi\": \"10.21037/tlcr.2019.10.23\",\n      \"paper_id\": \"753e796b9f6fe2fe78f1b4c6074d39441710eda7\",\n      \"material_depth\": \"\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0271\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\753e796b9f6fe2fe78f1b4c6074d39441710eda7\\\\5a16b2ba1f3b6771b60cbdbf52912ac1\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"study_summary_A\": {\n        \"approach\": \"采用回顾性队列设计。纳入标准为确诊为晚期NSCLC、接受ICI治疗时长>3个月的日本患者。收集治疗期间的单次粪便样本，使用Illumina MiSeq平台对16S rRNA基因的V1-V2区域进行测序。利用QIIME流程进行OTU聚类（97%相似度）和Alpha多样性分析。使用LEfSe算法识别反应者与非反应者之间显著差异的分类群。临床结局以治疗失败时间（TTF）为主要终点，使用Kaplan-Meier法和Log-rank检验分析特定细菌属的高/低丰度与TTF的关系。PD-L1表达通过商业实验室的22C3 pharmDx检测进行评估。统计使用EZR软件，P<0.05视为显著。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"在亚洲（日本）NSCLC人群中，初步识别出与ICI疗效相关的特定肠道细菌属（如Lactobacillus, Clostridium, Bilophila等），提供了微生物组作为潜在疗效生物标志物的观察性证据。\",\n            \"limits\": \"样本量极小（仅17例），存在选择偏倚（仅纳入治疗>3个月的患者，可能排除早期进展或不耐受者）；单中心回顾性研究；仅采集单次粪便样本，无法反映治疗前后菌群动态变化；未控制抗生素使用等混杂因素的具体细节（虽记录但未深入校正）；部分关键图表不可读，具体统计细节受限。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"对比ICI反应者（n=6）与非反应者（n=11）的肠道菌群组成\",\n            \"finding\": \"反应者的肠道菌群中乳酸杆菌（Lactobacillus）、梭菌属（Clostridium）和Syntrophococcus显著富集；非反应者中Bilophila、Sutterella和Parabacteroides显著富集。\"\n          },\n          {\n            \"conditions\": \"特定细菌属丰度与治疗失败时间（TTF）的关系\",\n            \"finding\": \"高丰度的Bilophila与显著延长的TTF相关（HR 6.27, P=0.0037）。高丰度的Lactobacillus和Clostridium倾向于延长TTF，但统计学上不显著（P分别为0.219和0.352）。Syntrophococcus高丰度也显示延长TTF的趋势（P=0.057）。Parabacteroides丰度与TTF无显著关联。\"\n          },\n          {\n            \"conditions\": \"肠道菌群Alpha多样性\",\n            \"finding\": \"反应者与非反应者之间的Alpha多样性无显著差异，且未影响TTF。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"在晚期NSCLC患者中，是否存在特定的肠道微生物组特征可以作为预测免疫检查点抑制剂（ICI）长期疗效的生物标志物？目前缺乏能够筛选出能从ICI中长期获益患者的强效生物标志物。\",\n        \"research_scope\": \"日本晚期非小细胞肺癌（NSCLC）患者，接受免疫检查点抑制剂（ICI）治疗超过3个月的人群。样本量为17例，分为反应者（R, n=6）和非反应者（NR, n=11）。\",\n        \"work_summary\": \"本研究旨在探讨肠道微生物组组成与晚期NSCLC患者对免疫检查点抑制剂（ICI）疗效之间的关联。研究回顾性分析了17名在日本京都府立医科大学接受ICI治疗且持续时间超过3个月的患者的粪便样本。通过16S rRNA基因测序分析肠道菌群多样性及物种丰度，并结合临床疗效数据（基于RECIST 1.1标准定义的响应状态及治疗失败时间TTF），比较了反应者与非反应者在肠道微生物组成上的差异，并评估特定细菌属的丰度与临床预后指标的相关性。\"\n      },\n      \"review_planning_B\": {\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供NSCLC这一特定实体瘤类型的微生物组数据，填补泛癌种综述中的瘤种特异性空白。\",\n            \"material\": \"日本NSCLC患者队列的微生物组构成数据及与TTF的关联。\",\n            \"purpose\": \"作为实体瘤中微生物组影响ICI疗效的一个具体案例，特别是强调亚洲人群的数据，有助于评估地域/种族对微生物组-疗效关系的潜在影响。\"\n          },\n          {\n            \"connection_to_review\": \"展示单一时间点采样方法的局限性。\",\n            \"material\": \"研究仅在治疗期间采集一次粪便样本，未评估基线或治疗前后的动态变化。\",\n            \"purpose\": \"在综述的方法学讨论部分，可用此为例说明单次采样可能无法捕捉微生物组的动态演变及其对免疫治疗反应的复杂影响，支持需要纵向研究设计的观点。\"\n          }\n        ],\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"样本量小（n=17），仅为观察性关联，不能确立因果关系。仅针对日本人群，外推至其他种族需谨慎。仅测量了治疗期间的单次样本，未涵盖基线或动态变化。部分关键细菌（如Lactobacillus）的关联未达到统计学显著性（P>0.05），仅表现为趋势。\",\n            \"contribution\": \"提供了在晚期NSCLC患者中，肠道菌群组成与ICI疗效关联的具体物种列表。发现反应者富集Lactobacillus, Clostridium, Syntrophococcus，而非反应者富集Bilophila, Sutterella, Parabacteroides。其中Bilophila高丰度与显著延长的TTF（即更好的疗效/更慢的疾病进展）相关，这与部分其他研究可能存在的负面关联形成对比或补充，提示需关注菌种特异性而非整体多样性。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于回答“肠道微生物组如何调节实体瘤中ICI的疗效”这一子问题。可作为证据说明某些特定细菌的存在与更好的临床结果（更长TTF）相关，或者相反，某些细菌与较差结果相关。可用于讨论不同研究中微生物组标志物不一致的原因（如人群差异、菌种特异性）。\"\n          },\n          {\n            \"boundaries\": \"这些机制解释主要基于作者引用的既往研究（如小鼠模型），并非本研究直接证实的因果机制。本研究本身未进行机制验证实验（如动物共接种、免疫表型分析等）。因此，这些内容应被视为“假说”或“背景知识”，而非本研究的实证发现。\",\n            \"contribution\": \"作者在讨论中提出了潜在的机制假设：Lactobacillus可能通过促进树突状细胞成熟和调节宿主免疫来增强T细胞动员；而Sutterella和Bilophila可能在肿瘤微环境中引发炎症，导致对ICI不敏感。此外，提到小鼠模型中Lactobacillus可抑制Bilophila诱导的炎症和肠屏障功能障碍。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于回答“介导该效应的机制是什么”这一子问题。虽然这是作者基于文献的推测而非本研究的直接实验验证，但它提供了将观察到的微生物组变化与已知免疫学机制联系起来的理论框架。可用于综述中讨论微生物组影响免疫治疗的潜在生物学通路（如DC成熟、T细胞浸润、炎症调控）。\"\n          }\n        ],\n        \"planning_summary\": \"该研究提供了关于肠道微生物组如何关联固体肿瘤（NSCLC）免疫治疗疗效的直接观察数据。其核心价值在于指出了特定细菌属（有益菌与有害菌）与临床预后（TTF）的方向性关联，尽管由于样本量限制，部分关联未达到统计学显著性。对于综述而言，它提供了具体的“菌-效应”对应关系素材，特别是关于Bilophila与较差预后的负向关联，以及Lactobacillus/Clostridium的正向趋势，可用于支持或反驳不同研究中微生物组对ICI疗效影响的异质性。\",\n        \"scope_interpretation_cautions\": [\n          \"该研究样本量极小（17例），统计效力不足，许多具有生物学意义的趋势（如Lactobacillus）未达到统计学显著性。解读时应避免夸大其确定性，应视为探索性证据。\",\n          \"研究对象仅限于日本NSCLC患者，且均为长期治疗者（>3个月），存在严重的选择偏倚（幸存者偏差）。结果可能不适用于早期治疗失败者或其他种族群体。\",\n          \"作者提出的机制（如Lactobacillus促进DC成熟）是基于文献综述的推测，本研究并未提供直接的分子或细胞水平证据。在综述中引用时，必须明确区分这是作者的假设还是本研究的实证结果。\",\n          \"Bilophila高丰度与延长TTF（更好疗效）的关联可能与部分其他研究报道的负面作用相反，这突显了微生物组研究的高度情境依赖性和潜在矛盾，需谨慎对待单一研究的结论。\"\n        ],\n        \"topic_handles\": [\n          \"gut microbiome composition in NSCLC\",\n          \"immune checkpoint inhibitor (ICI) efficacy biomarkers\",\n          \"Lactobacillus abundance and ICI response\",\n          \"Clostridium abundance and ICI response\",\n          \"Bilophila abundance and ICI resistance\",\n          \"Time to treatment failure (TTF) as clinical endpoint\",\n          \"Japanese population specificity in microbiome studies\"\n        ]\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-3aa25875e4222837763e\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\753e796b9f6fe2fe78f1b4c6074d39441710eda7\\\\5a16b2ba1f3b6771b60cbdbf52912ac1\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0578\",\n      \"title\": \"Safety and efficacy of fecal microbiota transplantation in solid cancers resistant to immune checkpoint inhibitors: results of the MITRIC trial\",\n      \"year\": \"2026\",\n      \"doi\": \"10.1136/jitc-2026-015122\",\n      \"paper_id\": \"d9577b3a29bd8aec60c9e27c6a56a63faf3f4a27\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"采用单臂、开放标签的IIa期篮子试验设计。纳入标准包括ICI治疗后疾病进展、ECOG评分0-1及可测量病灶。供体需为ICI长期响应者（>12个月响应）。干预措施包括基线后第1周和第5周通过结肠镜进行两次FMT，随后在第14、30、78周可通过灌肠进行最多三次补充FMT。ICI治疗保持不变或重新引入。主要终点评估安全性和ORR（基于iRECIST）。次要终点包括可行性、临床获益率、无进展生存期（PFS）、总生存期（OS）、微生物定植（16S rRNA测序）、免疫反应（质谱流式细胞术分析PBMCs）及生物标志物（血清细胞因子）。统计分析采用描述性统计、Kaplan-Meier生存分析及Cox比例风险模型探索免疫特征与预后的关联，未进行多重检验校正。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"证实了在ICI耐药的晚期实体瘤患者中，使用ICI响应者供体的FMT是安全和可行的。提供了关于FMT后微生物定植动力学（短暂性）和系统性免疫景观（髓系抑制与T细胞活化）的详细生物标志物数据。\",\n            \"limits\": \"样本量小（n=12），试验因入组缓慢提前终止。单臂设计无法确立因果关系，缺乏对照组。未能实现预期的临床疗效（无ORR），限制了对其机制解释的确定性。结果可能受到快速进展性疾病背景的影响，未能在足够长的时间内观察FMT的潜在延迟效应。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"12名ICI耐药晚期实体瘤患者，接受来自ICI响应者的FMT联合ICI治疗\",\n            \"finding\": \"FMT安全性良好，无严重FMT相关不良事件导致停药，但50%患者出现免疫相关不良事件（irAEs），多数为轻度。客观缓解率（ORR）为0%，中位PFS为1.5个月，中位OS为10.1个月。\"\n          },\n          {\n            \"conditions\": \"微生物组分析\",\n            \"finding\": \"首次FMT后一周，大多数受体的微生物组向供体方向偏移（定植成功），但这种相似性在后续时间点大多下降，表明定植多为暂时性。仅1名获得临床获益的患者实现了持久的供体-受体微生物相似性。\"\n          },\n          {\n            \"conditions\": \"免疫微环境分析\",\n            \"finding\": \"基线时高度分化的T细胞环境（CD8+效应记忆T细胞和TEMRA）与改善的PFS和OS相关；而髓系偏倚环境和幼稚T细胞表型预后较差。CD14+单核细胞和血清IL-8水平随时间增加，高水平的CD14+单核细胞与较短的PFS和OS相关。这些免疫特征与预后的关联在使用ICI治疗起始日期重新计算时依然成立，提示其反映的是宿主对免疫治疗的固有反应能力，而非FMT的直接因果效应。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"早期研究表明FMT可能逆转ICI耐药，但其适用性在其他肿瘤类型中尚不明确，且关于患者选择、供体选择及给药方案的问题仍未解决。本研究试图回答：在ICI耐药的晚期实体瘤患者中，重复FMT是否安全可行，以及是否能通过微生物定植和免疫重塑来恢复ICI的疗效。\",\n        \"research_scope\": \"针对晚期实体瘤（黑色素瘤、头颈部鳞癌、肾细胞癌、微卫星不稳定性高胰腺癌）中免疫检查点抑制剂（ICI）耐药或进展的患者，评估来自ICI长期响应者的粪菌移植（FMT）联合ICI治疗的安全性和有效性。\",\n        \"work_summary\": \"本研究是一项单臂IIa期篮子试验（MITRIC），旨在验证通过FMT调节肠道微生物群能否克服已建立的ICI耐药性。研究纳入了12名在转移性阶段对ICI治疗进展的患者，使用ICI长期响应者作为供体，给予患者最多五次FMT（前两次通过结肠镜，后续通过灌肠），并继续原有ICI治疗。主要终点为FMT相关不良事件和客观缓解率（ORR）。结果显示FMT安全性良好，但未能观察到客观肿瘤反应（ORR为0%），仅5名患者达到疾病稳定。尽管缺乏总体疗效证据，研究发现FMT诱导了短暂的微生物定植，且外周血中的免疫细胞特征（如分化T细胞与髓系细胞的平衡）与生存期显著相关，但这些免疫特征似乎更多反映疾病本身状态而非FMT的特异性干预效果。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该论文提供了关于FMT在ICI耐药实体瘤中应用的阴性疗效结果及详细的转化医学发现。对于综述而言，其核心价值在于反驳了“FMT能普遍逆转ICI耐药”的简单假设，并指出了患者选择（如疾病进展速度、既往免疫状态）和供体匹配的重要性。同时，它提供了关于肠道微生物定植持久性与临床获益之间潜在联系的生物学见解，以及系统性免疫景观（特别是髓系细胞和T细胞亚群）作为预后生物标志物的证据。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅适用于ICI耐药/进展人群，不能外推至一线治疗场景。样本量极小，结果可能存在偶然性，但趋势明确。\",\n            \"contribution\": \"提供了FMT在广泛ICI耐药实体瘤队列中的真实世界疗效数据：ORR为0%，中位PFS仅为1.5个月。这表明在非选择性、快速进展的耐药人群中，FMT联合ICI并非有效的挽救疗法。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持综述中关于“FMT疗效具有高度情境依赖性”或“需严格筛选患者群体”的论点。对比其他阳性研究，说明患者基线状态（如疾病负荷、进展速度）对FMT结局的关键影响。\"\n          },\n          {\n            \"boundaries\": \"免疫关联分析为探索性，未校正多重检验，且缺乏对照组，无法证明FMT改变了这些免疫特征从而改善了预后。仅描述了相关性，未证明因果机制。\",\n            \"contribution\": \"揭示了FMT干预后系统性免疫景观的变化及其与预后的关联：(1) FMT诱导的微生物定植多为暂时性，仅持久定植者与临床获益相关；(2) 基线高分化T细胞表型预示更好预后，而高髓系细胞（CD14+）和高IL-8水平预示不良预后；(3) 这些免疫特征似乎反映了宿主固有的免疫反应能力，而非FMT直接重塑的结果。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于解释FMT起效的潜在机制（需要持久定植和特定的宿主免疫背景）。提供生物标志物候选项（如CD14+单核细胞、IL-8、T细胞分化状态）以预测哪些患者可能从微生物调节中受益。帮助区分“药物直接效应”与“宿主背景效应”。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"提供FMT在临床转化中的实际挑战案例，特别是供体选择和患者异质性问题。\",\n            \"material\": \"研究讨论了使用ICI响应者作为供体的局限性（微生物组成差异大），以及不同研究间供体数量（单供体vs多供体）对结果的潜在影响。\",\n            \"purpose\": \"用于讨论“供体选择标准”对FMT疗效的影响，指出单一供体或多供体混合策略的优劣尚无共识，且供体与受体的匹配度可能是关键因素。\"\n          },\n          {\n            \"connection_to_review\": \"提供关于FMT给药途径和频率的可行性数据。\",\n            \"material\": \"比较了结肠镜给药（前两次）和灌肠给药（后续）的可行性及耐受性。\",\n            \"purpose\": \"用于综述中关于“FMT最佳给药方案”的部分，说明多次、重复给药在技术上可行，但在临床实践中受限于患者状况和疾病进展。\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究的阴性结果主要归因于患者群体的快速进展特性和小样本量，不应将其解读为FMT在所有情况下均无效，而应视为特定情境下的失败尝试。\",\n          \"免疫生物标志物的发现是探索性的，且可能与ICI治疗本身的效应混淆，需谨慎解读其作为FMT特异性机制的作用。\",\n          \"微生物定植的暂时性并不必然意味着临床无效，因为唯一获益患者的持久定植提示了两者间的潜在联系，但这仅是个案观察。\"\n        ],\n        \"topic_handles\": [\n          \"fecal microbiota transplantation (FMT)\",\n          \"immune checkpoint inhibitors (ICIs) resistance\",\n          \"solid tumors (melanoma, HNSCC, RCC, pancreatic cancer)\",\n          \"microbiota engraftment kinetics\",\n          \"peripheral blood mononuclear cells (PBMCs)\",\n          \"myeloid-derived suppressor cells / CD14+ monocytes\",\n          \"T-cell differentiation phenotypes\",\n          \"serum cytokines (IL-8)\"\n        ]\n      },\n      \"deep_read_material\": {\n        \"_progressive_task_requirements\": {\n          \"knowledge_gaps\": [\n            \"MITRIC 试验阴性结果需详细提取其关于患者选择、供体匹配及免疫微环境限制的解释，以平衡 Ch5 中的阳性结果。\"\n          ],\n          \"questions\": [\n            {\n              \"gap_key\": \"MITRIC 试验阴性结果需详细提取其关于患者选择、供体匹配及免疫微环境限制的解释，以平衡 Ch5 中的阳性结果。\",\n              \"purpose\": \"Supply a concrete, attributed case for the coordinated review.\",\n              \"question\": \"MITRIC 试验阴性结果需详细提取其关于患者选择、供体匹配及免疫微环境限制的解释，以平衡 Ch5 中的阳性结果。\",\n              \"question_id\": \"Q01\",\n              \"required_output_ids\": [\n                \"O01\"\n              ]\n            }\n          ],\n          \"required_outputs\": [\n            {\n              \"description\": \"Source-based findings, conditions, methods and limits useful to the review.\",\n              \"output_id\": \"O01\",\n              \"output_type\": \"practical_material\"\n            }\n          ]\n        },\n        \"_progressive_task_signature\": \"1826ef4c29abfe31\",\n        \"current_question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究 (MITRIC trial)\",\n                \"conditions\": \"研究对象为12名接受过多种治疗的晚期实体瘤患者（9例黑色素瘤，1例HNSCC，1例ccRCC，1例MSI-H胰腺癌），均处于ICI治疗后的疾病进展期。供体为3名长期ICI反应者。干预措施包括结肠镜给药的初始FMT和灌肠后续FMT。\",\n                \"finding\": \"在12名ICI耐药实体瘤患者中，FMT联合ICI治疗未观察到客观缓解（ORR 0%）。尽管FMT安全且可行，但临床获益有限。机制分析显示，基线时髓系偏倚环境和幼稚T细胞表型与较差预后相关；治疗后CD14+单核细胞和血清IL-8水平升高，这与较短的PFS和OS相关，表明FMT未能逆转这种不利的免疫微环境，甚至可能伴随髓系驱动的免疫抑制增加。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供阴性结果的详细解释，特别是关于患者选择（快速进展、晚期）、供体匹配（多供体 vs 单供体）及免疫微环境限制（髓系主导、IL-8升高），用于平衡Ch5中的阳性结果。\"\n              },\n              {\n                \"attribution\": \"Baruch et al. (2021)\",\n                \"conditions\": \"研究对象为抗PD-1耐受的转移性黑色素瘤患者。所有反应者均接受来自单一供体的粪便。\",\n                \"finding\": \"在一项针对抗PD-1耐受的转移性黑色素瘤患者的概念验证试验中，使用粪便微生物移植（FMT）实现了3/10患者的客观缓解，另有3名患者获得持久的疾病稳定。\",\n                \"reference_ids\": [\n                  \"R19\"\n                ],\n                \"use_in_review\": \"作为对比背景，展示阳性结果中使用的单一供体策略和特定患者群体，以突显MITRIC试验中多供体和不同患者选择带来的差异。\"\n              },\n              {\n                \"attribution\": \"Davar et al. (2021)\",\n                \"conditions\": \"研究对象为抗PD-1耐受的转移性黑色素瘤患者。\",\n                \"finding\": \"在一项针对抗PD-1耐受的转移性黑色素瘤患者的试验中，FMT使3/15患者产生反应，另有3名患者获得持久的疾病稳定。响应者在FMT/抗PD-1治疗后表现出外周血中CD56+CD8+ T细胞水平升高，且这些细胞表达更高的激活标记物；同时，响应者体内循环IL-8降低，肿瘤内产生IL-8的髓系细胞频率减少。\",\n                \"reference_ids\": [\n                  \"R18\"\n                ],\n                \"use_in_review\": \"作为对比背景，展示阳性结果中观察到的免疫学变化（如CD56+CD8+ T细胞增加、IL-8降低），与MITRIC试验中的阴性结果形成机制上的对比。\"\n              },\n              {\n                \"attribution\": \"Kim et al. (2024)\",\n                \"conditions\": \"研究对象为抗PD-1抑制剂耐药的不可切除或转移性实体瘤患者，主要为上消化道癌症。\",\n                \"finding\": \"在抗PD-1抑制剂耐药的不可切除或转移性实体瘤患者中，FMT改善了1/13名上消化道癌症患者的抗PD-1抑制剂疗效。\",\n                \"reference_ids\": [\n                  \"R20\"\n                ],\n                \"use_in_review\": \"作为对比背景，展示在其他实体瘤（上消化道癌）中FMT的潜在疗效，说明癌症类型和疾病状态对结果的影响。\"\n              }\n            ],\n            \"explanation\": \"MITRIC试验的阴性结果提示，FMT在克服ICI耐药方面并非普遍有效，其效果受到患者选择、供体匹配和免疫微环境状态的严格限制。\\n\\n首先，患者选择是关键因素。与之前报告阳性结果的试验（如Baruch等和Davar等）相比，MITRIC试验中的患者大多患有扩散迅速、生长快速的疾病，这可能没有给予FMT足够的时间来发挥有意义的生物学效应。此外，MITRIC试验纳入了原发性和继发性ICI耐药患者，而之前的研究主要关注继发性耐药或特定类型的耐药，这可能导致了结果的异质性。\\n\\n其次，供体匹配和多样性可能影响疗效。MITRIC试验使用了三名不同的供体，而Baruch等人的研究中所有反应者均来自单一供体。这表明，使用多名供体可能导致供体-受体匹配次优，或者缺乏对特定获益至关重要的微生物群落。供体的微生物组成存在显著差异，且目前尚不清楚使用ICI反应者作为供体是否优于健康供体。\\n\\n最后，免疫微环境的限制是重要的机制解释。MITRIC试验发现，基线时髓系偏倚环境和幼稚T细胞表型与较差的预后相关。治疗后，CD14+单核细胞和血清IL-8水平升高，这与较短的PFS和OS相关。相比之下，Davar等人的研究发现响应者体内IL-8降低，且髓系细胞产生的IL-8减少。这表明，在MITRIC试验的患者群体中，FMT未能逆转由髓系驱动的免疫抑制微环境，甚至可能伴随着这种抑制的增加，从而限制了临床获益。因此，FMT可能仅在具有特定免疫特征（如高分化T细胞环境、低髓系浸润）的选定人群中有效，而可靠的生物标志物尚未建立。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"MITRIC试验样本量小，且为单臂研究，无法进行因果推断或多重检验校正，因此关于免疫微环境和生物标志物的发现应谨慎解读。\",\n              \"长期定植的效果难以评估，因为大多数患者在疾病进展后无法收集后续的粪便样本。\",\n              \"需要进一步的研究来确定FMT的最佳给药方案、供体选择标准以及能够预测获益的患者亚群。\"\n            ]\n          }\n        ],\n        \"fulfilled\": false,\n        \"paper_identity\": {\n          \"canonical_paper_id\": \"d9577b3a29bd8aec60c9e27c6a56a63faf3f4a27\",\n          \"doi\": \"10.1136/jitc-2026-015122\",\n          \"title\": \"Safety and efficacy of fecal microbiota transplantation in solid cancers resistant to immune checkpoint inhibitors: results of the MITRIC trial\"\n        },\n        \"paper_title\": \"Safety and efficacy of fecal microbiota transplantation in solid cancers resistant to immune checkpoint inhibitors: results of the MITRIC trial\",\n        \"plain_text\": \"\",\n        \"prior_question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为 ICI 治疗期间或治疗后进展的晚期实体瘤患者；供体为长期 ICI 响应者；干预措施为结肠镜和灌肠给予的重复 FMT 联合持续或重新引入的 ICI 治疗；评估标准采用 iRECIST。\",\n                \"finding\": \"MITRIC 试验为一项单臂 IIa 期篮子试验，纳入 12 名对免疫检查点抑制剂（ICI）耐药的晚期实体瘤患者（黑色素瘤 n=9, ccRCC n=1, HNSCC n=1, MSI-H 胰腺癌 n=1）。主要终点客观缓解率（ORR）为 0/12（0%），未观察到任何客观缓解（部分或完全缓解）。5 名患者达到最佳稳定疾病（SD），7 名患者进展（PD）。中位无进展生存期（PFS）为 1.5 个月，中位总生存期（OS）为 10.1 个月。仅 1 名黑色素瘤患者获得协议定义的临床获益（SD >6 个月），另 2 名患者出现混合反应（部分病灶消退）。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供 FMT 在 ICI 耐药/难治性实体瘤患者中的具体疗效数据（ORR, PFS, OS），并展示阴性结果的具体表现，作为该人群疗效局限性的直接证据。\"\n              }\n            ],\n            \"explanation\": \"作者对 MITRIC 试验结果为阴性的解释主要集中在患者选择、疾病特征及供体匹配等方面：\\n1. **患者选择与疾病进展速度**：既往研究（如 Baruch et al., Davar et al.）中的响应往往发生较晚，且有时 preceded by pseudo-progression（假性进展）。而 MITRIC 中的大多数患者表现为弥漫性、快速生长的疾病，可能没有足够的时间让 FMT 发挥有意义的生物学效应。\\n2. **供体匹配与异质性**：虽然既往研究中所有响应者均接受单一供体的粪便，而本试验使用了三名供体，可能存在次优的供体-受体匹配或缺乏产生获益所需的特定微生物群落。此外，ICI 响应者之间的微生物组成差异很大，使用健康供体是否更优尚不清楚。\\n3. **免疫微环境限制**：基线时髓系偏倚环境和幼稚 T 细胞表型与较差预后相关，且 FMT 未能逆转这种不利的髓系主导免疫环境（事实上 CD14+ 单核细胞和 IL-8 随时间增加，这与较短的 PFS 和 OS 相关）。这表明 FMT 可能仅在选定的具有特定免疫特征的人群中有效。\\n4. **样本量与异质性**：小样本量是重要局限性，且不同研究在供体选择、FMT 制备、给药途径和治疗方案上的异质性也可能影响结果。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"FMT 在 ICI 耐药人群中的最佳生物标志物筛选标准尚未确立。\",\n              \"供体选择（ICI 响应者 vs 健康供体）及个体化匹配策略对疗效的具体影响仍需进一步研究。\",\n              \"FMT 是否能通过改变外周血免疫表型（如减少髓系抑制）来增强疗效，目前数据不支持其诱导了显著的全身免疫改变。\"\n            ]\n          }\n        ],\n        \"question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为 ICI 治疗期间或治疗后进展的晚期实体瘤患者；供体为长期 ICI 响应者；干预措施为结肠镜和灌肠给予的重复 FMT 联合持续或重新引入的 ICI 治疗；评估标准采用 iRECIST。\",\n                \"finding\": \"MITRIC 试验为一项单臂 IIa 期篮子试验，纳入 12 名对免疫检查点抑制剂（ICI）耐药的晚期实体瘤患者（黑色素瘤 n=9, ccRCC n=1, HNSCC n=1, MSI-H 胰腺癌 n=1）。主要终点客观缓解率（ORR）为 0/12（0%），未观察到任何客观缓解（部分或完全缓解）。5 名患者达到最佳稳定疾病（SD），7 名患者进展（PD）。中位无进展生存期（PFS）为 1.5 个月，中位总生存期（OS）为 10.1 个月。仅 1 名黑色素瘤患者获得协议定义的临床获益（SD >6 个月），另 2 名患者出现混合反应（部分病灶消退）。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供 FMT 在 ICI 耐药/难治性实体瘤患者中的具体疗效数据（ORR, PFS, OS），并展示阴性结果的具体表现，作为该人群疗效局限性的直接证据。\"\n              }\n            ],\n            \"explanation\": \"作者对 MITRIC 试验结果为阴性的解释主要集中在患者选择、疾病特征及供体匹配等方面：\\n1. **患者选择与疾病进展速度**：既往研究（如 Baruch et al., Davar et al.）中的响应往往发生较晚，且有时 preceded by pseudo-progression（假性进展）。而 MITRIC 中的大多数患者表现为弥漫性、快速生长的疾病，可能没有足够的时间让 FMT 发挥有意义的生物学效应。\\n2. **供体匹配与异质性**：虽然既往研究中所有响应者均接受单一供体的粪便，而本试验使用了三名供体，可能存在次优的供体-受体匹配或缺乏产生获益所需的特定微生物群落。此外，ICI 响应者之间的微生物组成差异很大，使用健康供体是否更优尚不清楚。\\n3. **免疫微环境限制**：基线时髓系偏倚环境和幼稚 T 细胞表型与较差预后相关，且 FMT 未能逆转这种不利的髓系主导免疫环境（事实上 CD14+ 单核细胞和 IL-8 随时间增加，这与较短的 PFS 和 OS 相关）。这表明 FMT 可能仅在选定的具有特定免疫特征的人群中有效。\\n4. **样本量与异质性**：小样本量是重要局限性，且不同研究在供体选择、FMT 制备、给药途径和治疗方案上的异质性也可能影响结果。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"FMT 在 ICI 耐药人群中的最佳生物标志物筛选标准尚未确立。\",\n              \"供体选择（ICI 响应者 vs 健康供体）及个体化匹配策略对疗效的具体影响仍需进一步研究。\",\n              \"FMT 是否能通过改变外周血免疫表型（如减少髓系抑制）来增强疗效，目前数据不支持其诱导了显著的全身免疫改变。\"\n            ]\n          },\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究 (MITRIC trial)\",\n                \"conditions\": \"研究对象为12名接受过多种治疗的晚期实体瘤患者（9例黑色素瘤，1例HNSCC，1例ccRCC，1例MSI-H胰腺癌），均处于ICI治疗后的疾病进展期。供体为3名长期ICI反应者。干预措施包括结肠镜给药的初始FMT和灌肠后续FMT。\",\n                \"finding\": \"在12名ICI耐药实体瘤患者中，FMT联合ICI治疗未观察到客观缓解（ORR 0%）。尽管FMT安全且可行，但临床获益有限。机制分析显示，基线时髓系偏倚环境和幼稚T细胞表型与较差预后相关；治疗后CD14+单核细胞和血清IL-8水平升高，这与较短的PFS和OS相关，表明FMT未能逆转这种不利的免疫微环境，甚至可能伴随髓系驱动的免疫抑制增加。\",\n                \"reference_ids\": [],\n                \"use_in_review\": \"提供阴性结果的详细解释，特别是关于患者选择（快速进展、晚期）、供体匹配（多供体 vs 单供体）及免疫微环境限制（髓系主导、IL-8升高），用于平衡Ch5中的阳性结果。\"\n              },\n              {\n                \"attribution\": \"Baruch et al. (2021)\",\n                \"conditions\": \"研究对象为抗PD-1耐受的转移性黑色素瘤患者。所有反应者均接受来自单一供体的粪便。\",\n                \"finding\": \"在一项针对抗PD-1耐受的转移性黑色素瘤患者的概念验证试验中，使用粪便微生物移植（FMT）实现了3/10患者的客观缓解，另有3名患者获得持久的疾病稳定。\",\n                \"reference_ids\": [\n                  \"R19\"\n                ],\n                \"use_in_review\": \"作为对比背景，展示阳性结果中使用的单一供体策略和特定患者群体，以突显MITRIC试验中多供体和不同患者选择带来的差异。\"\n              },\n              {\n                \"attribution\": \"Davar et al. (2021)\",\n                \"conditions\": \"研究对象为抗PD-1耐受的转移性黑色素瘤患者。\",\n                \"finding\": \"在一项针对抗PD-1耐受的转移性黑色素瘤患者的试验中，FMT使3/15患者产生反应，另有3名患者获得持久的疾病稳定。响应者在FMT/抗PD-1治疗后表现出外周血中CD56+CD8+ T细胞水平升高，且这些细胞表达更高的激活标记物；同时，响应者体内循环IL-8降低，肿瘤内产生IL-8的髓系细胞频率减少。\",\n                \"reference_ids\": [\n                  \"R18\"\n                ],\n                \"use_in_review\": \"作为对比背景，展示阳性结果中观察到的免疫学变化（如CD56+CD8+ T细胞增加、IL-8降低），与MITRIC试验中的阴性结果形成机制上的对比。\"\n              },\n              {\n                \"attribution\": \"Kim et al. (2024)\",\n                \"conditions\": \"研究对象为抗PD-1抑制剂耐药的不可切除或转移性实体瘤患者，主要为上消化道癌症。\",\n                \"finding\": \"在抗PD-1抑制剂耐药的不可切除或转移性实体瘤患者中，FMT改善了1/13名上消化道癌症患者的抗PD-1抑制剂疗效。\",\n                \"reference_ids\": [\n                  \"R20\"\n                ],\n                \"use_in_review\": \"作为对比背景，展示在其他实体瘤（上消化道癌）中FMT的潜在疗效，说明癌症类型和疾病状态对结果的影响。\"\n              }\n            ],\n            \"explanation\": \"MITRIC试验的阴性结果提示，FMT在克服ICI耐药方面并非普遍有效，其效果受到患者选择、供体匹配和免疫微环境状态的严格限制。\\n\\n首先，患者选择是关键因素。与之前报告阳性结果的试验（如Baruch等和Davar等）相比，MITRIC试验中的患者大多患有扩散迅速、生长快速的疾病，这可能没有给予FMT足够的时间来发挥有意义的生物学效应。此外，MITRIC试验纳入了原发性和继发性ICI耐药患者，而之前的研究主要关注继发性耐药或特定类型的耐药，这可能导致了结果的异质性。\\n\\n其次，供体匹配和多样性可能影响疗效。MITRIC试验使用了三名不同的供体，而Baruch等人的研究中所有反应者均来自单一供体。这表明，使用多名供体可能导致供体-受体匹配次优，或者缺乏对特定获益至关重要的微生物群落。供体的微生物组成存在显著差异，且目前尚不清楚使用ICI反应者作为供体是否优于健康供体。\\n\\n最后，免疫微环境的限制是重要的机制解释。MITRIC试验发现，基线时髓系偏倚环境和幼稚T细胞表型与较差的预后相关。治疗后，CD14+单核细胞和血清IL-8水平升高，这与较短的PFS和OS相关。相比之下，Davar等人的研究发现响应者体内IL-8降低，且髓系细胞产生的IL-8减少。这表明，在MITRIC试验的患者群体中，FMT未能逆转由髓系驱动的免疫抑制微环境，甚至可能伴随着这种抑制的增加，从而限制了临床获益。因此，FMT可能仅在具有特定免疫特征（如高分化T细胞环境、低髓系浸润）的选定人群中有效，而可靠的生物标志物尚未建立。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"MITRIC试验样本量小，且为单臂研究，无法进行因果推断或多重检验校正，因此关于免疫微环境和生物标志物的发现应谨慎解读。\",\n              \"长期定植的效果难以评估，因为大多数患者在疾病进展后无法收集后续的粪便样本。\",\n              \"需要进一步的研究来确定FMT的最佳给药方案、供体选择标准以及能够预测获益的患者亚群。\"\n            ]\n          }\n        ],\n        \"questions\": [\n          {\n            \"gap_key\": \"MITRIC 试验阴性结果需详细提取其关于患者选择、供体匹配及免疫微环境限制的解释，以平衡 Ch5 中的阳性结果。\",\n            \"purpose\": \"Supply a concrete, attributed case for the coordinated review.\",\n            \"question\": \"MITRIC 试验阴性结果需详细提取其关于患者选择、供体匹配及免疫微环境限制的解释，以平衡 Ch5 中的阳性结果。\",\n            \"question_id\": \"Q01\",\n            \"required_output_ids\": [\n              \"O01\"\n            ]\n          }\n        ],\n        \"reading_mode\": \"focused_local_search\",\n        \"required_outputs\": [\n          {\n            \"description\": \"Source-based findings, conditions, methods and limits useful to the review.\",\n            \"output_id\": \"O01\",\n            \"output_type\": \"practical_material\"\n          }\n        ],\n        \"source_hash\": \"163af5f925ccdf303a5e1ea759ee09e197370c5f96ebb2b13c0ffe191f601130\",\n        \"task_hash\": \"d5ed1ee74fa77146cbbbb8902e443d73f4d0b6bf5e2f2fa86fc5fd776eb04965\"\n      },\n      \"deep_read_material_trimmed\": {\n        \"dropped_keys\": {\n          \"material_ready\": 4,\n          \"paper_id\": 42,\n          \"references\": 834,\n          \"review_id\": 23,\n          \"schema_version\": 46,\n          \"status\": 9,\n          \"task_id\": 34,\n          \"workflow\": 21\n        },\n        \"dropped_chars\": 1013,\n        \"note\": \"深读材料里的记账字段与论文自带的参考文献表已省略；科学内容（问句材料/发现/条件）保留。需要时可用 locator 读原文。\"\n      },\n      \"supplement_material\": {\n        \"auxiliary_material\": \"The study provides mechanistic insights into why efficacy may be limited in certain contexts. It found that microbiota engraftment from donors was transient in most recipients, with durable engraftment observed only in the single patient who achieved clinical benefit. Mass cytometry analysis revealed that a baseline myeloid-dominant environment (high CD14+ monocytes) and high serum IL-8 were associated with poorer outcomes, while an activated T-cell signature was favorable. These immune features appeared to reflect the host's underlying disease state rather than being directly modified by FMT to improve outcomes. Additionally, the review planning material notes that this study highlights challenges in donor selection (using ICI responders vs healthy donors) and patient heterogeneity (rapidly progressive disease vs stable disease), suggesting that FMT efficacy is highly context-dependent.\",\n        \"evidence\": [],\n        \"gap_id\": \"large_scale_rct_results\",\n        \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU02_search_candidate_fc8af41423\\\\FULFILLMENT_JUDGMENT.json\",\n        \"limitations\": [],\n        \"material_ready\": true,\n        \"material_usefulness\": \"supporting\",\n        \"outline_action\": \"Identify and retrieve full-text or registry data for actual Phase III randomized controlled trials of FMT or defined microbial consortia in oncology (e.g., TACITO, though noted as randomized, verify if Phase III; other ongoing/completed Phase III trials like those in melanoma or RCC). If no such trials are found in the literature base, explicitly state that no Phase III RCTs have yet confirmed efficacy, using this Phase IIa negative result to illustrate the current stage of evidence (pre-registration/early-phase focus).\",\n        \"outline_action_recovered_by_policy\": false,\n        \"remaining_gap\": \"The gap question asks for confirmation of completed large-scale Phase III randomized controlled trials confirming microbiome intervention efficacy. This study is explicitly identified as a 'single-arm phase IIa' trial. It is neither Phase III nor randomized. Therefore, it does not fulfill the success criterion of providing data from a completed Phase III RCT.\",\n        \"remaining_gap_recovered_by_policy\": false,\n        \"status\": \"unmet\",\n        \"useful_material\": \"This study reports the results of the MITRIC trial (NCT05286294), a single-arm, phase IIa basket trial evaluating Fecal Microbiota Transplantation (FMT) from immune checkpoint inhibitor (ICI) responders in patients with advanced cancers progressing on ICIs. The trial enrolled 12 patients across melanoma, head and neck squamous cell carcinoma (HNSCC), renal cell carcinoma (RCC), and microsatellite instability-high pancreatic cancer. The co-primary endpoints were safety and objective response rate (ORR). The study found that FMT was safe and feasible but demonstrated limited clinical activity: no objective responses were observed (ORR 0%), median progression-free survival was 1.5 months, and median overall survival was 10.1 months. Clinical benefit (stable disease >6 months) was achieved in only one patient. The authors conclude that FMT does not support efficacy as a salvage therapy in this non-biomarker-driven, heavily pretreated population.\"\n      },\n      \"supplement_materials\": [\n        {\n          \"auxiliary_material\": \"The study provides mechanistic insights into why efficacy may be limited in certain contexts. It found that microbiota engraftment from donors was transient in most recipients, with durable engraftment observed only in the single patient who achieved clinical benefit. Mass cytometry analysis revealed that a baseline myeloid-dominant environment (high CD14+ monocytes) and high serum IL-8 were associated with poorer outcomes, while an activated T-cell signature was favorable. These immune features appeared to reflect the host's underlying disease state rather than being directly modified by FMT to improve outcomes. Additionally, the review planning material notes that this study highlights challenges in donor selection (using ICI responders vs healthy donors) and patient heterogeneity (rapidly progressive disease vs stable disease), suggesting that FMT efficacy is highly context-dependent.\",\n          \"evidence\": [],\n          \"gap_id\": \"large_scale_rct_results\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU02_search_candidate_fc8af41423\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action\": \"Identify and retrieve full-text or registry data for actual Phase III randomized controlled trials of FMT or defined microbial consortia in oncology (e.g., TACITO, though noted as randomized, verify if Phase III; other ongoing/completed Phase III trials like those in melanoma or RCC). If no such trials are found in the literature base, explicitly state that no Phase III RCTs have yet confirmed efficacy, using this Phase IIa negative result to illustrate the current stage of evidence (pre-registration/early-phase focus).\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"The gap question asks for confirmation of completed large-scale Phase III randomized controlled trials confirming microbiome intervention efficacy. This study is explicitly identified as a 'single-arm phase IIa' trial. It is neither Phase III nor randomized. Therefore, it does not fulfill the success criterion of providing data from a completed Phase III RCT.\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"This study reports the results of the MITRIC trial (NCT05286294), a single-arm, phase IIa basket trial evaluating Fecal Microbiota Transplantation (FMT) from immune checkpoint inhibitor (ICI) responders in patients with advanced cancers progressing on ICIs. The trial enrolled 12 patients across melanoma, head and neck squamous cell carcinoma (HNSCC), renal cell carcinoma (RCC), and microsatellite instability-high pancreatic cancer. The co-primary endpoints were safety and objective response rate (ORR). The study found that FMT was safe and feasible but demonstrated limited clinical activity: no objective responses were observed (ORR 0%), median progression-free survival was 1.5 months, and median overall survival was 10.1 months. Clinical benefit (stable disease >6 months) was achieved in only one patient. The authors conclude that FMT does not support efficacy as a salvage therapy in this non-biomarker-driven, heavily pretreated population.\"\n        }\n      ],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0578\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU02_search_candidate_fc8af41423\\\\card\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU02_search_candidate_fc8af41423\\\\card\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0577\",\n      \"title\": \"Improved survival in advanced melanoma patients treated with fecal microbiota transplantation using healthy donor stool in combination with anti-PD1: final results of the MIMic phase 1 trial\",\n      \"year\": \"2025\",\n      \"doi\": \"10.1136/jitc-2025-012659\",\n      \"paper_id\": \"20c143d5373eab0bfea2067cf66b0e260dfeb1ef\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"Single-arm, multicenter phase I clinical trial. Patients received bowel preparation, followed by oral administration of capsules containing stool from one of three healthy male donors. Anti-PD1 therapy (nivolumab or pembrolizumab) started at least 7 days post-FMT. Outcomes were assessed using RECIST 1.1 criteria. Survival analysis used Kaplan-Meier methods. Metagenomic sequencing was performed on stool samples to analyze taxonomic composition (MetaPhlAn) and functional gene families (HUMAnN). Post hoc subgroup analyses compared responders vs. non-responders and patients with vs. without FMT-specific toxicity (FT) based on microbial and functional profiles.\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"Provides long-term survival data (median OS 52.8 months) for a small cohort of advanced melanoma patients treated with oral FMT plus anti-PD1, demonstrating high safety and promising efficacy signals compared to historical controls.\",\n            \"limits\": \"Small sample size (N=20), single-arm design without a control group, and lack of statistical power for definitive conclusions. Results are hypothesis-generating. Patient selection bias (excluded those appropriate for combination therapy).\"\n          },\n          {\n            \"contribution\": \"Identifies potential biomarkers for response, linking FMT-specific mild toxicity and long-term survival to specific microbial taxa (e.g., SCFA producers) and functional metabolic pathways (glycan modification, SCFA biosynthesis).\",\n            \"limits\": \"Associations are derived from post hoc analyses. Causality between specific microbes/enzymes and clinical benefit is not established. The 'donor effect' could not be clearly disentangled due to the small cohort and mixed donor usage.\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"Entire cohort (N=20), median follow-up 52.8 months\",\n            \"finding\": \"Median PFS was 29.6 months; median OS was 52.8 months. ORR was 65% (4 complete responses). Safety profile showed no increase in severe immune-related adverse events (irAEs); only grade 3 toxicities occurred.\"\n          },\n          {\n            \"conditions\": \"Responders (R, N=13) vs. Non-responders (NR, N=7)\",\n            \"finding\": \"R patients had significantly longer mPFS (52.8 vs. 5.2 months, p=0.0016) and longer mOS (52.8 vs. 17.6 months, p=0.0628). R patients sustained donor-derived microbial similarity over time.\"\n          },\n          {\n            \"conditions\": \"Patients with FMT-specific toxicity (FT, N=8) vs. Without FT (NFT, N=12)\",\n            \"finding\": \"All 8 FT patients were responders. FT patients had significantly improved mPFS (52.8 vs. 15.9 months, p=0.0364) and trend towards improved mOS (53.9 vs. 24.6 months, p=0.0610). FT was associated with enrichment of SCFA-producing taxa and glycan-modifying enzymes.\"\n          },\n          {\n            \"conditions\": \"Long-term survivors (LTS) vs. Short-term survivors (STS)\",\n            \"finding\": \"LTS were enriched for commensal bacteria (Alistipes, Faecalibacterium) and enzymes involved in amino acid/SCFA biosynthesis. STS were enriched for stress-associated oxidative metabolism pathways and Hungatella hathewayi.\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"To evaluate whether modifying the gut microbiome via oral FMT from healthy donors can improve the safety, response rate, and survival outcomes of anti-PD1 therapy in patients with advanced melanoma who are naive to advanced-stage treatment, potentially overcoming primary resistance to immune checkpoint inhibitors (ICIs).\",\n        \"research_scope\": \"Advanced cutaneous melanoma patients (N=20), treatment-naïve for advanced disease, receiving oral fecal microbiota transplantation (FMT) from healthy donors followed by single-agent anti-PD1 therapy. Multicenter phase I trial conducted in Canada.\",\n        \"work_summary\": \"This study reports the final survival outcomes of the MIMic phase I trial, evaluating the safety and efficacy of combining oral FMT with healthy donor stool and anti-PD1 immunotherapy as first-line treatment for advanced melanoma. The trial enrolled 20 patients who received a single dose of FMT followed by nivolumab or pembrolizumab. The primary endpoint was safety, while secondary endpoints included objective response rate (ORR), progression-free survival (PFS), and overall survival (OS). The study found that the combination was safe, with an ORR of 65%. Median PFS was 29.6 months and median OS was 52.8 months, figures reported as higher than historical randomized controlled trials (RCTs) and real-world data. Post hoc analyses linked clinical responses to specific microbial engraftment patterns and functional metabolic pathways, suggesting that successful microbiome modulation may enhance ICI efficacy.\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"This paper provides empirical evidence from a Phase I trial that oral FMT from healthy donors combined with anti-PD1 is safe and associated with improved survival in advanced melanoma. It offers specific mechanistic hypotheses linking clinical response to microbial engraftment success, characterized by the enrichment of short-chain fatty acid (SCFA)-producing bacteria and specific metabolic pathways. The study highlights FMT-specific toxicity as a potential marker of successful microbial integration and immune priming.\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"Results are from a single-arm, small-sample Phase I trial. Cannot establish causal superiority over standard care due to lack of concurrent control arm. Patient population was restricted to those unsuitable for combination immunotherapy.\",\n            \"contribution\": \"Reports clinical efficacy outcomes (ORR 65%, mPFS 29.6 mo, mOS 52.8 mo) for FMT+anti-PD1 in advanced melanoma, showing improvements over historical RCT benchmarks for anti-PD1 alone.\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"Can be used to illustrate the potential magnitude of benefit from microbiome manipulation in solid tumors, specifically melanoma. Provides baseline survival metrics for comparison with other microbiome interventions.\"\n          },\n          {\n            \"boundaries\": \"Mechanisms are inferred from correlative post hoc analyses. The role of FMT-specific toxicity as a proxy for engraftment success is observational. Functional profiling relies on metagenomic prediction, which may not reflect actual protein activity or host interaction.\",\n            \"contribution\": \"Links clinical response to specific microbial features: Responders and long-term survivors show enrichment of SCFA-producing taxa (Blautia, Roseburia, Faecalibacterium) and enzymes for glycan modification/amino acid biosynthesis. Non-responders/short-term survivors show enrichment of oxidative/stress pathways and Hungatella hathewayi.\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"Provides mechanistic insights into how microbiome composition might mediate ICI efficacy. Suggests that successful engraftment of metabolically fit, SCFA-producing communities enhances immune response. Identifies functional metabolic signatures (vs. just taxonomy) associated with outcome.\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"Helps categorize different microbiome intervention modalities in the review.\",\n            \"material\": \"Comparison of oral capsule-based FMT (this study) vs. invasive colonoscopic FMT (referenced in intro). This study supports the feasibility and safety of oral delivery for systemic immune modulation.\",\n            \"purpose\": \"Contextual background on FMT delivery methods\"\n          },\n          {\n            \"connection_to_review\": \"Addresses the safety facet of microbiome interventions, countering concerns about increased autoimmune toxicity when combining FMT with ICIs.\",\n            \"material\": \"No increase in severe irAEs; FMT-specific toxicities were mild (Grade 1-2 GI).\",\n            \"purpose\": \"Safety profile of microbiome manipulation\"\n          },\n          {\n            \"connection_to_review\": \"Useful for discussing the quality of evidence in the field and the need for larger, randomized Phase II/III trials (like the mentioned ME.17 trial).\",\n            \"material\": \"Acknowledges small sample size, lack of control arm, and hypothesis-generating nature of results.\",\n            \"purpose\": \"Limitations of current evidence\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"The study population is limited to advanced cutaneous melanoma patients ineligible for combination immunotherapy; results may not generalize to other solid tumors or earlier-stage disease.\",\n          \"Survival comparisons with historical RCTs are noted by authors but are confounded by patient selection biases and temporal changes in care; do not treat as definitive proof of superiority.\",\n          \"Microbial associations are correlational; causality between specific taxa/pathways and ICI response is not proven within this study design.\"\n        ],\n        \"topic_handles\": [\n          \"oral fecal microbiota transplantation (FMT) in solid tumors\",\n          \"anti-PD1 monotherapy in advanced melanoma\",\n          \"microbial engraftment dynamics (donor-recipient similarity)\",\n          \"FMT-specific gastrointestinal toxicity as a response biomarker\",\n          \"metabolic pathways: SCFA production, glycan degradation, oxidative stress\"\n        ]\n      },\n      \"deep_read_material\": {\n        \"_progressive_task_signature\": \"b4053ba5060ea008\",\n        \"paper_title\": \"Improved survival in advanced melanoma patients treated with fecal microbiota transplantation using healthy donor stool in combination with anti-PD1: final results of the MIMic phase 1 trial\",\n        \"plain_text\": \"\",\n        \"question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"本研究\",\n                \"conditions\": \"研究对象为20名晚期黑色素瘤患者；供体为3名健康男性；给药方式为口服胶囊；预处理为PEG肠道准备；无抗生素使用。\",\n                \"finding\": \"MIMic试验使用了来自三位健康男性供体的粪便进行口服FMT。所有患者均接受单一供体的粪便（每位患者对应一位供体），未混合多供体粪便。供体经过“严格的选择标准”筛选（文中引用了之前的出版物Craven et al. 2017及Routy et al. 2023中的详细标准）。FMT产品以胶囊形式给药，每剂包含35-40粒胶囊，相当于80-100克粪便。在给予FMT前一天，患者使用聚乙二醇（PEG）基肠道准备液进行预处理，且治疗期间未使用抗生素。\",\n                \"reference_ids\": [\n                  \"R12\",\n                  \"R13\"\n                ],\n                \"use_in_review\": \"作为FMT干预标准化中供体筛选和制备流程的具体案例，展示如何通过严格筛选和健康供体来源来保证干预的一致性和安全性，同时指出单供体使用的局限性。\"\n              }\n            ],\n            \"explanation\": \"MIMic试验在供体筛选和FMT制备方面采取了高度标准化的策略，旨在确保干预的安全性和微生物定植的可预测性。\\n\\n1. **供体筛选标准**：研究采用了“严格的选择标准”（stringent selection criteria）来筛选健康供体。虽然正文未列出具体排除指标的细节，但明确引用了关于代谢综合征疾病FMT供体筛选成本的研究（Craven et al., 2017, R13）以及该团队之前发表的I期试验方案（Routy et al., 2023, R12），暗示其遵循了当时临床前或早期临床试验中较为严格的卫生学、传染病及健康状况筛查流程。这种严格筛选是作为正面教材的，因为它最大限度地降低了传播病原体或引入致病微生物的风险，确保了“健康供体粪便”这一干预物的纯净度。\\n\\n2. **FMT制备与给药流程**：\\n   - **单一供源 vs 混合供源**：试验设计采用单一供体粪便（single healthy donor stool），每位患者仅接受来自三位指定男性供体中某一人的粪便。这种做法简化了批次管理，减少了不同供体间微生物组异质性带来的混杂因素，有利于评估特定微生物组合对免疫检查点抑制剂（ICI）的反应。然而，这也可能是一个反面教材或局限性，因为缺乏多供体混合可能无法覆盖更广泛的有益菌群多样性，且文中提到“没有明显的供体效应”，说明单个供体的效果在不同患者间可能存在差异，但未深入探讨混合供体是否会更优。\\n   - **制剂形式**：将粪便制成口服胶囊（35-40粒/剂，含80-100g粪便），而非传统的灌肠或鼻胃管给药。这提高了患者的依从性，减少了侵入性操作带来的感染风险，是FMT非侵入化、标准化的重要进展。\\n   - **预处理与辅助措施**：在FMT前一日使用PEG基肠道准备液，旨在清除原有肠道内容物，为新菌群定植腾出生态位。特别值得注意的是，研究中明确禁止使用抗生素，以避免抗生素对肠道菌群的破坏干扰FMT的效果或引起耐药性问题。这种“清洁但不杀菌”的准备策略是标准化流程中的关键控制点。\\n\\n总体而言，该试验通过严格的供体准入、单一的供体来源、标准化的胶囊制剂以及特定的肠道预处理，构建了一套可重复的FMT干预流程。其成功的关键在于确保了输入菌群的健康属性和定植潜力，为后续观察微生物组变化与临床疗效的关系提供了可靠的基础。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"文中引用的供体筛选具体指标（如具体的病原体检测列表、BMI限制、饮食要求等）未在本文正文中详细列出，需参考R12和R13获取完整细节。\",\n              \"单一供体与多供体混合在长期定植稳定性和临床获益上的比较数据不足，仅观察到无显著供体效应，未深入分析为何选择单一供体而非混合供体。\",\n              \"PEG肠道准备的具体配方浓度、体积及服用时间未详细说明。\"\n            ]\n          }\n        ],\n        \"reading_mode\": \"focused_local_search\",\n        \"source_hash\": \"02a5690fbd7940bcc411f8b60e4aa551e71a8b476c67344b80a9b28911c5e444\"\n      },\n      \"deep_read_material_trimmed\": {\n        \"dropped_keys\": {\n          \"material_ready\": 4,\n          \"paper_id\": 42,\n          \"references\": 595,\n          \"reused_from\": 207,\n          \"review_id\": 23,\n          \"schema_version\": 46,\n          \"status\": 16,\n          \"task_id\": 34,\n          \"workflow\": 21\n        },\n        \"dropped_chars\": 988,\n        \"note\": \"深读材料里的记账字段与论文自带的参考文献表已省略；科学内容（问句材料/发现/条件）保留。需要时可用 locator 读原文。\"\n      },\n      \"supplement_material\": {\n        \"auxiliary_material\": \"The paper provides mechanistic insights linking clinical response to microbial engraftment, noting that responders and long-term survivors showed enrichment of short-chain fatty acid (SCFA)-produ taxa (e.g., Blautia, Roseburia, Faecalibacterium) and glycan-modifying enzymes. It also suggests that mild FMT-specific gastrointestinal toxicity may serve as a marker for successful microbial integration and immune priming. Additionally, the text contrasts these findings with historical RCT data (e.g., KEYNOTE-006, CheckMate 067) to contextualize the magnitude of observed benefits, though it acknowledges limitations regarding patient selection bias.\",\n        \"evidence\": [],\n        \"gap_id\": \"large_scale_rct_results\",\n        \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU01_search_candidate_8a825f7f53\\\\FULFILLMENT_JUDGMENT.json\",\n        \"limitations\": [],\n        \"material_ready\": true,\n        \"material_usefulness\": \"supporting\",\n        \"outline_action\": \"Search for completed Phase III randomized controlled trials involving FMT or defined microbiome consortia combined with immune checkpoint inhibitors. Verify completion status and primary outcome data for these specific high-level trials.\",\n        \"outline_action_recovered_by_policy\": false,\n        \"remaining_gap\": \"The gap requires confirmation of completed large-scale Phase III randomized controlled trials. This study is a Phase I single-arm trial, not a Phase III RCT. While it mentions a planned Phase II randomized trial (ME.17), it does not provide data on any completed Phase III trials confirming efficacy.\",\n        \"remaining_gap_recovered_by_policy\": false,\n        \"status\": \"unmet\",\n        \"useful_material\": \"This study reports results from the MIMic trial, a multicenter, single-arm Phase I safety trial evaluating oral FMT combined with anti-PD1 therapy in 20 patients with advanced melanoma. The study found that the combination was safe and associated with an objective response rate (ORR) of 65%, median progression-free survival (mPFS) of 29.6 months, and median overall survival (mOS) of 52.8 months. These outcomes were compared favorably to historical randomized controlled trials (RCTs) of anti-PD1 monotherapy. The authors explicitly state that the sample size was small, there was no control arm, and the results are hypothesis-generating. The study identifies a subsequent randomized Phase II Canadian study (ME.17, NCT06623461) designed to evaluate the potential benefit of this intervention.\"\n      },\n      \"supplement_materials\": [\n        {\n          \"auxiliary_material\": \"The paper provides mechanistic insights linking clinical response to microbial engraftment, noting that responders and long-term survivors showed enrichment of short-chain fatty acid (SCFA)-produ taxa (e.g., Blautia, Roseburia, Faecalibacterium) and glycan-modifying enzymes. It also suggests that mild FMT-specific gastrointestinal toxicity may serve as a marker for successful microbial integration and immune priming. Additionally, the text contrasts these findings with historical RCT data (e.g., KEYNOTE-006, CheckMate 067) to contextualize the magnitude of observed benefits, though it acknowledges limitations regarding patient selection bias.\",\n          \"evidence\": [],\n          \"gap_id\": \"large_scale_rct_results\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU01_search_candidate_8a825f7f53\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action\": \"Search for completed Phase III randomized controlled trials involving FMT or defined microbiome consortia combined with immune checkpoint inhibitors. Verify completion status and primary outcome data for these specific high-level trials.\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"The gap requires confirmation of completed large-scale Phase III randomized controlled trials. This study is a Phase I single-arm trial, not a Phase III RCT. While it mentions a planned Phase II randomized trial (ME.17), it does not provide data on any completed Phase III trials confirming efficacy.\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"This study reports results from the MIMic trial, a multicenter, single-arm Phase I safety trial evaluating oral FMT combined with anti-PD1 therapy in 20 patients with advanced melanoma. The study found that the combination was safe and associated with an objective response rate (ORR) of 65%, median progression-free survival (mPFS) of 29.6 months, and median overall survival (mOS) of 52.8 months. These outcomes were compared favorably to historical randomized controlled trials (RCTs) of anti-PD1 monotherapy. The authors explicitly state that the sample size was small, there was no control arm, and the results are hypothesis-generating. The study identifies a subsequent randomized Phase II Canadian study (ME.17, NCT06623461) designed to evaluate the potential benefit of this intervention.\"\n        }\n      ],\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0577\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU01_search_candidate_8a825f7f53\\\\card\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\progressive_review_plan\\\\20260924_microbiome\\\\run01\\\\level1\\\\supplements\\\\large_scale_rct_results\\\\source_units\\\\SU01_search_candidate_8a825f7f53\\\\card\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0081\",\n      \"title\": \"Unraveling gut microbiome interferences in cancer immunotherapy: a meta-analysis of diverse drug effects\",\n      \"year\": \"2025\",\n      \"doi\": \"10.1186/s12885-025-15094-9\",\n      \"paper_id\": \"1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"1. 文献检索与筛选：遵循PRISMA指南，检索2011年4月至2024年5月发表的英文临床研究，纳入标准包括确诊癌症、接受ICI治疗、有微生物组干扰药物暴露数据及明确结局指标。排除动物研究、个案报告及样本量<10的研究。 2. 数据提取与质量评价：双人独立提取数据，优先提取多变量调整后的HR/RR以控制混杂。使用Newcastle-Ottawa Scale (NOS)评估队列研究质量，使用GRADE系统评估证据确定性。 3. Meta分析：计算各干预措施对OS、PFS和ORR的合并效应量。对于高异质性（I²>50%）采用随机效应模型。 4. 异质性探索：进行亚组分析（按肿瘤类型、暴露时间窗、治疗方案）和单变量Meta回归，识别导致异质性的协变量。 5. 敏感性分析与偏倚评估：使用“留一法”检验稳健性，通过漏斗图和Egger/Begg测试评估发表偏倚。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了目前最大规模的关于抗生素、PPIs和益生菌对ICI疗效影响的定量综合证据，明确了这三类药物对疗效影响的总体方向（抗生素/PPIs负面，益生菌正面）。\",\n            \"limits\": \"所纳入研究均为观察性设计，存在固有的指示偏倚（Indication Bias），即病情更重的患者更可能使用抗生素，可能导致抗生素负面效应的夸大。此外，肠道微生物组的具体组成变化未作为直接暴露变量，而是通过药物代理，机制解释受限。\"\n          },\n          {\n            \"contribution\": \"通过Meta回归量化了异质性来源，发现治疗方案和暴露时间窗是抗生素效应异质性的主要解释因素。\",\n            \"limits\": \"部分亚组（如特定肿瘤类型的ORR）统计效能不足，结果需谨慎解读。GRADE评级显示多数生存结局证据确定性不高，限制了临床指南的直接应用。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"抗生素暴露 vs 无暴露\",\n            \"finding\": \"抗生素使用与OS（HR=1.61, 95% CI 1.44-1.81）、PFS（HR=1.43, 95% CI 1.27-1.60）和ORR（RR=0.58, 95% CI 0.51-0.66）显著降低相关。证据确定性为低（OS/PFS）至中等（ORR）。\"\n          },\n          {\n            \"conditions\": \"PPIs暴露 vs 无暴露\",\n            \"finding\": \"PPIs使用与OS（HR=1.28, 95% CI 1.17-1.41）、PFS（HR=1.22, 95% CI 1.12-1.34）和ORR（RR=0.82, 95% CI 0.75-0.90）显著降低相关。证据确定性为中等（OS/PFS）至低（ORR）。\"\n          },\n          {\n            \"conditions\": \"益生菌暴露 vs 无暴露\",\n            \"finding\": \"益生菌使用与OS（HR=0.67, 95% CI 0.55-0.82）、PFS（HR=0.55, 95% CI 0.46-0.67）和ORR（RR=1.24, 95% CI 1.07-1.44）显著改善相关。但由于研究数量少且多为观察性研究，证据确定性较低至中等，结果被视为假设生成性而非确证性。\"\n          },\n          {\n            \"conditions\": \"亚组分析：抗生素暴露时间窗\",\n            \"finding\": \"在ICI治疗前后[-45, 45]天窗口内使用抗生素，OS恶化风险最高（β=0.2192, p=0.008）。\"\n          },\n          {\n            \"conditions\": \"亚组分析：PPIs暴露时间窗\",\n            \"finding\": \"在[-45, 45]天和同期使用时，PPIs与OS恶化的关联最强（HR≈1.31）。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管已知肠道微生物组影响ICI疗效，但现有研究在暴露定义、混杂因素调整和结果上存在巨大异质性和冲突。本研究旨在量化三种主要干扰肠道微生物组的药物干预（抗生素、PPIs、益生菌）对ICI治疗结局的整体影响方向、 magnitude 及其异质性来源，为临床合理用药提供综合证据。\",\n        \"research_scope\": \"针对接受免疫检查点抑制剂（ICIs）治疗的实体瘤患者，系统评估三种常见伴随用药（抗生素、质子泵抑制剂PPIs、益生菌）对肠道微生物组及ICI疗效的影响。研究涵盖非小细胞肺癌（NSCLC）、黑色素瘤、肾细胞癌（RCC）、尿路上皮癌（UC）、肝细胞癌（HCC）等多种肿瘤类型，纳入69项研究、102个队列，共22,568名患者。\",\n        \"work_summary\": \"这是一篇基于PRISMA指南的系统综述与Meta分析，旨在解决当前关于肠道微生物组调节剂影响ICI疗效的证据碎片化问题。作者通过检索PubMed、Embase等数据库，筛选出观察性研究（主要为回顾性队列），提取了进展无生存期（PFS）、总生存期（OS）和客观缓解率（ORR）数据。研究采用随机效应或固定效应模型计算合并风险比（HR/RR），并依据肿瘤类型、药物暴露时间窗（如[-90, 90]天）和治疗方案（单药vs联合）进行亚组分析。同时，利用Meta回归探索异质性来源，并通过GRADE系统评估证据确定性。结果显示，抗生素和PPIs的使用与ICI疗效降低显著相关，而益生菌补充则显示出改善疗效的趋势，但证据强度存在差异。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该Meta分析为综述提供了关于‘伴随用药’这一关键混杂因素或调节变量的大规模实证数据。它不直接揭示微生物组机制，但确立了临床实践中必须控制的药物干扰类型及其对预后的量化影响。可用于综述中讨论‘外部干预如何掩盖或修饰微生物组-免疫互作信号’，以及‘为何单纯检测微生物组而不考虑用药史会导致结果不一致’。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"仅反映统计学关联，不能证明因果机制；益生菌的结果基于较少研究且证据等级较低，不宜作为强证据引用；未区分具体细菌物种的变化。\",\n            \"contribution\": \"提供了抗生素、PPIs和益生菌对ICI疗效影响的汇总效应量（HR/RR）。具体数据显示抗生素和PPIs显著降低OS、PFS和ORR，而益生菌显著改善这些指标。这有助于解释在观察微生物组与ICI疗效关系时，为何不同研究间存在巨大差异——因为患者群体的用药背景不同。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持‘临床用药史是微生物组-ICI疗效关联中的关键混杂因素’这一论点；提供具体的效应大小参考，说明药物干扰的严重程度。\"\n          },\n          {\n            \"boundaries\": \"时间窗定义在不同原始研究中可能存在差异，合并分析依赖于作者的重新分类。\",\n            \"contribution\": \"揭示了药物暴露的时间窗特异性：在ICI治疗前后[-45, 45]天内使用抗生素或PPIs，对预后的负面影响最为显著。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于综述中讨论‘干预时机’的重要性，提示在评估微生物组影响时，需精确界定暴露时间窗，而非笼统地考虑‘是否用过药’。\"\n          },\n          {\n            \"boundaries\": \"这些是作者基于现有文献的解释性假说，并非本Meta分析的新实验发现；缺乏直接的微生物组测序数据支持，属于间接推断。\",\n            \"contribution\": \"提出了可能的机制假说：抗生素通过广谱消除有益菌破坏免疫反应；PPIs通过改变胃pH值扰乱免疫调节菌群平衡；益生菌通过促进有益菌生长增强抗肿瘤免疫。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"作为理论框架的一部分，用于连接‘药物-微生物组-免疫’通路，尽管这些机制在该文中未被直接验证，但为后续机制研究提供了方向。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"用于论证本综述的必要性：需要整合现有分散证据，统一评估标准，以澄清微生物组在ICI疗效中的真实作用。\",\n            \"material\": \"文章指出当前证据基础碎片化，大多数研究为回顾性、单中心、小样本，且暴露定义和混杂因素调整不一致。\",\n            \"purpose\": \"背景与现状描述\"\n          },\n          {\n            \"connection_to_review\": \"提醒综述作者在综合微生物组研究时，必须警惕类似的方法学缺陷，并在评估证据质量时考虑潜在的残余混杂。\",\n            \"material\": \"文章强调了观察性研究中的指示偏倚（Indication Bias），即重症患者更多使用抗生素，导致抗生素负面效应被高估。\",\n            \"purpose\": \"方法学警示\"\n          },\n          {\n            \"connection_to_review\": \"可作为综述‘局限性与展望’部分的素材，强调从相关性向因果性转变的需求，以及精准微生物组干预的潜力。\",\n            \"material\": \"建议未来研究应关注特定益生菌菌株和抗生素类别的影响，标准化微生物组测量协议，并进行前瞻性随机对照试验。\",\n            \"purpose\": \"未来研究方向\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该研究为Meta分析，其结论是基于已发表观察性研究的汇总，而非新的原始实验数据。\",\n          \"益生菌的益处证据等级较低（Low to Moderate certainty），不应视为确证性结论，仅具提示意义。\",\n          \"抗生素和PPIs的负面效应可能受到‘适应症偏倚’（即病情重者多用抗生素）的影响，实际因果效应可能被高估。\",\n          \"研究未直接测量肠道微生物组的具体组成变化，而是通过药物使用作为代理变量，因此不能直接回答‘哪些特定细菌’介导了疗效变化，只能回答‘哪些药物干扰’影响了疗效。\"\n        ],\n        \"topic_handles\": [\n          \"immune checkpoint inhibitors (ICIs)\",\n          \"gut microbiome modulation by drugs\",\n          \"antibiotics interference\",\n          \"proton pump inhibitors (PPIs)\",\n          \"probiotics supplementation\",\n          \"solid tumours (NSCLC, melanoma, RCC, etc.)\",\n          \"clinical outcomes (OS, PFS, ORR)\"\n        ]\n      },\n      \"local_passages\": {\n        \"external_calls\": 0,\n        \"passages\": [\n          {\n            \"best_sentence\": \"5 Effect of concomitant use of antibiotics on PFS others categorized as \\\"Multiple\\\", the OS, PFS, and ORR during ICI treatment were significantly lower among those who used antibiotics compared to those who did not.The heterogeneity of OS was mainly attributed to the non-small cell lung cancer group (I²=55.3%)and the multiple types of groups (I²=46.9%),with no statistically significant differences between subgroups (interaction P = 0.628).Notably, in patients with RCC, both OS and PFS were significantly reduced (HR = 2.08, 95% CI 1.41-3.06;HR = 2.22, 95% CI 1.70-2.91),as was the ORR (RR = 0.44, 95% CI 0.26-0.74).\",\n            \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\\\\6306ccac684d884f60ffc329cc05a0e0\\\\attempt-01\\\\PAPER_READING_CARD.json\",\n            \"doi\": \"10.1186/s12885-025-15094-9\",\n            \"limits\": [],\n            \"match_terms\": [\n              \"mechanisms mediate effect\",\n              \"ici\",\n              \"orr\",\n              \"pfs\",\n              \"os\",\n              \"nsclc\",\n              \"rcc\",\n              \"hcc\"\n            ],\n            \"material_depth\": \"fulltext\",\n            \"paper_id\": \"1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\",\n            \"pool_action\": \"already_in_pool\",\n            \"reading_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\materials\\\\1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\\\\snapshot-47bff19cde8d0f84f50042e9\",\n            \"score\": 45.351038,\n            \"section_path\": [\n              \"Subgroup analyses according to the cancer type\"\n            ],\n            \"segment_kind\": \"document_block\",\n            \"source_handle\": \"P0081\",\n            \"text\": \"groups (interaction P = 0.705).In patients with NSCLC, melanoma, urothelial carcinoma (UC), renal cell carcinoma (RCC), hepatocellular carcinoma (HCC), and Fig. ts with NSCLC, melanoma, urothelial carcinoma (UC), renal cell carcinoma (RCC), hepatocellular carcinoma (HCC), and Fig. 5 Effect of concomitant use of antibiotics on PFS others categorized as \\\"Multiple\\\", the OS, PFS, and ORR during ICI treatment were significantly lower among those who used antibiotics compared to those who did not.The heterogeneity of OS was mainly attributed to the non-small cell lung cancer group (I²=55.3%)and the multiple types of groups (I²=46.9%),with no statistically significant differences between subgroups (interaction P = 0.628).Notably, in patients with RCC, both OS and PFS were significantly reduced (HR = 2.08, 95% CI 1.41-3.06;HR = 2.22, 95% CI 1.70-2.91),as was the ORR (RR = 0.44, 95% CI 0.26-0.74). Regarding PPI treatment, for OS, heterogeneity primarily originated from the multiple cancer types subgroup (I²=71.5%),with no statistically significant differe\",\n            \"title\": \"Unraveling gut microbiome interferences in cancer immunotherapy: a meta-analysis of diverse drug effects\",\n            \"usable_fields\": [],\n            \"year\": \"2025\"\n          },\n          {\n            \"best_sentence\": \"solid tumours (NSCLC, melanoma, RCC, etc.)\",\n            \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\\\\6306ccac684d884f60ffc329cc05a0e0\\\\attempt-01\\\\PAPER_READING_CARD.json\",\n            \"doi\": \"10.1186/s12885-025-15094-9\",\n            \"limits\": [],\n            \"match_terms\": [\n              \"gut microbiome modulate efficacy immune checkpoint inhibitors solid tumours\",\n              \"nsclc\",\n              \"rcc\"\n            ],\n            \"material_depth\": \"fulltext\",\n            \"paper_id\": \"1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\",\n            \"pool_action\": \"already_in_pool\",\n            \"reading_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\materials\\\\1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\\\\snapshot-47bff19cde8d0f84f50042e9\",\n            \"score\": 5.750227,\n            \"section_path\": [\n              \"review planning\",\n              \"topic handles\"\n            ],\n            \"segment_kind\": \"card_topic_handle\",\n            \"source_handle\": \"P0081\",\n            \"text\": \"probiotics supplementation solid tumours (NSCLC, melanoma, RCC, etc.) clinical outcomes (OS, PFS, ORR)\",\n            \"title\": \"Unraveling gut microbiome interferences in cancer immunotherapy: a meta-analysis of diverse drug effects\",\n            \"usable_fields\": [],\n            \"year\": \"2025\"\n          }\n        ],\n        \"question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect? 实体瘤中肠道微生物组与 ICI 疗效的临床关联证据 系统评估不同实体瘤类型中肠道微生物特征（分类学、功能、动态变化）与 ICI 临床结局（ORR, PFS, OS）的观察性关联，明确证据强度、肿瘤特异性及外部干扰因素，避免将相关性误读为因果性或普适性生物标志物。 涵盖黑色素瘤、NSCLC、RCC、CRC、HCC 等主要实体瘤的回顾性与前瞻性队列研究；包括 16S rRNA、宏基因组及代谢组数据；区分基线特征与治疗期间动态变化；纳入阴性或矛盾结果以平衡证据；排除无微生物组数据的纯临床研究及非 ICI 疗法（如 CAR-T）研究。\",\n        \"reading_mode\": \"focused_local_search\"\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0081\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\\\\6306ccac684d884f60ffc329cc05a0e0\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-ba354d40740f64366cbf\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-403bce67afb0fdb07c1f\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-8c71e871c7aa5482d545\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-f85da31c482f020fe5f7\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-a7a6e9bd3a48b1fef12e\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-12c6cac6a4bef2539d08\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-02faf8b9fedd6313c05e\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-970b424322e405f5652d\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          },\n          {\n            \"asset_id\": \"asset-f4e5574773433f48fdb6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\\\\6306ccac684d884f60ffc329cc05a0e0\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0402\",\n      \"title\": \"THE IMPACT OF ANTIBIOTIC THERAPY ON THE EFFECTIVENESS OF IMMUNOTHERAPY: A REVIEW OF CURRENT EVIDENCE\",\n      \"year\": \"2026\",\n      \"doi\": \"10.31435/ijitss.1(49).2026.4882\",\n      \"paper_id\": \"affb01ce6dd2c0ea0909edc814fd8af01596e021\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [\n        \"P0576\"\n      ],\n      \"study_summary_A\": {\n        \"approach\": \"采用叙述性综述方法。通过PubMed/MEDLINE、Embase和Web of Science数据库进行聚焦式文献检索，关键词包括“antibiotics”、“immune checkpoint inhibitors”、“PD-1/PD-L1”、“CTLA-4”、“gut microbiome”和“cancer”。纳入标准包括相关的临床前研究、回顾性和前瞻性临床队列以及高质量综述。由于研究设计、肿瘤类型和抗生素暴露定义存在显著异质性，作者未采用正式的系统评价框架，而是对发现进行叙述性综合和分析。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"系统性地综合了截至2026年的临床前和临床证据，确立了抗生素暴露（特别是ICI前短期暴露）与ICI疗效降低之间的一致性关联，强调了时间窗口的重要性。\",\n            \"limits\": \"主要依赖回顾性观察性数据，无法确立因果关系；存在显著的异质性（暴露定义、肿瘤类型、混杂因素）；缺乏常规微生物组 profiling 数据以直接关联微生物变化与临床结果；可能存在发表偏倚。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"多肿瘤类型回顾性队列及荟萃分析\",\n            \"finding\": \"抗生素暴露与较差的临床结果一致相关，包括无进展生存期（PFS）、总生存期（OS）和治疗反应率（RR/ORR）降低，以及疾病进展（PD）风险增加。\"\n          },\n          {\n            \"conditions\": \"抗生素给药时间与ICI启动的关系\",\n            \"finding\": \"负面关联在ICI启动前短期内（如30天内）给予抗生素时最为明显；而ICI启动后或治疗期间的抗生素使用对生存影响的证据较弱或不一致。\"\n          },\n          {\n            \"conditions\": \"不同肿瘤类型\",\n            \"finding\": \"在黑色素瘤、非小细胞肺癌（NSCLC）和肾细胞癌（RCC）中观察到一致的负面信号；但在肝细胞癌（HCC）中，由于肝硬化、感染风险和肠-肝轴功能障碍，情况更为复杂，混杂因素更多。\"\n          },\n          {\n            \"conditions\": \"微生物组干预研究\",\n            \"finding\": \"早期转化研究和早期干预试验表明，通过粪便微生物移植（FMT）等方式调节肠道微生物群可能部分恢复对ICI的反应性，提供概念验证证据。\"\n          }\n        ],\n        \"paper_kind\": \"review\",\n        \"problem_or_question\": \"尽管免疫检查点抑制剂改变了癌症治疗格局，但仅部分患者获得持久获益。鉴于肠道微生物群在调节抗肿瘤免疫中的关键作用，抗生素通过破坏微生物稳态可能负面影响免疫治疗的有效性。本研究旨在解决：抗生素暴露如何具体影响ICI疗效？其背后的生物学机制是什么？不同肿瘤类型和时间窗口下的效应是否一致？\",\n        \"research_scope\": \"该综述聚焦于实体瘤患者接受免疫检查点抑制剂（ICIs）治疗期间，抗生素暴露对治疗疗效的影响。研究对象涵盖多种实体瘤类型（如黑色素瘤、非小细胞肺癌、肾细胞癌、肝细胞癌等），情境包括临床回顾性队列、前瞻性观察研究及荟萃分析，旨在综合评估抗生素使用与ICI疗效之间的关联及其潜在机制。\",\n        \"work_summary\": \"本文是一篇叙述性综述，旨在综合当前关于抗生素暴露如何影响免疫检查点抑制剂（ICIs）疗效的临床前和临床证据。文章首先回顾了肠道微生物群在调节抗肿瘤免疫反应中的关键作用，随后系统梳理了多项回顾性临床研究、肿瘤特异性验证研究以及系统性综述和荟萃分析的结果。研究发现，抗生素暴露（尤其是ICI启动前的短期暴露）与较差的临床结局（如无进展生存期缩短、总生存期降低和治疗反应率下降）一致相关。文章还讨论了这种关联在不同肿瘤类型中的表现差异、时间依赖性特征，并指出目前证据主要基于观察性数据，存在混杂因素，但支持谨慎使用抗生素以优化免疫治疗效果的临床建议。\"\n      },\n      \"review_planning_B\": {\n        \"planning_summary\": \"该综述为理解肠道微生物群介导的抗生素对ICI疗效的影响提供了全面的临床证据背景和机制解释。它特别适用于回答抗生素暴露的时间依赖性、不同实体瘤类型的敏感性差异，以及从观察性关联到潜在因果机制（微生物组失调）的逻辑链条。虽然不能提供直接的因果证明，但其综合的荟萃分析和叙述性证据是构建‘微生物群-免疫-药物’相互作用综述的关键背景素材。\",\n        \"facet_contributions\": [\n          {\n            \"boundaries\": \"这些是观察性关联，受混杂因素（如感染严重程度、基线健康状况）影响，不能直接证明抗生素是导致疗效降低的唯一原因。\",\n            \"contribution\": \"提供了抗生素暴露与ICI疗效负相关的大规模临床证据汇总，包括多个荟萃分析的数据（如Tsikala-Vafea 2021, Wu 2021, Crespin 2023等），证实了跨肿瘤类型的一致性信号。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于支持综述中关于‘抗生素暴露普遍降低ICI疗效’的观察性证据部分，特别是量化效应大小和一致性。\"\n          },\n          {\n            \"boundaries\": \"不同研究对‘短期’的定义不一（30天、60天等），且多为回顾性数据，精确的时间阈值尚不明确。\",\n            \"contribution\": \"详细分析了抗生素暴露的时间依赖性，指出ICI启动前短期暴露（<30天）的负面影响最显著，而治疗期间暴露的影响较弱或不一致。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于阐述‘时机’作为关键调节变量的重要性，指导未来研究中暴露定义的标准化。\"\n          },\n          {\n            \"boundaries\": \"人类临床数据中缺乏直接的微生物组-临床结局关联证据，机制主要外推自动物模型和小规模转化研究。\",\n            \"contribution\": \"阐述了潜在的生物学机制：抗生素导致有益菌丢失、微生物多样性降低和代谢改变，进而损害树突状细胞成熟、CD8+ T细胞 priming 和肿瘤内淋巴细胞浸润，最终削弱ICI疗效。引用了关键的临床前研究（Vétizou et al., Routy et al.）。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"用于解释‘为什么’抗生素会影响ICI疗效，提供从微生物组失调到免疫抑制的机制路径。\"\n          },\n          {\n            \"boundaries\": \"样本量小，探索性设计，尚未成为标准护理，不能代表所有患者的可逆性。\",\n            \"contribution\": \"提到了粪菌移植（FMT）等微生物组干预措施在部分患者中恢复ICI敏感性的概念验证证据。\",\n            \"facet_id\": \"F2\",\n            \"possible_uses\": \"作为反向证据，支持微生物组在ICI疗效中的因果角色，并提示可能的干预策略。\"\n          },\n          {\n            \"boundaries\": \"中性结果可能源于样本量不足、暴露定义差异或未充分调整的混杂因素。\",\n            \"contribution\": \"指出了特定肿瘤类型（如HCC）中混杂因素的复杂性，以及某些研究（如Kaderbhai 2017）中的中性结果。\",\n            \"facet_id\": \"F1\",\n            \"possible_uses\": \"用于讨论效应的异质性和情境依赖性，避免过度概括抗生素的负面影响。\"\n          }\n        ],\n        \"broader_review_uses\": [\n          {\n            \"connection_to_review\": \"可作为综述中关于‘临床意义’或‘未来方向’部分的背景信息，强调平衡感染风险与免疫治疗获益的现实挑战。\",\n            \"material\": \"综述讨论了抗生素管理（antibiotic stewardship）在ICI治疗患者中的重要性，建议谨慎使用抗生素，特别是在ICI启动前，但不主张在有明确指征时 withhold antibiotics。\",\n            \"purpose\": \"提供临床实践背景和建议\"\n          },\n          {\n            \"connection_to_review\": \"可用于综述的‘局限性’或‘未来展望’部分，说明当前证据等级的不足及亟需的研究设计改进。\",\n            \"material\": \"综述明确指出需要前瞻性、整合微生物组分析的队列研究，以标准化抗生素暴露定义（种类、剂量、持续时间、指征），并探索CAR-T等其他免疫疗法中的类似效应。\",\n            \"purpose\": \"识别知识空白和未来研究方向\"\n          },\n          {\n            \"connection_to_review\": \"可用于讨论‘抗生素特性’作为潜在调节变量，提示未来研究应细化抗生素分类分析。\",\n            \"material\": \"指出大多数研究未能区分抗生素类别的具体效应，尽管β-内酰胺类和氟喹诺酮类常用，但宽谱抗生素的影响可能更大，窄谱或短疗程的影响尚待验证。\",\n            \"purpose\": \"提供抗生素类别特异性的现状\"\n          }\n        ],\n        \"scope_interpretation_cautions\": [\n          \"该综述的证据基础主要是回顾性观察性研究，因此其发现的‘关联’不等于‘因果’。在将其用于支持因果机制时，必须明确标注这是基于观察性数据的假设，而非确证。\",\n          \"不同研究对‘抗生素暴露’的定义（时间窗口、累积剂量、类别）存在显著异质性，直接比较或合并效应大小时需谨慎，需注意方法学差异带来的偏差。\",\n          \"对于肝细胞癌（HCC）等复杂病例，混杂因素（如肝硬化、感染）可能独立影响预后，因此该人群中的观察结果可能高估或低估抗生素的真实效应。\",\n          \"微生物组机制的解释主要基于临床前模型和小规模转化研究，人类临床数据中缺乏直接的微生物组-临床结局配对分析，因此机制部分属于‘生物合理性’而非‘直接实证’。\"\n        ],\n        \"topic_handles\": [\n          \"antibiotic exposure timing (pre-ICI vs. concurrent)\",\n          \"tumor type specificity (melanoma, NSCLC, RCC, HCC)\",\n          \"clinical outcomes (PFS, OS, ORR)\",\n          \"gut microbiome dysbiosis mechanism\",\n          \"confounding by indication\",\n          \"fecal microbiota transplantation (FMT) as counter-intervention\"\n        ]\n      },\n      \"deep_read_material\": {\n        \"_progressive_task_signature\": \"3ed0816849d971a5\",\n        \"paper_title\": \"THE IMPACT OF ANTIBIOTIC THERAPY ON THE EFFECTIVENESS OF IMMUNOTHERAPY: A REVIEW OF CURRENT EVIDENCE\",\n        \"plain_text\": \"\",\n        \"question_material\": [\n          {\n            \"examples\": [\n              {\n                \"attribution\": \"Derosa et al. (2018)\",\n                \"conditions\": \"回顾性多中心分析；RCC患者（N=121）接受抗PD-(L)1治疗，NSCLC患者（N=239）接受抗PD-(L)1治疗；抗生素定义为ICI启动前≤60天使用。\",\n                \"finding\": \"在晚期肾细胞癌（RCC）和非小细胞肺癌（NSCLC）患者中，ICI启动前30天内使用抗生素与更短的无进展生存期（PFS）和总生存期（OS）相关。在RCC中，抗生素暴露还与更高的原发性疾病进展率相关；而在NSCLC中，多变量调整后仅OS显著缩短，PFS不显著。\",\n                \"reference_ids\": [\n                  \"R11\"\n                ],\n                \"use_in_review\": \"提供早期临床证据，显示抗生素暴露与免疫治疗预后不良相关，并指出不同肿瘤类型中PFS和OS的差异，为时间窗口效应提供初步背景。\"\n              },\n              {\n                \"attribution\": \"Pinato et al. (2019)\",\n                \"conditions\": \"前瞻性多中心队列研究；196名接受ICI治疗的实体瘤患者（包括NSCLC和黑色素瘤）；严格区分pATB（ICI前30天）和cATB（ICI期间）。\",\n                \"finding\": \"仅在ICI启动前30天内使用的抗生素（pATB）与显著的预后不良（OS缩短、反应率降低）相关；而ICI期间同时使用的抗生素（cATB）与生存受损无关。这种关联在调整抗生素类别、体能状态和皮质类固醇使用后仍然显著。\",\n                \"reference_ids\": [\n                  \"R10\"\n                ],\n                \"use_in_review\": \"直接回答关于“预处理 vs 同时暴露”的问题，明确区分了两种暴露时间窗对预后的不同影响，是支持时间依赖性效应的关键研究。\"\n              },\n              {\n                \"attribution\": \"Chorti et al. (2024)\",\n                \"conditions\": \"大型多中心回顾性队列；578名接受一线抗PD-1治疗的初治晚期黑色素瘤患者；抗生素定义为ICI前或期间≤60天使用。\",\n                \"finding\": \"ICI启动前60天内使用抗生素独立关联于更差的PFS和OS；而ICI开始后使用抗生素未与预后受损相关。\",\n                \"reference_ids\": [\n                  \"R17\"\n                ],\n                \"use_in_review\": \"在高度免疫敏感的黑色素瘤中验证时间依赖性效应，进一步支持预处理暴露是关键风险因素，而同时暴露无影响。\"\n              },\n              {\n                \"attribution\": \"Alshammari et al. (2024)\",\n                \"conditions\": \"多中心回顾性研究；59名接受Nivolumab治疗的Child-Pugh A级或早期B级肝硬化HCC患者；抗生素定义为与Nivolumab同时使用。\",\n                \"finding\": \"在Child-Pugh A级晚期肝细胞癌患者中，与抗PD-1治疗同时使用抗生素与OS降低相关。\",\n                \"reference_ids\": [\n                  \"R20\"\n                ],\n                \"use_in_review\": \"提供特定肿瘤类型（HCC）中同时暴露影响的证据，作为对比案例，显示在某些复杂临床背景下同时暴露也可能有害，但需谨慎解释。\"\n              },\n              {\n                \"attribution\": \"Tsikala-Vafea et al. (2021)\",\n                \"conditions\": \"系统综述与Meta分析；12,794名ICI治疗患者；抗生素定义为ICI期间或之后<1个月，或ICI之前>1个月使用。\",\n                \"finding\": \"抗生素暴露与多种肿瘤类型ICI治疗患者的较差OS和PFS显著相关。\",\n                \"reference_ids\": [\n                  \"R25\"\n                ],\n                \"use_in_review\": \"通过Meta分析提供抗生素暴露与预后不良之间关联强度的定量证据，尽管存在异质性，但信号稳健。\"\n              },\n              {\n                \"attribution\": \"Crespin et al. (2023)\",\n                \"conditions\": \"系统综述与Meta分析；超过41,000名ICI治疗癌症患者；抗生素定义多样，主要关注ICI启动前后。\",\n                \"finding\": \"ICI启动前后的抗生素暴露一致关联于较差的OS和PFS、较低的客观缓解率（ORR）以及更高的疾病进展（PD）风险，且在ICI启动前后不久给药时负面效应最强。\",\n                \"reference_ids\": [\n                  \"R27\"\n                ],\n                \"use_in_review\": \"提供最大规模的Meta分析证据，确认抗生素暴露（特别是围治疗期）与OS、PFS、ORR降低及PD风险增加的相关性，强化证据强度。\"\n              }\n            ],\n            \"explanation\": \"关于抗生素类别特异性效应的共识：目前大多数回顾性研究和Meta分析并未发现抗生素类别之间存在统计学上的显著差异，这主要归因于统计效能不足、暴露定义异质性以及缺乏详细的累积剂量和持续时间报告。然而，文献指出β-内酰胺类和氟喹诺酮类是最常用的抗生素，且已知它们对肠道微生物多样性有深远且持久的影响。作者推测，抗生素的作用谱（spectrum of activity）而非抗生素类别本身可能是干扰免疫治疗的关键决定因素。窄谱抗生素或较短疗程可能在理论上具有较少的负面免疫调节作用，但这一假设在临床环境中尚未得到充分验证。\\n\\n关于预处理与同时暴露的证据强度：现有临床证据强烈支持时间依赖性效应。预处理暴露（通常在ICI启动前30-60天内） consistently 与预后不良（OS和PFS缩短、原发性耐药增加）相关，而同时暴露（concurrent exposure）的影响则更具可变性，部分研究显示无显著影响，部分在特定复杂背景下（如HCC）显示负面影响。这种时间关系的生物学合理性在于，早期的微生物群破坏可能损害免疫治疗启动时的免疫 priming（致敏），而随后的扰动可能影响较小。Meta分析提供了强有力的定量支持，证实了这一关联的稳健性，尽管由于观察性数据的局限性，因果关系仍不能最终确立。\",\n            \"question_id\": \"Q01\",\n            \"remaining_points\": [\n              \"抗生素类别特异性效应的确切机制尚不明确，需要前瞻性试验系统评估抗生素类别、作用谱、持续时间和时间与ICI启动的关系。\",\n              \"感染严重程度和适应症混杂因素难以完全排除，限制了因果推断。\",\n              \"微生物组 profiling 在大多数临床研究中未常规进行，阻碍了抗生素诱导的微生物变化与免疫治疗结果之间的直接相关性分析。\"\n            ]\n          }\n        ],\n        \"reading_mode\": \"focused_local_search\",\n        \"source_hash\": \"5a84d9b9e8e0751d548b0e90497719e1a2b215be9f48988122ba7ffda29caee6\"\n      },\n      \"deep_read_material_trimmed\": {\n        \"dropped_keys\": {\n          \"material_ready\": 4,\n          \"paper_id\": 20,\n          \"references\": 5040,\n          \"reused_from\": 183,\n          \"review_id\": 23,\n          \"schema_version\": 46,\n          \"status\": 16,\n          \"task_id\": 34,\n          \"workflow\": 21\n        },\n        \"dropped_chars\": 5387,\n        \"note\": \"深读材料里的记账字段与论文自带的参考文献表已省略；科学内容（问句材料/发现/条件）保留。需要时可用 locator 读原文。\"\n      },\n      \"supplement_material\": {\n        \"auxiliary_material\": [\n          {\n            \"content\": \"Preclinical models (Vétizou et al., Routy et al., Sivan et al.) demonstrate that commensal bacteria influence antigen presentation, dendritic cell maturation, and CD8+ T-cell priming. Antibiotic-induced dysbiosis disrupts these processes, leading to impaired immune surveillance. FMT from responders can restore sensitivity to PD-1 blockade in refractory patients (Davar et al., Kim et al.).\",\n            \"type\": \"Mechanism\"\n          },\n          {\n            \"content\": \"Evidence consistently suggests that the detrimental association is most pronounced when antibiotics are administered shortly before ICI initiation (pre-treatment window). Concurrent or post-treatment exposure shows more variable or null effects in several studies (e.g., Pinato 2019, Chorti 2024).\",\n            \"type\": \"Timing Specificity\"\n          },\n          {\n            \"content\": \"Most retrospective studies did not detect statistically significant differences between antibiotic categories (beta-lactams, fluoroquinolones). It is unclear if specific classes drive the effect or if broad-spectrum activity/spectrum of activity is the critical determinant. Few studies accounted for infection severity or indication.\",\n            \"type\": \"Unresolved Question: Antibiotic Class\"\n          },\n          {\n            \"content\": \"Judicious antibiotic stewardship is recommended, particularly avoiding unnecessary/prolonged exposure in the peri-immunotherapy period. However, antibiotics should not be withheld when clinically indicated due to severe infection risk.\",\n            \"type\": \"Clinical Implication\"\n          }\n        ],\n        \"evidence\": [],\n        \"gap_id\": \"ici_antibiotic_exposure_outcomes\",\n        \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\planning_support\\\\20260923\\\\practical_refresh\\\\supplement_live\\\\source_units\\\\SU02_search_candidate_b202b1e76f\\\\FULFILLMENT_JUDGMENT.json\",\n        \"limitations\": [],\n        \"material_ready\": true,\n        \"material_usefulness\": \"direct\",\n        \"outline_action\": \"Use the provided material to construct the section on 'Clinical Evidence of Antibiotic Impact on ICI Outcomes'. Structure by timing (prior vs. concurrent) and tumor type (Melanoma, NSCLC, RCC, HCC). Highlight the consistent signal of reduced PFS/OS with pre-treatment exposure. Explicitly note the limitations regarding confounding by indication and the lack of causal proof despite biological plausibility. Include the neutral finding from Kaderbhai to illustrate heterogeneity. Use the auxiliary mechanism material to support the biological rationale for the observed associations.\",\n        \"outline_action_recovered_by_policy\": false,\n        \"remaining_gap\": \"['The gap question asks how adjustment for clinical confounding affects interpretation. While this review provides adjusted results for several key studies (e.g., Pinato 2019, Derosa 2018), it explicitly states that causality cannot be definitively established due to confounding by indication (infection severity, baseline fitness) which may not be fully captured in multivariate models. The review does not provide a comprehensive synthesis of *how* different adjustment strategies across all available literature alter the magnitude of the effect size compared to unadjusted estimates, nor does it resolve the extent of residual confounding.', 'The specific contribution of antibiotic *class* or *spectrum* remains unresolved, as the review notes insufficient power and reporting in existing studies to determine class-specific effects.']\",\n        \"remaining_gap_recovered_by_policy\": false,\n        \"status\": \"partial\",\n        \"useful_material\": [\n          {\n            \"conditions\": \"Antibiotic exposure within 30 days prior to ICI initiation\",\n            \"findings\": \"In RCC, associated with shorter PFS and higher primary progressive disease. In NSCLC, independently associated with shorter OS but not PFS after multivariate adjustment.\",\n            \"limits\": \"Retrospective design; confounding by indication.\",\n            \"method\": \"Multicenter retrospective cohort; anti-PD-(L)1 therapy\",\n            \"population\": \"Advanced renal cell carcinoma (RCC) and non-small cell lung cancer (NSCLC)\",\n            \"study\": \"Derosa et al. (2018)\"\n          },\n          {\n            \"conditions\": \"Distinction between prior antibiotic exposure (pATB, ≤30 days before ICI) and concurrent use (cATB)\",\n            \"findings\": \"Only pATB was associated with significantly worse OS and poorer response across multiple tumor types (including NSCLC and melanoma). Associations remained significant after adjustment for antibiotic class, performance status, and corticosteroid use in multivariate and propensity score analyses. cATB was not associated with impaired survival.\",\n            \"limits\": \"Observational; residual confounding possible.\",\n            \"method\": \"Prospective, multicenter cohort; routine clinical practice ICIs\",\n            \"population\": \"196 unselected patients with various solid tumors\",\n            \"study\": \"Pinato et al. (2019)\"\n          },\n          {\n            \"conditions\": \"Antibiotic exposure within 30 days prior to ICI initiation\",\n            \"findings\": \"Associated with significantly shorter PFS and higher likelihood of primary resistance. Multivariate analysis confirmed antibiotic exposure as an independent predictor of shorter PFS. OS difference was not statistically significant.\",\n            \"limits\": \"Sample size limitations for OS analysis.\",\n            \"method\": \"Retrospective study\",\n            \"population\": \"Advanced melanoma treated with anti-PD-1 or anti-CTLA-4\",\n            \"study\": \"Elkrief et al. (2019)\"\n          },\n          {\n            \"conditions\": \"Various definitions of antibiotic exposure around ICI initiation\",\n            \"findings\": \"Consistently associated with inferior OS, PFS, reduced ORR, and increased PD. Strongest negative effects observed when antibiotics administered shortly before or after treatment initiation.\",\n            \"limits\": \"Predominance of retrospective data; heterogeneity in exposure definitions; potential publication bias; precludes definitive causal inference.\",\n            \"method\": \"Systematic reviews and meta-analyses of retrospective cohorts\",\n            \"population\": \"Multiple tumor types (Meta-analyses encompassing >41,000 patients)\",\n            \"study\": \"Tsikala-Vafea et al. (2021); Wu et al. (2021); Crespin et al. (2023)\"\n          },\n          {\n            \"conditions\": \"Antibiotic exposure within 60 days prior to treatment initiation vs. after start\",\n            \"findings\": \"Prior exposure independently associated with worse PFS and OS. Antibiotic use after immunotherapy start was not associated with impaired outcomes.\",\n            \"limits\": \"Residual confounding inherent to retrospective analyses.\",\n            \"method\": \"Large multicenter retrospective cohort\",\n            \"population\": \"Treatment-naïve advanced melanoma receiving first-line anti-PD-1\",\n            \"study\": \"Chorti et al. (2024)\"\n          },\n          {\n            \"conditions\": \"Antibiotic exposure ±30 days or concurrent with ICIs/targeted therapies\",\n            \"findings\": \"Antibiotic exposure associated with shorter PFS and OS across treatment modalities. Non-treatment-specific effect noted in Pinato (2023), highlighting vulnerability due to cirrhosis/infection risk. Alshammari (2024) found concurrent exposure associated with reduced OS.\",\n            \"limits\": \"Complex clinical context of HCC (cirrhosis, gut-liver axis dysfunction); retrospective design precludes complete control of confounding.\",\n            \"method\": \"Retrospective analyses (trial database and multicenter)\",\n            \"population\": \"Hepatocellular carcinoma (HCC); Alshammari restricted to Child-Pugh class A/early B\",\n            \"study\": \"Pinato et al. (2023); Alshammari et al. (2024)\"\n          },\n          {\n            \"conditions\": \"Antibiotic exposure ≤3 months before or during ICI\",\n            \"findings\": \"No significant impact on response rates or PFS (neutral finding).\",\n            \"limits\": \"Limited sample size; highlights heterogeneity and context-dependence.\",\n            \"method\": \"Retrospective study\",\n            \"population\": \"NSCLC treated with nivolumab\",\n            \"study\": \"Kaderbhai et al. (2017)\"\n          }\n        ]\n      },\n      \"local_passages\": {\n        \"external_calls\": 0,\n        \"passages\": [\n          {\n            \"best_sentence\": \"a-analysis 12794 ICIs <1 month during or after ICI initiation, >1 month prior to ICI initiation ↓ OS ↓ PFS ↓RR ↑ PD Wu (2021) Multiple Meta-analysis 12492 ICIs Various ↓ OS, ↓ PFS, ↓ ORR Crespin (2023) Multiple Systematic review & meta-analysis 41663 ICIs Various ↓ OS, ↓ PFS, ↓ ORR, ↑ PD Alotaibi (2024) GI tumors Systematic review & meta-analysis 2214 ICIs Various ↓ OS and ↓ PFS Huo (2021) NSCLC Meta-analysis 787 Nivolumab Various ↓ OS, and ↓ PFS Jiang (2022) Multiple Meta-analysis 6010 ICIs Various ↓ OS and ↓ PFS Luo (2022) RCC Systematic review & meta-analysis 1104 ICIs Various ↓ OS, ↓ PFS, ↓ ORR\",\n            \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\affb01ce6dd2c0ea0909edc814fd8af01596e021\\\\7dd94cc7542d04164a27a4b9e6ca8b88\\\\attempt-01\\\\PAPER_READING_CARD.json\",\n            \"doi\": \"10.31435/ijitss.1(49).2026.4882\",\n            \"limits\": [],\n            \"match_terms\": [\n              \"ici\",\n              \"orr\",\n              \"pfs\",\n              \"os\",\n              \"nsclc\",\n              \"rcc\"\n            ],\n            \"material_depth\": \"fulltext\",\n            \"paper_id\": \"affb01ce6dd2c0ea0909edc814fd8af01596e021\",\n            \"pool_action\": \"already_in_pool\",\n            \"reading_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\materials\\\\affb01ce6dd2c0ea0909edc814fd8af01596e021\\\\snapshot-18e21cac25786d4e299dd59a\",\n            \"score\": 43.0388,\n            \"section_path\": [\n              \"Clinical Evidence\"\n            ],\n            \"segment_kind\": \"document_block\",\n            \"source_handle\": \"P0402\",\n            \"text\": \"(2021) Multiple Systematic review & meta-analysis 12794 ICIs <1 month during or after ICI initiation, >1 month prior to ICI initiation ↓ OS ↓ PFS ↓RR ↑ PD Wu ( a-analysis 12794 ICIs <1 month during or after ICI initiation, >1 month prior to ICI initiation ↓ OS ↓ PFS ↓RR ↑ PD Wu (2021) Multiple Meta-analysis 12492 ICIs Various ↓ OS, ↓ PFS, ↓ ORR Crespin (2023) Multiple Systematic review & meta-analysis 41663 ICIs Various ↓ OS, ↓ PFS, ↓ ORR, ↑ PD Alotaibi (2024) GI tumors Systematic review & meta-analysis 2214 ICIs Various ↓ OS and ↓ PFS Huo (2021) NSCLC Meta-analysis 787 Nivolumab Various ↓ OS, and ↓ PFS Jiang (2022) Multiple Meta-analysis 6010 ICIs Various ↓ OS and ↓ PFS Luo (2022) RCC Systematic review & meta-analysis 1104 ICIs Various ↓ OS, ↓ PFS, ↓ ORR In conclusion, these early retrospective studies consistently reported an association between antibiotic exposure preceding ICI therapy and inferior clinical ou\",\n            \"title\": \"THE IMPACT OF ANTIBIOTIC THERAPY ON THE EFFECTIVENESS OF IMMUNOTHERAPY: A REVIEW OF CURRENT EVIDENCE\",\n            \"usable_fields\": [],\n            \"year\": \"2026\"\n          },\n          {\n            \"best_sentence\": \"多肿瘤类型回顾性队列及荟萃分析\\n抗生素暴露与较差的临床结果一致相关，包括无进展生存期（PFS）、总生存期（OS）和治疗反应率（RR/ORR）降低，以及疾病进展（PD）风险增加。\",\n            \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\affb01ce6dd2c0ea0909edc814fd8af01596e021\\\\7dd94cc7542d04164a27a4b9e6ca8b88\\\\attempt-01\\\\PAPER_READING_CARD.json\",\n            \"doi\": \"10.31435/ijitss.1(49).2026.4882\",\n            \"limits\": [],\n            \"match_terms\": [\n              \"orr\",\n              \"pfs\",\n              \"os\"\n            ],\n            \"material_depth\": \"fulltext\",\n            \"paper_id\": \"affb01ce6dd2c0ea0909edc814fd8af01596e021\",\n            \"pool_action\": \"already_in_pool\",\n            \"reading_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\materials\\\\affb01ce6dd2c0ea0909edc814fd8af01596e021\\\\snapshot-18e21cac25786d4e299dd59a\",\n            \"score\": 12.792042,\n            \"section_path\": [\n              \"general understanding\",\n              \"key finding\"\n            ],\n            \"segment_kind\": \"card_key_finding\",\n            \"source_handle\": \"P0402\",\n            \"text\": \"多肿瘤类型回顾性队列及荟萃分析\\n抗生素暴露与较差的临床结果一致相关，包括无进展生存期（PFS）、总生存期（OS）和治疗反应率（RR/ORR）降低，以及疾病进展（PD）风险增加。 抗生素给药时间与ICI启动的关系\\n负面关联在ICI启动前短期内（如30天内）给予抗生素时最为明显；而ICI启动后或治疗期间的抗生素使用对生存影响的证据较弱或不一致。\",\n            \"title\": \"THE IMPACT OF ANTIBIOTIC THERAPY ON THE EFFECTIVENESS OF IMMUNOTHERAPY: A REVIEW OF CURRENT EVIDENCE\",\n            \"usable_fields\": [],\n            \"year\": \"2026\"\n          }\n        ],\n        \"question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect? 实体瘤中肠道微生物组与 ICI 疗效的临床关联证据 系统评估不同实体瘤类型中肠道微生物特征（分类学、功能、动态变化）与 ICI 临床结局（ORR, PFS, OS）的观察性关联，明确证据强度、肿瘤特异性及外部干扰因素，避免将相关性误读为因果性或普适性生物标志物。 涵盖黑色素瘤、NSCLC、RCC、CRC、HCC 等主要实体瘤的回顾性与前瞻性队列研究；包括 16S rRNA、宏基因组及代谢组数据；区分基线特征与治疗期间动态变化；纳入阴性或矛盾结果以平衡证据；排除无微生物组数据的纯临床研究及非 ICI 疗法（如 CAR-T）研究。\",\n        \"reading_mode\": \"focused_local_search\"\n      },\n      \"locator\": {\n        \"writer_packet\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\writer_packets\\\\Ch1.json\",\n        \"source_handle\": \"P0402\",\n        \"card_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\affb01ce6dd2c0ea0909edc814fd8af01596e021\\\\7dd94cc7542d04164a27a4b9e6ca8b88\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n      },\n      \"card_material\": {\n        \"known_gaps\": [\n          {\n            \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"missing\"\n          },\n          {\n            \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n            \"kind\": \"asset\",\n            \"reason\": \"caption_or_locator_without_readable_image\",\n            \"status\": \"caption_only\"\n          }\n        ],\n        \"material_scope\": \"fulltext\"\n      },\n      \"material_read_from_disk\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\paper_cards\\\\20260922_microbiome_batch\\\\reading\\\\cards\\\\affb01ce6dd2c0ea0909edc814fd8af01596e021\\\\7dd94cc7542d04164a27a4b9e6ca8b88\\\\attempt-01\\\\PAPER_READING_CARD.json\"\n    },\n    {\n      \"source_handle\": \"P0123\",\n      \"title\": \"Non-Small Cell Lung Cancer Patients Treated with Anti-PD1 Immunotherapy Show Distinct Microbial Signatures and Metabolic Pathways According to Clinical Outcomes\",\n      \"year\": \"2022\",\n      \"doi\": \"10.1101/2022.10.05.22280734\",\n      \"paper_id\": \"35f3b135b6c865df8bb304e1f28a8247e55c25fd\",\n      \"material_depth\": \"fulltext\",\n      \"material_status\": \"resolved\",\n      \"aliases\": [],\n      \"study_summary_A\": {\n        \"approach\": \"1. 队列设计：纳入62名接受抗PD-1治疗的晚期NSCLC患者作为发现队列，另设60名患者作为验证队列。记录临床参数（PFS、PD-L1状态、化疗史、合并用药）。 2. 样本处理与测序：收集粪便样本，提取DNA，进行鸟枪法宏基因组测序。 3. 数据分析： - 多样性分析：计算Alpha多样性（Shannon指数）和Beta多样性（UMAP/Permanova）。 - 差异丰度分析：使用Wilcoxon秩和检验比较不同临床分组间的门、属、种水平细菌丰度。 - 网络分析：构建细菌相互作用网络，比较长/短PFS患者的网络拓扑结构差异。 - 多变量建模：使用Lasso回归和Cox比例风险回归建立预测模型，识别独立预测因子。 - 机器学习：使用随机森林（Random Forest）算法评估分类学和代谢通路数据对PFS、PD-L1状态和化疗史的预测性能（AUC）。 - 验证：在独立队列中验证关键物种的预测价值。\",\n        \"contribution_and_limits\": [\n          {\n            \"contribution\": \"提供了针对高加索人种NSCLC患者的详细肠道宏基因组图谱，区分了分类学（预测PFS）和代谢通路（预测PD-L1）的不同预测价值。确认了Alistipes和Barnesiella为正预测因子，Streptococcus和Bifidobacterium为负预测因子，并建立了分层预测模型。\",\n            \"limits\": \"横断面研究设计，无法确定因果关系（是微生物导致疗效差异，还是疾病状态改变了微生物）。样本量相对较小（发现队列n=62），且仅包含高加索人种，外推至其他种族需谨慎。未检测肿瘤组织突变负荷（TMB）。部分结果（如B. adolescentis）在验证队列中未达显著性。\"\n          }\n        ],\n        \"key_findings\": [\n          {\n            \"conditions\": \"长PFS (>6个月) vs 短PFS (≤6个月)\",\n            \"finding\": \"Alpha多样性无显著差异；Beta多样性有显著差异。短PFS患者中厚壁菌门（Firmicutes）和放线菌门（Actinobacteria）丰度增加，F/B比率升高。长PFS与Alistipes shahii, A. finegoldii, Barnesiella visceriola正相关；短PFS与Streptococcus salivarius, S. vestibularis, Bifidobacterium breve正相关。\"\n          },\n          {\n            \"conditions\": \"PD-L1高表达 vs 低表达\",\n            \"finding\": \"Beta多样性无显著差异。PD-L1低表达患者中Euryarcheota丰度较高。代谢通路方面，核苷酸降解、氨基酸合成和发酵通路在PD-L1低表达患者中更丰富。代谢通路比分类学更能预测PD-L1状态（AUC=0.87）。\"\n          },\n          {\n            \"conditions\": \"化疗预处理（CHT-treated）vs 未预处理（CHT-naïve）\",\n            \"finding\": \"两组间Beta多样性有显著差异。CHT处理后患者中氨基酸降解和碳水化合物合成通路增加。CHT预处理本身并未将微生物组推向“短PFS”表型，但CHT-treated患者整体预后略差。\"\n          },\n          {\n            \"conditions\": \"合并用药影响\",\n            \"finding\": \"抗生素使用导致Anaerostipes等减少，Eggerthella增加。抗酸药使用导致链球菌属（如S. salivarius）增加，这与短PFS相关。类固醇使用与变形菌门（Proteobacteria）增加相关。\"\n          }\n        ],\n        \"paper_kind\": \"empirical\",\n        \"problem_or_question\": \"在晚期NSCLC患者中，肠道微生物组的组成（分类学）和功能（代谢通路）是否与抗PD-1免疫治疗的临床疗效（以PFS衡量）及肿瘤PD-L1表达水平存在显著关联？这些微生物特征能否作为预测治疗反应的生物标志物？\",\n        \"research_scope\": \"62名接受抗PD-1免疫治疗（ICI）的晚期非小细胞肺癌（NSCLC）患者（发现队列），以及60名独立验证队列患者。研究对象为高加索人种，样本来源为粪便微生物组。研究情境包括一线化疗前（CHT-naïve）与后续线化疗后（CHT-treated）的治疗背景，以及伴随使用的抗生素、抗酸药和类固醇药物。\",\n        \"work_summary\": \"本研究旨在探究肠道微生物组特征与非小细胞肺癌患者抗PD-1免疫治疗疗效及PD-L1表达之间的关联。研究团队对62名患者进行了宏基因组测序，分析细菌多样性、分类学组成及代谢通路，并将其与无进展生存期（PFS）、PD-L1免疫组化表达及其他临床参数进行相关性分析。通过多变量统计模型筛选关键预测菌种，并在60人的独立队列中进行验证。同时，利用随机森林机器学习算法评估分类学和代谢通路特征对临床结局的预测能力。研究发现特定细菌物种及其代谢功能可作为ICI疗效和PD-L1状态的生物标志物。\"\n      },\n      \"review_planning_B\"
