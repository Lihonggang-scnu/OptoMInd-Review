go.2021.02.001\",\n      \"paper_id\": \"d9c8811c9fe1a30956b5b250c0de876c0e270551\"\n    },\n    \"P0524\": {\n      \"source_id\": \"source::P0524\",\n      \"aliases\": [],\n      \"title\": \"Challenges and knowledge gaps with immune checkpoint inhibitors monotherapy in the management of patients with non-small-cell lung cancer: a survey of oncologist perceptions\",\n      \"doi\": \"10.1016/j.esmoop.2022.100764\",\n      \"paper_id\": \"eb8389aa4db9c7fa1d42d82f39f1ba4436f3b701\"\n    },\n    \"P0323\": {\n      \"source_id\": \"source::P0323\",\n      \"aliases\": [],\n      \"title\": \"The dark matter in cancer immunology: beyond the visible– unveiling multiomics pathways to breakthrough therapies\",\n      \"doi\": \"10.1186/s12967-025-06839-y\",\n      \"paper_id\": \"8a42b4f37f1c7313faa25f37bb036aac0202e1c7\"\n    },\n    \"P0416\": {\n      \"source_id\": \"source::P0416\",\n      \"aliases\": [],\n      \"title\": \"Immune-reactive tumor organoids system to determine the effects of microbial metabolites on cancer immunity and immunotherapies\",\n      \"doi\": \"10.3389/frmbi.2024.1411322\",\n      \"paper_id\": \"b68d0c2836362527000931b8f1fefbb2a4f2dd3b\"\n    },\n    \"P0050\": {\n      \"source_id\": \"source::P0050\",\n      \"aliases\": [],\n      \"title\": \"Artificial intelligence–enabled multi-omics biomarkers for immune checkpoint blockade: mechanisms, predictive modeling, and clinical translation\",\n      \"doi\": \"10.3389/fimmu.2026.1732079\",\n      \"paper_id\": \"164f89ae032b4a17e939d4531f3f7f8ddb4c81ee\"\n    },\n    \"P0054\": {\n      \"source_id\": \"source::P0054\",\n      \"aliases\": [],\n      \"title\": \"Artificial Intelligence–Enabled Multi-Omics for Predicting Immune Checkpoint Inhibitor Response and Resistance\",\n      \"doi\": \"10.2147/jmdh.s572089\",\n      \"paper_id\": \"174066de2e0865cbf905ef36de34933107992fa8\"\n    },\n    \"P0574\": {\n      \"source_id\": \"source::P0574\",\n      \"aliases\": [],\n      \"title\": \"Gut dysbiosis in oncology: a risk factor for immunoresistance\",\n      \"doi\": \"10.1038/s41422-025-01212-6\",\n      \"paper_id\": \"ff5504ec23a09bb1d577854219dadfe3c7772ece\"\n    },\n    \"P0172\": {\n      \"source_id\": \"source::P0172\",\n      \"aliases\": [],\n      \"title\": \"From mechanisms to precision medicine: the role of organoids in studying the gut microbiota-tumor microenvironment axis\",\n      \"doi\": \"10.3389/fmicb.2025.1669482\",\n      \"paper_id\": \"4a8bc3da652bbd783e7ea5c1dbde908e5124c442\"\n    },\n    \"P0532\": {\n      \"source_id\": \"source::P0532\",\n      \"aliases\": [],\n      \"title\": \"Focus on gut microbes: new direction in cancer treatment\",\n      \"doi\": \"10.3389/fonc.2025.1505656\",\n      \"paper_id\": \"ed9f49b6f8cea1ce51cbf797f10d7a01e6835e15\"\n    },\n    \"P0555\": {\n      \"source_id\": \"source::P0555\",\n      \"aliases\": [],\n      \"title\": \"Unveiling the interplay between microbiota and PD1/PD-L1 axis in tumor immunity and immunotherapy\",\n      \"doi\": \"10.3389/fimmu.2025.1690374\",\n      \"paper_id\": \"f661d588e0fee18c37ed1d46fd697c2ad01c4394\"\n    }\n  },\n  \"source_aliases\": {\n    \"P0584\": \"P0333\"\n  },\n  \"shared_fullbody_context\": {\n    \"read_only\": true,\n    \"chapters\": [\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch1\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"实体瘤中肠道微生物组与 ICI 疗效的临床关联证据\",\n          \"chapter_purpose\": \"使读者能够准确评估不同实体瘤类型中肠道微生物特征与 ICI 临床结局的观察性关联强度，理解外部干扰因素与纵向动态对关联强度的修饰作用，并清晰区分当前证据的阶梯分布（从强观察性关联到弱干预性概念验证），避免将相关性误读为因果性或普适性生物标志物。\",\n          \"chapter_scope\": \"跨癌种观察性队列证实特定肠道微生物特征（分类学与功能通路）与 ICI 疗效存在显著关联，但缺乏普适性单一标志物；外部药物暴露（抗生素、PPIs）及联合治疗方案构成关键修饰变量，其影响具有明确的时间窗口特异性；基线单次采样难以捕捉治疗诱导的生态重塑，纵向动态变化比静态丰度更能反映真实疗效轨迹；当前证据呈现明显的阶梯状分布，概念验证性干预显示初步希望但异质性大，Phase III RCT 证据完全缺失，且安全性信号受 ICI 方案严格调节。\",\n          \"chapter_thesis\": \"跨癌种观察性队列证实特定肠道微生物特征（分类学与功能通路）与 ICI 疗效存在显著关联，但缺乏普适性单一标志物；外部药物暴露（抗生素、PPIs）及联合治疗方案构成关键修饰变量，其影响具有明确的时间窗口特异性；基线单次采样难以捕捉治疗诱导的生态重塑，纵向动态变化比静态丰度更能反映真实疗效轨迹；当前证据呈现明显的阶梯状分布，概念验证性干预显示初步希望但异质性大，Phase III RCT 证据完全缺失，且安全性信号受 ICI 方案严格调节。\",\n          \"chapter_argument\": \"跨癌种观察性队列证实特定肠道微生物特征（分类学与功能通路）与 ICI 疗效存在显著关联，但缺乏普适性单一标志物；外部药物暴露（抗生素、PPIs）及联合治疗方案构成关键修饰变量，其影响具有明确的时间窗口特异性；基线单次采样难以捕捉治疗诱导的生态重塑，纵向动态变化比静态丰度更能反映真实疗效轨迹；当前证据呈现明显的阶梯状分布，概念验证性干预显示初步希望但异质性大，Phase III RCT 证据完全缺失，且安全性信号受 ICI 方案严格调节。\",\n          \"reader_objective\": \"使读者能够准确评估不同实体瘤类型中肠道微生物特征与 ICI 临床结局的观察性关联强度，理解外部干扰因素与纵向动态对关联强度的修饰作用，并清晰区分当前证据的阶梯分布（从强观察性关联到弱干预性概念验证），避免将相关性误读为因果性或普适性生物标志物。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"U1_跨癌种关联图谱\",\n            \"focus\": \"跨癌种观察性队列证实特定肠道微生物特征（分类学与功能通路）与 ICI 疗效存在显著关联，但缺乏普适性单一标志物，证据强度呈癌种特异性分布。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U1_跨癌种关联图谱_P01\",\n                \"point\": \"展示跨癌种共性信号与癌种特异性分布\",\n                \"development\": \"先列举黑色素瘤、NSCLC、RCC 等队列中反复出现的阳性信号（如 Akkermansia muciniphila、Bifidobacterium longum、Faecalibacterium prausnitzii 富集及高α多样性），随后指出结直肠癌与肝细胞癌中部分信号反转或失效，说明证据强度呈癌种特异性分布。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0096\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 NSCLC 背景下跨癌种的微生物特征清单，指出特定菌属富集与疗效正相关但存在阈值风险\"\n                  },\n                  {\n                    \"source_handle\": \"P0146\",\n                    \"role\": \"背景\",\n                    \"use\": \"作为基础资源映射肠道微生物组组成与 ICI 疗效在实体瘤中的关系，提供特定微生物标记物\"\n                  },\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 JCOG2007 辅助研究数据，说明方案特异性及基线微生物与疗效关联\"\n                  },\n                  {\n                    \"source_handle\": \"P0298\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 NSCLC 与黑色素瘤的大样本荟萃分析数据，量化高α多样性及特定菌富集对 ICI 生存期的正向预后效应\"\n                  },\n                  {\n                    \"source_handle\": \"P0204\",\n                    \"role\": \"例证\",\n                    \"use\": \"展示 HCC 多界微生物组特征，揭示细菌/代谢物在持久获益与非获益组间的显著差异而真菌差异较小\"\n                  },\n                  {\n                    \"source_handle\": \"P0270\",\n                    \"role\": \"比较\",\n                    \"use\": \"报道 mCRPC 患者中 A. muciniphila 丰度与 ICI 疗效呈负相关，挑战跨癌种通用正相关假设\"\n                  },\n                  {\n                    \"source_handle\": \"P0393\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供多界微生物组整合分析证据，证实高多样性及特定属组合与 ICI 疗效正相关，补充单一细菌视角的局限\"\n                  },\n                  {\n                    \"source_handle\": \"P0565\",\n                    \"role\": \"例证\",\n                    \"use\": \"系统综述黑色素瘤数据，揭示真菌失调与较差预后的关联，论证多界微生物生态对 ICI 疗效的综合调节作用\"\n                  },\n                  {\n                    \"source_handle\": \"P0545\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供波兰队列中饮食模式与特定菌群协同影响抗 PD-1 疗效的实证，支撑微生物标志物具有人群与生活方式依赖性\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U1_跨癌种关联图谱_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U1_跨癌种关联图谱_P01\",\n                    \"unit_id\": \"U1_跨癌种关联图谱\",\n                    \"ordinal\": 1,\n                    \"point\": \"展示跨癌种共性信号与癌种特异性分布\",\n                    \"development\": \"先列举黑色素瘤、NSCLC、RCC 等队列中反复出现的阳性信号（如 Akkermansia muciniphila、Bifidobacterium longum、Faecalibacterium prausnitzii 富集及高α多样性），随后指出结直肠癌与肝细胞癌中部分信号反转或失效，说明证据强度呈癌种特异性分布。\",\n                    \"source_handles\": [\n                      \"P0096\",\n                      \"P0146\",\n                      \"P0585\"\n                    ],\n                    \"finding_conditions\": \"在黑色素瘤、NSCLC 和 RCC 队列中，Akkermansia muciniphila、Bifidobacterium longum 及 Faecalibacterium prausnitzii 富集与更好的 ICI 预后相关（P0096, P0146）；但在肝细胞癌及部分结直肠癌队列中，相同信号失效或反转（P0585）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U1_跨癌种关联图谱_P02\",\n                \"point\": \"解释跨队列异质性与“无通用标志物”的统计依据\",\n                \"development\": \"引用 PERMANOVA 分析结果，证明“队列”本身是解释微生物群落组成变异的最大因素（解释方差远超临床参数），机器学习跨队列泛化能力极差（留一法交叉验证平均 AUC-ROC 仅为 0.59-0.60），确认黑色素瘤 ICI 反应中微生物关联的复杂性和队列依赖性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0478\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供跨队列荟萃分析结果，证明队列本身是解释微生物群落组成变异的最大因素，机器学习跨队列泛化能力极差\"\n                  },\n                  {\n                    \"source_handle\": \"P0170\",\n                    \"role\": \"主论据\",\n                    \"use\": \"揭示微生物标志物的肠型特异性，解释为何单一物种难以成为普适性生物标志物\"\n                  },\n                  {\n                    \"source_handle\": \"P0289\",\n                    \"role\": \"主论据\",\n                    \"use\": \"基于 SCRUM-Japan 大规模队列证实整体α多样性与 ICI 疗效无普遍关联，为无通用标志物提供关键反例\"\n                  },\n                  {\n                    \"source_handle\": \"P0364\",\n                    \"role\": \"发展\",\n                    \"use\": \"提出功能趋同理论框架，解释分类学不一致背后的共享免疫通路，支持向基于功能的生物标志物开发转型\"\n                  },\n                  {\n                    \"source_handle\": \"P0437\",\n                    \"role\": \"发展\",\n                    \"use\": \"展示基因水平微生物丰度结合生物先验知识在预测 ICI 反应中优于传统分类学特征\"\n                  },\n                  {\n                    \"source_handle\": \"P0511\",\n                    \"role\": \"主论据\",\n                    \"use\": \"基于转移性黑色素瘤宏基因组荟萃分析，确认维生素 B 代谢通路富集与响应正相关，为功能趋同提供跨队列统计支持\"\n                  },\n                  {\n                    \"source_handle\": \"P0015\",\n                    \"role\": \"比较\",\n                    \"use\": \"证明菌株级签名在联合免疫治疗中具有泛癌种预测力，但在单药队列中失效，直接支撑缺乏普适性单一标志物的核心论点\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U1_跨癌种关联图谱_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U1_跨癌种关联图谱_P02\",\n                    \"unit_id\": \"U1_跨癌种关联图谱\",\n                    \"ordinal\": 2,\n                    \"point\": \"解释跨队列异质性与“无通用标志物”的统计依据\",\n                    \"development\": \"引用 PERMANOVA 分析结果，证明“队列”本身是解释微生物群落组成变异的最大因素（解释方差远超临床参数），机器学习跨队列泛化能力极差（留一法交叉验证平均 AUC-ROC 仅为 0.59-0.60），确认黑色素瘤 ICI 反应中微生物关联的复杂性和队列依赖性。\",\n                    \"source_handles\": [\n                      \"P0478\"\n                    ],\n                    \"finding_conditions\": \"在整合 5 个新测序队列（n=165）和 4 个公开数据集（n=147）后，PERMANOVA 分析显示“队列”因素对微生物群落组成的解释方差是其他任何变量的近十倍；留一法交叉验证的平均 AUC-ROC 仅为 0.59-0.60，仅约 31.4% 的情况超过 0.6（P0478）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U1_跨癌种关联图谱_P03\",\n                \"point\": \"阐明治疗方案与给药时序的修饰效应\",\n                \"development\": \"对比 NIC（尼莫鲁单抗 + 伊匹木单抗 + 铂类双药）与 PC 组，指出 Fusicatenibacter 和 Butyricicoccus 高丰度仅在 NIC 组中与更好 OS 相关（HR 分别为 0.56 和 0.52），而 Prevotellaceae NK3B31 高丰度在 NIC 组中与更高死亡风险相关（HR=2.33），说明微生物效应方向受具体给药方案严格修饰。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"主论据\",\n                    \"use\": \"对比 NIC 与 PC 组，指出特定菌高丰度仅在 NIC 组中与更好 OS 相关，说明微生物效应方向受具体给药方案严格修饰\"\n                  },\n                  {\n                    \"source_handle\": \"P0015\",\n                    \"role\": \"补充\",\n                    \"use\": \"补充说明治疗策略（联合免疫阻断 vs 单药）对微生物信号泛化性的修饰作用\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U1_跨癌种关联图谱_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U1_跨癌种关联图谱_P03\",\n                    \"unit_id\": \"U1_跨癌种关联图谱\",\n                    \"ordinal\": 3,\n                    \"point\": \"阐明治疗方案与给药时序的修饰效应\",\n                    \"development\": \"对比 NIC（尼莫鲁单抗 + 伊匹木单抗 + 铂类双药）与 PC 组，指出 Fusicatenibacter 和 Butyricicoccus 高丰度仅在 NIC 组中与更好 OS 相关（HR 分别为 0.56 和 0.52），而 Prevotellaceae NK3B31 高丰度在 NIC 组中与更高死亡风险相关（HR=2.33），说明微生物效应方向受具体给药方案严格修饰。\",\n                    \"source_handles\": [\n                      \"P0585\"\n                    ],\n                    \"finding_conditions\": \"在 NIC 臂（Nivolumab-ipilimumab + platinum doublet chemotherapy）vs PC 臂中，Fusicatenibacter 高丰度患者 HR=0.56，Butyricicoccus 高丰度患者 HR=0.52；Prevotellaceae NK3B31 高丰度患者 HR=2.33（P0585）。\"\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"既然基线快照与方案特异性已严重限制单一标志物的泛化，必须审视外部药物暴露如何进一步修饰这些关联。\",\n              \"argument_relations\": \"共性信号确立微生物-ICI 关联的生物学合理性 → 跨队列异质性统计依据否定普适性单一标志物假设 → 方案特异性修饰效应进一步限制泛化边界。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供NSCLC背景下跨癌种（黑色素瘤、肾癌）的微生物特征清单，指出特定菌属富集与疗效正相关但存在阈值风险，支撑综述中“跨癌种共性信号与情境依赖性”的论述。\",\n                  \"paper_id\": \"261e0a3618ae7acf6e831646379929eff88857d5\",\n                  \"source_handle\": \"P0096\"\n                },\n                {\n                  \"contribution\": \"揭示微生物标志物的肠型特异性（如E2肠型中Collinsella与响应相关），解释为何单一物种难以成为普适性生物标志物，为“无通用标志物”的统计依据提供群落背景视角。\",\n                  \"paper_id\": \"4a1e10851c0bf838d11646a65bc0ee57b10b940a\",\n                  \"source_handle\": \"P0170\"\n                },\n                {\n                  \"contribution\": \"证明菌株级签名在联合免疫治疗中具有泛癌种预测力，但在单药队列中失效，直接支撑“治疗方案严格修饰微生物效应方向”及“缺乏普适性单一标志物”的核心论点。\",\n                  \"paper_id\": \"08a484e3c782bc9552d2df812bad2ec86f231edc\",\n                  \"source_handle\": \"P0015\"\n                },\n                {\n                  \"contribution\": \"提供NSCLC与黑色素瘤的大样本荟萃分析数据，量化高α多样性及Akkermansia/Faecalibacterium富集对ICI生存期的正向预后效应，支撑“跨癌种共性信号”的论述。\",\n                  \"paper_id\": \"82318ae05cff1667b2348961675db67dee4d8360\",\n                  \"source_handle\": \"P0298\"\n                },\n                {\n                  \"contribution\": \"展示HCC多界微生物组特征，揭示细菌/代谢物在持久获益与非获益组间的显著差异而真菌差异较小，用于论证微生物效应具有高度癌种特异性及多界异质性。\",\n                  \"paper_id\": \"58ddfd822378599d43b877cd0905dfe067a4375f\",\n                  \"source_handle\": \"P0204\"\n                },\n                {\n                  \"contribution\": \"基于SCRUM-Japan大规模队列证实整体α多样性与ICI疗效无普遍关联，且粪便口腔细菌比例升高预测较差PFS（尤其合并PPI使用时），为“无通用标志物”及统计异质性提供关键反例。\",\n                  \"paper_id\": \"7fe882e8b39d1a041fd2fee47d9321c965f01aa5\",\n                  \"source_handle\": \"P0289\"\n                },\n                {\n                  \"contribution\": \"报道mCRPC患者中A. muciniphila丰度与ICI疗效呈负相关，挑战跨癌种通用正相关假设，并验证ICI治疗期间菌群高度稳定，支撑治疗方案史修饰效应及基线决定论。\",\n                  \"paper_id\": \"74786f8df0c7648840756833a4b4bc49ace34be6\",\n                  \"source_handle\": \"P0270\"\n                },\n                {\n                  \"contribution\": \"提供多界微生物组（细菌+真菌+古菌+病毒）整合分析证据，证实高多样性及特定属组合与ICI疗效正相关，补充单一细菌视角的局限，支撑“生态网络稳定性促进疗效”的观点。\",\n                  \"paper_id\": \"a9e58de949ced186b4882146c14b79b306ae9ef5\",\n                  \"source_handle\": \"P0393\"\n                },\n                {\n                  \"contribution\": \"提出“功能趋同”理论框架，解释分类学不一致背后的共享免疫通路（如SCFA产生、DC激活），为跨队列异质性提供机制整合视角，支持向基于功能的生物标志物开发转型。\",\n                  \"paper_id\": \"9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\",\n                  \"source_handle\": \"P0364\"\n                },\n                {\n                  \"contribution\": \"展示基因水平微生物丰度结合生物先验知识在预测ICI反应中优于传统分类学特征，揭示治疗策略（联合免疫阻断vs单药）对微生物信号泛化性的修饰作用，丰富标志物开发的维度。\",\n                  \"paper_id\": \"bfb5efeaf486304583ce74567d60f84cf138a0ae\",\n                  \"source_handle\": \"P0437\"\n                },\n                {\n                  \"contribution\": \"提供波兰队列中饮食模式（高植物/低乳制品）与特定菌群协同影响抗PD-1疗效的实证，支撑“微生物标志物具有人群与生活方式依赖性”的分析。\",\n                  \"paper_id\": \"f31246cd559d1a06b99a32b0ee47bb1ce0265772\",\n                  \"source_handle\": \"P0545\"\n                },\n                {\n                  \"contribution\": \"系统综述黑色素瘤数据，揭示真菌失调与较差预后的关联，补充单一细菌视角局限，论证多界微生物生态对ICI疗效的综合调节作用。\",\n                  \"paper_id\": \"f9a9ef8d406ee51983cd285f9e60fc41574ae937\",\n                  \"source_handle\": \"P0565\"\n                },\n                {\n                  \"contribution\": \"基于转移性黑色素瘤宏基因组荟萃分析，确认维生素B代谢通路富集与响应正相关，为“功能趋同优于单一分类学标志物”提供跨队列统计支持。\",\n                  \"paper_id\": \"e533262a6b45c7d00cff83bd889cdc367c85f377\",\n                  \"source_handle\": \"P0511\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0096\",\n              \"P0146\",\n              \"P0585\",\n              \"P0298\",\n              \"P0204\",\n              \"P0270\",\n              \"P0393\",\n              \"P0565\",\n              \"P0545\",\n              \"P0478\",\n              \"P0170\",\n              \"P0289\",\n              \"P0364\",\n              \"P0437\",\n              \"P0511\",\n              \"P0015\",\n              \"P0583\",\n              \"P0273\",\n              \"P0417\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\",\n              \"P0578\",\n              \"P0577\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P01\",\n                \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P02\",\n                \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U2_外部干扰与宿主背景\",\n            \"focus\": \"外部药物暴露（抗生素、PPIs）及联合治疗方案构成关键混杂/修饰变量，其影响具有明确的时间窗口特异性和剂量依赖性，需在关联分析中严格校正。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U2_外部干扰与宿主背景_P01\",\n                \"point\": \"量化抗生素/PPIs 暴露的效应量与时间窗特异性\",\n                \"development\": \"汇总 Meta 分析数据，指出抗生素使用与 OS 恶化（HR=1.61）、PFS 缩短（HR=1.43）及 ORR 降低（RR=0.58）显著相关；亚组分析证实负面关联在 ICI 治疗前后 [-45, 45] 天窗口内最强（β=0.2192, p=0.008），同期 PPIs 暴露亦导致 OS 恶化（HR≈1.31）。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0081\",\n                    \"role\": \"主论据\",\n                    \"use\": \"汇总 Meta 分析数据，指出抗生素使用与 OS 恶化、PFS 缩短及 ORR 降低显著相关\"\n                  },\n                  {\n                    \"source_handle\": \"P0402\",\n                    \"role\": \"主论据\",\n                    \"use\": \"系统综述明确 ICI 启动前 30 天内的抗生素暴露是预后恶化的核心风险窗口，量化时间窗特异性\"\n                  },\n                  {\n                    \"source_handle\": \"P0123\",\n                    \"role\": \"例证\",\n                    \"use\": \"量化抗酸药（PPIs）使用导致链球菌增加及短 PFS 的关联，并对比化疗预处理对微生物组的持久影响\"\n                  },\n                  {\n                    \"source_handle\": \"P0236\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供超 5 万名实体瘤患者的系统综述与荟萃分析数据，量化全身性抗生素暴露导致 PFS 和 OS 显著缩短的效应量\"\n                  },\n                  {\n                    \"source_handle\": \"P0266\",\n                    \"role\": \"例证\",\n                    \"use\": \"聚焦拉丁美洲 NSCLC 人群，证实抗生素暴露显著降低 OS 但未影响 PFS，提示地域/人群特征可能扰动微生物 - 疗效轴\"\n                  },\n                  {\n                    \"source_handle\": \"P0275\",\n                    \"role\": \"比较\",\n                    \"use\": \"针对 HCC 人群的 Meta 分析显示抗生素使用未显著恶化 ICI 疗效，提出肝硬化基线免疫抑制状态可能缓冲抗生素扰动\"\n                  },\n                  {\n                    \"source_handle\": \"P0289\",\n                    \"role\": \"例证\",\n                    \"use\": \"揭示质子泵抑制剂 (PPI) 使用者粪便中口腔细菌比例显著升高，且该特征在 PPI 亚组中与更差 PFS 趋势强相关\"\n                  },\n                  {\n                    \"source_handle\": \"P0339\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供大样本荟萃分析数据，量化 PPI 使用与 ICI 生存结局恶化的关联，并细化使用时窗的效应差异\"\n                  },\n                  {\n                    \"source_handle\": \"P0360\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供妇科肿瘤真实世界数据，明确抗生素使用时长（≥14 天）与 OS 显著缩短的独立关联\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U2_外部干扰与宿主背景_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U2_外部干扰与宿主背景_P01\",\n                    \"unit_id\": \"U2_外部干扰与宿主背景\",\n                    \"ordinal\": 1,\n                    \"point\": \"量化抗生素/PPIs 暴露的效应量与时间窗特异性\",\n                    \"development\": \"汇总 Meta 分析数据，指出抗生素使用与 OS 恶化（HR=1.61）、PFS 缩短（HR=1.43）及 ORR 降低（RR=0.58）显著相关；亚组分析证实负面关联在 ICI 治疗前后 [-45, 45] 天窗口内最强（β=0.2192, p=0.008），同期 PPIs 暴露亦导致 OS 恶化（HR≈1.31）。\",\n                    \"source_handles\": [\n                      \"P0081\",\n                      \"P0402\"\n                    ],\n                    \"finding_conditions\": \"抗生素暴露与 OS 恶化（HR=1.61, 95% CI 1.44-1.81）、PFS 缩短（HR=1.43, 95% CI 1.27-1.60）及 ORR 降低（RR=0.58, 95% CI 0.51-0.66）显著相关；在 ICI 治疗前后 [-45, 45] 天窗口内使用抗生素，OS 恶化风险最高（β=0.2192, p=0.008）（P0081, P0402）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U2_外部干扰与宿主背景_P02\",\n                \"point\": \"讨论联合方案对微生物效应的修饰与反转\",\n                \"development\": \"对比 NIC 与 PC 组，指出 Fusicatenibacter 和 Butyricicoccus 高丰度仅在 NIC 组中与更好 OS 相关（HR 分别为 0.56 和 0.52），而 Prevotellaceae NK3B31 高丰度在 NIC 组中与更高死亡风险相关（HR=2.33），说明联合方案可反转或放大微生物效应方向。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"主论据\",\n                    \"use\": \"对比 NIC 与 PC 组，指出特定菌高丰度仅在 NIC 组中与更好 OS 相关，说明联合方案可反转或放大微生物效应方向\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U2_外部干扰与宿主背景_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U2_外部干扰与宿主背景_P02\",\n                    \"unit_id\": \"U2_外部干扰与宿主背景\",\n                    \"ordinal\": 2,\n                    \"point\": \"讨论联合方案对微生物效应的修饰与反转\",\n                    \"development\": \"对比 NIC 与 PC 组，指出 Fusicatenibacter 和 Butyricicoccus 高丰度仅在 NIC 组中与更好 OS 相关（HR 分别为 0.56 和 0.52），而 Prevotellaceae NK3B31 高丰度在 NIC 组中与更高死亡风险相关（HR=2.33），说明联合方案可反转或放大微生物效应方向。\",\n                    \"source_handles\": [\n                      \"P0585\"\n                    ],\n                    \"finding_conditions\": \"在 NIC 臂（Nivolumab-ipilimumab + platinum doublet chemotherapy）vs PC 臂中，Fusicatenibacter 高丰度患者 HR=0.56，Butyricicoccus 高丰度患者 HR=0.52；Prevotellaceae NK3B31 高丰度患者 HR=2.33（P0585）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U2_外部干扰与宿主背景_P03\",\n                \"point\": \"强调校正必要性与残余偏倚风险\",\n                \"development\": \"指出指示偏倚（Indication Bias）可能导致抗生素负面效应被高估；强调未来研究需标准化暴露定义（种类、剂量、持续时间、指征）并进行多变量校正，否则单纯检测微生物组而不考虑用药史会导致结果不一致。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0081\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出指示偏倚可能导致抗生素负面效应被高估，强调未来研究需标准化暴露定义并进行多变量校正\"\n                  },\n                  {\n                    \"source_handle\": \"P0402\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提示需区分暴露时机进行校正，否则单纯检测微生物组而不考虑用药史会导致结果不一致\"\n                  },\n                  {\n                    \"source_handle\": \"P0157\",\n                    \"role\": \"补充\",\n                    \"use\": \"汇总抗生素、PPIs 及类固醇暴露对 ICI 预后的负面效应量，为讨论指示偏倚高估负面效应及需标准化校正提供实证对照\"\n                  },\n                  {\n                    \"source_handle\": \"P0033\",\n                    \"role\": \"例证\",\n                    \"use\": \"展示 PPI 使用者与非使用者在微生物动态轨迹上的显著差异，说明合并用药可重塑菌群演化路径，需在关联分析中作为关键协变量严格校正\"\n                  },\n                  {\n                    \"source_handle\": \"P0421\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供肌肉量这一非微生物宿主因素对 ICI 疗效影响的实证数据，作为对比背景说明除菌群外其他宿主因素的预测价值存在异质性\"\n                  },\n                  {\n                    \"source_handle\": \"P0517\",\n                    \"role\": \"例证\",\n                    \"use\": \"证实 NSCLC 中抗生素暴露的负面效应高度依赖 PD-L1 表达水平，为宿主生物标志物状态严格修饰微生物干预效应方向提供临床分层依据\"\n                  },\n                  {\n                    \"source_handle\": \"P0548\",\n                    \"role\": \"发展\",\n                    \"use\": \"整合多尺度证据指出抗生素效应在不同实体瘤中存在异质性，警示简单归因于菌群破坏，强调需结合肿瘤免疫原性与疾病背景综合评估\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U2_外部干扰与宿主背景_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U2_外部干扰与宿主背景_P03\",\n                    \"unit_id\": \"U2_外部干扰与宿主背景\",\n                    \"ordinal\": 3,\n                    \"point\": \"强调校正必要性与残余偏倚风险\",\n                    \"development\": \"指出指示偏倚（Indication Bias）可能导致抗生素负面效应被高估；强调未来研究需标准化暴露定义（种类、剂量、持续时间、指征）并进行多变量校正，否则单纯检测微生物组而不考虑用药史会导致结果不一致。\",\n                    \"source_handles\": [\n                      \"P0081\",\n                      \"P0402\"\n                    ],\n                    \"finding_conditions\": \"观察性研究中的指示偏倚（重症患者更多使用抗生素）可能导致抗生素负面效应被高估；标准化暴露定义与多变量校正是避免结果不一致的必要前提（P0081, P0402）。\"\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"外部干扰虽可量化，但基线单次采样仍难以捕捉治疗诱导的生态重塑，必须转向纵向动态监测。\",\n              \"argument_relations\": \"量化暴露效应与时间窗特异性 → 联合方案修饰/反转效应方向 → 强调校正必要性与残余偏倚风险，确立外部干扰作为核心混杂/修饰变量的地位。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"量化抗酸药（PPIs）使用导致链球菌增加及短PFS的关联，并对比化疗预处理对微生物组的持久影响，支撑“外部药物暴露具有明确时间窗特异性与剂量依赖性”的分析任务。\",\n                  \"paper_id\": \"35f3b135b6c865df8bb304e1f28a8247e55c25fd\",\n                  \"source_handle\": \"P0123\"\n                },\n                {\n                  \"contribution\": \"汇总抗生素、PPIs及类固醇暴露对ICI预后的负面效应量，特别强调抗生素使用时机（治疗后vs治疗前）的差异，为讨论指示偏倚高估负面效应及需标准化校正提供实证对照。\",\n                  \"paper_id\": \"45ca27020bec6c917c6b71d8b1bad217f5abd0ed\",\n                  \"source_handle\": \"P0157\"\n                },\n                {\n                  \"contribution\": \"展示PPI使用者与非使用者在微生物动态轨迹上的显著差异（如Streptococcus thermophilus变化方向相反），说明合并用药可重塑菌群演化路径，需在关联分析中作为关键协变量严格校正。\",\n                  \"paper_id\": \"0f25b980517704cd7fa782dd9e51d16b77d00249\",\n                  \"source_handle\": \"P0033\"\n                },\n                {\n                  \"contribution\": \"提供超5万名实体瘤患者的系统综述与荟萃分析数据，量化全身性抗生素暴露导致PFS和OS显著缩短的效应量，确立抗生素作为负面预后调节因子的流行病学证据等级。\",\n                  \"paper_id\": \"62379160afa6c14c9a9ae85a0684ccec8ed9c07e\",\n                  \"source_handle\": \"P0236\"\n                },\n                {\n                  \"contribution\": \"聚焦拉丁美洲NSCLC人群，证实抗生素暴露显著降低OS但未影响PFS，提示地域/人群特征可能扰动微生物-疗效轴，补充外部干扰效应的群体异质性背景。\",\n                  \"paper_id\": \"70ba511d3bb0697cd93e53d4880c68ce77471bde\",\n                  \"source_handle\": \"P0266\"\n                },\n                {\n                  \"contribution\": \"揭示质子泵抑制剂(PPI)使用者粪便中口腔细菌比例显著升高，且该特征在PPI亚组中与更差PFS趋势强相关，阐明合并用药通过重塑肠道生态位构成关键混杂/修饰变量。\",\n                  \"paper_id\": \"7fe882e8b39d1a041fd2fee47d9321c965f01aa5\",\n                  \"source_handle\": \"P0289\"\n                },\n                {\n                  \"contribution\": \"针对HCC人群的Meta分析显示抗生素使用未显著恶化ICI疗效(OS/PFS/ORR)，提出肝硬化基线免疫抑制状态可能缓冲抗生素扰动，为讨论指示偏倚及肿瘤类型特异性校正必要性提供反面对照。\",\n                  \"paper_id\": \"768ceed11b5509cd8f6c24d07e8fa015646929c0\",\n                  \"source_handle\": \"P0275\"\n                },\n                {\n                  \"contribution\": \"提供大样本荟萃分析数据，量化PPI使用与ICI生存结局恶化的关联，并细化使用时窗（基线/前60天 vs 同期）的效应差异，为讨论药物暴露的时间依赖性干扰提供流行病学基准。\",\n                  \"paper_id\": \"9225e04c4f9620a87d4eb74932067cab87644bf2\",\n                  \"source_handle\": \"P0339\"\n                },\n                {\n                  \"contribution\": \"提供妇科肿瘤真实世界数据，明确抗生素使用时长（≥14天）与OS显著缩短的独立关联，区分短期反应指标与长期生存获益的差异，强化用药阈值效应的临床证据。\",\n                  \"paper_id\": \"9cfb62b17064ed5abe1c447f8fa2f46e716b6c0d\",\n                  \"source_handle\": \"P0360\"\n                },\n                {\n                  \"contribution\": \"提供肌肉量这一非微生物宿主因素对ICI疗效影响的实证数据，显示低肌肉量在肺癌中未降低PFS且不增加毒性，作为对比背景说明除菌群外其他宿主因素的预测价值存在异质性。\",\n                  \"paper_id\": \"b7d5f0bd4b9b2ff5ccb0fca4182d84c2111a7fdf\",\n                  \"source_handle\": \"P0421\"\n                },\n                {\n                  \"contribution\": \"证实NSCLC中抗生素暴露的负面效应高度依赖PD-L1表达水平，为“宿主生物标志物状态严格修饰微生物干预效应方向”提供临床分层依据。\",\n                  \"paper_id\": \"e8fb88935a5c5757dc683f56d1ff0c0f356b20ae\",\n                  \"source_handle\": \"P0517\"\n                },\n                {\n                  \"contribution\": \"系统综述明确ICI启动前30天内的抗生素暴露是预后恶化的核心风险窗口，同期暴露影响较弱，量化时间窗特异性并提示需区分暴露时机进行校正。\",\n                  \"paper_id\": \"CorpusId:286786239\",\n                  \"source_handle\": \"P0576\"\n                },\n                {\n                  \"contribution\": \"整合多尺度证据指出抗生素效应在不同实体瘤中存在异质性，警示简单归因于“菌群破坏”，强调需结合肿瘤免疫原性与疾病背景综合评估。\",\n                  \"paper_id\": \"f381ac20e0012cee8a359a479037e3d12ee6e878\",\n                  \"source_handle\": \"P0548\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0081\",\n              \"P0402\",\n              \"P0123\",\n              \"P0236\",\n              \"P0266\",\n              \"P0275\",\n              \"P0289\",\n              \"P0339\",\n              \"P0360\",\n              \"P0585\",\n              \"P0157\",\n              \"P0033\",\n              \"P0421\",\n              \"P0517\",\n              \"P0548\",\n              \"P0583\",\n              \"P0273\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\",\n              \"P0578\",\n              \"P0577\",\n              \"P0576\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P01\",\n                \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P02\",\n                \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U3_动态监测与纵向演变\",\n            \"focus\": \"基线单次采样难以捕捉治疗诱导的生态重塑，纵向动态变化（如病原菌清除或定植失败）比静态丰度更能反映真实疗效轨迹，但纵向数据收集仍面临方法学挑战。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U3_动态监测与纵向演变_P01\",\n                \"point\": \"对比基线快照的预测局限与静态阈值缺陷\",\n                \"development\": \"指出早期 NSCLC 新辅助研究中，基线快照难以捕捉治疗诱导的生态重塑，静态阈值缺陷明显；纵向动态变化（如病原菌清除或定植失败）比静态丰度更能反映真实疗效轨迹。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0569\",\n                    \"role\": \"主论据\",\n                    \"use\": \"报道早期 NSCLC 新辅助治疗中低基线α多样性与高纵向稳定性预示较好病理缓解，对比晚期研究结果\"\n                  },\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出基线单次采样难以捕捉治疗诱导的生态重塑，纵向动态变化比静态丰度更能反映真实疗效轨迹\"\n                  },\n                  {\n                    \"source_handle\": \"P0227\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 NSCLC 与黑色素瘤纵向队列数据，证明治疗初期微生物稳定性丧失独立于抗生素暴露且与 ICI 耐药显著相关\"\n                  },\n                  {\n                    \"source_handle\": \"P0443\",\n                    \"role\": \"补充\",\n                    \"use\": \"提供 NSCLC 物种水平微生物特征与 PFS 及 PD-L1 状态的关联数据，证实化疗预处理虽扰动菌群但不消除特异性预测信号\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_动态监测与纵向演变_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_动态监测与纵向演变_P01\",\n                    \"unit_id\": \"U3_动态监测与纵向演变\",\n                    \"ordinal\": 1,\n                    \"point\": \"对比基线快照的预测局限与静态阈值缺陷\",\n                    \"development\": \"指出早期 NSCLC 新辅助研究中，基线快照难以捕捉治疗诱导的生态重塑，静态阈值缺陷明显；纵向动态变化（如病原菌清除或定植失败）比静态丰度更能反映真实疗效轨迹。\",\n                    \"source_handles\": [\n                      \"P0569\",\n                      \"P0585\"\n                    ],\n                    \"finding_conditions\": \"早期 NSCLC 新辅助研究中，基线快照难以捕捉治疗诱导的生态重塑，静态阈值缺陷明显；纵向动态变化（如病原菌清除或定植失败）比静态丰度更能反映真实疗效轨迹（P0569, P0585）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_动态监测与纵向演变_P02\",\n                \"point\": \"展示纵向动态演变（病原菌清除/定植失败）的预测价值\",\n                \"development\": \"引用 FMT-LUMINate 试验数据，指出响应者获益主要源于基线有害细菌物种（如 Enterocloster, Clostridium）的大量丢失，而非供体菌株的成功定植；这种丢失与血浆中色氨酸代谢产物水平降低及效应性 CD8+ T 细胞增加相关。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"主论据\",\n                    \"use\": \"引用 FMT-LUMINate 试验数据，指出响应者获益主要源于基线有害细菌物种的大量丢失，而非供体菌株的成功定植\"\n                  },\n                  {\n                    \"source_handle\": \"P0098\",\n                    \"role\": \"例证\",\n                    \"use\": \"记录 ICI 治疗期间循环 Tregs 减少与基线拟杆菌属丰度的纵向关联，提示微生物组可能通过设定免疫稳态临界点影响疗效\"\n                  },\n                  {\n                    \"source_handle\": \"P0134\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供小规模前瞻性配对样本数据，显示响应者伴随显著的微生物组波动，而无响应者相对稳定或恶化\"\n                  },\n                  {\n                    \"source_handle\": \"P0200\",\n                    \"role\": \"发展\",\n                    \"use\": \"展示晚期 NSCLC 患者纵向多组学轨迹，发现响应者治疗后微生物特征向健康状态回归而进展期均恶化\"\n                  },\n                  {\n                    \"source_handle\": \"P0205\",\n                    \"role\": \"例证\",\n                    \"use\": \"针对 EGFR 突变 NSCLC 亚群，记录治疗前后微生物 U 型与倒 U 型动态演变模式及特定代谢物变化\"\n                  },\n                  {\n                    \"source_handle\": \"P0415\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供人类黑色素瘤患者宏基因组与宏转录组联合分析证据，识别与 PFS 相关的特定代谢通路及其转录活性\"\n                  },\n                  {\n                    \"source_handle\": \"P0485\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供黏膜黑色素瘤前瞻性队列初步数据，揭示响应者与非响应者肠道菌群组成差异及肿瘤微环境 CD56/CD20 表达平行变化\"\n                  },\n                  {\n                    \"source_handle\": \"P0577\",\n                    \"role\": \"主论据\",\n                    \"use\": \"详述 MIMic 试验中供体菌株定植动力学与临床获益的关联，指出持久定植者获得更长生存\"\n                  },\n                  {\n                    \"source_handle\": \"P0033\",\n                    \"role\": \"主论据\",\n                    \"use\": \"通过贝叶斯模型证实基线后微生物 SGBs 的持续积累轨迹比静态丰度更能区分长/短 PFS 患者\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_动态监测与纵向演变_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_动态监测与纵向演变_P02\",\n                    \"unit_id\": \"U3_动态监测与纵向演变\",\n                    \"ordinal\": 2,\n                    \"point\": \"展示纵向动态演变（病原菌清除/定植失败）的预测价值\",\n                    \"development\": \"引用 FMT-LUMINate 试验数据，指出响应者获益主要源于基线有害细菌物种（如 Enterocloster, Clostridium）的大量丢失，而非供体菌株的成功定植；这种丢失与血浆中色氨酸代谢产物水平降低及效应性 CD8+ T 细胞增加相关。\",\n                    \"source_handles\": [\n                      \"P0585\"\n                    ],\n                    \"finding_conditions\": \"在 FMT-LUMINate 试验中，响应者获益主要源于基线有害细菌物种（如 Enterocloster, Clostridium）的大量丢失，而非供体菌株的成功定植；这种丢失与血浆中色氨酸代谢产物水平降低及效应性 CD8+ T 细胞增加相关（P0585）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_动态监测与纵向演变_P03\",\n                \"point\": \"指出纵向采样面临的现实障碍与标准化需求\",\n                \"development\": \"强调当前领域缺乏前瞻性验证、技术标准化不足、地理多样性缺乏，呼吁开展大型多中心队列研究和随机干预试验；指出纵向采样需解决采集频率、存储条件及 AI 辅助语言工具辅助的语言精炼问题。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"发展\",\n                    \"use\": \"强调当前领域缺乏前瞻性验证、技术标准化不足、地理多样性缺乏，呼吁开展大型多中心队列研究和随机干预试验\"\n                  },\n                  {\n                    \"source_handle\": \"P0273\",\n                    \"role\": \"背景\",\n                    \"use\": \"指出纵向采样需解决采集频率、存储条件及语言精炼问题\"\n                  },\n                  {\n                    \"source_handle\": \"P0327\",\n                    \"role\": \"例证\",\n                    \"use\": \"报告 NSCLC 基线队列中肠道微生物组成、SCFA 谱及肠屏障通透性指标均未能预测 ICI 反应或 irAEs，指出标准化缺失与参考值未建立是主要方法学障碍\"\n                  },\n                  {\n                    \"source_handle\": \"P0546\",\n                    \"role\": \"发展\",\n                    \"use\": \"梳理活体生物制品与后生元在临床试验中的动态监测需求，指出标准化采样频率与存储条件缺失是阻碍纵向数据转化为临床决策的主要方法学瓶颈\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_动态监测与纵向演变_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_动态监测与纵向演变_P03\",\n                    \"unit_id\": \"U3_动态监测与纵向演变\",\n                    \"ordinal\": 3,\n                    \"point\": \"指出纵向采样面临的现实障碍与标准化需求\",\n                    \"development\": \"强调当前领域缺乏前瞻性验证、技术标准化不足、地理多样性缺乏，呼吁开展大型多中心队列研究和随机干预试验；指出纵向采样需解决采集频率、存储条件及 AI 辅助语言工具辅助的语言精炼问题。\",\n                    \"source_handles\": [\n                      \"P0584\",\n                      \"P0273\"\n                    ],\n                    \"finding_conditions\": \"当前领域缺乏前瞻性验证、技术标准化不足、地理多样性缺乏，呼吁开展大型多中心队列研究和随机干预试验；纵向采样需解决采集频率、存储条件及 AI 辅助语言工具辅助的语言精炼问题（P0584, P0273）。\"\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"纵向监测虽优，但当前证据整体仍停留在观察性阶段，必须审视干预性研究的阶梯分布与安全边界。\",\n              \"argument_relations\": \"基线快照局限 → 纵向动态预测价值 → 现实障碍与标准化需求，确立纵向监测优于静态快照的方法学共识。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"通过贝叶斯模型证实基线后微生物SGBs的持续积累轨迹比静态丰度更能区分长/短PFS患者，直接支撑“纵向动态变化优于单次基线采样”的方法学主张。\",\n                  \"paper_id\": \"0f25b980517704cd7fa782dd9e51d16b77d00249\",\n                  \"source_handle\": \"P0033\"\n                },\n                {\n                  \"contribution\": \"提供小规模前瞻性配对样本数据，显示响应者伴随显著的微生物组波动（如梭菌属增加），而无响应者相对稳定或恶化，为“病原菌清除或定植失败反映真实疗效轨迹”提供早期实证。\",\n                  \"paper_id\": \"3bb355ee930e0893c48cf56a7164df771bf2d7f5\",\n                  \"source_handle\": \"P0134\"\n                },\n                {\n                  \"contribution\": \"记录ICI治疗期间循环Tregs减少与基线拟杆菌属丰度的纵向关联，提示微生物组可能通过设定免疫稳态“临界点”影响疗效，补充了纵向监测中免疫-微生物互作的动态机制线索。\",\n                  \"paper_id\": \"2709ffca937655fdff12c871b14cb93ee1830d79\",\n                  \"source_handle\": \"P0098\"\n                },\n                {\n                  \"contribution\": \"提供NSCLC与黑色素瘤纵向队列数据，证明治疗初期微生物稳定性丧失独立于抗生素暴露且与ICI耐药显著相关，支持动态监测优于静态采样的核心主张。\",\n                  \"paper_id\": \"5e9212b7607472bd4faf0f6e2385c37552c9821c\",\n                  \"source_handle\": \"P0227\"\n                },\n                {\n                  \"contribution\": \"展示晚期NSCLC患者纵向多组学轨迹，发现响应者治疗后微生物特征向健康状态回归而进展期均恶化，并开发结合TMB的跨人群微生物评分，阐释动态演变与多模态分层的临床价值。\",\n                  \"paper_id\": \"57133de914bfeefa962dacc91943374147c07fff\",\n                  \"source_handle\": \"P0200\"\n                },\n                {\n                  \"contribution\": \"针对EGFR突变NSCLC亚群，记录治疗前后微生物U型与倒U型动态演变模式及特定代谢物(脱氧胆酸、L-瓜氨酸)变化，说明驱动基因背景下的纵向生态重塑特征。\",\n                  \"paper_id\": \"590fbadadd7e854b3435c77a34e74cd5b744c084\",\n                  \"source_handle\": \"P0205\"\n                },\n                {\n                  \"contribution\": \"报告NSCLC基线队列中肠道微生物组成、SCFA谱及肠屏障通透性指标均未能预测ICI反应或irAEs，指出标准化缺失与参考值未建立是纵向/横断面生物标志物转化的主要方法学障碍。\",\n                  \"paper_id\": \"8b3aa2316f5ec9089bf4d5f6cefbb1c1be74ad79\",\n                  \"source_handle\": \"P0327\"\n                },\n                {\n                  \"contribution\": \"提供人类黑色素瘤患者宏基因组与宏转录组联合分析证据，识别与PFS相关的特定代谢通路（氨基酸合成、维生素合成）及其转录活性，为纵向动态变化提供分子层面的候选机制线索。\",\n                  \"paper_id\": \"b63bda99b7dbfd8c9d82d9a7246125da767de5c7\",\n                  \"source_handle\": \"P0415\"\n                },\n                {\n                  \"contribution\": \"提供NSCLC物种水平微生物特征与PFS及PD-L1状态的关联数据，证实化疗预处理虽扰动菌群但不消除特异性预测信号，支持动态监测中治疗史独立性的论证。\",\n                  \"paper_id\": \"c39938e0fe05e9c9d70243715a4b8f8524d956a9\",\n                  \"source_handle\": \"P0443\"\n                },\n                {\n                  \"contribution\": \"提供黏膜黑色素瘤前瞻性队列初步数据，揭示响应者与非响应者肠道菌群组成差异及肿瘤微环境CD56/CD20表达平行变化，补充罕见实体瘤亚型中纵向生态重塑的早期实证。\",\n                  \"paper_id\": \"da741d94b4d509b96c9490a118677edf3d1417a7\",\n                  \"source_handle\": \"P0485\"\n                },\n                {\n                  \"contribution\": \"报道早期NSCLC新辅助治疗中低基线α多样性与高纵向稳定性预示较好病理缓解，对比晚期研究结果，阐明疾病阶段与治疗强度对动态标志物的情境修饰。\",\n                  \"paper_id\": \"fbbf5b7b16fb493ff4f0b84691ccb2b202d25d41\",\n                  \"source_handle\": \"P0569\"\n                },\n                {\n                  \"contribution\": \"详述MIMic试验中供体菌株定植动力学与临床获益的关联，指出持久定植者获得更长生存，为“纵向生态重塑轨迹优于单次静态丰度”提供因果验证线索。\",\n                  \"paper_id\": \"20c143d5373eab0bfea2067cf66b0e260dfeb1ef\",\n                  \"source_handle\": \"P0577\"\n                },\n                {\n                  \"contribution\": \"梳理活体生物制品与后生元在临床试验中的动态监测需求，指出标准化采样频率与存储条件缺失是阻碍纵向数据转化为临床决策的主要方法学瓶颈。\",\n                  \"paper_id\": \"f32b23ec68d527d1114ddf96e609079a09947e6e\",\n                  \"source_handle\": \"P0546\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0569\",\n              \"P0585\",\n              \"P0227\",\n              \"P0443\",\n              \"P0098\",\n              \"P0134\",\n              \"P0200\",\n              \"P0205\",\n              \"P0415\",\n              \"P0485\",\n              \"P0577\",\n              \"P0033\",\n              \"P0584\",\n              \"P0273\",\n              \"P0327\",\n              \"P0546\",\n              \"P0583\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\",\n              \"P0578\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch1::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98_P01\",\n                \"Ch1::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98_P02\",\n                \"Ch1::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98::U3_%E5%8A%A8%E6%80%81%E7%9B%91%E6%B5%8B%E4%B8%8E%E7%BA%B5%E5%90%91%E6%BC%94%E5%8F%98_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U4_证据阶梯与转化边界\",\n            \"focus\": \"当前证据呈现明显的阶梯状分布：观察性关联最强，概念验证性干预（FMT）显示初步希望但异质性大，Phase III RCT 证据完全缺失，且安全性信号受 ICI 方案严格调节。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U4_证据阶梯与转化边界_P01\",\n                \"point\": \"总结观察性证据强度与概念验证性干预的初步希望\",\n                \"development\": \"指出观察性关联证据最强，概念验证性干预（FMT）显示初步希望但异质性大；FMT-LUMINate II 期试验报告了 NSCLC 患者 ORR 为 80%，并指出响应者基线有害菌种丢失，而非供体菌株定植。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"报告 FMT-LUMINate II 期试验中 NSCLC 患者 ORR 达 80%，且响应源于基线有害菌种丢失而非供体定植\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"发展\",\n                    \"use\": \"提出肠道 - 代谢物 - 免疫轴框架，详述特定代谢物在减轻 irAEs 同时维持抗肿瘤活性的潜力\"\n                  },\n                  {\n                    \"source_handle\": \"P0026\",\n                    \"role\": \"背景\",\n                    \"use\": \"系统梳理 FMT 克服耐药的初步临床数据及机器学习预测性能，明确指出当前缺乏 Phase III RCT 证据且方法学异质性大\"\n                  },\n                  {\n                    \"source_handle\": \"P0144\",\n                    \"role\": \"背景\",\n                    \"use\": \"汇总 FMT 及益生菌干预的早期临床试验结果，强调多数证据来自病例报告或小样本系列研究\"\n                  },\n                  {\n                    \"source_handle\": \"P0161\",\n                    \"role\": \"比较\",\n                    \"use\": \"对比 FMT、益生菌与饮食干预的临床效果差异，指出普通益生菌使用结果高度依赖菌株特异性\"\n                  },\n                  {\n                    \"source_handle\": \"P0291\",\n                    \"role\": \"背景\",\n                    \"use\": \"系统梳理早期 FMT 及定义菌群临床试验现状，强调多数证据来自小样本探索性研究且缺乏大型 RCT 确证\"\n                  },\n                  {\n                    \"source_handle\": \"P0387\",\n                    \"role\": \"比较\",\n                    \"use\": \"系统对比三类微生物干预措施的临床结局，指出 FMT 在难治性肿瘤中表现较一致 ORR 提升而益生菌效果高度特异\"\n                  },\n                  {\n                    \"source_handle\": \"P0470\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供涵盖特定菌属富集、抗生素暴露及 FMT 效果的定量荟萃分析结果，汇总群体水平的统计关联证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"发展\",\n                    \"use\": \"对比 FMT、益生菌与工程菌的临床转化现状，指出供体筛选标准与给药方案异质性是导致概念验证试验结果分化的主因\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U4_证据阶梯与转化边界_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U4_证据阶梯与转化边界_P01\",\n                    \"unit_id\": \"U4_证据阶梯与转化边界\",\n                    \"ordinal\": 1,\n                    \"point\": \"总结观察性证据强度与概念验证性干预的初步希望\",\n                    \"development\": \"指出观察性关联证据最强，概念验证性干预（FMT）显示初步希望但异质性大；FMT-LUMINate II 期试验报告了 NSCLC 患者 ORR 为 80%，并指出响应者基线有害菌种丢失，而非供体菌株定植。\",\n                    \"source_handles\": [\n                      \"P0583\",\n                      \"P0584\"\n                    ],\n                    \"finding_conditions\": \"观察性关联证据最强，概念验证性干预（FMT）显示初步希望但异质性大；FMT-LUMINate II 期试验报告了 NSCLC 患者 ORR 为 80%，并指出响应者基线有害菌种丢失，而非供体菌株定植（P0583, P0584）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U4_证据阶梯与转化边界_P02\",\n                \"point\": \"对比阴性干预试验（MITRIC）与供体匹配/疾病进展速度的限制\",\n                \"development\": \"对比 MITRIC IIa 期篮子试验阴性结果（ORR 0%），指出快速进展性疾病背景、供体匹配次优及免疫微环境限制（髓系主导、IL-8 升高）是疗效受限的主因，强调供体选择与疾病状态对 FMT 成败的决定性作用。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0578\",\n                    \"role\": \"主论据\",\n                    \"use\": \"详述 MITRIC IIa 期篮子试验阴性结果 (ORR 0%)，剖析快速进展疾病背景、供体匹配次优及髓系主导微环境限制等失败主因\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U4_证据阶梯与转化边界_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U4_证据阶梯与转化边界_P02\",\n                    \"unit_id\": \"U4_证据阶梯与转化边界\",\n                    \"ordinal\": 2,\n                    \"point\": \"对比阴性干预试验（MITRIC）与供体匹配/疾病进展速度的限制\",\n                    \"development\": \"对比 MITRIC IIa 期篮子试验阴性结果（ORR 0%），指出快速进展性疾病背景、供体匹配次优及免疫微环境限制（髓系主导、IL-8 升高）是疗效受限的主因，强调供体选择与疾病状态对 FMT 成败的决定性作用。\",\n                    \"source_handles\": [\n                      \"P0578\"\n                    ],\n                    \"finding_conditions\": \"MITRIC IIa 期篮子试验阴性结果（ORR 0%），指出快速进展性疾病背景、供体匹配次优及免疫微环境限制（髓系主导、IL-8 升高）是疗效受限的主因，强调供体选择与疾病状态对 FMT 成败的决定性作用（P0578/MITRIC）。\"\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U4_证据阶梯与转化边界_P03\",\n                \"point\": \"强调 Phase III 空白与安全信号的情境依赖性\",\n                \"development\": \"强调目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用；安全信号（如心肌炎）仅在双 ICI 背景下出现（Prevotella 相关），单药抗 PD-1 未观察到类似毒性，凸显安全性受 ICI 方案严格调节。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"主论据\",\n                    \"use\": \"强调目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用\"\n                  },\n                  {\n                    \"source_handle\": \"P0273\",\n                    \"role\": \"背景\",\n                    \"use\": \"强调目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用\"\n                  },\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"例证\",\n                    \"use\": \"指出安全信号（如心肌炎）仅在双 ICI 背景下出现，单药抗 PD-1 未观察到类似毒性\"\n                  },\n                  {\n                    \"source_handle\": \"P0260\",\n                    \"role\": \"例证\",\n                    \"use\": \"阐述 A. muciniphila 高丰度虽延长 NSCLC 患者 OS 但增加 irAE 风险，明确疗效与毒性在微生物层面的耦合关系\"\n                  },\n                  {\n                    \"source_handle\": \"P0462\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供肺癌幸存者长期随访数据，揭示获益者特有的紧凑微生物网络与丁酸高产能力，以及 irAEs 患者的分子模拟表位富集\"\n                  },\n                  {\n                    \"source_handle\": \"P0600\",\n                    \"role\": \"发展\",\n                    \"use\": \"通过人源化小鼠 FMT 实验确立 irAEs 发生的微生物因果链，并构建随机森林预测模型\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U4_证据阶梯与转化边界_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U4_证据阶梯与转化边界_P03\",\n                    \"unit_id\": \"U4_证据阶梯与转化边界\",\n                    \"ordinal\": 3,\n                    \"point\": \"强调 Phase III 空白与安全信号的情境依赖性\",\n                    \"development\": \"强调目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用；安全信号（如心肌炎）仅在双 ICI 背景下出现（Prevotella 相关），单药抗 PD-1 未观察到类似毒性，凸显安全性受 ICI 方案严格调节。\",\n                    \"source_handles\": [\n                      \"P0584\",\n                      \"P0273\",\n                      \"P0583\"\n                    ],\n                    \"finding_conditions\": \"目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用；安全信号（如心肌炎）仅在双 ICI 背景下出现（Prevotella 相关），单药抗 PD-1 未观察到类似毒性，凸显安全性受 ICI 方案严格调节（P0584, P0273, P0583）。\"\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [\n              {\n                \"table_id\": \"U4_证据阶梯与转化边界_T01\",\n                \"purpose\": \"比较当前主要微生物干预临床试验的设计、人群、疗效结果及局限性，直观展示证据阶梯分布。\",\n                \"columns\": [\n                  \"试验名称/阶段\",\n                  \"目标人群\",\n                  \"干预策略\",\n                  \"主要疗效结果 (ORR/PFS)\",\n                  \"关键局限性/失败原因\"\n                ],\n                \"row_tasks\": [\n                  {\n                    \"content\": \"FMT-LUMINate (Phase 2)\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0583\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 NSCLC 患者 ORR 达 80% 的数据及响应归因于有害菌丢失\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"MITRIC (Phase 2a)\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0578\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 ORR 0% 的阴性结果及快速进展疾病背景等失败主因\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"MIMic (Phase 1)\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0577\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供供体菌株定植动力学与临床获益的关联数据\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"早期 FMT/益生菌综述\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0026\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 ORR 约 20% 的初步临床数据及机器学习预测性能\"\n                      },\n                      {\n                        \"source_handle\": \"P0144\",\n                        \"role\": \"比较\",\n                        \"use\": \"强调多数证据来自病例报告或小样本系列研究\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"干预策略对比 (FMT vs 益生菌)\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0387\",\n                        \"role\": \"比较\",\n                        \"use\": \"指出 FMT 在难治性肿瘤中表现较一致 ORR 提升而益生菌效果高度特异\"\n                      }\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"综上，本章确立了微生物组作为 ICI 疗效调节因子的观察性基础与转化边界，下一章将深入解析介导这些关联的具体分子与细胞机制。\",\n              \"argument_relations\": \"观察性证据最强 → 概念验证干预异质性大（阳性 vs 阴性） → Phase III 空白与安全信号情境依赖，确立当前证据阶梯分布与转化边界。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"系统梳理FMT克服耐药的初步临床数据（ORR约20%）及机器学习预测性能，明确指出当前缺乏Phase III RCT证据且方法学异质性大，支撑“证据阶梯分布与转化边界”的批判性评估。\",\n                  \"paper_id\": \"0cf91befe63ec25329391e50e90d14093d3c74d7\",\n                  \"source_handle\": \"P0026\"\n                },\n                {\n                  \"contribution\": \"汇总FMT及益生菌干预的早期临床试验结果，强调多数证据来自病例报告或小样本系列研究，安全性与长期维持效果尚不确定，用于界定概念验证阶段向常规临床应用转化的现实障碍。\",\n                  \"paper_id\": \"412cf94675e5be84f181d1075570015bc0b66c25\",\n                  \"source_handle\": \"P0144\"\n                },\n                {\n                  \"contribution\": \"对比FMT、益生菌与饮食干预的临床效果差异，指出普通益生菌使用结果高度依赖菌株特异性且部分研究显示无效甚至有害，为讨论干预策略的异质性及安全性信号的情境依赖性提供核心素材。\",\n                  \"paper_id\": \"478e06158ac52abb764c678cb77109164cd00f5d\",\n                  \"source_handle\": \"P0161\"\n                },\n                {\n                  \"contribution\": \"报告FMT-LUMINate II期试验中NSCLC患者ORR达80%，且响应源于基线有害菌种丢失而非供体定植，提供概念验证干预的初步希望及疗效归因线索。\",\n                  \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n                  \"source_handle\": \"P0583\"\n                },\n                {\n                  \"contribution\": \"详述MITRIC IIa期篮子试验阴性结果(ORR 0%)，剖析快速进展疾病背景、供体匹配次优及髓系主导微环境限制等失败主因，界定FMT转化的现实边界。\",\n                  \"paper_id\": \"d9577b3a29bd8aec60c9e27c6a56a63faf3f4a27\",\n                  \"source_handle\": \"P0578\"\n                },\n                {\n                  \"contribution\": \"阐述A. muciniphila高丰度虽延长NSCLC患者OS但增加irAE风险，明确疗效与毒性在微生物层面的耦合关系，支撑安全性受ICI方案严格调节的情境依赖性论点。\",\n                  \"paper_id\": \"6f8044dc50ea73203f972ec2f8a2e2527694e3d3\",\n                  \"source_handle\": \"P0260\"\n                },\n                {\n                  \"contribution\": \"系统梳理早期FMT及定义菌群临床试验现状，强调多数证据来自小样本探索性研究且缺乏大型RCT确证，直接呼应Phase III空白及转化医学的证据阶梯分布特征。\",\n                  \"paper_id\": \"8084192e33a8c5d78c74149b0e22d13f2ca24771\",\n                  \"source_handle\": \"P0291\"\n                },\n                {\n                  \"contribution\": \"系统对比三类微生物干预措施（益生菌vs菌群组合vs FMT）的临床结局，指出FMT在难治性肿瘤中表现较一致ORR提升而益生菌效果高度特异，支撑“干预复杂度决定疗效”的证据阶梯判断。\",\n                  \"paper_id\": \"a7aa74ce68cc3094e2a185d973f39ba70ae017d9\",\n                  \"source_handle\": \"P0387\"\n                },\n                {\n                  \"contribution\": \"提供肺癌幸存者长期随访数据，通过地标分析校正时间偏倚，揭示获益者特有的紧凑微生物网络与丁酸高产能力，以及irAEs患者的分子模拟表位富集，界定概念验证阶段向常规应用转化的现实边界。\",\n                  \"paper_id\": \"cc2b555e2b10a62d0141cb12ab5cefa6e47d570c\",\n                  \"source_handle\": \"P0462\"\n                },\n                {\n                  \"contribution\": \"提供涵盖特定菌属富集、抗生素暴露及FMT效果的定量荟萃分析结果，汇总群体水平的统计关联证据，用于评估当前证据等级及未来标准化需求的核心素材。\",\n                  \"paper_id\": \"d01d7681c26311e53a792fec4a5c6d8c608be0d6\",\n                  \"source_handle\": \"P0470\"\n                },\n                {\n                  \"contribution\": \"通过人源化小鼠FMT实验确立irAEs发生的微生物因果链，并构建随机森林预测模型，为“安全性信号受宿主免疫背景与菌群特征共同驱动”提供机制与工具支撑。\",\n                  \"paper_id\": \"CorpusId:257062954\",\n                  \"source_handle\": \"P0600\"\n                },\n                {\n                  \"contribution\": \"对比FMT、益生菌与工程菌的临床转化现状，指出供体筛选标准与给药方案异质性是导致概念验证试验结果分化的主因，界定当前干预策略的适用边界。\",\n                  \"paper_id\": \"ff51b7d7a956ceb17d4fb9e0f36c3446c6a4cf65\",\n                  \"source_handle\": \"P0573\"\n                },\n                {\n                  \"contribution\": \"提出肠道-代谢物-免疫轴框架，详述特定代谢物（如吲哚类、SCFAs）在减轻irAEs同时维持抗肿瘤活性的潜力，为平衡疗效与毒性提供分子干预思路。\",\n                  \"paper_id\": \"CorpusId:290154100\",\n                  \"source_handle\": \"P0584\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0583\",\n              \"P0584\",\n              \"P0026\",\n              \"P0144\",\n              \"P0161\",\n              \"P0291\",\n              \"P0387\",\n              \"P0470\",\n              \"P0573\",\n              \"P0578\",\n              \"P0273\",\n              \"P0260\",\n              \"P0462\",\n              \"P0600\",\n              \"P0577\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_P01\",\n                \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_P02\",\n                \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_P03\"\n              ],\n              \"table_tasks\": [\n                \"Ch1::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C::U4_%E8%AF%81%E6%8D%AE%E9%98%B6%E6%A2%AF%E4%B8%8E%E8%BD%AC%E5%8C%96%E8%BE%B9%E7%95%8C_T01\"\n              ]\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch2\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"微生物调节 ICI 疗效的免疫学机制\",\n          \"chapter_purpose\": \"帮助读者建立“微生物信号→先天识别→适应性启动→髓系/屏障重塑”的机制链条认知，明确区分动物模型中的因果发现与人类队列中的相关性证据，并理解不同实体瘤类型中机制表达的异质性，为后续代谢物专论（Ch3）与临床转化（Ch5）奠定生物学基础。\",\n          \"chapter_scope\": \"肠道微生物组并非仅作为旁观者，而是通过模式识别受体（PRRs）触发先天免疫识别、介导抗原交叉反应以启动适应性免疫、以及重塑髓系细胞稳态与肠道屏障完整性，系统性驱动抗肿瘤免疫激活；然而，这些机制的临床外推受限于模型系统差异与肿瘤类型特异性，需严格区分临床前因果证据与人类队列的观察性关联。\",\n          \"chapter_thesis\": \"肠道微生物组并非仅作为旁观者，而是通过模式识别受体（PRRs）触发先天免疫识别、介导抗原交叉反应以启动适应性免疫、以及重塑髓系细胞稳态与肠道屏障完整性，系统性驱动抗肿瘤免疫激活；然而，这些机制的临床外推受限于模型系统差异与肿瘤类型特异性，需严格区分临床前因果证据与人类队列的观察性关联。\",\n          \"chapter_argument\": \"肠道微生物组并非仅作为旁观者，而是通过模式识别受体（PRRs）触发先天免疫识别、介导抗原交叉反应以启动适应性免疫、以及重塑髓系细胞稳态与肠道屏障完整性，系统性驱动抗肿瘤免疫激活；然而，这些机制的临床外推受限于模型系统差异与肿瘤类型特异性，需严格区分临床前因果证据与人类队列的观察性关联。\",\n          \"reader_objective\": \"帮助读者建立“微生物信号→先天识别→适应性启动→髓系/屏障重塑”的机制链条认知，明确区分动物模型中的因果发现与人类队列中的相关性证据，并理解不同实体瘤类型中机制表达的异质性，为后续代谢物专论（Ch3）与临床转化（Ch5）奠定生物学基础。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"Ch2_U01\",\n            \"focus\": \"先天免疫识别与树突状细胞（DC）的抗原呈递启动：微生物分子结构（如六酰化 LPS）与 PRR/STING 通路决定 DC 成熟、迁移和 CD8+ T 细胞启动，但人类证据主要为宏基因组关联、临床干预伴随观察或肿瘤内微生物生态相关数据。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch2_U01_P01\",\n                \"point\": \"先天识别不是“有菌即激活”，而受微生物分子结构与受体语境调节。\",\n                \"development\": \"以六酰化 LPS 与五酰化 LPS 的差异为核心，说明 LPS 酰化状态如何通过 TLR4/NF-κB 改变 DC/髓系细胞激活及抗 PD-1 疗效；同时引入 MAMPs 经 TLR/NOD2 刺激抗原呈递细胞、促进 Th1 极化的综述框架，并用 CRC 综述中 TLR4/NLRP3 与 Fn/cGAS-IFN-β 的语境差异提示同一通路在不同肿瘤或微生物背景下可能产生不同方向。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0080\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供六酰化 LPS 经 TLR4/NF-κB 增强抗 PD-1 疗效、五酰化 LPS 拮抗的具体分子案例，并配套人类黑色素瘤宏基因组关联与 MC38 小鼠因果验证。\"\n                  },\n                  {\n                    \"source_handle\": \"P0309\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 MAMPs（如鞭毛蛋白、肽聚糖）经 TLR/NOD2 刺激 APC、促进 Th1 极化和抗原呈递的跨免疫干预框架。\"\n                  },\n                  {\n                    \"source_handle\": \"P0028\",\n                    \"role\": \"局限\",\n                    \"use\": \"提供 CRC 背景下 TLR4/NLRP3、Fn 琥珀酸抑制 cGAS-IFN-β、B. fragilis 多糖与 CTLA-4 协同等语境化案例，防止将 PRR 通路写成单向促免疫。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U01_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U01_P01\",\n                    \"unit_id\": \"Ch2_U01\",\n                    \"ordinal\": 1,\n                    \"point\": \"先天识别不是“有菌即激活”，而受微生物分子结构与受体语境调节。\",\n                    \"development\": \"以六酰化 LPS 与五酰化 LPS 的差异为核心，说明 LPS 酰化状态如何通过 TLR4/NF-κB 改变 DC/髓系细胞激活及抗 PD-1 疗效；同时引入 MAMPs 经 TLR/NOD2 刺激抗原呈递细胞、促进 Th1 极化的综述框架，并用 CRC 综述中 TLR4/NLRP3 与 Fn/cGAS-IFN-β 的语境差异提示同一通路在不同肿瘤或微生物背景下可能产生不同方向。\",\n                    \"source_handles\": [\n                      \"P0080\",\n                      \"P0309\",\n                      \"P0028\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U01_P02\",\n                \"point\": \"DC 亚群成熟、迁移与 STING/IFN-β 轴是微生物信号转化为 CD8+ T 细胞启动的关键节点。\",\n                \"development\": \"以 P0114 的 Ruminococcaceae 菌株为例，说明 TLR 刺激如何经 IRF8 驱动 CD103+ DC 分化并向肿瘤及引流淋巴结迁移，进而通过 NFATc1 增强 CD8+ T 细胞激活和 PD-1 表达；再以综述中的临床前证据补充口服乳酸杆菌、LGG、BF839 或 c-di-AMP 等通过 cGAS-STING/IFN-β 增强 DC 功能和 CD8+ T 细胞浸润，但需明确这些多为动物或综述归纳证据，不能直接外推为人类普适机制。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0114\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供响应者来源 Ruminococcaceae 菌株通过 TLR/IRF8 驱动 CD103+ DC 分化、迁移并增强 CD8+ T 细胞激活的 DC 亚群特异性机制。\"\n                  },\n                  {\n                    \"source_handle\": \"P0132\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供综述层面的临床前证据，说明口服乳酸杆菌等可通过 cGAS/STING 诱导 DC IFN-β 并促进 CD8+ T 细胞浸润。\"\n                  },\n                  {\n                    \"source_handle\": \"P0333\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 LGG、BF839、Akkermansia 等通过 cGAS-STING 或其他通路调节 DC 与 CD8+ T 细胞的综述性机制图谱。\"\n                  },\n                  {\n                    \"source_handle\": \"P0309\",\n                    \"role\": \"背景\",\n                    \"use\": \"补充 MAMPs 经 TLR/NOD2 刺激 APC、促进 Th1 极化的跨免疫干预框架，与 STING 通路形成互补。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U01_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U01_P02\",\n                    \"unit_id\": \"Ch2_U01\",\n                    \"ordinal\": 2,\n                    \"point\": \"DC 亚群成熟、迁移与 STING/IFN-β 轴是微生物信号转化为 CD8+ T 细胞启动的关键节点。\",\n                    \"development\": \"以 P0114 的 Ruminococcaceae 菌株为例，说明 TLR 刺激如何经 IRF8 驱动 CD103+ DC 分化并向肿瘤及引流淋巴结迁移，进而通过 NFATc1 增强 CD8+ T 细胞激活和 PD-1 表达；再以综述中的临床前证据补充口服乳酸杆菌、LGG、BF839 或 c-di-AMP 等通过 cGAS-STING/IFN-β 增强 DC 功能和 CD8+ T 细胞浸润，但需明确这些多为动物或综述归纳证据，不能直接外推为人类普适机制。\",\n                    \"source_handles\": [\n                      \"P0114\",\n                      \"P0132\",\n                      \"P0333\",\n                      \"P0309\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U01_P03\",\n                \"point\": \"微生物还可调节 DC 检查点语气，但人类证据仍以关联和伴随观察为主。\",\n                \"development\": \"以 P0242 的 C. cateniformis 为例，说明微生物表面成分可通过 MYD88 下调 DC PD-L2，减弱 PD-L2/RGMb 对 CD8+ T 细胞的抑制，从而在微生物缺失或非响应者粪便模型中恢复 ICI 疗效；随后用 P0080 的人类黑色素瘤 lpxM 关联、P0583 的 FMT 后有害菌丢失与 CD8+ T 细胞增加，以及 P0535 的肿瘤内 Bifidobacterium/STING 观察，对比人类层面的关联证据与肿瘤内生态线索，强调这些人类数据不能直接证明与小鼠相同的因果链条。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0242\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供微生物直接调控 DC 检查点分子 PD-L2/RGMb 的因果案例，补充先天识别之外微生物调节 DC 抑制性语气的路径。\"\n                  },\n                  {\n                    \"source_handle\": \"P0080\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供人类黑色素瘤基线宏基因组中 lpxM 基因富集与疗效的关联，作为人类层面的间接证据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供人类 II 期 FMT 联合 ICI 中微生物重塑、色氨酸代谢产物下降与 CD8+ T 细胞增加的伴随机制线索，作为临床层级证据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0535\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供肿瘤内微生物群与 STING、PD-L1、MDSC 等免疫调节通路的综述证据，作为肠道机制与局部肿瘤生态之间的边界参照。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U01_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U01_P03\",\n                    \"unit_id\": \"Ch2_U01\",\n                    \"ordinal\": 3,\n                    \"point\": \"微生物还可调节 DC 检查点语气，但人类证据仍以关联和伴随观察为主。\",\n                    \"development\": \"以 P0242 的 C. cateniformis 为例，说明微生物表面成分可通过 MYD88 下调 DC PD-L2，减弱 PD-L2/RGMb 对 CD8+ T 细胞的抑制，从而在微生物缺失或非响应者粪便模型中恢复 ICI 疗效；随后用 P0080 的人类黑色素瘤 lpxM 关联、P0583 的 FMT 后有害菌丢失与 CD8+ T 细胞增加，以及 P0535 的肿瘤内 Bifidobacterium/STING 观察，对比人类层面的关联证据与肿瘤内生态线索，强调这些人类数据不能直接证明与小鼠相同的因果链条。\",\n                    \"source_handles\": [\n                      \"P0242\",\n                      \"P0080\",\n                      \"P0583\",\n                      \"P0535\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"\",\n              \"argument_relations\": \"本单元为 Ch2_U02 的 T 细胞 priming 与亚群平衡提供上游先天识别/DC 机制；不展开代谢物浓度与剂量问题，相关代谢物中介主要留给 Ch3。\",\n              \"supporting_studies\": [\n                {\n                  \"source_handle\": \"P0080\",\n                  \"paper_id\": \"1c98ea21fbac0226e1f0c817968ad885448151f3\",\n                  \"contribution\": \"提供六酰化 LPS 经 TLR4/NF-κB 增强抗 PD-1 疗效、五酰化 LPS 拮抗的具体分子案例，并配套人类黑色素瘤宏基因组关联与 MC38 小鼠因果验证。\",\n                  \"conditions\": \"人类黑色素瘤基线宏基因组；小鼠 MC38 抗 PD-1 模型；LPS 结构差异。\",\n                  \"limits\": \"宏基因组推断基因潜力而非直接测量 LPS 产物；主要限于黑色素瘤与 MC38；人与小鼠 TLR4/MD2 对 LPS 酰化状态敏感性可能不同。\"\n                },\n                {\n                  \"source_handle\": \"P0114\",\n                  \"paper_id\": \"3138b2ba3413f9ffc9b5e0000b6c0310cb34cd84\",\n                  \"contribution\": \"提供响应者来源 Ruminococcaceae 菌株通过 TLR/IRF8 驱动 CD103+ DC 分化、迁移并增强 CD8+ T 细胞激活的 DC 亚群特异性机制。\",\n                  \"conditions\": \"动物模型；PD-1 响应者粪便分离菌株；非响应者粪便移植背景。\",\n                  \"limits\": \"会议摘要，样本量、统计细节和普适性不足；仅限单一菌株与特定 DC 亚群。\"\n                },\n                {\n                  \"source_handle\": \"P0132\",\n                  \"paper_id\": \"3ae3c79b877e85a192dae9804adf84211ceedab7\",\n                  \"contribution\": \"提供综述层面的临床前证据，说明口服乳酸杆菌等可通过 cGAS/STING 诱导 DC IFN-β 并促进 CD8+ T 细胞浸润。\",\n                  \"conditions\": \"综述归纳；主要为肿瘤治疗背景下的动物模型与机制研究。\",\n                  \"limits\": \"综述未提供新原始数据；具体效应依赖所引用研究，不能视为统一人类机制。\"\n                },\n                {\n                  \"source_handle\": \"P0242\",\n                  \"paper_id\": \"657c221351daa09b93f85f8beef5195760d2acbb\",\n                  \"contribution\": \"提供微生物直接调控 DC 检查点分子 PD-L2/RGMb 的因果案例，补充先天识别之外微生物调节 DC 抑制性语气的路径。\",\n                  \"conditions\": \"无菌/抗生素小鼠、患者粪便移植、MC38/B16 等模型；抗 PD-1/PD-L1 联合抗 PD-L2/RGMb。\",\n                  \"limits\": \"主要基于小鼠；并非所有肿瘤模型均显示联合获益；人体中 PD-L2/PD-1 与 PD-L2/RGMb 相对贡献未明。\"\n                },\n                {\n                  \"source_handle\": \"P0333\",\n                  \"paper_id\": \"8e25ec1d06aea0a73a479436c268bc6fab267259\",\n                  \"contribution\": \"提供 LGG、BF839、Akkermansia 等通过 cGAS-STING 或其他通路调节 DC 与 CD8+ T 细胞的综述性机制图谱。\",\n                  \"conditions\": \"综述；跨 ICI 方案与多癌种机制归纳。\",\n                  \"limits\": \"叙述性综述，缺乏正式质量评估；多数机制来自临床前或小样本研究。\"\n                },\n                {\n                  \"source_handle\": \"P0309\",\n                  \"paper_id\": \"8552db34c533ee32ec30305e104babc5da9914ae\",\n                  \"contribution\": \"提供 MAMPs（如鞭毛蛋白、肽聚糖）经 TLR/NOD2 刺激 APC、促进 Th1 极化和抗原呈递的跨免疫干预框架。\",\n                  \"conditions\": \"综述；涵盖 ICI 与疫苗反应比较。\",\n                  \"limits\": \"机制多来自临床前模型；SCFA 等效应具有情境依赖性，不能线性外推。\"\n                },\n                {\n                  \"source_handle\": \"P0028\",\n                  \"paper_id\": \"0d36b62772e0930cc8aead7edc85535b5b389e25\",\n                  \"contribution\": \"提供 CRC 背景下 TLR4/NLRP3、Fn 琥珀酸抑制 cGAS-IFN-β、B. fragilis 多糖与 CTLA-4 协同等语境化案例，防止将 PRR 通路写成单向促免疫。\",\n                  \"conditions\": \"CRC 免疫微环境综述；部分机制来自小鼠或体外。\",\n                  \"limits\": \"主要聚焦 CRC；不同微生物与癌种中同一通路方向可能不同。\"\n                },\n                {\n                  \"source_handle\": \"P0535\",\n                  \"paper_id\": \"eea4059be35526f75d745cc8d16db8ec33658f69\",\n                  \"contribution\": \"提供肿瘤内微生物群与 STING、PD-L1、MDSC 等免疫调节通路的综述证据，作为肠道机制与局部肿瘤生态之间的边界参照。\",\n                  \"conditions\": \"肿瘤内微生物群综述；多癌种、多方法学证据。\",\n                  \"limits\": \"聚焦肿瘤内微生物而非肠道微生物；低生物量与污染问题需谨慎；多为相关性或临床前机制。\"\n                },\n                {\n                  \"source_handle\": \"P0583\",\n                  \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n                  \"contribution\": \"提供人类 II 期 FMT 联合 ICI 中微生物重塑、色氨酸代谢产物下降与 CD8+ T 细胞增加的伴随机制线索，作为临床层级证据。\",\n                  \"conditions\": \"FMT-LUMINate II 期试验；NSCLC 抗 PD-1 单药，黑色素瘤抗 PD-1/CTLA-4 双药。\",\n                  \"limits\": \"单臂、小样本；机制关联需结合动物实验，不能单独证明人类因果；不深入代谢物浓度与剂量问题。\"\n                }\n              ],\n              \"case_objects\": [\n                {\n                  \"conditions\": \"112 例黑色素瘤患者基线粪便宏基因组；小鼠 MC38 结肠腺癌模型，抗 PD-1 治疗；口服六酰化或五酰化 LPS；TLR4 抑制剂 TAK-242 或粘菌素 B 干预。\",\n                  \"finding\": \"响应者中编码六酰化 LPS 的 lpxM 基因富集，非响应者中总 LPS 合成基因及五酰化 lpxL 基因更高；小鼠中六酰化 LPS 经 TLR4/NF-κB 增强抗 PD-1 疗效并增加肿瘤浸润 IFNγ+/TNF+ CD8+ T 细胞，五酰化 LPS 无效且可拮抗六酰化 LPS。该研究提供人类关联与小鼠因果验证，但宏基因组推断的是基因潜力，且主要限于黑色素瘤与 MC38 模型。\",\n                  \"paper_id\": \"1c98ea21fbac0226e1f0c817968ad885448151f3\",\n                  \"source_handle\": \"P0080\"\n                },\n                {\n                  \"conditions\": \"从 PD-1 响应实体瘤患者粪便中分离的新型 Ruminococcaceae 菌株；动物模型中联合 PD-1 阻断，包括非响应者粪便移植背景；机制分析聚焦 CD103+ DC、IRF8、TLR 信号与 CD8+ T 细胞。\",\n                  \"finding\": \"该菌株通过刺激多个 TLR，促进 IRF8 驱动的 CD103+ DC 分化、成熟及向肿瘤微环境和肿瘤引流淋巴结迁移；DC 与 CD8+ T 细胞接触延长，经 NFATc1 核转位增强肿瘤抗原特异性 CD8+ T 细胞激活并上调 PD-1。该证据为动物模型中的机制发现，摘要未提供完整样本量与统计细节。\",\n                  \"paper_id\": \"3138b2ba3413f9ffc9b5e0000b6c0310cb34cd84\",\n                  \"source_handle\": \"P0114\"\n                },\n                {\n                  \"conditions\": \"无菌鼠、抗生素处理鼠、定植健康人/小鼠微生物群或患者粪便的 C57BL/6 小鼠；MC38、B16-OVA 等肿瘤模型；抗 PD-1/PD-L1 联合抗 PD-L2 或抗 RGMb 干预。\",\n                  \"finding\": \"Coprobacillus cateniformis 表面提取物可经 MYD88 依赖途径下调 DC 表面 PD-L2，减弱 PD-L2 与 T 细胞 RGMb 的抑制性互作；在微生物缺失或患者非响应者粪便定植模型中，阻断 PD-L2/RGMb 可恢复抗 PD-1/PD-L1 疗效。该机制主要基于小鼠模型，尚缺人体直接验证。\",\n                  \"paper_id\": \"657c221351daa09b93f85f8beef5195760d2acbb\",\n                  \"source_handle\": \"P0242\"\n                },\n                {\n                  \"conditions\": \"FMT-LUMINate II 期试验：晚期 NSCLC 接受 FMT 联合抗 PD-1 单药，黑色素瘤接受 FMT 联合抗 PD-1/CTLA-4；微生物组、血浆代谢组与免疫表型伴随分析。\",\n                  \"finding\": \"响应者并非主要依赖供体菌株定植，而是表现为基线有害细菌物种（如 Enterocloster、Clostridium 等）的大幅丢失，伴随血浆色氨酸代谢产物降低和效应性 CD8+ T 细胞增加；动物回输实验提示清除这些有害菌是疗效所需。该人类试验提供微生物重塑与免疫微环境改善的伴随关联，但不直接证明 DC 迁移或 STING 因果。\",\n                  \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n                  \"source_handle\": \"P0583\"\n                },\n                {\n                  \"conditions\": \"多种实体瘤中肿瘤内微生物群的综述性证据；涉及 Bifidobacterium、Akkermansia、Fusobacterium nucleatum 及 STING、PD-L1 等通路。\",\n                  \"finding\": \"肿瘤内有益菌（如 Bifidobacterium）可与 STING 激活、免疫增强和 ICI 响应相关，而 Fn 等可诱导免疫抑制；但该证据属于肿瘤内微生物生态，不能直接等同肠道菌群因果机制，且多为临床前或相关性观察。\",\n                  \"paper_id\": \"eea4059be35526f75d745cc8d16db8ec33658f69\",\n                  \"source_handle\": \"P0535\"\n                }\n              ],\n              \"synthesis_and_transition\": \"先天识别与 DC 成熟构成微生物信号进入抗肿瘤免疫的第一道闸门，但其方向取决于微生物分子结构、DC 亚群、检查点语气和肿瘤背景。小鼠模型提供了受体、细胞与菌株层面的因果链条，人类队列则主要提供宏基因组、免疫表型或干预伴随关联。DC 启动之后，T 细胞克隆扩增、亚群平衡与耗竭状态将决定疗效能否持续，这是下一单元的任务。\"\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0080\",\n              \"P0309\",\n              \"P0028\",\n              \"P0114\",\n              \"P0132\",\n              \"P0333\",\n              \"P0242\",\n              \"P0583\",\n              \"P0535\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch2::Ch2_U01::Ch2_U01_P01\",\n                \"Ch2::Ch2_U01::Ch2_U01_P02\",\n                \"Ch2::Ch2_U01::Ch2_U01_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch2_U02\",\n            \"focus\": \"适应性免疫启动：分子模拟、T 细胞 priming 与亚群平衡\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch2_U02_P01\",\n                \"point\": \"分子模拟与交叉反应性T细胞激活\",\n                \"development\": \"解析微生物肽段与肿瘤新抗原序列相似性假说，阐述交叉反应性CD8+ T细胞如何被激活并浸润肿瘤。对比小鼠模型中功能回补实验的因果验证与人类队列中基于生物信息学预测的关联性证据。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0388\",\n                    \"role\": \"主论据\",\n                    \"use\": \"微生物肽段与肿瘤新抗原序列相似性激活交叉反应性 CD8+ T 细胞，功能回补实验证实因果性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0560\",\n                    \"role\": \"例证\",\n                    \"use\": \"细菌抗原与肿瘤抗原交叉反应增强抗原性，体外共培养证实 T 细胞杀伤力提升。\"\n                  },\n                  {\n                    \"source_handle\": \"P0085\",\n                    \"role\": \"背景\",\n                    \"use\": \"提出预存异源记忆 T 细胞通过分子模拟交叉识别肿瘤新抗原的假说，为微生物介导的 T 细胞交叉反应性提供理论框架。\"\n                  },\n                  {\n                    \"source_handle\": \"P0462\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供肠道微生物表位与宿主自身免疫或肿瘤抗原发生交叉反应的实证数据，阐明分子模拟介导长期疗效与免疫相关不良事件的双刃剑效应。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U02_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U02_P01\",\n                    \"unit_id\": \"Ch2_U02\",\n                    \"ordinal\": 1,\n                    \"point\": \"分子模拟与交叉反应性T细胞激活\",\n                    \"development\": \"解析微生物肽段与肿瘤新抗原序列相似性假说，阐述交叉反应性CD8+ T细胞如何被激活并浸润肿瘤。对比小鼠模型中功能回补实验的因果验证与人类队列中基于生物信息学预测的关联性证据。\",\n                    \"source_handles\": [\n                      \"P0388\",\n                      \"P0560\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U02_P02\",\n                \"point\": \"T细胞 priming、亚群平衡与耗竭调控\",\n                \"development\": \"阐述CD8+ T细胞priming、Th17/Treg亚群平衡及耗竭状态的调控路径。对比小鼠模型中CRISPR敲除或抗体耗竭的功能验证与人类队列中基于流式细胞术的单细胞表型观察，强调代谢微环境（如腺苷积累）对T细胞耗竭的决定性影响。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0269\",\n                    \"role\": \"主论据\",\n                    \"use\": \"T 细胞耗竭与代谢微环境（腺苷积累）密切相关，IL-12 与 ADA 工程化策略可恢复 NK/T 细胞功能。\"\n                  },\n                  {\n                    \"source_handle\": \"P0535\",\n                    \"role\": \"例证\",\n                    \"use\": \"非经典检查点配体（LAG-3, TIM-3）在肿瘤细胞中高表达，与低 CD8+ T 细胞浸润及不良预后相关。\"\n                  },\n                  {\n                    \"source_handle\": \"P0098\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供纵向队列中基线拟杆菌属与瘤胃球菌科丰度预测 Treg 减少及 irAEs 严重程度的动态数据，揭示菌群对 T 细胞亚群平衡的设定作用。\"\n                  },\n                  {\n                    \"source_handle\": \"P0154\",\n                    \"role\": \"背景\",\n                    \"use\": \"阐述 SCFAs 与色氨酸衍生物通过 HDAC 抑制及 AHR/GPR43 信号调节 Th17/Treg 极化的分子路径，补充代谢微环境对 T 细胞耗竭的调控机制。\"\n                  },\n                  {\n                    \"source_handle\": \"P0195\",\n                    \"role\": \"例证\",\n                    \"use\": \"揭示代谢物脱氨酪氨酸（DAT）通过宿主 IFN-I 信号通路协同增强 T 细胞活化及 Th1 分化的具体路径。\"\n                  },\n                  {\n                    \"source_handle\": \"P0444\",\n                    \"role\": \"例证\",\n                    \"use\": \"揭示 MEP 通路代谢物 HMBPP 特异性激活 Vδ2 T 细胞，以及核黄素通路产物 5-OP-RU 诱导 MAIT 细胞增殖的机制。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U02_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U02_P02\",\n                    \"unit_id\": \"Ch2_U02\",\n                    \"ordinal\": 2,\n                    \"point\": \"T细胞 priming、亚群平衡与耗竭调控\",\n                    \"development\": \"阐述CD8+ T细胞priming、Th17/Treg亚群平衡及耗竭状态的调控路径。对比小鼠模型中CRISPR敲除或抗体耗竭的功能验证与人类队列中基于流式细胞术的单细胞表型观察，强调代谢微环境（如腺苷积累）对T细胞耗竭的决定性影响。\",\n                    \"source_handles\": [\n                      \"P0269\",\n                      \"P0535\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提出预存异源记忆T细胞通过分子模拟交叉识别肿瘤新抗原的假说，为微生物介导的T细胞交叉反应性提供理论框架。\",\n                  \"paper_id\": \"1fc390ce78756996bf505f1fc9c3e6405ff665ba\",\n                  \"source_handle\": \"P0085\"\n                },\n                {\n                  \"contribution\": \"提供纵向队列中基线拟杆菌属与瘤胃球菌科丰度预测Treg减少及irAEs严重程度的动态数据，揭示菌群对T细胞亚群平衡的设定作用。\",\n                  \"paper_id\": \"2709ffca937655fdff12c871b14cb93ee1830d79\",\n                  \"source_handle\": \"P0098\"\n                },\n                {\n                  \"contribution\": \"阐述SCFAs与色氨酸衍生物通过HDAC抑制及AHR/GPR43信号调节Th17/Treg极化的分子路径，补充代谢微环境对T细胞耗竭的调控机制。\",\n                  \"paper_id\": \"443d395fc74f8084d7e8e04c6f91a23b5e25f08d\",\n                  \"source_handle\": \"P0154\"\n                },\n                {\n                  \"contribution\": \"揭示代谢物脱氨酪氨酸（DAT）通过宿主IFN-I信号通路协同增强T细胞活化及Th1分化的具体路径，为解释菌群失调后单一代谢物替代疗法恢复ICI敏感性提供实证。\",\n                  \"paper_id\": \"556c1f84751da3bea2bca5a9336429ad72962add\",\n                  \"source_handle\": \"P0195\"\n                },\n                {\n                  \"contribution\": \"揭示MEP通路代谢物HMBPP特异性激活Vδ2 T细胞，以及核黄素通路产物5-OP-RU诱导MAIT细胞增殖的机制，补充非经典T细胞亚群在菌群介导的抗肿瘤免疫中的功能证据。\",\n                  \"paper_id\": \"c426f22c38d341a24524f67fd75537f6ef60aaf0\",\n                  \"source_handle\": \"P0444\"\n                },\n                {\n                  \"contribution\": \"提供肠道微生物表位与宿主自身免疫或肿瘤抗原发生交叉反应的实证数据，阐明分子模拟介导长期疗效与免疫相关不良事件的双刃剑效应，丰富适应性免疫启动的机制维度。\",\n                  \"paper_id\": \"cc2b555e2b10a62d0141cb12ab5cefa6e47d570c\",\n                  \"source_handle\": \"P0462\"\n                }\n              ],\n              \"case_objects\": [\n                {\n                  \"conditions\": \"免疫健全小鼠同系移植瘤模型，CRISPR敲除与功能回补实验\",\n                  \"finding\": \"微生物肽段与肿瘤新抗原序列相似性激活交叉反应性CD8+ T细胞，功能回补实验证实因果性。\",\n                  \"paper_id\": \"a85afdff22ae96afa7e975dddb2b63ea9aa9cd29\",\n                  \"source_handle\": \"P0388\"\n                },\n                {\n                  \"conditions\": \"体外多色流式细胞术共培养体系，含/不含高浓度腺苷\",\n                  \"finding\": \"细菌抗原与肿瘤抗原交叉反应增强抗原性，体外共培养证实T细胞杀伤力提升。\",\n                  \"paper_id\": \"f826b922c5585799af4e6bc30d1735d189bcc5e1\",\n                  \"source_handle\": \"P0560\"\n                },\n                {\n                  \"conditions\": \"免疫健全小鼠模型，静脉注射工程菌评估生存期与免疫记忆\",\n                  \"finding\": \"T细胞耗竭与代谢微环境（腺苷积累）密切相关，IL-12与ADA工程化策略可恢复NK/T细胞功能。\",\n                  \"paper_id\": \"7297b72d6d45a0bb256e7e59cf9e282416f77bc7\",\n                  \"source_handle\": \"P0269\"\n                },\n                {\n                  \"conditions\": \"人类TCGA RNA-seq与CPTAC蛋白质组学数据集\",\n                  \"finding\": \"非经典检查点配体（LAG-3, TIM-3）在肿瘤细胞中高表达，与低CD8+ T细胞浸润及不良预后相关。\",\n                  \"paper_id\": \"eea4059be35526f75d745cc8d16db8ec33658f69\",\n                  \"source_handle\": \"P0535\"\n                }\n              ],\n              \"synthesis_and_transition\": \"适应性免疫启动依赖于分子模拟与T细胞priming，但这一过程极易受到髓系细胞重编程与肠道屏障完整性的制约。当髓系抑制网络占据主导或屏障受损时，即使存在活跃的T细胞priming，抗肿瘤效应仍会被阻断。\"\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0388\",\n              \"P0560\",\n              \"P0085\",\n              \"P0462\",\n              \"P0269\",\n              \"P0535\",\n              \"P0098\",\n              \"P0154\",\n              \"P0195\",\n              \"P0444\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch2::Ch2_U02::Ch2_U02_P01\",\n                \"Ch2::Ch2_U02::Ch2_U02_P02\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch2_U03\",\n            \"focus\": \"屏障完整性、细菌易位与髓系重编程构成连续而条件依赖的机制链\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch2_U03_P01\",\n                \"point\": \"肠道屏障完整性是微生物信号能否转化为全身免疫事件的条件闸门。\",\n                \"development\": \"用肠芯片证据说明非响应者粪便/LPS 可破坏 ZO-1/β-catenin 并激活 TNF/IL-6/NF-κB，而响应者粪便中鞭毛蛋白/TLR-5 相关信号与屏障维持相关；再引入 P. bifermentans 活菌破坏上皮屏障并诱导炎症、但其无细胞小分子组分保留抗肿瘤增效的双重结构，强调屏障损伤与疗效增强并非同一机制的必然结果。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0073\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供人源肠芯片中响应者/非响应者粪便对屏障完整性、炎症通路和微生物分子（LPS/鞭毛蛋白）差异的功能证据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0284\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U03_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U03_P01\",\n                    \"unit_id\": \"Ch2_U03\",\n                    \"ordinal\": 1,\n                    \"point\": \"肠道屏障完整性是微生物信号能否转化为全身免疫事件的条件闸门。\",\n                    \"development\": \"用肠芯片证据说明非响应者粪便/LPS 可破坏 ZO-1/β-catenin 并激活 TNF/IL-6/NF-κB，而响应者粪便中鞭毛蛋白/TLR-5 相关信号与屏障维持相关；再引入 P. bifermentans 活菌破坏上皮屏障并诱导炎症、但其无细胞小分子组分保留抗肿瘤增效的双重结构，强调屏障损伤与疗效增强并非同一机制的必然结果。\",\n                    \"source_handles\": [\n                      \"P0073\",\n                      \"P0284\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U03_P02\",\n                \"point\": \"细菌易位可以是治疗诱导的主动免疫转运过程，而非单纯被动漏肠。\",\n                \"development\": \"以 P0166 为核心，说明联合 ICT 诱导特定肠道细菌经 DC 摄取并以 CCR7 依赖方式进入 MLN、TDLN 和肿瘤，MLN 切除会削弱远端抗肿瘤免疫；结合 PDAC 综述中细菌经门静脉/淋巴/胆道等路径进入肿瘤或次级淋巴器官并激活局部 PRR 的描述，以及消化道肿瘤中 Fn 等病原菌局部免疫抑制的案例，建立“屏障—转运—局部免疫”的解剖链条。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0166\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 ICT 诱导肠道细菌经 DC/CCR7 向 MLN、TDLN 和肿瘤转移，并增强肠外抗肿瘤免疫的因果路径。\"\n                  },\n                  {\n                    \"source_handle\": \"P0084\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 PDAC 中肠道菌群/细菌易位通过 PRR 和巨噬细胞/TAM 重编程形成局部免疫抑制的综述性机制框架。\"\n                  },\n                  {\n                    \"source_handle\": \"P0438\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供消化道肿瘤中 Fn 抑制 NK/招募 MDSC、Barnesiella 增强 T 细胞浸润等局部微生物调控案例。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U03_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U03_P02\",\n                    \"unit_id\": \"Ch2_U03\",\n                    \"ordinal\": 2,\n                    \"point\": \"细菌易位可以是治疗诱导的主动免疫转运过程，而非单纯被动漏肠。\",\n                    \"development\": \"以 P0166 为核心，说明联合 ICT 诱导特定肠道细菌经 DC 摄取并以 CCR7 依赖方式进入 MLN、TDLN 和肿瘤，MLN 切除会削弱远端抗肿瘤免疫；结合 PDAC 综述中细菌经门静脉/淋巴/胆道等路径进入肿瘤或次级淋巴器官并激活局部 PRR 的描述，以及消化道肿瘤中 Fn 等病原菌局部免疫抑制的案例，建立“屏障—转运—局部免疫”的解剖链条。\",\n                    \"source_handles\": [\n                      \"P0166\",\n                      \"P0084\",\n                      \"P0438\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U03_P03\",\n                \"point\": \"易位微生物的免疫后果主要由髓系细胞重编程决定。\",\n                \"development\": \"说明易位细菌或屏障来源信号可通过 TLR/PRR 改变 TAM、MDSC 和巨噬细胞表型：在 PDAC 背景中促进免疫抑制性 TAM 并限制 T 细胞活化，抗生素清除后可恢复促炎表型与抗 PD-1 反应；同时用广谱 ICI 耐药综述补充 MDSC、M2 样 TAM、TGF-β/IL-10、缺氧和乳酸积累等共同构成免疫抑制网络；再用 FMT 综述指出微生物干预可能增加效应 T 细胞或减少抑制性髓系细胞，但失败案例同样存在。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0084\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供肠道菌群或肿瘤内易位细菌可通过 PRR 诱导巨噬细胞/TAM 向免疫抑制表型转化的综述框架。\"\n                  },\n                  {\n                    \"source_handle\": \"P0362\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 ICI 耐药中 MDSC、TAM、Treg、缺氧、乳酸和氨基酸代谢等免疫抑制网络的背景框架。\"\n                  },\n                  {\n                    \"source_handle\": \"P0438\",\n                    \"role\": \"例证\",\n                    \"use\": \"补充易位后髓系/NK 语境，如 Fn 抑制 NK/招募 MDSC。\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"局限\",\n                    \"use\": \"提供 FMT 联合 ICI 的机制异质性综述：可增加效应 T 细胞、减少 Treg/MDSC，也可能失败或引入不利代谢/菌群。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U03_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U03_P03\",\n                    \"unit_id\": \"Ch2_U03\",\n                    \"ordinal\": 3,\n                    \"point\": \"易位微生物的免疫后果主要由髓系细胞重编程决定。\",\n                    \"development\": \"说明易位细菌或屏障来源信号可通过 TLR/PRR 改变 TAM、MDSC 和巨噬细胞表型：在 PDAC 背景中促进免疫抑制性 TAM 并限制 T 细胞活化，抗生素清除后可恢复促炎表型与抗 PD-1 反应；同时用广谱 ICI 耐药综述补充 MDSC、M2 样 TAM、TGF-β/IL-10、缺氧和乳酸积累等共同构成免疫抑制网络；再用 FMT 综述指出微生物干预可能增加效应 T 细胞或减少抑制性髓系细胞，但失败案例同样存在。\",\n                    \"source_handles\": [\n                      \"P0084\",\n                      \"P0362\",\n                      \"P0438\",\n                      \"P0573\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U03_P04\",\n                \"point\": \"人类证据显示微生物屏障/易位相关重塑具有疗效与毒性的情境依赖，但不能直接外推小鼠因果。\",\n                \"development\": \"用 FMT-LUMINate 说明人类响应者以有害菌丢失、色氨酸代谢产物下降和 CD8+ T 细胞增加为特征，而 Prevotella 富集供体仅在双 ICI 背景下与严重毒性相关；结合 P. bifermentans 的活菌炎症/小分子增效双重机制与 FMT 综述中的异质性结果，强调同一微生物状态可能同时关联疗效与毒性，且依赖 ICI 方案、宿主基线与肿瘤类型。此处不展开代谢物浓度与剂量问题，留给 Ch3。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供人类 FMT 联合 ICI 中基线有害菌清除、代谢产物下降、CD8+ T 细胞增加及方案依赖毒性信号的核心临床证据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0284\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 FMT 联合 ICI 的机制异质性综述，支持情境依赖观点。\"\n                  },\n                  {\n                    \"source_handle\": \"P0333\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供微生物 - 代谢物 - 免疫轴的情境依赖综述框架，提示不同癌种、方案和宿主背景下同一微生物特征可能产生不同效应。\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"负责人指定\",\n                    \"use\": \"\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U03_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U03_P04\",\n                    \"unit_id\": \"Ch2_U03\",\n                    \"ordinal\": 4,\n                    \"point\": \"人类证据显示微生物屏障/易位相关重塑具有疗效与毒性的情境依赖，但不能直接外推小鼠因果。\",\n                    \"development\": \"用 FMT-LUMINate 说明人类响应者以有害菌丢失、色氨酸代谢产物下降和 CD8+ T 细胞增加为特征，而 Prevotella 富集供体仅在双 ICI 背景下与严重毒性相关；结合 P. bifermentans 的活菌炎症/小分子增效双重机制与 FMT 综述中的异质性结果，强调同一微生物状态可能同时关联疗效与毒性，且依赖 ICI 方案、宿主基线与肿瘤类型。此处不展开代谢物浓度与剂量问题，留给 Ch3。\",\n                    \"source_handles\": [\n                      \"P0583\",\n                      \"P0284\",\n                      \"P0573\",\n                      \"P0584\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"\",\n              \"argument_relations\": \"本单元承接 Ch2_U01 的先天识别/DC 启动，转向屏障与髓系层面的系统重塑，并为 Ch2_U04 的肿瘤类型特异性与模型差异提供机制基础；不重复 Ch5 的干预试验评价，也不深入 Ch3 的代谢物浓度/剂量问题。\",\n              \"supporting_studies\": [\n                {\n                  \"source_handle\": \"P0073\",\n                  \"paper_id\": \"1a747439d702aff9bb8fb4513e8de0c1063c237a\",\n                  \"contribution\": \"提供人源肠芯片中响应者/非响应者粪便对屏障完整性、炎症通路和微生物分子（LPS/鞭毛蛋白）差异的功能证据。\",\n                  \"conditions\": \"黑色素瘤患者粪便；肠芯片；LPS 与鞭毛蛋白对照。\",\n                  \"limits\": \"体外模型未整合完整免疫系统；样本量小；不能直接等同体内全身疗效。\"\n                },\n                {\n                  \"source_handle\": \"P0166\",\n                  \"paper_id\": \"48ff8778babb3307819f8c65b752079c1045f3a6\",\n                  \"contribution\": \"提供 ICT 诱导肠道细菌经 DC/CCR7 向 MLN、TDLN 和肿瘤转移，并增强肠外抗肿瘤免疫的因果路径。\",\n                  \"conditions\": \"B16-F10 小鼠；联合抗 PD-1/CTLA-4；DC 耗竭、CCR7 缺失、MLN 切除、抗生素与菌株回补。\",\n                  \"limits\": \"仅限黑色素瘤小鼠模型；联合 ICT 与单药可能不同；检测方法影响可见菌群。\"\n                },\n                {\n                  \"source_handle\": \"P0084\",\n                  \"paper_id\": \"1e9bcb85e156528e8eb9e781e4d4845dc4149ed6\",\n                  \"contribution\": \"提供 PDAC 中肠道菌群/细菌易位通过 PRR 和巨噬细胞/TAM 重编程形成局部免疫抑制的综述性机制框架。\",\n                  \"conditions\": \"PDAC 小鼠模型、KPC 粪便移植、抗生素与抗 PD-1 联合；综述整合。\",\n                  \"limits\": \"人体直接证据有限；具体菌株与人体互作细节未完全验证。\"\n                },\n                {\n                  \"source_handle\": \"P0284\",\n                  \"paper_id\": \"7cdc8a62c7a781f0b9a88abe52934ab9b889134d\",\n                  \"contribution\": \"提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。\",\n                  \"conditions\": \"黑色素瘤/NSCLC 队列；培养组学；Caco-2 屏障；DSS/MCA-205 小鼠模型；<3 kDa 上清组分。\",\n                  \"limits\": \"活性代谢物身份未明；小鼠模型不能完全复现人类 ir-colitis；临床关联为队列观察。\"\n                },\n                {\n                  \"source_handle\": \"P0362\",\n                  \"paper_id\": \"9d35f21e0312f02012226526155eabf2efc7472f\",\n                  \"contribution\": \"提供 ICI 耐药中 MDSC、TAM、Treg、缺氧、乳酸和氨基酸代谢等免疫抑制网络的背景框架。\",\n                  \"conditions\": \"多实体瘤耐药机制综述。\",\n                  \"limits\": \"叙述性综述，非微生物特异；未分层量化微生物贡献。\"\n                },\n                {\n                  \"source_handle\": \"P0438\",\n                  \"paper_id\": \"c01d091d25a86879909c5dbeacff09210ff73402\",\n                  \"contribution\": \"提供消化道肿瘤中 Fn 抑制 NK/招募 MDSC、Barnesiella 增强 T 细胞浸润等局部微生物调控案例，补充易位后髓系/NK 语境。\",\n                  \"conditions\": \"胃癌、结直肠癌、胰腺癌等消化道肿瘤综述；部分机制来自感染或化疗背景。\",\n                  \"limits\": \"主要聚焦消化道肿瘤；许多机制来自特定病原或临床前模型，不能直接等同 ICI 普遍机制。\"\n                },\n                {\n                  \"source_handle\": \"P0573\",\n                  \"paper_id\": \"ff51b7d7a956ceb17d4fb9e0f36c3446c6a4cf65\",\n                  \"contribution\": \"提供 FMT 联合 ICI 的机制异质性综述：可增加效应 T 细胞、减少 Treg/MDSC，也可能失败或引入不利代谢/菌群。\",\n                  \"conditions\": \"FMT 与 ICI 联合治疗的临床前/临床研究综述。\",\n                  \"limits\": \"叙述性综述；供体、受体和方案差异大；不能替代原始因果证据。\"\n                },\n                {\n                  \"source_handle\": \"P0583\",\n                  \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n                  \"contribution\": \"提供人类 FMT 联合 ICI 中基线有害菌清除、代谢产物下降、CD8+ T 细胞增加及方案依赖毒性信号的核心临床证据。\",\n                  \"conditions\": \"FMT-LUMINate II 期；NSCLC 抗 PD-1 单药，黑色素瘤抗 PD-1/CTLA-4 双药。\",\n                  \"limits\": \"单臂小样本；毒性关联需更大试验验证；机制外推受肿瘤类型和 ICI 方案限制。\"\n                },\n                {\n                  \"source_handle\": \"P0584\",\n                  \"paper_id\": \"CorpusId:290154100\",\n                  \"contribution\": \"提供微生物-代谢物-免疫轴的情境依赖综述框架，提示不同癌种、方案和宿主背景下同一微生物特征可能产生不同效应。\",\n                  \"conditions\": \"叙述性综述；涵盖多癌种、多 ICI 靶点与早期干预研究。\",\n                  \"limits\": \"无正式质量评估；多数机制来自临床前或小样本研究；不用于支持具体代谢物剂量结论。\"\n                }\n              ],\n              \"case_objects\": [\n                {\n                  \"conditions\": \"集成蠕动功能的人源肠芯片；黑色素瘤 ICI 响应者/非响应者粪便悬液或上清；Caco-2/HT-29 或 hiPSC 肠类器官与内皮细胞共培养；LPS 与鞭毛蛋白对照。\",\n                  \"finding\": \"非响应者粪便或 LPS 重现屏障损伤：ZO-1/β-catenin 下调、通透性增加、TNF/IL-6/NF-κB 促炎通路激活；响应者粪便富含鞭毛蛋白相关基因，激活 TLR-5 并伴随 IL-1β/IL-10 变化，屏障较稳定；纯化鞭毛蛋白可部分逆转 LPS 损伤。该模型提供人类粪便功能差异的体外机制证据，但未整合完整免疫系统。\",\n                  \"paper_id\": \"1a747439d702aff9bb8fb4513e8de0c1063c237a\",\n                  \"source_handle\": \"P0073\"\n                },\n                {\n                  \"conditions\": \"B16-F10 黑色素瘤小鼠；联合抗 PD-1/CTLA-4；DC 耗竭、CCR7 缺失、MLN 切除、抗生素处理或特定菌株回补。\",\n                  \"finding\": \"ICT 诱导特定肠道细菌（如 Enterococcus faecalis、Lactobacillus johnsonii）经 DC 摄取并以 CCR7 依赖方式转移至肠系膜淋巴结、肿瘤引流淋巴结和肿瘤；MLN 切除降低远端细菌负荷并削弱 ICT 诱导的 CD8+ T 细胞活化与抗肿瘤疗效；抗生素清除肠道菌群削弱疗效，回补可转移菌株部分恢复疗效。该过程不依赖全身肠道屏障通透性的普遍增加。\",\n                  \"paper_id\": \"48ff8778babb3307819f8c65b752079c1045f3a6\",\n                  \"source_handle\": \"P0166\"\n                },\n                {\n                  \"conditions\": \"黑色素瘤/NSCLC ICI 队列；ir-colitis 患者粪便培养组学；抗生素处理小鼠 FMT；Caco-2 屏障共培养；DSS 结肠炎与 MCA-205 肿瘤模型；P. bifermentans 活菌、上清或 <3 kDa 组分。\",\n                  \"finding\": \"Paraclostridium bifermentans 在急性 ir-colitis 中富集；活菌破坏 Caco-2 ZO-1/Occludin 并增加 TNF-α/IL-1β，而细胞游离上清不重现屏障破坏；口服活菌增强双 ICI 抗肿瘤反应，且 <3 kDa 小分子组分保留增效作用。该案例显示同一菌种可通过活菌依赖的屏障/炎症效应与代谢组分介导的疗效效应并行。\",\n                  \"paper_id\": \"7cdc8a62c7a781f0b9a88abe52934ab9b889134d\",\n                  \"source_handle\": \"P0284\"\n                },\n                {\n                  \"conditions\": \"PDAC 小鼠模型、KPC 粪便移植、抗生素处理、体外/体内巨噬细胞实验；综述整合门静脉、肠系膜淋巴结或胆道等潜在易位路径。\",\n                  \"finding\": \"肠道菌群或肿瘤内易位细菌可通过 PRR（如 TLR 信号）诱导巨噬细胞/TAM 向免疫抑制表型转化，抑制 T 细胞活化；清除肠道菌群后 TAM 更偏促炎表型，CD8+ T 细胞浸润增加，抗生素与抗 PD-1 在 PDAC 模型中显示协同。该证据主要为临床前综述整合，人体直接验证有限。\",\n                  \"paper_id\": \"1e9bcb85e156528e8eb9e781e4d4845dc4149ed6\",\n                  \"source_handle\": \"P0084\"\n                },\n                {\n                  \"conditions\": \"FMT-LUMINate II 期试验：NSCLC 抗 PD-1 单药，黑色素瘤抗 PD-1/CTLA-4 双药；宏基因组、代谢组、流式细胞术与小鼠因果验证。\",\n                  \"finding\": \"响应者以基线有害菌丢失为主，而非供体菌定植；伴随血浆色氨酸代谢产物降低与效应 CD8+ T 细胞增加；重新引入丢失的有害菌可抵消小鼠中的疗效。黑色素瘤双 ICI 背景下，富含 Prevotella 的供体簇与更严重免疫相关不良事件相关，而单药抗 PD-1 背景未观察到同等毒性。该案例提供人类干预中微生物重塑、免疫代谢与安全性情境依赖的边界。\",\n                  \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n                  \"source_handle\": \"P0583\"\n                }\n              ],\n              \"synthesis_and_transition\": \"屏障、易位与髓系重编程不是彼此并列的名词，而是一条条件化链条：屏障状态和治疗背景决定微生物信号是否进入肠外免疫区室，易位后的菌种/分子决定髓系细胞是被激活还是被抑制，髓系状态又反过来决定 CD8+ T 细胞能否有效启动。人类干预试验显示这一链条可伴随疗效或毒性，但其因果细节仍主要由小鼠和体外模型支持。下一单元将比较这些机制在不同肿瘤类型与模型系统中的表达差异及外推边界。\"\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0073\",\n              \"P0284\",\n              \"P0166\",\n              \"P0084\",\n              \"P0438\",\n              \"P0362\",\n              \"P0573\",\n              \"P0583\",\n              \"P0333\",\n              \"P0584\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch2::Ch2_U03::Ch2_U03_P01\",\n                \"Ch2::Ch2_U03::Ch2_U03_P02\",\n                \"Ch2::Ch2_U03::Ch2_U03_P03\",\n                \"Ch2::Ch2_U03::Ch2_U03_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch2_U04\",\n            \"focus\": \"肿瘤类型特异性与模型系统差异：从临床前因果到人类观察性证据\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch2_U04_P01\",\n                \"point\": \"肿瘤类型特异性：黑色素瘤、NSCLC与消化道肿瘤的机制异质性\",\n                \"development\": \"对比黑色素瘤、NSCLC与消化道肿瘤中机制表达的异质性。强调黑色素瘤中交叉反应性T细胞的主导作用，NSCLC中代谢微环境（腺苷积累）的决定性影响，以及消化道肿瘤中屏障完整性与易位的特殊地位。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0535\",\n                    \"role\": \"例证\",\n                    \"use\": \"非经典检查点配体在肿瘤细胞中高表达，与低 CD8+ T 细胞浸润及不良预后相关。\"\n                  },\n                  {\n                    \"source_handle\": \"P0146\",\n                    \"role\": \"例证\",\n                    \"use\": \"特定微生物群落塑造癌症免疫治疗响应，机制具有高度情境依赖性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"例证\",\n                    \"use\": \"供体聚类分析显示富含 Prevotella spp.的 Cluster B 与双 ICI 背景下严重 irAEs 显著相关。\"\n                  },\n                  {\n                    \"source_handle\": \"P0057\",\n                    \"role\": \"比较\",\n                    \"use\": \"对比 TNBC 中化疗与 ICI 对微生物组的不同影响（破坏 vs 恢复），以及 TMAO 诱导焦亡的机制。\"\n                  },\n                  {\n                    \"source_handle\": \"P0090\",\n                    \"role\": \"比较\",\n                    \"use\": \"汇总 mRCC 队列中抗生素暴露显著降低 ORR/PFS/OS 的观察性数据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0113\",\n                    \"role\": \"比较\",\n                    \"use\": \"分析 HCC 病因异质性（病毒性 vs 代谢性）下微生物组景观的差异及其对 ICI 响应的不同影响。\"\n                  },\n                  {\n                    \"source_handle\": \"P0270\",\n                    \"role\": \"比较\",\n                    \"use\": \"挑战跨癌种通用预测模型，发现 mCRPC 患者中 A. muciniphila 与疗效负相关。\"\n                  },\n                  {\n                    \"source_handle\": \"P0352\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供下呼吸道微生物组独立于肠道调节 NSCLC ICI 疗效的证据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0457\",\n                    \"role\": \"比较\",\n                    \"use\": \"系统综述肿瘤内驻留微生物群（非肠道）通过抗原呈递、Th1 极化及基质重塑调节局部免疫的三种机制。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U04_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U04_P01\",\n                    \"unit_id\": \"Ch2_U04\",\n                    \"ordinal\": 1,\n                    \"point\": \"肿瘤类型特异性：黑色素瘤、NSCLC与消化道肿瘤的机制异质性\",\n                    \"development\": \"对比黑色素瘤、NSCLC与消化道肿瘤中机制表达的异质性。强调黑色素瘤中交叉反应性T细胞的主导作用，NSCLC中代谢微环境（腺苷积累）的决定性影响，以及消化道肿瘤中屏障完整性与易位的特殊地位。\",\n                    \"source_handles\": [\n                      \"P0535\",\n                      \"P0146\",\n                      \"P0573\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch2_U04_P02\",\n                \"point\": \"模型系统差异：临床前因果发现与人类观察性证据的严格区分\",\n                \"development\": \"严格区分小鼠模型中的因果发现（如CRISPR敲除、抗体耗竭、FMT功能回补）与人类队列中的观察性关联（如单细胞表型、血清标志物）。强调模型系统差异导致的机制外推风险，划定后续章节的边界。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0535\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供肿瘤内微生物群与免疫调节通路的综述证据，作为人类观察性数据的参照。\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 FMT 联合 ICI 的机制异质性综述，提示临床转化中的不确定性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0146\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供特定微生物群落塑造癌症免疫治疗响应的综述，强调情境依赖性。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch2_U04_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch2_U04_P02\",\n                    \"unit_id\": \"Ch2_U04\",\n                    \"ordinal\": 2,\n                    \"point\": \"模型系统差异：临床前因果发现与人类观察性证据的严格区分\",\n                    \"development\": \"严格区分小鼠模型中的因果发现（如CRISPR敲除、抗体耗竭、FMT功能回补）与人类队列中的观察性关联（如单细胞表型、血清标志物）。强调模型系统差异导致的机制外推风险，划定后续章节的边界。\",\n                    \"source_handles\": [\n                      \"P0535\",\n                      \"P0573\",\n                      \"P0146\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [\n              {\n                \"table_id\": \"Ch2_U04_T01\",\n                \"purpose\": \"比较不同实体瘤类型中微生物组调节 ICI 疗效的关键特征、机制与证据等级\",\n                \"columns\": [\n                  \"肿瘤类型\",\n                  \"关键微生物特征\",\n                  \"主要机制/通路\",\n                  \"证据类型 (临床前/人类)\",\n                  \"来源\"\n                ],\n                \"row_tasks\": [\n                  {\n                    \"content\": \"黑色素瘤：六酰化 LPS 富集，T 细胞交叉反应\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0080\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供六酰化 LPS 与抗 PD-1 疗效关联\"\n                      },\n                      {\n                        \"source_handle\": \"P0388\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 T 细胞交叉反应机制\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"NSCLC：下呼吸道菌群独立作用，腺苷代谢微环境\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0352\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供下呼吸道微生物组证据\"\n                      },\n                      {\n                        \"source_handle\": \"P0269\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供腺苷代谢微环境机制\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"RCC：抗生素暴露显著降低疗效，FMT 恢复敏感性\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0090\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供抗生素暴露与疗效关联\"\n                      },\n                      {\n                        \"source_handle\": \"P0146\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 FMT 恢复敏感性证据\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"HCC：病因异质性（病毒性 vs 代谢性）影响菌群景观\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0113\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 HCC 病因异质性分析\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"前列腺癌 (mCRPC)：A. muciniphila 与疗效负相关（反例）\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0270\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 A. muciniphila 负相关反例\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"TNBC：化疗与 ICI 对菌群影响不同，TMAO 诱导焦亡\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0057\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供 TNBC 化疗与 ICI 对比\"\n                      }\n                    ]\n                  },\n                  {\n                    \"content\": \"消化道肿瘤：屏障完整性与细菌易位关键\",\n                    \"source_uses\": [\n                      {\n                        \"source_handle\": \"P0438\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供消化道肿瘤局部微生物调控案例\"\n                      },\n                      {\n                        \"source_handle\": \"P0457\",\n                        \"role\": \"比较\",\n                        \"use\": \"提供肿瘤内微生物群机制\"\n                      }\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"\",\n              \"transition\": \"\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"对比TNBC中化疗与ICI对微生物组的不同影响（破坏vs恢复），以及TMAO诱导焦亡的机制，凸显肿瘤类型与治疗方式对菌群效应的修饰作用。\",\n                  \"paper_id\": \"17a3c5cfa0cf5f59523761562650015ee0a27a38\",\n                  \"source_handle\": \"P0057\"\n                },\n                {\n                  \"contribution\": \"汇总mRCC队列中抗生素暴露显著降低ORR/PFS/OS的观察性数据，与小鼠FMT恢复敏感性的因果发现形成严格对照，划定外推边界。\",\n                  \"paper_id\": \"2253f6b8b722c18cd3ea17b12f5a944ac838b73c\",\n                  \"source_handle\": \"P0090\"\n                },\n                {\n                  \"contribution\": \"分析HCC病因异质性（病毒性vs代谢性）下微生物组景观的差异及其对ICI响应的不同影响，说明单一标志物普适性受限的情境依赖性。\",\n                  \"paper_id\": \"311fa59a8b5fb73c98a3ccc71ace6cff185cf5a1\",\n                  \"source_handle\": \"P0113\"\n                },\n                {\n                  \"contribution\": \"挑战跨癌种通用预测模型，发现mCRPC患者中A. muciniphila与疗效负相关，提示既往内分泌治疗史可能重塑菌群-疗效关系，为标志物异质性及治疗史作为混杂因素提供关键反例。\",\n                  \"paper_id\": \"74786f8df0c7648840756833a4b4bc49ace34be6\",\n                  \"source_handle\": \"P0270\"\n                },\n                {\n                  \"contribution\": \"提供下呼吸道微生物组独立于肠道调节NSCLC ICI疗效的证据，识别出Bacillus为有益菌而Sphingomonas/Sediminibacterium为有害菌，补充部位特异性微生物组对实体瘤疗效影响的对照案例。\",\n                  \"paper_id\": \"99e3a3f190fb24b09b9be22b5300e85bd8a34e43\",\n                  \"source_handle\": \"P0352\"\n                },\n                {\n                  \"contribution\": \"系统综述肿瘤内驻留微生物群（非肠道）通过抗原呈递、Th1极化及基质重塑调节局部免疫的三种机制，补充肿瘤局部微环境与全身肠道菌群效应的空间对比视角。\",\n                  \"paper_id\": \"c9e703c8b55bc186c169f077572bc056d0e0e549\",\n                  \"source_handle\": \"P0457\"\n                }\n              ],\n              \"case_objects\": [\n                {\n                  \"conditions\": \"人类TCGA RNA-seq与CPTAC蛋白质组学数据集\",\n                  \"finding\": \"非经典检查点配体在肿瘤细胞中高表达，与低CD8+ T细胞浸润及不良预后相关。\",\n                  \"paper_id\": \"eea4059be35526f75d745cc8d16db8ec33658f69\",\n                  \"source_handle\": \"P0535\"\n                },\n                {\n                  \"conditions\": \"人类肾细胞癌CheckMate 025队列及小鼠同系移植瘤模型\",\n                  \"finding\": \"特定微生物群落塑造癌症免疫治疗响应，机制具有高度情境依赖性。\",\n                  \"paper_id\": \"4171288ecca93c6bca3eee61295418d704bb00fd\",\n                  \"source_handle\": \"P0146\"\n                },\n                {\n                  \"conditions\": \"FMT-LUMINate黑色素瘤队列及MIMIC试验数据，Bray-Curtis不相似度聚类\",\n                  \"finding\": \"供体聚类分析显示富含Prevotella spp.的Cluster B与双ICI背景下严重irAEs显著相关。\",\n                  \"paper_id\": \"ff51b7d7a956ceb17d4fb9e0f36c3446c6a4cf65\",\n                  \"source_handle\": \"P0573\"\n                }\n              ],\n              \"synthesis_and_transition\": \"肿瘤类型特异性与模型系统差异决定了机制外推的边界。严格区分临床前因果发现与人类观察性关联，是避免过度解读的前提。下一章将聚焦于纯代谢物化学结构分析，进一步细化微生物信号转化的生化路径。\"\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0535\",\n              \"P0146\",\n              \"P0573\",\n              \"P0057\",\n              \"P0090\",\n              \"P0113\",\n              \"P0270\",\n              \"P0352\",\n              \"P0457\",\n              \"P0080\",\n              \"P0388\",\n              \"P0269\",\n              \"P0438\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch2::Ch2_U04::Ch2_U04_P01\",\n                \"Ch2::Ch2_U04::Ch2_U04_P02\"\n              ],\n              \"table_tasks\": [\n                \"Ch2::Ch2_U04::Ch2_U04_T01\"\n              ]\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch3\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"微生物代谢物的中介作用与分子机制\",\n          \"chapter_purpose\": \"读者将掌握四大类核心微生物代谢物调节 ICI 疗效的具体分子靶点与下游通路，理解代谢物效应的强情境依赖性（如 SCFAs 在 PD-1 与 CTLA-4 背景下的双向作用），并明确当前文献中人体 TME 代谢物浓度数据的缺失现状（特别是肌苷仅有血浆关联数据而无组织实测值）及其对因果推断的限制。\",\n          \"chapter_scope\": \"肠道微生物组通过特定代谢物（如 SCFAs、肌苷、胆汁酸及色氨酸衍生物）介导的表观遗传修饰、受体信号传导及肿瘤细胞内在重编程，系统性调节实体瘤对 ICI 的疗效；然而，现有临床证据高度依赖血浆或粪便浓度作为系统性暴露代理，人体肿瘤微环境（TME）内代谢物的绝对生理浓度及其与疗效的直接定量关联仍属关键证据缺口，尤其是肌苷在 TME 内的实测数据缺失限制了因果推断与剂量优化。\",\n          \"chapter_thesis\": \"肠道微生物组通过特定代谢物（如 SCFAs、肌苷、胆汁酸及色氨酸衍生物）介导的表观遗传修饰、受体信号传导及肿瘤细胞内在重编程，系统性调节实体瘤对 ICI 的疗效；然而，现有临床证据高度依赖血浆或粪便浓度作为系统性暴露代理，人体肿瘤微环境（TME）内代谢物的绝对生理浓度及其与疗效的直接定量关联仍属关键证据缺口，尤其是肌苷在 TME 内的实测数据缺失限制了因果推断与剂量优化。\",\n          \"chapter_argument\": \"肠道微生物组通过特定代谢物（如 SCFAs、肌苷、胆汁酸及色氨酸衍生物）介导的表观遗传修饰、受体信号传导及肿瘤细胞内在重编程，系统性调节实体瘤对 ICI 的疗效；然而，现有临床证据高度依赖血浆或粪便浓度作为系统性暴露代理，人体肿瘤微环境（TME）内代谢物的绝对生理浓度及其与疗效的直接定量关联仍属关键证据缺口，尤其是肌苷在 TME 内的实测数据缺失限制了因果推断与剂量优化。\",\n          \"reader_objective\": \"读者将掌握四大类核心微生物代谢物调节 ICI 疗效的具体分子靶点与下游通路，理解代谢物效应的强情境依赖性（如 SCFAs 在 PD-1 与 CTLA-4 背景下的双向作用），并明确当前文献中人体 TME 代谢物浓度数据的缺失现状（特别是肌苷仅有血浆关联数据而无组织实测值）及其对因果推断的限制。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"U3_1\",\n            \"focus\": \"短链脂肪酸（SCFAs）通过 HDAC 抑制与 GPCR 信号通路发挥双重免疫调节作用，其效应方向严格取决于 ICI 靶点类型、局部微环境状态及浓度阈值。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U3_1_P01\",\n                \"point\": \"阐明 SCFAs（乙酸、丙酸、丁酸）通过 HDAC 抑制与 GPR41/43/GPR109A 受体调控免疫细胞代谢与分化的基础生化路径。\",\n                \"development\": \"对比 SCFAs 在正常结肠上皮与肿瘤微环境中的代谢流向差异，建立表观遗传调控的理论框架。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0515\",\n                    \"role\": \"主论据\",\n                    \"use\": \"详述丁酸通过 HDAC 抑制上调 Pdcd1/Cd28 增强 CD8+ T 细胞记忆的分子基础\"\n                  },\n                  {\n                    \"source_handle\": \"P0544\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 CRC 背景下调节微生物群增强 ICI 疗效的机制分类框架\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_1_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_1_P01\",\n                    \"unit_id\": \"U3_1\",\n                    \"ordinal\": 1,\n                    \"point\": \"阐明 SCFAs（乙酸、丙酸、丁酸）通过 HDAC 抑制与 GPR41/43/GPR109A 受体调控免疫细胞代谢与分化的基础生化路径。\",\n                    \"development\": \"对比 SCFAs 在正常结肠上皮与肿瘤微环境中的代谢流向差异，建立表观遗传调控的理论框架。\",\n                    \"source_handles\": [\n                      \"P0515\",\n                      \"P0544\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_1_P02\",\n                \"point\": \"呈现 SCFAs 在抗 PD-1 治疗中增强抗肿瘤免疫的临床与临床前证据。\",\n                \"development\": \"结合 P0092 与 P0223 的队列数据，说明高粪便 SCFA 水平如何转化为更长的 PFS，并引用 P0515 解释其增强 CD8+ T 细胞杀伤的分子基础。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0092\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供粪便 SCFA 水平与抗 PD-1 疗效正相关的临床队列证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0223\",\n                    \"role\": \"主论据\",\n                    \"use\": \"补充实体瘤抗 PD-1 治疗中响应者 fSCFA 显著升高的表型数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0515\",\n                    \"role\": \"背景\",\n                    \"use\": \"解释 SCFA 增强 CD8+ T 细胞杀伤的分子基础\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_1_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_1_P02\",\n                    \"unit_id\": \"U3_1\",\n                    \"ordinal\": 2,\n                    \"point\": \"呈现 SCFAs 在抗 PD-1 治疗中增强抗肿瘤免疫的临床与临床前证据。\",\n                    \"development\": \"结合 P0092 与 P0223 的队列数据，说明高粪便 SCFA 水平如何转化为更长的 PFS，并引用 P0515 解释其增强 CD8+ T 细胞杀伤的分子基础。\",\n                    \"source_handles\": [\n                      \"P0092\",\n                      \"P0223\",\n                      \"P0515\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_1_P03\",\n                \"point\": \"揭示 SCFAs 在抗 CTLA-4 治疗中的负面或限制性作用。\",\n                \"development\": \"基于 P0503 与 P0559 的数据，论证高血清丁酸/丙酸如何通过促进 Treg 极化或抑制 DC 表面共刺激分子表达，削弱抗 CTLA-4 介导的初始 T 细胞激活。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0503\",\n                    \"role\": \"主论据\",\n                    \"use\": \"揭示血清丁酸/丙酸与抗 CTLA-4 预后负相关，阐明靶点依赖性\"\n                  },\n                  {\n                    \"source_handle\": \"P0559\",\n                    \"role\": \"比较\",\n                    \"use\": \"绘制高阶机制图谱，区分丁酸盐对 PD-1 与 CTLA-4 抑制剂疗效的差异化影响\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_1_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_1_P03\",\n                    \"unit_id\": \"U3_1\",\n                    \"ordinal\": 3,\n                    \"point\": \"揭示 SCFAs 在抗 CTLA-4 治疗中的负面或限制性作用。\",\n                    \"development\": \"基于 P0503 与 P0559 的数据，论证高血清丁酸/丙酸如何通过促进 Treg 极化或抑制 DC 表面共刺激分子表达，削弱抗 CTLA-4 介导的初始 T 细胞激活。\",\n                    \"source_handles\": [\n                      \"P0503\",\n                      \"P0559\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_1_P04\",\n                \"point\": \"分析微环境缺氧状态与代谢物浓度阈值对 SCFAs 效应方向的决定性影响。\",\n                \"development\": \"利用 P0377 与 P0544 的机制发现，指出在葡萄糖剥夺或严重缺氧条件下，SCFAs 可能被肿瘤细胞逆向摄取作为碳源，从而逆转其预期的抑癌效果。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0377\",\n                    \"role\": \"主论据\",\n                    \"use\": \"展示缺氧微环境中癌细胞逆向摄取丁酸供能的反常现象\"\n                  },\n                  {\n                    \"source_handle\": \"P0544\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 CRC 中调节微生物群增强 ICI 疗效的机制视角\"\n                  },\n                  {\n                    \"source_handle\": \"P0220\",\n                    \"role\": \"发展\",\n                    \"use\": \"梳理 SCFA 在不同浓度与癌种下的矛盾功能，为解释情境依赖性提供理论框架\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_1_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_1_P04\",\n                    \"unit_id\": \"U3_1\",\n                    \"ordinal\": 4,\n                    \"point\": \"分析微环境缺氧状态与代谢物浓度阈值对 SCFAs 效应方向的决定性影响。\",\n                    \"development\": \"利用 P0377 与 P0544 的机制发现，指出在葡萄糖剥夺或严重缺氧条件下，SCFAs 可能被肿瘤细胞逆向摄取作为碳源，从而逆转其预期的抑癌效果。\",\n                    \"source_handles\": [\n                      \"P0377\",\n                      \"P0544\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"上述案例共同表明，SCFAs 并非单向的“免疫增敏剂”。其在 PD-1 背景下主要通过表观遗传重编程增强效应 T 细胞功能（P0092, P0515），而在 CTLA-4 背景下可能因过度促进 Treg 或干扰 DC 共刺激信号而限制疗效（P0503）。此外，微环境的缺氧状态与局部浓度阈值决定了 SCFAs 是作为抑癌代谢物还是促癌底物（P0377），这要求后续机制讨论必须剥离单一维度的线性描述。\",\n              \"transition\": \"与 SCFAs 主要作用于宿主免疫细胞不同，部分微生物代谢物能够直接穿透细胞膜靶向肿瘤细胞内在蛋白，从而重塑肿瘤的抗原呈递属性。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供粪便SCFA水平与抗PD-1疗效正相关的临床队列证据，确立其作为疗效预测标志物的实证基础。\",\n                  \"paper_id\": \"2365676f101b69b7a4aa2e5ba20e1e3bbe1c0cb6\",\n                  \"source_handle\": \"P0092\"\n                },\n                {\n                  \"contribution\": \"揭示血清丁酸/丙酸与抗CTLA-4预后负相关，阐明SCFA效应的靶点依赖性与情境反转。\",\n                  \"paper_id\": \"e2d5688c3346ac3349ad3e82b9abf9f5b92382ee\",\n                  \"source_handle\": \"P0503\"\n                },\n                {\n                  \"contribution\": \"详述丁酸通过HDAC抑制上调Pdcd1/Cd28增强CD8+ T细胞记忆，同时提示Treg分化的双向潜力。\",\n                  \"paper_id\": \"e79cf5704aa32b05d4bd83b923592452b3074529\",\n                  \"source_handle\": \"P0515\"\n                },\n                {\n                  \"contribution\": \"展示缺氧微环境中癌细胞逆向摄取丁酸供能的反常现象，凸显代谢物效应的微环境阈值依赖性。\",\n                  \"paper_id\": \"a2db7c8539dee7153c704805a86c4fbcbdb2c8c9\",\n                  \"source_handle\": \"P0377\"\n                },\n                {\n                  \"contribution\": \"补充实体瘤抗PD-1治疗中响应者fSCFA显著升高的表型数据，强化代谢物介导免疫激活的临床关联。\",\n                  \"paper_id\": \"5dafc84d8aa8c1cc679fad0bfc3f4fa134a26c65\",\n                  \"source_handle\": \"P0223\"\n                },\n                {\n                  \"contribution\": \"梳理SCFA在不同浓度与癌种下的矛盾功能，为解释肠道菌群对ICI疗效的情境依赖性提供理论框架。\",\n                  \"paper_id\": \"5d4d1432a51cc91edfadc9f8ca60f84f5bd9c2f4\",\n                  \"source_handle\": \"P0220\"\n                },\n                {\n                  \"contribution\": \"绘制微生物代谢物调节抗肿瘤免疫的高阶机制图谱，详细区分不同代谢物对PD-1与CTLA-4抑制剂疗效的差异化影响（如丁酸盐的双刃剑效应）。\",\n                  \"paper_id\": \"f740fe4e28eed64b9c255e57d2e93b64c6cbdd27\",\n                  \"source_handle\": \"P0559\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0515\",\n              \"P0544\",\n              \"P0092\",\n              \"P0223\",\n              \"P0503\",\n              \"P0559\",\n              \"P0377\",\n              \"P0220\",\n              \"P0582\",\n              \"P0580\",\n              \"P0579\",\n              \"P0581\",\n              \"P0639\",\n              \"P0634\",\n              \"P0609\",\n              \"P0586\",\n              \"P0587\",\n              \"P0589\",\n              \"P0588\",\n              \"P0593\",\n              \"P0591\",\n              \"P0592\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch3::U3_1::U3_1_P01\",\n                \"Ch3::U3_1::U3_1_P02\",\n                \"Ch3::U3_1::U3_1_P03\",\n                \"Ch3::U3_1::U3_1_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U3_2\",\n            \"focus\": \"肌苷直接靶向肿瘤细胞泛素激活酶 UBA6，解除其对炎症信号与 MHC-I 表达的抑制，从而增强肿瘤内在免疫原性与 T 细胞杀伤敏感性；然而，人体肿瘤微环境（TME）内肌苷的绝对生理浓度数据缺失，现有临床关联仅基于血浆水平。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U3_2_P01\",\n                \"point\": \"详述肌苷靶向 UBA6 的生化结合验证、遗传学回补实验及对肿瘤细胞抗原呈递通路的分子重塑。\",\n                \"development\": \"整合 P0582 的 LiP-SMap 筛选、体外硫酯酶活性测定及 CRISPR 敲除数据，构建“肌苷-UBA6-USE1-FAT10\\\"信号轴，阐明其如何解除肿瘤内在免疫抑制。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0582\",\n                    \"role\": \"主论据\",\n                    \"use\": \"核心文献，证实肌苷直接结合 UBA6 解除 MHC-I 抑制\"\n                  },\n                  {\n                    \"source_handle\": \"P0593\",\n                    \"role\": \"例证\",\n                    \"use\": \"发现别嘌醇通过嘌呤补救途径增加肌苷分泌、增强肿瘤免疫原性的分子机制\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_2_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_2_P01\",\n                    \"unit_id\": \"U3_2\",\n                    \"ordinal\": 1,\n                    \"point\": \"详述肌苷靶向 UBA6 的生化结合验证、遗传学回补实验及对肿瘤细胞抗原呈递通路的分子重塑。\",\n                    \"development\": \"整合 P0582 的 LiP-SMap 筛选、体外硫酯酶活性测定及 CRISPR 敲除数据，构建“肌苷-UBA6-USE1-FAT10\\\"信号轴，阐明其如何解除肿瘤内在免疫抑制。\",\n                    \"source_handles\": [\n                      \"P0582\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_2_P02\",\n                \"point\": \"汇报 CheckMate 025 队列中血浆肌苷水平与抗 PD-1 治疗总生存期的定量关联，并强调其作为系统性暴露代理的局限性。\",\n                \"development\": \"基于 P0582 的临床队列数据，对比 nivolumab 与 everolimus 组的差异，确立高血浆肌苷作为 ICI 疗效预测因子的统计效力，同时指出缺乏 TME 实测数据的现状。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0582\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 CheckMate 025 队列中血浆肌苷与 OS 关联的临床数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0588\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供肌苷联合 ICI 治疗晚期实体瘤的随机对照临床 II 期数据，证实 PFS 获益\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_2_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_2_P02\",\n                    \"unit_id\": \"U3_2\",\n                    \"ordinal\": 2,\n                    \"point\": \"汇报 CheckMate 025 队列中血浆肌苷水平与抗 PD-1 治疗总生存期的定量关联，并强调其作为系统性暴露代理的局限性。\",\n                    \"development\": \"基于 P0582 的临床队列数据，对比 nivolumab 与 everolimus 组的差异，确立高血浆肌苷作为 ICI 疗效预测因子的统计效力，同时指出缺乏 TME 实测数据的现状。\",\n                    \"source_handles\": [\n                      \"P0582\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_2_P03\",\n                \"point\": \"区分肌苷的肿瘤内在作用（UBA6 抑制）与 T 细胞外在作用（A2AR 激活/碳源补充）。\",\n                \"development\": \"结合 P0124 与 P0584，对比肌苷在肿瘤细胞内直接抑制 UBA6 与在 T 细胞内通过 A2AR/cAMP 通路或替代糖酵解途径发挥作用的平行机制，避免机制混淆。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0124\",\n                    \"role\": \"主论据\",\n                    \"use\": \"阐释双歧杆菌来源肌苷经 A2AR/cAMP 通路促进 Th1 分化及作为替代碳源维持效应 T 细胞存活\"\n                  },\n                  {\n                    \"source_handle\": \"P0251\",\n                    \"role\": \"比较\",\n                    \"use\": \"对比生态与还原论方法，明确双歧杆菌通过肌苷-A2AR 轴增强 T 细胞活性的分子路径\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供腺苷脱氨酶将免疫抑制性腺苷转化为肌苷的药代动力学数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_2_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_2_P03\",\n                    \"unit_id\": \"U3_2\",\n                    \"ordinal\": 3,\n                    \"point\": \"区分肌苷的肿瘤内在作用（UBA6 抑制）与 T 细胞外在作用（A2AR 激活/碳源补充）。\",\n                    \"development\": \"结合 P0124 与 P0584，对比肌苷在肿瘤细胞内直接抑制 UBA6 与在 T 细胞内通过 A2AR/cAMP 通路或替代糖酵解途径发挥作用的平行机制，避免机制混淆。\",\n                    \"source_handles\": [\n                      \"P0124\",\n                      \"P0251\",\n                      \"P0584\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_2_P04\",\n                \"point\": \"明确标注人体 TME 内肌苷绝对浓度数据的缺失现状及药代动力学挑战。\",\n                \"development\": \"综合 P0582 与 P0584 的讨论，指出腺苷快速降解（~10 秒）与肌苷较长半衰期（~15 小时）导致的测量窗口限制，以及缺乏原位微透析或空间代谢组学数据的现状，强调这是限制机制确证的关键缺口。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0582\",\n                    \"role\": \"局限\",\n                    \"use\": \"明确指出因样本完整性问题未能在人体肿瘤队列中直接检测肌苷浓度\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"局限\",\n                    \"use\": \"指出体外有效浓度属人工设定而非内源性实测值，体内浓度受血流灌注与降解酶多重制约\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_2_P04\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_2_P04\",\n                    \"unit_id\": \"U3_2\",\n                    \"ordinal\": 4,\n                    \"point\": \"明确标注人体 TME 内肌苷绝对浓度数据的缺失现状及药代动力学挑战。\",\n                    \"development\": \"综合 P0582 与 P0584 的讨论，指出腺苷快速降解（~10 秒）与肌苷较长半衰期（~15 小时）导致的测量窗口限制，以及缺乏原位微透析或空间代谢组学数据的现状，强调这是限制机制确证的关键缺口。\",\n                    \"source_handles\": [\n                      \"P0582\",\n                      \"P0584\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"肌苷的作用具有明确的靶点特异性：它并非单纯作用于免疫细胞，而是通过直接抑制肿瘤细胞 UBA6 来解除对 MHC-I 与炎症通路的转录后抑制（P0582），同时作为 T 细胞的代谢燃料与 A2AR 配体协同增效（P0124, P0584）。CheckMate 025 队列提供了循环肌苷预测 OS 的强临床关联（P0582），但所有研究均受限于无法在人体活检组织中直接定量肌苷浓度，目前仅能依赖血浆水平或 UBA6 表达作为间接代理指标。这一缺口阻碍了确定 TME 内有效抑制 UBA6 所需的肌苷浓度阈值。\",\n              \"transition\": \"除了直接靶向肿瘤细胞或作为 T 细胞燃料外，更多微生物代谢物通过激活宿主核受体网络，远程调控髓系与淋巴系细胞的极化平衡。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"核心文献，证实肌苷直接结合UBA6解除MHC-I抑制，并指出人体肿瘤内实测浓度缺失的关键转化缺口。\",\n                  \"paper_id\": \"CorpusId:252309032\",\n                  \"source_handle\": \"P0582\"\n                },\n                {\n                  \"contribution\": \"阐释双歧杆菌来源肌苷经A2AR/cAMP通路促进Th1分化及作为替代碳源维持效应T细胞存活的平行机制。\",\n                  \"paper_id\": \"364d5abc343a02132e4f3f24c0b441cb277190f2\",\n                  \"source_handle\": \"P0124\"\n                },\n                {\n                  \"contribution\": \"提供腺苷脱氨酶将免疫抑制性腺苷转化为肌苷的药代动力学数据，说明肌苷半衰期延长对微环境暴露的意义。\",\n                  \"paper_id\": \"CorpusId:290154100\",\n                  \"source_handle\": \"P0584\"\n                },\n                {\n                  \"contribution\": \"对比生态与还原论方法，明确双歧杆菌通过肌苷-A2AR轴增强T细胞活性的分子路径，支撑机制解析。\",\n                  \"paper_id\": \"68b67449fc944c707f68e31b629b3909e59b29ea\",\n                  \"source_handle\": \"P0251\"\n                },\n                {\n                  \"contribution\": \"提供肌苷联合ICI治疗晚期实体瘤的首个随机对照临床II期数据，证实了肌苷在延长PFS方面的统计学显著性，并为“肠道代谢物调节免疫治疗”假说提供了初步临床支持。\",\n                  \"paper_id\": \"CorpusId:272644866\",\n                  \"source_handle\": \"P0588\"\n                },\n                {\n                  \"contribution\": \"建立基于单细胞分辨率的药物诱导TME重塑量化框架，发现别嘌醇通过嘌呤补救途径增加肌苷分泌、增强肿瘤免疫原性和T细胞功能的分子机制。\",\n                  \"paper_id\": \"CorpusId:286644045\",\n                  \"source_handle\": \"P0593\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0582\",\n              \"P0593\",\n              \"P0588\",\n              \"P0124\",\n              \"P0251\",\n              \"P0584\",\n              \"P0580\",\n              \"P0579\",\n              \"P0581\",\n              \"P0639\",\n              \"P0634\",\n              \"P0609\",\n              \"P0586\",\n              \"P0587\",\n              \"P0589\",\n              \"P0591\",\n              \"P0592\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch3::U3_2::U3_2_P01\",\n                \"Ch3::U3_2::U3_2_P02\",\n                \"Ch3::U3_2::U3_2_P03\",\n                \"Ch3::U3_2::U3_2_P04\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U3_3\",\n            \"focus\": \"次级胆汁酸与色氨酸代谢物主要通过激活宿主核受体（FXR, TGR5, AhR, RORγt）重塑髓系与淋巴系细胞的极化状态，进而决定抗肿瘤免疫基调。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U3_3_P01\",\n                \"point\": \"阐述次级胆汁酸（TDCA, UDCA 等）通过 TGR5/FXR 受体增强 CD8+ T 细胞杀伤与巨噬细胞 M1 极化的机制。\",\n                \"development\": \"整合 P0481 与 P0424 的证据，说明胆汁酸如何克服抗生素介导的菌群耗竭，并在 HCC 患者中转化为可测量的预后标志物。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0481\",\n                    \"role\": \"主论据\",\n                    \"use\": \"证实牛磺脱氧胆酸经 TGR5 受体直接增强 CD8+ T 细胞毒性，并在菌群失调模型中恢复 ICI 疗效\"\n                  },\n                  {\n                    \"source_handle\": \"P0424\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供不可切除肝细胞癌队列中次级胆汁酸丰度与更长 PFS 的正向关联\"\n                  },\n                  {\n                    \"source_handle\": \"P0186\",\n                    \"role\": \"背景\",\n                    \"use\": \"基于毛螺菌科比较基因组学预测胆汁酸转化基因簇，为核受体配体生成提供菌株特异性功能线索\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_3_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_3_P01\",\n                    \"unit_id\": \"U3_3\",\n                    \"ordinal\": 1,\n                    \"point\": \"阐述次级胆汁酸（TDCA, UDCA 等）通过 TGR5/FXR 受体增强 CD8+ T 细胞杀伤与巨噬细胞 M1 极化的机制。\",\n                    \"development\": \"整合 P0481 与 P0424 的证据，说明胆汁酸如何克服抗生素介导的菌群耗竭，并在 HCC 患者中转化为可测量的预后标志物。\",\n                    \"source_handles\": [\n                      \"P0481\",\n                      \"P0424\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_3_P02\",\n                \"point\": \"解析色氨酸代谢物（IPA, Kynurenine）通过 AhR 与 RORγt 受体调控 T 细胞亚群分化与骨髓细胞极化的路径。\",\n                \"development\": \"基于 P0180 与 P0209，对比保护性吲哚衍生物（激活 AhR 维持 T 细胞干性）与致病性犬尿氨酸（抑制 T 细胞/促进 Treg）的双向调节作用。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0180\",\n                    \"role\": \"主论据\",\n                    \"use\": \"揭示次级胆汁酸结合非经典核受体 RORγt 与 NR4A1，精细调控 Th17/Treg 平衡的分子细节\"\n                  },\n                  {\n                    \"source_handle\": \"P0209\",\n                    \"role\": \"主论据\",\n                    \"use\": \"阐明色氨酸代谢物 IPA 通过 AhR 维持 CD8+ T 细胞干性（Tcf7 超增强子），并与抗 PD-1 产生协同效应\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_3_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_3_P02\",\n                    \"unit_id\": \"U3_3\",\n                    \"ordinal\": 2,\n                    \"point\": \"解析色氨酸代谢物（IPA, Kynurenine）通过 AhR 与 RORγt 受体调控 T 细胞亚群分化与骨髓细胞极化的路径。\",\n                    \"development\": \"基于 P0180 与 P0209，对比保护性吲哚衍生物（激活 AhR 维持 T 细胞干性）与致病性犬尿氨酸（抑制 T 细胞/促进 Treg）的双向调节作用。\",\n                    \"source_handles\": [\n                      \"P0180\",\n                      \"P0209\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_3_P03\",\n                \"point\": \"讨论核受体信号在跨组织免疫监视中的系统性与局部性差异。\",\n                \"development\": \"结合 P0180 与 P0481 的动物模型数据，辨析核受体配体在肠道局部稳态维持与远端肿瘤微环境重塑中的剂量与分布差异。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0180\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供核受体配体在肠道局部稳态维持与远端肿瘤微环境重塑中的剂量与分布差异的理论支撑\"\n                  },\n                  {\n                    \"source_handle\": \"P0481\",\n                    \"role\": \"例证\",\n                    \"use\": \"展示胆汁酸在克服抗生素介导的菌群耗竭中的远端肿瘤微环境重塑作用\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_3_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_3_P03\",\n                    \"unit_id\": \"U3_3\",\n                    \"ordinal\": 3,\n                    \"point\": \"讨论核受体信号在跨组织免疫监视中的系统性与局部性差异。\",\n                    \"development\": \"结合 P0180 与 P0481 的动物模型数据，辨析核受体配体在肠道局部稳态维持与远端肿瘤微环境重塑中的剂量与分布差异。\",\n                    \"source_handles\": [\n                      \"P0180\",\n                      \"P0481\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"胆汁酸与色氨酸代谢物构成了微生物 - 宿主跨器官通讯的核心化学语言。TDCA 通过 TGR5 直接赋能 CD8+ T 细胞（P0481），而多种次级胆汁酸与 IPA 则通过 FXR/TGR5/AhR/RORγt 等核受体网络精细调控 Th17/Treg 比例与巨噬细胞表型（P0180, P0209）。HCC 队列数据进一步证实，这些受体介导的代谢信号不仅存在于动物模型，也在人类实体瘤患者的基线代谢谱中与长期临床获益挂钩（P0424）。\",\n              \"transition\": \"上述代谢物不仅作为独立的信号分子，还深度嵌入宿主免疫细胞的能量代谢与表观遗传网络中，形成多维度的功能整合。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"证实牛磺脱氧胆酸经TGR5受体直接增强CD8+ T细胞毒性，并在菌群失调模型中恢复ICI疗效。\",\n                  \"paper_id\": \"d684f0baadf8b8893a164468cb9ee38f1eb49901\",\n                  \"source_handle\": \"P0481\"\n                },\n                {\n                  \"contribution\": \"揭示次级胆汁酸结合非经典核受体RORγt与NR4A1，精细调控Th17/Treg平衡的分子细节。\",\n                  \"paper_id\": \"4ed2637cc267e69d764e877652226e827eb752a9\",\n                  \"source_handle\": \"P0180\"\n                },\n                {\n                  \"contribution\": \"阐明色氨酸代谢物IPA通过AhR维持CD8+ T细胞干性（Tcf7超增强子），并与抗PD-1产生协同效应。\",\n                  \"paper_id\": \"5a81f2ebb2189b30d6f36f3aa8ed1ae9503fa614\",\n                  \"source_handle\": \"P0209\"\n                },\n                {\n                  \"contribution\": \"提供不可切除肝细胞癌队列中次级胆汁酸丰度与更长PFS的正向关联，连接特定菌群与临床预后。\",\n                  \"paper_id\": \"ba17ba65137d50666a0e60a34c2cfe287f8bc9a4\",\n                  \"source_handle\": \"P0424\"\n                },\n                {\n                  \"contribution\": \"基于毛螺菌科比较基因组学预测胆汁酸转化基因簇，为核受体配体生成提供菌株特异性功能线索。\",\n                  \"paper_id\": \"52fc41afc10d1874915df79a5f918e521e7ca077\",\n                  \"source_handle\": \"P0186\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0481\",\n              \"P0424\",\n              \"P0186\",\n              \"P0180\",\n              \"P0209\",\n              \"P0582\",\n              \"P0580\",\n              \"P0579\",\n              \"P0581\",\n              \"P0639\",\n              \"P0634\",\n              \"P0609\",\n              \"P0586\",\n              \"P0587\",\n              \"P0589\",\n              \"P0588\",\n              \"P0593\",\n              \"P0591\",\n              \"P0592\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch3::U3_3::U3_3_P01\",\n                \"Ch3::U3_3::U3_3_P02\",\n                \"Ch3::U3_3::U3_3_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U3_4\",\n            \"focus\": \"微生物代谢物通过重塑免疫细胞的能量代谢通路与表观遗传景观，实现抗肿瘤免疫功能的系统性整合，其中功能性通路特征比单一物种分类更具预测价值。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U3_4_P01\",\n                \"point\": \"论证宏基因组功能通路（如 MEP、核黄素合成）与特定 T 细胞亚群（Vδ2, MAIT）活化的直接关联。\",\n                \"development\": \"基于 P0444 的 PDTO 共培养与纵向队列数据，说明为何关注代谢通路丰度比单一菌属更能准确预测 ICI 反应。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0444\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供宏基因组功能通路（MEP、核黄素合成）与特定 T 细胞亚群（Vδ2、MAIT）活化直接关联的纵向队列证据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_4_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_4_P01\",\n                    \"unit_id\": \"U3_4\",\n                    \"ordinal\": 1,\n                    \"point\": \"论证宏基因组功能通路（如 MEP、核黄素合成）与特定 T 细胞亚群（Vδ2, MAIT）活化的直接关联。\",\n                    \"development\": \"基于 P0444 的 PDTO 共培养与纵向队列数据，说明为何关注代谢通路丰度比单一菌属更能准确预测 ICI 反应。\",\n                    \"source_handles\": [\n                      \"P0444\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_4_P02\",\n                \"point\": \"阐述代谢物驱动的表观遗传重编程（HDAC 抑制、染色质开放）如何决定免疫细胞的功能状态。\",\n                \"development\": \"整合 P0220 与 P0587 的机制发现，解释代谢物如何作为表观遗传酶的变构调节剂或底物，锁定 T 细胞或巨噬细胞的效应/耗竭表型。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0220\",\n                    \"role\": \"主论据\",\n                    \"use\": \"阐述代谢物作为表观遗传修饰底物或直接抑制 HDAC，改变染色质开放性以重编程巨噬细胞与 T 细胞转录程序\"\n                  },\n                  {\n                    \"source_handle\": \"P0587\",\n                    \"role\": \"发展\",\n                    \"use\": \"整合多组学数据揭示微生物代谢物系统性调节宿主免疫细胞氧化磷酸化与糖酵解平衡，决定效应与耗竭 T 细胞命运\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_4_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_4_P02\",\n                    \"unit_id\": \"U3_4\",\n                    \"ordinal\": 2,\n                    \"point\": \"阐述代谢物驱动的表观遗传重编程（HDAC 抑制、染色质开放）如何决定免疫细胞的功能状态。\",\n                    \"development\": \"整合 P0220 与 P0587 的机制发现，解释代谢物如何作为表观遗传酶的变构调节剂或底物，锁定 T 细胞或巨噬细胞的效应/耗竭表型。\",\n                    \"source_handles\": [\n                      \"P0220\",\n                      \"P0587\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_4_P03\",\n                \"point\": \"提出以“功能性菌群失调评分”替代传统α/β多样性作为 ICI 疗效预测指标的必要性。\",\n                \"development\": \"结合 P0444 与 P0363 的观点，批判单一分类学分析的局限，主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0444\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供功能性通路优于物种分类的实证\"\n                  },\n                  {\n                    \"source_handle\": \"P0363\",\n                    \"role\": \"发展\",\n                    \"use\": \"批判单一分类学分析的局限，主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化以替代传统多样性指标\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_4_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_4_P03\",\n                    \"unit_id\": \"U3_4\",\n                    \"ordinal\": 3,\n                    \"point\": \"提出以“功能性菌群失调评分”替代传统α/β多样性作为 ICI 疗效预测指标的必要性。\",\n                    \"development\": \"结合 P0444 与 P0363 的观点，批判单一分类学分析的局限，主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化。\",\n                    \"source_handles\": [\n                      \"P0444\",\n                      \"P0363\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"代谢物的作用超越了单纯的受体配体角色，它们直接参与宿主细胞的能量代谢与表观遗传架构。P0444 揭示了特定细菌代谢通路（MEP vs 核黄素合成）如何精准匹配 Vδ2 与 MAIT 这两类非典型 T 细胞的活化需求，提供了“功能通路优于物种分类”的实证。P0220 与 P0587 进一步表明，代谢物通过提供乙酰-CoA 或抑制 HDAC，直接改写免疫细胞的染色质景观，这种代谢 - 表观遗传耦合是解释为何相同菌群在不同宿主状态下产生不同疗效的关键。\",\n              \"transition\": \"尽管上述机制在临床前模型与部分人类队列中得到有力支持，但整个领域面临一个根本性的方法学瓶颈：人体肿瘤局部的代谢物浓度数据极度匮乏。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供宏基因组功能通路（MEP、核黄素合成）与特定T细胞亚群（Vδ2、MAIT）活化直接关联的纵向队列证据。\",\n                  \"paper_id\": \"c426f22c38d341a24524f67fd75537f6ef60aaf0\",\n                  \"source_handle\": \"P0444\"\n                },\n                {\n                  \"contribution\": \"阐述代谢物作为表观遗传修饰底物或直接抑制HDAC，改变染色质开放性以重编程巨噬细胞与T细胞转录程序。\",\n                  \"paper_id\": \"5d4d1432a51cc91edfadc9f8ca60f84f5bd9c2f4\",\n                  \"source_handle\": \"P0220\"\n                },\n                {\n                  \"contribution\": \"整合多组学数据揭示微生物代谢物系统性调节宿主免疫细胞氧化磷酸化与糖酵解平衡，决定效应与耗竭T细胞命运。\",\n                  \"paper_id\": \"OpenAlex:W7116840248\",\n                  \"source_handle\": \"P0587\"\n                },\n                {\n                  \"contribution\": \"批判单一分类学分析的局限，主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化以替代传统多样性指标。\",\n                  \"paper_id\": \"9db1c1ced73dca207c6289b20b4a2914a09ca2b1\",\n                  \"source_handle\": \"P0363\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0444\",\n              \"P0220\",\n              \"P0587\",\n              \"P0363\",\n              \"P0582\",\n              \"P0580\",\n              \"P0579\",\n              \"P0581\",\n              \"P0639\",\n              \"P0634\",\n              \"P0609\",\n              \"P0586\",\n              \"P0589\",\n              \"P0588\",\n              \"P0593\",\n              \"P0591\",\n              \"P0592\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch3::U3_4::U3_4_P01\",\n                \"Ch3::U3_4::U3_4_P02\",\n                \"Ch3::U3_4::U3_4_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"U3_5\",\n            \"focus\": \"现有证据高度依赖血浆或粪便代谢物浓度作为系统性暴露代理，人体肿瘤微环境（TME）内代谢物的绝对生理浓度及其与 ICI 疗效的直接定量关联构成关键转化缺口，特别是肌苷在 TME 内的实测数据缺失。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"U3_5_P01\",\n                \"point\": \"客观评估当前血浆/粪便代谢组学作为 ICI 疗效预测工具的效能与固有偏差。\",\n                \"development\": \"基于 P0582 与 P0363，承认宏观代谢物检测在临床可行性上的优势，同时指出其无法区分游离态与结合态、无法反映组织滞留时间的缺陷。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0582\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出因样本完整性问题未能在人体肿瘤队列中直接检测肌苷浓度，仅能以 UBA6 表达作为通路活性代理\"\n                  },\n                  {\n                    \"source_handle\": \"P0363\",\n                    \"role\": \"背景\",\n                    \"use\": \"强调多数机制证据来自小鼠模型，血浆/粪便浓度不能完全代表 TME 暴露水平，警示跨物种外推风险\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_5_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_5_P01\",\n                    \"unit_id\": \"U3_5\",\n                    \"ordinal\": 1,\n                    \"point\": \"客观评估当前血浆/粪便代谢组学作为 ICI 疗效预测工具的效能与固有偏差。\",\n                    \"development\": \"基于 P0582 与 P0363，承认宏观代谢物检测在临床可行性上的优势，同时指出其无法区分游离态与结合态、无法反映组织滞留时间的缺陷。\",\n                    \"source_handles\": [\n                      \"P0582\",\n                      \"P0363\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_5_P02\",\n                \"point\": \"深入剖析人体 TME 内代谢物绝对浓度数据缺失对机制研究与临床转化的具体阻碍，特别强调肌苷案例。\",\n                \"development\": \"结合 P0584 与 P0413 的药代动力学与递送障碍分析，说明缺乏 TME 浓度阈值如何导致体外有效浓度无法在体内复现，以及为何单纯提高血浆浓度未必改善疗效。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"主论据\",\n                    \"use\": \"指出体外有效浓度（如 100 μM 肌苷）属人工设定而非内源性实测值，体内浓度受血流灌注与降解酶多重制约\"\n                  },\n                  {\n                    \"source_handle\": \"P0413\",\n                    \"role\": \"主论据\",\n                    \"use\": \"从药理学角度分析代谢物在 TME 中的递送效率受血管通透性及转运体限制，导致全身循环与局部有效浓度脱节\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_5_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_5_P02\",\n                    \"unit_id\": \"U3_5\",\n                    \"ordinal\": 2,\n                    \"point\": \"深入剖析人体 TME 内代谢物绝对浓度数据缺失对机制研究与临床转化的具体阻碍，特别强调肌苷案例。\",\n                    \"development\": \"结合 P0584 与 P0413 的药代动力学与递送障碍分析，说明缺乏 TME 浓度阈值如何导致体外有效浓度无法在体内复现，以及为何单纯提高血浆浓度未必改善疗效。\",\n                    \"source_handles\": [\n                      \"P0584\",\n                      \"P0413\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"U3_5_P03\",\n                \"point\": \"规划填补 TME 浓度缺口的未来技术路线与研究范式。\",\n                \"development\": \"提出引入原位微透析（microdialysis）、基质辅助激光解吸电离质谱成像（MALDI-MSI）及配对组织 - 血液纵向采样，以建立“局部浓度 - 受体占有率 - 临床结局”的直接定量映射。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0582\",\n                    \"role\": \"发展\",\n                    \"use\": \"呼吁未来研究需解决 TME 内代谢物浓度测量问题\"\n                  },\n                  {\n                    \"source_handle\": \"P0363\",\n                    \"role\": \"发展\",\n                    \"use\": \"主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化\"\n                  },\n                  {\n                    \"source_handle\": \"P0413\",\n                    \"role\": \"发展\",\n                    \"use\": \"提出需解决代谢物在 TME 中的递送效率问题\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"U3_5_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"U3_5_P03\",\n                    \"unit_id\": \"U3_5\",\n                    \"ordinal\": 3,\n                    \"point\": \"规划填补 TME 浓度缺口的未来技术路线与研究范式。\",\n                    \"development\": \"提出引入原位微透析（microdialysis）、基质辅助激光解吸电离质谱成像（MALDI-MSI）及配对组织 - 血液纵向采样，以建立“局部浓度 - 受体占有率 - 临床结局”的直接定量映射。\",\n                    \"source_handles\": [\n                      \"P0582\",\n                      \"P0363\",\n                      \"P0413\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"本章节的所有机制假设均建立在“系统性暴露代理”之上。P0582 的坦诚声明代表了当前领域的普遍困境：我们已知高血浆肌苷预示更长 OS，但不知肿瘤实质内究竟需要多少μM 的肌苷才能饱和抑制 UBA6。P0363 与 P0413 进一步指出，血浆/粪便浓度受饮食、肾脏清除率及肠道菌群周转率的强烈干扰，无法精确反映 TME 局部的真实化学梯度。这一缺口不仅阻碍了代谢物补充剂的精准给药，也使得许多基于动物模型的高浓度干预策略难以直接翻译至临床。\",\n              \"transition\": \"综上所述，微生物代谢物通过精密的分子网络深刻重塑了实体瘤的免疫景观，但跨越从系统性关联到局部因果确证的鸿沟，仍需下一代空间与动态监测技术的介入。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"明确指出因样本完整性问题未能在人体肿瘤队列中直接检测肌苷浓度，仅能以UBA6表达作为通路活性代理。\",\n                  \"paper_id\": \"CorpusId:252309032\",\n                  \"source_handle\": \"P0582\"\n                },\n                {\n                  \"contribution\": \"强调多数机制证据来自小鼠模型，血浆/粪便浓度不能完全代表TME暴露水平，警示跨物种外推风险。\",\n                  \"paper_id\": \"9db1c1ced73dca207c6289b20b4a2914a09ca2b1\",\n                  \"source_handle\": \"P0363\"\n                },\n                {\n                  \"contribution\": \"指出体外有效浓度（如100 μM肌苷）属人工设定而非内源性实测值，体内浓度受血流灌注与降解酶多重制约。\",\n                  \"paper_id\": \"CorpusId:290154100\",\n                  \"source_handle\": \"P0584\"\n                },\n                {\n                  \"contribution\": \"从药理学角度分析代谢物在TME中的递送效率受血管通透性及转运体限制，导致全身循环与局部有效浓度脱节。\",\n                  \"paper_id\": \"b4de79d677aec2f2b495ddebba1aaf8a77cffc38\",\n                  \"source_handle\": \"P0413\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0582\",\n              \"P0363\",\n              \"P0584\",\n              \"P0413\",\n              \"P0580\",\n              \"P0579\",\n              \"P0581\",\n              \"P0639\",\n              \"P0634\",\n              \"P0609\",\n              \"P0586\",\n              \"P0587\",\n              \"P0589\",\n              \"P0588\",\n              \"P0593\",\n              \"P0591\",\n              \"P0592\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch3::U3_5::U3_5_P01\",\n                \"Ch3::U3_5::U3_5_P02\",\n                \"Ch3::U3_5::U3_5_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch4\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"外部因素对微生物 - 免疫轴的干扰\",\n          \"chapter_purpose\": \"使读者系统掌握抗生素、质子泵抑制剂、饮食模式及生活方式等外部因素如何通过改变肠道微生物组进而影响ICI疗效，理解暴露时机、药物类别与肿瘤背景对效应的修饰作用，并清晰区分观察性关联与因果推断的边界，为后续主动微生物干预策略（Ch5）奠定临床现实与方法学基础。\",\n          \"chapter_scope\": \"外部因素（抗生素、PPIs、饮食及生活方式）通过重塑肠道微生物组稳态，显著调节实体瘤患者对免疫检查点抑制剂（ICI）的临床疗效；其影响具有高度的时间窗口依赖性、药物类别特异性及肿瘤类型异质性。观察性关联证据在多数实体瘤中一致指向负面干扰（如抗生素与PPIs缩短OS/PFS），但因果链条受适应症偏倚与混杂因素制约；特定干预策略（如高纤维饮食、精准益生菌）在部分队列中显示正向潜力，而广谱抗菌或胃酸抑制药物的破坏效应则更为明确。综合判断表明，微生物组的“可塑性”与“脆弱性”共同决定了外部干预的净临床收益，未来需通过标准化暴露定义与前瞻性设计厘清因果边界。\",\n          \"chapter_thesis\": \"外部因素（抗生素、PPIs、饮食及生活方式）通过重塑肠道微生物组稳态，显著调节实体瘤患者对免疫检查点抑制剂（ICI）的临床疗效；其影响具有高度的时间窗口依赖性、药物类别特异性及肿瘤类型异质性。观察性关联证据在多数实体瘤中一致指向负面干扰（如抗生素与PPIs缩短OS/PFS），但因果链条受适应症偏倚与混杂因素制约；特定干预策略（如高纤维饮食、精准益生菌）在部分队列中显示正向潜力，而广谱抗菌或胃酸抑制药物的破坏效应则更为明确。综合判断表明，微生物组的“可塑性”与“脆弱性”共同决定了外部干预的净临床收益，未来需通过标准化暴露定义与前瞻性设计厘清因果边界。\",\n          \"chapter_argument\": \"外部因素（抗生素、PPIs、饮食及生活方式）通过重塑肠道微生物组稳态，显著调节实体瘤患者对免疫检查点抑制剂（ICI）的临床疗效；其影响具有高度的时间窗口依赖性、药物类别特异性及肿瘤类型异质性。观察性关联证据在多数实体瘤中一致指向负面干扰（如抗生素与PPIs缩短OS/PFS），但因果链条受适应症偏倚与混杂因素制约；特定干预策略（如高纤维饮食、精准益生菌）在部分队列中显示正向潜力，而广谱抗菌或胃酸抑制药物的破坏效应则更为明确。综合判断表明，微生物组的“可塑性”与“脆弱性”共同决定了外部干预的净临床收益，未来需通过标准化暴露定义与前瞻性设计厘清因果边界。\",\n          \"reader_objective\": \"使读者系统掌握抗生素、质子泵抑制剂、饮食模式及生活方式等外部因素如何通过改变肠道微生物组进而影响ICI疗效，理解暴露时机、药物类别与肿瘤背景对效应的修饰作用，并清晰区分观察性关联与因果推断的边界，为后续主动微生物干预策略（Ch5）奠定临床现实与方法学基础。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"Ch4_U01\",\n            \"focus\": \"抗生素暴露的时间窗口与疗程长度决定其对 ICI 疗效的负面影响强度，且存在肿瘤类型特异性。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch4_U01_P01\",\n                \"point\": \"界定ICI治疗前后30-90天为抗生素暴露的高危窗口，对比术前与术后暴露的生存差异。\",\n                \"development\": \"比较P0575大样本队列中术后暴露（HR 1.27）与术前暴露（HR 1.04）的OS风险，论证微生物完整性在免疫启动期的脆弱性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0575\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 UC Health 多中心大样本队列数据，对比术后暴露（HR 1.27）与术前暴露（HR 1.04）的生存差异，界定 ICI 启动前后 30-90 天为抗生素干扰的高危窗口。\"\n                  },\n                  {\n                    \"source_handle\": \"P0096\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 NSCLC 背景下微生物组作为生物标志物与干预策略的综述背景，支持抗生素使用时机对疗效影响的一般性论述。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U01_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U01_P01\",\n                    \"unit_id\": \"Ch4_U01\",\n                    \"ordinal\": 1,\n                    \"point\": \"界定ICI治疗前后30-90天为抗生素暴露的高危窗口，对比术前与术后暴露的生存差异。\",\n                    \"development\": \"比较P0575大样本队列中术后暴露（HR 1.27）与术前暴露（HR 1.04）的OS风险，论证微生物完整性在免疫启动期的脆弱性。\",\n                    \"source_handles\": [\n                      \"P0575\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch4_U01_P02\",\n                \"point\": \"建立抗生素疗程长度与OS下降的剂量-反应关系，提示广谱破坏的累积效应。\",\n                \"development\": \"引用P0061数据展示>10天疗程导致OS骤降（2.8 vs 8.8个月），结合P0052/Meta分析中氟喹诺酮类高风险趋势，说明暴露强度与疗效受损的正相关性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0061\",\n                    \"role\": \"主论据\",\n                    \"use\": \"基于印度 Tata 纪念医院真实世界审计数据，展示>10 天疗程导致 OS 骤降（2.8 vs 8.8 个月），建立抗生素暴露强度与疗效受损的正向剂量 - 反应关系。\"\n                  },\n                  {\n                    \"source_handle\": \"P0052\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 NSCLC 患者抗生素使用对临床结局影响的系统综述与 Meta 分析数据，量化抗生素暴露与较差生存/缓解的强关联。\"\n                  },\n                  {\n                    \"source_handle\": \"P0081\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供多种药物效应 Meta 分析数据，作为抗生素作为关键混杂因素或调节变量的大规模实证支持，量化其对预后的影响。\"\n                  },\n                  {\n                    \"source_handle\": \"P0417\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 2019 年系统综述数据，作为抗生素干扰 ICI 疗效的历史证据背景，支持微生物组成预测价值的讨论。\"\n                  },\n                  {\n                    \"source_handle\": \"P0564\",\n                    \"role\": \"背景\",\n                    \"use\": \"汇总不同菌属与 ICI 反应及毒性的关联，以及抗生素使用时机和类型对预后的影响，作为解释微生物调节 ICI 疗效的关键背景素材。\"\n                  },\n                  {\n                    \"source_handle\": \"P0517\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供 NSCLC 队列中抗生素暴露导致 PD-L1 高表达（≥50%）人群 OS 显著缩短的实证，揭示宿主生物标志物状态与微生物组干预效应的高度情境依赖性。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U01_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U01_P02\",\n                    \"unit_id\": \"Ch4_U01\",\n                    \"ordinal\": 2,\n                    \"point\": \"建立抗生素疗程长度与OS下降的剂量-反应关系，提示广谱破坏的累积效应。\",\n                    \"development\": \"引用P0061数据展示>10天疗程导致OS骤降（2.8 vs 8.8个月），结合P0052/Meta分析中氟喹诺酮类高风险趋势，说明暴露强度与疗效受损的正相关性。\",\n                    \"source_handles\": [\n                      \"P0061\",\n                      \"P0052\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch4_U01_P03\",\n                \"point\": \"引入HCC等特定癌种的阴性结果，讨论肝硬化背景下的免疫缓冲效应与结论外推边界。\",\n                \"development\": \"利用P0275 Meta分析指出HCC中抗生素未显著恶化OS/PFS/ORR，结合肝硬化导致的基线免疫抑制与肠肝轴紊乱，解释为何抗生素扰动在此类人群中不转化为明确的生存劣势，警示单一机制模型的局限性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0275\",\n                    \"role\": \"主论据\",\n                    \"use\": \"引入 HCC Meta 分析（n=1056 亚洲人群）阴性结果，结合肝硬化基线免疫抑制与肠肝轴紊乱背景，解释抗生素扰动在此类人群中不转化为明确生存劣势。\"\n                  },\n                  {\n                    \"source_handle\": \"P0547\",\n                    \"role\": \"比较\",\n                    \"use\": \"通过系统综述量化多数实体瘤中抗生素暴露导致生存率下降的风险幅度，并指出黑色素瘤中的阴性结果，警示单一机制模型的外推边界。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U01_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U01_P03\",\n                    \"unit_id\": \"Ch4_U01\",\n                    \"ordinal\": 3,\n                    \"point\": \"引入HCC等特定癌种的阴性结果，讨论肝硬化背景下的免疫缓冲效应与结论外推边界。\",\n                    \"development\": \"利用P0275 Meta分析指出HCC中抗生素未显著恶化OS/PFS/ORR，结合肝硬化导致的基线免疫抑制与肠肝轴紊乱，解释为何抗生素扰动在此类人群中不转化为明确的生存劣势，警示单一机制模型的局限性。\",\n                    \"source_handles\": [\n                      \"P0275\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"抗生素对ICI疗效的损害并非均质发生，而是高度集中于ICI诱导免疫启动与致敏的关键时间窗（尤其是治疗后早期）。长疗程与特定广谱类别（如氟喹诺酮类）加剧了有益菌群的不可逆耗竭。然而，在HCC等伴随严重肝硬化与固有免疫抑制的癌种中，抗生素的负面信号减弱甚至消失，提示宿主基础微环境（如门脉高压、肠肝轴功能障碍）可能掩盖或替代了单纯的菌群介导效应。这要求临床评估必须结合肿瘤分期、肝功能状态与感染指征进行分层。\",\n              \"transition\": \"明确了抗生素扰动的时序与情境依赖后，需进一步考察其他广泛使用的支持性药物（如PPIs）是否遵循相似的干扰逻辑，及其是否存在独立的药代动力学或微生物组双重作用路径。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供UC Health多中心大样本队列数据，对比术后暴露（HR 1.27）与术前暴露（HR 1.04）的生存差异，界定ICI启动前后30-90天为抗生素干扰的高危窗口，论证微生物完整性在免疫启动期的脆弱性。\",\n                  \"paper_id\": \"82ebda249f3476e1948f523a9219bd678f5165c3\",\n                  \"source_handle\": \"P0575\"\n                },\n                {\n                  \"contribution\": \"基于印度Tata纪念医院真实世界审计数据，展示>10天疗程导致OS骤降（2.8 vs 8.8个月），建立抗生素暴露强度与疗效受损的正向剂量-反应关系，提示广谱破坏的累积效应。\",\n                  \"paper_id\": \"1802c54fde7426f92c3e5e6d085590592e3f2f66\",\n                  \"source_handle\": \"P0061\"\n                },\n                {\n                  \"contribution\": \"引入HCC Meta分析（n=1056亚洲人群）阴性结果，结合肝硬化基线免疫抑制与肠肝轴紊乱背景，解释抗生素扰动在此类人群中不转化为明确生存劣势，警示单一机制模型的外推边界。\",\n                  \"paper_id\": \"768ceed11b5509cd8f6c24d07e8fa015646929c0\",\n                  \"source_handle\": \"P0275\"\n                },\n                {\n                  \"contribution\": \"提供NSCLC队列中抗生素暴露导致PD-L1高表达（≥50%）人群OS显著缩短的实证，揭示宿主生物标志物状态与微生物组干预效应的高度情境依赖性。\",\n                  \"paper_id\": \"e8fb88935a5c5757dc683f56d1ff0c0f356b20ae\",\n                  \"source_handle\": \"P0517\"\n                },\n                {\n                  \"contribution\": \"通过系统综述量化多数实体瘤中抗生素暴露导致生存率下降的风险幅度，并指出黑色素瘤中的阴性结果，警示单一机制模型的外推边界。\",\n                  \"paper_id\": \"f35b573335f00cb26d5316eda7d52df639464dbd\",\n                  \"source_handle\": \"P0547\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0575\",\n              \"P0096\",\n              \"P0061\",\n              \"P0052\",\n              \"P0081\",\n              \"P0417\",\n              \"P0564\",\n              \"P0517\",\n              \"P0275\",\n              \"P0547\",\n              \"P0583\",\n              \"P0273\",\n              \"P0584\",\n              \"P0585\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\",\n              \"P0188\",\n              \"P0118\",\n              \"P0612\",\n              \"P0359\",\n              \"P0430\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch4::Ch4_U01::Ch4_U01_P01\",\n                \"Ch4::Ch4_U01::Ch4_U01_P02\",\n                \"Ch4::Ch4_U01::Ch4_U01_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch4_U02\",\n            \"focus\": \"质子泵抑制剂（PPIs）通过降低胃酸促进口腔细菌易位与菌群多样性丧失，独立预测 ICI 疗效下降，且效应受既往化疗时序的修饰。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch4_U02_P01\",\n                \"point\": \"量化PPIs使用与ICI生存结局的负相关，强调使用时窗（基线/ICI前60天）的决定性作用。\",\n                \"development\": \"整合P0339 Meta分析数据（OS HR 1.31, PFS HR 1.30），对比不同暴露时窗的效应差异，确立PPI作为独立预后不良因子的地位。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0339\",\n                    \"role\": \"主论据\",\n                    \"use\": \"整合 33 项研究 Meta 分析数据（OS HR=1.31, PFS HR=1.30），量化 PPI 使用与 ICI 生存结局的负相关，强调基线或 ICI 前 60 天内使用时窗的决定性作用。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U02_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U02_P01\",\n                    \"unit_id\": \"Ch4_U02\",\n                    \"ordinal\": 1,\n                    \"point\": \"量化PPIs使用与ICI生存结局的负相关，强调使用时窗（基线/ICI前60天）的决定性作用。\",\n                    \"development\": \"整合P0339 Meta分析数据（OS HR 1.31, PFS HR 1.30），对比不同暴露时窗的效应差异，确立PPI作为独立预后不良因子的地位。\",\n                    \"source_handles\": [\n                      \"P0339\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch4_U02_P02\",\n                \"point\": \"揭示化疗近期暴露对PPI效应的修饰作用，并提出“口腔化”易位与菌群多样性丧失的机制假说。\",\n                \"development\": \"结合P0537发现化疗<1年间隔消除PPI负面影响，以及P0289/P0088关于PPI促进口腔细菌定植、降低α多样性的描述，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0537\",\n                    \"role\": \"主论据\",\n                    \"use\": \"揭示化疗结束至 ICI 开始间隔<1 年可消除 PPI 负面影响（HR 1.09），并报告 PPI 使用者乳酸杆菌科和韦荣球菌属相对丰度较高，构建“胃酸抑制→菌群失调→免疫 priming 受损”的逻辑链。\"\n                  },\n                  {\n                    \"source_handle\": \"P0289\",\n                    \"role\": \"例证\",\n                    \"use\": \"描述 PPI 促进口腔细菌定植、降低α多样性的机制证据，结合 P0537 构建“胃酸抑制→菌群失调→免疫 priming 受损”的逻辑链。\"\n                  },\n                  {\n                    \"source_handle\": \"P0088\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供 PPI 改变乳酸杆菌科和韦荣球菌属相对丰度的微生物组数据，支持 PPI 诱导特定菌群失调从而干扰免疫稳态的生物学基础。\"\n                  },\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供 JCOG2007 试验中化疗 - 免疫联合治疗背景下的微生物组数据，作为化疗时序修饰药物效应的外部验证与对照。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U02_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U02_P02\",\n                    \"unit_id\": \"Ch4_U02\",\n                    \"ordinal\": 2,\n                    \"point\": \"揭示化疗近期暴露对PPI效应的修饰作用，并提出“口腔化”易位与菌群多样性丧失的机制假说。\",\n                    \"development\": \"结合P0537发现化疗<1年间隔消除PPI负面影响，以及P0289/P0088关于PPI促进口腔细菌定植、降低α多样性的描述，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。\",\n                    \"source_handles\": [\n                      \"P0537\",\n                      \"P0289\",\n                      \"P0088\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch4_U02_P03\",\n                \"point\": \"对比PPIs与H2B的毒性信号差异，并提供临床用药降级与监测建议。\",\n                \"development\": \"引用P0286 FAERS信号显示PPI联用显著增加肝胆/皮肤irAEs报告率，结合P0537中H2B未达显著生存影响的观察，提出在必须抑酸时优先考虑H2B或严格限定PPI适应症的实践启示。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0286\",\n                    \"role\": \"主论据\",\n                    \"use\": \"引用 FAERS 自发报告系统信号显示 ICI+PPI 联用显著升高肝胆疾病（RORadj 7.10）、皮肤及代谢障碍的报告率，对比 H2B 未达显著生存影响的观察，提供临床用药降级与监测建议的实证依据。\"\n                  },\n                  {\n                    \"source_handle\": \"P0537\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供 H2B 未达显著生存影响的观察数据，作为 PPI 毒性信号的对照，支持临床用药降级建议。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U02_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U02_P03\",\n                    \"unit_id\": \"Ch4_U02\",\n                    \"ordinal\": 3,\n                    \"point\": \"对比PPIs与H2B的毒性信号差异，并提供临床用药降级与监测建议。\",\n                    \"development\": \"引用P0286 FAERS信号显示PPI联用显著增加肝胆/皮肤irAEs报告率，结合P0537中H2B未达显著生存影响的观察，提出在必须抑酸时优先考虑H2B或严格限定PPI适应症的实践启示。\",\n                    \"source_handles\": [\n                      \"P0286\",\n                      \"P0537\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"PPIs对ICI疗效的负面影响具有明确的流行病学支撑，其核心机制在于胃酸抑制引发的肠道pH值上升，导致共生菌（如双歧杆菌、阿克曼氏菌）丰度下降及条件致病菌（如链球菌、韦荣球菌）过度生长。这种“口腔化”易位不仅削弱了SCFAs产生与抗原呈递功能，还可能通过TLR/NF-κB通路放大全身炎症。值得注意的是，近期化疗（<1年）可能通过剧烈的菌群重置与免疫微环境重塑，暂时掩盖或抵消了PPI的细微扰动（P0537）。此外，PPIs与irAEs（如肝毒性、皮肤反应）报告率的协同升高（P0286）提示其干扰不仅限于抗肿瘤免疫，还波及免疫耐受边界。相比之下，H2B未显示同等程度的生存损害，为需要抑酸治疗的患者提供了潜在的降级选择。\",\n              \"transition\": \"在确认强效药物（抗生素、PPIs）的破坏性后，需转向更具可控性的生活方式与营养干预，评估饮食模式与补充剂能否通过定向重塑菌群实现疗效增益或毒性缓解。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"整合33项研究Meta分析数据（OS HR=1.31, PFS HR=1.30），量化PPI使用与ICI生存结局的负相关，强调基线或ICI前60天内使用时窗的决定性作用，确立PPI作为独立预后不良因子的地位。\",\n                  \"paper_id\": \"9225e04c4f9620a87d4eb74932067cab87644bf2\",\n                  \"source_handle\": \"P0339\"\n                },\n                {\n                  \"contribution\": \"揭示化疗结束至ICI开始间隔<1年可消除PPI负面影响（HR 1.09），并报告PPI使用者乳酸杆菌科和韦荣球菌属相对丰度较高，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。\",\n                  \"paper_id\": \"ef3aa04c443ab46a0b126661b9aab2a6d8239655\",\n                  \"source_handle\": \"P0537\"\n                },\n                {\n                  \"contribution\": \"引用FAERS自发报告系统信号显示ICI+PPI联用显著升高肝胆疾病（RORadj 7.10）、皮肤及代谢障碍的报告率，对比H2B未达显著生存影响的观察，提供临床用药降级与监测建议的实证依据。\",\n                  \"paper_id\": \"7e82740a20ee584360b9fa976bf4b172c099caa4\",\n                  \"source_handle\": \"P0286\"\n                },\n                {\n                  \"contribution\": \"描述PPI促进口腔细菌定植、降低α多样性的机制证据，结合P0537构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。\",\n                  \"paper_id\": \"7fe882e8b39d1a041fd2fee47d9321c965f01aa5\",\n                  \"source_handle\": \"P0289\"\n                },\n                {\n                  \"contribution\": \"提供PPI改变乳酸杆菌科和韦荣球菌属相对丰度的微生物组数据，支持PPI诱导特定菌群失调从而干扰免疫稳态的生物学基础。\",\n                  \"paper_id\": \"2129f97a58fe871598a9da0cb18083d6d6fa4729\",\n                  \"source_handle\": \"P0088\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0339\",\n              \"P0537\",\n              \"P0289\",\n              \"P0088\",\n              \"P0585\",\n              \"P0286\",\n              \"P0583\",\n              \"P0273\",\n              \"P0584\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\",\n              \"P0188\",\n              \"P0118\",\n              \"P0612\",\n              \"P0564\",\n              \"P0081\",\n              \"P0359\",\n              \"P0430\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch4::Ch4_U02::Ch4_U02_P01\",\n                \"Ch4::Ch4_U02::Ch4_U02_P02\",\n                \"Ch4::Ch4_U02::Ch4_U02_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch4_U03\",\n            \"focus\": \"饮食模式（高纤维/生酮）与特定膳食成分可通过富集产 SCFAs 菌属或调节色氨酸代谢改善 ICI 响应，而商业益生菌补充剂的效果呈现高度菌株特异性和情境依赖性。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch4_U03_P01\",\n                \"point\": \"论证高纤维/特定宏量营养素饮食对ICI疗效的正向调节，关联产SCFAs菌属富集与PFS延长。\",\n                \"development\": \"利用P0155 NSCLC队列数据展示高脂低淀粉饮食（HR 0.37）与Ruminococcus lactaris等有益菌富集的关联，对比P0390黑色素瘤队列中高纤维饮食的PFS获益，确立饮食底物对菌群功能的定向塑造作用。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0155\",\n                    \"role\": \"主论据\",\n                    \"use\": \"利用 NSCLC 前瞻性队列（N=147）宏基因组数据，展示高脂低淀粉饮食（HR 0.37）与 Ruminococcus lactaris 等有益菌富集的关联，确立饮食底物对菌群功能的定向塑造作用。\"\n                  },\n                  {\n                    \"source_handle\": \"P0390\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供黑色素瘤队列中高纤维饮食的 PFS 获益数据，与 P0155 形成癌种间饮食效应比较，支持饮食模式对 ICI 疗效的正向调节。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U03_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U03_P01\",\n                    \"unit_id\": \"Ch4_U03\",\n                    \"ordinal\": 1,\n                    \"point\": \"论证高纤维/特定宏量营养素饮食对ICI疗效的正向调节，关联产SCFAs菌属富集与PFS延长。\",\n                    \"development\": \"利用P0155 NSCLC队列数据展示高脂低淀粉饮食（HR 0.37）与Ruminococcus lactaris等有益菌富集的关联，对比P0390黑色素瘤队列中高纤维饮食的PFS获益，确立饮食底物对菌群功能的定向塑造作用。\",\n                    \"source_handles\": [\n                      \"P0155\",\n                      \"P0390\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch4_U03_P02\",\n                \"point\": \"剖析商业益生菌的矛盾证据，强调菌株特异性、生态位竞争及“食物基质优于补充剂”的原则。\",\n                \"development\": \"对比P0390中非标准化益生菌的负面信号与P0583/P0593中CBM588/LBTs的初步阳性趋势，结合P0249 Avatar模型证明饮食成分可绕过定植障碍直接驱动代谢输出，论证盲目补充的风险与精准靶向的必要性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0390\",\n                    \"role\": \"主论据\",\n                    \"use\": \"剖析商业益生菌的矛盾证据，指出非标准化益生菌补充导致抗 PD-1 反应受损（IFN-γ+ CTL 频率降低），论证盲目补充的风险与精准靶向的必要性。\"\n                  },\n                  {\n                    \"source_handle\": \"P0249\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供黑覆盆子饮食干预的人源化 Avatar 模型证据，证明饮食成分可绕过定植障碍直接驱动代谢输出，支持“食物基质优于补充剂”原则。\"\n                  },\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"比较\",\n                    \"use\": \"报告 FMT-LUMINate 试验中响应者基线有害菌种丢失及供体菌株未定植的现象，为剖析商业益生菌/补充剂的矛盾证据提供关键对照。\"\n                  },\n                  {\n                    \"source_handle\": \"P0593\",\n                    \"role\": \"负责人指定\",\n                    \"use\": \"\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U03_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U03_P02\",\n                    \"unit_id\": \"Ch4_U03\",\n                    \"ordinal\": 2,\n                    \"point\": \"剖析商业益生菌的矛盾证据，强调菌株特异性、生态位竞争及“食物基质优于补充剂”的原则。\",\n                    \"development\": \"对比P0390中非标准化益生菌的负面信号与P0583/P0593中CBM588/LBTs的初步阳性趋势，结合P0249 Avatar模型证明饮食成分可绕过定植障碍直接驱动代谢输出，论证盲目补充的风险与精准靶向的必要性。\",\n                    \"source_handles\": [\n                      \"P0390\",\n                      \"P0249\",\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch4_U03_P03\",\n                \"point\": \"简述昼夜节律紊乱与心理压力通过神经内分泌-色氨酸轴间接调制免疫稳态的潜在路径。\",\n                \"development\": \"整合P0224/P0147关于睡眠剥夺导致LPS易位、SCFAs下降及HPA轴激活抑制CD8+ T细胞的机制假说，指出生活方式干预需纳入多维宿主状态评估框架。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0224\",\n                    \"role\": \"主论据\",\n                    \"use\": \"简述昼夜节律紊乱与心理压力通过 HPA 轴激活、LPS 易位及 SCFAs 下降间接调制免疫稳态的潜在路径，指出生活方式干预需纳入多维宿主状态评估框架。\"\n                  },\n                  {\n                    \"source_handle\": \"P0147\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供肿瘤相关抑郁症作为微生物群改变驱动因素的背景机制，支持心理 - 微生物联合干预的理论支撑，避免单一营养视角的局限。\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch4_U03_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch4_U03_P03\",\n                    \"unit_id\": \"Ch4_U03\",\n                    \"ordinal\": 3,\n                    \"point\": \"简述昼夜节律紊乱与心理压力通过神经内分泌-色氨酸轴间接调制免疫稳态的潜在路径。\",\n                    \"development\": \"整合P0224/P0147关于睡眠剥夺导致LPS易位、SCFAs下降及HPA轴激活抑制CD8+ T细胞的机制假说，指出生活方式干预需纳入多维宿主状态评估框架。\",\n                    \"source_handles\": [\n                      \"P0224\",\n                      \"P0147\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"饮食作为上游可修饰因素，其影响高度依赖于宏量营养素构成与发酵底物的可获得性。高纤维与特定植物多酚（如黑覆盆子花蜜）通过滋养产丁酸/丙酸菌（如Ruminococcaceae, Bifidobacterium）及促进次级胆汁酸转化，增强CD8+ T细胞浸润与记忆形成。然而，商业益生菌的临床试验结果呈现显著分裂：定义明确的活体生物疗法（如CBM588）在mRCC中显示PFS延长趋势，而非标准化混合制剂在NSCLC队列中反而与较差预后相关（P0390）。这表明外源定植面临生态位竞争与菌株功能冗余的挑战，“全食物基质”可能比单一补充剂更能维持菌群网络稳定性。此外，睡眠剥夺与慢性压力通过激活HPA轴、升高皮质醇及改变色氨酸犬尿氨酸代谢，间接削弱Th1型抗肿瘤应答，提示身心干预可作为微生物组管理的辅助维度。\",\n              \"transition\": \"外部因素的干扰效应最终汇聚于临床决策的权衡：在缺乏大规模III期RCT确证的情况下，如何识别高价值干预靶点、规避混杂偏倚，并为未来精准微生物调控划定方法学标准？\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"利用NSCLC前瞻性队列（N=147）宏基因组数据，展示高脂低淀粉饮食（HR 0.37）与Ruminococcus lactaris等有益菌富集的关联，对比P0390黑色素瘤队列中高纤维饮食的PFS获益，确立饮食底物对菌群功能的定向塑造作用。\",\n                  \"paper_id\": \"448f3d956dc7cb74cd1bee3958ce828f79d4e1c7\",\n                  \"source_handle\": \"P0155\"\n                },\n                {\n                  \"contribution\": \"剖析商业益生菌的矛盾证据，指出非标准化益生菌补充导致抗PD-1反应受损（IFN-γ+ CTL频率降低），结合P0249 Avatar模型证明饮食成分可绕过定植障碍直接驱动代谢输出，论证盲目补充的风险与精准靶向的必要性。\",\n                  \"paper_id\": \"a980ecd60c8c25767f7e60710e0949f181673c92\",\n                  \"source_handle\": \"P0390\"\n                },\n                {\n                  \"contribution\": \"简述昼夜节律紊乱与心理压力通过HPA轴激活、LPS易位及SCFAs下降间接调制免疫稳态的潜在路径，指出生活方式干预需纳入多维宿主状态评估框架，避免单一营养视角的局限。\",\n                  \"paper_id\": \"5dbcf9d0db62adc57ef25ab84c8b892e6281343d\",\n                  \"source_handle\": \"P0224\"\n                },\n                {\n                  \"contribution\": \"报告FMT-LUMINate试验中响应者基线有害菌种丢失及供体菌株未定植的现象，为剖析商业益生菌/补充剂的矛盾证据提供关键对照。\",\n                  \"paper_id\": \"071823eff68d7dbea395490dd4643170131b5f6a\",\n                  \"source_handle\": \"P0583\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0155\",\n              \"P0390\",\n              \"P0249\",\n              \"P0583\",\n              \"P0593\",\n              \"P0224\",\n              \"P0147\",\n              \"P0273\",\n              \"P0584\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\",\n              \"P0188\",\n              \"P0118\",\n              \"P0612\",\n              \"P0564\",\n              \"P0081\",\n              \"P0359\",\n              \"P0430\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch4::Ch4_U03::Ch4_U03_P01\",\n                \"Ch4::Ch4_U03::Ch4_U03_P02\",\n                \"Ch4::Ch4_U03::Ch4_U03_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch5\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"微生物干预策略的临床转化现状\",\n          \"chapter_purpose\": \"使读者清晰掌握当前微生物干预策略的临床证据等级、疗效异质性来源、安全性边界及转化瓶颈，为理解该领域从\\\"观察性关联\\\"走向\\\"因果性干预\\\"的现实路径提供结构化评估。\",\n          \"chapter_scope\": \"微生物干预（FMT、活体生物药及益生菌）在实体瘤 ICI 治疗中展现出从概念验证向临床转化迈进的潜力，但其疗效高度依赖于人群特征（初治 vs 难治）、供体匹配度及免疫微环境基线。当前证据主要局限于 I/II 期单臂或早期随机试验，缺乏大型 III 期 RCT 确证；同时，特定菌群特征与方案背景交互引发的安全性风险（如 Prevotella 相关心肌炎仅在双 ICI 背景下出现）凸显了标准化筛选与精准分层的迫切需求。\",\n          \"chapter_thesis\": \"微生物干预（FMT、活体生物药及益生菌）在实体瘤 ICI 治疗中展现出从概念验证向临床转化迈进的潜力，但其疗效高度依赖于人群特征（初治 vs 难治）、供体匹配度及免疫微环境基线。当前证据主要局限于 I/II 期单臂或早期随机试验，缺乏大型 III 期 RCT 确证；同时，特定菌群特征与方案背景交互引发的安全性风险（如 Prevotella 相关心肌炎仅在双 ICI 背景下出现）凸显了标准化筛选与精准分层的迫切需求。\",\n          \"chapter_argument\": \"微生物干预（FMT、活体生物药及益生菌）在实体瘤 ICI 治疗中展现出从概念验证向临床转化迈进的潜力，但其疗效高度依赖于人群特征（初治 vs 难治）、供体匹配度及免疫微环境基线。当前证据主要局限于 I/II 期单臂或早期随机试验，缺乏大型 III 期 RCT 确证；同时，特定菌群特征与方案背景交互引发的安全性风险（如 Prevotella 相关心肌炎仅在双 ICI 背景下出现）凸显了标准化筛选与精准分层的迫切需求。\",\n          \"reader_objective\": \"使读者清晰掌握当前微生物干预策略的临床证据等级、疗效异质性来源、安全性边界及转化瓶颈，为理解该领域从\\\"观察性关联\\\"走向\\\"因果性干预\\\"的现实路径提供结构化评估。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"Ch5_U01\",\n            \"focus\": \"FMT 联合一线 ICI 在初治人群中的高缓解率信号及其机制假说（有害菌清除 vs 供体定植）。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U01_P01\",\n                \"point\": \"报告 FMT-LUMINate 与 MIMic 试验在初治实体瘤队列中的 ORR 与生存信号。\",\n                \"development\": \"对比 NSCLC 单药抗 PD-1（ORR 80%）与黑色素瘤双药抗 PD-1/CTLA-4（ORR 75%）背景下的响应差异，指出单臂设计下的高响应率提示 FMT 具备增效潜力，但需警惕历史对照偏倚。MIMic 试验报告 ORR 65%，中位 PFS 29.6 个月，中位 OS 52.8 个月。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 FMT-LUMINate 试验在 NSCLC 与黑色素瘤队列中的 ORR 与 PFS 核心数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0577\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 MIMic 试验在黑色素瘤一线治疗中的 ORR、PFS 及 OS 数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0215\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供一线实体瘤队列中 FMT 联合 ICI 的客观缓解率汇总数据，对比不同癌种响应差异\"\n                  },\n                  {\n                    \"source_handle\": \"P0343\",\n                    \"role\": \"背景\",\n                    \"use\": \"汇总活体生物疗法及高纤维饮食与 ICI 疗效关联的临床证据链，强化干预策略增效潜力分析\"\n                  },\n                  {\n                    \"source_handle\": \"P0585\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供 JCOG2007 III 期试验辅助生物标志物数据，证实特定菌属丰度与化疗免疫联合方案 OS 获益相关\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U01_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U01_P01\",\n                    \"unit_id\": \"Ch5_U01\",\n                    \"ordinal\": 1,\n                    \"point\": \"报告 FMT-LUMINate 与 MIMic 试验在初治实体瘤队列中的 ORR 与生存信号。\",\n                    \"development\": \"对比 NSCLC 单药抗 PD-1（ORR 80%）与黑色素瘤双药抗 PD-1/CTLA-4（ORR 75%）背景下的响应差异，指出单臂设计下的高响应率提示 FMT 具备增效潜力，但需警惕历史对照偏倚。MIMic 试验报告 ORR 65%，中位 PFS 29.6 个月，中位 OS 52.8 个月。\",\n                    \"source_handles\": [\n                      \"P0583\",\n                      \"P0577\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U01_P02\",\n                \"point\": \"阐述 FMT 起效的潜在机制：基线病原菌清除优于供体定植。\",\n                \"development\": \"解析 LUMINate 试验发现响应者获益主要依赖基线有害菌属（如 Enterocloster、Clostridium）的大量丢失，伴随色氨酸代谢产物降低与 CD8+ T 细胞扩增；动物回输实验证实消除这些有害菌是疗效必要条件。MIMic 试验也观察到响应者富集产 SCFA 菌群（Blautia, Roseburia, Faecalibacterium）及糖基修饰酶。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供宏基因组与代谢组分析揭示的“有害菌丢失”假说及 CD8+ T 细胞扩增数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0577\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供响应者富集产 SCFA 菌群及糖基修饰酶的观察结果\"\n                  },\n                  {\n                    \"source_handle\": \"P0297\",\n                    \"role\": \"发展\",\n                    \"use\": \"补充 NSCLC 背景下肠道菌群向肿瘤易位的实证数据，阐释有益菌如何重塑局部微环境恢复耗竭 CD8+ T 细胞功能\"\n                  },\n                  {\n                    \"source_handle\": \"P0333\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供肠道 - 代谢物 - 免疫轴的结构化框架，阐述特定菌群通过 cGAS-STING 通路激活 DC 及 SCFAs 调节 T 细胞分化的分子机制\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U01_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U01_P02\",\n                    \"unit_id\": \"Ch5_U01\",\n                    \"ordinal\": 2,\n                    \"point\": \"阐述 FMT 起效的潜在机制：基线病原菌清除优于供体定植。\",\n                    \"development\": \"解析 LUMINate 试验发现响应者获益主要依赖基线有害菌属（如 Enterocloster、Clostridium）的大量丢失，伴随色氨酸代谢产物降低与 CD8+ T 细胞扩增；动物回输实验证实消除这些有害菌是疗效必要条件。MIMic 试验也观察到响应者富集产 SCFA 菌群（Blautia, Roseburia, Faecalibacterium）及糖基修饰酶。\",\n                    \"source_handles\": [\n                      \"P0583\",\n                      \"P0577\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U01_P03\",\n                \"point\": \"引入 TACITO Phase 2a RCT 数据，展示随机对照背景下的数值改善与统计局限。\",\n                \"development\": \"说明 d-FMT 组在 mRCC 一线治疗中 12 个月 PFS 率（70% vs 41%）与中位 PFS（24.0 vs 9.0 个月）呈有利趋势，但主要终点未达统计学显著性（P=0.053），提示疗效存在但需更大样本确证。中位 OS 41.0 vs 28.3 个月（P=0.167）。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0593\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 TACITO 试验在 mRCC 一线治疗中的 PFS 率、中位 PFS 及 OS 数据与统计结果\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U01_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U01_P03\",\n                    \"unit_id\": \"Ch5_U01\",\n                    \"ordinal\": 3,\n                    \"point\": \"引入 TACITO Phase 2a RCT 数据，展示随机对照背景下的数值改善与统计局限。\",\n                    \"development\": \"说明 d-FMT 组在 mRCC 一线治疗中 12 个月 PFS 率（70% vs 41%）与中位 PFS（24.0 vs 9.0 个月）呈有利趋势，但主要终点未达统计学显著性（P=0.053），提示疗效存在但需更大样本确证。中位 OS 41.0 vs 28.3 个月（P=0.167）。\",\n                    \"source_handles\": [\n                      \"P0593\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"初治人群的积极信号表明 FMT 可重塑免疫代谢微环境并提升 ICI 敏感性，但单臂设计与高 PD-L1 表达人群的选择偏倚限制了普适性推断；TACITO 试验的阴性主要终点进一步印证了疗效信号的脆弱性与对大样本验证的依赖。\",\n              \"transition\": \"上述初治队列的阳性结果与后续难治人群试验形成鲜明对比，引出下一单元关于 FMT 在 ICI 耐药背景下疗效受限的深入剖析。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"补充NSCLC背景下肠道菌群向肿瘤易位的实证数据，阐释Akkermansia等有益菌如何通过重塑局部微环境恢复耗竭CD8+ T细胞功能，支撑“非单纯定植而是功能重建”的机制论述。\",\n                  \"paper_id\": \"8211fc48bb00f738157c8859ad0748cc7d220f09\",\n                  \"source_handle\": \"P0297\"\n                },\n                {\n                  \"contribution\": \"提供一线实体瘤队列中FMT联合ICI的客观缓解率汇总数据，对比不同癌种（如黑色素瘤与结直肠癌）的响应差异，强化供体选择与给药工艺对疗效可重复性的影响分析。\",\n                  \"paper_id\": \"5b4da7a4eb5afd77f649e4aaa0b69c1db2666e97\",\n                  \"source_handle\": \"P0215\"\n                },\n                {\n                  \"contribution\": \"提供肠道-代谢物-免疫轴的结构化框架，详细阐述特定菌群（如LGG、BF839）通过cGAS-STING通路激活DC及SCFAs调节T细胞分化的分子机制，支撑Ch5:1中“基线有害菌清除与免疫微环境重塑”的机制论述，补充供体菌株功能验证的理论依据。\",\n                  \"paper_id\": \"8e25ec1d06aea0a73a479436c268bc6fab267259\",\n                  \"source_handle\": \"P0333\"\n                },\n                {\n                  \"contribution\": \"汇总活体生物疗法（MRx0518, CBM588）及高纤维饮食与ICI疗效关联的临床证据链，对比单药抗PD-1与双免疫骨架下的响应差异，强化Ch5:1中关于干预策略增效潜力及历史对照偏倚的批判性分析。\",\n                  \"paper_id\": \"93c5dd39ff702a807d9b564fd630d241e76ebcba\",\n                  \"source_handle\": \"P0343\"\n                },\n                {\n                  \"contribution\": \"提供JCOG2007 III期试验辅助生物标志物数据，证实特定菌属（Fusicatenibacter）丰度与化疗免疫联合方案OS获益及毒性风险相关，支撑Ch5:1中关于干预策略增效潜力及历史对照偏倚的批判性分析。\",\n                  \"paper_id\": \"8016df1aa5a8160b7ccd412fa6851a6a508e2731\",\n                  \"source_handle\": \"P0585\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0583\",\n              \"P0577\",\n              \"P0215\",\n              \"P0343\",\n              \"P0585\",\n              \"P0297\",\n              \"P0333\",\n              \"P0593\",\n              \"P0578\",\n              \"P0212\",\n              \"P0590\",\n              \"P0152\",\n              \"P0273\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U01::Ch5_U01_P01\",\n                \"Ch5::Ch5_U01::Ch5_U01_P02\",\n                \"Ch5::Ch5_U01::Ch5_U01_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch5_U02\",\n            \"focus\": \"FMT 在 ICI 耐药人群中的疗效局限性与生物学屏障（定植短暂、髓系主导微环境）。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U02_P01\",\n                \"point\": \"报告 MITRIC 试验在 ICI 耐药篮子队列中的 ORR、PFS 及临床获益分布。\",\n                \"development\": \"指出全队列 ORR 为 0%，仅 1 例获得长期疾病稳定（SD>6 个月），中位 PFS 仅 1.5 个月，明确 FMT 在此类高度经治人群中缺乏挽救性活性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0578\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 MITRIC 试验在 ICI 耐药实体瘤中的 ORR、PFS 及临床获益具体数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U02_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U02_P01\",\n                    \"unit_id\": \"Ch5_U02\",\n                    \"ordinal\": 1,\n                    \"point\": \"报告 MITRIC 试验在 ICI 耐药篮子队列中的 ORR、PFS 及临床获益分布。\",\n                    \"development\": \"指出全队列 ORR 为 0%，仅 1 例获得长期疾病稳定（SD>6 个月），中位 PFS 仅 1.5 个月，明确 FMT 在此类高度经治人群中缺乏挽救性活性。\",\n                    \"source_handles\": [\n                      \"P0578\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U02_P02\",\n                \"point\": \"解析阴性结果的生物学限制：定植动力学短暂与宿主免疫微环境固化。\",\n                \"development\": \"说明多数受体仅出现短暂供体相似性偏移，持久定植仅见于唯一获益者；基线髓系偏倚（高 CD14+ 单核细胞）与高 IL-8 水平预示不良预后，且 FMT 未能逆转该髓系主导状态，提示疗效受限于宿主固有免疫抑制背景。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0578\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供微生物动力学数据及外周血质谱流式显示的基线髓系偏倚与 IL-8 水平关联\"\n                  },\n                  {\n                    \"source_handle\": \"P0178\",\n                    \"role\": \"背景\",\n                    \"use\": \"引入“生态药理学”分析框架，阐明在宿主免疫微环境固化背景下，简单添加外源菌群难以逆转获得性耐药\"\n                  },\n                  {\n                    \"source_handle\": \"P0304\",\n                    \"role\": \"发展\",\n                    \"use\": \"系统梳理难治性队列中 FMT 干预后的免疫表型变化，指出短暂定植与基线炎症状态的耦合效应\"\n                  },\n                  {\n                    \"source_handle\": \"P0358\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供跨癌种微生物特征与 irAEs 发生率的对照清单，为阴性结果提供安全性与疗效权衡的背景参照\"\n                  },\n                  {\n                    \"source_handle\": \"P0474\",\n                    \"role\": \"发展\",\n                    \"use\": \"提供肿瘤微环境介导 ICI 耐药的机制综述，补充说明宿主基线免疫抑制背景对 FMT 疗效的限制\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U02_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U02_P02\",\n                    \"unit_id\": \"Ch5_U02\",\n                    \"ordinal\": 2,\n                    \"point\": \"解析阴性结果的生物学限制：定植动力学短暂与宿主免疫微环境固化。\",\n                    \"development\": \"说明多数受体仅出现短暂供体相似性偏移，持久定植仅见于唯一获益者；基线髓系偏倚（高 CD14+ 单核细胞）与高 IL-8 水平预示不良预后，且 FMT 未能逆转该髓系主导状态，提示疗效受限于宿主固有免疫抑制背景。\",\n                    \"source_handles\": [\n                      \"P0578\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U02_P03\",\n                \"point\": \"补充 Kim 等研究数据，确认耐药人群中 FMT 整体响应率极低。\",\n                \"development\": \"引用抗 PD-1 耐药晚期实体瘤单臂研究中 ORR 仅 7.7%、DCR 46.2% 的数据，强调缺乏随机对照与较小样本量，进一步支持 FMT 难以普遍克服已建立的获得性耐药。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0594\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 Kim 等前瞻性单臂研究在抗 PD-1 耐药实体瘤中的 ORR 与 DCR 数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U02_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U02_P03\",\n                    \"unit_id\": \"Ch5_U02\",\n                    \"ordinal\": 3,\n                    \"point\": \"补充 Kim 等研究数据，确认耐药人群中 FMT 整体响应率极低。\",\n                    \"development\": \"引用抗 PD-1 耐药晚期实体瘤单臂研究中 ORR 仅 7.7%、DCR 46.2% 的数据，强调缺乏随机对照与较小样本量，进一步支持 FMT 难以普遍克服已建立的获得性耐药。\",\n                    \"source_handles\": [\n                      \"P0594\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"难治人群的阴性结果并非否定微生物调节的理论价值，而是揭示了临床转化的现实约束：快速生长的弥漫性疾病剥夺了微生物重塑的时间窗口，而宿主基线髓系抑制与幼稚 T 细胞表型构成了难以通过单次 FMT 跨越的免疫屏障。\",\n              \"transition\": \"鉴于 FMT 在复杂人群中的局限性，领域内转向开发成分明确的活体生物药（LBPs）与益生菌以提升可控性，本单元将评估此类标准化制剂的早期临床信号。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"引入“生态药理学”分析框架，阐明在宿主免疫微环境固化及髓系优势背景下，简单添加外源菌群难以逆转获得性耐药，为阴性结果提供生态学层面的理论解释。\",\n                  \"paper_id\": \"4e5d3c59029be0d184837900411ff5a84badd8bc\",\n                  \"source_handle\": \"P0178\"\n                },\n                {\n                  \"contribution\": \"系统梳理难治性队列中FMT干预后的免疫表型变化（如IL-8下调尝试），指出短暂定植与基线炎症状态的耦合效应，补充说明为何微生物重塑未能转化为临床获益。\",\n                  \"paper_id\": \"84b1e34896b604ec02c721d50caa6d49e2965297\",\n                  \"source_handle\": \"P0304\"\n                },\n                {\n                  \"contribution\": \"提供跨癌种微生物特征与irAEs发生率的对照清单，区分厚壁菌门/拟杆菌门在不同免疫骨架下的毒性预测价值，避免将单一菌属的副作用风险泛化至所有干预场景，为Ch5:2阴性结果提供安全性与疗效权衡的背景参照。\",\n                  \"paper_id\": \"9c8304850055dda9ff76ba5868edb8fbfe85773b\",\n                  \"source_handle\": \"P0358\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0578\",\n              \"P0178\",\n              \"P0304\",\n              \"P0358\",\n              \"P0474\",\n              \"P0594\",\n              \"P0577\",\n              \"P0583\",\n              \"P0212\",\n              \"P0590\",\n              \"P0152\",\n              \"P0273\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U02::Ch5_U02_P01\",\n                \"Ch5::Ch5_U02::Ch5_U02_P02\",\n                \"Ch5::Ch5_U02::Ch5_U02_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch5_U03\",\n            \"focus\": \"定义明确的菌株制剂（LBPs/益生菌）的标准化优势与早期探索性疗效信号。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U03_P01\",\n                \"point\": \"评估 CBM588 在 mRCC 一线治疗中对肠道稳态的调节作用。\",\n                \"development\": \"说明 CBM588 能防止 Eubacterium siraeum 耗竭并纠正 Firmicutes/Bacteroidetes 比率失衡，为临床获益提供微生物学合理性，但早期 I 期合并分析未直接关联 ORR/PFS。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0006\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 CBM588 在 mRCC ICI 治疗中对肠道微生物组组成及失调的具体调节证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0143\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 CBM588 纠正 F/B 比率失衡及保护特定菌属的微生物标志物数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U03_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U03_P01\",\n                    \"unit_id\": \"Ch5_U03\",\n                    \"ordinal\": 1,\n                    \"point\": \"评估 CBM588 在 mRCC 一线治疗中对肠道稳态的调节作用。\",\n                    \"development\": \"说明 CBM588 能防止 Eubacterium siraeum 耗竭并纠正 Firmicutes/Bacteroidetes 比率失衡，为临床获益提供微生物学合理性，但早期 I 期合并分析未直接关联 ORR/PFS。\",\n                    \"source_handles\": [\n                      \"P0006\",\n                      \"P0143\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U03_P02\",\n                \"point\": \"报告 MRx0518 在 ICI 耐药实体瘤中的安全性轮廓与 TLR5 介导的免疫激活假说。\",\n                \"development\": \"指出 Part A 完成显示无治疗相关 SAEs，2/12 患者达 PR，DCR 42%；机制上基于前体研究提示其通过激活肿瘤 TLR5 减少 Treg 并增加 IFNγ+ T 细胞浸润，但人体直接验证有限。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0125\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 MRx0518 联合 pembrolizumab 在 ICI 耐药患者中的 Phase I/II 研究方案与筛选标准\"\n                  },\n                  {\n                    \"source_handle\": \"P0230\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 MRx0518 Phase I 研究的安全性数据及初步疗效信号（PR, DCR）\"\n                  },\n                  {\n                    \"source_handle\": \"P0244\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 MRx0518 在新辅助设置中的安全性及免疫调节基因表达变化证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0251\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供还原论视角下的分子机制证据（如 cdAMP-STING、肌苷-A2AR 通路），对比生态方法与定义菌群的优劣\"\n                  },\n                  {\n                    \"source_handle\": \"P0593\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供别嘌醇通过肌苷轴重塑 TME 并增强 ICI 疗效的临床前机制与回顾性临床证据，作为非微生物代谢干预案例对比\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U03_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U03_P02\",\n                    \"unit_id\": \"Ch5_U03\",\n                    \"ordinal\": 2,\n                    \"point\": \"报告 MRx0518 在 ICI 耐药实体瘤中的安全性轮廓与 TLR5 介导的免疫激活假说。\",\n                    \"development\": \"指出 Part A 完成显示无治疗相关 SAEs，2/12 患者达 PR，DCR 42%；机制上基于前体研究提示其通过激活肿瘤 TLR5 减少 Treg 并增加 IFNγ+ T 细胞浸润，但人体直接验证有限。\",\n                    \"source_handles\": [\n                      \"P0125\",\n                      \"P0230\",\n                      \"P0244\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U03_P03\",\n                \"point\": \"概述 MET4 等定义菌群组合的开发困境与监管挑战。\",\n                \"development\": \"提及 MET4-IO 试验因招募不足终止，反映复杂菌群组合在临床试验中的实施难度；同时指出单株/定义菌群虽利于质控，但疗效信号多为探索性终点，缺乏 OS/PFS 确证。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0122\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 MET4 诱导宿主全身性体液免疫反应及菌群变化的实证数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0387\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述微生物治疗辅助剂（益生菌 vs 菌群组合 vs FMT）的临床结局对比，揭示复杂性与效果的关系\"\n                  },\n                  {\n                    \"source_handle\": \"P0261\",\n                    \"role\": \"背景\",\n                    \"use\": \"汇总早期临床试验中定义菌群的探索性信号，强调监管标准化与质控优势及缺乏 OS/PFS 确证数据\"\n                  },\n                  {\n                    \"source_handle\": \"P0152\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供天然多糖作为免疫佐剂克服 ICI 耐药的机制见解与临床证据，作为定义菌群之外的干预策略补充\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U03_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U03_P03\",\n                    \"unit_id\": \"Ch5_U03\",\n                    \"ordinal\": 3,\n                    \"point\": \"概述 MET4 等定义菌群组合的开发困境与监管挑战。\",\n                    \"development\": \"提及 MET4-IO 试验因招募不足终止，反映复杂菌群组合在临床试验中的实施难度；同时指出单株/定义菌群虽利于质控，但疗效信号多为探索性终点，缺乏 OS/PFS 确证。\",\n                    \"source_handles\": [\n                      \"P0122\",\n                      \"P0387\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"LBPs 与益生菌通过成分标准化规避了 FMT 的批次异质性，并在体外或早期体内模型中展示了明确的免疫通路激活（如 TLR5、STING、IgG 应答），但人类临床数据仍以安全性与微生物组动态为主，疗效确证仍需大规模对照试验。\",\n              \"transition\": \"微生物干预在增强抗肿瘤免疫的同时，亦伴随特定的毒性风险，尤其是当供体特征与强效免疫骨架发生交互时。下一单元将聚焦干预相关安全性与情境依赖性毒性。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供还原论视角下的分子机制证据（如cdAMP-STING、肌苷-A2AR通路），对比生态方法（FMT）与定义菌群的优劣，支撑“菌株特异性决定疗效上限”的综合判断。\",\n                  \"paper_id\": \"68b67449fc944c707f68e31b629b3909e59b29ea\",\n                  \"source_handle\": \"P0251\"\n                },\n                {\n                  \"contribution\": \"汇总早期临床试验中CBM588等定义菌群的探索性信号，强调监管标准化与质控优势的同时，指出缺乏OS/PFS确证数据，平衡安全性收益与疗效不确定性。\",\n                  \"paper_id\": \"6f9060daa22a7c9efcd4a92919035c5e5c24367a\",\n                  \"source_handle\": \"P0261\"\n                },\n                {\n                  \"contribution\": \"提供别嘌醇通过肌苷轴重塑TME并增强ICI疗效的临床前机制与回顾性临床证据，作为非微生物代谢干预案例，对比定义菌群在靶向微环境重塑方面的异同。\",\n                  \"paper_id\": \"CorpusId:286644045\",\n                  \"source_handle\": \"P0593\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0006\",\n              \"P0143\",\n              \"P0125\",\n              \"P0230\",\n              \"P0244\",\n              \"P0251\",\n              \"P0593\",\n              \"P0122\",\n              \"P0387\",\n              \"P0261\",\n              \"P0152\",\n              \"P0578\",\n              \"P0577\",\n              \"P0583\",\n              \"P0212\",\n              \"P0590\",\n              \"P0273\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U03::Ch5_U03_P01\",\n                \"Ch5::Ch5_U03::Ch5_U03_P02\",\n                \"Ch5::Ch5_U03::Ch5_U03_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch5_U04\",\n            \"focus\": \"微生物干预相关的安全性风险及其情境依赖性（ICI 方案、供体特征）。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U04_P01\",\n                \"point\": \"对比 NSCLC 单药与黑色素瘤双药背景下 FMT 联合 ICI 的毒性发生率与起病时间。\",\n                \"development\": \"指出 NSCLC 组无 3 级以上 AEs，而黑色素瘤组 65% 发生 3 级以上 AEs，其中心肌炎发生率 15%（文献报道<1%），且中位起病时间提前至 40 天，提示双免疫骨架放大毒性风险。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 FMT-LUMINate 试验中不同 ICI 方案下的毒性谱差异、心肌炎发生率及起病时间数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U04_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U04_P01\",\n                    \"unit_id\": \"Ch5_U04\",\n                    \"ordinal\": 1,\n                    \"point\": \"对比 NSCLC 单药与黑色素瘤双药背景下 FMT 联合 ICI 的毒性发生率与起病时间。\",\n                    \"development\": \"指出 NSCLC 组无 3 级以上 AEs，而黑色素瘤组 65% 发生 3 级以上 AEs，其中心肌炎发生率 15%（文献报道<1%），且中位起病时间提前至 40 天，提示双免疫骨架放大毒性风险。\",\n                    \"source_handles\": [\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U04_P02\",\n                \"point\": \"揭示供体微生物组特征与 irAEs 的因果关联：Cluster B 供体与 S. copri 定植驱动毒性。\",\n                \"development\": \"说明无监督聚类将供体分为 Cluster A 与 B，后者富含 Prevotella spp.；接受 Cluster B 供体（尤其供体 5）的患者均发生 3 级以上 AEs，且 S. copri 定植与 CD4+ T 细胞亚群增加相关，该关联仅在双 ICI 背景下成立。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0583\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供供体聚类分析、Prevotella 富集与心肌炎风险的关联数据及 CD4+ T 细胞亚群变化\"\n                  },\n                  {\n                    \"source_handle\": \"P0250\",\n                    \"role\": \"发展\",\n                    \"use\": \"详述黑色素瘤双 ICI 背景下特定供体引发严重 irAEs 的队列数据，完善毒性情境依赖性的实证链条\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U04_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U04_P02\",\n                    \"unit_id\": \"Ch5_U04\",\n                    \"ordinal\": 2,\n                    \"point\": \"揭示供体微生物组特征与 irAEs 的因果关联：Cluster B 供体与 S. copri 定植驱动毒性。\",\n                    \"development\": \"说明无监督聚类将供体分为 Cluster A 与 B，后者富含 Prevotella spp.；接受 Cluster B 供体（尤其供体 5）的患者均发生 3 级以上 AEs，且 S. copri 定植与 CD4+ T 细胞亚群增加相关，该关联仅在双 ICI 背景下成立。\",\n                    \"source_handles\": [\n                      \"P0583\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U04_P03\",\n                \"point\": \"汇总 FMT 联合 ICI 的总体不良事件谱与文献共识。\",\n                \"development\": \"引用荟萃分析数据（1-2 级 AE 42%，3-4 级 AE 37%），指出双药组毒性更高；同时强调 FDA 对 FMT 传播耐药菌/病毒的警告，凸显供体筛查与制造控制的必要性。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0212\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 FMT 联合 ICI 的荟萃分析数据，包括 AE 发生率及异质性分析\"\n                  },\n                  {\n                    \"source_handle\": \"P0178\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供 FMT、LBPs 和定义菌群三类干预的安全性汇总及生态药理学因素分析\"\n                  },\n                  {\n                    \"source_handle\": \"P0231\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供跨癌种微生物特征与 irAEs 发生率的对照清单，区分不同免疫骨架下的毒性预测价值\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U04_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U04_P03\",\n                    \"unit_id\": \"Ch5_U04\",\n                    \"ordinal\": 3,\n                    \"point\": \"汇总 FMT 联合 ICI 的总体不良事件谱与文献共识。\",\n                    \"development\": \"引用荟萃分析数据（1-2 级 AE 42%，3-4 级 AE 37%），指出双药组毒性更高；同时强调 FDA 对 FMT 传播耐药菌/病毒的警告，凸显供体筛查与制造控制的必要性。\",\n                    \"source_handles\": [\n                      \"P0212\",\n                      \"P0178\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"安全性数据表明微生物干预并非绝对无害，其毒性谱受 ICI 治疗方案强烈调制；供体特异性菌群（如 Prevotella）在双阻断背景下可能过度激活 CD4+ T 细胞网络并破坏肠道屏障，提示未来试验必须建立基于 ICI 骨架的供体排除标准。\",\n              \"transition\": \"综合初治增效、难治局限、LBPs 探索与毒性警示，本章最后单元将统整当前证据等级，明确缺乏 III 期 RCT 的现状，并指出标准化与人群分层是下一阶段的核心任务。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"详述黑色素瘤双ICI背景下特定供体（Cluster B）引发严重irAEs的队列数据，揭示Prevotella富集与心肌炎风险的因果关联，完善毒性情境依赖性的实证链条。\",\n                  \"paper_id\": \"67a11dcbb1430387e3630bb0ffa834eccc29fa4f\",\n                  \"source_handle\": \"P0250\"\n                },\n                {\n                  \"contribution\": \"提供跨癌种微生物特征与irAEs发生率的对照清单，区分厚壁菌门/拟杆菌门在不同免疫骨架下的毒性预测价值，避免将单一菌属的副作用风险泛化至所有干预场景。\",\n                  \"paper_id\": \"608ca9e37ce71dcbbe9281286a7b96096c05b73c\",\n                  \"source_handle\": \"P0231\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0583\",\n              \"P0250\",\n              \"P0212\",\n              \"P0178\",\n              \"P0231\",\n              \"P0578\",\n              \"P0577\",\n              \"P0590\",\n              \"P0152\",\n              \"P0273\",\n              \"P0585\",\n              \"P0417\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U04::Ch5_U04_P01\",\n                \"Ch5::Ch5_U04::Ch5_U04_P02\",\n                \"Ch5::Ch5_U04::Ch5_U04_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch5_U05\",\n            \"focus\": \"当前证据等级局限（缺乏 III 期 RCT）与转化瓶颈（标准化、供体匹配、方法学）。\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch5_U05_P01\",\n                \"point\": \"确认尚无已完成的大型随机对照 III 期临床试验证实微生物干预在 ICI 治疗中的确切疗效。\",\n                \"development\": \"明确指出 TACITO 为 Phase 2a，MITRIC/MIMIC/LUMINate 均为单臂或早期设计；多项系统评价一致呼吁开展大规模、多中心、标准化的 III 期 RCT 以验证生存获益并优化方案。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0212\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供荟萃分析结论，指出当前缺乏标准化协议及大样本 RCT 证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0573\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供优化 FMT 以增强 ICI 疗效的概念图，强调从混乱到秩序的标准化需求\"\n                  },\n                  {\n                    \"source_handle\": \"P0333\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供肠道 - 代谢物 - 免疫轴综述，指出当前临床转化阶段的证据局限\"\n                  },\n                  {\n                    \"source_handle\": \"P0590\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供结直肠癌领域微生物组临床意义的综述，强调 FMT 仍处于实验性阶段\"\n                  },\n                  {\n                    \"source_handle\": \"P0417\",\n                    \"role\": \"背景\",\n                    \"use\": \"提供肠道微生物组对 ICI 疗效影响的系统评价，确认当前证据等级与异质性\"\n                  },\n                  {\n                    \"source_handle\": \"P0584\",\n                    \"role\": \"负责人指定\",\n                    \"use\": \"\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U05_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U05_P01\",\n                    \"unit_id\": \"Ch5_U05\",\n                    \"ordinal\": 1,\n                    \"point\": \"确认尚无已完成的大型随机对照 III 期临床试验证实微生物干预在 ICI 治疗中的确切疗效。\",\n                    \"development\": \"明确指出 TACITO 为 Phase 2a，MITRIC/MIMIC/LUMINate 均为单臂或早期设计；多项系统评价一致呼吁开展大规模、多中心、标准化的 III 期 RCT 以验证生存获益并优化方案。\",\n                    \"source_handles\": [\n                      \"P0212\",\n                      \"P0573\",\n                      \"P0584\",\n                      \"P0590\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U05_P02\",\n                \"point\": \"剖析影响疗效可重复性的关键变量：供体来源、预处理策略与给药途径的异质性。\",\n                \"development\": \"比较健康供体与 ICI 响应者供体的优劣争议；指出抗生素预处理（如 SER-401 试验）可能破坏保护性免疫准备；口服胶囊与内镜给药的定植效率差异尚未统一。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0178\",\n                    \"role\": \"主论据\",\n                    \"use\": \"分析影响干预效果的生态学和药理学因素（如抗生素使用、基线菌群状态）\"\n                  },\n                  {\n                    \"source_handle\": \"P0304\",\n                    \"role\": \"主论据\",\n                    \"use\": \"系统评价肠道微生物组改变药物及 FMT 对 ICI 疗效与毒性的影响，指出抗生素负面影响的例外情况\"\n                  },\n                  {\n                    \"source_handle\": \"P0546\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述肠道微生物组调节 ICI 的机制，指出临床疗效数据主要来自早期试验，效力证据等级有限\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U05_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U05_P02\",\n                    \"unit_id\": \"Ch5_U05\",\n                    \"ordinal\": 2,\n                    \"point\": \"剖析影响疗效可重复性的关键变量：供体来源、预处理策略与给药途径的异质性。\",\n                    \"development\": \"比较健康供体与 ICI 响应者供体的优劣争议；指出抗生素预处理（如 SER-401 试验）可能破坏保护性免疫准备；口服胶囊与内镜给药的定植效率差异尚未统一。\",\n                    \"source_handles\": [\n                      \"P0178\",\n                      \"P0304\",\n                      \"P0546\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch5_U05_P03\",\n                \"point\": \"提出解决转化瓶颈的方法学路径：纵向监测、功能预测模型与生态药理学框架。\",\n                \"development\": \"强调单次基线测序不足以捕捉动态演变；建议整合宏基因组功能注释、宿主免疫表型与机器学习构建预测模型；倡导将微生物干预视为\\\"生态扰动\\\"而非简单药物添加，需制定统一的报告与安全监测标准。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0363\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 gut microbiome–TME axis 综述，界定当前领域边界及识别研究空白（如缺乏前瞻性验证）\"\n                  },\n                  {\n                    \"source_handle\": \"P0329\",\n                    \"role\": \"例证\",\n                    \"use\": \"提供设计性活体生物疗法恢复响应者样微生物组特征的预测模型概念验证\"\n                  },\n                  {\n                    \"source_handle\": \"P0357\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述益生菌在癌症免疫治疗中的应用，指出当前证据局限性和未来研究方法学建议\"\n                  },\n                  {\n                    \"source_handle\": \"P0273\",\n                    \"role\": \"发展\",\n                    \"use\": \"批判性评估当前领域缺乏前瞻性验证与技术标准化的现状，呼吁开展大型多中心队列研究与随机干预试验\"\n                  },\n                  {\n                    \"source_handle\": \"P0303\",\n                    \"role\": \"发展\",\n                    \"use\": \"指出测序平台、样本采集时间点及地理饮食混杂因素导致的结果异质性，提出整合宏基因组功能注释与宿主免疫表型的纵向监测协议\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch5_U05_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch5_U05_P03\",\n                    \"unit_id\": \"Ch5_U05\",\n                    \"ordinal\": 3,\n                    \"point\": \"提出解决转化瓶颈的方法学路径：纵向监测、功能预测模型与生态药理学框架。\",\n                    \"development\": \"强调单次基线测序不足以捕捉动态演变；建议整合宏基因组功能注释、宿主免疫表型与机器学习构建预测模型；倡导将微生物干预视为\\\"生态扰动\\\"而非简单药物添加，需制定统一的报告与安全监测标准。\",\n                    \"source_handles\": [\n                      \"P0363\",\n                      \"P0329\",\n                      \"P0357\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"微生物干预已从现象观察步入机制驱动的干预设计阶段，但临床转化仍受制于证据等级偏低与操作规范缺失。唯有通过严格设计的 III 期 RCT、标准化的供体 - 受体匹配算法以及针对特定 ICI 骨架的安全阈值界定，方能将该领域的概念验证转化为可常规应用的精准医疗手段。\",\n              \"transition\": \"本章对微生物干预临床现状的系统评估，自然过渡至下一章对微生物组与免疫治疗毒性（irAEs）深层关联的探讨，并为后续方法学挑战章节奠定实证基础。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"批判性评估当前领域缺乏前瞻性验证与技术标准化的现状，呼吁开展大型多中心队列研究与随机干预试验，为转化瓶颈提供方法论层面的改进路径。\",\n                  \"paper_id\": \"759b176490dcac135bff0b645dc106c3df8f4059\",\n                  \"source_handle\": \"P0273\"\n                },\n                {\n                  \"contribution\": \"指出测序平台、样本采集时间点及地理饮食混杂因素导致的结果异质性，提出整合宏基因组功能注释与宿主免疫表型的纵向监测协议，作为解决可重复性危机的具体方案。\",\n                  \"paper_id\": \"847cf10f8ac760ce125802cd31697c58f8dbf822\",\n                  \"source_handle\": \"P0303\"\n                }\n              ]\n            },\n            \"unit_notes\": \"\",\n            \"source_handles\": [\n              \"P0212\",\n              \"P0573\",\n              \"P0333\",\n              \"P0590\",\n              \"P0417\",\n              \"P0584\",\n              \"P0178\",\n              \"P0304\",\n              \"P0546\",\n              \"P0363\",\n              \"P0329\",\n              \"P0357\",\n              \"P0273\",\n              \"P0303\",\n              \"P0578\",\n              \"P0577\",\n              \"P0583\",\n              \"P0152\",\n              \"P0585\",\n              \"P0096\",\n              \"P0148\",\n              \"P0474\",\n              \"P0271\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch5::Ch5_U05::Ch5_U05_P01\",\n                \"Ch5::Ch5_U05::Ch5_U05_P02\",\n                \"Ch5::Ch5_U05::Ch5_U05_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          }\n        ],\n        \"other_chapter_references\": [\n          \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\",\n          \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\",\n          \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\",\n          \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\",\n          \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\",\n          \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\"\n        ]\n      },\n      {\n        \"schema_version\": \"optomind.writer_candidates.input.v1\",\n        \"chapter_id\": \"Ch6\",\n        \"chapter_frame\": {\n          \"chapter_title\": \"微生物组与免疫治疗毒性的关联\",\n          \"chapter_purpose\": \"明确微生物组作为 ICI 毒性预测标志物的临床潜力与局限，理解疗效与毒性耦合/解耦的生物学基础，并掌握基于供体特征与 ICI 方案的情境化安全性管理策略。特别需注意非结肠炎 irAEs（如心肌炎、神经毒性）的微生物组证据仍受限于样本量，当前结论主要基于结肠炎数据。\",\n          \"chapter_scope\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因癌种特异性、毒性表型（结肠炎 vs 心肌炎）及干预情境（供体特征、ICI 骨架方案）而异。观察性关联在结肠炎中证据最强，心肌炎等罕见 irAEs 仍受限于样本量；微生物干预（如 FMT）的获益与风险高度依赖于供体菌群组成与联合用药方案的交互作用。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用。\",\n          \"chapter_thesis\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因癌种特异性、毒性表型（结肠炎 vs 心肌炎）及干预情境（供体特征、ICI 骨架方案）而异。观察性关联在结肠炎中证据最强，心肌炎等罕见 irAEs 仍受限于样本量；微生物干预（如 FMT）的获益与风险高度依赖于供体菌群组成与联合用药方案的交互作用。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用。\",\n          \"chapter_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因癌种特异性、毒性表型（结肠炎 vs 心肌炎）及干预情境（供体特征、ICI 骨架方案）而异。观察性关联在结肠炎中证据最强，心肌炎等罕见 irAEs 仍受限于样本量；微生物干预（如 FMT）的获益与风险高度依赖于供体菌群组成与联合用药方案的交互作用。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用。\",\n          \"reader_objective\": \"明确微生物组作为 ICI 毒性预测标志物的临床潜力与局限，理解疗效与毒性耦合/解耦的生物学基础，并掌握基于供体特征与 ICI 方案的情境化安全性管理策略。特别需注意非结肠炎 irAEs（如心肌炎、神经毒性）的微生物组证据仍受限于样本量，当前结论主要基于结肠炎数据。\",\n          \"research_question\": \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\",\n          \"review_argument\": \"肠道微生物组通过分类学特征、代谢产物及免疫通路调节实体瘤患者对 ICI 的临床疗效，但证据强度因肿瘤类型、研究设计及干预策略而异。观察性关联证据在黑色素瘤中最强，NSCLC 和 RCC 次之，但关联不等于因果。机制证据主要来自动物模型，人类验证有限，特别是肿瘤微环境内代谢物浓度数据缺失（如肌苷仅有血浆数据）。干预策略在初治人群中显示希望（FMT-LUMINate ORR 75-80%），但在难治人群中效果有限（MITRIC ORR 0%），且安全性受 ICI 方案调节（Prevotella 相关心肌炎仅在双 ICI 背景下出现）。目前缺乏 Phase III RCT 证据支持微生物干预的常规临床应用，未来研究需解决标准化、因果推断及人群分层问题。\",\n          \"shared_scope\": {\n            \"statement\": \"本综述聚焦于实体瘤（黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗期间，肠道微生物组对治疗疗效（ORR、PFS、OS）及毒性（irAEs）的调节作用。涵盖观察性关联证据（区分回顾性与前瞻性队列）、因果机制解析（免疫细胞、分子通路、代谢物）、外部干扰因素（抗生素、PPI、饮食）及微生物干预策略（FMT、益生菌、工程菌）的临床试验数据。明确排除血液系统恶性肿瘤及非免疫治疗背景下的微生物组研究（除非用于机制对比）。严格区分肠道微生物组与肿瘤内微生物组的作用边界。证据等级标注明确：观察性关联不推断因果，干预试验区分 I/II 期与 III 期，代谢物数据区分血浆与肿瘤组织浓度。\"\n          },\n          \"review_argument_status\": \"calibrated\",\n          \"review_argument_source\": \"whole_plan_improvement\"\n        },\n        \"language\": \"zh\",\n        \"units\": [\n          {\n            \"unit_id\": \"Ch6_U1\",\n            \"focus\": \"特定菌属与 irAEs 的癌种特异性关联及预测模型困境\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch6_U1_P01\",\n                \"point\": \"结肠炎型 irAEs 的微生物指纹与整体多样性下降\",\n                \"development\": \"比较结肠炎型与非结肠炎型 irAE 患者的粪便宏基因组/16S 特征，指出主要产丁酸菌丰度降低、拟杆菌门/双歧杆菌减少及肠球菌富集是结肠炎的核心表型。P0017 通过抗生素预处理小鼠 FMT 实验验证其因果致病潜力：接受结肠炎型患者菌群移植的小鼠出现致命性严重结肠炎（3/9 死亡），而非结肠炎型菌群移植小鼠全部存活。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0017\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供结肠炎型患者菌群移植小鼠出现致命性严重结肠炎的因果证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0600\",\n                    \"role\": \"比较\",\n                    \"use\": \"提供肺癌及多癌种队列中结肠炎与非结肠炎 irAEs 的微生物指纹差异，并通过人源化小鼠 FMT 实验确立菌群致结肠炎的因果性\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U1_P01\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U1_P01\",\n                    \"unit_id\": \"Ch6_U1\",\n                    \"ordinal\": 1,\n                    \"point\": \"结肠炎型 irAEs 的微生物指纹与整体多样性下降\",\n                    \"development\": \"比较结肠炎型与非结肠炎型 irAE 患者的粪便宏基因组/16S 特征，指出主要产丁酸菌丰度降低、拟杆菌门/双歧杆菌减少及肠球菌富集是结肠炎的核心表型。P0017 通过抗生素预处理小鼠 FMT 实验验证其因果致病潜力：接受结肠炎型患者菌群移植的小鼠出现致命性严重结肠炎（3/9 死亡），而非结肠炎型菌群移植小鼠全部存活。\",\n                    \"source_handles\": [\n                      \"P0017\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U1_P02\",\n                \"point\": \"胃肠道癌症的保护性菌群与器官特异性毒性差异\",\n                \"development\": \"聚焦食管癌、胃癌、结直肠癌队列（P0011，n=95），指出 Ruminococcus callidus 和 Bacteroides xylanisolvens 在无重症 irAEs 患者中显著富集，且尿素循环/精氨酸生物合成通路与低毒性相关。同时强调皮肤、血液、内分泌及肝脏毒性各自呈现独立的微生物通路特征，反驳单一通用标志物假设。但需注意该研究样本量有限且缺乏外部验证。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0011\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供胃肠道癌症队列中 Ruminococcus callidus 和 Bacteroides xylanisolvens 富集与低毒性相关的实证数据\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U1_P02\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U1_P02\",\n                    \"unit_id\": \"Ch6_U1\",\n                    \"ordinal\": 2,\n                    \"point\": \"胃肠道癌症的保护性菌群与器官特异性毒性差异\",\n                    \"development\": \"聚焦食管癌、胃癌、结直肠癌队列（P0011，n=95），指出 Ruminococcus callidus 和 Bacteroides xylanisolvens 在无重症 irAEs 患者中显著富集，且尿素循环/精氨酸生物合成通路与低毒性相关。同时强调皮肤、血液、内分泌及肝脏毒性各自呈现独立的微生物通路特征，反驳单一通用标志物假设。但需注意该研究样本量有限且缺乏外部验证。\",\n                    \"source_handles\": [\n                      \"P0011\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"paragraph_id\": \"Ch6_U1_P03\",\n                \"point\": \"预测模型的构建困境与非结肠炎 irAEs 证据不足\",\n                \"development\": \"评估基于机器学习（如 RF14 分类器，P0308）的 irAEs 预测模型性能，指出尽管 AUC 可达 0.88，但在多重检验校正后部分特征显著性不足。P0312 综述指出，即使在大样本队列中，非结肠炎 irAEs（如心肌炎、神经毒性）的样本量仍不足以支持独立的微生物组分析，当前证据主要集中于结肠炎。不同研究间测序平台、CTCAE 分级版本及队列异质性导致模型泛化能力受限。\",\n                \"source_uses\": [\n                  {\n                    \"source_handle\": \"P0308\",\n                    \"role\": \"主论据\",\n                    \"use\": \"提供 RF14 分类器性能数据及多重检验校正后特征显著性不足的证据\"\n                  },\n                  {\n                    \"source_handle\": \"P0312\",\n                    \"role\": \"背景\",\n                    \"use\": \"综述指出非结肠炎 irAEs 样本量不足以支持独立微生物组分析的限制\"\n                  },\n                  {\n                    \"source_handle\": \"P0049\",\n                    \"role\": \"局限\",\n                    \"use\": \"揭示 F. prausnitzii 等标志物在多重检验下的不一致性及大样本队列中非结肠炎亚组样本量极小（n=2）的现状\"\n                  },\n                  {\n                    \"source_handle\": \"P0605\",\n                    \"role\": \"局限\",\n                    \"use\": \"量化心肌炎/脑膜炎等亚组样本量极小，直接支撑预测模型构建困境及非结肠炎毒性证据不足的论述\"\n                  }\n                ],\n                \"carried_over\": true,\n                \"point_changed_from_brief\": false,\n                \"source_briefs\": [\n                  \"Ch6_U1_P03\"\n                ],\n                \"source_brief_details\": [\n                  {\n                    \"paragraph_id\": \"Ch6_U1_P03\",\n                    \"unit_id\": \"Ch6_U1\",\n                    \"ordinal\": 3,\n                    \"point\": \"预测模型的构建困境与非结肠炎 irAEs 证据不足\",\n                    \"development\": \"评估基于机器学习（如 RF14 分类器，P0308）的 irAEs 预测模型性能，指出尽管 AUC 可达 0.88，但在多重检验校正后部分特征显著性不足。P0312 综述指出，即使在大样本队列中，非结肠炎 irAEs（如心肌炎、神经毒性）的样本量仍不足以支持独立的微生物组分析，当前证据主要集中于结肠炎。不同研究间测序平台、CTCAE 分级版本及队列异质性导致模型泛化能力受限。\",\n                    \"source_handles\": [\n                      \"P0308\",\n                      \"P0312\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"table_tasks\": [],\n            \"owner_unit_context\": {\n              \"evidence_conditions\": \"\",\n              \"synthesis\": \"微生物组对 irAEs 的预测价值呈现显著的癌种与器官特异性，结肠炎表型的微生物驱动证据最为坚实（包括动物因果验证），而其他毒性类型（心肌炎、神经毒性等）的独立预测标志物仍需大样本前瞻性队列验证。当前非结肠炎 irAEs 的微生物组证据受限于样本量，不能外推为领域层面的确定性结论。\",\n              \"transition\": \"在确认特定菌群与毒性关联的基础上，需进一步解析为何某些微生物特征既能促进抗肿瘤响应，又会引发过度免疫激活，从而引出疗效与毒性的耦合与解耦机制。\",\n              \"supporting_studies\": [\n                {\n                  \"contribution\": \"提供肺癌及多癌种队列中结肠炎与非结肠炎irAEs的微生物指纹差异，并通过人源化小鼠FMT实验确立菌群致结肠炎的因果性，直接支撑癌种特异性关联与样本量局限性的论述。\",\n                  \"paper_id\": \"CorpusId:257062954\",\n                  \"source_handle\": \"P0600\"\n                },\n                {\n                  \"contribution\": \"基于大样本前瞻性队列揭示Ruminococcaceae科动态下降与严重irAEs的关联，并剖析F. prausnitzii等标志物在多重检验下的不一致性，用于论证预测模型构建的方法学困境。\",\n                  \"paper_id\": \"1607ffdb79bd5dbb1f94932e27410c55f0aa8290\",\n                  \"source_handle\": \"P0049\"\n                },\n                {\n                  \"contribution\": \"提供大样本前瞻性纵向队列数据，证实Ruminococcaceae动态耗竭与严重irAEs关联，并量化心肌炎/脑膜炎等亚组样本量极小（n=2），直接支撑预测模型构建困境及非结肠炎毒性证据不足的论述。\",\n                  \"paper_id\": \"CorpusId:275340168\",\n                  \"source_handle\": \"P0605\"\n                }\n              ]\n            },\n            \"unit_notes\": \"将 P0600 从 case_level_uses 整合进 P01，强化因果证据；将 P0049/P0605 整合进 P03，明确样本量局限。\",\n            \"source_handles\": [\n              \"P0017\",\n              \"P0600\",\n              \"P0011\",\n              \"P0308\",\n              \"P0312\",\n              \"P0049\",\n              \"P0605\",\n              \"P0601\",\n              \"P0595\",\n              \"P0597\",\n              \"P0596\",\n              \"P0261\",\n              \"P0319\",\n              \"P0447\",\n              \"P0297\",\n              \"P0146\",\n              \"P0609\",\n              \"P0460\",\n              \"P0486\",\n              \"P0604\",\n              \"P0602\",\n              \"P0462\",\n              \"P0284\",\n              \"P0067\",\n              \"P0314\",\n              \"P0409\",\n              \"P0197\",\n              \"P0598\",\n              \"P0578\",\n              \"P0212\",\n              \"P0590\"\n            ],\n            \"fullbody_task_keys\": {\n              \"paragraph_tasks\": [\n                \"Ch6::Ch6_U1::Ch6_U1_P01\",\n                \"Ch6::Ch6_U1::Ch6_U1_P02\",\n                \"Ch6::Ch6_U1::Ch6_U1_P03\"\n              ],\n              \"table_tasks\": []\n            }\n          },\n          {\n            \"unit_id\": \"Ch6_U2\",\n            \"focus\": \"疗效与毒性的耦合及解耦关系与免疫稳态中介\",\n            \"paragraph_tasks\": [\n              {\n                \"paragraph_id\": \"Ch6_U2_P01\",\n                \"point\": \"共享免疫激活通路的\\\"双刃剑\\\"效应\",\n                \"development\": \"指出高丰度 Akkermansia mu
