le\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U02::Ch7_U02_P03\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U02\",\n        \"local_task_id\": \"Ch7_U02::Ch7_U02_P03\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U02::Ch7_U02_P04\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U02\",\n        \"local_task_id\": \"Ch7_U02::Ch7_U02_P04\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U03::Ch7_U03_P01\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U03\",\n        \"local_task_id\": \"Ch7_U03::Ch7_U03_P01\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U03::Ch7_U03_P02\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U03\",\n        \"local_task_id\": \"Ch7_U03::Ch7_U03_P02\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U03::Ch7_U03_P03\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U03\",\n        \"local_task_id\": \"Ch7_U03::Ch7_U03_P03\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U03::Ch7_U03_P04\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U03\",\n        \"local_task_id\": \"Ch7_U03::Ch7_U03_P04\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U04::Ch7_U04_P01\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U04\",\n        \"local_task_id\": \"Ch7_U04::Ch7_U04_P01\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U04::Ch7_U04_P02\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U04\",\n        \"local_task_id\": \"Ch7_U04::Ch7_U04_P02\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U04::Ch7_U04_P03\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U04\",\n        \"local_task_id\": \"Ch7_U04::Ch7_U04_P03\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      },\n      {\n        \"task_id\": \"Ch7::Ch7_U04::Ch7_U04_P04\",\n        \"chapter_id\": \"Ch7\",\n        \"unit_id\": \"Ch7_U04\",\n        \"local_task_id\": \"Ch7_U04::Ch7_U04_P04\",\n        \"kind\": \"paragraph\",\n        \"editable\": true\n      }\n    ],\n    \"other_chapters\": {\n      \"neighbor::17318a790db7719ebb69d3a7e5ddec9e65e4624988415d3e30d7166c413547a7\": {\n        \"chapter_id\": \"Ch2\",\n        \"purpose\": \"帮助读者建立“微生物信号→先天识别→适应性启动→髓系/屏障重塑”的机制链条认知，明确区分动物模型中的因果发现与人类队列中的相关性证据，并理解不同实体瘤类型中机制表达的异质性，为后续代谢物专论（Ch3）与临床转化（Ch5）奠定生物学基础。\"\n      },\n      \"neighbor::204d1f2405b7e031a2a1d33e94f1e39a6cd39bf301f6e53b7a426e13f26feefc\": {\n        \"chapter_id\": \"Ch3\",\n        \"purpose\": \"读者将掌握四大类核心微生物代谢物调节 ICI 疗效的具体分子靶点与下游通路，理解代谢物效应的强情境依赖性（如 SCFAs 在 PD-1 与 CTLA-4 背景下的双向作用），并明确当前文献中人体 TME 代谢物浓度数据的缺失现状（特别是肌苷仅有血浆关联数据而无组织实测值）及其对因果推断的限制。\"\n      },\n      \"neighbor::d95ca3b8d264bec565032213d3481b34e739ae6986f993cbbcb807362fe01dc7\": {\n        \"chapter_id\": \"Ch4\",\n        \"purpose\": \"使读者系统掌握抗生素、质子泵抑制剂、饮食模式及生活方式等外部因素如何通过改变肠道微生物组进而影响ICI疗效，理解暴露时机、药物类别与肿瘤背景对效应的修饰作用，并清晰区分观察性关联与因果推断的边界，为后续主动微生物干预策略（Ch5）奠定临床现实与方法学基础。\"\n      },\n      \"neighbor::710ad3f4d4078685c81014f585a7f88bfec03eb44a29372fa4f067a5e0e56ecc\": {\n        \"chapter_id\": \"Ch5\",\n        \"purpose\": \"使读者清晰掌握当前微生物干预策略的临床证据等级、疗效异质性来源、安全性边界及转化瓶颈，为理解该领域从\\\"观察性关联\\\"走向\\\"因果性干预\\\"的现实路径提供结构化评估。\"\n      },\n      \"neighbor::b68a2828b9169443756440bdb15c53428fc51c1466006f67973522f172059795\": {\n        \"chapter_id\": \"Ch6\",\n        \"purpose\": \"明确微生物组作为 ICI 毒性预测标志物的临床潜力与局限，理解疗效与毒性耦合/解耦的生物学基础，并掌握基于供体特征与 ICI 方案的情境化安全性管理策略。特别需注意非结肠炎 irAEs（如心肌炎、神经毒性）的微生物组证据仍受限于样本量，当前结论主要基于结肠炎数据。\"\n      },\n      \"neighbor::cb843183c32f73b001f67c79c594307b920cafddb966b5b472e143db5a9a80d8\": {\n        \"chapter_id\": \"Ch7\",\n        \"purpose\": \"帮助读者识别当前领域内关键的方法学瓶颈与证据等级差异，理解为何单一菌种难以成为通用预测因子，并为后续临床转化研究提供可操作的设计原则、优先级排序及边界认知。\"\n      },\n      \"neighbor::9d17417f5ed26e637123039641801d99dcb785192525c97651fcda6f3469e94f\": {\n        \"chapter_id\": \"Ch1\",\n        \"purpose\": \"使读者能够准确评估不同实体瘤类型中肠道微生物特征与 ICI 临床结局的观察性关联强度，理解外部干扰因素与纵向动态对关联强度的修饰作用，并清晰区分当前证据的阶梯分布（从强观察性关联到弱干预性概念验证），避免将相关性误读为因果性或普适性生物标志物。\"\n      }\n    },\n    \"intent_is_not_scientific_evidence\": true\n  },\n  \"accepted_body_markdown\": \"\",\n  \"current_scope_partial_body_markdown\": \"\",\n  \"output_continuation\": false,\n  \"continuation_join\": null,\n  \"accepted_prose_scope\": \"entire_actual_prefix\",\n  \"manuscript_navigation\": [],\n  \"recent_prose_segments\": [],\n  \"reread_segments\": [],\n  \"writing_position\": {\n    \"completed_task_ids\": [],\n    \"current_task_ids\": [\n      \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P01\",\n      \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P02\",\n      \"Ch1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1::U1_%E8%B7%A8%E7%99%8C%E7%A7%8D%E5%85%B3%E8%81%94%E5%9B%BE%E8%B0%B1_P03\",\n      \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P01\",\n      \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF_P02\",\n      \"Ch1::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%E6%89%B0%E4%B8%8E%E5%AE%BF%E4%B8%BB%E8%83%8C%E6%99%AF::U2_%E5%A4%96%E9%83%A8%E5%B9%B2%