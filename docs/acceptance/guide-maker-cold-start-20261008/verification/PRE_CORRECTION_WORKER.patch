+def _record_request_composition(stage, outcome, *, run_dir, input_hash, code_hash,
+                                dependencies):
+    """Persist the exact stage shape without duplicating provider secrets/raw text."""
+    messages_path = Path(outcome["messages_path"])
+    composition_path = messages_path.with_name("REQUEST_COMPOSITION.json")
+    rows = stage.get("messages", [])
+    actual_path = None
+    actual = None
+    if outcome.get("attempt_dir"):
+        candidate = Path(outcome["attempt_dir"]) / "ACTUAL_REQUEST.json"
+        if candidate.is_file():
+            actual_path = str(candidate)
+            actual = _read(candidate)
+    composition = {
+        "schema_version": "optomind.guide_maker.v1.request_composition",
+        "stage_id": stage["stage_id"],
+        "role": stage["role"],
+        "execution_mode": outcome.get("execution_mode", "preview"),
+        "status": outcome.get("status"),
+        "messages_path": str(messages_path),
+        "message_count": len(rows),
+        "message_roles": [row.get("role") for row in rows if isinstance(row, Mapping)],
+        "message_sha256": _text_hash(rows),
+        "message_characters": sum(len(str(row.get("content", ""))) for row in rows if isinstance(row, Mapping)),
+        "wire_request_sha256": stage.get("estimate", {}).get("wire_request_sha256"),
+        "wire_parameters": stage.get("estimate", {}).get("wire_parameters"),
+        "estimate": stage.get("estimate"),
+        "actual_request_path": actual_path,
+        "actual_request": actual,
+        "input_hash": input_hash,
+        "code_hash": code_hash,
+        "dependencies": deepcopy(dependencies),
+    }
+    _write(composition_path, composition, ascii_only=True)
+    outcome["request_composition_path"] = str(composition_path)
+    return composition
+
