0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"\\n\\n```guide_writer\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"_metadata\\n{\\\"complete\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"\\\":true,\\\"remaining\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"_content\\\":[]}\\n\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"```\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[{\"finish_reason\":\"stop\",\"delta\":{\"content\":\"\",\"reasoning_content\":null},\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: {\"choices\":[],\"object\":\"chat.completion.chunk\",\"usage\":{\"prompt_tokens\":382842,\"completion_tokens\":6607,\"total_tokens\":389449,\"completion_tokens_details\":{\"reasoning_tokens\":4474,\"text_tokens\":6607},\"prompt_tokens_details\":{\"text_tokens\":382842}},\"created\":1791444312,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-10969aaf-ba6f-9bf6-aca8-aece4bd3cc08\"}\n\ndata: [DONE]\n\n",
