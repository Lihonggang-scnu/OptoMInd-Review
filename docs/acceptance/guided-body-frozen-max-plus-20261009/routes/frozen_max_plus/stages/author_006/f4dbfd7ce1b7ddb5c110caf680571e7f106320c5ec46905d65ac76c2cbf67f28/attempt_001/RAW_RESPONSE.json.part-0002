:[{\"delta\":{\"content\":\"筛选需考虑\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791549626,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-deb0afdf-3023-95a6-87c6-cc63b69d9792\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"治疗方案。分子机制\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791549626,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-deb0afdf-3023-95a6-87c6-cc63b69d9792\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"涉及\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791549626,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-deb0afdf-3023-95a6-87c6-cc63b69d9792\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"屏障、模拟及\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791549626,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-deb0afdf-3023-95a6-87c6-cc63b69d9792\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"细胞因子轴\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791549626,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-deb0afdf-3023-95a6-87c6-cc63b69d9792\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"，但多源于\",\"reasoning_content\":null},\"finish_reason\":null,\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791549626,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-deb0afdf-3023-95a6-87c6-cc63b69d9792\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"模型