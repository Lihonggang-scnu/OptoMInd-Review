        {
          "source_handle": "P0588",
          "title": "Inosine enhances the efficacy of immune‐checkpoint inhibitors in advanced solid tumors: A randomized, controlled, Phase 2 study",
          "year": "2024",
          "doi": "10.1002/cam4.70143",
          "paper_id": "CorpusId:272644866",
          "material_depth": "fulltext",
          "material_status": "resolved",
          "aliases": [],
          "study_summary_A": {
            "approach": "采用单中心、随机对照试验设计。纳入符合RECIST v1.1标准的晚期实体瘤患者，按1:1比例随机分组。试验组接受标准免疫治疗联合肌苷（0.2g tid），对照组接受标准免疫治疗。疗效评估每6周进行一次，主要终点为ORR，次要终点为DCR、OS和PFS。使用Kaplan-Meier法计算生存曲线，Cox比例风险模型进行多因素分析，并对不同亚组（如肿瘤类型、炎症指标、转移部位）进行探索性分析以识别潜在受益人群。",
            "contribution_and_limits": [
              {
                "contribution": "提供了肌苷联合ICI治疗晚期实体瘤的首个随机对照临床II期数据，证实了肌苷在延长PFS方面的统计学显著性，并为“肠道代谢物调节免疫治疗”假说提供了初步临床支持。",
                "limits": "单中心设计导致样本量有限（每组86人）；非盲法设计可能存在偏倚；多肿瘤类型混合导致统计效能分散，OS结果受后续治疗影响较大；亚组分析为探索性，存在多重比较问题，需外部验证。"
              }
            ],
            "key_findings": [
              {
                "conditions": "全队列（N=172）",
                "finding": "肌苷组中位PFS显著长于对照组（7.00 vs 4.40个月，HR=0.63, p=0.011）；ORR为26.7% vs 15.1%（p=0.061，未显著）；中位OS两组无显著差异（HR=1.05, p=0.874）。"
              },
              {
                "conditions": "肺癌亚组（N=57）",
                "finding": "肌苷组mPFS显著延长（13.80 vs 4.10个月，HR=0.45, p=0.018）；mOS趋势向好但未达显著（HR=0.46, p=0.100）。"
              },
              {
                "conditions": "消化道恶性肿瘤亚组（N=55）",
                "finding": "肌苷组mPFS有延长趋势但未达显著（5.77 vs 3.50个月，HR=0.63, p=0.121）；mOS无显著差异。"
              },
              {
                "conditions": "实验室指标亚组（PLR<229, NLR<4, LDH≥216, ENR≤0.012）",
                "finding": "在这些特定炎症/代谢标志物背景下，肌苷组PFS均显著优于对照组。"
              },
              {
                "conditions": "安全性评估",
                "finding": "肌苷组3-4级不良事件发生率为29%，对照组为36%（p=0.329），提示肌苷可能不增加且略有降低严重不良反应的风险。"
              }
            ],
            "paper_kind": "empirical",
            "problem_or_question": "尽管临床前研究表明肠道微生物代谢物肌苷可增强ICI疗效，但缺乏人体临床证据。本研究试图解决肌苷作为辅助治疗是否能提高晚期实体瘤患者对PD-1/PD-L1抑制剂的响应率及生存获益的问题。",
            "research_scope": "单中心、前瞻性、随机、开放标签的II期临床试验。研究对象为晚期恶性实体瘤患者（包括肺癌、消化道肿瘤等），干预措施为在PD-1/PD-L1抑制剂基础上联合口服肌苷（0.2g，每日三次），对照组仅接受PD-1/PD-L1抑制剂±靶向±化疗。主要评估终点为客观缓解率（ORR）、无进展生存期（PFS）和总生存期（OS）。",
            "work_summary": "本研究旨在验证肠道微生物代谢物肌苷能否增强免疫检查点抑制剂（ICIs）在晚期实体瘤中的疗效。研究在北京友谊医院开展，将172名患者随机分配至肌苷组或对照组。结果显示，与对照组相比，肌苷组显著延长了中位PFS（7.00 vs 4.40个月，HR=0.63, p=0.011），ORR呈上升趋势但未达统计学显著性（26.7% vs 15.1%, p=0.061），OS两组无显著差异。亚组分析显示肌苷在多种基线特征下均能改善PFS。安全性方面，肌苷组3-4级不良反应发生率略低于对照组。结论认为肌苷有潜力增强ICI疗效并降低相关不良反应。"
          },
          "review_planning_B": {
            "planning_summary": "该论文提供了肌苷（一种已知的肠道微生物代谢物）在人体中增强ICI疗效的直接临床证据。对于综述而言，它是连接“肠道菌群代谢物”与“ICI疗效”的关键实证环节，特别是填补了从动物实验到人类临床应用的空白。其核心价值在于展示了具体代谢物干预的临床可行性、剂量方案及初步疗效信号，同时揭示了不同肿瘤类型和炎症状态下的异质性响应。",
            "facet_contributions": [
