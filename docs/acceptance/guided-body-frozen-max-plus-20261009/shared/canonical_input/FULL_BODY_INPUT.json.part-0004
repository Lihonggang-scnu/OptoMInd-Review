          "source_handle": "P0591",
          "title": "Peripheral blood biomarkers in PD-1/PD-L1 immunotherapy: distinguishing predictive from prognostic biomarkers",
          "year": "2026",
          "doi": "10.3389/fimmu.2026.1924506",
          "paper_id": "CorpusId:291487342",
          "material_depth": "",
          "material_status": "resolved",
          "aliases": [],
          "locator": {
            "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch3.json",
