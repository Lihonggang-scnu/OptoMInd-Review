        {
          "unit_id": "Ch4_U02",
          "focus": "质子泵抑制剂（PPIs）通过降低胃酸促进口腔细菌易位与菌群多样性丧失，独立预测 ICI 疗效下降，且效应受既往化疗时序的修饰。",
          "paragraph_tasks": [
            {
              "paragraph_id": "Ch4_U02_P01",
              "point": "量化PPIs使用与ICI生存结局的负相关，强调使用时窗（基线/ICI前60天）的决定性作用。",
              "development": "整合P0339 Meta分析数据（OS HR 1.31, PFS HR 1.30），对比不同暴露时窗的效应差异，确立PPI作为独立预后不良因子的地位。",
              "source_uses": [
                {
                  "source_handle": "P0339",
                  "role": "主论据",
