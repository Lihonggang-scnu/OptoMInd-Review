        {
          "source_handle": "P0251",
          "title": "Microbial mechanisms to improve immune checkpoint blockade responsiveness",
          "year": "2022",
          "doi": "10.1016/j.neo.2022.100818",
          "paper_id": "68b67449fc944c707f68e31b629b3909e59b29ea",
          "material_depth": "fulltext",
          "material_status": "resolved",
          "aliases": [],
          "study_summary_A": {
            "approach": "采用还原论视角，从生态水平的菌群相关性分析转向分子水平的机制解析。具体路线包括：1) 梳理建立相关性的大规模测序研究和动物模型实验；2) 验证相关性并识别宿主表型（如CD8+ T细胞浸润）；3) 深入探讨具体的分子机制，分为T细胞刺激、髓系细胞刺激和分子模拟三个子主题；4) 评估基于分子机制的工程化益生菌应用前景。",
            "contribution_and_limits": [
              {
