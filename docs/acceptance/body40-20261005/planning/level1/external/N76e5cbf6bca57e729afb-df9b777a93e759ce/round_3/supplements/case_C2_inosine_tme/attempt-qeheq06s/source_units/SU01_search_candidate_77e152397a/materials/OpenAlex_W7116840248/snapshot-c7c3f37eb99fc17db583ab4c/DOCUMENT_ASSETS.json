            },
            "text": "Functional Role in Immunity"
          },
          {
            "block_id": "block-ee6151194c09ce8bf015",
            "locator": {
              "col_index": 4,
              "col_span": 1,
              "is_header": true,
              "row_index": 0,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/thead[1]/tr[1]/th[5]"
            },
            "text": "Key Surface Receptors"
          },
          {
            "block_id": "block-1ef5d466b635b3f25ff8",
            "locator": {
              "col_index": 0,
              "col_span": 1,
              "is_header": false,
              "row_index": 1,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[1]/td[1]"
            },
            "text": "Naïve T Cell [15,54]"
          },
          {
            "block_id": "block-edeb343396d2032eb0b5",
            "locator": {
              "col_index": 1,
              "col_span": 1,
              "is_header": false,
              "row_index": 1,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[1]/td[2]"
            },
            "text": "OXPHOS, fatty acid oxidation (FAO)"
          },
          {
            "block_id": "block-75721a571d7b25ff69be",
            "locator": {
              "col_index": 2,
              "col_span": 1,
              "is_header": false,
              "row_index": 1,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[1]/td[3]"
            },
            "text": "Low nutrient uptake, energy-efficient, quiescent, high AMPK and low mTOR activity"
          },
          {
            "block_id": "block-858b3b28daddd366503e",
            "locator": {
              "col_index": 3,
              "col_span": 1,
              "is_header": false,
              "row_index": 1,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[1]/td[4]"
            },
            "text": "Long-term surveillance, maintenance of diversity"
          },
          {
            "block_id": "block-c8527a64d8070c16b1b3",
            "locator": {
              "col_index": 4,
              "col_span": 1,
              "is_header": false,
              "row_index": 1,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[1]/td[5]"
            },
            "text": "CD45RA, CD62L, CCR7, TCR (low activation)"
          },
          {
            "block_id": "block-0312917e1a7f47b51093",
            "locator": {
              "col_index": 0,
              "col_span": 1,
              "is_header": false,
              "row_index": 2,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[2]/td[1]"
            },
            "text": "Activated Effector T Cell [15,54]"
          },
          {
            "block_id": "block-d747a93bc254591404f0",
            "locator": {
              "col_index": 1,
              "col_span": 1,
              "is_header": false,
              "row_index": 2,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[2]/td[2]"
            },
            "text": "Aerobic glycolysis, increased glutaminolysis"
          },
          {
            "block_id": "block-934676d1cf2df0b8dd70",
            "locator": {
              "col_index": 2,
              "col_span": 1,
              "is_header": false,
              "row_index": 2,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[2]/td[3]"
            },
            "text": "High nutrient (glucose, glutamine) uptake, strong anabolic drive, high mTOR activity, rapid biosynthesis"
          },
          {
            "block_id": "block-4997fc2c32701407a0eb",
            "locator": {
              "col_index": 3,
              "col_span": 1,
              "is_header": false,
              "row_index": 2,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[2]/td[4]"
            },
            "text": "Proliferation, cytokine secretion, cancer cell killing"
          },
          {
            "block_id": "block-592772096245fd8f5c34",
            "locator": {
              "col_index": 4,
              "col_span": 1,
              "is_header": false,
              "row_index": 2,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[2]/td[5]"
            },
            "text": "CD25 (IL-2Rα), CD28, GLUT1, CD98, CD69, TCR (high activation)"
          },
          {
            "block_id": "block-81f653b46d402712a44c",
            "locator": {
              "col_index": 0,
              "col_span": 1,
              "is_header": false,
              "row_index": 3,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[3]/td[1]"
            },
            "text": "Central Memory T Cell [55,56,57]"
          },
          {
            "block_id": "block-c64db1f45cda38fac91a",
            "locator": {
              "col_index": 1,
              "col_span": 1,
              "is_header": false,
              "row_index": 3,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[3]/td[2]"
            },
            "text": "OXPHOS, FAO, preserved glycolytic capacity"
          },
          {
            "block_id": "block-0924979011060aaeb412",
            "locator": {
              "col_index": 2,
              "col_span": 1,
              "is_header": false,
              "row_index": 3,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[3]/td[3]"
            },
            "text": "Mitochondrial remodeling, increased spare respiratory capacity, energy flexibility"
          },
          {
            "block_id": "block-db196921a9fdbeeb1eec",
            "locator": {
              "col_index": 3,
              "col_span": 1,
              "is_header": false,
              "row_index": 3,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[3]/td[4]"
            },
            "text": "Long-term survival, rapid reactivation, migration"
          },
          {
            "block_id": "block-08ee7b28278dab340f92",
            "locator": {
              "col_index": 4,
              "col_span": 1,
              "is_header": false,
              "row_index": 3,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[3]/td[5]"
            },
            "text": "CD45RO, CD62L, CCR7, IL-7Rα (CD127), TCR"
          },
          {
            "block_id": "block-a5c32337194d2560f2c8",
            "locator": {
              "col_index": 0,
              "col_span": 1,
              "is_header": false,
              "row_index": 4,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[4]/td[1]"
            },
            "text": "Effector Memory T Cell [55,56,57]"
          },
          {
            "block_id": "block-fb0ad2d099c548dfb678",
            "locator": {
              "col_index": 1,
              "col_span": 1,
              "is_header": false,
              "row_index": 4,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[4]/td[2]"
            },
            "text": "Mixed OXPHOS and glycolysis"
          },
          {
            "block_id": "block-9aede35b3efa3ecba2e1",
            "locator": {
              "col_index": 2,
              "col_span": 1,
              "is_header": false,
              "row_index": 4,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[4]/td[3]"
            },
            "text": "Intermediate metabolic activity, poised for effector function"
          },
          {
            "block_id": "block-1842d8daf8dd29fcb166",
            "locator": {
              "col_index": 3,
              "col_span": 1,
              "is_header": false,
              "row_index": 4,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[4]/td[4]"
            },
            "text": "Immediate protection at peripheral tissues"
          },
          {
            "block_id": "block-2b26d15534999ac8db0d",
            "locator": {
              "col_index": 4,
              "col_span": 1,
              "is_header": false,
              "row_index": 4,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[4]/td[5]"
            },
            "text": "CD45RO, lower CD62L, CXCR3, TCR"
          },
          {
            "block_id": "block-5e6085734faa49d7306c",
            "locator": {
              "col_index": 0,
              "col_span": 1,
              "is_header": false,
              "row_index": 5,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[5]/td[1]"
            },
            "text": "Exhausted/Dysfunctional T Cell [58,59,60]"
          },
          {
            "block_id": "block-be8efdb4d9344b03ab14",
            "locator": {
              "col_index": 1,
              "col_span": 1,
              "is_header": false,
              "row_index": 5,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[5]/td[2]"
            },
            "text": "Impaired glycolysis and OXPHOS, ADO accumulation, disrupted mTOR signaling"
          },
          {
            "block_id": "block-86033710529fe77c7041",
            "locator": {
              "col_index": 2,
              "col_span": 1,
              "is_header": false,
              "row_index": 5,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[5]/td[3]"
            },
            "text": "Mitochondrial fragmentation, low ATP production, bioenergetic crisis, upregulation of inhibitory pathways"
          },
          {
            "block_id": "block-6692d31c6864351f484e",
            "locator": {
              "col_index": 3,
              "col_span": 1,
              "is_header": false,
              "row_index": 5,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[5]/td[4]"
            },
            "text": "Dysfunction, poor proliferation, loss of cytotoxicity"
          },
          {
            "block_id": "block-9e22941a93a509ee1cce",
            "locator": {
              "col_index": 4,
              "col_span": 1,
              "is_header": false,
              "row_index": 5,
              "row_span": 1,
              "xml_id": null,
              "xml_path": "/article/body[1]/sec[3]/sec[4]/table-wrap[1]/table[1]/tbody[1]/tr[5]/td[5]"
            },
            "text": "PD-1, TIM-3, LAG-3, CTLA-4, A2A adenosine receptor"
          }
        ]
      },
