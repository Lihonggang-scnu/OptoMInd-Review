{
  "additions": [
    {
      "studies": [
        {
          "contribution": "提供UC Health多中心大样本队列数据，对比术后暴露（HR 1.27）与术前暴露（HR 1.04）的生存差异，界定ICI启动前后30-90天为抗生素干扰的高危窗口，论证微生物完整性在免疫启动期的脆弱性。",
          "source_handle": "P0575"
        },
        {
          "contribution": "基于印度Tata纪念医院真实世界审计数据，展示>10天疗程导致OS骤降（2.8 vs 8.8个月），建立抗生素暴露强度与疗效受损的正向剂量-反应关系，提示广谱破坏的累积效应。",
          "source_handle": "P0061"
        },
        {
          "contribution": "引入HCC Meta分析（n=1056亚洲人群）阴性结果，结合肝硬化基线免疫抑制与肠肝轴紊乱背景，解释抗生素扰动在此类人群中不转化为明确生存劣势，警示单一机制模型的外推边界。",
          "source_handle": "P0275"
        }
      ],
      "unit_key": "Ch4:1"
    },
    {
      "studies": [
        {
          "contribution": "整合33项研究Meta分析数据（OS HR=1.31, PFS HR=1.30），量化PPI使用与ICI生存结局的负相关，强调基线或ICI前60天内使用时窗的决定性作用，确立PPI作为独立预后不良因子的地位。",
          "source_handle": "P0339"
        },
        {
          "contribution": "揭示化疗结束至ICI开始间隔<1年可消除PPI负面影响（HR 1.09），并报告PPI使用者乳酸杆菌科和韦荣球菌属相对丰度较高，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。",
          "source_handle": "P0537"
        },
        {
          "contribution": "引用FAERS自发报告系统信号显示ICI+PPI联用显著升高肝胆疾病（RORadj 7.10）、皮肤及代谢障碍的报告率，对比H2B未达显著生存影响的观察，提供临床用药降级与监测建议的实证依据。",
          "source_handle": "P0286"
        }
      ],
      "unit_key": "Ch4:2"
    },
    {
      "studies": [
        {
          "contribution": "利用NSCLC前瞻性队列（N=147）宏基因组数据，展示高脂低淀粉饮食（HR 0.37）与Ruminococcus lactaris等有益菌富集的关联，对比P0390黑色素瘤队列中高纤维饮食的PFS获益，确立饮食底物对菌群功能的定向塑造作用。",
          "source_handle": "P0155"
        },
        {
          "contribution": "剖析商业益生菌的矛盾证据，指出非标准化益生菌补充导致抗PD-1反应受损（IFN-γ+ CTL频率降低），结合P0249 Avatar模型证明饮食成分可绕过定植障碍直接驱动代谢输出，论证盲目补充的风险与精准靶向的必要性。",
          "source_handle": "P0390"
        },
        {
          "contribution": "简述昼夜节律紊乱与心理压力通过HPA轴激活、LPS易位及SCFAs下降间接调制免疫稳态的潜在路径，指出生活方式干预需纳入多维宿主状态评估框架，避免单一营养视角的局限。",
          "source_handle": "P0224"
        }
      ],
      "unit_key": "Ch4:3"
    }
  ],
