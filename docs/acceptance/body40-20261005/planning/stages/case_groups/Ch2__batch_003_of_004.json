        {
          "contribution": "提供乳酸杆菌（LGG）及特定菌株通过激活cGAS-STING通路促进树突状细胞成熟并增强CD8+ T细胞浸润的实验证据，补充先天识别到适应性启动的分子链条。",
          "source_handle": "P0333"
        },
        {
          "contribution": "阐述微生物相关分子模式（MAMPs）如何通过TLR/NOD2受体刺激抗原呈递细胞，驱动Th1极化与免疫应答启动，为树突状细胞成熟机制提供跨癌种的背景框架。",
          "source_handle": "P0309"
        }
      ],
      "unit_key": "Ch2:1"
    },
    {
      "studies": [
        {
          "contribution": "揭示MEP通路代谢物HMBPP特异性激活Vδ2 T细胞，以及核黄素通路产物5-OP-RU诱导MAIT细胞增殖的机制，补充非经典T细胞亚群在菌群介导的抗肿瘤免疫中的功能证据。",
          "source_handle": "P0444"
        },
        {
          "contribution": "提供肠道微生物表位与宿主自身免疫或肿瘤抗原发生交叉反应的实证数据，阐明分子模拟介导长期疗效与免疫相关不良事件的双刃剑效应，丰富适应性免疫启动的机制维度。",
          "source_handle": "P0462"
        }
      ],
      "unit_key": "Ch2:2"
    },
    {
      "studies": [
        {
          "contribution": "详述髓系衍生抑制细胞（MDSCs）、肿瘤相关巨噬细胞（TAMs）及代谢重编程（缺氧、乳酸积累）构建免疫抑制微环境的机制，补充髓系细胞重编程与屏障损伤关联的病理背景。",
          "source_handle": "P0362"
        },
        {
          "contribution": "展示特定共生菌（如Barnesiella intestinihominis）通过招募T细胞增强化疗/免疫疗效，而病原菌（如具核梭杆菌）抑制NK细胞功能的案例，补充微生物易位至次级淋巴器官前的局部髓系调控证据。",
          "source_handle": "P0438"
        }
      ],
      "unit_key": "Ch2:3"
    },
    {
      "studies": [
        {
          "contribution": "提供下呼吸道微生物组独立于肠道调节NSCLC ICI疗效的证据，识别出Bacillus为有益菌而Sphingomonas/Sediminibacterium为有害菌，补充部位特异性微生物组对实体瘤疗效影响的对照案例。",
          "source_handle": "P0352"
        },
        {
          "contribution": "系统综述肿瘤内驻留微生物群（非肠道）通过抗原呈递、Th1极化及基质重塑调节局部免疫的三种机制，补充肿瘤局部微环境与全身肠道菌群效应的空间对比视角。",
          "source_handle": "P0457"
        }
      ],
