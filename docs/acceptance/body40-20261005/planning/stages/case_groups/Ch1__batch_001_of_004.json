{
  "additions": [
    {
      "studies": [
        {
          "contribution": "提供NSCLC背景下跨癌种（黑色素瘤、肾癌）的微生物特征清单，指出特定菌属富集与疗效正相关但存在阈值风险，支撑综述中“跨癌种共性信号与情境依赖性”的论述。",
          "source_handle": "P0096"
        },
        {
          "contribution": "揭示微生物标志物的肠型特异性（如E2肠型中Collinsella与响应相关），解释为何单一物种难以成为普适性生物标志物，为“无通用标志物”的统计依据提供群落背景视角。",
          "source_handle": "P0170"
        },
        {
          "contribution": "证明菌株级签名在联合免疫治疗中具有泛癌种预测力，但在单药队列中失效，直接支撑“治疗方案严格修饰微生物效应方向”及“缺乏普适性单一标志物”的核心论点。",
          "source_handle": "P0015"
        }
      ],
      "unit_key": "Ch1:1"
    },
    {
      "studies": [
        {
          "contribution": "量化抗酸药（PPIs）使用导致链球菌增加及短PFS的关联，并对比化疗预处理对微生物组的持久影响，支撑“外部药物暴露具有明确时间窗特异性与剂量依赖性”的分析任务。",
          "source_handle": "P0123"
        },
        {
          "contribution": "汇总抗生素、PPIs及类固醇暴露对ICI预后的负面效应量，特别强调抗生素使用时机（治疗后vs治疗前）的差异，为讨论指示偏倚高估负面效应及需标准化校正提供实证对照。",
          "source_handle": "P0157"
        },
        {
          "contribution": "展示PPI使用者与非使用者在微生物动态轨迹上的显著差异（如Streptococcus thermophilus变化方向相反），说明合并用药可重塑菌群演化路径，需在关联分析中作为关键协变量严格校正。",
          "source_handle": "P0033"
        }
      ],
      "unit_key": "Ch1:2"
    },
    {
      "studies": [
        {
          "contribution": "通过贝叶斯模型证实基线后微生物SGBs的持续积累轨迹比静态丰度更能区分长/短PFS患者，直接支撑“纵向动态变化优于单次基线采样”的方法学主张。",
          "source_handle": "P0033"
        },
        {
          "contribution": "提供小规模前瞻性配对样本数据，显示响应者伴随显著的微生物组波动（如梭菌属增加），而无响应者相对稳定或恶化，为“病原菌清除或定植失败反映真实疗效轨迹”提供早期实证。",
          "source_handle": "P0134"
        },
        {
          "contribution": "记录ICI治疗期间循环Tregs减少与基线拟杆菌属丰度的纵向关联，提示微生物组可能通过设定免疫稳态“临界点”影响疗效，补充了纵向监测中免疫-微生物互作的动态机制线索。",
          "source_handle": "P0098"
        }
      ],
      "unit_key": "Ch1:3"
    },
    {
      "studies": [
        {
          "contribution": "系统梳理FMT克服耐药的初步临床数据（ORR约20%）及机器学习预测性能，明确指出当前缺乏Phase III RCT证据且方法学异质性大，支撑“证据阶梯分布与转化边界”的批判性评估。",
          "source_handle": "P0026"
        },
        {
          "contribution": "汇总FMT及益生菌干预的早期临床试验结果，强调多数证据来自病例报告或小样本系列研究，安全性与长期维持效果尚不确定，用于界定概念验证阶段向常规临床应用转化的现实障碍。",
          "source_handle": "P0144"
        },
        {
          "contribution": "对比FMT、益生菌与饮食干预的临床效果差异，指出普通益生菌使用结果高度依赖菌株特异性且部分研究显示无效甚至有害，为讨论干预策略的异质性及安全性信号的情境依赖性提供核心素材。",
          "source_handle": "P0161"
        }
      ],
      "unit_key": "Ch1:4"
    }
  ],
