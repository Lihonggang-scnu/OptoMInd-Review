    {
      "atom_id": "atom::b8a5a05a2c4c46c244939963",
      "source_handle": "P0588",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用单中心、随机对照试验设计。纳入符合RECIST v1.1标准的晚期实体瘤患者，按1:1比例随机分组。试验组接受标准免疫治疗联合肌苷（0.2g tid），对照组接受标准免疫治疗。疗效评估每6周进行一次，主要终点为ORR，次要终点为DCR、OS和PFS。使用Kaplan-Meier法计算生存曲线，Cox比例风险模型进行多因素分析，并对不同亚组（如肿瘤类型、炎症指标、转移部位）进行探索性分析以识别潜在受益人群。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::93c6a2bc5ca1c43be2fd189fb473aa761e120adadfbb9d47d57314ce2ef6769a",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::33a5c9e4d60f2557fa054a13",
      "source_handle": "P0588",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肌苷联合ICI治疗晚期实体瘤的首个随机对照临床II期数据，证实了肌苷在延长PFS方面的统计学显著性，并为“肠道代谢物调节免疫治疗”假说提供了初步临床支持。",
        "limits": "单中心设计导致样本量有限（每组86人）；非盲法设计可能存在偏倚；多肿瘤类型混合导致统计效能分散，OS结果受后续治疗影响较大；亚组分析为探索性，存在多重比较问题，需外部验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::93c6a2bc5ca1c43be2fd189fb473aa761e120adadfbb9d47d57314ce2ef6769a",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ]
    },
