          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::e58ae790bec32ee11a9df4c4",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用粪便微生物移植（FMT）联合ICI",
        "finding": "在多种难治性实体瘤（黑色素瘤、NSCLC、MSI-H癌症等）中显示出一致的积极信号，ORR普遍较高（20%-77%），且安全性总体可控，提示其可能具有广谱抗肿瘤活性。"
      },
      "role": "evidence",
      "origins": [
