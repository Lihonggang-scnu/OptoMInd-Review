            "1"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::36d5718059c065b3b3c074a7",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "膀胱癌和小肠癌小鼠模型",
        "finding": "肠道菌群产生的肌苷（Inosine）可通过A2aR-cAMP-PKA通路促进Th1分化，增加IFN-γ+ CD4+和CD8+ T细胞浸润，增强抗CTLA-4和抗PD-L1疗效；但在缺乏外源IFN-γ时可能抑制Th1分化，且需CpG共刺激。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::1e1bdc01a956b0ad950e688c",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠肿瘤模型及部分临床数据",
        "finding": "氧化三甲胺（TMAO）通过激活PERK介导的内质网应激和Gasdermin-E介导的细胞焦亡，增强CD8+ T细胞介导的抗肿瘤免疫，提高抗PD-1疗效；高血浆TMAO水平与较长PFS相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::93ea60f675ed97e4c3550dac",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "胰腺导管腺癌小鼠模型 vs. 结肠癌/乳腺癌模型",
        "finding": "乳酸杆菌来源的吲哚类色氨酸代谢物（如Indoles）在胰腺癌中通过激活TAMs上的A2aR抑制CD8+ T细胞释放IFN-γ，抑制免疫；而双歧杆菌产生的ILA可诱导结肠癌细胞凋亡，IPA可抑制乳腺癌生长，显示出色氨酸代谢物效应的异质性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
