    {
      "atom_id": "atom::f5b4029a4db9047fd36c2c50",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统性文献回顾与综合的方法。作者检索并整理了从临床前研究到临床研究的相关证据，按照代谢物的化学类别（SCFAs、肌苷、TMAO、色氨酸衍生物、胆汁酸及其他分子）进行分类叙述。对于每一类代谢物，综述了其在动物模型和临床试验中的观察结果，归纳了其作用的免疫细胞类型（如CD8+ T细胞、Treg、巨噬细胞等）及关键信号通路（如HDAC、mTOR、GPRs、AhR、NOD2等）。同时，对比分析了同一代谢物在不同治疗背景下的矛盾发现，以评估其复杂性和情境依赖性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::596759d47ba6a21459261d96",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统性地汇总了肠道微生物代谢物调节ICIs疗效的多维证据，特别是揭示了同一代谢物（如SCFAs）在不同ICIs靶点（PD-1 vs CTLA-4）下可能具有截然相反的免疫调节作用，强调了治疗策略的情境依赖性。",
        "limits": "作为综述，依赖于已发表研究的总结，未提供新的原始实验数据；部分机制（如肌苷的双重作用、特定代谢物的精确剂量效应）仍需更多临床验证；未能涵盖所有可能的微生物代谢物种类。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::e6a84e8e4a4530184c544641",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受PD-1/PD-L1阻断治疗的实体瘤患者及小鼠模型",
        "finding": "粪便中高浓度的短链脂肪酸（SCFAs，如丙酸、丁酸、戊酸）与较长的无进展生存期（PFS）及更好的治疗反应相关；SCFAs通过抑制HDAC、激活GPRs和调节mTOR通路增强CD8+ T细胞的细胞毒性和分化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::4ccaa4344a587186290f3b5e",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受CTLA-4阻断治疗的转移性黑色素瘤患者及小鼠模型",
        "finding": "血清中高浓度的丁酸和丙酸与较差的ICIs疗效负相关；丁酸抑制记忆T细胞的积累和树突状细胞上CD80/CD86的上调，增加Treg比例，从而削弱抗CTLA-4疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
