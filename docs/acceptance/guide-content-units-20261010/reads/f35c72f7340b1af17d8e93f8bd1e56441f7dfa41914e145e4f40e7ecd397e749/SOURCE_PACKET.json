    {
      "atom_id": "atom::34fba25ca01d8cc9a99d4b85",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性队列设计。收集接受ICI治疗的癌症患者粪便样本。使用16S rRNA测序和MGS进行微生物组分析。定义七个基于文献的预设细菌组（包括致病菌组和Ruminococcaceae等）。使用多种统计工具（ANCOM-BC, LinDA, MaAsLin2, ALDEx2）进行差异丰度分析，以寻找跨工具一致的结果。通过逻辑回归和线性混合效应模型评估细菌组与严重irAE的关联，并校正ICI类型。比较有/无严重irAE患者在基线、治疗早期、irAE发作时及免疫抑制后的微生物组特征。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::81d1197be7aa905b288e7880",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了大样本（195例）前瞻性数据，证实了Ruminococcaceae科的动态减少与严重irAE的相关性，特别是在irAE发作时的显著降低。",
        "limits": "基线致病菌组的高RA关联在多重检验校正后不显著；部分低丰度菌群的差异结果需谨慎解读；无法区分菌株特异性效应；样本量对于解析复杂的多重交互作用仍显不足。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::c2a3cf5d3e5f4ec9f74e46c7",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线（ICI治疗前）",
        "finding": "发生严重irAE的患者中，预设的致病菌组（pathobionts）平均RA显著高于未发生者（8.2% vs 4.8%; OR 1.40; 95%CI 1.07-1.87），但该关联在多重检验校正后失去统计学显著性（校正p=0.059）。Ruminococcaceae科在两组间基线RA无显著差异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::945c11493df532310035578f",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "治疗早期（从基线到第2周期）",
        "finding": "发生严重irAE的患者中，Ruminococcaceae科的RA下降幅度显著大于未发生者（交互作用粗p=0.018，校正p=0.123）。然而，发生组内的下降本身未达到统计学显著性（粗p=0.078）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
