            "1"
          ]
        }
      ]
    },
    {
      "atom_id": "atom::4a8e73e66868ae4bfdc82e5a",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "严重irAE发作时",
        "finding": "与所有其他时间点相比，发生严重irAE的患者中Ruminococcaceae科、Ruminococcus属以及R. bromii和R. callidus物种的RA显著降低。Haemophilus属及其种H. parainfluenzae在irAE发作时的RA显著升高。"
      },
