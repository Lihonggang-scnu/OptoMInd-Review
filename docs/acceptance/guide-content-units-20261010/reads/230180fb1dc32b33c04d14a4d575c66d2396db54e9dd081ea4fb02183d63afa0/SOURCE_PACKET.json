    {
      "atom_id": "atom::370e1997ec04811460303373",
      "source_handle": "P0600",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "抗PD-1治疗后出现irAEs的患者 vs 未出现irAEs的患者",
        "finding": "微生物组成显著不同（P=0.001）。irAE患者中双歧杆菌（Bifidobacterium）、粪杆菌属（Faecalibacterium）和阿加索细菌属（Agathobacter）丰度较低，而红球菌属（Erysipelatoclostridium）丰度较高。主要丁酸产生菌总丰度在irAE患者中更低（P=0.007）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::764ddb58c7d47204119c72b59b439669e230c3e9d3e77cfd06d6412172c36ce1",
          "field_path": [
