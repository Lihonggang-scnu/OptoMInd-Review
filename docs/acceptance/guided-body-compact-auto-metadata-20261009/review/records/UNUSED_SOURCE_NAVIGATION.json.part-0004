      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅展示关联，不直接提供分子机制；未区分不同肿瘤类型间的差异；未提供irAEs的具体效应量数据。",
            "contribution": "提供了特定细菌属（Akkermansia, Bifidobacterium, Faecalibacterium）富集与ICIs疗效提升（OS, PFS）的正向关联证据；提供了抗生素暴露与疗效下降的负向关联证据；提供了FMT提高ORR的证据。",
            "facet_id": "F1"
          },
          "atom_id": "atom::4d515e81ecce4092cc77829d",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "本综述本身未深入阐述具体的分子或细胞机制（如抗原呈递、T细胞浸润等），因此不能直接用于回答机制问题，只能作为机制研究的动机或验证目标。",
            "contribution": "虽然主要关注临床结局关联，但通过指出特定菌属和多样性的作用，间接指向了可能的机制路径（如免疫激活）。",
            "facet_id": "F2"
          },
          "atom_id": "atom::6b402a143e9e52a21f1a8a4b",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "确认肠道微生物群是ICIs疗效的关键决定因素，且存在可量化的关联。"
          },
          "atom_id": "atom::e78858b2e1123d4265b08dbb",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "抗生素使用的负面效应（HR 1.84）与有益菌的正面效应形成对比。"
          },
          "atom_id": "atom::f23e8af78b1f515d19225376",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究为荟萃分析结果，反映的是群体水平的统计关联，不能直接推断个体因果机制。",
          "atom_id": "atom::22ade239973f63ac1cc2ad87",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "摘要未提供各纳入研究间异质性（I^2等）的具体数值，解读效应量时需考虑研究间差异。",
          "atom_id": "atom::0f416788f290cefd8da15ac8",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "未明确说明是否针对特定实体瘤进行了分层分析，若综述关注特定癌种，需核实此处的结论是否适用于所有实体瘤。",
          "atom_id": "atom::db09b0238c5e110876ebe550",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "irAEs的结果在摘要中仅定性提及“impact”，缺乏具体OR值和置信区间，无法用于精确量化毒性风险。",
          "atom_id": "atom::751f28ea1ac600e31a54ae09",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "特定细菌属富集（Akkermansia muciniphila, Bifidobacterium longum, Faecalibacterium prausnitzii）",
            "finding": "与改善的总生存期（HR 0.62, 95% CI 0.51-0.76）和无进展生存期（HR 0.69, 95% CI 0.55-0.83）显著相关。"
          },
          "atom_id": "atom::865c3fce85bd3a3a7bb8c697",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "在ICI治疗前或期间暴露于抗生素",
            "finding": "与较差的总生存期相关（HR 1.84, 95% CI 1.45-2.34）。"
          },
          "atom_id": "atom::55e5fca6e95dbafa7b97ba97",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "接受来自反应者的FMT",
            "finding": "表现出更高的客观缓解率（OR 2.91, 95% CI 1.48-5.73）。"
          },
          "atom_id": "atom::afa5de82594d6caa0498c1c3",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "比较响应者与无响应者",
            "finding": "响应者的微生物多样性指数 consistently higher（持续更高）。"
          },
          "atom_id": "atom::8304fac36c52270463706836",
          "chapter_id": "Ch1"
        }
      ],
