        },
        {
          "atom_id": "atom::879a32130d48905cf03cb52c",
          "source_handle": "P0433",
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "胰腺导管腺癌（PDAC）小鼠模型及临床观察",
            "finding": "乳酸杆菌产生的TMAO促进巨噬细胞向M1型极化，增强效应T细胞反应并提高ICI疗效；而高表达AhR的巨噬细胞与PDAC患者较差的免疫治疗反应相关。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::f2a7f6253e7390084ec754fd"
          ],
          "author_chapter_id": "Ch7",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0433"
        },
        {
          "atom_id": "atom::6915227a4c4ed95c31ceef17",
          "source_handle": "P0433",
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "晚期胃肠道癌症患者接受抗PD-1/PD-L1治疗",
            "finding": "粪便中较高浓度的乙酸、丙酸、丁酸和戊酸（SCFAs）以及与PD-1抑制剂疗效显著延长PFS相关。"
          },
          "role": "evidence",
          "snapshot_ids": [
