            "key_findings"
          ],
          "value": {
            "conditions": "2013-2025年文献计量学与临床试验数据",
            "finding": "研究产出呈指数增长，2018年标志性人类队列研究后出现转化激增，临床试验启动在2021年达到峰值。主题从早期的机制探索和特定药物关注转向以FMT、微生物代谢物和多组学为核心的临床干预导向。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::09453c46fe36046e2b9f48ff"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0364"
        },
        {
          "atom_id": "atom::cc17e4f3c24c70c94dd6fc02",
          "source_handle": "P0364",
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "跨队列代表性临床及临床前研究（n=8）",
            "finding": "响应者相关的微生物群表现出支持代谢和免疫有利的特征，如短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏；而非响应者则显示失调和免疫抑制特征。尽管具体菌种不同，但免疫通路呈现功能趋同。"
          },
