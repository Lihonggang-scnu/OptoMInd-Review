      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅基于定性综合，未提供定量效应估计；主要涵盖黑色素瘤、NSCLC等实体瘤，但未详细区分所有亚型的具体差异。",
            "contribution": "提供了微生物群影响ICI疗效的临床证据图谱，指出响应者相关菌群虽物种各异，但均富集于免疫调节共生菌。",
            "facet_id": "F1"
          },
          "atom_id": "atom::3e1984b3ca8b725e905ca262",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "机制解释主要基于文献回顾和概念框架，部分机制（如inosine的作用）主要来自临床前模型，其在人体中的确切贡献尚需更多验证；因果关系受限于观察性研究的混杂因素。",
            "contribution": "详细阐述了微生物-ICI相互作用的潜在机制，包括短链脂肪酸产生、树突状细胞成熟、Th1极化和CD8+ T细胞激活等通路。",
            "facet_id": "F2"
          },
          "atom_id": "atom::3b7a2ae7cc5b05daaa11d775",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "文献计量学显示的主题演变（从机制到干预）、临床试验活动的时间线（2018-2021激增）、主要干预策略（FMT为主，益生菌为辅）。"
          },
          "atom_id": "atom::f4f1140eb39545b899dede98",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "文章讨论了抗生素、PPI、皮质类固醇、饮食、肿瘤类型等混杂因素对微生物群和ICI疗效的影响，以及反向因果的可能性。"
          },
          "atom_id": "atom::575a570443c26814fbfe0163",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该论文的“功能趋同”结论是基于定性综合提出的假设生成性模型，并非经过严格统计验证的普适规律，需谨慎引用。",
          "atom_id": "atom::41fca2713c6e913cb79761ee",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "引用的机制证据多来自临床前模型或早期临床队列，其在广泛人群中的适用性和因果效力尚未完全确立。",
          "atom_id": "atom::77220f10b3d35c7683606ace",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "文献计量学反映的是学术关注度，不完全等同于临床疗效或生物学真实性。",
          "atom_id": "atom::bb2165a93fa1f992e9da9f2a",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "2013-2025年文献计量学与临床试验数据",
            "finding": "研究产出呈指数增长，2018年标志性人类队列研究后出现转化激增，临床试验启动在2021年达到峰值。主题从早期的机制探索和特定药物关注转向以FMT、微生物代谢物和多组学为核心的临床干预导向。"
          },
          "atom_id": "atom::f70f007dd2cadd7ff269cb8e",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "跨队列代表性临床及临床前研究（n=8）",
            "finding": "响应者相关的微生物群表现出支持代谢和免疫有利的特征，如短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏；而非响应者则显示失调和免疫抑制特征。尽管具体菌种不同，但免疫通路呈现功能趋同。"
          },
          "atom_id": "atom::cc17e4f3c24c70c94dd6fc02",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "概念框架综合",
            "finding": "提出了一个统一框架，将宿主因素、微生物组成、代谢物信号和免疫反应联系起来，表明微生物-ICI相互作用由功能趋同通路驱动，而非单一菌种。"
          },
          "atom_id": "atom::9b134360649fc3d7a4fc5945",
          "chapter_id": "Ch1"
        }
      ],
