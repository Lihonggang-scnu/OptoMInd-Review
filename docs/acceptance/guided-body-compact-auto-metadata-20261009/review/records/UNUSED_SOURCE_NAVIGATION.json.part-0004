      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "结果主要基于Ashray_2024（罕见实体瘤+CICB）和黑色素瘤队列。跨队列泛化仅在CICB背景下成立，单药背景下的泛化性差，因此不能推广为通用的单一微生物标志物。",
            "contribution": "提供了基因水平微生物丰度作为预测生物标志物的实证数据，证明其在CICB治疗下优于分类学特征。具体识别出在响应者中富集的Rikenellaceae, Ruminococcaceae, Lachnospiraceae家族，以及在非响应者中富集的Desulfovibrionaceae, Bacteroidaceae家族。",
            "facet_id": "F1"
          },
          "atom_id": "atom::65503468d23f0b34c349344a",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这些是相关性分析（特征归因后的富集），并非因果实验验证。机制解释依赖于作者的理论推导，需注明为假设性关联。",
            "contribution": "通过KEGG和GO富集分析揭示了潜在机制：响应者中富集的nitrilase基因参与氮代谢和T细胞调节；非响应者中富集的lipoic acid metabolism可能通过调节氧化应激影响免疫。年龄分层显示老年响应者与Bifidobacterium相关，年轻响应者与UBA11524等相关。",
            "facet_id": "F2"
          },
          "atom_id": "atom::aa57ec061e37cb85469a506b",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "BioP-VAE模型架构，整合蛋白序列嵌入（ESM-2）与宏基因组RPKM特征，使用集成梯度进行可解释性分析。"
          },
          "atom_id": "atom::1c7a36b342d7405117ddef9e",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "跨队列验证结果显示，基于CICB训练的模型在单药测试中失效，反之亦然；不同年龄组的关键预测菌属不同。"
          },
          "atom_id": "atom::dcdc4ba1b0aa608551e38585",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究的泛化性结论严格限定在治疗策略上：CICB背景下的基因特征具有跨癌种一致性，但单药背景下的特征不具备同等泛化性。",
          "atom_id": "atom::cfb9a770641f543a9e72f1b5",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "‘基因水平优于分类学水平’的结论基于特定自定义参考基因组集，其他研究使用的标准数据库可能得出不同结果。",
          "atom_id": "atom::4eadeeab1837b7eed9b0c114",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "年龄分层的结果提示微生物-免疫互作的复杂性，但不能直接推断因果关系。",
          "atom_id": "atom::705c1efd15412390628a0aaf",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Ashray_2024队列（CICB治疗，罕见实体瘤）内部验证",
            "finding": "整合生物先验知识的过滤后RPKM特征在预测ICI反应中表现最佳，平均AUC为0.89，准确率为92.68%，显著优于所有层级的分类学丰度特征（最高AUC 0.72）。"
          },
          "atom_id": "atom::a91acbcf0d7d10e3af6178ee",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "跨队列评估（训练集与测试集分离）",
            "finding": "在CICB治疗背景下，模型展现出一定的跨队列泛化能力（Ashray_2024训练，Frankel_2017 CICB子集测试，AUC=0.88）。但在单药治疗队列（Lee_2022, Matson_2018）之间或向单药子集的泛化能力较差（AUC < 0.60-0.64）。"
          },
          "atom_id": "atom::e1c25a7f5e0305dddaab98ac",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "单药治疗队列内部验证",
            "finding": "在抗PD-1/CTLA-4单药治疗的内部队列中，BioP-VAE实现了极高的预测性能，平均AUC达到0.97。"
          },
          "atom_id": "atom::9804a41fd821fa289bc29c6a",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "12个月无进展生存期（PFS）预测",
            "finding": "在Ashray_2024队列中，整合生物先验知识的RPKM特征预测12个月PFS的AUC为0.88，优于仅使用临床因素或传统分类学特征。"
          },
          "atom_id": "atom::0982efcdb938bbab4f561a53",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "年龄分层分析（>60岁 vs ≤60岁）",
            "finding": "年轻患者的预测性能略高于老年患者（AUC 0.91 vs 0.87）。归因分析显示不同年龄组的贡献微生物存在差异：老年响应者中Bifidobacterium属贡献为正，而年轻响应者中UBA11524等未培养属贡献显著；非响应者中两组的特征分布也截然不同。"
          },
          "atom_id": "atom::24da6e6e61b40253d81d17e4",
          "chapter_id": "Ch1"
        }
      ],
