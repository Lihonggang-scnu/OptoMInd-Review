      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "介绍了NSCLC中ICI耐药的多维度机制，包括内在肿瘤基因改变、局部TME抑制和系统性因素。"
          },
          "atom_id": "atom::fd45b37845cc9232f8771c98",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "讨论了PD-L1、TMB、空间组学和液体活检等生物标志物的现状、局限性和整合需求。"
          },
          "atom_id": "atom::159d56d3ae0242026c9cb9ba",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "区分了III期支持的联合疗法（如双免疫、免疫+抗血管）与早期探索性疗法（如微生物组调节、IDO抑制）。"
          },
          "atom_id": "atom::ca50e4620e570197a4e95208",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅限NSCLC人群；关联多为观察性，因果机制未详述；Fusobacterium的作用在其他癌种更明确，此处仅为对比提示。",
            "contribution": "提供了NSCLC队列中与ICI疗效相关的特定肠道微生物菌群信息：Akkermansia muciniphila、Bifidobacterium spp. 和 Ruminococcus 被报道有助于促进有利的免疫微环境；而 Fusobacterium 的关联在结直肠癌中更强，在NSCLC中需谨慎外推。",
            "facet_id": "F1"
          },
          "atom_id": "atom::21e41420c3204126923b02a4",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "机制描述较为概括，未深入具体的微生物-宿主分子互作细节；主要基于综述转述的其他研究结果；强调需要前瞻性验证。",
            "contribution": "阐述了系统性因素（包括微生物组、营养状态、全身炎症）如何作为TME介导耐药的一部分影响ICI疗效。指出微生物组特征可能通过塑造有利的免疫微环境来增强ICI反应，但同时也强调了这种关联需要NSCLC特异性数据集的支持，且目前微生物组干预（如FMT、益生菌）仍属探索性阶段，缺乏标准化评估和安全监测。",
            "facet_id": "F2"
          },
          "atom_id": "atom::5ce76ef1bd40abb575afd9d6",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该综述聚焦于NSCLC，其关于微生物组的发现不能直接外推到所有实体瘤或其他癌症类型，尽管文中提到了结直肠癌的对比。",
          "atom_id": "atom::bfe4688b4889c6c75d385bf2",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "文中提到的微生物组与ICI疗效的关联主要基于观察性研究和初步数据，因果关系尚未完全确立，干预效果也未经验证。",
          "atom_id": "atom::75bfe2b13ac9586076893b8d",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "综述本身是叙事性的，其结论依赖于作者对文献的选择和综合，可能存在选择偏倚。",
          "atom_id": "atom::eaf685d0ccc478e538526402",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "对于Fusobacterium等菌种，文中明确指出其在NSCLC中的作用不如在结直肠癌中明确，需谨慎解读。",
          "atom_id": "atom::b39a3d326158b7528cc18724",
          "chapter_id": "Ch5"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "TME细胞成分异质性",
            "finding": "巨噬细胞并非简单的M1/M2二元模型，而是存在激活状态的连续谱系；MDSCs亚型特异性功能不同（单核型通过ARG1/iNOS抑制，多形核型通过ROS抑制）；CAF和ECM重塑通过增加间质硬度促进免疫排斥。"
          },
          "atom_id": "atom::c58638947e26fda363bc96b7",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "内在肿瘤机制",
            "finding": "STK11缺失抑制I型干扰素信号，KEAP1缺失激活抗氧化程序，两者共同导致低PD-L1表达和低CD8+ T细胞浸润；EGFR/ALK驱动突变通常伴随低TMB和不活跃的免疫微环境。"
          },
          "atom_id": "atom::868f6863791b248bb2f885d2",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "联合治疗证据等级",
            "finding": "纳武利尤单抗+伊匹木单抗在CheckMate 227中显示疗效（受PD-L1/TMB影响）；阿替利珠单抗+贝伐珠单抗+化疗在IMpower150中证实对转移性非鳞状NSCLC有效，包括肝转移和EGFR突变TKI失败后人群；LAG-3/TIM-3抑制剂在NSCLC中的临床采纳仍需成熟试验确认。"
          },
          "atom_id": "atom::8374ecf9788b5088e7803fbf",
          "chapter_id": "Ch5"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "生物标志物应用",
            "finding": "PD-L1检测存在空间异质性和平台间不完全互换性；高TMB预测价值受测序平台和肿瘤纯度影响；空间转录组学可区分免疫表型；液体活检（ctDNA/exosome）需前瞻性验证阈值。"
          },
          "atom_id": "atom::55ac707849e577034afb0fb0",
          "chapter_id": "Ch5"
        }
      ],
