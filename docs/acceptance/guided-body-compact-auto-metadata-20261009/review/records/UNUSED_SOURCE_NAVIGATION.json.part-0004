          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "抗生素的影响可能是多方面的（微生物组改变+直接抗炎作用），综述未区分具体抗生素种类的影响差异，仅指出广谱抗生素影响更显著。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::c1380d633739b6409c09a4c3",
            "snapshot::5b707a9c2a4912437225849f",
