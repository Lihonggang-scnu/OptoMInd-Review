        {
          "atom_id": "atom::e8a2aaa35d093c8ed7f79883",
          "source_handle": "P0364",
          "field_path": [
            "study_summary_A",
            "approach"
          ],
          "value": "采用混合方法：首先进行文献计量学映射，包括关键词共现网络、引用共现分析、主题演化分析和战略主题图，以描绘科学产出、智力结构和主题演变；其次，检索ClinicalTrials.gov评估干预性临床试验的活动；最后，进行定性的跨队列功能综合，选取具有明确响应者/非响应者定义的代表性临床研究（Level 4）和临床前研究（Level 2），比较其微生物特征、代谢通路和免疫机制，构建概念框架。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::09453c46fe36046e2b9f48ff"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0364"
        },
        {
          "atom_id": "atom::8e2687bbb100ff34b25cb2d9",
          "source_handle": "P0364",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "提供了将文献计量学结构与跨队列功能解释相结合的综合视角，解释了分类学不一致背后的功能趋同可能性，并为基于功能的生物标志物开发提供了理论依据。",
            "limits": "所给摘要未交代具体的统计检验细节；定性综合依赖于单作者筛选，可能存在选择偏差；未能提供合并效应量；依赖单一数据库（WoSCC）和英语文献，可能存在语言和数据库偏差；因果推断仍受限于观察性研究和混杂因素。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::09453c46fe36046e2b9f48ff"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0364"
        },
        {
