          "source_handle": "P0443",
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "PD-L1低表达 vs. PD-L1高表达",
            "finding": "β-多样性无显著差异。PD-L1低表达患者中广古菌门（Euryarchaeota）丰度显著更高。代谢通路方面，核苷酸降解、氨基酸合成和发酵通路在PD-L1低表达患者中更丰富。"
          },
          "role": "evidence",
