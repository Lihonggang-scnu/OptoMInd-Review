        },
        {
          "atom_id": "atom::bb9fa6649bc07ac89e8a11b8",
          "source_handle": "P0360",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ],
          "value": "To evaluate whether prior antibiotic use affects the efficacy of ICIs (measured by DCR and OS) in patients with recurrent gynecologic malignancies, and to identify independent prognostic factors for survival in this population.",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::bbd82f3d93056270fa4c5d4e",
          "source_handle": "P0360",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ],
          "value": "Recurrent gynecologic malignancies (ovarian, cervical, endometrial) treated with anti-PD-1 monotherapy (pembrolizumab or nivolumab) at two academic centers in Korea.",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::b65cd3de8f464ec01d8e0c43",
          "source_handle": "P0360",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ],
          "value": "This retrospective cohort study evaluated the association between prior antibiotic use and oncological outcomes in patients with recurrent gynecologic cancers receiving immune checkpoint inhibitors (ICIs). The study analyzed clinical data from 215 patients to determine if antibiotic exposure within 60 days before ICI initiation affected disease control rate (DCR) and overall survival (OS). It identified a cumulative antibiotic duration of >14 days as an independent predictor of poor OS, while noting that DCR was not significantly altered by antibiotic use. The authors attribute these findings to potential gut microbiota dysbiosis induced by prolonged antibiotic therapy.",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::b34f121ad4f2197802092e13",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Limited to gynecologic cancers; does not prove causality via microbiome measurement; effect size is observational.",
            "contribution": "Provides empirical clinical data showing that prior antibiotic use (specifically ≥14 days) is associated with reduced Overall Survival in solid tumors (gynecologic cancers), supporting the modulatory role of the microbiome environment on ICI efficacy.",
            "facet_id": "F1"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::2b85b9b279c174d714b72d9c",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Mechanism is inferred/hypothesized by authors; no direct microbial sequencing data is presented in this study to confirm dysbiosis in this specific cohort.",
            "contribution": "Discusses the proposed mechanism of gut dysbiosis caused by broad-spectrum antibiotics (particularly cephalosporins) affecting ICI activity, referencing the recovery time of microbiota (6 weeks to 6 months).",
            "facet_id": "F2"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::21a8ea0966ac434337034121",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Discussion of FMT, probiotics, and diet as potential interventions to reverse antibiotic-induced dysbiosis and improve ICI response."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::6ea63f76f7c306221d790eb7",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Note that dMMR/MSI-H status was not an independent prognostic factor in multivariate analysis due to small sample size and heterogeneous testing rates across tumor types."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::3967e8c930bcda86097bd08c",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The association between antibiotics and OS is observational; confounding by indication (severity of infection requiring longer antibiotics) cannot be fully excluded.",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::63a95565951ecc282b46c6d1",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The study does not measure gut microbiota directly; conclusions about dysbiosis are mechanistic hypotheses based on external literature.",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b9a2d82cfd023eb143b5db0a"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0360"
        },
        {
          "atom_id": "atom::00591dfaf13cb2e513f48999",
          "source_handle": "P0360",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Results are specific to anti-PD-1 monotherapy in gynecologic cancers and may not generalize to combination therapies or other solid tumor types without verification.",
          "role": "evidence",
