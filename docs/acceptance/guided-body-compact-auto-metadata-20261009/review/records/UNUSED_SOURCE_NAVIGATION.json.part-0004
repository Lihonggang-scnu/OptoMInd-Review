      "source_navigation_occurrences": 7,
      "evidence_atom_occurrences": 20,
      "planning_summary_atom_occurrences": 8,
      "key_findings_atom_occurrences": 3,
      "semantic_field_paths": [
        "review_planning_B.broader_review_uses",
        "review_planning_B.facet_contributions",
        "review_planning_B.scope_interpretation_cautions",
