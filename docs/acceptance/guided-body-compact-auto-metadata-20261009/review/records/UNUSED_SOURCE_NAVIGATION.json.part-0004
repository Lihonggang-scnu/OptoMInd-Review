      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这些发现来自黑色素瘤研究，且不同研究间存在细菌物种关联的不一致性，需谨慎外推至其他实体瘤类型。",
            "contribution": "提供了癌症免疫治疗中微生物群预测疗效的直接证据：Gopalakrishnan等发现响应者富集Faecalibacterium，非响应者富集Bacteroidales；Routy等发现Akkermansia muciniphila与响应相关，且补充该菌可恢复疗效。",
            "facet_id": "F1"
          },
          "atom_id": "atom::7239e636c35d0ccf8dfdf308",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "文章未深入阐述具体的分子机制，仅指出微生物群的中心作用，具体通路需参考其他专门研究机制的论文。",
            "contribution": "提示了微生物群可能通过影响宿主免疫状态或药物代谢来调节疗效的机制线索：例如Akkermiasia muciniphila的补充恢复了PD-1阻断的疗效，暗示微生物群可能通过调节局部或全身免疫环境发挥作用。",
            "facet_id": "F2"
          },
          "atom_id": "atom::2603601f994fa56e8980351a",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这是从饮食干预研究中推导出的方法论建议，并非直接针对ICIs试验的设计规范。",
            "contribution": "提供了关于临床试验设计的重要启示：由于个体间微生物群差异巨大，基于群体的平均结果可能掩盖亚组的显著疗效，因此需要考虑基于微生物群的 stratification。",
            "facet_id": "F1"
          },
          "atom_id": "atom::7433488fa448a7e804425140",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这属于对领域现状的评论，而非具体的机制发现。",
            "contribution": "指出了当前机制研究的局限性：不同研究报道的与疗效相关的细菌物种存在差异，这可能反映了技术平台、分析流程或患者人群异质性的影响，而非单一的因果机制。",
            "facet_id": "F2"
          },
          "atom_id": "atom::7bf6b8989f1a421ea3102de3",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "文章开篇总结了肠道微生物群在慢性炎症性疾病中的角色，以及饮食作为核心影响因素的背景。"
          },
          "atom_id": "atom::fbaa0ef7abb83c3ce43bb95b",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "提出了“抗性”与“易感”微生物群的概念，并图示说明不同个体对同一干预（如乳化剂、膳食纤维）的不同反应。"
          },
          "atom_id": "atom::0b547d2fdf7e2a50155284e3",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "文章指出目前大多数研究依赖16S rRNA测序，可能不足以准确预测反应，需要宏基因组或宏转录组分析，甚至菌株水平的鉴定。"
          },
          "atom_id": "atom::c93c2f2f360978f7c92c35be",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "提到了FMT在复发性艰难梭菌感染中的成功应用，以及在IBD中的探索性应用。"
          },
          "atom_id": "atom::5bd50b5bc6be59c5dd2ec247",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "本文主要聚焦于饮食干预，其对ICIs疗效的讨论主要集中在癌症免疫治疗领域，且多为观察性关联，需谨慎推断因果关系。",
          "atom_id": "atom::f699ad0c5b4c2d633ece8cd7",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "文章中提到的细菌物种（如Faecalibacterium, Akkermiasia）在不同研究中的关联可能存在冲突，不能简单视为普适性标志物。",
          "atom_id": "atom::3690087e9bf834aa5c74a070",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "文章未提供具体的ICIs临床试验数据，其关于个性化干预的建议是基于逻辑推导和跨领域类比，而非直接的ICIs证据。",
          "atom_id": "atom::f4f82da340149475a0e7b6fc",
          "chapter_id": "Ch7"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "癌症免疫治疗（抗PD-1疗法）",
            "finding": "肠道微生物群组成可预测免疫检查点抑制剂的疗效；响应者中Faecalibacterium属丰度较高，非响应者中Bacteroidales目丰度较高；Akkermansia muciniphila的丰度与临床反应相关，且补充该菌可恢复小鼠模型中的治疗 efficacy。"
          },
          "atom_id": "atom::de133c33149b49c1c784eb79",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "饮食乳化剂（CMC和P80）摄入",
            "finding": "乳化剂改变微生物群组成，促进微生物侵入粘液层，引发低度肠道炎症和代谢紊乱；这种有害效应依赖于复杂的微生物群，且在缺乏微生物群的无菌小鼠中不出现。"
          },
          "atom_id": "atom::cf7780ad4ecf33898bebec6b",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "麦芽糊精摄入与克罗恩病（CD）",
            "finding": "麦芽糊精增强CD相关粘附侵袭性大肠杆菌（AIEC）的生物膜形成；由于仅30%-40%的CD患者携带AIEC，针对全人群的无麦芽糊精饮食试验可能因混杂了AIEC阴性个体而显示无效，但在AIEC阳性亚组中可能有效。"
          },
          "atom_id": "atom::f9f1ee51c96cee6ae31e3533",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "可溶性纤维（菊粉）补充",
            "finding": "在野生型小鼠中有益，但在IL10KO基因易感小鼠中加剧结肠炎；在雄性小鼠中导致肝细胞癌（HCC），且该效应由微生物群介导，可通过抑制微生物发酵预防。"
          },
          "atom_id": "atom::a28cf92576eebd223952fef6",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "餐后血糖反应（人群研究）",
            "finding": "相同饮食引起的餐后血糖反应存在高度个体差异；整合微生物群组成的机器学习算法能准确预测个体的血糖反应，支持基于微生物群的个性化饮食推荐。"
          },
          "atom_id": "atom::2660117baf2722ea13854afd",
          "chapter_id": "Ch7"
        }
      ],
