      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅限NSCLC患者，高加索人群。PFS定义为>6个月为长，≤6个月为短。未涉及总生存期（OS）。",
            "contribution": "提供了具体的细菌分类群（物种水平）与ICI疗效（PFS）的关联证据。发现*Alistipes shahii*和*A. finegoldii*丰度高与长PFS相关，而*Streptococcus salivarius*、*S. vestibularis*和*B. breve*丰度高与短PFS相关。这些发现在独立验证队列中得到确认。",
            "facet_id": "F1"
          },
          "atom_id": "atom::f4dbf3bd1ff2fc87e04d5633",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "基于随机森林模型，可能存在过拟合风险，尽管使用了交叉验证。代谢通路分析样本量较小（n=37）。",
            "contribution": "提供了微生物组特征预测效能的量化数据。分类学特征预测PFS的AUC为0.74，代谢通路预测PD-L1的AUC为0.87。同时指出α-多样性在此场景下无预测价值。",
            "facet_id": "F1"
          },
          "atom_id": "atom::feeef6f1df4ea05728330825",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅为相关性观察，未通过干预实验验证网络结构变化是否导致疗效改变。机制解释尚属推测。",
            "contribution": "提出了菌群网络结构可能与疗效相关的假设。长PFS患者表现出更密集的菌群网络和更高的节点中心性，暗示有益菌之间的协同互作可能增强抗肿瘤免疫。",
            "facet_id": "F2"
          },
          "atom_id": "atom::a3a5b9914305654656477c50",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "代谢通路数据仅来自子集。F/B比率的具体生物学机制未在本研究中深入阐明。",
            "contribution": "分析了代谢通路（如氨基酸合成、发酵）与PD-L1表达的联系，以及厚壁菌/拟杆菌比率（F/B ratio）与短PFS的联系。",
            "facet_id": "F2"
          },
          "atom_id": "atom::dca49d80e01fef93b6041699",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "观察性研究，混杂因素较多。化疗方案多样，未统一标准化。",
            "contribution": "评估了化疗预处理对肠道菌群的影响。发现化疗确实改变了菌群组成（β-多样性差异），但这种改变并未将菌群推向特定的“不良预后”表型，且化疗预处理患者中仍保留了与PFS相关的特异性菌群差异。",
            "facet_id": "F1"
          },
          "atom_id": "atom::35103c949497a976bb9740b8",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "引言中提到的“分子模拟”假说（微生物抗原与肿瘤新抗原相似，激活T细胞）以及“肠-肺轴”概念。"
          },
          "atom_id": "atom::d728198fecb8864ce25b1c18",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "讨论部分指出本研究与东亚人群研究（Jin et al., Zhang et al.）结果的差异，归因于种族背景、测序方法（16S vs 宏基因组）和参考数据库的不同。"
          },
          "atom_id": "atom::5098926836554035c3b06b7d",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "研究了抗生素、抗酸药（PPI）和类固醇使用对菌群的影响。发现抗酸药使用与短PFS相关菌属（链球菌）增加有关，而抗生素使用未直接关联短PFS菌属增加。"
          },
          "atom_id": "atom::f539b66ea1f6e028c87c0c12",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究为观察性横断面研究，发现的菌群与PFS关联仅为统计学相关，不能直接推断因果关系。",
          "atom_id": "atom::24419f7508af418e94b98eeb",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "样本主要来自高加索人群，结论外推至其他种族（如亚洲、非洲）时需考虑微生物组地域差异。",
          "atom_id": "atom::70e5af635ac8a33a9883b412",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "PFS的定义（6个月阈值）可能影响结果的解释，且未报告总生存期（OS）。",
          "atom_id": "atom::13e15e1ea0c2a87317c8c1e9",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "代谢通路分析仅在部分患者中进行，可能不代表整体队列的功能特征。",
          "atom_id": "atom::db4a1a595b125fa5470e038e",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "机器学习模型的预测性能（AUC 0.74）属于中等水平，尚未达到临床常规应用的极高精度标准。",
          "atom_id": "atom::7c19a38017d41f95e77105d7",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "所有比较组（长/短PFS、PD-L1高低、化疗处理/未处理）",
            "finding": "α-多样性（Shannon指数）在各组间均无显著差异。"
          },
          "atom_id": "atom::8854143fc8da7a3753da0fd9",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "长PFS（>6个月） vs. 短PFS（≤6个月）",
            "finding": "β-多样性存在显著差异。短PFS患者中厚壁菌门（Firmicutes）和放线菌门（Actinobacteria）丰度显著增加，F/B比率升高。长PFS患者中*Alistipes shahii*、*Alistipes finegoldii*和*Barnesiella visceriola*丰度较高；短PFS患者中*Streptococcus salivarius*、*S. vestibularis*和*Bifidobacterium breve*丰度较高。长PFS患者的菌群网络连接更紧密，具有更高的中心性。"
          },
          "atom_id": "atom::dca365e90a5ce019eb2b0ecd",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "PD-L1低表达 vs. PD-L1高表达",
            "finding": "β-多样性无显著差异。PD-L1低表达患者中广古菌门（Euryarchaeota）丰度显著更高。代谢通路方面，核苷酸降解、氨基酸合成和发酵通路在PD-L1低表达患者中更丰富。"
          },
          "atom_id": "atom::fdf77d78260ae78820b64685",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "化疗预处理（CHT-treated） vs. 一线未化疗（CHT-naive）",
            "finding": "β-多样性存在显著差异。CHT预处理改变了菌群组成，但未将其推向特定的“短PFS”或“长PFS”表型。CHT-naive患者中糖酵解通路更丰富，而CHT-treated患者中氨基酸降解和碳水化合物合成通路更丰富。"
          },
          "atom_id": "atom::0d94b1d03cfcafbfcf412a96",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "机器学习预测效能",
            "finding": "基于分类学特征（物种）的随机森林模型预测PFS的AUC为0.74；基于代谢通路的模型预测PD-L1表达的AUC为0.87。表明分类学特征更适合预测生存结局，而代谢通路更适合预测PD-L1表型。"
          },
          "atom_id": "atom::0e1c30f0af452acce36c85fc",
          "chapter_id": "Ch1"
        }
      ],
