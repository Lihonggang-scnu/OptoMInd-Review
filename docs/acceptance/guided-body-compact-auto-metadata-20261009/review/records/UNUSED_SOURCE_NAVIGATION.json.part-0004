      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "该结论基于回顾性队列数据的观察性关联，不能直接推断因果关系；不同癌症类型和治疗方案的混合可能引入异质性，需谨慎外推至特定单一癌种或特定药物类别。",
            "contribution": "提供了多界微生物组特征（特别是高多样性和特定属的组合）与ICI疗效正相关的实证证据。指出C2亚型（高多样性、富含Bacteroides/Kluyveromyces）与更好的治疗反应和生存率相关，而C1亚型（低多样性、富含Malassezia）与较差预后相关。",
            "facet_id": "F1"
          },
          "atom_id": "atom::2b97608fb6d4f94f1b9a33c2",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "所给材料未提供直接的机制实验数据（如动物模型或体外细胞实验），所有机制解释均为基于文献的推测和关联分析，属于理论假说层面，需注明其为作者的解释而非已验证的因果链条。",
            "contribution": "提出了多界微生物通过维持肠道生态稳定性和产生免疫调节代谢物（如短链脂肪酸）来增强抗肿瘤免疫的潜在机制假设。讨论了Bacteroides fragilis诱导树突状细胞成熟和Th1细胞浸润，以及Malassezia激活补体级联反应导致免疫抑制的可能路径。",
            "facet_id": "F2"
          },
          "atom_id": "atom::83561df9577bb9b3b630c124",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "使用了WSNF方法整合多界宏基因组数据，并通过机器学习（随机森林/SVM）构建预测模型。"
          },
          "atom_id": "atom::78c0836b9a8d3729c6bb23ea",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "讨论了抗生素使用对微生物多样性的负面影响，以及粪菌移植（FMT）、益生菌（Clostridium butyricum）和益生元（inulin-type fructans）在改善ICI疗效中的潜在应用。"
          },
          "atom_id": "atom::3124b140ef48214b18522c42",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究为观察性回顾性分析，发现的是微生物特征与疗效的统计学关联，而非因果证明。",
          "atom_id": "atom::acc4f86be6d51ea935fc5098",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "数据来自多个国家和癌种，存在潜在的批次效应和人群异质性，尽管作者进行了标准化处理，但外推至特定单一群体时需考虑情境依赖性。",
          "atom_id": "atom::cf70d829836bf649083a164b",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "多界微生物中病毒和古菌的丰度较低，其检测灵敏度和生物学意义可能受技术限制，解读时需注意低丰度信号的不确定性。",
          "atom_id": "atom::7a3c458274dcf115831a566c",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者提出的机制（如Bacteroides诱导Th1，Malassezia激活补体）引用自其他研究，并非本研究的直接实验发现，需明确区分为本研究的关联发现与文献支持的机制假设。",
          "atom_id": "atom::954c087eec683fcf3af743d3",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "基于WSNF聚类的两个亚型（C1 vs C2），涉及965例多癌种ICI治疗患者",
            "finding": "C2亚型表现出显著更高的Alpha多样性（Shannon和Observed species指数）和更复杂的Beta多样性结构；C2亚型中响应者比例更高，且总体生存期（OS）和无进展生存期（PFS > 6个月）显著优于C1亚型。"
          },
          "atom_id": "atom::a06d831e0fc3bfa9575865c1",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "多界微生物组成差异分析",
            "finding": "C2亚型富集有益菌属，如细菌界的Bacteroides、Parabacteroides，真菌界的Kluyveromyces；C1亚型富集潜在有害菌属，如Malassezia。古菌和病毒界也显示出显著的亚型特异性分布。"
          },
          "atom_id": "atom::0c84a99ade10a4cb256364e9",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "机器学习模型预测效能比较",
            "finding": "由32个多界微生物属组成的诊断模型在区分ICI疗效方面表现出优于单一细菌、真菌、古菌或病毒模型的预测准确性（更高的AUC值）。"
          },
          "atom_id": "atom::dfcab8dadc4c8affa27f2f3c",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "微生物共现网络分析",
            "finding": "C2亚型的微生物共现网络更为密集和稳健，强正相关连接（|ρ| > 0.5）的数量显著多于C1亚型；拟杆菌属（Bacteroides）在C2中为核心枢纽菌属，而Komagataella在C1中更具中心性。"
          },
          "atom_id": "atom::898f31aa8ea8f4c61c221c71",
          "chapter_id": "Ch1"
        }
      ],
