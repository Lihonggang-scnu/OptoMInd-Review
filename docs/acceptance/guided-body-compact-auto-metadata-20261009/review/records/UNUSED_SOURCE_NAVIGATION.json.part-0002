      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "结果来自HCC特定人群，外推至其他实体瘤需谨慎；预测模型未经外部验证；仅展示了关联性，未直接证明因果机制。",
            "contribution": "提供了肠道细菌和代谢物多样性及组成与ICI疗效（DCB vs NDB）关联的具体证据，显示细菌/代谢物差异显著而真菌差异较小；同时提供了基于18种细菌的预测模型（AUC=75.63%）。",
            "facet_id": "F1"
          },
          "atom_id": "atom::64ab749a06f23eea2ace9352",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "摘要未提供这些生物标志物具体的生物学作用机制或实验验证路径；仅为观察性关联，不能直接推断因果机制；样本量有限，可能存在假阳性风险。",
            "contribution": "识别了与生存相关的特定细菌物种（Actinomyces_sp_ICM47, Senegalimassilia_anaerobia）和代谢物（galanthaminone），暗示这些分子可能与免疫治疗的长期效果或患者生存有关。",
            "facet_id": "F2"
          },
          "atom_id": "atom::545d6f781672ec9a07c0a821",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "研究强调了“多界”（multi-kingdom）微生物组的概念，即细菌、真菌和代谢物共同构成复杂的生态系统。"
          },
          "atom_id": "atom::747964e83aa76daae4a56be8",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "研究发现真菌在DCB/NDB间的差异小于细菌，提示不同微生物类群对ICI反应的贡献度可能不同。"
          },
          "atom_id": "atom::fd1b4e369eef5db85c871b93",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究针对的是肝细胞癌（HCC）这一特定实体瘤，其微生物组特征和治疗反应可能与其他实体瘤存在差异，外推时需考虑肿瘤类型特异性。",
          "atom_id": "atom::2b01ff87b0b1ef6f4f50fdaf",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "预测模型基于80人的队列，缺乏独立验证，其临床实用性和泛化能力有待进一步证实。",
          "atom_id": "atom::aee00b010b822ee2c2e493c1",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者声称的“首次”多组学描述需结合领域现状谨慎解读，可能存在其他类似研究未被本摘要涵盖。",
          "atom_id": "atom::3881c3b0703171184ef19a9f",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "观察性研究设计无法确立因果关系，发现的生物标志物仅为潜在关联，需后续功能实验验证。",
          "atom_id": "atom::144c11aae9ad6505311c8cab",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "DCB组 vs NDB组",
            "finding": "细菌和代谢物在DCB与NDB组之间差异显著，而真菌的差异较小。"
          },
          "atom_id": "atom::ff7855f2bf0d8e5cf45f51c0",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "治疗前基线状态",
            "finding": "DCB组的细菌和真菌整体多样性高于NDB组；这种多样性差异在治疗6-8周后开始发生变化。"
          },
          "atom_id": "atom::23afa824a5a804acab5002bf",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "预测模型构建",
            "finding": "建立了包含18个细菌物种的模型，用于预测免疫治疗是否带来持续获益，曲线下面积（AUC）为75.63%。"
          },
          "atom_id": "atom::7d922f870245277cb78e9a52",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "预后生物标志物筛选",
            "finding": "筛选出两种细菌（Actinomyces_sp_ICM47, Senegalimassilia_anaerobia）和一种代谢物（galanthaminone）作为ICI治疗HCC患者生存的预后生物标志物。"
          },
          "atom_id": "atom::08aefcf8d29c72c241e63b18",
          "chapter_id": "Ch1"
        }
      ],
