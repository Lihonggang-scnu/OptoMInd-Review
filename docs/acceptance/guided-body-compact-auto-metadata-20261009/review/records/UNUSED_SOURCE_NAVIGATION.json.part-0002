      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "人体试验中A. muciniphila变化不显著，说明并非所有饮食干预都通过单一菌种起作用；结果基于初步实验，需警惕过度解读因果性。",
            "contribution": "提供了黑覆盆子饮食干预对人体肠道微生物组组成的实际影响数据，以及这种改变在体外（小鼠Avatar模型）对ICI疗效的潜在正向调节作用。",
            "facet_id": "F1"
          },
          "atom_id": "atom::830de14ad71c312851592534",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "该模型本身是工具而非机制解释；具体的分子机制（如抗原呈递、T细胞活化等）在本摘要中未详细阐述，仅表现为肿瘤体积减小。",
            "contribution": "展示了利用‘人体微生物组Avatar模型’（Human microbiome avatar models）来桥接人体菌群变化与肿瘤免疫反应之间关系的实验设计。",
            "facet_id": "F2"
          },
          "atom_id": "atom::cbcb099dbb300df0550a1e8f",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "BEWELL Study的设计细节（随机、交叉、高危人群）及黑覆盆子花蜜的具体剂量（2x80mL/day, 4 weeks）。"
          },
          "atom_id": "atom::27b25d34126690a2d6b9394e",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "人体中A. muciniphila无显著变化 vs 小鼠模型中肿瘤抑制效果。"
          },
          "atom_id": "atom::3ff585c608d2a22bfa3755d0",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者声称的结果基于‘Preliminary experiments’，统计显著性（p=0.05）处于临界值，且未提供效应量或置信区间，规划时需将其视为探索性发现而非确证性结论。",
          "atom_id": "atom::bc906d3445816fa066c426e6",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "人体受试者为‘high risk of developing lung cancer’而非已患癌并接受ICI治疗的患者，其免疫状态和肿瘤微环境与目标综述对象（实体瘤患者）存在本质差异，外推至治疗效果时需明确这一情境限制。",
          "atom_id": "atom::1f113b11fb847cc9481818e8",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "摘要未交代具体的微生物组测序分析方法、批次效应处理及多重检验校正细节，引用其菌群变化数据时应保持谨慎。",
          "atom_id": "atom::e1fda597512715652d3a63ea",
          "chapter_id": "Ch4"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "小鼠模型，饮食含5%冻干黑覆盆子粉",
            "finding": "增加了Akkermansia muciniphila的丰度，该菌属在黑色素瘤中与改善ICI响应相关"
          },
          "atom_id": "atom::1c4bf86160b13e7d02fcbebf",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "人体BEWELL试验，96名高危肺癌风险人群，每日2x80mL黑覆盆子花蜜，持续4周",
            "finding": "未观察到A. muciniphila的显著变化（logistic regression with negative binomial Wald test p-value 0.056），但观察到其他分类群的变化"
          },
          "atom_id": "atom::868146441f96ca8c4467a26f",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "人源化小鼠Avatar模型，移植干预后的人体粪便，接种mc38结肠癌细胞，给予抗PD-1治疗",
            "finding": "初步实验显示，接受干预后菌群移植的小鼠肿瘤体积小于接受干预前菌群移植的小鼠（相对于同型对照，t-test, p-value 0.05）"
          },
          "atom_id": "atom::57726d65f0f931200215ed69",
          "chapter_id": "Ch4"
        }
      ],
