          "source_handle": "P0152",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "Contextualizes polysaccharides against other adjuvants (CpG, STING agonists, FMT) and defines their niche in terms of safety and tolerability.",
            "limits": "Direct head-to-head comparative clinical data between polysaccharides and these other agents are sparse; comparisons are often based on separate study contexts."
