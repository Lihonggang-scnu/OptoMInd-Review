        "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json"
