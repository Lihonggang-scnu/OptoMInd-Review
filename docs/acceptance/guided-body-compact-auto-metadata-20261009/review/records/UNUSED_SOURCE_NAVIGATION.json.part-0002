          ],
          "value": {
            "conditions": "预测模型构建",
            "finding": "建立了包含18个细菌物种的模型，用于预测免疫治疗是否带来持续获益，曲线下面积（AUC）为75.63%。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::79c14d42539eae37ca42ccd3"
          ],
          "author_chapter_id": "Ch1",
