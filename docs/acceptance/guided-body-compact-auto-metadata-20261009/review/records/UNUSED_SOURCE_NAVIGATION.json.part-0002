        {
          "atom_id": "atom::62036c47acb27522a770a22a",
          "source_handle": "P0157",
          "field_path": [
            "study_summary_A",
            "approach"
          ],
          "value": "作为一篇综述，本文采用逻辑分类法组织材料。首先基于免疫学基础（T细胞介导的免疫）建立背景框架；其次，依据免疫激活的时间顺序和空间位置（TME访问、启动、增效、维持）对耐药机制进行系统性归类；再次，针对每一类耐药机制，列举相应的克服策略（如联合化疗/放疗、靶向替代检查点、调节微生物群等）；最后，结合临床前模型和部分临床试验结果（如KEYNOTE系列、CheckMate系列等）来佐证各策略的有效性和局限性。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::4e8a6b09792021ffa6ec9129"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0157"
        },
        {
          "atom_id": "atom::f0d5bc43aaaa142c68f558a1",
          "source_handle": "P0157",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "提供了一个基于免疫激活连续阶段的系统性耐药机制框架，并将宿主因素（微生物群、药物）纳入整体考量。",
            "limits": "作为综述，其结论依赖于所引用的文献，未提供新的原始实验数据。部分策略的临床证据尚处于早期阶段（如I/II期试验），长期疗效和安全性有待进一步验证。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::4e8a6b09792021ffa6ec9129"
          ],
          "author_chapter_id": "Ch1",
