        {
          "atom_id": "atom::1e562fd41ff771a831aa787e",
          "source_handle": "P0231",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "总结了FMT、益生菌、益生元、合生元等调节肠道微生物群的临床和非临床干预手段，包括其应用形式、潜在益处（如增强疗效、缓解结肠炎）和风险（如感染、定植失败）。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::ab105c805d6f74d4e02b550b"
          ],
          "author_chapter_id": "Ch5",
