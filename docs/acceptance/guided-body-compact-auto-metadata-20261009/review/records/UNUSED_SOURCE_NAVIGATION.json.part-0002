          "author_chapter_id": "Ch6",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_006\\b56751a8f394813e6767aa8efd24825055cb0b332ed100bfcc9c8be800506c10\\attempt_001\\MESSAGES.json",
