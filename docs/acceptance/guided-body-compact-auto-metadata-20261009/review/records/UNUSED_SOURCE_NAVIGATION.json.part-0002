        {
          "atom_id": "atom::6d2370498917430fe1ce20f1",
          "source_handle": "P0152",
          "field_path": [
            "study_summary_A",
            "approach"
          ],
          "value": "The authors conduct a narrative review synthesizing literature from structural biology, immunology, oncology, and biomanufacturing. They organize the content by: 1) Structural determinants of bioactivity; 2) Four mechanistic axes of ICI sensitization; 3) Clinical and preclinical evidence; 4) Translational bottlenecks (heterogeneity, PK/PD, trial design); 5) Future strategies (AI, synthetic biology, nanodelivery). They compare polysaccharides with mainstream immunostimulants and contextualize findings within Technology Readiness Levels (TRLs).",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::75c05d10f04491719965663b"
          ],
          "author_chapter_id": "Ch5",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_005\\c8a8e196a35945b70bab58ac7d25825d55761abfe16e04e3930ca8753de1bb61\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0152"
        },
        {
          "atom_id": "atom::a6b20904a951e3029bf63694",
          "source_handle": "P0152",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "Provides a comprehensive framework linking polysaccharide structure (ESAR) to immune function and ICI synergy, categorizing mechanisms into four distinct axes.",
            "limits": "As a review, it synthesizes existing data rather than generating new experimental evidence; clinical validation is limited to early-phase/small-sample studies."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::75c05d10f04491719965663b"
          ],
          "author_chapter_id": "Ch5",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_005\\c8a8e196a35945b70bab58ac7d25825d55761abfe16e04e3930ca8753de1bb61\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0152"
        },
        {
          "atom_id": "atom::2bc8fd0b296c3aa429b0f019",
          "source_handle": "P0152",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "Identifies specific translational bottlenecks (structural heterogeneity, low bioavailability) and proposes advanced technical solutions (AI glycomics, synthetic biology, nanodelivery).",
            "limits": "Proposed solutions like Industry 6.0 integration and AI models are largely theoretical or in early development stages; practical implementation details are not yet established."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::75c05d10f04491719965663b"
          ],
          "author_chapter_id": "Ch5",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_005\\c8a8e196a35945b70bab58ac7d25825d55761abfe16e04e3930ca8753de1bb61\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0152"
