      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "General introduction to how the microbiome educates the immune system, regulates homeostasis, and influences diverse immune processes including defense against infection and autoimmunity."
          },
          "atom_id": "atom::8677c0f361db12eb80393af3",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Discussion of how microbiome modulation affects vaccine outcomes, highlighting shared mechanisms (SCFAs, MAMPs, cytokines) and differences (e.g., live vs. inactivated vaccines)."
          },
          "atom_id": "atom::52cd806f824b68dd3a0382db",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Review of clinical and preclinical efforts using FMT, probiotics, and prebiotics to improve ICI and vaccine outcomes."
          },
          "atom_id": "atom::631f065d89bbef76014439c8",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Associations are primarily observational in humans; causality is largely established in preclinical mouse models. Effects may vary by cancer type and ICI agent (anti-PD-1 vs anti-CTLA-4).",
            "contribution": "Identifies specific gut microbial signatures associated with ICI efficacy in solid tumors. Clinically, higher diversity and abundance of Faecalibacterium prausnitzii, Bifidobacterium longum, and Akkermansia muciniphilia are linked to better outcomes in melanoma, NSCLC, and RCC. Antibiotic use is frequently associated with reduced efficacy.",
            "facet_id": "F1"
          },
          "atom_id": "atom::827da2bac4d68e9836b04872",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Many mechanistic details are derived from preclinical models (mice). The review notes that SCFA effects can be context-dependent (e.g., butyrate may inhibit ICI in some contexts while promoting vaccine response). Direct translation of these mechanisms to human tumor microenvironments requires caution.",
            "contribution": "Details three main mechanistic pathways: 1) SCFAs (e.g., butyrate) influencing DC maturation and T cell activation; 2) MAMPs (e.g., flagellin, peptidoglycan) stimulating TLRs/NOD2 on APCs to promote Th1 polarization and antigen presentation; 3) Microbiome-derived cytokines (IL-12, IFN-gamma) shaping the immune tone.",
            "facet_id": "F2"
          },
          "atom_id": "atom::38f1ad86e5e0d277737673b3",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The review covers multiple cancer types (melanoma, NSCLC, RCC, urothelial) and ICI agents (anti-PD-1, anti-PD-L1, anti-CTLA-4). Findings should not be assumed to be uniform across all solid tumors or ICI types.",
          "atom_id": "atom::7b5283260c0e718f8177c2a3",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Many mechanistic insights are from preclinical mouse models; direct applicability to human solid tumors requires verification.",
          "atom_id": "atom::31184bdeed7a8fc614b22a66",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Clinical associations are often correlative; causality is not always established in human studies.",
          "atom_id": "atom::59e312711a840825fa208836",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The review is a narrative synthesis and does not provide quantitative effect sizes or meta-analytic conclusions.",
          "atom_id": "atom::37411b100d5a12085cc1aa94",
          "chapter_id": "Ch2"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Clinical studies in metastatic melanoma, NSCLC, RCC, and urothelial carcinoma treated with anti-PD-1/PD-L1 or anti-CTLA-4",
            "finding": "Higher gut microbiome diversity and specific bacterial abundances (e.g., Faecalibacterium prausnitzii, Bifidobacterium longum, Akkermansia muciniphilia) are associated with improved ICI response and longer progression-free survival. Conversely, antibiotic use prior to or during ICI therapy is generally associated with reduced efficacy, although some studies show no association."
          },
          "atom_id": "atom::d1b93d675e5ea37408a69ae6",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Preclinical mouse models (melanoma, colon cancer, renal cell carcinoma, fibrosarcoma)",
            "finding": "Microbiota depletion via broad-spectrum antibiotics reduces ICI efficacy. FMT from ICI responders enhances anti-tumor immunity (increased CD8+ T cells, Th1 polarization) compared to FMT from non-responders. Specific bacteria (e.g., Bacteroides fragilis, Bifidobacterium pseudolongum) restore efficacy via mechanisms involving TLR signaling and metabolite production (inosine)."
          },
          "atom_id": "atom::401937b6bf1397ad67aa7641",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Clinical and preclinical studies of various vaccines (influenza, rotavirus, typhoid, etc.)",
            "finding": "Germ-free and antibiotic-treated models consistently show reduced antibody responses to most vaccines, suggesting the microbiome is crucial for optimal vaccine efficacy. Specific microbial components like flagellin (via TLR5) and SCFAs (via GPR43) act as endogenous adjuvants or enhance exogenous adjuvant activity. Dysbiosis in infants and the elderly is linked to poorer vaccine responses."
          },
          "atom_id": "atom::5a6ed862076f28bdb13cebb9",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Mechanistic investigations across both ICI and vaccine contexts",
            "finding": "Three key factors mediate microbial immunomodulation: 1) Short-chain fatty acids (SCFAs) which can have context-dependent effects (promoting DC maturation in vaccines but potentially inhibiting it in ICI); 2) MAMPs (e.g., flagellin, peptidoglycan) which stimulate pattern recognition receptors (TLRs, NOD2) on APCs to prime immune responses; 3) Inflammatory cytokines (IL-12, IFN-gamma, IL-10) whose steady-state levels are shaped by the microbiome and influence systemic immunity."
          },
          "atom_id": "atom::4a9ad87a7c21e655b8d53364",
          "chapter_id": "Ch2"
        }
      ],
