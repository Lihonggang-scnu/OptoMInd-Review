          "source_handle": "P0297",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Description of the bidirectional network connecting intestinal microbiota with pulmonary health via immune, neural, and metabolic pathways."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::55488d84dbb359a3345c319f",
            "snapshot::7b48398ecbc866361ef2c262"
          ],
          "author_chapter_id": "Ch5",
