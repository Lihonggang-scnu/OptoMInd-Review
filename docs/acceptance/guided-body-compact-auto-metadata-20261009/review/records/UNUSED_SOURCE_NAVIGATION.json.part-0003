      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Limited to gynecologic cancers; does not prove causality via microbiome measurement; effect size is observational.",
            "contribution": "Provides empirical clinical data showing that prior antibiotic use (specifically ≥14 days) is associated with reduced Overall Survival in solid tumors (gynecologic cancers), supporting the modulatory role of the microbiome environment on ICI efficacy.",
            "facet_id": "F1"
          },
          "atom_id": "atom::b34f121ad4f2197802092e13",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Mechanism is inferred/hypothesized by authors; no direct microbial sequencing data is presented in this study to confirm dysbiosis in this specific cohort.",
            "contribution": "Discusses the proposed mechanism of gut dysbiosis caused by broad-spectrum antibiotics (particularly cephalosporins) affecting ICI activity, referencing the recovery time of microbiota (6 weeks to 6 months).",
            "facet_id": "F2"
          },
          "atom_id": "atom::2b85b9b279c174d714b72d9c",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Discussion of FMT, probiotics, and diet as potential interventions to reverse antibiotic-induced dysbiosis and improve ICI response."
          },
          "atom_id": "atom::21a8ea0966ac434337034121",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Note that dMMR/MSI-H status was not an independent prognostic factor in multivariate analysis due to small sample size and heterogeneous testing rates across tumor types."
          },
          "atom_id": "atom::6ea63f76f7c306221d790eb7",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The association between antibiotics and OS is observational; confounding by indication (severity of infection requiring longer antibiotics) cannot be fully excluded.",
          "atom_id": "atom::3967e8c930bcda86097bd08c",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The study does not measure gut microbiota directly; conclusions about dysbiosis are mechanistic hypotheses based on external literature.",
          "atom_id": "atom::63a95565951ecc282b46c6d1",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Results are specific to anti-PD-1 monotherapy in gynecologic cancers and may not generalize to combination therapies or other solid tumor types without verification.",
          "atom_id": "atom::00591dfaf13cb2e513f48999",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Multivariate analysis of 215 patients with recurrent gynecologic cancers.",
            "finding": "Prior antibiotic use for a cumulative duration of ≥14 days was independently associated with worse Overall Survival (HR 2.286, 95% CI 1.210–4.318; p = 0.011)."
          },
          "atom_id": "atom::622685168278c6c7db9b08f4",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Comparison of Disease Control Rate (DCR) at 8–10 weeks between groups.",
            "finding": "No significant difference in DCR was observed between patients who received antibiotics (23.4%) and those who did not (33.3%, p = 0.130), nor was DCR significantly affected by antibiotic duration (<14 vs ≥14 days)."
          },
          "atom_id": "atom::ab27face14515573916cb552",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Univariate analysis of prognostic factors.",
            "finding": "Poor ECOG performance status (≥2), chemotherapy-free interval <6 months, and dMMR/MSI-H status were significantly associated with OS in univariate analysis, but only ECOG and chemotherapy-free interval remained significant in multivariate analysis alongside long-term antibiotic use."
          },
          "atom_id": "atom::b33342352d24d63e95312bce",
          "chapter_id": "Ch1"
        }
      ],
