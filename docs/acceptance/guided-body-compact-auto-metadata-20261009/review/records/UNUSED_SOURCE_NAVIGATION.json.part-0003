          "raw_source_handle": "P0329"
        },
        {
          "atom_id": "atom::93a5dccbe3d93c3c7257faa4",
          "source_handle": "P0329",
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "在模型预测价值良好的257名患者子集中，模拟健康供体FMT添加",
            "finding": "FMT提高了模型预测的响应率，且效果依赖于暴露量（即FMT物种定植并替换患者基线微生物组的比例）。"
          },
          "role": "evidence",
