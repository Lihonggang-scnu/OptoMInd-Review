            "broader_review_uses"
          ],
          "value": {
            "material": "418名NSCLC患者的基线微生物组数据及其与ICI响应的统计关联分析。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::668c479a5777d8a189e172af",
            "snapshot::7f4d4d07befb7d6373432503"
          ],
          "author_chapter_id": "Ch7",
