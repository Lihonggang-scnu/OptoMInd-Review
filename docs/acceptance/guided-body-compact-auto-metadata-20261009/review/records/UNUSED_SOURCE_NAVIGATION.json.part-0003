      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Associations are inconsistent across studies; many findings are from retrospective or small prospective cohorts. Causal direction is often inferred rather than proven. Specific taxa may vary by tumor type and geography.",
            "contribution": "Provides a catalog of specific bacterial taxa (e.g., Akkermansia, Bifidobacterium, Faecalibacterium) and metabolites (propionate, inosine) associated with improved ICI response in various solid tumors, along with taxa linked to poor response (Bacteroides, Ruminococcus obeum). Also details the negative impact of broad-spectrum antibiotics on ICI outcomes.",
            "facet_id": "F1"
          },
          "atom_id": "atom::15f73eb5eadb303dd3b9f876",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "Mechanistic evidence is largely derived from preclinical models or small-scale human studies. The prevalence and clinical significance of antigen mimicry are still being elucidated. Inconsistencies in human data limit definitive mechanistic claims.",
            "contribution": "Outlines two distinct mechanistic pathways: (1) Antigen-independent modulation via innate/adaptive immune cell engagement (e.g., DC activation, CD8+ T cell infiltration); (2) Antigen-specific cross-reactivity between microbial and tumor neoantigens. Discusses how specific bacteria might promote regulatory T cells to prevent colitis.",
            "facet_id": "F2"
          },
          "atom_id": "atom::b52a2a2c18a4fca342b2c728",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Introduction to ICIs, their mechanism (blocking inhibitory pathways), and the problem of heterogeneous response and immune-related adverse events (colitis)."
          },
          "atom_id": "atom::825500cc93825fbbc3024cf3",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Acknowledgment of sequencing center heterogeneity, geographical/population differences, and the need for large-scale prospective studies similar to GWAS."
          },
          "atom_id": "atom::9ae21607fe4cc933f2b679c3",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Table 2 listing ongoing trials investigating microbiome modification (e.g., potato starch supplement), FMT for colitis, and biomarker identification."
          },
          "atom_id": "atom::0603b6d101f75d1ebc9a2a83",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The review covers both preclinical (mouse) and clinical (human) data; distinctions must be maintained when attributing findings to human applicability.",
          "atom_id": "atom::c3e02d1c5d2220b47046098f",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Identified bacterial taxa and metabolites show inconsistency across studies; do not present them as universal predictors without noting context-dependence (tumor type, geography, methodology).",
          "atom_id": "atom::d8ed7fc7fc933274280a7ac1",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Mechanistic explanations (especially antigen mimicry) are presented as emerging hypotheses supported by limited evidence; avoid overstating their generalizability.",
          "atom_id": "atom::a66e1342c7b2e0deef60e823",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "FMT efficacy is based on very small pilot studies; conclusions about its therapeutic potential are preliminary and controversial.",
          "atom_id": "atom::2e125b37f8b82c5131d48d04",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Preclinical mouse models (SPF vs GF, antibiotic treatment)",
            "finding": "Intact commensal microbiome is required for anti-tumor efficacy of anti-CTLA-4 antibodies; germ-free or antibiotic-depleted mice show compromised responses."
          },
          "atom_id": "atom::085aa5d13333e18f891b3108",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Human metastatic melanoma patients treated with anti-CTLA-4",
            "finding": "Higher abundance of Faecalibacterium prausnitzii and Gemmiger formicilis associated with positive response; Bacteroides associated with poor response."
          },
          "atom_id": "atom::e22d936b9e5d3051a9e2aeb4",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Human advanced NSCLC or urothelial carcinomas treated with ICIs",
            "finding": "Increased relative abundances of Akkermansia muciniphila and Enterococcus hirae associated with clinical response."
          },
          "atom_id": "atom::aa01a377236c40b93227d94e",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Human solid tumors treated with anti-PD-1",
            "finding": "Higher fecal short-chain fatty acids (SCFAs), particularly propionate, associated with longer progression-free survival in some cohorts, though conflicting results exist for butyrate and other SCFAs across different cohorts."
          },
          "atom_id": "atom::07a943c867a88980d90a169c",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Patients receiving broad-spectrum antibiotics prior to or during ICI therapy",
            "finding": "Antibiotic use is consistently associated with reduced ICI efficacy, shorter overall survival, and shorter progression-free survival."
          },
          "atom_id": "atom::fa42d4d99ed38acb34c1d37b",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "ICI-associated colitis pathogenesis",
            "finding": "Specific bacteria (e.g., Bacteroides fragilis, Burkholderia cepacia) may protect against colitis by promoting regulatory T cells; conversely, increases in Firmicutes have been linked to higher incidence of colitis."
          },
          "atom_id": "atom::dedbea0d3515dd54bf16aa5d",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Mechanistic pathways",
            "finding": "Two major mechanisms identified: (1) Antigen-independent: Microbes modulate innate/adaptive immunity (e.g., dendritic cell activation, CD8+ T cell infiltration); (2) Antigen-specific: Molecular mimicry where microbial epitopes cross-react with tumor neoantigens."
          },
          "atom_id": "atom::c78e7cc967833bf2f392d7c6",
          "chapter_id": "Ch1"
        }
      ],
