      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅提供文献分布统计，不直接提供微生物调节ICI疗效的具体临床效果大小或异质性数据。",
            "contribution": "提供了该领域研究规模的宏观证据，确认了肠道微生物群与ICI疗效关联已成为一个独立且快速扩张的研究子领域。指出了结直肠癌（colorectal cancer）和免疫检查点抑制剂（immune checkpoint inhibitor）是该领域最核心的关键词集群，暗示了在这些特定癌种中微生物调节ICI疗效的研究最为集中。",
            "facet_id": "F1"
          },
          "atom_id": "atom::f91958cbdab94422e5faf534",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "关键词突现代表关注度上升，不代表机制已被完全阐明。摘要未提供具体的分子通路细节，需结合其他实证研究论文来填充具体的机制链条。",
            "contribution": "通过关键词突现分析（burst detection），识别出“microsatellite instability (MSI)”、“diversity”和“t cells”作为新兴热点。这表明当前机制研究的前沿可能集中在MSI状态下的微生物特征、微生物多样性对T细胞浸润的影响等方面。同时，聚类结果指向“tumor microenvironment”（肿瘤微环境）为主要研究方向之一。",
            "facet_id": "F2"
          },
          "atom_id": "atom::f078ddb1ffd8be970ab761ca",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "摘要指出传统综述难以分析知识结构，本研究构建了“微生物-免疫-肿瘤”三角框架。"
          },
          "atom_id": "atom::38c34e6fb892b9f774fcac73",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "列出了Zitvogel, Routy, Kroemer等关键作者及MD Anderson、INSERM等机构。"
          },
          "atom_id": "atom::61c8cb832c511cc207f211f4",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "结论提到需要整合跨尺度机制探索和标准化临床转化路径。"
          },
          "atom_id": "atom::87492d1c99b1b7dc8e17db25",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该论文为文献计量学综述，其“发现”是基于文献计数的统计结果（如关键词频率、引用中心性），而非生物学实验的直接观察。",
          "atom_id": "atom::9999f33c5d2cb360fe617601",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "摘要中提到的“Ruminococcus”, “Bifidobacterium”, “L-selenomethionine”仅为背景介绍中已确认的作用，非本论文的新发现，引用时需区分这是领域共识还是本文贡献。",
          "atom_id": "atom::4e780b89aa8335294feadf2e",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "关键词“colorectal cancer”的高频出现提示该癌种研究较多，但不能推断所有实体瘤的微生物机制相同，需注意不同癌种的异质性。",
          "atom_id": "atom::bc2fb4c5dd29b080e055091c",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "摘要未提供具体的机制细节，若需了解具体分子通路，必须查阅被引用的原始实证研究论文。",
          "atom_id": "atom::c5579360f2d8d045eeef1617",
          "chapter_id": "Ch7"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "2001-2025年 WoSCC 数据库",
            "finding": "研究领域呈现“萌芽-发展-爆发”三阶段增长模式，2024年达到峰值（525篇文章）。"
          },
          "atom_id": "atom::3d03746407449a9359784d05",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "国家合作网络",
            "finding": "中国（988篇）和美国（762篇）是高产国家；英国具有最高中心性（0.30），是全球合作枢纽。"
          },
          "atom_id": "atom::5746eced4aab3f5fdc705ace",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "机构合作网络",
            "finding": "德克萨斯大学系统（149篇）、INSERM（124篇）和MD Anderson癌症中心（123篇）是高产机构；加州大学系统具有最高中心性（0.19）。"
          },
          "atom_id": "atom::439778384de1bdfa2c53ffa9",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "作者影响力",
            "finding": "发文量前三的作者为Zitvogel, Laurence (50篇), Routy, Bertrand (47篇), Wargo, Jennifer A (39篇)；高中心性作者包括Kroemer, Guido等。"
          },
          "atom_id": "atom::784fd12a57becc8b7c60b978",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "关键词分析",
            "finding": "高频关键词为gut microbiota, immunotherapy, colorectal cancer；高中心性关键词为immunotherapy, t cells, gut microbiota；新兴突现关键词为microsatellite instability, health, diversity。"
          },
          "atom_id": "atom::18aa2b0d688dff26fa4ab1eb",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "聚类分析",
            "finding": "揭示五大主要研究方向：免疫检查点抑制剂、乳腺癌、结直肠癌、疗效、肿瘤微环境。"
          },
          "atom_id": "atom::c03581ddab9a9bef368e0a62",
          "chapter_id": "Ch7"
        }
      ],
