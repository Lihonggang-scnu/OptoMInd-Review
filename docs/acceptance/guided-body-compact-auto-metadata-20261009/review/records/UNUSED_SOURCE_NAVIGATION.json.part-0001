      ],
      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "HCC病因（HBV/HCV vs NASH）导致的微生物组差异及其对免疫治疗响应的不同影响。"
          },
          "atom_id": "atom::1f3e98f86aa9737288087c35",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "次级胆汁酸（UDCA, TUDCA）与ICI响应的关联，以及其通过NKT细胞介导的免疫激活机制。"
          },
          "atom_id": "atom::8834b700014fe9559482d360",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "FMT临床试验的进展、安全性顾虑、益生菌（Probio-M9）的初步疗效数据。"
          },
          "atom_id": "atom::e52fed9afee42929b618c972",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "不同研究间存在显著的方法学差异和结果不一致性（如Shen et al.报告Akkermansia在无响应者中富集，与Zheng et al.相反），需谨慎引用，需注明情境依赖性。样本量普遍较小。",
            "contribution": "提供了HCC患者中ICI治疗响应者与无响应者的具体微生物分类学差异清单。例如，响应者富集Akkermansia muciniphila, Ruminococcaceae, Faecalibacterium; 无响应者富集Bacteroides, Proteobacteria, Prevotella。同时也提到了联合治疗（ICI+TKI）下的特定菌群变化。",
            "facet_id": "F1"
          },
          "atom_id": "atom::f8897d3045f6cf3e35e01d33",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "许多机制细节来自小鼠模型或体外实验，在人类HCC中的直接验证有限。代谢物水平的因果关系尚需更多临床数据支持。",
            "contribution": "详细阐述了微生物通过代谢物（SCFAs, 胆汁酸, MAMPs）和直接细胞互作（TLR, STING通路）调节抗肿瘤免疫的机制。具体包括：SCFAs维持屏障并抑制增殖；次级胆汁酸激活NKT细胞；A. muciniphila通过STING通路激活DC/NK细胞；L. rhamnosus通过cGAS/STING轴增强CD8+ T细胞交叉呈递。",
            "facet_id": "F2"
          },
          "atom_id": "atom::56828bb144170e1eacaa62e7",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "大多数干预研究处于早期阶段（Phase I/II或回顾性分析），缺乏大规模随机对照试验证据。FMT的安全性和标准化问题突出。抗生素的影响复杂，取决于类型、时机和剂量。",
            "contribution": "提供了微生物靶向干预（FMT, 益生菌, 益生元, 抗生素）在HCC免疫治疗中的临床前和早期临床证据。例如Probio-M9提高ORR，FMT激活T细胞，抗生素通常降低疗效但存在例外。",
            "facet_id": "F1"
          },
          "atom_id": "atom::6e0090d0ff672afb59ff4ca7",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这部分内容多为理论整合和假设，直接针对这些亚型的微生物干预临床试验数据不足。",
            "contribution": "分析了HCC病因异质性（病毒性肝炎 vs NASH/MASLD）和肿瘤遗传/代谢特征如何塑造不同的微生物组景观，进而影响免疫治疗响应。",
            "facet_id": "F1"
          },
          "atom_id": "atom::e99c317b05be378537a0ec55",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该综述聚焦于HCC，虽然机制可能在其他实体瘤中保守，但直接将HCC的微生物标志物外推至其他癌症类型需谨慎，需考虑器官特异性和肿瘤微环境的差异。",
          "atom_id": "atom::bbf11cba6cccb153c9fcf8c2",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "文中引用的微生物分类学结果在不同研究间存在矛盾，这反映了方法学异质性和生物学复杂性，而非简单的错误。在综合时不应强行统一，而应将其视为领域内的争议点或情境依赖现象。",
          "atom_id": "atom::25f7613ff7964d5c53b4aa02",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "机制描述中混合了人类临床观察和小鼠模型数据，需明确区分哪些是人类中已证实的关联，哪些是动物模型中的因果推断，避免高估人类体内的机制确定性。",
          "atom_id": "atom::8492d048b43cad61fbb16b3e",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者声称微生物组是“关键调节因子”，但这主要基于相关性研究和有限的干预试验，尚不能确立其在所有HCC患者中的决定性作用，需保留不确定性。",
          "atom_id": "atom::09539de388e741601182cc61",
          "chapter_id": "Ch2"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "ICI单药治疗（如Nivolumab, Camrelizumab）",
            "finding": "响应者通常表现出更高的微生物多样性（Shannon指数）和特定菌属富集，如Akkermansia muciniphila、Ruminococcaceae、Citrobacter freundii；无响应者则富集Proteobacteria、Escherichia coli、Dialister pneumosintes及Prevotella。"
          },
          "atom_id": "atom::851db4dec05ec03b53c55a5d",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "ICI联合TKI治疗",
            "finding": "组合疗法显示出优于单药的临床结果，微生物特征显示Lachnospiraceae、Ruminococcus、Faecalibacterium等有益菌在响应者中富集，而Bacteroides、Veillonella等在部分研究中与无响应相关。不同研究间存在显著的菌群标识差异，可能与方法学变异有关。"
          },
          "atom_id": "atom::3928c283a8e4280e54c54f41",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "微生物干预措施",
            "finding": "抗生素暴露通常与ICIs疗效降低和不良事件增加相关，但个别研究显示短期窗口期内的特定抗生素可能增强疗效。益生菌（如Probio-M9/Lactobacillus rhamnosus）在临床试验中提高了ORR。FMT在早期试验中显示出激活CD4+/CD8+ T细胞和抑制肿瘤生长的潜力，但安全性和标准化仍是主要障碍。"
          },
          "atom_id": "atom::e041d2a6f54b96184e595f54",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "机制层面：代谢物与免疫调节",
            "finding": "微生物代谢物如SCFAs维持肠道屏障并抑制肿瘤增殖；次级胆汁酸（UDCA, TUDCA）通过激活NKT细胞分泌IFN-γ/TNF增强抗肿瘤免疫；MAMPs通过TLR通路招募免疫细胞但也可能导致炎症和致癌。特定菌株（如A. muciniphila）可通过STING通路激活DC细胞和NK细胞。"
          },
          "atom_id": "atom::277be6ab0272039613e4b0f7",
          "chapter_id": "Ch2"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "肿瘤异质性背景",
            "finding": "HBV/HCV相关HCC与Enterobacteriaceae升高及炎症反应增强相关；NASH相关HCC与Bacteroides/Ruminococcus富集及免疫抑制性胆汁酸代谢相关。CTNNB1突变导致免疫排斥表型，可能富集Fusobacterium nucleatum；TP53缺失导致屏障功能障碍和LPS易位。"
          },
          "atom_id": "atom::df76f3e6937337b3b73537db",
          "chapter_id": "Ch2"
        }
      ],
