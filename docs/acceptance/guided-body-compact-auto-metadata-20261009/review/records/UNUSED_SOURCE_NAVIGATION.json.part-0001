      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "该结论主要基于罕见实体瘤的CICB治疗数据，外推至其他癌症类型或单药治疗时需保持谨慎。",
            "contribution": "提供了具体的实证数据，证明在CICB治疗背景下，菌株水平的微生物特征能显著提升预测准确率（AUC从物种级的较低值提升至0.73），且该签名跨越不同罕见癌症类型有效。",
            "facet_id": "F1"
          },
          "atom_id": "atom::36a7de06ce88d178887cb4ed",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这一发现限制了跨治疗方案直接比较微生物标志物的可行性，提示在综合不同研究结果时必须考虑治疗方案的匹配性。",
            "contribution": "揭示了微生物预测签名的‘治疗方案特异性’：针对CICB训练的模型无法预测抗PD-1单药的反应，反之亦然（尽管文中主要展示了CICB模型在单药上的失败）。",
            "facet_id": "F1"
          },
          "atom_id": "atom::2b2c749ca49f2ae8573b2656",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这仅是基于基因组潜力的相关性观察，未提供直接的因果机制证据（如代谢物测量或动物模型验证），不能单独作为机制确定的依据。",
            "contribution": "通过功能注释发现，与CICB反应正相关的菌株（如特定Faecalibacterium菌株）富含完整的丁酸合成基因簇，而负相关菌株则缺失，提出了丁酸代谢作为潜在机制线索。",
            "facet_id": "F2"
          },
          "atom_id": "atom::cd80817558097eae7d9663d5",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "论文指出既往物种水平标志物重现性差，并展示了如何通过构建自定义菌株参考库和严格的QC流程来解决这一问题。"
          },
          "atom_id": "atom::c3ad9be0659ed9c6ef8b9d97",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "论文显示，即使在同一类癌症（黑色素瘤）中，如果治疗方案不同（CICB vs 单药），微生物预测模型也会失效。"
          },
          "atom_id": "atom::020a1a6d234e463d88311166",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究的‘泛癌种’结论仅限于三种罕见实体瘤（UGB, NEN, GYN）及外部黑色素瘤队列，不代表所有实体瘤。",
          "atom_id": "atom::ff8da943c7ca4594b6b0853e",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "‘菌株特异性’结论是基于计算生物学预测和统计关联，非实验验证的因果机制。",
          "atom_id": "atom::0534fa098886515c5e4cf703",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "外部验证队列主要来自工业化国家，地理多样性有限。",
          "atom_id": "atom::7d526744560a714bab7d5874",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "CA209-538发现队列 (n=106, CICB治疗)",
            "finding": "菌株水平的微生物特征显著优于物种水平及临床因素，预测CICB反应的最佳AUC为0.73。"
          },
          "atom_id": "atom::a49b5b946b548142e0b40071",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "内部交叉验证 (UGB, NEN, GYN)",
            "finding": "菌株响应签名在三种不同的罕见癌症组织学亚型间表现出稳健的预测能力（平均AUC=0.75），提示其具有泛癌种特性。"
          },
          "atom_id": "atom::b4ea8ed5747f637499bff2bd",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "外部荟萃分析 (6个独立队列, n=364)",
            "finding": "当训练集和测试集均为CICB方案时，签名具有中等程度的外部泛化能力（平均AUC=0.65）；但当应用于抗PD-1单药队列时，预测能力丧失（平均AUC=0.51）。"
          },
          "atom_id": "atom::bea945b34f37b89a9c4a4002",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "关键驱动菌株功能分析",
            "finding": "正向关联的主要菌株属于Firmicutes门Ruminococcaceae科，特别是Faecalibacterium属，且这些菌株普遍拥有完整的乙酰辅酶A丁酸生成途径；而负向关联菌株中部分缺乏该途径。"
          },
          "atom_id": "atom::fa6aa5bedd8fdde4e228b38d",
          "chapter_id": "Ch1"
        }
      ],
