            "broader_review_uses"
          ],
          "value": {
            "material": "摘要指出传统综述难以分析知识结构，本研究构建了“微生物-免疫-肿瘤”三角框架。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::ba6faeb60e6135f42c59cc7b"
          ],
