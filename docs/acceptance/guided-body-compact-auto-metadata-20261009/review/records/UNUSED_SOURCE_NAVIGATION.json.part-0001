          "source_handle": "P0134",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "使用了16S rRNA测序（V3-V4区）和标准的生物信息学流程（QIIME, DESeq2）来分析配对样本。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::c668512a6c9823161aab5aff"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0134"
        },
        {
          "atom_id": "atom::1bd3e81cd7e640495cb12068",
          "source_handle": "P0134",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "样本量极小（N=5），结果可能存在过拟合或偶然性，不能代表总体人群。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::c668512a6c9823161aab5aff"
          ],
          "author_chapter_id": "Ch1",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_001\\47be7e22b5ff720e1d0f995795f678f363ed33890ab836f8c1baae006ee530dc\\attempt_001\\MESSAGES.json",
