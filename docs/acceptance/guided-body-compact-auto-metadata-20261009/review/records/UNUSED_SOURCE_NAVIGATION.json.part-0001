        "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_003\\91eee61491f488e16f81be04d8f112d83ba92e728c1e4bb2c3b0864271a87189\\attempt_001\\MESSAGES.json",
        "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_004\\b995d57956e84cb840b6d426921fbc748165b7d5bcb76b80cd617161c4b4a22f\\attempt_001\\MESSAGES.json",
        "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_005\\c8a8e196a35945b70bab58ac7d25825d55761abfe16e04e3930ca8753de1bb61\\attempt_001\\MESSAGES.json",
        "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_006\\b56751a8f394813e6767aa8efd24825055cb0b332ed100bfcc9c8be800506c10\\attempt_001\\MESSAGES.json",
        "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json"
      ],
      "source_navigation_occurrences": 7,
      "evidence_atom_occurrences": 24,
      "planning_summary_atom_occurrences": 11,
      "key_findings_atom_occurrences": 4,
      "semantic_field_paths": [
        "review_planning_B.broader_review_uses",
        "review_planning_B.facet_contributions",
        "review_planning_B.scope_interpretation_cautions",
        "study_summary_A.approach",
        "study_summary_A.contribution_and_limits",
        "study_summary_A.key_findings",
        "study_summary_A.paper_kind",
        "study_summary_A.problem_or_question",
        "study_summary_A.research_scope",
        "study_summary_A.work_summary"
      ],
      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅限NSCLC患者；观察性关联，非因果证明；基于宏基因组测序，非16S rRNA；主要适用于高加索人群。",
            "contribution": "提供了具体的细菌分类学特征与ICI疗效（PFS）的关联证据。具体包括：长PFS相关的有益菌（Alistipes shahii, A. finegoldii, Barnesiella visceriola）和短PFS相关的有害菌（Streptococcus salivarius, S. vestibularis, Bifidobacterium breve）。证实了Taxonomic profiles在预测PFS方面的有效性（AUC=0.74）。",
            "facet_id": "F1"
          },
          "atom_id": "atom::fe2e2c8cd6b7b9cbfa3d0132",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅在37名患者的子集中分析了代谢通路；预测的是PD-L1表达而非直接的治疗响应；需结合其他研究验证代谢通路的普遍性。",
            "contribution": "提供了代谢通路特征与PD-L1表达状态的关联。发现PD-L1低表达患者中核苷酸降解、氨基酸合成和发酵通路更活跃。指出Metabolic pathways在预测PD-L1状态上优于分类学（AUC=0.87）。",
            "facet_id": "F1"
          },
          "atom_id": "atom::22a0fe6aa2f35eab3a16f5df",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "机制主要为推测性讨论，缺乏直接的实验验证（如动物模型或体外实验）；网络分析仅为相关性。",
            "contribution": "提出了微生物组可能通过分子模拟（molecular mimicry）或肠-肺轴影响免疫微环境的背景机制讨论，并观察到长PFS患者中细菌网络更具连通性（hub species如S. vestibularis, B. uniformis等）。",
            "facet_id": "F2"
          },
          "atom_id": "atom::165aa3a3f5f4973cd5c20cec",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "观察性数据，无法排除适应症偏倚（例如，使用抗酸药的患者可能有不同的基础疾病严重程度）。",
            "contribution": "评估了辅助治疗（抗生素、抗酸药、类固醇）对微生物组组成的干扰。发现抗酸药（PPI/H-blocker）使用与短PFS相关菌种（链球菌）的增加有关，提示药物可能间接影响疗效。",
            "facet_id": "F1"
          },
          "atom_id": "atom::79d62bbddd89e6d8142e93d0",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "作者指出其与东亚NSCLC研究（Jin et al., Zhang et al.）结果的差异，归因于种族基线菌群差异、测序方法（宏基因组vs 16S）和参考数据库的不同。"
          },
          "atom_id": "atom::cd15e9e909619ce769f313c3",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "发现CHT-treated患者微生物组组成改变，但未完全转化为‘短PFS’表型，提示化疗预处理并非绝对禁忌，但可能通过降低PD-L1表达间接影响预后。"
          },
          "atom_id": "atom::e3580678ef9207076c1fc9dc",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究为横断面观察性研究，发现的微生物与疗效关联不代表因果关系。",
          "atom_id": "atom::b61433ca1d9a0267c6cf3aac",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "样本主要来自高加索人种，结论不能直接外推至其他种族群体。",
          "atom_id": "atom::54fd49cad755c4e0a1b2504f",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "代谢通路分析仅在部分子集（n=37）中进行，代表性有限。",
          "atom_id": "atom::ad8c8e03ccc95232d20c4156",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "部分关键物种（如B. adolescentis）在验证队列中未获显著支持，需谨慎引用其普适性。",
          "atom_id": "atom::dfe3a193bd57aab5c38c95db",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者声称的‘首次’或‘最全面’需结合具体语境理解，不应视为领域共识。",
          "atom_id": "atom::6642e7bee0a1f195636db518",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "长PFS (>6个月) vs 短PFS (≤6个月)",
            "finding": "Alpha多样性无显著差异；Beta多样性有显著差异。短PFS患者中厚壁菌门（Firmicutes）和放线菌门（Actinobacteria）丰度增加，F/B比率升高。长PFS与Alistipes shahii, A. finegoldii, Barnesiella visceriola正相关；短PFS与Streptococcus salivarius, S. vestibularis, Bifidobacterium breve正相关。"
          },
          "atom_id": "atom::daa4adaeb566ae2e4e93d726",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "PD-L1高表达 vs 低表达",
            "finding": "Beta多样性无显著差异。PD-L1低表达患者中Euryarcheota丰度较高。代谢通路方面，核苷酸降解、氨基酸合成和发酵通路在PD-L1低表达患者中更丰富。代谢通路比分类学更能预测PD-L1状态（AUC=0.87）。"
          },
          "atom_id": "atom::1b02db1847acf319c9a23061",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "化疗预处理（CHT-treated）vs 未预处理（CHT-naïve）",
            "finding": "两组间Beta多样性有显著差异。CHT处理后患者中氨基酸降解和碳水化合物合成通路增加。CHT预处理本身并未将微生物组推向“短PFS”表型，但CHT-treated患者整体预后略差。"
          },
          "atom_id": "atom::23e65bda95e038e310d76c62",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "合并用药影响",
            "finding": "抗生素使用导致Anaerostipes等减少，Eggerthella增加。抗酸药使用导致链球菌属（如S. salivarius）增加，这与短PFS相关。类固醇使用与变形菌门（Proteobacteria）增加相关。"
          },
          "atom_id": "atom::1282b78e315c719d1bfc2099",
          "chapter_id": "Ch1"
        }
      ],
