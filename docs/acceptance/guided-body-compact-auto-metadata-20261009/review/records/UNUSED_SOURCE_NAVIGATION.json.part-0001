      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅限NSCLC人群，样本量小（N=5），且混合了单药与联合化疗方案，结果的外推需谨慎。不能证明因果关系，仅为关联观察。",
            "contribution": "提供了具体的临床观察证据：在NSCLC患者中，治疗期间肠道微生物组的显著变化（波动）与抗PD-1治疗的响应正相关，而稳定的或特定菌属（如Akkermansia减少）的变化与无响应相关。",
            "facet_id": "F1"
          },
          "atom_id": "atom::60bb2b4a9aa9df9db01788b3",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这是相关性发现，未提供直接的机制验证（如代谢产物分析或动物模型验证）。所给材料未交代这些菌属变化的具体分子机制。",
            "contribution": "提示了潜在的机制线索：响应者中Clostridium sensu stricto 1的增加和无响应者中Akkermansia的减少可能与免疫激活或抑制有关。同时指出Escheria-Shigella在无响应者中的增加与既往文献一致。",
            "facet_id": "F2"
          },
          "atom_id": "atom::e83c2e1bd28e65ccf7087396",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "论文引言讨论了基线微生物组、抗生素使用、粪菌移植（FMT）与ICI疗效的关系，以及当前基线生物标志物（如PD-L1）的局限性。"
          },
          "atom_id": "atom::eab5db6ff6e6bd9baf462ffc",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "使用了16S rRNA测序（V3-V4区）和标准的生物信息学流程（QIIME, DESeq2）来分析配对样本。"
          },
          "atom_id": "atom::7d78b42fa14a1be3044aa718",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "样本量极小（N=5），结果可能存在过拟合或偶然性，不能代表总体人群。",
          "atom_id": "atom::1bd3e81cd7e640495cb12068",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "研究纳入了联合化疗患者，化疗本身对微生物组的影响未被单独控制，可能导致混杂。",
          "atom_id": "atom::246effc5bffc4f5957f9d1d4",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "仅有一个治疗时间点样本，无法区分短期波动与长期趋势。",
          "atom_id": "atom::cbe5d95acd9ad45b5d33eee2",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者声称的“潜在用途”需结合其他更大规模研究综合评估，不可单独视为确证证据。",
          "atom_id": "atom::0b5f55cb4a345f60d7fb9eb6",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "基线阶段，3名响应者与2名无响应者之间",
            "finding": "肠道微生物组的整体Alpha多样性（包括Observed, Chao1, Shannon, Simpson指数）无显著差异。"
          },
          "atom_id": "atom::1c7b0afc6f541c9bb294a0bd",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "治疗期间，比较响应者与无响应者的微生物组变化幅度",
            "finding": "响应者表现出显著的治疗前后微生物组多样性变化（R2: 0.146, P = 0.0274），而无响应者变化较小。整体而言，治疗时间点对微生物组组成的解释力较弱（P = 0.26），个体效应较强。"
          },
          "atom_id": "atom::c233e41e0f6c2e57947aec0a",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "响应者（Responders）治疗后的特定菌属变化",
            "finding": "Odoribacter, Gordonibacter, Candidatus Stoquefichus, Escheria-Shigella, 和 Collinsella 的丰度显著下降；Clostridium sensu stricto 1 的丰度显著增加。"
          },
          "atom_id": "atom::c110c5934d43437de2c0d2ac",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "无响应者（Non-responders）治疗后的特定菌属变化",
            "finding": "Prevotella, Porphyromonas, Streptococcus, 和 Escheria-Shigella 的丰度显著增加；Akkermansia 的丰度显著下降。"
          },
          "atom_id": "atom::6419dd7088c2e53b13242b6f",
          "chapter_id": "Ch1"
        }
      ],
