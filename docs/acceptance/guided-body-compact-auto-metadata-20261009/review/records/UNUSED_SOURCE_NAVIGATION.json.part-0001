      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这些发现主要基于黑色素瘤患者的观察性研究和动物FMT实验，尚未在广泛的其他实体瘤中普遍验证；且未说明这些菌群是原因还是结果。",
            "contribution": "提供了肠道菌群组成与免疫检查点抑制剂（ICI）疗效关联的临床证据。指出黑色素瘤ICI响应者肠道中富集Akkermansia, Alistipes, Clostridiales等菌属，而非响应者则不同。",
            "facet_id": "F1"
          },
          "atom_id": "atom::b14e80f9a7f421e778a5ee90",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "机制细节主要来自小鼠模型（FMT实验），人体内的确切分子通路尚不完全清楚；不同研究识别出的关键菌种存在差异（如有的强调Akkermansia，有的强调Bifidobacterium），提示情境依赖性。",
            "contribution": "揭示了特定细菌介导ICI疗效增强的潜在机制线索。例如，Akkermansia muciniphila可增加肿瘤内细胞毒性T细胞浸润；Bifidobacterium longum等也被认为能改善PD-L1疗效。同时提出了抗生素使用破坏菌群导致ICI疗效下降的反面证据。",
            "facet_id": "F2"
          },
          "atom_id": "atom::2d4cbfba6e3c600e35d0bafc",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "这是间接效应，不直接回答菌群如何生物化学地调节ICI靶点或免疫通路。",
            "contribution": "提供了益生菌（非特定共生菌，而是补充剂）可能间接影响治疗结局的背景。虽然主要关注副作用缓解，但指出维持健康的肠道平衡可能防止因严重副作用导致的停药，从而间接保证ICI疗程的完成。",
            "facet_id": "F1"
          },
          "atom_id": "atom::b520a3be90c3e52e0e98c71a",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "将益生菌的作用分为两类：1) 缓解胃肠道毒性（腹泻、黏膜炎）以提高生活质量/依从性；2) 作为免疫调节剂增强ICI疗效。"
          },
          "atom_id": "atom::fee4e8bf5f4ec766e01a8391",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "LGG通过释放LTA激活巨噬细胞保护正常肠细胞的机制。"
          },
          "atom_id": "atom::79cab45f7e4752c2bb82585a",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "癌症患者常处于免疫抑制状态，使用益生菌可能存在机会性感染和抗生素耐药基因转移的风险。"
          },
          "atom_id": "atom::7e5917ce1d1f8f5876a84c76",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该综述主要基于2019年之前的文献，后续可能有更多更新的研究出现。",
          "atom_id": "atom::db497ebde7996862e20e5599",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "文中提到的ICI疗效增强证据多来自黑色素瘤，外推到其他实体瘤需谨慎。",
          "atom_id": "atom::f5418f50017f7bc5c7b7ebf4",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "区分“特定肠道共生菌”（如Akkermansia，自然存在于体内）与“外源性益生菌补充剂”（如LGG，作为药物/补充剂给予）的不同作用模式和证据等级。",
          "atom_id": "atom::69c82aa40e101f1d3f0618ef",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "不要将动物模型（FMT）的结果直接等同于人体临床疗效，需注明这是机制探索阶段的证据。",
          "atom_id": "atom::f6037a1d0608677fe5924a2f",
          "chapter_id": "Ch6"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "黑色素瘤患者接受抗PD-1/PD-L1免疫治疗",
            "finding": "作者转述了Routy等人和Gopalakrishnan等人的研究，发现响应者肠道中富集Akkermansia、Alistipes、Clostridiales等菌属；粪菌移植（FMT）至无菌小鼠可改善PD-1阻断疗效，表明特定肠道菌群能增强免疫检查点抑制剂的抗肿瘤效果。"
          },
          "atom_id": "atom::bba8ee6803b73e5fdd19167b",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "接受化疗或放疗的结直肠癌及其他实体瘤患者",
            "finding": "多项随机对照试验显示，口服益生菌（如L. johnsonii, L. acidophilus, B. longum, S. boulardii）能显著减少治疗相关的腹泻、黏膜炎和术后感染，改善肠道菌群组成和局部免疫功能。"
          },
          "atom_id": "atom::d35f3c7fa718acde685707ba",
          "chapter_id": "Ch6"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "接受放化疗的胃肠道肿瘤患者",
            "finding": "模型菌株LGG被证实能通过释放脂磷壁酸（LTA）激活隐窝周围巨噬细胞，从而选择性保护正常肠上皮干细胞免受辐射诱导的凋亡，而不影响肿瘤细胞，起到“时间释放胶囊”般的放射保护作用。"
          },
          "atom_id": "atom::e143d0e94eb670b6a7e529de",
          "chapter_id": "Ch6"
        }
      ],
