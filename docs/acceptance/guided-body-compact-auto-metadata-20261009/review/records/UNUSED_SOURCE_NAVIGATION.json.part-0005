        {
          "atom_id": "atom::e31bd726bed36cb5ed5e8fce",
          "source_handle": "P0547",
          "field_path": [
            "study_summary_A",
            "approach"
          ],
          "value": "采用系统综述设计。检索策略基于MeSH术语，限定为过去10年内发表的英语人类研究，关键词组合包括抗生素、免疫检查点抑制剂、癌症及治疗结局。从576条记录中筛选出175篇进行详细审查，最终纳入25项报告了按抗生素暴露分层生存结局的研究。分析重点在于比较抗生素暴露组与非暴露组的总体生存率，并考察肿瘤类型、抗生素类别及合并感染状态对结果的调节作用。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::e8d01d45808cf092b87f9be9"
          ],
          "author_chapter_id": "Ch4",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_004\\b995d57956e84cb840b6d426921fbc748165b7d5bcb76b80cd617161c4b4a22f\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0547"
        },
        {
          "atom_id": "atom::508c3fe653060c37151841b0",
          "source_handle": "P0547",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "提供了关于抗生素暴露与ICI疗效关联的大规模汇总证据（25项研究，~73,567例），明确了在非黑色素瘤实体瘤中的负面关联趋势，并识别了黑色素瘤和HCC作为潜在的特异性情境。",
            "limits": "所给摘要未交代具体的数据综合方法（如是否进行Meta分析）、偏倚风险评估细节以及各单项研究的基线特征差异。结论主要基于观察性数据的汇总，因果推断能力受限。作者提出的临床建议（如延迟ICI启动）属于推测性指导，需进一步前瞻性研究验证。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::e8d01d45808cf092b87f9be9"
          ],
          "author_chapter_id": "Ch4",
