          "source_handle": "P0511",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "验证队列样本量较小（N=27），导致预后分析的统计效力不足，P值不显著不代表无关联，而是无法拒绝零假设。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::876d049940377080941b53c1"
          ],
          "author_chapter_id": "Ch1",
