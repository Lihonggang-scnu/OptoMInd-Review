          "value": {
            "boundaries": "仅限黏膜黑色素瘤亚型；结果为初步相关性，尚未确立因果性或普适性；样本量有限。",
            "contribution": "提供了黏膜黑色素瘤患者中，ICI响应者与非响应者之间肠道微生物组组成的具体差异证据（细菌类群存在和比例的变化）。",
            "facet_id": "F1"
          },
          "role": "evidence",
          "snapshot_ids": [
