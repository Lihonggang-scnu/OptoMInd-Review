          "atom_id": "atom::264c6709cc910d12ebd5a8dc",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "Use of time-dependent Cox models to address immortal time bias."
          },
          "atom_id": "atom::1c2fc03bd228d69f90700d6f",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The study is retrospective and single-centre, limiting generalizability.",
          "atom_id": "atom::efb551cb64f4a996542cfcde",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Associations do not imply causation; unmeasured confounders may exist.",
          "atom_id": "atom::cc9ac9200723c62e3332eec1",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The 'early' vs 'late' grouping is based on median infusion time, which may not reflect optimal biological timing.",
          "atom_id": "atom::a65a67c7fc1223583e7be583",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Results differ by regimen type (chemo vs non-chemo), so findings cannot be universally applied to all ICI treatments.",
          "atom_id": "atom::d76e4eb2c50a15b19045343c",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Sensitivity analysis yielded mixed results depending on the statistical model used.",
          "atom_id": "atom::09bde12acd20d48d0d686ba1",
          "chapter_id": "Ch7"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Overall cohort (n=2631)",
            "finding": "Median OS was significantly shorter in the late group (13.1 months) compared to the early group (21.4 months). Time-dependent Cox model showed HR 1.30 (95% CI 1.16-1.44) for death in the late group."
          },
          "atom_id": "atom::86be55c0fd1c481f08135111",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Regimens with ICIs alone (n=1886) or ICIs plus tyrosine kinase inhibitors (n=163)",
            "finding": "The association between later administration and shorter OS remained significant."
          },
          "atom_id": "atom::1c462fad1719cdc8697afb2a",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Regimens comprising chemotherapy (n=582)",
            "finding": "No significant difference in OS was observed between early and late groups."
          },
          "atom_id": "atom::83d0fdb0fb696690c582b8f6",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Sensitivity analysis based on exposure at 3 months",
            "finding": "Standard model showed no difference (HR 1.09, 95% CI 0.98-1.20); time-dependent model showed higher risk of death for late group (HR 1.14, 95% CI 1.02-1.26)."
          },
          "atom_id": "atom::7c00aacbe807f3ae64142343",
          "chapter_id": "Ch7"
        }
