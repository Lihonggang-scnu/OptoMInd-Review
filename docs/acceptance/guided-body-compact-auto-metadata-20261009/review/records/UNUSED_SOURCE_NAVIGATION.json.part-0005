      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "These are model-derived predictions fitted to clinical data, not independent prospective validations. The causal link is theoretical within the model structure.",
            "contribution": "Identifies specific microbial characteristics (low/high levels of favorable bacteria, growth rates) as predictive markers for anti-PD-1 response in melanoma patients via modeling.",
            "facet_id": "F1"
          },
          "atom_id": "atom::be73708f468266ddc0678883",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "The mechanism is simulated; actual biological pathways are not detailed. The claim of achieving long-term progression-free survival is a simulation result, not a clinical observation.",
            "contribution": "Proposes a mechanism where the initial state of favorable bacteria determines therapeutic outcome, and suggests that modifying this state can shift non-responders to responders.",
            "facet_id": "F2"
          },
          "atom_id": "atom::91197f30babbd6c32cdd1a19",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "The use of melanoma patient data to calibrate the model and the focus on anti-PD-1 therapy."
          },
          "atom_id": "atom::6a8a6a7123af68e7f4e79f93",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The results are based on a theoretical model fitted to clinical data, not direct experimental evidence of causality.",
          "atom_id": "atom::d39d3c28cec61e16914b5346",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The specific findings regarding predictive markers are derived from simulation outputs and may depend on model assumptions.",
          "atom_id": "atom::b5593bd6e42114fbf96bf247",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "The generalizability to other types of solid tumors or different ICI classes is not addressed in the abstract.",
          "atom_id": "atom::7245caff3982eb86a32b47d5",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "Claims about improving response rates through bacterial manipulation are hypothetical based on simulation, not confirmed clinical outcomes.",
          "atom_id": "atom::decc20b4febb01d740031b54",
          "chapter_id": "Ch7"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "At the initiation of anti-PD-1 therapy",
            "finding": "Low initial growth rate and low level of favorable bacteria predict non-responders, while a high level of favorable bacteria predicts responders."
          },
          "atom_id": "atom::812a29729d0569843ec91062",
          "chapter_id": "Ch7"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "Through simulation of bacterial manipulation",
            "finding": "It is possible to promote the response rate to anti-PD-1 by manipulating the gut bacteria composition of non-responders, potentially achieving long-term progression-free survival."
          },
          "atom_id": "atom::9f9dc46c0fca85bc8c805b82",
          "chapter_id": "Ch7"
        }
      ],
