      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅证明关联性，不直接展示微生物群的具体变化机制。黑色素瘤中的阴性结果提示该关联并非普适，需结合其他文献解释为何黑色素瘤对微生物群扰动相对不敏感或存在补偿机制。",
            "contribution": "提供了抗生素暴露（微生物群破坏的主要诱因）与ICI疗效负相关的实证数据。具体而言，它量化了在多数实体瘤中抗生素使用导致生存率下降的风险幅度（HR 1.08-2.55），并指出了黑色素瘤中无显著关联的反例。",
            "facet_id": "F1"
          },
          "atom_id": "atom::9b83286e3a75f0d290f5de18",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "摘要未提供具体的分子机制或微生物物种层面的数据，仅停留在临床结局和药物类别层面。不能直接用于解释具体的免疫细胞浸润或信号通路变化，需引用其他机制研究论文补充。",
            "contribution": "提示了抗生素类别特异性（如氟喹诺酮类）和宿主因素（HCC中的肝炎状态）可能调节抗生素对免疫治疗的影响。这暗示了不同的微生物群扰动模式或宿主-微生物互作机制可能导致不同的临床结局。",
            "facet_id": "F2"
          },
          "atom_id": "atom::11831df00927849d2569d08f",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "25项研究汇总的生存数据及HR范围，以及关于氟喹诺酮类高风险的发现。"
          },
          "atom_id": "atom::b27a962b5bb98728d54bc4ce",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "黑色素瘤无关联、HCC依赖肝炎状态的例外发现。"
          },
          "atom_id": "atom::62437265cb56642120dc3484",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究为观察性系统综述，发现的关联不等于因果关系。抗生素使用可能与疾病严重程度或共病有关，而不仅仅是微生物群破坏所致。",
          "atom_id": "atom::78b670f8dba4d118dcf3f52e",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "黑色素瘤中的阴性结果不应被忽视，它挑战了“抗生素必然损害ICI疗效”的简单假设，需在综述中谨慎处理以避免过度概括。",
          "atom_id": "atom::9724329df5ec041f960e30f6",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "所给材料未提供原始研究的详细质量评估，因此汇总结果的可靠性依赖于纳入研究的整体质量，阅读时需保持适度谨慎。",
          "atom_id": "atom::4bc6ea6a73844a22cdb7f80b",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "作者提出的“延迟ICI启动”建议是基于回顾性数据的推测，尚未得到随机对照试验证实，不应作为既定事实陈述。",
          "atom_id": "atom::cf8986b2814409ac3b9aca36",
          "chapter_id": "Ch4"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "除黑色素瘤和特定HCC外的多数实体瘤",
            "finding": "抗生素暴露（治疗前30-60天或期间）与较差的总生存期（OS）显著相关，风险比（HR）范围通常在1.08至2.55之间，个别研究报道风险极高（HR 7.4）。"
          },
          "atom_id": "atom::dd615146c98f41a4f0d8a8b6",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "黑色素瘤队列",
            "finding": "大型黑色素瘤队列未显示抗生素暴露与生存率之间存在显著关联，构成主要例外情况。"
          },
          "atom_id": "atom::cb375096d782aae5a8445330",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "肝细胞癌（HCC）",
            "finding": "关联结果可变，取决于肝炎感染状态。"
          },
          "atom_id": "atom::82144f781343847050f09698",
          "chapter_id": "Ch4"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "不同抗生素类别",
            "finding": "部分分析显示氟喹诺酮类与其他类别相比与更差的生存率相关，提示可能存在类别特异性效应而非统一的抗生素风险。"
          },
          "atom_id": "atom::b33beb873f2d36553ab5f184",
          "chapter_id": "Ch4"
        }
      ],
