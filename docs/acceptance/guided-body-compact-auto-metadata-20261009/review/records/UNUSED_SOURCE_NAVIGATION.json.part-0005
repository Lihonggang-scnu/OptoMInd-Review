          "source_handle": "P0525",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "The use of melanoma patient data to calibrate the model and the focus on anti-PD-1 therapy."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b52cf9e1252591b6988e94d5"
          ],
          "author_chapter_id": "Ch7",
