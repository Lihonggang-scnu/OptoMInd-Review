      "planning_summary": [
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "仅限黏膜黑色素瘤亚型；结果为初步相关性，尚未确立因果性或普适性；样本量有限。",
            "contribution": "提供了黏膜黑色素瘤患者中，ICI响应者与非响应者之间肠道微生物组组成的具体差异证据（细菌类群存在和比例的变化）。",
            "facet_id": "F1"
          },
          "atom_id": "atom::3caf73fb053b6436a58289fd",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "CD56/CD20表达与微生物组之间的直接因果联系未在摘要中证实，仅为并行观察到的现象；机制解释尚不明确，需进一步实验验证。",
            "contribution": "提示了微生物组可能与肿瘤微环境免疫状态相关联，表现为响应者中CD56和CD20表达升高。同时指出了不同原发部位MM具有不同的突变签名（如MMR缺陷 vs UV损伤），这可能间接影响免疫原性和微生物组互作。",
            "facet_id": "F2"
          },
          "atom_id": "atom::174dac331c10482c9b499eeb",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "不同原发部位（口鼻、泌尿生殖、直肠、结膜）MM具有独特的微生物特征和基因组突变签名（如UV暴露相关 vs MMR缺陷相关）。"
          },
          "atom_id": "atom::b2f4a369c8011c98960b26ff",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "MM整体对ICI反应率低，且本研究正在探索可改变的风险因素。"
          },
          "atom_id": "atom::32396aee7cbda217c69e93a3",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "该研究为进行中中的前瞻性队列，数据截至2026年5月，结果仅为初步分析，不代表最终结论。",
          "atom_id": "atom::1ccc88cdddfbf0f6f604fa46",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "微生物组与ICI响应的关联仅为观察性相关性，未证明因果关系。",
          "atom_id": "atom::7252567914c781709c40c1f9",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "样本量较小（n=130），且仅部分患者完成了微生物组测序，可能存在选择偏倚。",
          "atom_id": "atom::3414ff342a8a474b3279096c",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "不同原发部位的生物学差异巨大，结果不可直接外推至其他类型的黑色素瘤或实体瘤。",
          "atom_id": "atom::11978337d32cb53b592725f8",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions"
          ],
          "value": "CD56和CD20的高表达是响应者的特征，但其与微生物组的具体互作机制未知。",
          "atom_id": "atom::be82f4a21379d0105e536ace",
          "chapter_id": "Ch1"
        }
      ],
      "key_findings": [
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "基于截至2026年5月入组的130名患者（已测序粪便和黏膜拭子85人），按原发部位分类。",
            "finding": "肠道和黏膜表面微生物组显示出广泛的样本内异质性，且微生物特征与原发部位相关。"
          },
          "atom_id": "atom::bc1422b9fae5b64d5014930b",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "基于WES和WGS数据分析。",
            "finding": "肿瘤突变负荷（TMB）中位数为1.34 mut/Mb（范围0.52–14.72）。直肠和泌尿生殖道肿瘤与DNA错配修复和微卫星不稳定性相关的突变签名有关；结膜和口鼻肿瘤与紫外线暴露相关。"
          },
          "atom_id": "atom::3fad70e7d4cee75ed5a89c85",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "针对接受ICI治疗的患者的肠道微生物组分析。",
            "finding": "响应者（R）与非响应者（NR）之间细菌类群的存在和比例存在组成差异。"
          },
          "atom_id": "atom::26a92b9bc963407db444dccb",
          "chapter_id": "Ch1"
        },
        {
          "field_path": [
            "study_summary_A",
            "key_findings"
          ],
          "value": {
            "conditions": "DSP分析按治疗反应分组。",
            "finding": "响应者（R）的免疫和肿瘤区室中CD56和CD20的表达高于非响应者。"
          },
          "atom_id": "atom::c9fa6ec476c115cb9276312c",
          "chapter_id": "Ch1"
        }
      ],
