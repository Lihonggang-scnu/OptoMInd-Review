        {
          "atom_id": "atom::22c2a86826ff5178286311d1",
          "source_handle": "P0558",
          "field_path": [
            "study_summary_A",
            "approach"
          ],
          "value": "Retrospective cohort study. Patients receiving ICIs for advanced/metastatic disease between Jan 2018 and Dec 2023 were grouped based on infusion timing relative to the median time of all treatments ('early group': <50% cycles after median time; 'late group': ≥50%). Primary endpoint was OS. Multivariable-adjusted Hazard Ratios (HRs) were estimated using standard Cox models and time-dependent Cox models to account for potential changes in group assignment over time. Sensitivity analyses were performed.",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::2f36d454510b1c8d961d57df"
          ],
          "author_chapter_id": "Ch7",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0558"
        },
        {
          "atom_id": "atom::3411659c8a5c411b2e7aba87",
          "source_handle": "P0558",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "Provides evidence from a large sample size suggesting a benefit in OS with early ICI administration, utilizing time-dependent Cox models to reduce immortal time bias.",
            "limits": "Retrospective design limits causal inference; results may be specific to the single-centre setting; no difference found when chemotherapy is included; sensitivity analysis results varied by model type."
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::2f36d454510b1c8d961d57df"
          ],
          "author_chapter_id": "Ch7",
