        {
          "atom_id": "atom::b889a447834235936ab7bdb8",
          "source_handle": "P0534",
          "field_path": [
            "review_planning_B",
            "facet_contributions"
          ],
          "value": {
            "boundaries": "机制部分主要基于作者引用的理论框架和对现有研究的解读，而非本篇提供的原始实验数据；具体分子通路细节未在文中展开，需结合其他机制研究；干预试验的因果效力尚未在大样本随机对照试验中得到确证。",
            "contribution": "提供了微生物组调节疗效的理论机制框架，包括癌症免疫循环、生态韧性理论和精准宿主调节。解释了为何多样性比单一菌种更重要（生态韧性），以及微生物如何通过抗原呈递、T细胞 priming 和短链脂肪酸生成影响免疫状态。同时指出了当前干预试验（FMT、活体产品）处于早期阶段，机制尚不完全明确。",
            "facet_id": "F2"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::e7f22d9bd792b22114d77cc5"
          ],
          "author_chapter_id": "Ch7",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0534"
        },
        {
          "atom_id": "atom::a270ba0cc300126faed82feb",
          "source_handle": "P0534",
          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "文章提出的从“分类学”到“功能/生态系统”的范式转变，以及癌症免疫循环、生态韧性理论在解释ICI异质性中的应用。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::e7f22d9bd792b22114d77cc5"
          ],
          "author_chapter_id": "Ch7",
