        {
          "atom_id": "atom::16131621d0424b348f162b60",
          "source_handle": "P0566",
          "field_path": [
            "study_summary_A",
            "approach"
          ],
          "value": "采用结构化但非系统的文献检索策略，基于 PubMed/MEDLINE, Embase, Scopus (2015-2026) 及会议摘要。优先纳入肺癌相关的临床队列和随机数据，补充机制性临床前研究。通过叙述性综合方法，整合不同研究关于微生物组成、多样性、代谢功能及临床混杂因素的发现，对比肠道与口腔微生物组的预测价值，并评估现有证据的方法学局限性和转化前景。",
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::ba084eb01ffbfae5b25958c7"
          ],
          "author_chapter_id": "Ch7",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json",
          "raw_source_handle": "P0566"
        },
        {
          "atom_id": "atom::e8730e7cd201aaca9a764fdd",
          "source_handle": "P0566",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits"
          ],
          "value": {
            "contribution": "提供了肺癌 ICI 治疗中肠道与口腔微生物组预测价值的对比综述，明确了肠道微生物组更强的预测一致性，并指出了口腔微生物组的情境依赖性（仅在与化疗联用时可能有效）。",
            "limits": "作为叙事性综述，未应用 PRISMA 协议或正式偏倚风险评估；证据主要来自回顾性、单中心、小样本研究，缺乏前瞻性外部验证；SCLC 数据严重缺失；大多数研究未充分调整临床混杂因素。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::ba084eb01ffbfae5b25958c7"
          ],
          "author_chapter_id": "Ch7",
          "author_messages_path": "F:\\OptoMind-Review-2\\outputs\\guided_body_compact_auto_metadata_20261009_12cny\\LIVE\\stages\\author_007\\64c910a3a897b68c48b39fd88d4fd623cb88438f2742fba7317c27a24293bba7\\attempt_001\\MESSAGES.json",
