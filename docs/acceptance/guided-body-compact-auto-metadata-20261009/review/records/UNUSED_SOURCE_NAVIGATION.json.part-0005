          "field_path": [
            "review_planning_B",
            "broader_review_uses"
          ],
          "value": {
            "material": "提到了Blautia obeum与ICI结肠炎风险增加相关，Bacteroides具有双重效应；FDA关于FMT严重不良事件的警告。"
          },
          "role": "evidence",
          "snapshot_ids": [
            "snapshot::b4fe98bf4129f2a01928c2de",
            "snapshot::49f12e61cfb8da920f6cf528"
          ],
