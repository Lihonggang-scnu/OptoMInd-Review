qwen3.5-plus\",\"id\":\"chatcmpl-6ec1a668-ec8a-972a-8d53-031c69f2fb29\"}\n\ndata: {\"choices\":[{\"finish_reason\":\"stop\",\"delta\":{\"content\":\"\",\"reasoning_content\":null},\"index\":0,\"logprobs\":null}],\"object\":\"chat.completion.chunk\",\"usage\":null,\"created\":1791557142,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-6ec1a668-ec8a-972a-8d53-031c69f2fb29\"}\n\ndata: {\"choices\":[],\"object\":\"chat.completion.chunk\",\"usage\":{\"prompt_tokens\":306254,\"completion_tokens\":6947,\"total_tokens\":313201,\"completion_tokens_details\":{\"reasoning_tokens\":3483,\"text_tokens\":6947},\"prompt_tokens_details\":{\"text_tokens\":306254}},\"created\":1791557142,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-6ec1a668-ec8a-972a-8d53-031c69f2fb29\"}\n\ndata: [DONE]\n\n",
