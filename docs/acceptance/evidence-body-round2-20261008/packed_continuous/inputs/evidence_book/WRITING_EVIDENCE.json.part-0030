    "atom::f2c2a7eec715004d62365d9e": {
      "atom_id": "atom::f2c2a7eec715004d62365d9e",
      "source_handle": "P0122",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于构建综述中关于“微生物如何远程调节免疫系统”的理论章节，支持微生物作为免疫调节剂而非单纯抗原的观点。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::73efa1be4be250cf312dbe783dc8f3712f715ee79db5c885e78434ea239597d8",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::426415760d470b58531c9cb98c0207c1a993c9225e3b5030e058e6a1c174d116",
      "multiple_values_in_field": true
    },
    "atom::28d75a84749b754609b5e997": {
      "atom_id": "atom::28d75a84749b754609b5e997",
      "source_handle": "P0122",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究为早期相位（Phase I/II）试验，主要终点是安全性和定植，而非客观缓解率（ORR）或总生存期（OS）。因此，任何关于“MET4提高ICI疗效”的推论均缺乏直接临床结局数据支持，仅能推断其具备免疫激活潜力。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73efa1be4be250cf312dbe783dc8f3712f715ee79db5c885e78434ea239597d8",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::0c64ef8af6b5d025d357ca838817f5be149889a42fea4d7816b0d39fb2cced8e",
      "multiple_values_in_field": true
    },
    "atom::a102ea7c99ecf5904b039720": {
      "atom_id": "atom::a102ea7c99ecf5904b039720",
      "source_handle": "P0122",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗体反应的高变异性（仅5人显示高反应）提示个体差异极大，外推至一般人群时需考虑宿主基线免疫状态的影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73efa1be4be250cf312dbe783dc8f3712f715ee79db5c885e78434ea239597d8",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0c64ef8af6b5d025d357ca838817f5be149889a42fea4d7816b0d39fb2cced8e",
      "multiple_values_in_field": true
    },
    "atom::d77f50d5341d6ed41b9423ff": {
      "atom_id": "atom::d77f50d5341d6ed41b9423ff",
      "source_handle": "P0122",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "IgG结合分选实验中提到的“保留率偏差”意味着未被检测到的菌种可能同样具有免疫原性，解读“谁激发了抗体”时需保持谨慎，避免绝对化结论。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73efa1be4be250cf312dbe783dc8f3712f715ee79db5c885e78434ea239597d8",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::0c64ef8af6b5d025d357ca838817f5be149889a42fea4d7816b0d39fb2cced8e",
      "multiple_values_in_field": true
    },
