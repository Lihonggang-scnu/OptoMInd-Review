            "aliases"
          ]
        }
      ],
      "variant_group": "field::fd686dabf21491d67d2d922b0bcb23d64c80790a9af48284b5f69023d1053c7f",
      "multiple_values_in_field": false
    },
    "atom::34fba25ca01d8cc9a99d4b85": {
      "atom_id": "atom::34fba25ca01d8cc9a99d4b85",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性队列设计。收集接受ICI治疗的癌症患者粪便样本。使用16S rRNA测序和MGS进行微生物组分析。定义七个基于文献的预设细菌组（包括致病菌组和Ruminococcaceae等）。使用多种统计工具（ANCOM-BC, LinDA, MaAsLin2, ALDEx2）进行差异丰度分析，以寻找跨工具一致的结果。通过逻辑回归和线性混合效应模型评估细菌组与严重irAE的关联，并校正ICI类型。比较有/无严重irAE患者在基线、治疗早期、irAE发作时及免疫抑制后的微生物组特征。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::297767f084bc80ce180ec3be205c91c8cabef295ccfd3c720d7eaa20efce7b81",
      "multiple_values_in_field": false
    },
    "atom::81d1197be7aa905b288e7880": {
      "atom_id": "atom::81d1197be7aa905b288e7880",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了大样本（195例）前瞻性数据，证实了Ruminococcaceae科的动态减少与严重irAE的相关性，特别是在irAE发作时的显著降低。",
        "limits": "基线致病菌组的高RA关联在多重检验校正后不显著；部分低丰度菌群的差异结果需谨慎解读；无法区分菌株特异性效应；样本量对于解析复杂的多重交互作用仍显不足。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::bdea12e32fc9ab5b17ac017e007735230d312c88b8828cbe10895cbeddb45134",
      "multiple_values_in_field": false
    },
    "atom::c2a3cf5d3e5f4ec9f74e46c7": {
      "atom_id": "atom::c2a3cf5d3e5f4ec9f74e46c7",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线（ICI治疗前）",
        "finding": "发生严重irAE的患者中，预设的致病菌组（pathobionts）平均RA显著高于未发生者（8.2% vs 4.8%; OR 1.40; 95%CI 1.07-1.87），但该关联在多重检验校正后失去统计学显著性（校正p=0.059）。Ruminococcaceae科在两组间基线RA无显著差异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::59f4dd308278754cd1b1879d84ff47d62334229c7c7e5e58e85d3064abe7a576",
      "multiple_values_in_field": true
    },
    "atom::945c11493df532310035578f": {
      "atom_id": "atom::945c11493df532310035578f",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "治疗早期（从基线到第2周期）",
        "finding": "发生严重irAE的患者中，Ruminococcaceae科的RA下降幅度显著大于未发生者（交互作用粗p=0.018，校正p=0.123）。然而，发生组内的下降本身未达到统计学显著性（粗p=0.078）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::59f4dd308278754cd1b1879d84ff47d62334229c7c7e5e58e85d3064abe7a576",
      "multiple_values_in_field": true
    },
    "atom::4a8e73e66868ae4bfdc82e5a": {
      "atom_id": "atom::4a8e73e66868ae4bfdc82e5a",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "严重irAE发作时",
        "finding": "与所有其他时间点相比，发生严重irAE的患者中Ruminococcaceae科、Ruminococcus属以及R. bromii和R. callidus物种的RA显著降低。Haemophilus属及其种H. parainfluenzae在irAE发作时的RA显著升高。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::59f4dd308278754cd1b1879d84ff47d62334229c7c7e5e58e85d3064abe7a576",
      "multiple_values_in_field": true
    },
    "atom::a7ef9c7e8453fccfc36f88ca": {
      "atom_id": "atom::a7ef9c7e8453fccfc36f88ca",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "empirical",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::83a0c714efbe52bf8b01475e3a5bc98ac21e0fbb09d1a8bb26f54009e3108fc5",
      "multiple_values_in_field": false
    },
    "atom::be70156d57df0f79b02acfcc": {
      "atom_id": "atom::be70156d57df0f79b02acfcc",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管已知肠道微生物组可能影响ICI疗效，但其与严重irAEs的关联尚不明确，且既往研究结果存在冲突。本研究试图确定基线微生物特征或治疗期间的动态变化是否能预测严重irAEs，并探索潜在的病理生理机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::ff0b2dc86d8237e42e38ebb0b9043b7401f3a886621c75af581dc7ced51ba7e9",
      "multiple_values_in_field": false
    },
    "atom::6ead9f1dbcba31cf6e1fc85d": {
      "atom_id": "atom::6ead9f1dbcba31cf6e1fc85d",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "荷兰乌得勒支大学医学中心进行的UNI-CIT前瞻性生物库研究中的癌症患者。研究对象为接受一线抗PD-1单药或抗PD-1联合抗CTLA-4治疗的实体瘤患者（主要为黑色素瘤和非小细胞肺癌）。样本包括治疗前基线、治疗早期（第2-3周期）、严重irAE发作时及免疫抑制治疗后的粪便样本。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::b19a5f6c82d4b122ab24e942ba8b7dea9176ac35e365b0eb7e1056156786f4c1",
      "multiple_values_in_field": false
    },
    "atom::68f4a1a3b76d7493fee0802b": {
      "atom_id": "atom::68f4a1a3b76d7493fee0802b",
      "source_handle": "P0049",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在评估肠道微生物组在免疫检查点抑制剂（ICI）治疗开始时的组成及其在治疗过程中的变化，是否与随后发生的严重免疫相关不良事件（irAEs，≥3级）相关。通过对195名患者的497个粪便样本进行16S rRNA基因测序和宏基因组鸟枪法测序（MGS），分析α/β多样性、特定分类群相对丰度（RA）及预设细菌组的差异。研究发现，虽然基线时致病菌组（pathobionts）的RA较高与严重irAE风险增加有关（但在多重检验校正后不再显著），但Ruminococcaceae科在发生严重irAE的患者中表现出更显著的下降趋势，且在irAE发作时其RA显著低于其他时间点。这表明以Ruminococcaceae减少为特征的微生物组失调可能预示严重irAE的发生。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::763a5c9066aee7a3d8409129500f3f0ffe6ee8d297f1d5ae6030b1775bd1f09e",
      "multiple_values_in_field": false
    },
    "atom::d1eff3f3296d14ed4028938e": {
      "atom_id": "atom::d1eff3f3296d14ed4028938e",
      "source_handle": "P0049",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了关于肠道微生物组动态变化（特别是Ruminococcaceae科的减少）与ICI诱导的严重毒性（irAEs）之间关联的直接实证证据。它强调了微生物组在irAE发病机制中的潜在角色，并指出了单一物种（如F. prausnitzii）研究的局限性，支持从群落水平（如科/属）或功能失衡角度理解irAEs。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::8f5fe3493b31e99570bd14b787bbee4f5bea9a72c1f65a5e88bc7056013694a2",
      "multiple_values_in_field": false
    },
    "atom::c252b5474d64d364cd7f3860": {
      "atom_id": "atom::c252b5474d64d364cd7f3860",
      "source_handle": "P0049",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅观察性关联，非因果证明；主要关注毒性而非直接疗效指标（如ORR/PFS）；结果受多重检验校正影响。",
        "contribution": "提供了肠道微生物组组成变化与ICI疗效/毒性关联的观察性证据。具体发现Ruminococcaceae科的减少与严重irAEs相关，提示微生物组状态可能调节宿主对ICI的反应谱（不仅限于抗肿瘤疗效，还包括毒性）。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::5c3922516405ad6829de6fb3c3ae6073b6f1bdc961062d22bc495c29766704be",
      "multiple_values_in_field": true
    },
    "atom::862ef559b97a8340c34dbb45": {
      "atom_id": "atom::862ef559b97a8340c34dbb45",
      "source_handle": "P0049",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论微生物组如何影响ICI的整体临床结局（疗效与毒性并存），作为微生物组介导ICI反应性的证据之一。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::279dd6bb67b36d726b0c0ab30d771648b90c585d08192bac41c2cb15c34086af",
      "multiple_values_in_field": true
    },
    "atom::4b929c4295eb40cb9ab14192": {
      "atom_id": "atom::4b929c4295eb40cb9ab14192",
      "source_handle": "P0049",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制推断为主，缺乏直接的分子机制验证（如代谢物测量或动物实验验证）；F. prausnitzii的具体作用在该研究中未得到明确支持（基线无差异）。",
        "contribution": "探讨了可能的机制线索：致病菌组富集和有益菌（Ruminococcaceae）减少导致的菌群失调（dysbiosis）可能促进炎症反应，从而引发irAEs。特别讨论了F. prausnitzii（产丁酸菌）在不同研究中的矛盾结果，暗示菌株特异性的重要性。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::31096503c68e72c641fcbe7ed505116ece99186d0990738573c5a0161d0ce396",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::5c3922516405ad6829de6fb3c3ae6073b6f1bdc961062d22bc495c29766704be",
      "multiple_values_in_field": true
    },
