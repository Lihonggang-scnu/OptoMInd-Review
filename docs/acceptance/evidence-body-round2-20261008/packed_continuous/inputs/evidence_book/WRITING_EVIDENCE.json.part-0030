    "atom::c965085c365ae58f031b3902": {
      "atom_id": "atom::c965085c365ae58f031b3902",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "探究肠道微生物组是否以及如何与胃肠道癌症患者接受免疫检查点抑制剂治疗后发生的免疫相关不良事件（irAEs）相关联，识别潜在的预测性生物标志物和代谢机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::34d45ba1364c9db3642c905848348b28403c7eb0ad977ede06d372d24ff4e897",
      "multiple_values_in_field": false
    },
    "atom::addc034e2e5b3e12e9cdb012": {
      "atom_id": "atom::addc034e2e5b3e12e9cdb012",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "95例接受免疫检查点抑制剂（ICI）治疗的晚期/不可切除胃肠道癌症（食管癌、胃癌、结直肠癌）患者；基线粪便样本宏基因组测序；分析肠道微生物组与免疫相关不良事件（irAEs）的关联。",
      "role": "evidence",
      "origins": [
