    "atom::06c366e630e21e39d4a70148": {
      "atom_id": "atom::06c366e630e21e39d4a70148",
      "source_handle": "P0017",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制推断基于功能预测和表型观察，未直接验证具体分子通路（如丁酸受体信号或特定炎症因子轴），属于假设性机制，需与其他机制研究相互印证。",
        "contribution": "提供了菌群介导ICIs相关结肠炎的因果机制线索。通过FMT实验证明特定菌群可直接导致结肠炎，并提示产丁酸菌减少和代谢通路改变可能是潜在机制。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8b8d965f22f748d8aea311269a6f0e2a9da275cc0c6a988a124e0c1cb0c546a2",
