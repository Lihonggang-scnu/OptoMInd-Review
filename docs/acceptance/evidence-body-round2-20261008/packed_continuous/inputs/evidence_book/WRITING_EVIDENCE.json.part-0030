      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "引用Spencer等人的研究，显示非标准化的商业益生菌补充剂在小鼠模型和人类队列中可能损害ICI反应，减少IFN-γ阳性T细胞。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1e84d153ee9b84bcfe58dd944d8134d501566e942ca006ee36320ec01cc920f6",
