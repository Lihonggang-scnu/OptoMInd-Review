    "atom::ad5a28fe0d2f3d68b7b8e60f": {
      "atom_id": "atom::ad5a28fe0d2f3d68b7b8e60f",
      "source_handle": "P0329",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "1. 数据收集：使用公开可用的418名NSCLC患者基线肠道微生物组物种谱数据。2. 模型构建：训练机器学习模型预测ICI响应（R vs NR），固定参数，在保留测试集上验证（AUC=0.62，OS曲线差异显著p<0.0001）。3. 筛选子集：聚焦于模型预测价值良好的257名患者。4. 模拟干预：在模型中模拟健康供体FMT和治疗性菌群组合添加到患者基线微生物组中的过程，考察不同定植比例（exposure-dependent）对预测响应概率的影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::7f4d4d07befb7d6373432503421be51449af575c09ed4e7fa4907f8aec9d5a46",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::6de1ff6518d37640887b6d065d63da34a94bf65f00b575271b8fe3dc30b88054",
      "multiple_values_in_field": false
    },
    "atom::8dd8758eb8f26ba40de0493c": {
      "atom_id": "atom::8dd8758eb8f26ba40de0493c",
      "source_handle": "P0329",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了一个基于基线微生物组预测ICI响应的机器学习框架，并证实了在特定患者亚群中，通过模拟FMT或定制菌群可提升预测响应率。",
        "limits": "所给摘要未交代具体的机器学习算法类型、特征选择细节、治疗性菌群的具体组成成分、菌株分离的具体进展以及临床转化的时间表。仅基于回顾性数据的模拟，非前瞻性临床试验结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
