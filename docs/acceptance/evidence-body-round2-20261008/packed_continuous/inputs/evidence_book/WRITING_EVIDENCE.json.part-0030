    "atom::bd22fb14494e0354503b38df": {
      "atom_id": "atom::bd22fb14494e0354503b38df",
      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "介绍了肠道微生物组作为“第二基因组”的概念，及其通过GALT、代谢物和MAMPs调节全身免疫的基础理论。定义了益生菌、益生元、后生元和FMT的区别。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1e84d153ee9b84bcfe58dd944d8134d501566e942ca006ee36320ec01cc920f6",
          "field_path": [
