    "atom::d275ef2f003aa6a533e723b5": {
      "atom_id": "atom::d275ef2f003aa6a533e723b5",
      "source_handle": "P0595",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "实体瘤患者常合并多种基础疾病，药物相互作用（如acetohydroxamic-acid）可能加剧ICI毒性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e3f4c8dec02f81414a28625ade0beb1ba34d1cbb54b717e6ac5f1c667bd97525",
          "field_path": [
