            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::bdb79b05a95b208d12fdf9107a191a26b2f71700257d2723579c5c699eeab7ee",
      "multiple_values_in_field": true
    },
    "atom::b4bed6075da6fb337a1b29ef": {
      "atom_id": "atom::b4bed6075da6fb337a1b29ef",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Preclinical mouse models",
        "finding": "Specific commensals (e.g., Bifidobacterium spp., Akkermansia muciniphila, Bacteroides fragilis) enhance anti-PD-1 or anti-CTLA-4 efficacy via dendritic cell activation, STING pathway signaling, and modulation of T-cell subsets."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::eb5aa52fd3ffd49fe0ad1176a0c3eb40913425af4d4bd49464d5d0d575e08488",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::9e91a3b1e00de9fc0c422d0a190b4780294f9e83420ff3a54b0fd3c2a86afe05",
      "multiple_values_in_field": true
    },
    "atom::9c9912d42b9680ae59616b6d": {
      "atom_id": "atom::9c9912d42b9680ae59616b6d",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Human observational studies (Melanoma, NSCLC, RCC)",
        "finding": "Responders to ICIs often show higher abundance of specific taxa (e.g., Faecalibacterium, Ruminococcaceae, A. muciniphila), but there is no consensus on a universal predictive signature due to cohort-specific variations, geographic differences, and methodological heterogeneity."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
            "study_summary_A",
            "key_findings",
