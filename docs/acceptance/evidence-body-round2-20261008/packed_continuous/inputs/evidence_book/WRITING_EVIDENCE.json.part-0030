    "atom::92911391202391ebe6b83c2e": {
      "atom_id": "atom::92911391202391ebe6b83c2e",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "论文强调的是微生物诱导自身免疫（负面效应或病理机制），而 ICI 旨在激活抗肿瘤免疫（正面效应），两者在临床结局上可能相反，需注意机制与结果的区分。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::659fbe964878d15df72b15ba55faae47e6d3e7d99fd9bc5ddf6fcf498acc2c72",
      "multiple_values_in_field": true
    },
    "atom::e30c47c80f2eb5e6aa54fd6e": {
      "atom_id": "atom::e30c47c80f2eb5e6aa54fd6e",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "毒力因子的鉴定基于序列同源性，其实际生物学功能需在活体中验证，综述中引用时应注明这是预测性数据。",
      "role": "evidence",
      "origins": [
