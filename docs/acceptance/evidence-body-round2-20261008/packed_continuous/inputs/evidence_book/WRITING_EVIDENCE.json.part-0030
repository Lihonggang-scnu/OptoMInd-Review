      "multiple_values_in_field": true
    },
    "atom::d0a4b14c69acf2eb85337178": {
      "atom_id": "atom::d0a4b14c69acf2eb85337178",
      "source_handle": "P0601",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定基因功能与序列分析",
        "finding": "发现编码尿素酰胺水解酶（AAH）的基因，其产物包含与小鼠心脏肌球蛋白重链 α 亚基高度同源的表位（BAC 25-40），且该表位在另一 B. infantis 菌株中保守存在。"
      },
      "role": "evidence",
      "origins": [
        {
