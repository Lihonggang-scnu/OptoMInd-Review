          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::7c58f4adef0538e7049907c90a9c40669631b9f660426bf2b02a4edc8eccb145",
      "multiple_values_in_field": true
    },
    "atom::cea693d96ee129bf17264c8b": {
      "atom_id": "atom::cea693d96ee129bf17264c8b",
      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于讨论ICI治疗的安全性与微生物组的关联，特别是在评估益生菌作为辅助疗法时的风险收益比。",
      "role": "planning",
      "origins": [
        {
