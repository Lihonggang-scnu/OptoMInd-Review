      "variant_group": "field::33c4db576134898808ea9505e7b16c52b857356a370f24683657a2caffe3aa72",
      "multiple_values_in_field": true
    },
    "atom::40cde84a3d04b6be8e41787a": {
      "atom_id": "atom::40cde84a3d04b6be8e41787a",
      "source_handle": "P0595",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "结论主要针对心肌炎，不可泛化为所有ICI相关免疫不良反应的共同机制。",
      "role": "evidence",
      "origins": [
