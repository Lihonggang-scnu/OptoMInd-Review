      ],
      "value": "用于综述中讨论肠道菌群作为ICIs治疗反应预测因子的部分，特别是区分疗效与毒性（irAEs）的不同菌群特征时。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::8b8d965f22f748d8aea311269a6f0e2a9da275cc0c6a988a124e0c1cb0c546a2",
