            "0"
          ]
        }
      ],
      "variant_group": "field::aa13bb333d0b3adfc4c7a5b6a9752ba526521fec724c48e46e0fb34c69401ae3",
      "multiple_values_in_field": true
    },
    "atom::097ce1c7acf039f50668de70": {
