    "atom::94d50912fa44c41d58ffaf18": {
      "atom_id": "atom::94d50912fa44c41d58ffaf18",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "前瞻性队列研究设计。纳入95例接受PD-1/PD-L1抑制剂（单药或联合CTLA-4抑制剂）治疗的GI癌症患者。收集基线粪便样本进行宏基因组鸟枪法测序。使用MaAsLin2进行差异物种和通路分析，PERMANOVA评估混杂因素，Wilcoxon秩和检验比较组间差异。按irAE严重程度（轻症vs重症）、癌症类型（食管/胃/结肠）及特定器官毒性（皮肤/血液/内分泌/肝脏）进行分层分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::a6eb6da292def941042d7e3367ba2411b091f7c8b10178c2eb27ed0125809380",
      "multiple_values_in_field": false
    },
    "atom::8e654486045065fb54b27c79": {
      "atom_id": "atom::8e654486045065fb54b27c79",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了胃肠道癌症（食管、胃、结肠）背景下，基线肠道微生物组与irAEs发生及严重程度的具体关联谱，包括特定菌种（如R. callidus, B. xylanisolvens）和代谢通路（尿素循环）。揭示了不同癌症类型和器官特异性毒性具有独特的微生物特征。",
        "limits": "样本量较小（n=95），缺乏外部验证队列。未进行因果机制的实验验证（如动物模型或体外实验）。结果主要基于相关性分析，无法确立因果关系。不同癌症类型的异质性可能导致微生物标志物的特异性较强，通用性受限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::ddb88ecc14fb448049f4eadca82c67d93033df49fbea67e071c64783c3eea88c",
      "multiple_values_in_field": false
    },
    "atom::53bef823014e951415c37a47": {
      "atom_id": "atom::53bef823014e951415c37a47",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "所有GI癌症患者总体比较（有vs无irAEs）",
        "finding": "整体α和β多样性无显著差异。Clostridium hathewayi, Ruminococcus torques等富集于无irAEs组；Bifidobacterium dentium, Rothia mucilaginosa等富集于irAEs组。尿素循环（PWY-4984）和瓜氨酸生物合成通路富集于无irAEs组。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::847c24732b406be0f158ec0cd84911b1bac0605f87ba4cfacc8e0807f1d8587e",
      "multiple_values_in_field": true
    },
    "atom::d43d4aced5ec8f4e8c1052fe": {
      "atom_id": "atom::d43d4aced5ec8f4e8c1052fe",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "irAEs严重程度比较（轻症Grade 1-2 vs 重症Grade ≥3）",
        "finding": "Ruminococcus callidus和Bacteroides xylanisolvens在无重症irAEs患者中显著富集，有助于区分重症人群。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::847c24732b406be0f158ec0cd84911b1bac0605f87ba4cfacc8e0807f1d8587e",
      "multiple_values_in_field": true
    },
    "atom::0e0d6cd2fb9007d7666a16f8": {
      "atom_id": "atom::0e0d6cd2fb9007d7666a16f8",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同癌症类型分层",
        "finding": "食管癌：R. torques富集于无irAEs组，Dialister invisus富集于高irAE组；谷氨酰胺生物合成通路在高irAE组富集。胃癌：乳酸杆菌科、双歧杆菌科等益生菌及丁酸产生菌富集于无/低irAE组。结肠癌：Bacteroides stercoris富集于高irAE组；精氨酸生物合成通路在低irAE组富集。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::847c24732b406be0f158ec0cd84911b1bac0605f87ba4cfacc8e0807f1d8587e",
      "multiple_values_in_field": true
    },
    "atom::f913c3f2f3b926febe78b1c5": {
      "atom_id": "atom::f913c3f2f3b926febe78b1c5",
      "source_handle": "P0011",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定器官毒性比较",
        "finding": "皮肤毒性：甘油降解和尿素循环通路富集于无皮肤irAEs组。血液毒性：尿素循环和瓜氨酸生物合成通路富集于无血液irAEs组。内分泌毒性：肠铁菌素生物合成通路富集于无内分泌irAEs组。肝脏毒性：尿素循环和瓜氨酸生物合成通路富集于无肝毒性irAEs组。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9434601012338f320affc14b004fedd527e07481e307d66fd6a26b18e6d628cf",
