          ]
        }
      ],
      "variant_group": "field::9e91a3b1e00de9fc0c422d0a190b4780294f9e83420ff3a54b0fd3c2a86afe05",
      "multiple_values_in_field": true
    },
    "atom::db8e6cda2084f9d7f422abcc": {
      "atom_id": "atom::db8e6cda2084f9d7f422abcc",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Antibiotic use during ICI therapy",
        "finding": "Broad-spectrum antibiotic use is consistently associated with reduced progression-free survival and overall survival in ICI-treated patients, likely due to depletion of beneficial microbes."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
