    "atom::a739c61fbf53de449aab1e2b": {
      "atom_id": "atom::a739c61fbf53de449aab1e2b",
      "source_handle": "P0122",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "若综述涉及微生物-宿主互作检测技术，此文提供了具体的实验设计范例，特别是如何区分特异性结合与非特异性背景。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::73efa1be4be250cf312dbe783dc8f3712f715ee79db5c885e78434ea239597d8",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::426415760d470b58531c9cb98c0207c1a993c9225e3b5030e058e6a1c174d116",
      "multiple_values_in_field": true
    },
    "atom::04daf3518eaf2243919fef62": {
      "atom_id": "atom::04daf3518eaf2243919fef62",
      "source_handle": "P0122",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "讨论了“adjuvant taxa”（佐剂样菌）概念，即某些菌通过模式识别受体激活APC，进而引发广泛的系统性免疫反应，甚至包括针对其他菌的抗体。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73efa1be4be250cf312dbe783dc8f3712f715ee79db5c885e78434ea239597d8",
          "field_path": [
