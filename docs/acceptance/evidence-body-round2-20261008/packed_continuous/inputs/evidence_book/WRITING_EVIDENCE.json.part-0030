    "atom::0301fdfc5b3304e94489ae94": {
      "atom_id": "atom::0301fdfc5b3304e94489ae94",
      "source_handle": "P0601",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基因组注释与 VFDB 比对",
        "finding": "鉴定出 623 个潜在毒力因子基因，其中 18 个为该菌株特有（包括粘附素、侵袭素等），225 个与致病菌株共有。"
      },
      "role": "evidence",
      "origins": [
