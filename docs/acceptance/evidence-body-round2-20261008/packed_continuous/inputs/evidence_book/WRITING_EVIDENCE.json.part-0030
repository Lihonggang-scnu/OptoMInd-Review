    },
    "atom::8c0c0f5f0e2fb809fce77a59": {
      "atom_id": "atom::8c0c0f5f0e2fb809fce77a59",
      "source_handle": "P0595",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "ICI-MC是ICI治疗中最致命的免疫相关不良事件之一，理解其机制对于评估ICI在实体瘤治疗中的整体获益-风险比至关重要。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e3f4c8dec02f81414a28625ade0beb1ba34d1cbb54b717e6ac5f1c667bd97525",
