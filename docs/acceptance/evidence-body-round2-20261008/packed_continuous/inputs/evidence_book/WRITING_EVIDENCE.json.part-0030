    "atom::bac4dadcab9216e74454e8af": {
      "atom_id": "atom::bac4dadcab9216e74454e8af",
      "source_handle": "P0308",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制证据主要为相关性（微生物丰度、基因表达、血清代谢物与临床表型的关联）和文献支持的通路推断，尚未通过干预实验确证因果关系。",
        "contribution": "揭示了微生物组影响irAEs的潜在机制：非irAEs患者中甲萘醌（Vitamin K2）生物合成增强，且血清中甲萘醌水平更高；关联分析提示甲萘醌可能通过抑制NF-κB促炎通路发挥作用。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cba66b07106aef6edf937b84257ddd41cae6b95446b25f99102db710c36f64d7",
          "field_path": [
