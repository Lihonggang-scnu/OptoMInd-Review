            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::8c93f42ed55f55daf0158d471e738cd9df3dd4ca8b7b79e249c4ee78bdef4efd",
      "multiple_values_in_field": true
    },
    "atom::2151952a4c6ff4b033e7e506": {
      "atom_id": "atom::2151952a4c6ff4b033e7e506",
      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "大部分机制细节源自小鼠模型（germ-free mice, gnotobiotic models）。人类体内确切的因果链条尚未完全确立，许多通路在人体中的确切贡献度和主导性尚不明确。不同菌株的作用机制可能存在显著差异，综述中的机制概括可能掩盖菌株特异性。",
        "contribution": "详细描述了益生菌调节免疫的具体分子和细胞机制：1）通过SCFAs激活GPCRs并抑制HDAC，促进Treg分化或增强CD8+ T细胞功能；2）通过AhR通路调节色氨酸代谢；3）通过STING通路激活DC和巨噬细胞，促进M1极化；4）通过分子模拟（molecular mimicry）交叉激活T细胞。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1e84d153ee9b84bcfe58dd944d8134d501566e942ca006ee36320ec01cc920f6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::6e75af540e1165fa53a1929a64fb791241d785928d4e9b0f5c82b9b73ef68270",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::7c58f4adef0538e7049907c90a9c40669631b9f660426bf2b02a4edc8eccb145",
      "multiple_values_in_field": true
    },
    "atom::07c0b04ceee82bc5534c322c": {
      "atom_id": "atom::07c0b04ceee82bc5534c322c",
      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“介导效应的机制”子问题。提供了从肠道局部到全身系统性免疫调节的详细路径图，解释了微生物如何影响T细胞活化、耗竭及肿瘤浸润。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1e84d153ee9b84bcfe58dd944d8134d501566e942ca006ee36320ec01cc920f6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::6e75af540e1165fa53a1929a64fb791241d785928d4e9b0f5c82b9b73ef68270",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::8c93f42ed55f55daf0158d471e738cd9df3dd4ca8b7b79e249c4ee78bdef4efd",
      "multiple_values_in_field": true
    },
    "atom::4e3e5363e3b1e6060c91a4ba": {
      "atom_id": "atom::4e3e5363e3b1e6060c91a4ba",
      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "临床数据矛盾且不充分。动物模型结果不能直接外推至人类。缺乏大规模RCT数据支持益生菌对irAEs的确切保护作用。",
        "contribution": "分析了益生菌对ICI诱导的免疫相关不良事件（irAEs）的双向影响，指出某些菌株可能减轻结肠炎，而其他情况下可能增加毒性或无显著影响。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1e84d153ee9b84bcfe58dd944d8134d501566e942ca006ee36320ec01cc920f6",
          "field_path": [
