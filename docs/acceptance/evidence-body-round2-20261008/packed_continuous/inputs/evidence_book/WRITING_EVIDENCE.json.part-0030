      "source_handle": "P0329",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是基于计算机模拟的结果，非体内或体外实验验证。所给摘要未交代具体的分子机制（如抗原呈递、炎症调节等），仅停留在表型预测层面。",
        "contribution": "提出了通过“恢复响应者样微生物组特征”来克服ICI无响应的设计策略，并通过模拟证明了FMT和定制菌群的潜在有效性。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
