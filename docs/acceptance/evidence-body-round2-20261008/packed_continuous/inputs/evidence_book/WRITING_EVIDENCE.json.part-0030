    "atom::49b20d1fa55e0cba3809b746": {
      "atom_id": "atom::49b20d1fa55e0cba3809b746",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为方法论参考，说明如何利用基因组数据预测微生物的免疫调节潜力。在综述中可提及，未来研究可能需要对 ICI 响应者的微生物组进行类似的深度功能注释，以寻找潜在的免疫调节标志物。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::183cbefaf05490409078468de44ff06fc1585ae2c74067c0895ee42d93cdb0db",
      "multiple_values_in_field": true
    },
    "atom::ca60f5f8ef03691a49b77099": {
      "atom_id": "atom::ca60f5f8ef03691a49b77099",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该机制针对的是器官特异性自身免疫（心肌炎），而非肿瘤免疫监视的直接增强或抑制。不能直接外推为 ICI 疗效的促进或阻碍机制，仅作为微生物-宿主免疫互作的理论模型支持。",
        "contribution": "提供了分子模拟作为微生物调节宿主免疫反应的具体分子机制案例。论文详细描述了细菌来源的 AAH 蛋白中包含与宿主心脏肌球蛋白高度同源的表位，这解释了微生物抗原如何可能被免疫系统误认为自身抗原，从而引发交叉反应性 T 细胞激活。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::a345e194117b5b32750edc7fe5f1f74aaa9ef502684f3f9adce037a46705296c",
      "multiple_values_in_field": true
    },
    "atom::7426d1ebd25ce4959f4f5801": {
      "atom_id": "atom::7426d1ebd25ce4959f4f5801",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于解释微生物成分如何通过结构相似性干扰或调节宿主的免疫耐受状态。在讨论 ICI 疗效时，可作为极端案例或机制参照，说明某些微生物抗原可能通过分子模拟诱发自身免疫样反应，进而影响整体免疫环境。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::73666581dd3f9ddd28db2aaed25e84648767e0b7f59dd4b12963a4fe806a5141",
      "multiple_values_in_field": true
    },
    "atom::3048963d8c86796088cbb523": {
      "atom_id": "atom::3048963d8c86796088cbb523",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该细菌来源于海洋，非人体常驻菌群，其在人体内的定植能力和对 ICI 治疗的直接影响未知。此贡献主要用于概念上的扩展，而非直接证据。",
        "contribution": "展示了非肠道来源的细菌（海洋芽孢杆菌）携带完整的毒力因子谱（如粘附素、侵袭素、转运蛋白），表明即使是环境或非典型共生菌也可能具备复杂的宿主互作能力。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::a345e194117b5b32750edc7fe5f1f74aaa9ef502684f3f9adce037a46705296c",
      "multiple_values_in_field": true
    },
    "atom::e1386bad53907209aad56453": {
      "atom_id": "atom::e1386bad53907209aad56453",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于拓宽综述中对“微生物群”定义的视野，提示除了肠道菌群外，其他部位的微生物或环境微生物也可能通过其毒力因子影响全身免疫状态，进而间接影响抗肿瘤免疫治疗的环境。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
            "review_planning_B",
