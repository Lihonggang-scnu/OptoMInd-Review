    "atom::5d0e8612c6170ba2e46da88b": {
      "atom_id": "atom::5d0e8612c6170ba2e46da88b",
      "source_handle": "P0601",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "在综述中讨论微生物群对免疫系统的广泛影响时，可引用此例说明微生物抗原如何打破免疫耐受。这对于理解 ICI 治疗期间可能出现的免疫相关不良反应（irAEs）具有参考价值，因为 irAEs 本质上也是自身免疫反应。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a3ce6157cdd1db2d54fcb611f08000dfabaa2f27bae9ef772a1d67142ab31cae",
          "field_path": [
