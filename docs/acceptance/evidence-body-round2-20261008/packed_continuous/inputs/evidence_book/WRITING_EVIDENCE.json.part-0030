    "atom::6830f3216aaff9dac057e352": {
      "atom_id": "atom::6830f3216aaff9dac057e352",
      "source_handle": "P0357",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "强调了当前临床研究中益生菌制剂的非标准化、商业产品的标签准确性问题、以及饮食/抗生素/种族等混杂因素的复杂性。提出了整合纵向多组学、ex vivo assays和gut-on-a-chip模型的必要性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1e84d153ee9b84bcfe58dd944d8134d501566e942ca006ee36320ec01cc920f6",
