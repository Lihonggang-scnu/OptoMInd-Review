            "paper_kind"
          ]
        },
        {
          "record_id": "record::7f4d4d07befb7d6373432503421be51449af575c09ed4e7fa4907f8aec9d5a46",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::ee7c54179099b1599a4562110ff333dc2813210d121ff0b7359c17bf507b0ec5",
      "multiple_values_in_field": false
    },
    "atom::b5b1d19764f6694dbdc7af78": {
      "atom_id": "atom::b5b1d19764f6694dbdc7af78",
      "source_handle": "P0329",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "现有研究中单个微生物物种与ICI响应的关联往往不可重复且统计效力不足；虽然FMT显示有益，但药物开发多集中于简单菌群组合。本研究试图在模型中复制FMT的治疗益处，并设计能够增强ICI响应的治疗性微生物组合。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::7f4d4d07befb7d6373432503421be51449af575c09ed4e7fa4907f8aec9d5a46",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::ceced51a5ca94f7631bb7c89dbef68dbd4f32a11e411373d9d8dd8548e11c1c5",
      "multiple_values_in_field": false
    },
    "atom::ae8542404f12e8b138fd3320": {
      "atom_id": "atom::ae8542404f12e8b138fd3320",
      "source_handle": "P0329",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "基于418名非小细胞肺癌（NSCLC）患者的基线肠道微生物组数据，构建机器学习模型以预测免疫检查点抑制剂（ICI）的响应情况；并在模拟环境中评估粪菌移植（FMT）及设计型活细菌疗法对ICI疗效的影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::7f4d4d07befb7d6373432503421be51449af575c09ed4e7fa4907f8aec9d5a46",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::06bf04c7fff7290b8c87c5ccc89dafe6ad50bfb2c4281bedf8d2810f0ee5d4f9",
      "multiple_values_in_field": false
    },
    "atom::4ae34442850db6176f0dc26c": {
      "atom_id": "atom::4ae34442850db6176f0dc26c",
      "source_handle": "P0329",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "该研究旨在解决个体微生物物种与ICI响应关联缺乏统计稳健性的问题，并探索通过微生物组干预改善ICI疗效的策略。作者利用418名NSCLC患者的基线微生物组数据训练了一个区分响应者（R）与非响应者（NR）的机器学习模型（AUC=0.62）。随后，在具有良好预测价值的子集（n=257）中，通过模拟实验评估了健康供体FMT和自定义治疗性菌群组合的效果。结果显示，增加FMT或治疗性菌群的定植比例可依赖性地提高模型预测的响应率。结论认为这些候选疗法有潜力改善ICI患者响应，目前正进行菌株分离培养以开发联合疗法。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::7f4d4d07befb7d6373432503421be51449af575c09ed4e7fa4907f8aec9d5a46",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::ac8ca62745509453ce41f0c34218d1bc7c909e24187e1e5caca41c28d4b6b7c7",
      "multiple_values_in_field": false
    },
    "atom::52690f071bd7b697f8226c7c": {
      "atom_id": "atom::52690f071bd7b697f8226c7c",
      "source_handle": "P0329",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了关于“微生物组介导ICI疗效”的一个具体计算生物学视角。它不侧重于单一机制的发现，而是提供了一个从微生物组特征到临床响应预测的建模流程，并展示了通过恢复“响应者样”微生物组特征（通过FMT或合成菌群）来改善预后的概念验证。这对于综述中讨论“如何通过调节微生物组增强ICI疗效”以及“预测生物标志物的开发”部分具有直接参考价值。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::7f4d4d07befb7d6373432503421be51449af575c09ed4e7fa4907f8aec9d5a46",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::502c67313504711f79b6b2ec7039da8eca7def34523a55fd3184026e6498f901",
      "multiple_values_in_field": false
    },
    "atom::8ac1b1eac700149a344ed443": {
      "atom_id": "atom::8ac1b1eac700149a344ed443",
      "source_handle": "P0329",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "模型性能中等（AUC 0.62），且仅在NSCLC队列中验证，外推至其他实体瘤需谨慎。所给摘要未交代模型的可解释性（即哪些具体菌群驱动了预测）。",
        "contribution": "提供了基于全谱微生物组而非单一物种的ICI响应预测模型构建方法，并量化了模型性能（AUC 0.62）。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::668c479a5777d8a189e172afde0bb392281a5fec0540a3d2c4af6ccd9b233809",
          "field_path": [
