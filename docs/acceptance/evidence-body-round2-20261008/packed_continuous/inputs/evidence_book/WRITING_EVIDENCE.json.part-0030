    "atom::009b8c762617bca488678bdf": {
      "atom_id": "atom::009b8c762617bca488678bdf",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "As a narrative review, the authors systematically summarize and categorize existing literature rather than conducting a new systematic meta-analysis. The approach involves: (1) reviewing preclinical mouse models to establish causal links between specific bacteria and ICI response; (2) analyzing human observational cohort studies to identify associations between microbiota composition (taxa and diversity) and clinical outcomes (response vs. non-response); (3) synthesizing proposed biological mechanisms (T-cell activation, mimicry, metabolites); and (4) evaluating early-phase clinical trial data for microbiome interventions (FMT, consortia, diet). The review explicitly compares findings across different studies to highlight inconsistencies in biomarker discovery and emphasizes the need for standardized methodologies.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::eb5aa52fd3ffd49fe0ad1176a0c3eb40913425af4d4bd49464d5d0d575e08488",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::da99c8cd2166e61170986eba40aeb48ac357394b3d7db853b4c9fceae44af7e8",
      "multiple_values_in_field": false
    },
    "atom::45cafb54dc0b22611aed0da9": {
      "atom_id": "atom::45cafb54dc0b22611aed0da9",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive synthesis of preclinical and clinical evidence linking the gut microbiome to ICI efficacy and toxicity, categorizing mechanisms into three distinct themes.",
        "limits": "As a narrative review, it does not perform a quantitative meta-analysis; it highlights the lack of consensus in human biomarker studies rather than resolving it."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::eb5aa52fd3ffd49fe0ad1176a0c3eb40913425af4d4bd49464d5d0d575e08488",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::bdb79b05a95b208d12fdf9107a191a26b2f71700257d2723579c5c699eeab7ee",
      "multiple_values_in_field": true
    },
    "atom::d12797a4caef170c2b7834bb": {
      "atom_id": "atom::d12797a4caef170c2b7834bb",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Critically evaluates the limitations of current human studies, including small sample sizes, geographic biases, and analytical pipeline differences, advocating for standardized large-scale datasets.",
        "limits": "Does not provide definitive answers on which specific microbial signatures are universally predictive across all solid tumor types."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::eb5aa52fd3ffd49fe0ad1176a0c3eb40913425af4d4bd49464d5d0d575e08488",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::bdb79b05a95b208d12fdf9107a191a26b2f71700257d2723579c5c699eeab7ee",
      "multiple_values_in_field": true
    },
    "atom::9a0404a5b8c8e5b2a74dec45": {
      "atom_id": "atom::9a0404a5b8c8e5b2a74dec45",
      "source_handle": "P0261",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Summarizes early-phase clinical trial data for various microbiome interventions (FMT, consortia, diet), offering a landscape of current therapeutic developments.",
        "limits": "Most clinical trial data reported are from early-phase (I/II) studies with small sample sizes; long-term efficacy and safety profiles are not yet established."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c96dcd391e3ff6d5952be10a6f0f6ed8e2d52ea0f3fdaa391e1a2ae0d66832f1",
          "field_path": [
            "study_summary_A",
