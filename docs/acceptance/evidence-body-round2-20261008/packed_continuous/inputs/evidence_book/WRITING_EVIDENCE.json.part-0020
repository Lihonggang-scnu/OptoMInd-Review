            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::b2fb21c706a62c32789dc598c56bf313454a33bd38b2664a7aa6c5e79ed9ed23",
      "multiple_values_in_field": true
    },
    "atom::f2aaff59afaf42f21c967e5b": {
      "atom_id": "atom::f2aaff59afaf42f21c967e5b",
      "source_handle": "P0271",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节实体瘤中ICI的疗效”这一子问题。可作为证据说明某些特定细菌的存在与更好的临床结果（更长TTF）相关，或者相反，某些细菌与较差结果相关。可用于讨论不同研究中微生物组标志物不一致的原因（如人群差异、菌种特异性）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "review_planning_B",
