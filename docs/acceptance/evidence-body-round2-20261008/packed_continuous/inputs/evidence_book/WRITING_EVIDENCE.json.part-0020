      "multiple_values_in_field": false
    },
    "atom::bbf51165ebd9be173e979c8e": {
      "atom_id": "atom::bbf51165ebd9be173e979c8e",
      "source_handle": "P0578",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "早期研究表明FMT可能逆转ICI耐药，但其适用性在其他肿瘤类型中尚不明确，且关于患者选择、供体选择及给药方案的问题仍未解决。本研究试图回答：在ICI耐药的晚期实体瘤患者中，重复FMT是否安全可行，以及是否能通过微生物定植和免疫重塑来恢复ICI的疗效。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
