    "atom::1440b6c81c7ea354a5c0604d": {
      "atom_id": "atom::1440b6c81c7ea354a5c0604d",
      "source_handle": "P0583",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制主要在人类队列中通过相关性分析发现，并通过小鼠模型进行功能验证；不同肿瘤类型中富集的有益菌种类有限重叠，但有害菌清除模式一致。",
        "contribution": "阐明了FMT起效的潜在机制：响应者的获益主要依赖于基线有害细菌物种（如Enterocloster, Clostridium）的大量丢失，而非供体菌株的成功定植。这种丢失与血浆中色氨酸代谢产物（喹啉酸、犬尿氨酸）水平的降低以及效应性CD8+ T细胞的增加相关。动物实验证实，重新引入这些丢失的有害菌会阻断ICI疗效。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
