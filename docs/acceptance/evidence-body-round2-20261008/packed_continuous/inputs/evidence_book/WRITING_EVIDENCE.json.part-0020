    "atom::48e81723cf1694edffb2648d": {
      "atom_id": "atom::48e81723cf1694edffb2648d",
      "source_handle": "P0583",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管免疫检查点抑制剂改善了NSCLC和黑色素瘤的预后，但超过半数的患者存在原发性耐药。目前尚不清楚健康供体FMT联合抗PD-1（NSCLC）或抗PD-1联合抗CTLA-4（黑色素瘤）在一线治疗中的临床活性和安全性，以及FMT增强ICI疗效的人类机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::cc9c61313270bf8ed21449cda520e30abe029c0dc4128fb4e9405f0415b9f043",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::858e2e285637cdae2d18e8b523ced12f1d8ed904d7a295670a200334eaf41854",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::e0ab03ae8f4e8669b7c7052edd8c65b601d40b6be91f2e2e0e8f540e3873acc0",
          "field_path": [
