            "problem_or_question"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::af86a4933f431c439688158cb3555439202f7f27c0b4b04aa2e8d6c633706e39",
      "multiple_values_in_field": false
    },
    "atom::16c76a5912d11aab9f5c31be": {
      "atom_id": "atom::16c76a5912d11aab9f5c31be",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "非小细胞肺癌（NSCLC）患者中，肿瘤微环境（TME）介导的免疫检查点抑制剂（ICI）耐药机制、联合治疗策略及生物标志物框架。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::60b6f3ae285ec6a6791a1d53f18a816c29175ff1370143c2066199841aeead61",
      "multiple_values_in_field": false
    },
    "atom::f8fa25779ca4c2210b5be95b": {
      "atom_id": "atom::f8fa25779ca4c2210b5be95b",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本文是一篇叙事性综述，旨在将TME介导的ICI耐药视为一个相互连接的生物学过程，而非孤立因素的集合。文章系统梳理了免疫抑制细胞群、基质重塑、血管功能障碍、缺氧、代谢重编程以及抗原呈递缺陷和致癌驱动信号如何协同作用，形成免疫沙漠、免疫排斥或耗竭性炎症表型。在此基础上，综述评估了针对这些机制的联合治疗策略，区分了III期支持的临床标准与早期探索性方法，并提出了整合PD-L1、TMB、干扰素γ特征、空间组学、ctDNA等指标的操作化生物标志物框架，以指导NSCLC的精准免疫治疗。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
