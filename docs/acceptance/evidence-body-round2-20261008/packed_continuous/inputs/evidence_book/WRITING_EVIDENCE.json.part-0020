          "record_id": "record::60860a7689fed061bd39fe74b1fb64de44d7f85199418ada4c9f0738d255c811",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::121f0aee7f0a48353b5757c2f2e9c74ccb654109b084826164db8c7f7bce492e",
      "multiple_values_in_field": true
    },
    "atom::dc49577c38447b26cd3c70ca": {
      "atom_id": "atom::dc49577c38447b26cd3c70ca",
      "source_handle": "P0148",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Pathway-level inference from metagenomics. Causality of these pathways in driving response is not established.",
        "contribution": "Reports that responders also had higher abundance of pro-inflammatory pathways (LPS, heme synthesis), challenging the notion that only 'healthy' microbiomes predict response.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
