    },
    "atom::4b95e0954996ca9c4c8353c0": {
      "atom_id": "atom::4b95e0954996ca9c4c8353c0",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "日本晚期非小细胞肺癌（NSCLC）患者，接受免疫检查点抑制剂（ICI）治疗超过3个月的人群。样本量为17例，分为反应者（R, n=6）和非反应者（NR, n=11）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::d3d3338725bcb6af1d221f0aae9f1b361312ce703fcf11ad2cb0262219fa4fe8",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::fe5c600d9bf2b28e4f9f43203610a19132867cde5f76806ca84387d3caacfa8c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::8feb7d818d55c997e790471d37bb4c493790e66e34ad0ffbce681bcd8989aaaa",
      "multiple_values_in_field": false
    },
    "atom::9d388fc73384e2cb2f641bcf": {
      "atom_id": "atom::9d388fc73384e2cb2f641bcf",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在探讨肠道微生物组组成与晚期NSCLC患者对免疫检查点抑制剂（ICI）疗效之间的关联。研究回顾性分析了17名在日本京都府立医科大学接受ICI治疗且持续时间超过3个月的患者的粪便样本。通过16S rRNA基因测序分析肠道菌群多样性及物种丰度，并结合临床疗效数据（基于RECIST 1.1标准定义的响应状态及治疗失败时间TTF），比较了反应者与非反应者在肠道微生物组成上的差异，并评估特定细菌属的丰度与临床预后指标的相关性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "work_summary"
