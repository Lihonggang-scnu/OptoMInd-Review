        },
        {
          "record_id": "record::ceff59cf10840ae2fa4f87a4ff0663f65ba50bed0bb6e871a51e844548260048",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::d6c59c7209906b964f45677cc34339b00328cb8c7f57e1bacc86a1addc479774",
      "multiple_values_in_field": false
    },
    "atom::bfc280fdf99afe8f46ce98b5": {
      "atom_id": "atom::bfc280fdf99afe8f46ce98b5",
      "source_handle": "P0583",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "这是一项多中心、开放标签的II期临床试验（FMT-LUMINate），旨在评估单次口服胶囊FMT在启动ICI治疗前对原发性耐药患者的影响。研究纳入20名NSCLC患者和20名黑色素瘤患者。主要终点为NSCLC队列的客观缓解率（ORR）。结果显示，NSCLC队列ORR为80%，超过预设阈值；黑色素瘤队列ORR为75%。安全性方面，NSCLC组无3级及以上不良事件，而黑色素瘤组出现较早发的严重免疫相关不良反应（irAEs），特别是心肌炎，且与特定供体菌群有关。机制研究发现，响应者并非通过获得特定的供体菌株定植获益，而是通过显著清除基线存在的有害细菌物种（如Enterocloster和Clostridium属），从而降低色氨酸代谢途径活性并改善全身免疫微环境。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::cc9c61313270bf8ed21449cda520e30abe029c0dc4128fb4e9405f0415b9f043",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::858e2e285637cdae2d18e8b523ced12f1d8ed904d7a295670a200334eaf41854",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::e0ab03ae8f4e8669b7c7052edd8c65b601d40b6be91f2e2e0e8f540e3873acc0",
