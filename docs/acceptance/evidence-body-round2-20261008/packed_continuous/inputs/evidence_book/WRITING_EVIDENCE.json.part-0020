    "atom::0151b710263ede70d23b60e6": {
      "atom_id": "atom::0151b710263ede70d23b60e6",
      "source_handle": "P0273",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要是相关性观察，未详细区分抗生素种类、使用时机及具体影响的菌群通路。",
        "contribution": "指出抗生素使用（尤其是ICIs期间）与较差的PFS和OS相关，提示抗生素引起的菌群失调可能是导致免疫治疗耐药的一个因素。",
        "facet_id": "F2"
      },
      "role": "evidence",
