    },
    "atom::34aabb94a8abc243087e0187": {
      "atom_id": "atom::34aabb94a8abc243087e0187",
      "source_handle": "P0474",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节ICI疗效”的具体实例，展示有益菌和潜在有害菌在NSCLC中的不同表现。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
