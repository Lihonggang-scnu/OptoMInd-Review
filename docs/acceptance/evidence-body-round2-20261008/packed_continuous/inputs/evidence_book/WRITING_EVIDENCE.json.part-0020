    "atom::ed5a6fb37ba56ea7b2020e0c": {
      "atom_id": "atom::ed5a6fb37ba56ea7b2020e0c",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用回顾性队列设计。纳入标准为确诊为晚期NSCLC、接受ICI治疗时长>3个月的日本患者。收集治疗期间的单次粪便样本，使用Illumina MiSeq平台对16S rRNA基因的V1-V2区域进行测序。利用QIIME流程进行OTU聚类（97%相似度）和Alpha多样性分析。使用LEfSe算法识别反应者与非反应者之间显著差异的分类群。临床结局以治疗失败时间（TTF）为主要终点，使用Kaplan-Meier法和Log-rank检验分析特定细菌属的高/低丰度与TTF的关系。PD-L1表达通过商业实验室的22C3 pharmDx检测进行评估。统计使用EZR软件，P<0.05视为显著。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::d3d3338725bcb6af1d221f0aae9f1b361312ce703fcf11ad2cb0262219fa4fe8",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::fe5c600d9bf2b28e4f9f43203610a19132867cde5f76806ca84387d3caacfa8c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::36e0e258402ee983f38de6d805a8012cb184e50f60ddcc5118bae06f8f5463fa",
      "multiple_values_in_field": false
    },
    "atom::30994db1246f07559f22783a": {
      "atom_id": "atom::30994db1246f07559f22783a",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "在亚洲（日本）NSCLC人群中，初步识别出与ICI疗效相关的特定肠道细菌属（如Lactobacillus, Clostridium, Bilophila等），提供了微生物组作为潜在疗效生物标志物的观察性证据。",
        "limits": "样本量极小（仅17例），存在选择偏倚（仅纳入治疗>3个月的患者，可能排除早期进展或不耐受者）；单中心回顾性研究；仅采集单次粪便样本，无法反映治疗前后菌群动态变化；未控制抗生素使用等混杂因素的具体细节（虽记录但未深入校正）；部分关键图表不可读，具体统计细节受限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::d3d3338725bcb6af1d221f0aae9f1b361312ce703fcf11ad2cb0262219fa4fe8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::fe5c600d9bf2b28e4f9f43203610a19132867cde5f76806ca84387d3caacfa8c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::27ba60da51f5f8f997532bd8e350f14882a7418f5b951f6f913b0cc5ab550591",
      "multiple_values_in_field": false
    },
    "atom::6eb3e3f438183272bd01a339": {
      "atom_id": "atom::6eb3e3f438183272bd01a339",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "对比ICI反应者（n=6）与非反应者（n=11）的肠道菌群组成",
        "finding": "反应者的肠道菌群中乳酸杆菌（Lactobacillus）、梭菌属（Clostridium）和Syntrophococcus显著富集；非反应者中Bilophila、Sutterella和Parabacteroides显著富集。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::d3d3338725bcb6af1d221f0aae9f1b361312ce703fcf11ad2cb0262219fa4fe8",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::fe5c600d9bf2b28e4f9f43203610a19132867cde5f76806ca84387d3caacfa8c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::ca8f605401b0c3054f056a2b8bcf8bcc58c5ac6565981fcc72d9cab523bb51a3",
      "multiple_values_in_field": true
    },
    "atom::5c1fc9107c44ed6afb5b08d0": {
      "atom_id": "atom::5c1fc9107c44ed6afb5b08d0",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定细菌属丰度与治疗失败时间（TTF）的关系",
        "finding": "高丰度的Bilophila与显著延长的TTF相关（HR 6.27, P=0.0037）。高丰度的Lactobacillus和Clostridium倾向于延长TTF，但统计学上不显著（P分别为0.219和0.352）。Syntrophococcus高丰度也显示延长TTF的趋势（P=0.057）。Parabacteroides丰度与TTF无显著关联。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
