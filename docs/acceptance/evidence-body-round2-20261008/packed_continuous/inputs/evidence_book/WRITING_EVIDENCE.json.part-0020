    "atom::e849371241dc6a948cc4e054": {
      "atom_id": "atom::e849371241dc6a948cc4e054",
      "source_handle": "P0583",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物群如何调节实体瘤中ICI的疗效”，提供具体的临床响应率证据，支持FMT作为增敏策略的有效性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
