    "atom::cbe196816b698d3940dc59ad": {
      "atom_id": "atom::cbe196816b698d3940dc59ad",
      "source_handle": "P0148",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Helps explore the link between microbiome and immune toxicity (irAEs), which is a key aspect of ICI modulation. May inform strategies to manage side effects.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
