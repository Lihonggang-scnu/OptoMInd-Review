    "atom::f68ab6ce48799e6ca1058cd3": {
      "atom_id": "atom::f68ab6ce48799e6ca1058cd3",
      "source_handle": "P0578",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用单臂、开放标签的IIa期篮子试验设计。纳入标准包括ICI治疗后疾病进展、ECOG评分0-1及可测量病灶。供体需为ICI长期响应者（>12个月响应）。干预措施包括基线后第1周和第5周通过结肠镜进行两次FMT，随后在第14、30、78周可通过灌肠进行最多三次补充FMT。ICI治疗保持不变或重新引入。主要终点评估安全性和ORR（基于iRECIST）。次要终点包括可行性、临床获益率、无进展生存期（PFS）、总生存期（OS）、微生物定植（16S rRNA测序）、免疫反应（质谱流式细胞术分析PBMCs）及生物标志物（血清细胞因子）。统计分析采用描述性统计、Kaplan-Meier生存分析及Cox比例风险模型探索免疫特征与预后的关联，未进行多重检验校正。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::de6856b325f938438220cbe8b17903dd941239ef440c8510463fecefd670962a",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::2796f4a95907dc27585d9be6c34717031ccbf68aa1205c3f86aa55982b202416",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::27801c3cd738d669748966f524ca9c87b3851d68f863303f08556772aba11c25",
      "multiple_values_in_field": false
    },
    "atom::35e4bb77f5eebd2aa771b705": {
      "atom_id": "atom::35e4bb77f5eebd2aa771b705",
      "source_handle": "P0578",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "证实了在ICI耐药的晚期实体瘤患者中，使用ICI响应者供体的FMT是安全和可行的。提供了关于FMT后微生物定植动力学（短暂性）和系统性免疫景观（髓系抑制与T细胞活化）的详细生物标志物数据。",
        "limits": "样本量小（n=12），试验因入组缓慢提前终止。单臂设计无法确立因果关系，缺乏对照组。未能实现预期的临床疗效（无ORR），限制了对其机制解释的确定性。结果可能受到快速进展性疾病背景的影响，未能在足够长的时间内观察FMT的潜在延迟效应。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::de6856b325f938438220cbe8b17903dd941239ef440c8510463fecefd670962a",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::2796f4a95907dc27585d9be6c34717031ccbf68aa1205c3f86aa55982b202416",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::b666f9e19a38fa6f4c5e79aeaf30c28483821b8fd9d6789b650786712333852a",
      "multiple_values_in_field": false
    },
    "atom::59a3a7b73308240f96ffb39c": {
      "atom_id": "atom::59a3a7b73308240f96ffb39c",
      "source_handle": "P0578",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "12名ICI耐药晚期实体瘤患者，接受来自ICI响应者的FMT联合ICI治疗",
        "finding": "FMT安全性良好，无严重FMT相关不良事件导致停药，但50%患者出现免疫相关不良事件（irAEs），多数为轻度。客观缓解率（ORR）为0%，中位PFS为1.5个月，中位OS为10.1个月。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::de6856b325f938438220cbe8b17903dd941239ef440c8510463fecefd670962a",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::2796f4a95907dc27585d9be6c34717031ccbf68aa1205c3f86aa55982b202416",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::493392e3de775aab4ec6df0d6be0fcd6dc73f939d25de319ec964f0b48ea1cce",
      "multiple_values_in_field": true
    },
    "atom::da136020eae35e8a2dfc6af1": {
      "atom_id": "atom::da136020eae35e8a2dfc6af1",
      "source_handle": "P0578",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物组分析",
        "finding": "首次FMT后一周，大多数受体的微生物组向供体方向偏移（定植成功），但这种相似性在后续时间点大多下降，表明定植多为暂时性。仅1名获得临床获益的患者实现了持久的供体-受体微生物相似性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::de6856b325f938438220cbe8b17903dd941239ef440c8510463fecefd670962a",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::2796f4a95907dc27585d9be6c34717031ccbf68aa1205c3f86aa55982b202416",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::493392e3de775aab4ec6df0d6be0fcd6dc73f939d25de319ec964f0b48ea1cce",
      "multiple_values_in_field": true
    },
    "atom::0836a8c74dab91d3a0b4f4ce": {
      "atom_id": "atom::0836a8c74dab91d3a0b4f4ce",
      "source_handle": "P0578",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "免疫微环境分析",
        "finding": "基线时高度分化的T细胞环境（CD8+效应记忆T细胞和TEMRA）与改善的PFS和OS相关；而髓系偏倚环境和幼稚T细胞表型预后较差。CD14+单核细胞和血清IL-8水平随时间增加，高水平的CD14+单核细胞与较短的PFS和OS相关。这些免疫特征与预后的关联在使用ICI治疗起始日期重新计算时依然成立，提示其反映的是宿主对免疫治疗的固有反应能力，而非FMT的直接因果效应。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::de6856b325f938438220cbe8b17903dd941239ef440c8510463fecefd670962a",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::2796f4a95907dc27585d9be6c34717031ccbf68aa1205c3f86aa55982b202416",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::493392e3de775aab4ec6df0d6be0fcd6dc73f939d25de319ec964f0b48ea1cce",
      "multiple_values_in_field": true
    },
