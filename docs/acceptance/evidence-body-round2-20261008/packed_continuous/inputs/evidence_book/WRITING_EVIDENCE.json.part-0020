            "problem_or_question"
          ]
        },
        {
          "record_id": "record::fe5c600d9bf2b28e4f9f43203610a19132867cde5f76806ca84387d3caacfa8c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::2e4fccceb82a2b23259aee4bbe7b17335242951b345a57b8998781aa53b9d996",
