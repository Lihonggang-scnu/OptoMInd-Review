    "atom::f77d7a57b1c5af196e7ec273": {
      "atom_id": "atom::f77d7a57b1c5af196e7ec273",
      "source_handle": "P0583",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "机制验证（动物实验）",
        "finding": "在抗生素处理的小鼠中，将FMT响应者基线样本中丢失的有害细菌混合物重新引入，抵消了FMT联合ICI的抗肿瘤效应，证实消除有害菌是治疗获益的必要条件。"
      },
      "role": "evidence",
