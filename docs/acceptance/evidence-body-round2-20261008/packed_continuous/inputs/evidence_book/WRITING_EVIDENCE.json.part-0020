    "atom::10fa00141f5ccb618952ade4": {
      "atom_id": "atom::10fa00141f5ccb618952ade4",
      "source_handle": "P0273",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "抗PD-1难治性转移性黑色素瘤患者接受来自响应者的FMT",
        "finding": "两项突破性临床试验显示，将来自免疫治疗响应者的粪菌移植给难治性患者，结合抗PD-1治疗，可使部分患者重新获得临床响应（Baruch et al. 3/10响应；Davar et al. 6/15响应），且安全性良好。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2694ad4ea52a0088aba17fec8749475852bf5ca9f787b90de4f0629fb7feefb5",
