    "atom::0eee6b0fc85c1aa61c7d0f69": {
      "atom_id": "atom::0eee6b0fc85c1aa61c7d0f69",
      "source_handle": "P0273",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法。电子数据库搜索策略包括关键词“cancer”、“immunotherapy/immune checkpoint inhibitor”和“microbiome/microbiota”。纳入标准限定为：成人（>18岁）、英文全文、同行评审期刊发表的研究。排除动物模型研究以专注于临床应用证据。对纳入的10项研究进行定性综合，按癌症类型（黑色素瘤、HCC、NSCLC等）和治疗结果（疗效、irAEs、FMT干预）分类整理发现。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2694ad4ea52a0088aba17fec8749475852bf5ca9f787b90de4f0629fb7feefb5",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::eb554c2581ab757501df96e5e2c1e4a52b3957dd1999e4e6739aad243fb42bcb",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::17ec529e254380cf6b84cb8828d0e4b7cbcb40aeb149c1edacb6805d9c2bdaff",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::744d358d21c766e8381c7ee4e442cefc1d15e0139df010432ad16f44ba98215d",
      "multiple_values_in_field": false
    },
    "atom::f0e5381ebc2cc88f3e2bff9f": {
      "atom_id": "atom::f0e5381ebc2cc88f3e2bff9f",
      "source_handle": "P0273",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "首次专门针对临床研究的综述，汇总了肠道微生物组作为ICIs疗效预测生物标志物和irAEs风险因子的证据，强调了FMT在逆转耐药性方面的初步临床可行性。",
        "limits": "所纳入的研究样本量普遍较小（多数n≤42），存在异质性（不同癌症类型、不同ICI药物、不同测序方法如16S rRNA与宏基因组）。观察性研究无法确立因果关系。未对纳入的非随机研究进行严格的质量偏倚风险评估。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2694ad4ea52a0088aba17fec8749475852bf5ca9f787b90de4f0629fb7feefb5",
