    "atom::2722e11e77db735695b2ff6e": {
      "atom_id": "atom::2722e11e77db735695b2ff6e",
      "source_handle": "P0148",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Study is limited to KRAS-mutated NSCLC. Sample size is small (n=33). Associations are observational. Some findings (e.g., Akkermansia) did not reach high statistical confidence (90% BCL) due to sample size.",
        "contribution": "Identifies specific microbial features associated with ICI response in KRAS-mutated NSCLC: enrichment of SCFA-producing species (e.g., Agathobaculum, Bifidobacterium) and Akkermansia in responders; enrichment of Bacteroides/Blautia in non-responders.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::60860a7689fed061bd39fe74b1fb64de44d7f85199418ada4c9f0738d255c811",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::3bcbdccaaa7fb31548e125211bcb7e6c8af603ef3765cd980fcba420c8aa3716",
      "multiple_values_in_field": true
    },
    "atom::9a0e7a002875565c43844916": {
      "atom_id": "atom::9a0e7a002875565c43844916",
      "source_handle": "P0148",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used as evidence for the association between beneficial microbes (SCFA producers) and improved ICI efficacy in solid tumors. Supports the hypothesis that certain microbial signatures predict response across different cancer types.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
