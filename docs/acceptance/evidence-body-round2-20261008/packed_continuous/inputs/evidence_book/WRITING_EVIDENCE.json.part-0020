    "atom::5bf177507031d3cb68991669": {
      "atom_id": "atom::5bf177507031d3cb68991669",
      "source_handle": "P0271",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "样本量小（n=17），仅为观察性关联，不能确立因果关系。仅针对日本人群，外推至其他种族需谨慎。仅测量了治疗期间的单次样本，未涵盖基线或动态变化。部分关键细菌（如Lactobacillus）的关联未达到统计学显著性（P>0.05），仅表现为趋势。",
        "contribution": "提供了在晚期NSCLC患者中，肠道菌群组成与ICI疗效关联的具体物种列表。发现反应者富集Lactobacillus, Clostridium, Syntrophococcus，而非反应者富集Bilophila, Sutterella, Parabacteroides。其中Bilophila高丰度与显著延长的TTF（即更好的疗效/更慢的疾病进展）相关，这与部分其他研究可能存在的负面关联形成对比或补充，提示需关注菌种特异性而非整体多样性。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::d3d3338725bcb6af1d221f0aae9f1b361312ce703fcf11ad2cb0262219fa4fe8",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
