    "atom::23dc4a9736d9a9bb87b855f5": {
      "atom_id": "atom::23dc4a9736d9a9bb87b855f5",
      "source_handle": "P0148",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This study investigates the association between the gut microbiome and clinical outcomes in a homogeneous cohort of advanced KRAS-mutated NSCLC patients receiving ICI therapy. The authors performed shotgun metagenomic sequencing on baseline stool samples to analyze microbial composition and functional pathways. They compared responders versus non-responders (defined by DCR and PFS12) and patients with vs. without immune-related adverse events (irAEs), adjusting for confounders like ICI regimen, metastatic stage, age, sex, and BMI. The study found no differences in overall alpha or beta diversity but identified specific species and metabolic pathways differentially abundant between groups.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::60860a7689fed061bd39fe74b1fb64de44d7f85199418ada4c9f0738d255c811",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::4e3ed88c9f5b55fb17309f9903e034b6fbb89dc83afe569e6516a5d29d7c2fde",
      "multiple_values_in_field": false
    },
    "atom::ee42e524fe323936cdd4b0e2": {
      "atom_id": "atom::ee42e524fe323936cdd4b0e2",
      "source_handle": "P0148",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "Discussion compares findings with studies from China, Japan, and other European cohorts, noting differences in associated species (e.g., Bacteroides massiliensis in Chinese cohort vs. Bacteroides in this cohort). Attributes differences to diet, geography, and methodological factors."
      },
      "role": "evidence",
