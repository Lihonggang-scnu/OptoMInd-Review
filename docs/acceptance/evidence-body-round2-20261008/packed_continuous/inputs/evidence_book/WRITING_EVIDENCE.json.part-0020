            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::ebd518facf6d264d978e53787d0a9b3ab51b1562a49ff297ab90cbb339132444",
      "multiple_values_in_field": true
    },
    "atom::602293d8d060926ae50da0a3": {
