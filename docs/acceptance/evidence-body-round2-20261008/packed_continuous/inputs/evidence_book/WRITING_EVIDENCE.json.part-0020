    "atom::0c4539dfe7511b5ee26afddc": {
      "atom_id": "atom::0c4539dfe7511b5ee26afddc",
      "source_handle": "P0583",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物组分析与临床响应关联",
        "finding": "响应者（R）与非响应者（NR）相比，在FMT后表现出显著更高的基线细菌物种丢失幅度。这种丢失主要由有害菌（如Enterocloster, Clostridium, Streptococcus）构成，而非供体菌株的定植。"
      },
      "role": "evidence",
