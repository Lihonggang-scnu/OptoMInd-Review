    "atom::19f5ba98faa7f71a33a18835": {
      "atom_id": "atom::19f5ba98faa7f71a33a18835",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To evaluate whether modifying the gut microbiome via oral FMT from healthy donors can improve the safety, response rate, and survival outcomes of anti-PD1 therapy in patients with advanced melanoma who are naive to advanced-stage treatment, potentially overcoming primary resistance to immune checkpoint inhibitors (ICIs).",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::878be6f95d35e78b4869f988fecafe80887677e8927f20c1a2fe5e88487f3acb",
      "multiple_values_in_field": false
    },
    "atom::f99b8e9719b07fd9b3d34bf5": {
      "atom_id": "atom::f99b8e9719b07fd9b3d34bf5",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "Advanced cutaneous melanoma patients (N=20), treatment-naïve for advanced disease, receiving oral fecal microbiota transplantation (FMT) from healthy donors followed by single-agent anti-PD1 therapy. Multicenter phase I trial conducted in Canada.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::e666cd86c2bceed5802c9ce80ed3a044a1553dc941c53be083c715366bc1a52c",
      "multiple_values_in_field": false
    },
    "atom::835431f5f287a104ceabd51e": {
      "atom_id": "atom::835431f5f287a104ceabd51e",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This study reports the final survival outcomes of the MIMic phase I trial, evaluating the safety and efficacy of combining oral FMT with healthy donor stool and anti-PD1 immunotherapy as first-line treatment for advanced melanoma. The trial enrolled 20 patients who received a single dose of FMT followed by nivolumab or pembrolizumab. The primary endpoint was safety, while secondary endpoints included objective response rate (ORR), progression-free survival (PFS), and overall survival (OS). The study found that the combination was safe, with an ORR of 65%. Median PFS was 29.6 months and median OS was 52.8 months, figures reported as higher than historical randomized controlled trials (RCTs) and real-world data. Post hoc analyses linked clinical responses to specific microbial engraftment patterns and functional metabolic pathways, suggesting that successful microbiome modulation may enhance ICI efficacy.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::694f0733a990bbe90e779a1f3555654eccddd79f1f1c7065b568dd7e23b41e3d",
      "multiple_values_in_field": false
    },
    "atom::c4c62ba8b354ff9629bfc7ba": {
      "atom_id": "atom::c4c62ba8b354ff9629bfc7ba",
      "source_handle": "P0577",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This paper provides empirical evidence from a Phase I trial that oral FMT from healthy donors combined with anti-PD1 is safe and associated with improved survival in advanced melanoma. It offers specific mechanistic hypotheses linking clinical response to microbial engraftment success, characterized by the enrichment of short-chain fatty acid (SCFA)-producing bacteria and specific metabolic pathways. The study highlights FMT-specific toxicity as a potential marker of successful microbial integration and immune priming.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::2647e256505ce03e0a1bf249b16232d1c27fa964f68e0b5458bf4be89c1058a8",
      "multiple_values_in_field": false
    },
    "atom::f8959cd8dd927a10f9dd3654": {
      "atom_id": "atom::f8959cd8dd927a10f9dd3654",
      "source_handle": "P0577",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Results are from a single-arm, small-sample Phase I trial. Cannot establish causal superiority over standard care due to lack of concurrent control arm. Patient population was restricted to those unsuitable for combination immunotherapy.",
        "contribution": "Reports clinical efficacy outcomes (ORR 65%, mPFS 29.6 mo, mOS 52.8 mo) for FMT+anti-PD1 in advanced melanoma, showing improvements over historical RCT benchmarks for anti-PD1 alone.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::055a894df1d7ad8988d06552aad26a5e74791f52d53dbe02f1e0445601865673",
      "multiple_values_in_field": true
    },
    "atom::2710a1abbe1e18c3a40fd754": {
      "atom_id": "atom::2710a1abbe1e18c3a40fd754",
      "source_handle": "P0577",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to illustrate the potential magnitude of benefit from microbiome manipulation in solid tumors, specifically melanoma. Provides baseline survival metrics for comparison with other microbiome interventions.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::dc57c9f28f702091b19b2f66ae24e3f4aa7d352f8e8564caeb23838c3c7262a1",
      "multiple_values_in_field": true
    },
    "atom::da8e241ae0ffdf09b558a4ff": {
      "atom_id": "atom::da8e241ae0ffdf09b558a4ff",
      "source_handle": "P0577",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Mechanisms are inferred from correlative post hoc analyses. The role of FMT-specific toxicity as a proxy for engraftment success is observational. Functional profiling relies on metagenomic prediction, which may not reflect actual protein activity or host interaction.",
        "contribution": "Links clinical response to specific microbial features: Responders and long-term survivors show enrichment of SCFA-producing taxa (Blautia, Roseburia, Faecalibacterium) and enzymes for glycan modification/amino acid biosynthesis. Non-responders/short-term survivors show enrichment of oxidative/stress pathways and Hungatella hathewayi.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::055a894df1d7ad8988d06552aad26a5e74791f52d53dbe02f1e0445601865673",
      "multiple_values_in_field": true
    },
    "atom::d5ca5557f698c50be26a769c": {
      "atom_id": "atom::d5ca5557f698c50be26a769c",
      "source_handle": "P0577",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Provides mechanistic insights into how microbiome composition might mediate ICI efficacy. Suggests that successful engraftment of metabolically fit, SCFA-producing communities enhances immune response. Identifies functional metabolic signatures (vs. just taxonomy) associated with outcome.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
