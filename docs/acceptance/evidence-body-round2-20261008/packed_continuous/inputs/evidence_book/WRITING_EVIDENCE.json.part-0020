    "atom::ada46cc65142f66137be5912": {
      "atom_id": "atom::ada46cc65142f66137be5912",
      "source_handle": "P0583",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅适用于未经过ICI治疗的原发性耐药患者；NSCLC结果基于高PD-L1表达人群；黑色素瘤结果包含不同BRAF状态。",
        "contribution": "提供了FMT联合ICI在NSCLC（抗PD-1）和黑色素瘤（抗PD-1/CTLA-4）中的具体ORR数据（分别为80%和75%），证明了其在一线治疗中提高临床活性的能力。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
