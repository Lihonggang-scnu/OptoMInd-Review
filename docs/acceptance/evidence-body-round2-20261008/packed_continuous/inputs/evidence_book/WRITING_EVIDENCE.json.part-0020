          ]
        },
        {
          "record_id": "record::1fd227bf27d6d15554f9ced9bb8d6b3fb34d9cfe28b6ead92bf02a96743e96a1",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::524a9db1afbc8629d8760117436dc44eb33eb2fb7cfc6cc78e01ddf42d19650d",
      "multiple_values_in_field": false
    },
