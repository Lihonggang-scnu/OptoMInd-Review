    "atom::ba11e860995b5b93ccba646a": {
      "atom_id": "atom::ba11e860995b5b93ccba646a",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性文献回顾方法。检索PubMed索引的英文出版物（1946-2026年）、主要肿瘤学指南、关键II/III期临床试验、荟萃分析及机制研究。检索词涵盖NSCLC、ICI、TME、耐药及相关分子靶点。对临床证据按试验阶段、人群相关性、终点成熟度及监管意义进行加权；对临床前和假设生成性研究主要用于支持机制概念。通过分类归纳TME组成、分子通路、物理化学抑制因素及系统性因素，构建耐药机制框架，并据此评估不同组合疗法的临床转化潜力。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::63f50973543253a038b94aa8b1b9f00a4c4b4d4e7797e0719a9f09423c6dc859",
      "multiple_values_in_field": false
    },
    "atom::d0d6e3f09a1c7ce3c1adb314": {
      "atom_id": "atom::d0d6e3f09a1c7ce3c1adb314",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了NSCLC中TME介导耐药的整合性框架，强调从孤立因素转向相互连接的生物学过程视角；明确了不同联合疗法（免疫-免疫、免疫-抗血管、免疫-放化疗、免疫-靶向）的临床证据层级和适用情境。",
        "limits": "作为叙事性综述，其结论依赖于作者对纳入文献的选择和解释；未提供新的原始实验数据；部分机制（如微生物组干预）仅基于初步研究，缺乏大规模临床验证；特定生物标志物（如ctDNA阈值）尚待标准化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::51bef138f22164f6dca9b53bb5e6c8e795be3cc4a4653a708e0d706e3ed9ea4c",
      "multiple_values_in_field": false
    },
    "atom::c58638947e26fda363bc96b7": {
      "atom_id": "atom::c58638947e26fda363bc96b7",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "TME细胞成分异质性",
        "finding": "巨噬细胞并非简单的M1/M2二元模型，而是存在激活状态的连续谱系；MDSCs亚型特异性功能不同（单核型通过ARG1/iNOS抑制，多形核型通过ROS抑制）；CAF和ECM重塑通过增加间质硬度促进免疫排斥。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::02368d39ceb97ee6328edfb3bad6070e10d80db1c73b3c7caf81015286643c6b",
      "multiple_values_in_field": true
    },
    "atom::868f6863791b248bb2f885d2": {
      "atom_id": "atom::868f6863791b248bb2f885d2",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "内在肿瘤机制",
        "finding": "STK11缺失抑制I型干扰素信号，KEAP1缺失激活抗氧化程序，两者共同导致低PD-L1表达和低CD8+ T细胞浸润；EGFR/ALK驱动突变通常伴随低TMB和不活跃的免疫微环境。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::02368d39ceb97ee6328edfb3bad6070e10d80db1c73b3c7caf81015286643c6b",
      "multiple_values_in_field": true
    },
    "atom::8374ecf9788b5088e7803fbf": {
      "atom_id": "atom::8374ecf9788b5088e7803fbf",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "联合治疗证据等级",
        "finding": "纳武利尤单抗+伊匹木单抗在CheckMate 227中显示疗效（受PD-L1/TMB影响）；阿替利珠单抗+贝伐珠单抗+化疗在IMpower150中证实对转移性非鳞状NSCLC有效，包括肝转移和EGFR突变TKI失败后人群；LAG-3/TIM-3抑制剂在NSCLC中的临床采纳仍需成熟试验确认。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::02368d39ceb97ee6328edfb3bad6070e10d80db1c73b3c7caf81015286643c6b",
      "multiple_values_in_field": true
    },
    "atom::55ac707849e577034afb0fb0": {
      "atom_id": "atom::55ac707849e577034afb0fb0",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "生物标志物应用",
        "finding": "PD-L1检测存在空间异质性和平台间不完全互换性；高TMB预测价值受测序平台和肿瘤纯度影响；空间转录组学可区分免疫表型；液体活检（ctDNA/exosome）需前瞻性验证阈值。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        },
