            "scope_interpretation_cautions",
            "1"
          ]
        },
        {
          "record_id": "record::1fd227bf27d6d15554f9ced9bb8d6b3fb34d9cfe28b6ead92bf02a96743e96a1",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::933728968fcb44be264ad04706bcf630f6a6e3173127d0e4b81fe77d7235f036",
      "multiple_values_in_field": true
    },
    "atom::8297157472470af83f1bc39c": {
      "atom_id": "atom::8297157472470af83f1bc39c",
      "source_handle": "P0417",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗生素的影响可能是多方面的（微生物组改变+直接抗炎作用），综述未区分具体抗生素种类的影响差异，仅指出广谱抗生素影响更显著。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c1380d633739b6409c09a4c3ee78ec05f17624561fe7d5fe1dd336699e226c44",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        },
        {
          "record_id": "record::5b707a9c2a4912437225849fe19dbd25efd93ce5e0d74a9b7e06be3bfe21b244",
          "field_path": [
