    "atom::4a3358fa0ff1afdc9ee48a53": {
      "atom_id": "atom::4a3358fa0ff1afdc9ee48a53",
      "source_handle": "P0474",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "解决NSCLC中ICI原发性和获得性耐药限制长期临床获益的问题；阐明TME各组分如何协同导致不同免疫表型，并厘清当前联合治疗策略的证据等级与局限性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::153461ac1a5cb9b5a31c3121b0fc942b1ff043b8b534ad3744ffe24333b4766e",
          "field_path": [
