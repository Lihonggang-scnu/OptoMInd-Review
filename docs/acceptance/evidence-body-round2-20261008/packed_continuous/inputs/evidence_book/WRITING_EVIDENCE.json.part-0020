    "atom::3faecf28e92560240194f225": {
      "atom_id": "atom::3faecf28e92560240194f225",
      "source_handle": "P0271",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "在综述的方法学讨论部分，可用此为例说明单次采样可能无法捕捉微生物组的动态演变及其对免疫治疗反应的复杂影响，支持需要纵向研究设计的观点。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
