    "atom::cd1eb32400edde04370e97c2": {
      "atom_id": "atom::cd1eb32400edde04370e97c2",
      "source_handle": "P0273",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受ICIs治疗的晚期癌症患者（黑色素瘤、HCC、NSCLC等）",
        "finding": "基线肠道微生物组的多样性和组成与ICIs疗效显著相关。高α-多样性通常与较长的PFS和OS相关。特定菌属富集与响应正相关（如Fecalibacterium prausnitzii, Bifidobacterium longum, Akkermansia muciniphila），而某些拟杆菌目（Bacteroidales）丰度高则与非响应相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2694ad4ea52a0088aba17fec8749475852bf5ca9f787b90de4f0629fb7feefb5",
