    "atom::024518a823f6006dd3e972f9": {
      "atom_id": "atom::024518a823f6006dd3e972f9",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Entire cohort (N=20), median follow-up 52.8 months",
        "finding": "Median PFS was 29.6 months; median OS was 52.8 months. ORR was 65% (4 complete responses). Safety profile showed no increase in severe immune-related adverse events (irAEs); only grade 3 toxicities occurred."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::422c77c967148fd60af8c2e688628c92e0971cb00b271674bb36835fec66c89a",
      "multiple_values_in_field": true
    },
    "atom::3485959e4adbd9d7481e46dc": {
      "atom_id": "atom::3485959e4adbd9d7481e46dc",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Responders (R, N=13) vs. Non-responders (NR, N=7)",
        "finding": "R patients had significantly longer mPFS (52.8 vs. 5.2 months, p=0.0016) and longer mOS (52.8 vs. 17.6 months, p=0.0628). R patients sustained donor-derived microbial similarity over time."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::422c77c967148fd60af8c2e688628c92e0971cb00b271674bb36835fec66c89a",
      "multiple_values_in_field": true
    },
    "atom::7ebb834ea4cc8b7658e4ac8d": {
      "atom_id": "atom::7ebb834ea4cc8b7658e4ac8d",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Patients with FMT-specific toxicity (FT, N=8) vs. Without FT (NFT, N=12)",
        "finding": "All 8 FT patients were responders. FT patients had significantly improved mPFS (52.8 vs. 15.9 months, p=0.0364) and trend towards improved mOS (53.9 vs. 24.6 months, p=0.0610). FT was associated with enrichment of SCFA-producing taxa and glycan-modifying enzymes."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
