        {
          "record_id": "record::e83de03b33da0c831779d170ec8a1247328175b4f78cb3e44d806a9211ac3d6c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::1c04cf93ed697c956358a2e03ef398a93fe54499a40e51ed336e48c014597833",
