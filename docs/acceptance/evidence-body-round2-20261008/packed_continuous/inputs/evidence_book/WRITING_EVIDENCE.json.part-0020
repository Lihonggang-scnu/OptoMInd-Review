          ]
        }
      ],
      "variant_group": "field::983bc30b02e6452beb052c68a6ba657466e6cac061c42a039ed34a0c59a4e2d1",
      "multiple_values_in_field": false
    },
    "atom::486e666a3840ab88db3d19db": {
      "atom_id": "atom::486e666a3840ab88db3d19db",
      "source_handle": "P0583",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于FMT联合ICI治疗实体瘤的关键临床数据，特别是其在克服原发性耐药方面的潜力。更重要的是，它提出了一个区别于传统“有益菌定植”假说的新机制框架：即治疗获益主要源于FMT诱导的基线有害病原体（pathobionts）的清除，进而调节宿主代谢和免疫微环境。此外，它还揭示了供体菌群特征（如Prevotella丰度）与特定ICI方案（双免疫检查点抑制）相互作用下的安全性风险。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::cc9c61313270bf8ed21449cda520e30abe029c0dc4128fb4e9405f0415b9f043",
          "field_path": [
