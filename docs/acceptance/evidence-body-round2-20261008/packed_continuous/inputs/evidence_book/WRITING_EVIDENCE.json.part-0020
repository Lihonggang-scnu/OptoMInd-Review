    "atom::0fc5763ac32ca8ee7111a467": {
      "atom_id": "atom::0fc5763ac32ca8ee7111a467",
      "source_handle": "P0273",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "样本量极小，仅为概念验证性质。供体和受体间的个体差异、预处理抗生素的使用等因素可能影响结果。尚未阐明具体的分子机制或关键菌株。",
        "contribution": "通过FMT临床试验（Baruch et al., Davar et al.）展示了从响应者向难治者移植微生物组可恢复部分患者的治疗响应，并观察到CD8+ T细胞激活增加和IL-8表达髓系细胞减少。这为微生物组介导免疫治疗效应的因果假设提供了最强的临床间接证据。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2694ad4ea52a0088aba17fec8749475852bf5ca9f787b90de4f0629fb7feefb5",
          "field_path": [
