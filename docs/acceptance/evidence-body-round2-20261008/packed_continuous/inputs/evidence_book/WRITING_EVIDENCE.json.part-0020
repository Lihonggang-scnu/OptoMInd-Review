    "atom::08554aa4c222491df9d38ef8": {
      "atom_id": "atom::08554aa4c222491df9d38ef8",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "Single-arm, multicenter phase I clinical trial. Patients received bowel preparation, followed by oral administration of capsules containing stool from one of three healthy male donors. Anti-PD1 therapy (nivolumab or pembrolizumab) started at least 7 days post-FMT. Outcomes were assessed using RECIST 1.1 criteria. Survival analysis used Kaplan-Meier methods. Metagenomic sequencing was performed on stool samples to analyze taxonomic composition (MetaPhlAn) and functional gene families (HUMAnN). Post hoc subgroup analyses compared responders vs. non-responders and patients with vs. without FMT-specific toxicity (FT) based on microbial and functional profiles.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ad04cf8aae09644b6a6123477ab42045cb7d567a923b0e67a3e4f097577ddcd7",
      "multiple_values_in_field": false
    },
    "atom::37fd84d50ba8233eb66b5714": {
      "atom_id": "atom::37fd84d50ba8233eb66b5714",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides long-term survival data (median OS 52.8 months) for a small cohort of advanced melanoma patients treated with oral FMT plus anti-PD1, demonstrating high safety and promising efficacy signals compared to historical controls.",
        "limits": "Small sample size (N=20), single-arm design without a control group, and lack of statistical power for definitive conclusions. Results are hypothesis-generating. Patient selection bias (excluded those appropriate for combination therapy)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::d94654cea34f2583334f29d65b54b1a04e1b295fe30ff61eb2341f92717e2b5f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::aa51796fecd374ed033112bbca2559fb3aa2bb95f0624a28581871d882cd3c3e",
      "multiple_values_in_field": true
    },
    "atom::b7e3e6165a31ec1e105e75b4": {
      "atom_id": "atom::b7e3e6165a31ec1e105e75b4",
      "source_handle": "P0577",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Identifies potential biomarkers for response, linking FMT-specific mild toxicity and long-term survival to specific microbial taxa (e.g., SCFA producers) and functional metabolic pathways (glycan modification, SCFA biosynthesis).",
        "limits": "Associations are derived from post hoc analyses. Causality between specific microbes/enzymes and clinical benefit is not established. The 'donor effect' could not be clearly disentangled due to the small cohort and mixed donor usage."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
