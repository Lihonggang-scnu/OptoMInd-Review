    "atom::ccd742ea527af43296074069": {
      "atom_id": "atom::ccd742ea527af43296074069",
      "source_handle": "P0583",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "研究设计为前瞻性、多中心、单臂II期临床试验。入组标准包括：NSCLC患者需PD-L1 TPS ≥50%且无一线可操作基因改变；黑色素瘤患者不限BRAF状态。所有患者在开始ICI治疗前一周内接受来自健康供体的单次FMT（口服胶囊）。主要终点是NSCLC队列的ORR。次要终点包括黑色素瘤ORR、1年无进展生存期（PFS）、总生存期（OS）、疾病控制率（DCR）及安全性。微生物组分析采用鸟枪法宏基因组测序，结合定量PCR和高通量培养组学验证细菌变化。此外，通过血浆代谢组学和流式细胞术分析免疫代谢景观，并在抗生素处理的荷瘤小鼠模型中通过回输“丢失”的细菌混合物来验证因果机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::cc9c61313270bf8ed21449cda520e30abe029c0dc4128fb4e9405f0415b9f043",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::858e2e285637cdae2d18e8b523ced12f1d8ed904d7a295670a200334eaf41854",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::e0ab03ae8f4e8669b7c7052edd8c65b601d40b6be91f2e2e0e8f540e3873acc0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::ceff59cf10840ae2fa4f87a4ff0663f65ba50bed0bb6e871a51e844548260048",
          "field_path": [
