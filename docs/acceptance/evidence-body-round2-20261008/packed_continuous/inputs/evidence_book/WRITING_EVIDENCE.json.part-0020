    "atom::005a316d28eb7a8e707b2bd8": {
      "atom_id": "atom::005a316d28eb7a8e707b2bd8",
      "source_handle": "P0417",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节ICI疗效”中的现象学部分，即哪些因素（抗生素、特定菌群）与疗效正负相关。可用于对比不同研究中预测标志物的异质性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::c1380d633739b6409c09a4c3ee78ec05f17624561fe7d5fe1dd336699e226c44",
          "field_path": [
            "review_planning_B",
