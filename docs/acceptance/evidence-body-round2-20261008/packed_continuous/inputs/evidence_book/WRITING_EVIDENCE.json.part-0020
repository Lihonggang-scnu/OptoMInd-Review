            "problem_or_question"
          ]
        },
        {
          "record_id": "record::ceff59cf10840ae2fa4f87a4ff0663f65ba50bed0bb6e871a51e844548260048",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::51ac3e5630bfc615f5cb71b86033b8f0b1632cd636fa80079b912acd29705475",
      "multiple_values_in_field": false
    },
    "atom::f10ae71e3af0e5426782b275": {
      "atom_id": "atom::f10ae71e3af0e5426782b275",
      "source_handle": "P0583",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "该研究针对晚期非小细胞肺癌（NSCLC）和皮肤黑色素瘤患者，评估健康供体粪便微生物群移植（FMT）联合一线免疫检查点抑制剂（ICI）治疗的临床疗效、安全性及机制。NSCLC队列接受抗PD-1单药治疗，黑色素瘤队列接受抗PD-1联合抗CTLA-4双免疫检查点抑制治疗。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3f08daede868f51719f44f75b1f4a1db5dd97bb2986b20cbd1f7b1a074ddc0e9",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::cc9c61313270bf8ed21449cda520e30abe029c0dc4128fb4e9405f0415b9f043",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::858e2e285637cdae2d18e8b523ced12f1d8ed904d7a295670a200334eaf41854",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::e0ab03ae8f4e8669b7c7052edd8c65b601d40b6be91f2e2e0e8f540e3873acc0",
