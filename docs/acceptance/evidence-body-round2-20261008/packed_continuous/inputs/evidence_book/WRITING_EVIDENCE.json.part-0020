            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::f66ee7eb1492981604a56a4feff0d824c5f9c41c5d70d97b34a0c092a11b570a",
      "multiple_values_in_field": true
    },
    "atom::f2b5c8637e0bae0dea5dad1f": {
      "atom_id": "atom::f2b5c8637e0bae0dea5dad1f",
      "source_handle": "P0474",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释微生物组影响ICI疗效的系统性背景机制，以及当前干预手段的局限性。帮助区分已观察到的关联与尚未验证的因果机制。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2ebf71c6aa2b1657b267b130b63730407a6e10f893d24ea8dc68c6d9007bf17b",
          "field_path": [
