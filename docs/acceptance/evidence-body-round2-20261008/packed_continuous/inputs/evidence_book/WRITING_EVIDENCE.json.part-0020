    "atom::d4638a6a4f77e74e8f1b2c40": {
      "atom_id": "atom::d4638a6a4f77e74e8f1b2c40",
      "source_handle": "P0148",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "Provides empirical evidence linking specific gut microbial taxa (SCFA producers, Akkermansia) and pathways to ICI response in KRAS-mutated NSCLC. Offers a comparative perspective on whether microbial biomarkers are tumor-type specific or universal, and highlights the complexity of 'pro-inflammatory' vs 'health-associated' signatures in responders.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
          "field_path": [
