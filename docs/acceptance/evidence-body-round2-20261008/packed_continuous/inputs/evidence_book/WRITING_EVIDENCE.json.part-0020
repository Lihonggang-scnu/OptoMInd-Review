    "atom::f5d7e1fba79b4eaef4b2e294": {
      "atom_id": "atom::f5d7e1fba79b4eaef4b2e294",
      "source_handle": "P0273",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受CTLA-4抑制剂治疗的黑色素瘤患者",
        "finding": "低丰度的Bacteroidetes门细菌与免疫检查点抑制剂诱导的结肠炎（GI毒性）相关；相反，较高的Bacteroidetes丰度与抵抗结肠炎发生相关。"
      },
      "role": "evidence",
      "origins": [
