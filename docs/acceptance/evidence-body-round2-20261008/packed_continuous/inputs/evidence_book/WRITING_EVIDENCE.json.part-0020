    "atom::884404586a4ee2b78998353a": {
      "atom_id": "atom::884404586a4ee2b78998353a",
      "source_handle": "P0148",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "Observational cohort study. 1. Participant selection: 40 recruited, 33 eligible (KRAS-mutated NSCLC, baseline stool collected). 2. Sequencing: Shotgun metagenomics (Illumina HiSeq 2000). 3. Processing: KneadData for host removal, HUMAnN3 for functional profiles, MetaPhlAn3 for taxonomy. Normalization via arcsine square-root (taxa) and log (pathways). 4. Statistical Analysis: Shannon index for alpha-diversity; PCA on clr-transformed data for beta-diversity; PERMANOVA for variance explanation; Bayesian logistic-normal linear regression (Pibble model) to identify differential abundance of species/pathways associated with DCR, PFS12, and irAEs, adjusting for covariates. Credible intervals used for significance (75% and 90%).",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::60860a7689fed061bd39fe74b1fb64de44d7f85199418ada4c9f0738d255c811",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::29751f9b244259fe6cdc010dac14344b2ed1fb914b806e87b24b6ec0f7d8dc68",
      "multiple_values_in_field": false
    },
    "atom::1743485c0d4bb61ac9844056": {
      "atom_id": "atom::1743485c0d4bb61ac9844056",
      "source_handle": "P0148",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "First study to profile the gut microbiome exclusively in KRAS-mutated NSCLC patients treated with ICI. Identifies specific microbial signatures (SCFA-producers, Akkermansia) overlapping with findings in other tumor types (melanoma, RCC), suggesting potential tumor-independent mechanisms.",
        "limits": "Small sample size (n=33), single time-point (baseline only), limited statistical power (wide credible intervals for some associations like Akkermansia). Cannot establish causality. Regional/methodological differences may limit generalizability compared to larger multi-center cohorts."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::60860a7689fed061bd39fe74b1fb64de44d7f85199418ada4c9f0738d255c811",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::7d29d2422a039d2fbc8bc47c006d89da18005160513356786955686c543aedc9",
      "multiple_values_in_field": false
    },
    "atom::900b54dd6f651507770d5b53": {
      "atom_id": "atom::900b54dd6f651507770d5b53",
      "source_handle": "P0148",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Responders (DCR/PFS12) vs Non-responders",
        "finding": "No significant difference in alpha or beta diversity. Responders enriched in SCFA-producing species (Agathobaculum butyriciproducens, Clostridium leptum, Bifidobacterium longum, Eubacterium ramulus, Fusicatenibacter saccharivorans) and Akkermansia muciniphila (wider CI). Responders also showed higher abundance of pro-inflammatory pathways (LPS, heme synthesis). Non-responders enriched in Bacteroides spp. and Blautia genus."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::60860a7689fed061bd39fe74b1fb64de44d7f85199418ada4c9f0738d255c811",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::6664770621892d2d02dcb629d3ef61a5a14e95c495059a8e5e703072431971f3",
      "multiple_values_in_field": true
    },
    "atom::90573ec5da0da24dca4ef245": {
      "atom_id": "atom::90573ec5da0da24dca4ef245",
      "source_handle": "P0148",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Patients with irAEs vs Patients without irAEs",
        "finding": "No diversity differences. Patients unaffected by irAEs enriched in biotin and SCFA synthesis pathways. Patients developing irAEs enriched in Alistipes finegoldii, Bifidobacterium longum, and Bacteroides uniformis, and amino acid synthesis pathways."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::41a372ad3c000ca6ceb63be462b55be736df6ec06f59e5a2d0ccb2241f05cdbd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::5ea0587ee7013c3fa2de50ab370a50c09a7f8cfc351d330175f4663d28ac9008",
