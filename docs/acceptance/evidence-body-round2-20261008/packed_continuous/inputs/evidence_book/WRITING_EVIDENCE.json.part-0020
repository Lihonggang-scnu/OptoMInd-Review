      "multiple_values_in_field": true
    },
    "atom::bb85bf7cf3b7520e42bac278": {
      "atom_id": "atom::bb85bf7cf3b7520e42bac278",
      "source_handle": "P0417",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI诱导的难治性结肠炎患者",
        "finding": "在两例个案报告中，粪便微生物群移植（FMT）成功缓解了ICI相关的结肠炎症状。"
      },
      "role": "evidence",
