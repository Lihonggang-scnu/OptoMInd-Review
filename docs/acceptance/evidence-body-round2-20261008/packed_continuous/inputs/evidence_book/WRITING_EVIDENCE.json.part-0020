    "atom::b81452e6f8c2cf88f589c219": {
      "atom_id": "atom::b81452e6f8c2cf88f589c219",
      "source_handle": "P0273",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "发现的菌群与疗效的关联多为观察性结果，存在混杂因素（如饮食、生活方式、合并用药），不能直接视为因果证据，除非有FMT等干预性研究的支持。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2694ad4ea52a0088aba17fec8749475852bf5ca9f787b90de4f0629fb7feefb5",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        },
        {
          "record_id": "record::eb554c2581ab757501df96e5e2c1e4a52b3957dd1999e4e6739aad243fb42bcb",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        },
        {
          "record_id": "record::17ec529e254380cf6b84cb8828d0e4b7cbcb40aeb149c1edacb6805d9c2bdaff",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::72d5d97855ba3bc1d78b77cbd47d19ed447bdbc5fab04e95429432752546518f",
      "multiple_values_in_field": true
    },
    "atom::17045e9a74e743196a9ec5a9": {
      "atom_id": "atom::17045e9a74e743196a9ec5a9",
      "source_handle": "P0273",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "不同研究间使用的测序区域（V3-V4, V4, V4-V5）和分析方法不同，导致具体菌种鉴定可能存在偏差，比较时需考虑技术异质性。",
      "role": "evidence",
      "origins": [
