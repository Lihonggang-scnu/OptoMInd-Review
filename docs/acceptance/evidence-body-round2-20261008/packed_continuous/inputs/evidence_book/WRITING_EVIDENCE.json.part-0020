    "atom::d1c0f5c1558648ba8264b5ed": {
      "atom_id": "atom::d1c0f5c1558648ba8264b5ed",
      "source_handle": "P0578",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究的阴性结果主要归因于患者群体的快速进展特性和小样本量，不应将其解读为FMT在所有情况下均无效，而应视为特定情境下的失败尝试。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
