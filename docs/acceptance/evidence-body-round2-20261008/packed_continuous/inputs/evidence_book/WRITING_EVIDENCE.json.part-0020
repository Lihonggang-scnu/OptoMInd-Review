    "atom::d5efbdf228428548df85d84f": {
      "atom_id": "atom::d5efbdf228428548df85d84f",
      "source_handle": "P0417",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些主要是基于动物模型或观察性数据的推测，文中明确指出人类患者中尚未进行类似的机制验证研究。无法直接证明具体的分子机制路径。",
        "contribution": "讨论了抗生素可能通过改变微生物组选择不利菌种、或通过抗生素本身的抗炎特性（如降低促炎细胞因子、减少T细胞反应）来拮抗ICI疗效的潜在机制。指出微生物组与irAEs（结肠炎）的关联可能反映了ICI疗效与免疫介导毒性之间的正相关（表型伴随现象）。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c1380d633739b6409c09a4c3ee78ec05f17624561fe7d5fe1dd336699e226c44",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::5b707a9c2a4912437225849fe19dbd25efd93ce5e0d74a9b7e06be3bfe21b244",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::1fd227bf27d6d15554f9ced9bb8d6b3fb34d9cfe28b6ead92bf02a96743e96a1",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::32467eea702881a84189e2c0756294f20908969aa1f08dbe20111ff05ba74b84",
      "multiple_values_in_field": true
    },
    "atom::2969c953067dbad219d5f8b0": {
      "atom_id": "atom::2969c953067dbad219d5f8b0",
      "source_handle": "P0417",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "为解释“机制”提供理论假设和间接证据。特别是关于抗生素非特异性抗炎作用的讨论，以及微生物组介导的免疫激活导致疗效和毒性并存的假说。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::c1380d633739b6409c09a4c3ee78ec05f17624561fe7d5fe1dd336699e226c44",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::5b707a9c2a4912437225849fe19dbd25efd93ce5e0d74a9b7e06be3bfe21b244",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::1fd227bf27d6d15554f9ced9bb8d6b3fb34d9cfe28b6ead92bf02a96743e96a1",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::536da7b4856ebcbca6811e35660d4bfc7eae56e26e81074de1385b60933f8ad2",
      "multiple_values_in_field": true
    },
    "atom::e76720a8cb5e362c4f2ef405": {
      "atom_id": "atom::e76720a8cb5e362c4f2ef405",
      "source_handle": "P0417",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物组对ICI疗效的双向调节作用提供了关键的临床背景素材。它汇总了抗生素作为负面调节因子的证据，以及特定微生物特征作为疗效预测指标的初步发现。对于综述而言，此文有助于构建“微生物组-免疫疗法相互作用”的临床现状图景，特别是关于抗生素干扰和微生物组成预测价值的讨论，可作为机制探讨前的现象学基础。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::c1380d633739b6409c09a4c3ee78ec05f17624561fe7d5fe1dd336699e226c44",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::5b707a9c2a4912437225849fe19dbd25efd93ce5e0d74a9b7e06be3bfe21b244",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::1fd227bf27d6d15554f9ced9bb8d6b3fb34d9cfe28b6ead92bf02a96743e96a1",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::03f8a6ff54891726a6c49ab46e533c4c090d1bf9c39e114d90a4bd3d9ba90ab6",
      "multiple_values_in_field": false
    },
    "atom::404a9ca12df1963abbc87e35": {
      "atom_id": "atom::404a9ca12df1963abbc87e35",
      "source_handle": "P0417",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述主要涵盖实体瘤，特别是NSCLC、RCC和黑色素瘤，结果可能不适用于血液肿瘤或其他类型癌症。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c1380d633739b6409c09a4c3ee78ec05f17624561fe7d5fe1dd336699e226c44",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        },
        {
          "record_id": "record::5b707a9c2a4912437225849fe19dbd25efd93ce5e0d74a9b7e06be3bfe21b244",
          "field_path": [
