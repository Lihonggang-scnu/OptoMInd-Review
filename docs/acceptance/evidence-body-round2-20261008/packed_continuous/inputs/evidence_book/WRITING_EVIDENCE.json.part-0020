    "atom::b6331b5c08533653c791a8b8": {
      "atom_id": "atom::b6331b5c08533653c791a8b8",
      "source_handle": "P0578",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "免疫关联分析为探索性，未校正多重检验，且缺乏对照组，无法证明FMT改变了这些免疫特征从而改善了预后。仅描述了相关性，未证明因果机制。",
        "contribution": "揭示了FMT干预后系统性免疫景观的变化及其与预后的关联：(1) FMT诱导的微生物定植多为暂时性，仅持久定植者与临床获益相关；(2) 基线高分化T细胞表型预示更好预后，而高髓系细胞（CD14+）和高IL-8水平预示不良预后；(3) 这些免疫特征似乎反映了宿主固有的免疫反应能力，而非FMT直接重塑的结果。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
