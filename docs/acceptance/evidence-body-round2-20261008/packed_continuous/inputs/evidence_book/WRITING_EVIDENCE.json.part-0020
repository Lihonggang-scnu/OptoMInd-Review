          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::8478d173db2cce41982a89d0f98f1bf971b9c8aae38a07120ceb00a5dce967b4",
      "multiple_values_in_field": false
    },
