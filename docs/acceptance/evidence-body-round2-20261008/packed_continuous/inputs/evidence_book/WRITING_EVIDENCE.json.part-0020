    "atom::8a2fcb48de3c88c4516ba0b6": {
      "atom_id": "atom::8a2fcb48de3c88c4516ba0b6",
      "source_handle": "P0578",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释FMT起效的潜在机制（需要持久定植和特定的宿主免疫背景）。提供生物标志物候选项（如CD14+单核细胞、IL-8、T细胞分化状态）以预测哪些患者可能从微生物调节中受益。帮助区分“药物直接效应”与“宿主背景效应”。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
