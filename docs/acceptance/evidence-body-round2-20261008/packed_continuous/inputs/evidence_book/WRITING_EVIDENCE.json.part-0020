    "atom::02f9451ee30da352c12e3c62": {
      "atom_id": "atom::02f9451ee30da352c12e3c62",
      "source_handle": "P0271",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "在晚期NSCLC患者中，是否存在特定的肠道微生物组特征可以作为预测免疫检查点抑制剂（ICI）长期疗效的生物标志物？目前缺乏能够筛选出能从ICI中长期获益患者的强效生物标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7b91a87db840b7e201226a99d95e7e47325cdc2ba8b568e02bb8144657844d6",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::d3d3338725bcb6af1d221f0aae9f1b361312ce703fcf11ad2cb0262219fa4fe8",
