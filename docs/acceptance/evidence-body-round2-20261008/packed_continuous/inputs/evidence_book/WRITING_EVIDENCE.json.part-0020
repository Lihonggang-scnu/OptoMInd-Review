          "record_id": "record::17ec529e254380cf6b84cb8828d0e4b7cbcb40aeb149c1edacb6805d9c2bdaff",
          "field_path": [
            "supplement_materials"
          ]
        }
      ],
      "variant_group": "field::1d39ad0a8c4f1d7a793f062560ccfb831f83e1e990fe7fef6173cb550abd505b",
      "multiple_values_in_field": false
    },
