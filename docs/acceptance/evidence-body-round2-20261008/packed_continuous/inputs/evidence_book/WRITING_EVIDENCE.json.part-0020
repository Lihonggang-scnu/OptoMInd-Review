    "atom::73c3353f112689f59aeb587f": {
      "atom_id": "atom::73c3353f112689f59aeb587f",
      "source_handle": "P0578",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于支持综述中关于“FMT疗效具有高度情境依赖性”或“需严格筛选患者群体”的论点。对比其他阳性研究，说明患者基线状态（如疾病负荷、进展速度）对FMT结局的关键影响。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e922ecd2e5e9a27ad505756ecac7aefe8d3f347156a4dddb6acdd9f32d90d99b",
          "field_path": [
            "review_planning_B",
