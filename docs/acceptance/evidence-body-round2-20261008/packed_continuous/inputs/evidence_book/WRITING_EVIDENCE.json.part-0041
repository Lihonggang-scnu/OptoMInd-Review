    "record::e019bc638d7f5519719278f1c816f7c200e1a8e21b65fce45b14b857ca023898": {
      "source_handle": "P0054",
      "title": "Artificial Intelligence–Enabled Multi-Omics for Predicting Immune Checkpoint Inhibitor Response and Resistance",
      "year": "2026",
      "doi": "10.2147/jmdh.s572089",
      "paper_id": "174066de2e0865cbf905ef36de34933107992fa8",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "作为一篇综述，本研究采用定性综合的方法。作者检索并筛选了关于AI在多组学分析中应用的文献，按主题分类：1) ICI响应的生物学机制（基因、表观、代谢、微生物）；2) AI算法在数据处理和特征提取中的应用；3) 预测模型的构建与性能评估；4) 临床转化挑战与未来方向。通过归纳不同癌症类型（如NSCLC、黑色素瘤、HCC等）的研究案例，总结AI-多组学集成的模式、优势及局限性。",
        "contribution_and_limits": [
          {
            "contribution": "提供了AI-多组学在ICI研究领域的全面框架，涵盖了从生物学机制到临床应用的完整链条，特别强调了微生物组和代谢组的作用。",
            "limits": "作为叙事性综述，未进行定量荟萃分析；所引用的研究多为回顾性或早期临床试验，缺乏大规模前瞻性随机对照试验的证据支持；不同研究间的模型性能和数据预处理方法差异较大，难以直接比较。"
          }
        ],
        "key_findings": [
          {
            "conditions": "多种实体瘤（如NSCLC, HCC, 结直肠癌等）",
            "finding": "AI整合多组学数据（如影像+基因组+转录组）能显著优于单一生物标志物（如TMB或PD-L1），在预测ICI响应方面表现出更高的AUC（例如DenseNet模型在NSCLC中AUC>0.80）。"
          },
          {
            "conditions": "肠道微生物组分析",
            "finding": "特定菌群（如Bacteroides caccae, Prevotella copri）丰度与ICI响应正相关，抗生素使用导致的菌群失调与耐药相关；AI可识别这些微生物特征并预测疗效。"
          },
          {
            "conditions": "肿瘤微环境与干细胞特性",
            "finding": "高干细胞评分（如MKI67/STMN1表达）和冷肿瘤微环境（免疫排斥）与较差的ICI预后相关；AI模型可识别这些特征并建议联合治疗（如化疗或靶向药）。"
          },
          {
            "conditions": "解释性AI应用",
            "finding": "SHAP和Grad-CAM等工具可将AI预测结果映射到具体的生物学特征（如突变、组织形态区域），提高了模型的可解释性和临床信任度。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "传统单一生物标志物（如PD-L1、TMB）对ICI疗效预测准确性有限，无法全面捕捉肿瘤异质性和动态免疫逃逸机制。如何利用AI整合多维多组学数据，以更精准地预测ICI响应、揭示耐药机制并指导个性化治疗？",
        "research_scope": "免疫检查点抑制剂（ICIs）在实体瘤及血液肿瘤中的应用，重点聚焦于AI驱动的多组学整合技术。涵盖基因组、转录组、表观基因组、代谢组、微生物组、病理学和影像组学等多维度数据，旨在解决ICI疗效预测和耐药机制不明的问题。",
        "work_summary": "本文是一篇叙事性综述，系统梳理了人工智能与多组学技术在预测免疫检查点抑制剂响应和耐药方面的最新进展。文章首先阐述了ICI疗效差异的生物学基础，包括肿瘤异质性、干细胞特性、微环境重塑及微生物组调控；随后介绍了AI算法如何整合异构多组学数据以发现生物标志物、构建预测模型并进行患者分层；接着讨论了这些模型在指导联合治疗、实时监测和毒性预测中的临床转化潜力；最后分析了实施障碍（如数据异质性、黑盒性质、缺乏前瞻性验证）并展望了单细胞/空间多组学、联邦学习和生成式AI等未来方向。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物组如何调节实体瘤中ICI疗效提供了丰富的背景信息和机制线索。它汇总了微生物组特征（如特定菌属丰度、抗生素影响）与ICI响应之间的关联，并指出了AI在解析这种关联中的作用。虽然它不直接提供因果证据，但为综述中关于“微生物组调节机制”的部分提供了关键的假设来源和现有研究的概览，特别是关于菌群失调导致耐药的观察性证据。",
        "facet_contributions": [
          {
            "boundaries": "仅为相关性观察，未证明因果关系；主要基于回顾性队列和小型干预研究，外推至所有实体瘤需谨慎。",
            "contribution": "提供了肠道微生物组组成（如Bacteroides, Prevotella）与ICI响应之间关联的观察性证据，以及抗生素使用对疗效的负面影响。",
            "facet_id": "F1",
            "possible_uses": "可用于回答“肠道微生物组如何调节ICI疗效”中的描述性问题，即哪些微生物特征与疗效相关。"
          },
          {
            "boundaries": "机制多为推测性或基于动物/小样本研究，缺乏在大样本人群中验证的详细分子通路证据；具体介导分子（如短链脂肪酸的具体作用）需结合其他原始研究确认。",
            "contribution": "提出了微生物组通过调节全身免疫状态（如T细胞活性）和代谢产物影响ICI疗效的潜在机制，并指出FMT可能作为一种干预手段。",
            "facet_id": "F2",
            "possible_uses": "可为“介导效应的机制”部分提供理论框架和候选机制（如免疫激活、代谢重编程），用于构建机制假说。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供AI-多组学技术的整体背景，说明为何需要整合微生物组数据以提高预测精度。",
            "material": "综述中关于AI算法整合多模态数据的流程和挑战的描述。",
            "purpose": "作为综述的技术背景，解释当前领域如何利用技术手段处理复杂的微生物组数据。"
          },
          {
            "connection_to_review": "列举了除微生物组外的其他耐药机制（如干细胞特性、代谢抑制），有助于对比和区分微生物组特异性效应。",
            "material": "关于肿瘤异质性、干细胞特性和乳酸化修饰的讨论。",
            "purpose": "作为对照信息，帮助界定微生物组效应的独特性和相对重要性。"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述是叙事性的，其结论依赖于对所引用文献的选择性综合，可能存在发表偏倚。",
          "提到的微生物组关联多为观察性研究，不能直接推断因果；抗生素的影响也是间接证据。",
          "不同癌症类型的微生物组效应可能存在差异，不应将所有实体瘤的结果泛化为统一规律。",
          "AI模型的性能指标（如AUC）在不同研究中不可直接比较，因为训练集、验证集和预处理方法各异。"
        ],
