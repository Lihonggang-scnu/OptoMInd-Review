    "record::01aa69b11b55a87a24b2b3026bd5ecb8d4e435b574dd18460a16f5ed38e994e0": {
      "source_handle": "P0447",
      "title": "Microbial metabolites and their influence on the tumor microenvironment",
      "year": "2025",
      "doi": "10.3389/fimmu.2025.1675677",
      "paper_id": "c59738fb3db453360d9f86e97ad338176abe8eb6",
      "material_depth": "",
      "material_status": "resolved",
      "aliases": [],
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch6.json",
        "source_handle": "P0447",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\c59738fb3db453360d9f86e97ad338176abe8eb6\\42993142a6b2e557adda307d103ec858\\attempt-01\\PAPER_READING_CARD.json"
      },
      "study_summary_A": {
        "approach": "本综述采用系统性文献回顾和综合的方法。首先，梳理肿瘤免疫治疗面临的挑战，特别是TME中的代谢障碍。其次，整合关于免疫细胞代谢重编程（包括能量代谢、生物合成前体供应、表观遗传调控等）的基础研究，建立代谢与免疫功能联系的框架。然后，分类汇总微生物代谢物（SCFAs, 胆汁酸, 色氨酸代谢物, LPS）的临床和实验证据，分析其来源、转运机制及其对特定免疫细胞亚群（如T细胞、巨噬细胞、DCs等）代谢通路的具体调控机制。最后，综合讨论这些代谢物如何协同或拮抗地影响免疫治疗响应，并提出未来研究方向。",
        "contribution_and_limits": [
          {
            "contribution": "提供了一个将微生物代谢物与肿瘤免疫细胞代谢重编程联系起来的综合理论框架，强调了代谢物作为“第二基因组”产物在调节TME中的核心地位。",
            "limits": "作为综述，其结论依赖于所引用的原始研究，本身不提供新的实验数据。对于不同代谢物之间的复杂相互作用、剂量依赖性效应以及在人体内的具体临床转化效果，尚需更多前瞻性临床试验验证。"
          }
        ],
        "key_findings": [
          {
            "conditions": "在黑色素瘤和肺癌患者中，对PD-1抑制剂有响应的个体通常具有更高的肠道微生物多样性和产SCFA细菌丰度。",
            "finding": "SCFAs（如丁酸盐）可通过促进CD8+ T细胞激活、M1型巨噬细胞极化等机制，增强免疫检查点抑制剂的疗效，将“冷”肿瘤转化为“热”肿瘤。"
          },
          {
            "conditions": "在结直肠癌肝转移模型中，肠道菌群产生的次级胆汁酸通过TGR5信号通路招募髓源性抑制细胞（MDSCs）。",
            "finding": "胆汁酸具有双重作用：一方面可能通过抑制CD8+ T细胞功能促进肿瘤进展；另一方面，通过TGR5/mTOR/OXPHOS通路可激活CD8+ T细胞，增强抗肿瘤免疫。"
          },
          {
            "conditions": "肠道菌群（如双歧杆菌、Akkermansia）代谢色氨酸产生吲哚衍生物（如ILA, IPA）。",
            "finding": "这些代谢物通过激活芳香烃受体（AhR）信号通路，调节Treg分化、巨噬细胞极化和CD8+ T细胞功能，从而增强免疫治疗疗效或维持免疫稳态。"
          },
          {
            "conditions": "革兰氏阴性菌释放的LPS通过TLR4/MyD88/NF-κB通路。",
            "finding": "LPS可诱导慢性炎症，促进肿瘤侵袭和转移，但也可能通过激活特定免疫细胞亚群增强抗肿瘤免疫反应。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管免疫治疗在血液系统恶性肿瘤中取得进展，但在实体瘤中仍面临免疫抑制微环境和代谢异常导致的疗效有限及耐药问题。微生物组被称为“第二基因组”，其代谢物如何作为关键信使，通过调节免疫细胞的代谢重编程来影响肿瘤免疫逃逸和免疫治疗抵抗？",
        "research_scope": "肿瘤免疫微环境（TME）中的免疫细胞代谢重编程，以及肠道和肿瘤相关微生物群产生的代谢物（短链脂肪酸、胆汁酸、色氨酸代谢物、LPS等）对这一过程的调控作用。",
        "work_summary": "本文是一篇综述，旨在阐明微生物代谢物如何通过调节免疫细胞的代谢途径来影响肿瘤免疫反应和免疫治疗疗效。文章首先概述了肿瘤免疫治疗的现状与挑战，特别是实体瘤中由代谢异常和免疫抑制微环境导致的耐药性。随后，详细阐述了免疫细胞代谢（如糖酵解、OXPHOS、脂质代谢等）在决定免疫细胞命运和功能中的核心作用。在此基础上，重点分析了四类主要微生物代谢物——短链脂肪酸（SCFAs）、胆汁酸、色氨酸代谢物和脂多糖（LPS）——作为连接微生物组与宿主免疫系统的“信使”，通过受体依赖或非依赖机制，重塑TME中的免疫细胞代谢状态，进而调节抗肿瘤免疫应答和免疫检查点抑制剂（ICIs）的疗效。最后，讨论了这些发现对开发基于微生物代谢的精准干预策略的理论意义和未来方向。"
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "为理解为何需要探索微生物组-代谢轴作为克服ICI耐药的新策略提供背景。",
            "material": "介绍了肿瘤免疫治疗在实体瘤中面临的挑战，包括TME的物理屏障、免疫抑制细胞（TAMs, MDSCs）的作用以及代谢压力（缺氧、乳酸、葡萄糖剥夺）导致的T细胞耗竭。",
