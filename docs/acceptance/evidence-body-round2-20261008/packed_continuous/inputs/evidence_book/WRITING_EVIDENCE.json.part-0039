    "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0": {
      "source_handle": "P0594",
      "title": "Targeting the gut microbiota-metabolite-immune axis in cancer immunotherapy: mechanistic interplay, therapeutic strategies, and translational applications-a narrative review",
      "year": "2026",
      "doi": "10.21037/tcr-2025-1992",
      "paper_id": "CorpusId:286927958",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "作者通过PubMed数据库进行了系统性文献检索（2019年1月至2025年12月），筛选出关于肠道微生物群和代谢物在癌症免疫治疗中作用的基础和转化研究。随后，文章采用叙事性综述的方法，将内容分为三个主要部分：(1) 详细解析核心代谢物（SCFAs、色氨酸代谢物、胆汁酸、肌苷）的免疫调节机制；(2) 按肿瘤类型（胃肠道与非胃肠道）总结微生物签名与ICI疗效的关联；(3) 评估FMT、益生菌、工程菌等干预策略的转化应用。文中引用了大量图表（Figure 1-3, Table 2）来整合机制网络和治疗策略。",
        "contribution_and_limits": [
          {
            "contribution": "提供了肠道微生物群-代谢物-免疫轴在多类实体瘤中的系统性机制框架，特别强调了代谢物的情境依赖性（如丁酸的双向作用）和肿瘤特异性微生物签名。",
            "limits": "作为叙事性综述，其结论基于已发表研究的综合，缺乏原始数据的定量合成（如Meta分析）。许多机制证据来自动物模型或小样本临床研究，大规模随机对照试验（RCTs）数据尚缺，且个体间微生物组异质性导致标准化治疗面临挑战。"
          }
        ],
        "key_findings": [
          {
            "conditions": "短链脂肪酸（特别是丁酸）",
            "finding": "具有双向且依赖情境的免疫调节作用：一方面通过抑制HDAC活性、增强CD8+ T细胞毒性及TCR信号传导来增强抗肿瘤免疫；另一方面在某些情况下（如抗CTLA-4治疗中）可能抑制树突状细胞成熟，减弱T细胞激活。"
          },
          {
            "conditions": "色氨酸代谢物",
            "finding": "犬尿氨酸（Kyn）通过AhR通路促进Treg分化，抑制效应T细胞，削弱免疫反应；而吲哚-3-甲醛（I3A）和ICA则通过激活AhR/IL-22轴或抑制IDO1，增强CD8+ T细胞功能并维持肠道屏障完整性。"
          },
          {
            "conditions": "胆汁酸（BAs）",
            "finding": "次级胆汁酸如isoDCA促进Treg扩增，抑制DC功能；而UDCA通过降解TGF-β抑制Treg分化，增强抗肿瘤免疫。不同胆汁酸对CD8+ T细胞命运有截然相反的影响。"
          },
          {
            "conditions": "肌苷（Inosine）",
            "finding": "作为关键代谢物，肌苷通过抑制UBA6增加肿瘤免疫原性，结合A2AR促进Th1细胞分化，并在葡萄糖受限的微环境中作为替代能源维持效应T细胞的存活和杀伤功能。"
          },
          {
            "conditions": "不同肿瘤类型",
            "finding": "存在肿瘤特异性的微生物签名：例如ESCC中Streptococcus富集与良好响应相关，Fn驱动耐药；HCC中Akk和Ruminococcaceae富集者预后较好；黑色素瘤中Bifidobacterium和Ruminococcaceae与ICI疗效正相关。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管免疫检查点抑制剂（ICIs）取得了显著进展，但原发性或获得性耐药限制了其临床疗效。目前对于肠道微生物群-代谢物-免疫轴影响ICI疗效的具体分子机制以及不同肿瘤类型中的特异性调控模式仍不完全清楚。本研究旨在阐明这些机制并综合现有的微生物靶向治疗策略，以改善免疫治疗结果。",
        "research_scope": "该综述聚焦于肠道微生物群-代谢物-免疫轴在癌症免疫治疗中的作用，涵盖胃肠道肿瘤（如食管癌、胃癌、胰腺癌、肝癌、结直肠癌）和非胃肠道实体瘤（如黑色素瘤、肾细胞癌）。研究对象包括核心代谢物（短链脂肪酸、色氨酸代谢物、胆汁酸、肌苷）、特定微生物菌群及其与免疫检查点抑制剂（ICIs）疗效的相互作用。",
        "work_summary": "这是一篇叙事性综述，旨在系统梳理肠道微生物群及其代谢产物调节抗肿瘤免疫的分子机制，并综合评估针对该轴的转化治疗策略。文章首先阐述了微生物代谢物如何通过表观遗传修饰、受体结合和代谢重编程等途径重塑免疫微环境；其次，按肿瘤类型归纳了特征性微生物签名及其对ICI响应的影响；最后，讨论了粪菌移植（FMT）、益生菌补充、工程菌及其他干预手段的临床潜力与挑战。尽管采用了系统性的文献检索流程，但其性质为叙事性综述，侧重于机制解释和策略综合，而非严格的荟萃分析。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物如何调节实体瘤对免疫检查点抑制剂（ICIs）的响应提供了详细的机制背景和分类素材。它特别有价值地梳理了四大类核心代谢物（SCFAs、色氨酸代谢物、胆汁酸、肌苷）的具体作用路径，并按肿瘤类型整理了特征性微生物签名。此外，它还评估了FMT、益生菌和工程菌等干预策略的现状与挑战，可直接用于回答微生物组调节ICI疗效的机制及现有干预手段的有效性。",
        "facet_contributions": [
          {
            "boundaries": "这些关联多基于观察性队列或动物模型，因果关系需进一步验证；且不同研究间的微生物定义和分析方法可能存在差异。",
            "contribution": "提供了不同肿瘤类型中特征性微生物签名与ICI疗效关联的分类信息。具体包括：ESCC中Streptococcus富集与CD8+ T细胞浸润相关，Fn驱动耐药；HCC中Akk和Ruminococcaceae富集预示良好响应；黑色素瘤中Bifidobacterium和Ruminococcaceae与疗效正相关；结直肠癌中Lactobacillus rhamnosus GG和Roseburia intestinalis增强敏感性，而Peptostreptococcus anaerobius促进MDSC积累导致耐药。",
            "facet_id": "F1",
            "possible_uses": "可用于回答“哪些微生物特征预测了实体瘤患者对ICIs的响应？”这一问题，提供具体的细菌属/种及其在不同癌症背景下的作用方向。"
          },
          {
            "boundaries": "机制细节多源于体外实验或小鼠模型，人体内的确切浓度和效应阈值尚不明确；部分机制（如丁酸的双向作用）高度依赖肿瘤微环境的特定状态。",
            "contribution": "详细阐述了四类核心代谢物调节抗肿瘤免疫的具体分子机制。包括：(1) SCFAs（如丁酸）通过抑制HDAC、激活GPR109A/TLR5通路增强CD8+ T细胞功能，但具有情境依赖性；(2) 色氨酸代谢物中，Kyn通过AhR促进Treg，而I3A/ICA通过AhR/IDO1通路增强效应T细胞；(3) 胆汁酸中，isoDCA促进Treg，UDCA抑制Treg；(4) 肌苷通过抑制UBA6、激活A2AR/cAMP-CREB通路及作为替代能源支持T细胞代谢。",
            "facet_id": "F2",
            "possible_uses": "直接用于回答“微生物组调节ICI疗效的机制是什么？”这一问题，提供从受体结合、表观遗传修饰到代谢重编程的多层次机制解释。"
          },
          {
            "boundaries": "大多数干预措施仍处于早期临床试验阶段，缺乏大规模RCT证据；个体化匹配和长期安全性仍是未决问题。",
            "contribution": "评估了针对微生物组的干预策略（FMT、益生菌、工程菌）在增强ICI疗效方面的转化潜力和当前局限。指出FMT在黑色素瘤和小样本研究中显示出提高ORR的潜力，但面临标准化和安全风险；益生菌（如LGG、Faecalibacterium prausnitzii）可通过产生代谢物或下调PD-L1增强疗效，但也存在负面案例；工程菌和噬菌体疗法代表了精准调控的新方向。",
            "facet_id": "F1",
            "possible_uses": "用于回答“目前有哪些基于微生物组的干预手段被探索用于改善ICI疗效？”以及“这些手段的临床转化现状如何？”提供策略分类、成功案例及面临的监管和技术挑战。"
          }
        ],
        "broader_review_uses": [
          {
