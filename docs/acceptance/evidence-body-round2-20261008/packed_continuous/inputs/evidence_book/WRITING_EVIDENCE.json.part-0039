          "immune cell metabolic reprogramming",
          "tumor microenvironment (TME)",
          "immune checkpoint inhibitors (ICIs)",
          "solid tumors",
          "gut microbiome",
          "aryl hydrocarbon receptor (AhR)",
          "G protein-coupled receptors (GPCRs)"
        ]
      },
