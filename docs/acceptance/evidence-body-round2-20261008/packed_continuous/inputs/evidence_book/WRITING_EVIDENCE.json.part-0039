    "record::f63dfcb79a3ed06be7080d88b99e3f72f53931346bcc56ffcc4727bbc5001373": {
      "source_handle": "P0125",
      "title": "376 A phase I/II study of live biotherapeutic MRx0518 in combination with pembrolizumab in patients refractory to immune checkpoint inhibitors",
      "year": "2020",
      "doi": "10.1136/jitc-2020-sitc2020.0376",
      "paper_id": "3681bf55ee7a54db3e29efef26cafae311f70b3b",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用分阶段的 I/II 期临床试验设计。Part A 为已完成的安全性评估阶段，纳入 12 名经 Safety Review Committee 审核的患者。Part B 为扩展招募阶段，针对 RCC、NSCLC 或膀胱癌患者。入组标准严格定义为 ICIs 耐药：即初始对 PD-1 通路靶向治疗有反应，但在最后一次给药后 12 周内出现由两次间隔至少 4 周的影像学扫描确认的疾病进展，且无快速临床进展。治疗方案为每日两次口服 MRx0518（1×10^10 至 1×10^11 CFU）联合每三周一次静脉注射 pembrolizumab（200 mg）。主要终点为第一周期治疗期间的毒性监测（安全性），次要终点包括客观缓解率（ORR）、缓解持续时间（DOR）、疾病控制率（DCR）和无进展生存期（PFS）。探索性终点涉及生物标志物、微生物组影响、总生存期（OS）以及与 PD-L1 CPS/TPS 的相关性。样本采集包括血液、粪便、尿液及可选的组织活检。",
        "contribution_and_limits": [
          {
            "contribution": "提供了 MRx0518 在 ICIs 耐药实体瘤患者中与 pembrolizumab 联合使用的早期临床开发框架和部分安全性结论（Part A 完成并通过审查）。明确了此类难治性人群的定义标准和试验设计细节。",
            "limits": "所给摘要未交代任何具体的疗效数据、安全性不良事件详情或机制探索结果。Part B 仍在招募中，因此缺乏完整的临床结局证据。无法从当前材料中得出关于该疗法有效性的结论。"
          }
        ],
        "key_findings": [
          {
            "conditions": "Part A: 12 名 mRCC 和 mNSCLC 患者，联合使用 MRx0518 与 pembrolizumab",
            "finding": "所给摘要未交代具体的安全性数据结果、疗效数据（ORR, DCR, PFS 等）或生物标志物分析结果。仅陈述 Safety Review Committee 判定 Proceed to Part B 是适当的。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "既往研究表明 MRx0518 具有免疫刺激作用，但在对免疫检查点抑制剂产生耐药性的实体瘤患者中，将其与 pembrolizumab 联合使用的安全性和潜在临床益处尚不明确。本研究试图解决如何逆转或克服 ICIs 耐药的问题。",
        "research_scope": "针对对免疫检查点抑制剂（ICIs）耐药的实体瘤患者，评估新型口服活体生物制剂 MRx0518（一种源自人肠道微生物群的 Enterococcus 属细菌）与 pembrolizumab 联合治疗的临床安全性及初步疗效。研究队列包括转移性肾细胞癌（mRCC）、非小细胞肺癌（mNSCLC）和膀胱癌患者。",
        "work_summary": "该论文报告了一项 I/II 期临床试验的进展摘要。研究分为两部分：Part A 已完成，评估了 12 名 mRCC 和 mNSCLC 患者的联合治疗安全性；Part B 正在招募中，计划在每个适应症中额外招募最多 30 名患者。MRx0518 被选为开发候选药物是因为其体外和体内研究显示具有强效免疫刺激活性，能抑制肿瘤生长并调节 T 细胞分化。本研究旨在验证在 ICIs 耐药背景下，该联合疗法是否安全并能提供临床获益。"
      },
      "review_planning_B": {
        "planning_summary": "该文献作为一项正在进行中的临床试验记录，提供了将特定肠道菌群菌株（MRx0518）用于逆转免疫检查点抑制剂耐药性的具体临床方案设计和患者筛选标准。虽然缺乏最终疗效数据，但其对“ICIs 耐药”的操作性定义以及联合用药策略，对于综述中讨论微生态干预的临床转化路径和耐药机制背景具有重要参考价值。",
        "facet_contributions": [
          {
            "boundaries": "由于缺乏疗效结果，不能证明 MRx0518 确实改善了耐药患者的预后。仅能说明这是一种正在进行的探索性策略。",
            "contribution": "提供了针对 ICIs 耐药实体瘤患者的具体临床干预方案（MRx0518 + pembrolizumab）。定义了“耐药”的临床操作标准（初始响应后进展，影像学确认，时间窗口限制）。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中阐述微生态疗法在克服 ICIs 耐药方面的临床尝试现状。帮助界定哪些患者群体被视为潜在的微生态干预受益者。"
          },
          {
            "boundaries": "这些机制描述来源于体外和动物模型的前体研究，而非本临床试验的直接发现。本摘要未提供本研究中实际观察到的机制关联数据。",
            "contribution": "介绍了 MRx0518 的拟议作用机制基础（基于前体研究：减少 Treg，增加 Th1/Tc1，增加肿瘤内 CD4+/CD8+ T 细胞和 NK 细胞）。列出了探索性生物标志物收集计划（血液、粪便、组织活检以评估免疫标记和微生物组）。",
            "facet_id": "F2",
            "possible_uses": "可作为综述中讨论微生态调节免疫微环境潜在机制的理论依据之一。展示了研究者如何通过多组学采样来验证机制假设。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "有助于综述明确“耐药”这一关键概念的临床边界，区分原发性耐药与继发性/获得性耐药的不同情境。",
            "material": "对 ICIs 耐药的具体定义：初始 PD-1 靶向治疗有益，但随后出现影像学确认的进展，且在末次给药后 12 周内发生，无快速临床恶化。",
            "purpose": "背景与概念：定义难治性人群"
          },
          {
            "connection_to_review": "作为微生态疗法从实验室向临床转化的具体案例，展示当前领域内单一菌株疗法的研发进展和监管审批流程（如 IRB 批准、NCT 注册号）。",
            "material": "MRx0518 作为一种单菌株口服活体生物制剂，已进入 I/II 期临床试验，并与 pembrolizumab 联用。",
            "purpose": "实例：活体生物制剂的临床开发状态"
          }
        ],
        "scope_interpretation_cautions": [
          "该论文仅为临床试验摘要，未包含 Part A 的具体安全性数据或 Part B 的任何疗效数据。所有关于“有效性”或“安全性结论”的推断均不可基于此材料。",
          "文中提到的免疫调节机制（Treg/Th1/Tc1 变化等）是基于前体研究（in vitro/in vivo models）的描述，并非本临床试验的实际结果。",
          "研究对象限定为对 ICIs 耐药的实体瘤患者，结果外推至初治患者或其他癌症类型需谨慎。"
        ],
        "topic_handles": [
          "MRx0518 (Enterococcus genus live biotherapeutic)",
          "Immune Checkpoint Inhibitor (ICI) refractory/resistant patients",
          "Solid tumours (mRCC, mNSCLC, bladder cancer)",
          "Combination therapy with pembrolizumab",
          "Clinical trial design for microbiome modulation"
        ]
      },
