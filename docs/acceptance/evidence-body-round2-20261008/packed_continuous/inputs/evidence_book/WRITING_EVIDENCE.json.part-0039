    "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5": {
      "source_handle": "P0244",
      "title": "805 Safety and emerging evidence of immune modulation of the live biotherapeutic MRx0518 in the neoadjuvant setting for patients awaiting surgical removal of solid tumours",
      "year": "2020",
      "doi": "10.1136/jitc-2020-sitc2020.0805",
      "paper_id": "6616c4ad828cc2fd463ceba12acdf8d1aad10caf",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用单臂、开放标签的早期临床试验设计。纳入标准：组织学确诊的实体瘤、计划进行手术切除、初治患者。干预措施：口服 MRx0518（1x10^10 至 1x10^11 CFU），每日两次，持续至术前一天（最长28天）。数据收集：记录不良事件以评估安全性；收集治疗前（诊断性活检）和治疗后（手术标本）的配对样本，利用 NanoString Pan Cancer IO 360™ 基因表达面板进行转录组分析，同时计划进行微生物组和代谢组分析。",
        "contribution_and_limits": [
          {
            "contribution": "提供了 MRx0518 在人类实体瘤患者中短期使用的安全性数据，证实了其良好的耐受性。",
            "limits": "样本量小（n=17），且仅分析了前 5 对样本的基因表达数据，缺乏统计效力来确立普遍性的免疫调节模式。"
          },
          {
            "contribution": "初步证据表明 MRx0518 可能在体内诱导与临床前模型相似的免疫激活信号（基因表达变化）。",
            "limits": "基因表达变化的具体机制和功能后果尚未经过充分验证；未提供疗效（如肿瘤缩小）的直接证据，因为主要终点是安全性。"
          },
          {
            "contribution": "确立了在新辅助设置中使用配对活检样本评估微生物疗法对宿主免疫影响的方法学可行性。",
            "limits": "由于 COVID-19 疫情导致手术延迟，部分患者的治疗窗口可能受到影响，且后续 Part B 才包含安慰剂对照和更大规模的疗效评估。"
          }
        ],
        "key_findings": [
          {
            "conditions": "Part A, n=17 (breast n=8, prostate n=4, uterine n=3, melanoma n=1, bladder n=1), treatment naive, solid tumours awaiting surgery",
            "finding": "MRx0518 单药治疗显示出良好的安全性和耐受性，未报告 3/4 级 CTCAE 毒性，无严重不良反应或治疗中断。所有患者均接受了手术（3例因新冠疫情延迟）。"
          },
          {
            "conditions": "First 5 paired samples analysed using NanoString Pan Cancer IO 360™ Gene Expression panel",
            "finding": "在 48 个基因中观察到显著的基因表达谱变化（p < 0.05），提示免疫细胞浸润增加，这与临床前模型中的观察结果一致。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "评估 MRx0518 作为单药治疗在实体瘤患者中的安全性和耐受性；探索其是否能在人体内重现临床前观察到的免疫刺激效应，并识别潜在的疗效生物标志物。",
        "research_scope": "接受手术切除治疗的初治实体瘤患者（包括乳腺癌、前列腺癌、子宫内膜癌、黑色素瘤和膀胱癌），在术前新辅助阶段口服活体生物制剂 MRx0518。",
        "work_summary": "该研究是一项针对新型肠道微生物来源口服活体生物制剂 MRx0518 的早期临床试验，旨在评估其在实体瘤患者中的安全性和耐受性，并探索其对免疫微环境的潜在调节作用。MRx0518 源自粪肠球菌，临床前研究显示其能诱导 NK 细胞及 CD8+、CD4+ T 细胞的肿瘤浸润。本研究招募了 17 名初治患者，每日两次服用胶囊，直至术前一天。主要终点为安全性，次要探索性终点包括通过 NanoString 基因表达面板分析配对活检样本中的基因表达变化、微生物组分析及代谢标志物检测。结果显示药物耐受性良好，且初步基因分析显示部分患者存在显著的免疫相关基因表达改变。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了活体生物制剂（LBP）MRx0518 在人体内的初步安全性和免疫调节证据。对于综述而言，其核心价值在于连接临床前机制（NK/CD8+ T细胞浸润）与早期临床观察（基因表达变化），并为“肠道微生物组调节免疫检查点抑制剂疗效”这一主题提供了一个具体的分子机制案例（即通过直接免疫刺激而非仅通过重塑菌群结构）。它展示了 LBP 作为单一干预手段如何改变肿瘤微环境的转录特征，尽管尚未证明最终临床疗效。",
        "facet_contributions": [
          {
            "boundaries": "仅限 Part A 的前 5 对样本分析，未涉及与免疫检查点抑制剂（ICI）联合用药的实际疗效数据。",
            "contribution": "提供了 MRx0518 在实体瘤患者中诱导免疫相关基因表达变化的初步人体数据。",
            "facet_id": "F1",
            "possible_uses": "可用于解释肠道微生物疗法如何在人体内启动免疫反应，作为 ICI 疗效调节的背景机制之一。说明 LBP 可能通过直接激活固有或适应性免疫通路来增强抗肿瘤免疫。"
          },
          {
            "boundaries": "机制推断基于基因表达谱，而非直接的因果实验（如细胞因子测定或功能实验）。",
            "contribution": "揭示了 MRx0518 可能通过上调特定免疫基因（48个显著变化基因）来介导免疫刺激，支持其作为免疫佐剂的潜力。",
            "facet_id": "F2",
            "possible_uses": "用于描述微生物疗法介导免疫效应的潜在分子路径，特别是与 NK 细胞和 T 细胞浸润相关的通路。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "背景信息：活体生物制剂作为调节肠道微生物组以增强癌症免疫治疗的一种策略。",
            "material": "MRx0518 的临床前有效性数据（小鼠模型中的肿瘤生长减少和免疫细胞浸润）及其在人体中的安全性概况。",
            "purpose": "展示从临床前到早期的转化研究路径，说明为何选择特定菌株（Enterococcus gallinarum）作为候选药物，以及其预期的免疫刺激机制。"
          },
          {
            "connection_to_review": "对比基线：单药 LBP 与联合 ICI 治疗的差异。",
            "material": "本研究仅评估 MRx0518 单药的安全性，而提及正在进行的与其他疗法（如 ICI）的组合试验。",
            "purpose": "强调目前关于 LBP 单独使用对实体瘤疗效的证据有限，突出组合治疗（LBP + ICI）在综述中的重要性，因为单药效果可能不足以产生显著的临床获益。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究未直接测试 MRx0518 与免疫检查点抑制剂（ICI）的联合疗效，因此不能直接回答 F1 中关于“调节 ICI 疗效”的核心问题，只能提供潜在的机制基础。",
          "基因表达变化的样本量极小（n=5），结果具有探索性，不应被视为确证的生物学标志物。",
          "COVID-19 导致的延误可能引入了混杂因素，尽管主要结论基于安全性，但需注意治疗依从性或时长的潜在变异。",
          "作者声称的“免疫细胞浸润增加”是基于基因表达数据的推断，需结合其他独立验证数据（如流式细胞术或免疫组化）才能确证。"
        ],
        "topic_handles": [
          "Live biotherapeutics (MRx0518)",
          "Neoadjuvant setting",
          "Solid tumours (breast, prostate, uterine, melanoma, bladder)",
          "Immune cell infiltration (NK cells, CD8+ T-cells)",
          "Gene expression profiling (NanoString IO 360)",
          "Safety and tolerability in cancer patients"
        ]
      },
