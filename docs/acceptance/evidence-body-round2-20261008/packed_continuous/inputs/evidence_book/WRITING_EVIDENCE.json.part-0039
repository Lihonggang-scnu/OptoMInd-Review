    "record::ae6fc092083bad76a3be286e49684b5c3f415ec697f0b3a6f27ad3969d1723b6": {
      "source_handle": "P0006",
      "title": "77 Impact of CBM588 on gut microbiome composition and dysbiosis in patients receiving frontline immune checkpoint inhibitor (ICI) combinations for metastatic renal cell carcinoma (mRCC)",
      "year": "2024",
      "doi": "10.1093/oncolo/oyae181.007",
      "paper_id": "00f9287693a34900251aaeb6413aa11954a22877",
      "material_depth": "structured_partial",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用回顾性分析设计，整合两项独立的I期随机临床试验数据。纳入接受nivo/ipi或cabo/nivo +/- CBM588治疗的mRCC患者。收集基线和第12周的粪便样本进行宏基因组测序（MetaPhlan v4）。主要分析方法包括：1) 比较SOC组与SOC/CBM组在基线和第12周的Alpha和Beta多样性；2) 使用Wilcoxon配对检验评估临床相关微生物物种丰度的变化；3) 计算Firmicutes/Bacteroidetes比率以衡量菌群失调程度。",
        "contribution_and_limits": [
          {
            "contribution": "提供了CBM588调节肠道微生物组的直接证据，特别是其能防止Eubacterium siraeum耗竭并纠正Firmicutes/Bacteroidetes比率失衡，这为之前观察到的临床获益提供了生物学机制假设。",
            "limits": "样本量较小（N=58），且为I期试验数据的二次分析；仅报告了微生物组变化，未直接关联临床结局数据（如ORR、PFS）；未区分两种不同的ICI联合方案对微生物组影响的潜在差异；缺乏长期随访数据。"
          }
        ],
        "key_findings": [
          {
            "conditions": "SOC组 vs SOC/CBM组，基线 vs 第12周",
            "finding": "两组间Alpha和Beta多样性在第12周均无统计学显著差异。"
          },
          {
            "conditions": "SOC组，基线 vs 第12周",
            "finding": "Alistipes senegalensis减少（LFC -0.82, P=0.004）；Eubacterium siraeum显著减少（LFC -1.75, P=0.005）；Firmicutes/Bacteroidetes比率从89.0%增加到96.4%（提示菌群失调加重）。"
          },
          {
            "conditions": "SOC/CBM组，基线 vs 第12周",
            "finding": "Alistipes senegalensis减少（LFC -0.36, P=0.007）；Eubacterium siraeum未发生显著减少；Firmicutes/Bacteroidetes比率从100.0%显著下降到75.7%（提示菌群失调改善）。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "在mRCC患者中，添加CBM588到一线ICI联合治疗方案中，如何影响肠道微生物组的组成和菌群失调状态？其是否通过调节微生物组来介导临床获益？",
        "research_scope": "转移性肾细胞癌（mRCC）患者，接受一线免疫检查点抑制剂（ICI）联合治疗（纳武利尤单抗/伊匹木单抗或卡博替尼/纳武利尤单抗），部分患者联合使用活体生物疗法CBM588。样本来自两项I期临床试验的合并队列，共58名患者。",
        "work_summary": "本研究旨在探讨活体生物疗法CBM588对接受一线ICI联合治疗的mRCC患者肠道微生物组组成及菌群失调的影响。研究团队合并了两项I期随机临床试验的数据，对比了标准治疗（SOC）组与SOC联合CBM588组在基线和第12周时的肠道微生物多样性及组成变化。结果显示，CBM588显著改善了菌群失调指标，并防止了与ICI疗效相关的特定菌种耗竭，为CBM588增强临床疗效提供了潜在的微生物机制解释。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了CBM588作为微生物组调节剂在mRCC ICI治疗中的具体作用证据。它展示了特定的微生物响应模式（纠正F/B比率、保护E. siraeum），可用于综述中关于“微生物组特征预测或介导ICI疗效”以及“益生菌/合生元干预策略”的部分。特别适用于讨论哪些微生物变化与ICI治疗期间的菌群失调缓解相关。",
        "facet_contributions": [
          {
            "boundaries": "仅限mRCC人群；仅涉及CBM588这一种干预手段；未提供临床终点与微生物变化的直接相关性统计，仅作为机制推测的基础。",
            "contribution": "提供了CBM588干预下mRCC患者肠道微生物组的具体变化图谱。显示CBM588能逆转ICI治疗常见的菌群失调趋势（降低F/B比率），并维持Eubacterium siraeum水平。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物组如何调节ICI疗效”中的描述性问题，即展示一种成功的微生物组干预案例及其对应的微生物学改变。可作为支持“特定微生物群有助于维持ICI疗效”的证据之一。"
          },
          {
            "boundaries": "这是基于观察到的微生物变化的“合理机制推测”，而非经过功能验证的因果证据。需结合其他研究确认E. siraeum在ICI疗效中的具体功能角色。",
            "contribution": "提出了CBM588通过防止有益菌（E. siraeum）耗竭和纠正菌群失调来介导临床获益的潜在机制路径。",
            "facet_id": "F2",
            "possible_uses": "用于综述中关于“机制”的部分，说明微生物组成分的改变（特别是特定菌种的保留和群落结构的稳定）可能是ICI疗效增强的中介因素。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "为综述提供具体的临床前/早期临床研究实例，展示微生物组靶向治疗在实体瘤免疫治疗中的实际进展和挑战。",
            "material": "CBM588作为一种基于丁酸梭菌的活体生物疗法，在mRCC ICI治疗中的应用背景。",
            "purpose": "背景与实例"
          },
          {
            "connection_to_review": "在综述的方法论部分，可提及此类常用分析工具和指标，但需注意不同研究间指标定义和分析方法的异质性。",
            "material": "使用MetaPhlan v4进行分类学分析，以及使用F/B比率作为菌群失调指标的实践。",
            "purpose": "方法学参考"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为I期试验数据的汇总分析，样本量有限，结果可能受选择偏倚影响。",
          "发现的微生物变化是观察性关联，不能直接推断为导致临床获益的唯一或主要原因。",
          "未区分nivo/ipi和cabo/nivo两种方案对微生物组的不同影响，可能存在混杂因素。",
          "作者声称的“机制”是基于微生物组变化的推论，需警惕将相关性误读为因果性。"
        ],
        "topic_handles": [
          "CBM588 (Clostridium butyricum-based live biotherapeutic)",
          "metastatic renal cell carcinoma (mRCC)",
          "immune checkpoint inhibitors (ICI) combinations: nivo/ipi, cabo/nivo",
          "gut microbiome dysbiosis metrics: Firmicutes/Bacteroidetes ratio",
          "specific microbial species: Eubacterium siraeum, Alistipes senegalensis",
          "microbiome modulation as a mechanism for ICI efficacy"
        ]
      },
