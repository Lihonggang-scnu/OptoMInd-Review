    "record::890fce072a8f724aaec9108f7e6fb477e88b3e6ebacc50fe6157574d9cf1fe81": {
      "source_handle": "P0143",
      "title": "Impact of CBM588 on gut microbiome composition and dysbiosis in patients receiving frontline immune checkpoint inhibitor (ICI) combinations for metastatic renal cell carcinoma (mRCC).",
      "year": "2024",
      "doi": "10.1200/jco.2024.42.16_suppl.4550",
      "paper_id": "40bb0c781682f60135b3050a5dd92d2659017944",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用回顾性分析设计，合并两项独立的I期随机临床试验数据。纳入接受nivo/ipi或cabo/nivo +/- CBM588治疗的mRCC患者。使用MetaPhlan v4进行分类学分析，计算Alpha和Beta多样性。利用Wilcoxon配对检验评估从基线到第12周临床相关微生物物种丰度的变化。计算Firmicutes/Bacteroidetes比率作为菌群失调的衡量指标，并比较SOC组与SOC/CBM组的差异。",
        "contribution_and_limits": [
          {
            "contribution": "提供了CBM588调节肠道微生物组的直接证据，特别是其能防止Eubacterium siraeum耗竭并纠正F/B比率升高，这可能与改善ICI疗效有关。",
            "limits": "仅基于两项I期试验的合并小样本（N=58）分析，缺乏长期随访和临床终点（如OS/PFS）的直接关联分析。未交代具体的统计校正方法（如多重比较校正）。所给摘要未交代微生物组变化与具体临床响应率之间的直接相关性。"
          }
        ],
        "key_findings": [
          {
            "conditions": "SOC组 vs SOC/CBM组，基线 vs 第12周",
            "finding": "两组间Alpha和Beta多样性在基线与第12周之间无统计学显著差异。"
          },
          {
            "conditions": "Alistipes senegalensis丰度变化",
            "finding": "在SOC组和SOC/CBM组中均显著下降（SOC: LFC -0.82, P=0.004; SOC/CBM: LFC -0.36, P=0.007）。"
          },
          {
            "conditions": "Eubacterium siraeum丰度变化",
            "finding": "仅在SOC组中显著下降（LFC -1.75, P=0.005），而在SOC/CBM组中未观察到显著下降。"
          },
          {
            "conditions": "Firmicutes/Bacteroidetes比率变化",
            "finding": "SOC组从89.0%增加至96.4%；SOC/CBM组从100.0%显著下降至75.7%。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "在mRCC患者中，补充CBM588如何影响肠道微生物组的组成和菌群失调状态？其是否通过调节微生物组来增强ICI治疗的潜在疗效？",
        "research_scope": "转移性肾细胞癌（mRCC）患者，接受一线免疫检查点抑制剂（ICI）联合治疗（纳武利尤单抗/伊匹木单抗或卡博替尼/纳武利尤单抗），并补充活体生物制剂CBM588。研究基于两项I期临床试验的合并队列。",
        "work_summary": "本研究旨在探讨活体生物制剂CBM588对接受一线ICI联合治疗的mRCC患者肠道微生物组组成及菌群失调的影响。通过整合两项随机I期临床试验的数据，比较标准治疗（SOC）与SOC联合CBM588两组患者在基线和第12周的肠道微生物多样性、物种丰度变化以及Firmicutes/Bacteroidetes比率的变化。结果显示，CBM588显著纠正了菌群失调指标，并防止了与ICI反应相关的特定菌种耗竭，为CBM588改善临床结局提供了潜在的微生物机制解释。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了CBM588这一特定益生菌制剂在mRCC ICI治疗背景下对肠道微生物组的具体调节作用。它展示了如何通过特定的微生物标志物（如E. siraeum的保护和F/B比率的降低）来量化“菌群失调”的纠正，并为理解益生菌辅助ICI治疗的机制提供了实证数据。",
        "facet_contributions": [
          {
            "boundaries": "仅限mRCC人群；仅涉及CBM588一种制剂；样本量较小（N=58）；主要关注微生物组变化而非直接的临床疗效关联。",
            "contribution": "提供了益生菌（CBM588）调节肠道微生物组以可能增强ICI疗效的具体案例。数据显示CBM588能阻止有益菌（E. siraeum）的耗竭，并改善菌群失调指标（F/B比率）。",
            "facet_id": "F1",
            "possible_uses": "用于综述中关于“哪些微生物干预措施已被证明能调节微生物组并可能影响ICI疗效”的部分。可作为支持“特定益生菌可逆转ICI诱导的微生物组负面变化”的证据。"
          },
          {
            "boundaries": "机制仅为作者提出的“合理推测”（plausible mechanism），需结合其他文献验证E. siraeum在ICI反应中的具体生物学功能。F/B比率作为单一指标的局限性需注意。",
            "contribution": "提出了一个潜在的机制路径：通过维持Eubacterium siraeum等关键菌种的丰度和纠正F/B比率失衡，CBM588可能介导了对ICI治疗的更好反应。",
            "facet_id": "F2",
            "possible_uses": "用于讨论“微生物组-免疫系统相互作用”的具体机制假设。特别是关于短链脂肪酸产生菌（如Clostridium属）或特定有益菌在维持免疫微环境中的作用。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "为综述提供具体的临床前/早期临床研究实例，展示当前领域正在探索的微生物组干预策略。",
            "material": "CBM588作为一种基于梭菌的活体生物制剂，在mRCC ICI治疗中的应用背景。",
            "purpose": "背景与实例"
          },
          {
            "connection_to_review": "帮助综述界定和量化“菌群失调”，尽管该指标存在争议，但在此研究中被用作关键终点。",
            "material": "使用Firmicutes/Bacteroidetes比率作为肠道菌群失调（dysbiosis）的衡量指标。",
            "purpose": "概念澄清"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究仅分析了微生物组组成的变化，未直接报告临床疗效（如客观缓解率、无进展生存期）与微生物组变化的相关性，因此不能直接推断临床获益是由这些微生物变化介导的，只能说是提供了机制上的合理性。",
          "样本量较小且来自两项I期试验的合并，可能存在选择偏倚或统计效力不足。",
          "F/B比率的变化方向在不同研究中可能有不同解读，需结合具体上下文。",
          "所给摘要未交代是否进行了多重比较校正，P值结果需谨慎解读。"
        ],
