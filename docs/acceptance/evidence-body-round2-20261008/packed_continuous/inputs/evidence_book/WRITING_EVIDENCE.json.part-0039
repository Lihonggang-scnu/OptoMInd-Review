    "record::791f861f7c03887eb2ba17977c58d125ed07a70b72a642db190d011f4748db3b": {
      "source_handle": "P0230",
      "title": "283 Safety and efficacy signals in the complete phase I study of live biotherapeutic MRx0518 in combination with pembrolizumab in patients refractory to immune checkpoint inhibitors (ICIs)",
      "year": "2020",
      "doi": "10.1136/jitc-2020-sitc2020.0283",
      "paper_id": "5fcfc7e86cad682e895618b68f0561fb4f0a1738",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用单臂、开放标签的I期临床试验设计（Part A部分）。入组标准为：既往接受过至少一种ICI治疗（单药或联合），且根据RECIST 1.1标准确认疾病稳定（SD）或进展（PD），但在最后一次ICI剂量后12周内无快速临床进展。治疗方案为口服MRx0518（1×10^10至1×10^11 CFU，每日两次）联合静脉注射帕博利珠单抗（200 mg，每3周一次），最多35个周期。安全性通过监测第一周期的毒性进行评估；疗效通过每9周一次的影像学评估（RECIST 1.1）确定ORR、DCR和PFS。",
        "contribution_and_limits": [
          {
            "contribution": "提供了首个基于肠道微生物组的单菌株活体生物疗法MRx0518与ICI联合使用的早期临床数据，证实了该组合在难治性实体瘤中的可耐受性和初步疗效信号。",
            "limits": "样本量极小（仅12名患者），仅为I期Part A部分的数据，缺乏对照组，无法确立因果效力或普遍适用性；随访时间较短，长期生存数据未知。"
          }
        ],
        "key_findings": [
          {
            "conditions": "mRCC (n=9) 和 mNSCLC (n=3) 患者，中位既往治疗线数为3线，83%既往接受过纳武利尤单抗治疗，83%既往最佳反应为SD。",
            "finding": "安全性方面：联合方案显示积极的 profiles，无治疗相关的严重不良事件（SAEs），无因毒性导致的药物停药，未报告irAEs增加。"
          },
          {
            "conditions": "同一队列，数据截止日为2020年8月21日。",
            "finding": "疗效方面：2名RCC患者和1名NSCLC患者达到部分缓解（PR）；另外2名RCC患者获得持久性疾病稳定（SD，分别为6个月和13个月）。协议定义的DCR为42%。中位PFS为2.14个月。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "评估源自肠道微生物组的单菌株活体生物疗法MRx0518与免疫检查点抑制剂帕博利珠单抗联合使用，在对ICI难治性实体瘤患者中的安全性和初步疗效；验证其作为“首次概念证明”（proof of concept）的潜力。",
        "research_scope": "该研究针对对免疫检查点抑制剂（ICIs）难治性的实体瘤患者，具体包括转移性肾细胞癌（mRCC）和转移性非小细胞肺癌（mNSCLC）。研究对象为重度预处理的晚期癌症患者。",
        "work_summary": "本研究是一项在临床开发阶段的活体生物疗法MRx0518与帕博利珠单抗（pembrolizumab）联合治疗实体瘤的I期临床试验摘要。MRx0518是一种源自人类肠道微生物组的单菌株活体生物疗法。研究旨在评估该联合方案的安全性及初步疗效信号。试验招募了既往接受过ICI治疗但疾病稳定或进展的患者，给予MRx0518胶囊与帕博利珠单抗联合治疗。主要终点为安全性，次要终点包括客观缓解率（ORR）、缓解持续时间（DOR）、疾病控制率（DCR）和无进展生存期（PFS）。结果显示联合方案耐受性良好，无治疗相关严重不良事件，并观察到初步的抗肿瘤活性信号。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了肠道微生物组衍生活体生物疗法增强ICI疗效的临床前机制假设向临床转化初期的实证数据。它直接关联到综述主题中关于“肠道微生物如何调节ICI疗效”的问题，特别是通过提供具体的细菌菌株（MRx0518）及其与特定ICI（帕博利珠单抗）联合使用的临床结果，展示了微生物干预可能克服ICI耐药性的潜在路径。",
        "facet_contributions": [
          {
            "boundaries": "仅限I期小规模队列，未区分不同肿瘤类型的细微差异，且未提供长期生存数据。",
            "contribution": "提供了具体的临床案例证据：在ICI难治性实体瘤患者中，使用源自肠道微生物组的MRx0518联合帕博利珠单抗，实现了42%的疾病控制率和部分缓解，表明微生物疗法可能恢复或增强ICI的疗效。",
            "facet_id": "F1",
            "possible_uses": "用于支持综述中关于“微生物组干预可以逆转或克服ICI耐药”的论点，作为临床转化的初步证据。"
          },
          {
            "boundaries": "机制描述主要基于临床前小鼠模型和体外观察，临床样本中的具体分子通路验证程度在摘要中未详细展开。",
            "contribution": "提供了潜在的机制线索：摘要指出MRx0518通过激活肿瘤TLR5（与细菌鞭毛蛋白有关），诱导NFκB、细胞因子反应以及IFNγ+ CD4+和CD8+ T细胞的浸润，同时减少Tregs。这解释了微生物如何通过先天免疫受体激活适应性免疫反应。",
            "facet_id": "F2",
            "possible_uses": "用于解释微生物组调节ICI疗效的生物学机制，特别是TLR5信号通路在连接先天免疫和适应性免疫中的作用。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "背景与实例：作为肠道微生物组疗法从实验室走向临床的具体实例。",
            "material": "MRx0518的开发背景、靶点（TLR5）、以及其在难治性患者中的初步表现。",
            "purpose": "展示当前领域内具体的研发管线状态，说明单一菌株疗法作为一种策略的可行性与挑战。"
          },
          {
            "connection_to_review": "对比基线：提供了一类特定的微生物疗法（单菌株、TLR5激动剂）与其他可能的多菌株混合物或不同机制疗法的对比视角。",
            "material": "MRx0518的单菌株特性及其特定的免疫调节作用（增加CD4+/CD8+ T细胞，减少Tregs）。",
            "purpose": "帮助综述讨论不同微生物干预策略的异同，以及为何选择特定菌株或机制。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究仅为I期部分数据，样本量极小（n=12），结果具有高度不确定性，不能推广到所有实体瘤或所有ICI类型。",
          "机制描述主要基于临床前数据，临床层面的机制验证有限。",
          "作者声称的“首次概念证明”需结合后续更大规模的II期试验结果来评估其实际意义。"
        ],
        "topic_handles": [
          "MRx0518 (single-strain live biotherapeutic)",
          "gut microbiome-derived therapy",
          "immune checkpoint inhibitor refractory solid tumors",
          "combination therapy with pembrolizumab",
          "Toll-like receptor 5 (TLR5) activation mechanism",
          "clinical safety and efficacy signals in Phase I"
        ]
      },
