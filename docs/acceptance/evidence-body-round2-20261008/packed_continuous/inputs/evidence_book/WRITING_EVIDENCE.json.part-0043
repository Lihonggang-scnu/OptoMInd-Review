    "tool::d246d1ed6e11b1457bb047c36d5eb58b84347aa7af7e7fbc930c7090c626f8c4": {
      "need_id": "N48436b3aa73aea86f35f-128da42822ca7b8e",
      "question": "是否有已完成的大型随机对照 III 期临床试验证实微生物干预（如 FMT）在 ICI 治疗实体瘤中的疗效？",
