    "Ch5::Ch5_U03::Ch5_U03_P02": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U03::Ch5_U03_P02",
      "original_task_id": "Ch5_U03_P02",
      "unit_id": "Ch5_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U03_P02",
        "point": "报告 MRx0518 在 ICI 耐药实体瘤中的安全性轮廓与 TLR5 介导的免疫激活假说。",
        "development": "指出 Part A 完成显示无治疗相关 SAEs，2/12 患者达 PR，DCR 42%；机制上基于前体研究提示其通过激活肿瘤 TLR5 减少 Treg 并增加 IFNγ+ T 细胞浸润，但人体直接验证有限。",
        "source_uses": [
          {
            "source_handle": "P0125",
            "role": "主论据",
            "use": "提供 MRx0518 联合 pembrolizumab 在 ICI 耐药患者中的 Phase I/II 研究方案与筛选标准"
          },
          {
            "source_handle": "P0230",
            "role": "主论据",
            "use": "提供 MRx0518 Phase I 研究的安全性数据及初步疗效信号（PR, DCR）"
          },
          {
            "source_handle": "P0244",
            "role": "主论据",
            "use": "提供 MRx0518 在新辅助设置中的安全性及免疫调节基因表达变化证据"
          },
          {
            "source_handle": "P0251",
            "role": "背景",
            "use": "提供还原论视角下的分子机制证据（如 cdAMP-STING、肌苷-A2AR 通路），对比生态方法与定义菌群的优劣"
          },
          {
            "source_handle": "P0593",
            "role": "比较",
            "use": "提供别嘌醇通过肌苷轴重塑 TME 并增强 ICI 疗效的临床前机制与回顾性临床证据，作为非微生物代谢干预案例对比"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U03_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U03_P02",
            "unit_id": "Ch5_U03",
            "ordinal": 2,
            "point": "报告 MRx0518 在 ICI 耐药实体瘤中的安全性轮廓与 TLR5 介导的免疫激活假说。",
            "development": "指出 Part A 完成显示无治疗相关 SAEs，2/12 患者达 PR，DCR 42%；机制上基于前体研究提示其通过激活肿瘤 TLR5 减少 Treg 并增加 IFNγ+ T 细胞浸润，但人体直接验证有限。",
            "source_handles": [
              "P0125",
              "P0230",
              "P0244"
            ]
          }
        ]
      }
