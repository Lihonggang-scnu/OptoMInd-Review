    "atom::d2ee193139c04a77bbb7f1c3": {
      "atom_id": "atom::d2ee193139c04a77bbb7f1c3",
      "source_handle": "P0585",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "按治疗方案分层（NIC臂 vs CP/PC臂）",
        "finding": "在NIC组中，Fusicatenibacter和Butyricicoccus的高丰度与更好的OS相关（HR分别为0.56和0.52），优于CP组。而在NIC组中，Prevotellaceae NK3B31的高丰度与更高的死亡风险相关（HR=2.33）。"
      },
      "role": "evidence",
      "origins": [
