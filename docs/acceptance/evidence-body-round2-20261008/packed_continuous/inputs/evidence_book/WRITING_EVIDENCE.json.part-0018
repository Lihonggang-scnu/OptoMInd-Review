    "atom::cb708d8625657a0f1b60100f": {
      "atom_id": "atom::cb708d8625657a0f1b60100f",
      "source_handle": "P0585",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于肠道微生物群如何调节实体瘤（特别是NSCLC）免疫检查点抑制剂（ICI）疗效及安全性的直接临床证据。其核心价值在于不仅关联了微生物与疗效（OS），还关联了与免疫治疗密切相关的毒性（严重AEs），并揭示了不同免疫检查点抑制剂组合（PD-1 vs PD-1+CTLA-4）下的微生物响应差异，有助于回答“哪些微生物有益/有害”以及“机制是否受药物类型影响”的问题。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::b48b92078f04672f80082d0088935adb6508549e41039f2b01120655f16c11f8",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::33eb067b80204dcb68c3dbc6a5534688a594702c4f82ac666f1a616a367ec3ff",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::4debf19bd260cc81e2d804ee4f009c0257a9e0193c58b79ea0bb07b70725992b",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::f45b3a17625388b4fb4a5c37a83c64126d0e14929c0f65f856259ea72d528322",
      "multiple_values_in_field": false
    },
    "atom::3ca5c85cf380e43b5cfe3c21": {
      "atom_id": "atom::3ca5c85cf380e43b5cfe3c21",
      "source_handle": "P0585",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "结果来自NSCLC特定人群，且为观察性关联。NIC组中Prevotellaceae NK3B31显示负面关联，提示微生物效应具有复杂性和情境依赖性。不能直接外推至所有实体瘤或所有ICI单药治疗。",
        "contribution": "提供了肠道微生物群与ICI疗效关联的临床队列证据。具体发现：Fusicatenibacter和Butyricicoccus的高丰度与更长的OS相关，特别是在NIC（纳武利尤单抗+伊匹木单抗）方案中效果显著（HR 0.56/0.52）。同时，这些菌属也与较低的严重AE风险相关。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b48b92078f04672f80082d0088935adb6508549e41039f2b01120655f16c11f8",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
