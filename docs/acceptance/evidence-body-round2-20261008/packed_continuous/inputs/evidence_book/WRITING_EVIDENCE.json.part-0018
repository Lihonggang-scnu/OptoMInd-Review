    "Ch2::Ch2_U01::Ch2_U01_P01": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U01::Ch2_U01_P01",
      "original_task_id": "Ch2_U01_P01",
      "unit_id": "Ch2_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U01_P01",
        "point": "先天识别不是“有菌即激活”，而受微生物分子结构与受体语境调节。",
        "development": "以六酰化 LPS 与五酰化 LPS 的差异为核心，说明 LPS 酰化状态如何通过 TLR4/NF-κB 改变 DC/髓系细胞激活及抗 PD-1 疗效；同时引入 MAMPs 经 TLR/NOD2 刺激抗原呈递细胞、促进 Th1 极化的综述框架，并用 CRC 综述中 TLR4/NLRP3 与 Fn/cGAS-IFN-β 的语境差异提示同一通路在不同肿瘤或微生物背景下可能产生不同方向。",
        "source_uses": [
          {
            "source_handle": "P0080",
            "role": "主论据",
            "use": "提供六酰化 LPS 经 TLR4/NF-κB 增强抗 PD-1 疗效、五酰化 LPS 拮抗的具体分子案例，并配套人类黑色素瘤宏基因组关联与 MC38 小鼠因果验证。"
          },
          {
            "source_handle": "P0309",
            "role": "背景",
            "use": "提供 MAMPs（如鞭毛蛋白、肽聚糖）经 TLR/NOD2 刺激 APC、促进 Th1 极化和抗原呈递的跨免疫干预框架。"
          },
          {
            "source_handle": "P0028",
            "role": "局限",
            "use": "提供 CRC 背景下 TLR4/NLRP3、Fn 琥珀酸抑制 cGAS-IFN-β、B. fragilis 多糖与 CTLA-4 协同等语境化案例，防止将 PRR 通路写成单向促免疫。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U01_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U01_P01",
            "unit_id": "Ch2_U01",
            "ordinal": 1,
            "point": "先天识别不是“有菌即激活”，而受微生物分子结构与受体语境调节。",
            "development": "以六酰化 LPS 与五酰化 LPS 的差异为核心，说明 LPS 酰化状态如何通过 TLR4/NF-κB 改变 DC/髓系细胞激活及抗 PD-1 疗效；同时引入 MAMPs 经 TLR/NOD2 刺激抗原呈递细胞、促进 Th1 极化的综述框架，并用 CRC 综述中 TLR4/NLRP3 与 Fn/cGAS-IFN-β 的语境差异提示同一通路在不同肿瘤或微生物背景下可能产生不同方向。",
            "source_handles": [
              "P0080",
              "P0309",
              "P0028"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U01::Ch2_U01_P02": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U01::Ch2_U01_P02",
      "original_task_id": "Ch2_U01_P02",
      "unit_id": "Ch2_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U01_P02",
        "point": "DC 亚群成熟、迁移与 STING/IFN-β 轴是微生物信号转化为 CD8+ T 细胞启动的关键节点。",
        "development": "以 P0114 的 Ruminococcaceae 菌株为例，说明 TLR 刺激如何经 IRF8 驱动 CD103+ DC 分化并向肿瘤及引流淋巴结迁移，进而通过 NFATc1 增强 CD8+ T 细胞激活和 PD-1 表达；再以综述中的临床前证据补充口服乳酸杆菌、LGG、BF839 或 c-di-AMP 等通过 cGAS-STING/IFN-β 增强 DC 功能和 CD8+ T 细胞浸润，但需明确这些多为动物或综述归纳证据，不能直接外推为人类普适机制。",
        "source_uses": [
          {
            "source_handle": "P0114",
            "role": "主论据",
            "use": "提供响应者来源 Ruminococcaceae 菌株通过 TLR/IRF8 驱动 CD103+ DC 分化、迁移并增强 CD8+ T 细胞激活的 DC 亚群特异性机制。"
          },
          {
            "source_handle": "P0132",
            "role": "背景",
            "use": "提供综述层面的临床前证据，说明口服乳酸杆菌等可通过 cGAS/STING 诱导 DC IFN-β 并促进 CD8+ T 细胞浸润。"
          },
          {
            "source_handle": "P0333",
            "role": "背景",
            "use": "提供 LGG、BF839、Akkermansia 等通过 cGAS-STING 或其他通路调节 DC 与 CD8+ T 细胞的综述性机制图谱。"
          },
          {
            "source_handle": "P0309",
            "role": "背景",
            "use": "补充 MAMPs 经 TLR/NOD2 刺激 APC、促进 Th1 极化的跨免疫干预框架，与 STING 通路形成互补。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U01_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U01_P02",
            "unit_id": "Ch2_U01",
            "ordinal": 2,
            "point": "DC 亚群成熟、迁移与 STING/IFN-β 轴是微生物信号转化为 CD8+ T 细胞启动的关键节点。",
            "development": "以 P0114 的 Ruminococcaceae 菌株为例，说明 TLR 刺激如何经 IRF8 驱动 CD103+ DC 分化并向肿瘤及引流淋巴结迁移，进而通过 NFATc1 增强 CD8+ T 细胞激活和 PD-1 表达；再以综述中的临床前证据补充口服乳酸杆菌、LGG、BF839 或 c-di-AMP 等通过 cGAS-STING/IFN-β 增强 DC 功能和 CD8+ T 细胞浸润，但需明确这些多为动物或综述归纳证据，不能直接外推为人类普适机制。",
            "source_handles": [
              "P0114",
              "P0132",
              "P0333",
              "P0309"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U01::Ch2_U01_P03": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U01::Ch2_U01_P03",
      "original_task_id": "Ch2_U01_P03",
      "unit_id": "Ch2_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U01_P03",
        "point": "微生物还可调节 DC 检查点语气，但人类证据仍以关联和伴随观察为主。",
        "development": "以 P0242 的 C. cateniformis 为例，说明微生物表面成分可通过 MYD88 下调 DC PD-L2，减弱 PD-L2/RGMb 对 CD8+ T 细胞的抑制，从而在微生物缺失或非响应者粪便模型中恢复 ICI 疗效；随后用 P0080 的人类黑色素瘤 lpxM 关联、P0583 的 FMT 后有害菌丢失与 CD8+ T 细胞增加，以及 P0535 的肿瘤内 Bifidobacterium/STING 观察，对比人类层面的关联证据与肿瘤内生态线索，强调这些人类数据不能直接证明与小鼠相同的因果链条。",
        "source_uses": [
          {
            "source_handle": "P0242",
            "role": "主论据",
            "use": "提供微生物直接调控 DC 检查点分子 PD-L2/RGMb 的因果案例，补充先天识别之外微生物调节 DC 抑制性语气的路径。"
          },
          {
            "source_handle": "P0080",
            "role": "例证",
            "use": "提供人类黑色素瘤基线宏基因组中 lpxM 基因富集与疗效的关联，作为人类层面的间接证据。"
          },
          {
            "source_handle": "P0583",
            "role": "例证",
            "use": "提供人类 II 期 FMT 联合 ICI 中微生物重塑、色氨酸代谢产物下降与 CD8+ T 细胞增加的伴随机制线索，作为临床层级证据。"
          },
          {
            "source_handle": "P0535",
            "role": "比较",
            "use": "提供肿瘤内微生物群与 STING、PD-L1、MDSC 等免疫调节通路的综述证据，作为肠道机制与局部肿瘤生态之间的边界参照。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U01_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U01_P03",
            "unit_id": "Ch2_U01",
            "ordinal": 3,
            "point": "微生物还可调节 DC 检查点语气，但人类证据仍以关联和伴随观察为主。",
            "development": "以 P0242 的 C. cateniformis 为例，说明微生物表面成分可通过 MYD88 下调 DC PD-L2，减弱 PD-L2/RGMb 对 CD8+ T 细胞的抑制，从而在微生物缺失或非响应者粪便模型中恢复 ICI 疗效；随后用 P0080 的人类黑色素瘤 lpxM 关联、P0583 的 FMT 后有害菌丢失与 CD8+ T 细胞增加，以及 P0535 的肿瘤内 Bifidobacterium/STING 观察，对比人类层面的关联证据与肿瘤内生态线索，强调这些人类数据不能直接证明与小鼠相同的因果链条。",
            "source_handles": [
              "P0242",
              "P0080",
              "P0583",
              "P0535"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U02::Ch2_U02_P01": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U02::Ch2_U02_P01",
      "original_task_id": "Ch2_U02_P01",
      "unit_id": "Ch2_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U02_P01",
        "point": "分子模拟与交叉反应性T细胞激活",
        "development": "解析微生物肽段与肿瘤新抗原序列相似性假说，阐述交叉反应性CD8+ T细胞如何被激活并浸润肿瘤。对比小鼠模型中功能回补实验的因果验证与人类队列中基于生物信息学预测的关联性证据。",
        "source_uses": [
          {
            "source_handle": "P0388",
            "role": "主论据",
            "use": "微生物肽段与肿瘤新抗原序列相似性激活交叉反应性 CD8+ T 细胞，功能回补实验证实因果性。"
          },
          {
            "source_handle": "P0560",
            "role": "例证",
            "use": "细菌抗原与肿瘤抗原交叉反应增强抗原性，体外共培养证实 T 细胞杀伤力提升。"
          },
          {
            "source_handle": "P0085",
            "role": "背景",
            "use": "提出预存异源记忆 T 细胞通过分子模拟交叉识别肿瘤新抗原的假说，为微生物介导的 T 细胞交叉反应性提供理论框架。"
          },
          {
            "source_handle": "P0462",
            "role": "例证",
            "use": "提供肠道微生物表位与宿主自身免疫或肿瘤抗原发生交叉反应的实证数据，阐明分子模拟介导长期疗效与免疫相关不良事件的双刃剑效应。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U02_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U02_P01",
            "unit_id": "Ch2_U02",
            "ordinal": 1,
            "point": "分子模拟与交叉反应性T细胞激活",
            "development": "解析微生物肽段与肿瘤新抗原序列相似性假说，阐述交叉反应性CD8+ T细胞如何被激活并浸润肿瘤。对比小鼠模型中功能回补实验的因果验证与人类队列中基于生物信息学预测的关联性证据。",
            "source_handles": [
              "P0388",
              "P0560"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U02::Ch2_U02_P02": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U02::Ch2_U02_P02",
      "original_task_id": "Ch2_U02_P02",
      "unit_id": "Ch2_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U02_P02",
        "point": "T细胞 priming、亚群平衡与耗竭调控",
        "development": "阐述CD8+ T细胞priming、Th17/Treg亚群平衡及耗竭状态的调控路径。对比小鼠模型中CRISPR敲除或抗体耗竭的功能验证与人类队列中基于流式细胞术的单细胞表型观察，强调代谢微环境（如腺苷积累）对T细胞耗竭的决定性影响。",
        "source_uses": [
          {
            "source_handle": "P0269",
            "role": "主论据",
            "use": "T 细胞耗竭与代谢微环境（腺苷积累）密切相关，IL-12 与 ADA 工程化策略可恢复 NK/T 细胞功能。"
          },
          {
            "source_handle": "P0535",
            "role": "例证",
            "use": "非经典检查点配体（LAG-3, TIM-3）在肿瘤细胞中高表达，与低 CD8+ T 细胞浸润及不良预后相关。"
          },
          {
            "source_handle": "P0098",
            "role": "例证",
            "use": "提供纵向队列中基线拟杆菌属与瘤胃球菌科丰度预测 Treg 减少及 irAEs 严重程度的动态数据，揭示菌群对 T 细胞亚群平衡的设定作用。"
          },
          {
            "source_handle": "P0154",
            "role": "背景",
            "use": "阐述 SCFAs 与色氨酸衍生物通过 HDAC 抑制及 AHR/GPR43 信号调节 Th17/Treg 极化的分子路径，补充代谢微环境对 T 细胞耗竭的调控机制。"
          },
          {
            "source_handle": "P0195",
            "role": "例证",
            "use": "揭示代谢物脱氨酪氨酸（DAT）通过宿主 IFN-I 信号通路协同增强 T 细胞活化及 Th1 分化的具体路径。"
          },
          {
            "source_handle": "P0444",
            "role": "例证",
            "use": "揭示 MEP 通路代谢物 HMBPP 特异性激活 Vδ2 T 细胞，以及核黄素通路产物 5-OP-RU 诱导 MAIT 细胞增殖的机制。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U02_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U02_P02",
            "unit_id": "Ch2_U02",
            "ordinal": 2,
            "point": "T细胞 priming、亚群平衡与耗竭调控",
            "development": "阐述CD8+ T细胞priming、Th17/Treg亚群平衡及耗竭状态的调控路径。对比小鼠模型中CRISPR敲除或抗体耗竭的功能验证与人类队列中基于流式细胞术的单细胞表型观察，强调代谢微环境（如腺苷积累）对T细胞耗竭的决定性影响。",
            "source_handles": [
              "P0269",
              "P0535"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U03::Ch2_U03_P01": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U03::Ch2_U03_P01",
      "original_task_id": "Ch2_U03_P01",
      "unit_id": "Ch2_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U03_P01",
        "point": "肠道屏障完整性是微生物信号能否转化为全身免疫事件的条件闸门。",
        "development": "用肠芯片证据说明非响应者粪便/LPS 可破坏 ZO-1/β-catenin 并激活 TNF/IL-6/NF-κB，而响应者粪便中鞭毛蛋白/TLR-5 相关信号与屏障维持相关；再引入 P. bifermentans 活菌破坏上皮屏障并诱导炎症、但其无细胞小分子组分保留抗肿瘤增效的双重结构，强调屏障损伤与疗效增强并非同一机制的必然结果。",
        "source_uses": [
          {
            "source_handle": "P0073",
            "role": "主论据",
            "use": "提供人源肠芯片中响应者/非响应者粪便对屏障完整性、炎症通路和微生物分子（LPS/鞭毛蛋白）差异的功能证据。"
          },
          {
            "source_handle": "P0284",
            "role": "例证",
            "use": "提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U03_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U03_P01",
            "unit_id": "Ch2_U03",
            "ordinal": 1,
            "point": "肠道屏障完整性是微生物信号能否转化为全身免疫事件的条件闸门。",
            "development": "用肠芯片证据说明非响应者粪便/LPS 可破坏 ZO-1/β-catenin 并激活 TNF/IL-6/NF-κB，而响应者粪便中鞭毛蛋白/TLR-5 相关信号与屏障维持相关；再引入 P. bifermentans 活菌破坏上皮屏障并诱导炎症、但其无细胞小分子组分保留抗肿瘤增效的双重结构，强调屏障损伤与疗效增强并非同一机制的必然结果。",
            "source_handles": [
              "P0073",
              "P0284"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U03::Ch2_U03_P02": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U03::Ch2_U03_P02",
      "original_task_id": "Ch2_U03_P02",
      "unit_id": "Ch2_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U03_P02",
        "point": "细菌易位可以是治疗诱导的主动免疫转运过程，而非单纯被动漏肠。",
        "development": "以 P0166 为核心，说明联合 ICT 诱导特定肠道细菌经 DC 摄取并以 CCR7 依赖方式进入 MLN、TDLN 和肿瘤，MLN 切除会削弱远端抗肿瘤免疫；结合 PDAC 综述中细菌经门静脉/淋巴/胆道等路径进入肿瘤或次级淋巴器官并激活局部 PRR 的描述，以及消化道肿瘤中 Fn 等病原菌局部免疫抑制的案例，建立“屏障—转运—局部免疫”的解剖链条。",
        "source_uses": [
          {
            "source_handle": "P0166",
            "role": "主论据",
            "use": "提供 ICT 诱导肠道细菌经 DC/CCR7 向 MLN、TDLN 和肿瘤转移，并增强肠外抗肿瘤免疫的因果路径。"
          },
          {
            "source_handle": "P0084",
            "role": "背景",
            "use": "提供 PDAC 中肠道菌群/细菌易位通过 PRR 和巨噬细胞/TAM 重编程形成局部免疫抑制的综述性机制框架。"
          },
          {
            "source_handle": "P0438",
            "role": "例证",
            "use": "提供消化道肿瘤中 Fn 抑制 NK/招募 MDSC、Barnesiella 增强 T 细胞浸润等局部微生物调控案例。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U03_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U03_P02",
            "unit_id": "Ch2_U03",
            "ordinal": 2,
            "point": "细菌易位可以是治疗诱导的主动免疫转运过程，而非单纯被动漏肠。",
            "development": "以 P0166 为核心，说明联合 ICT 诱导特定肠道细菌经 DC 摄取并以 CCR7 依赖方式进入 MLN、TDLN 和肿瘤，MLN 切除会削弱远端抗肿瘤免疫；结合 PDAC 综述中细菌经门静脉/淋巴/胆道等路径进入肿瘤或次级淋巴器官并激活局部 PRR 的描述，以及消化道肿瘤中 Fn 等病原菌局部免疫抑制的案例，建立“屏障—转运—局部免疫”的解剖链条。",
            "source_handles": [
              "P0166",
              "P0084",
              "P0438"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U03::Ch2_U03_P03": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U03::Ch2_U03_P03",
      "original_task_id": "Ch2_U03_P03",
      "unit_id": "Ch2_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U03_P03",
        "point": "易位微生物的免疫后果主要由髓系细胞重编程决定。",
        "development": "说明易位细菌或屏障来源信号可通过 TLR/PRR 改变 TAM、MDSC 和巨噬细胞表型：在 PDAC 背景中促进免疫抑制性 TAM 并限制 T 细胞活化，抗生素清除后可恢复促炎表型与抗 PD-1 反应；同时用广谱 ICI 耐药综述补充 MDSC、M2 样 TAM、TGF-β/IL-10、缺氧和乳酸积累等共同构成免疫抑制网络；再用 FMT 综述指出微生物干预可能增加效应 T 细胞或减少抑制性髓系细胞，但失败案例同样存在。",
        "source_uses": [
          {
            "source_handle": "P0084",
            "role": "主论据",
            "use": "提供肠道菌群或肿瘤内易位细菌可通过 PRR 诱导巨噬细胞/TAM 向免疫抑制表型转化的综述框架。"
          },
          {
            "source_handle": "P0362",
            "role": "背景",
            "use": "提供 ICI 耐药中 MDSC、TAM、Treg、缺氧、乳酸和氨基酸代谢等免疫抑制网络的背景框架。"
          },
          {
            "source_handle": "P0438",
            "role": "例证",
            "use": "补充易位后髓系/NK 语境，如 Fn 抑制 NK/招募 MDSC。"
          },
          {
            "source_handle": "P0573",
            "role": "局限",
            "use": "提供 FMT 联合 ICI 的机制异质性综述：可增加效应 T 细胞、减少 Treg/MDSC，也可能失败或引入不利代谢/菌群。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U03_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U03_P03",
            "unit_id": "Ch2_U03",
            "ordinal": 3,
            "point": "易位微生物的免疫后果主要由髓系细胞重编程决定。",
            "development": "说明易位细菌或屏障来源信号可通过 TLR/PRR 改变 TAM、MDSC 和巨噬细胞表型：在 PDAC 背景中促进免疫抑制性 TAM 并限制 T 细胞活化，抗生素清除后可恢复促炎表型与抗 PD-1 反应；同时用广谱 ICI 耐药综述补充 MDSC、M2 样 TAM、TGF-β/IL-10、缺氧和乳酸积累等共同构成免疫抑制网络；再用 FMT 综述指出微生物干预可能增加效应 T 细胞或减少抑制性髓系细胞，但失败案例同样存在。",
            "source_handles": [
              "P0084",
              "P0362",
              "P0438",
              "P0573"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U03::Ch2_U03_P04": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U03::Ch2_U03_P04",
      "original_task_id": "Ch2_U03_P04",
      "unit_id": "Ch2_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U03_P04",
        "point": "人类证据显示微生物屏障/易位相关重塑具有疗效与毒性的情境依赖，但不能直接外推小鼠因果。",
        "development": "用 FMT-LUMINate 说明人类响应者以有害菌丢失、色氨酸代谢产物下降和 CD8+ T 细胞增加为特征，而 Prevotella 富集供体仅在双 ICI 背景下与严重毒性相关；结合 P. bifermentans 的活菌炎症/小分子增效双重机制与 FMT 综述中的异质性结果，强调同一微生物状态可能同时关联疗效与毒性，且依赖 ICI 方案、宿主基线与肿瘤类型。此处不展开代谢物浓度与剂量问题，留给 Ch3。",
        "source_uses": [
          {
            "source_handle": "P0583",
            "role": "主论据",
            "use": "提供人类 FMT 联合 ICI 中基线有害菌清除、代谢产物下降、CD8+ T 细胞增加及方案依赖毒性信号的核心临床证据。"
          },
          {
            "source_handle": "P0284",
            "role": "例证",
            "use": "提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。"
          },
          {
            "source_handle": "P0573",
            "role": "背景",
            "use": "提供 FMT 联合 ICI 的机制异质性综述，支持情境依赖观点。"
          },
          {
            "source_handle": "P0333",
            "role": "背景",
            "use": "提供微生物 - 代谢物 - 免疫轴的情境依赖综述框架，提示不同癌种、方案和宿主背景下同一微生物特征可能产生不同效应。"
          },
          {
            "source_handle": "P0584",
            "role": "负责人指定",
            "use": ""
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U03_P04"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U03_P04",
            "unit_id": "Ch2_U03",
            "ordinal": 4,
            "point": "人类证据显示微生物屏障/易位相关重塑具有疗效与毒性的情境依赖，但不能直接外推小鼠因果。",
            "development": "用 FMT-LUMINate 说明人类响应者以有害菌丢失、色氨酸代谢产物下降和 CD8+ T 细胞增加为特征，而 Prevotella 富集供体仅在双 ICI 背景下与严重毒性相关；结合 P. bifermentans 的活菌炎症/小分子增效双重机制与 FMT 综述中的异质性结果，强调同一微生物状态可能同时关联疗效与毒性，且依赖 ICI 方案、宿主基线与肿瘤类型。此处不展开代谢物浓度与剂量问题，留给 Ch3。",
            "source_handles": [
              "P0583",
              "P0284",
              "P0573",
              "P0584"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U04::Ch2_U04_P01": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U04::Ch2_U04_P01",
      "original_task_id": "Ch2_U04_P01",
      "unit_id": "Ch2_U04",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U04_P01",
        "point": "肿瘤类型特异性：黑色素瘤、NSCLC与消化道肿瘤的机制异质性",
        "development": "对比黑色素瘤、NSCLC与消化道肿瘤中机制表达的异质性。强调黑色素瘤中交叉反应性T细胞的主导作用，NSCLC中代谢微环境（腺苷积累）的决定性影响，以及消化道肿瘤中屏障完整性与易位的特殊地位。",
        "source_uses": [
          {
            "source_handle": "P0535",
            "role": "例证",
            "use": "非经典检查点配体在肿瘤细胞中高表达，与低 CD8+ T 细胞浸润及不良预后相关。"
          },
          {
            "source_handle": "P0146",
            "role": "例证",
            "use": "特定微生物群落塑造癌症免疫治疗响应，机制具有高度情境依赖性。"
          },
          {
            "source_handle": "P0573",
            "role": "例证",
            "use": "供体聚类分析显示富含 Prevotella spp.的 Cluster B 与双 ICI 背景下严重 irAEs 显著相关。"
          },
          {
            "source_handle": "P0057",
            "role": "比较",
            "use": "对比 TNBC 中化疗与 ICI 对微生物组的不同影响（破坏 vs 恢复），以及 TMAO 诱导焦亡的机制。"
          },
          {
            "source_handle": "P0090",
            "role": "比较",
            "use": "汇总 mRCC 队列中抗生素暴露显著降低 ORR/PFS/OS 的观察性数据。"
          },
          {
            "source_handle": "P0113",
            "role": "比较",
            "use": "分析 HCC 病因异质性（病毒性 vs 代谢性）下微生物组景观的差异及其对 ICI 响应的不同影响。"
          },
          {
            "source_handle": "P0270",
            "role": "比较",
            "use": "挑战跨癌种通用预测模型，发现 mCRPC 患者中 A. muciniphila 与疗效负相关。"
          },
          {
            "source_handle": "P0352",
            "role": "比较",
            "use": "提供下呼吸道微生物组独立于肠道调节 NSCLC ICI 疗效的证据。"
          },
          {
            "source_handle": "P0457",
            "role": "比较",
            "use": "系统综述肿瘤内驻留微生物群（非肠道）通过抗原呈递、Th1 极化及基质重塑调节局部免疫的三种机制。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U04_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U04_P01",
            "unit_id": "Ch2_U04",
            "ordinal": 1,
            "point": "肿瘤类型特异性：黑色素瘤、NSCLC与消化道肿瘤的机制异质性",
            "development": "对比黑色素瘤、NSCLC与消化道肿瘤中机制表达的异质性。强调黑色素瘤中交叉反应性T细胞的主导作用，NSCLC中代谢微环境（腺苷积累）的决定性影响，以及消化道肿瘤中屏障完整性与易位的特殊地位。",
            "source_handles": [
              "P0535",
              "P0146",
              "P0573"
            ]
          }
        ]
      }
    },
    "Ch2::Ch2_U04::Ch2_U04_P02": {
      "chapter_id": "Ch2",
      "local_task_id": "Ch2_U04::Ch2_U04_P02",
      "original_task_id": "Ch2_U04_P02",
      "unit_id": "Ch2_U04",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch2_U04_P02",
        "point": "模型系统差异：临床前因果发现与人类观察性证据的严格区分",
        "development": "严格区分小鼠模型中的因果发现（如CRISPR敲除、抗体耗竭、FMT功能回补）与人类队列中的观察性关联（如单细胞表型、血清标志物）。强调模型系统差异导致的机制外推风险，划定后续章节的边界。",
        "source_uses": [
          {
            "source_handle": "P0535",
            "role": "背景",
            "use": "提供肿瘤内微生物群与免疫调节通路的综述证据，作为人类观察性数据的参照。"
          },
          {
            "source_handle": "P0573",
            "role": "背景",
            "use": "提供 FMT 联合 ICI 的机制异质性综述，提示临床转化中的不确定性。"
          },
          {
            "source_handle": "P0146",
            "role": "背景",
            "use": "提供特定微生物群落塑造癌症免疫治疗响应的综述，强调情境依赖性。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch2_U04_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch2_U04_P02",
            "unit_id": "Ch2_U04",
            "ordinal": 2,
            "point": "模型系统差异：临床前因果发现与人类观察性证据的严格区分",
            "development": "严格区分小鼠模型中的因果发现（如CRISPR敲除、抗体耗竭、FMT功能回补）与人类队列中的观察性关联（如单细胞表型、血清标志物）。强调模型系统差异导致的机制外推风险，划定后续章节的边界。",
            "source_handles": [
              "P0535",
              "P0573",
              "P0146"
            ]
          }
        ]
      }
