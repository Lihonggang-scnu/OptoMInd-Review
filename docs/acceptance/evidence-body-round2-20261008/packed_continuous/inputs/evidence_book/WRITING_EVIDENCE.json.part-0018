    "Ch4::Ch4_U03::Ch4_U03_P03": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U03::Ch4_U03_P03",
      "original_task_id": "Ch4_U03_P03",
      "unit_id": "Ch4_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U03_P03",
        "point": "简述昼夜节律紊乱与心理压力通过神经内分泌-色氨酸轴间接调制免疫稳态的潜在路径。",
        "development": "整合P0224/P0147关于睡眠剥夺导致LPS易位、SCFAs下降及HPA轴激活抑制CD8+ T细胞的机制假说，指出生活方式干预需纳入多维宿主状态评估框架。",
        "source_uses": [
          {
            "source_handle": "P0224",
            "role": "主论据",
            "use": "简述昼夜节律紊乱与心理压力通过 HPA 轴激活、LPS 易位及 SCFAs 下降间接调制免疫稳态的潜在路径，指出生活方式干预需纳入多维宿主状态评估框架。"
          },
          {
            "source_handle": "P0147",
            "role": "例证",
            "use": "提供肿瘤相关抑郁症作为微生物群改变驱动因素的背景机制，支持心理 - 微生物联合干预的理论支撑，避免单一营养视角的局限。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U03_P03"
        ],
        "source_brief_details": [
          {
