            "0"
          ]
        },
        {
          "record_id": "record::909e93d69c5a110886797e4e6a1176ec0d75401b7009eecee9d6127d17db9e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::0ae7a2ce7e591525b4e4371de63f51471a9389ea67438dfadcfbdde2c16c835a",
      "multiple_values_in_field": true
    },
    "atom::433b968bb706256dc6a4239a": {
      "atom_id": "atom::433b968bb706256dc6a4239a",
      "source_handle": "P0096",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节ICI疗效”中的相关性部分，即确定哪些微生物群落结构与疗效改善或恶化有关。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::769a855a4ccae40446adf28a44c56ae006c315a0908beaebd2b1561b38a1979b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::909e93d69c5a110886797e4e6a1176ec0d75401b7009eecee9d6127d17db9e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::d3f416cb829a74d6a43498a0cdd978109022a7a37caca44cad8175edd6dddaf7",
      "multiple_values_in_field": true
    },
    "atom::853adb3bb7b26e67c353c0fb": {
      "atom_id": "atom::853adb3bb7b26e67c353c0fb",
      "source_handle": "P0096",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节来自小鼠模型或体外实验，直接外推到人类NSCLC患者需谨慎。作者明确指出大部分机制“仍 largely unknown”，现有解释多为假说或初步证据。",
        "contribution": "提出了几种可能的机制路径：1) 抗生素通过下调MAdCAM-1表达，促进Enterocloster增殖，进而抑制Th17/Treg细胞向肿瘤迁移；2) 某些细菌（如E. hirae）携带的噬菌体蛋白可与肿瘤抗原发生交叉反应，激活CD8+ T细胞；3) 短链脂肪酸（如丁酸）由有益菌产生，可能增强抗肿瘤免疫反应；4) 肺部微生物（如Veillonella）通过上调PI3K/Akt和ERK/MAPK通路促进肿瘤进展。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::769a855a4ccae40446adf28a44c56ae006c315a0908beaebd2b1561b38a1979b",
          "field_path": [
