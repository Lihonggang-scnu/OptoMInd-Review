          "record_id": "record::aab188251adff198144a1cd564959d717dd1ad629bd84c06a984f93b1eec07c5",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::0abe2b6ae8d1b1b994b28fb2728a4f1e1f91af190ef60d2fabef3e4d6a144da7",
      "multiple_values_in_field": true
    },
    "atom::385abb08948f6bfd5a895cdb": {
      "atom_id": "atom::385abb08948f6bfd5a895cdb",
      "source_handle": "P0146",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Intervention Strategies",
        "finding": "FMT from ICI responders can overcome resistance in refractory melanoma patients. Probiotics (e.g., Clostridium butyricum CBM588) and dietary interventions (high-fiber, ketogenic) show promise in enhancing ICI response and reducing toxicity, though clinical evidence is still emerging."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::89b8f947d85f7362a3c254e0e002085457319d9cd845107ac15367721f1d4de2",
          "field_path": [
