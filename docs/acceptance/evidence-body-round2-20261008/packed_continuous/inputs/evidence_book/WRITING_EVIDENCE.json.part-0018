          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::909e93d69c5a110886797e4e6a1176ec0d75401b7009eecee9d6127d17db9e26",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::6b5802cbcd1dfdc516f0610a295bc513363083ac4a32f8e117e8b9d000f5e24e",
