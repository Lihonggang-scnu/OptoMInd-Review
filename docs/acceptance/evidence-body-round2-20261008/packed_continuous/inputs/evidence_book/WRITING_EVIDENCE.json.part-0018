    "Ch7::Ch7_U03::Ch7_U03_P04": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U03::Ch7_U03_P04",
      "original_task_id": "Ch7_U03_P04",
      "unit_id": "Ch7_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U03_P04",
        "point": "呈现临床决策对预测因子的迫切需求与现实落差",
        "development": "引用医生调查数据，说明临床端对标准化生物标志物与干预协议的强烈渴望，反衬当前转化能力的不足。",
        "source_uses": [
          {
            "source_handle": "P0524",
            "role": "主论据",
            "use": "通过调查肿瘤科医生的意见，量化了 ICI 单药治疗 NSCLC 中未被充分研究的临床场景的重要性排序。"
          },
          {
            "source_handle": "P0544",
