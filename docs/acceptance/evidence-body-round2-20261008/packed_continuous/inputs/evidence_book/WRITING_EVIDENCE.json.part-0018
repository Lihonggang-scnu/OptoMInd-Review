      "task": {
        "paragraph_id": "U4_证据阶梯与转化边界_P01",
        "point": "总结观察性证据强度与概念验证性干预的初步希望",
        "development": "指出观察性关联证据最强，概念验证性干预（FMT）显示初步希望但异质性大；FMT-LUMINate II 期试验报告了 NSCLC 患者 ORR 为 80%，并指出响应者基线有害菌种丢失，而非供体菌株定植。",
        "source_uses": [
          {
            "source_handle": "P0583",
