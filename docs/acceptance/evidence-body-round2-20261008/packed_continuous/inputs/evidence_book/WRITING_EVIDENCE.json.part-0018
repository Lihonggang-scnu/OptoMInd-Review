            "ordinal": 3,
            "point": "提出以“功能性菌群失调评分”替代传统α/β多样性作为 ICI 疗效预测指标的必要性。",
            "development": "结合 P0444 与 P0363 的观点，批判单一分类学分析的局限，主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化。",
            "source_handles": [
              "P0444",
              "P0363"
            ]
          }
        ]
      }
    },
    "Ch3::U3_5::U3_5_P01": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_5::U3_5_P01",
      "original_task_id": "U3_5_P01",
      "unit_id": "U3_5",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_5_P01",
        "point": "客观评估当前血浆/粪便代谢组学作为 ICI 疗效预测工具的效能与固有偏差。",
        "development": "基于 P0582 与 P0363，承认宏观代谢物检测在临床可行性上的优势，同时指出其无法区分游离态与结合态、无法反映组织滞留时间的缺陷。",
        "source_uses": [
          {
            "source_handle": "P0582",
            "role": "主论据",
            "use": "指出因样本完整性问题未能在人体肿瘤队列中直接检测肌苷浓度，仅能以 UBA6 表达作为通路活性代理"
          },
          {
            "source_handle": "P0363",
            "role": "背景",
            "use": "强调多数机制证据来自小鼠模型，血浆/粪便浓度不能完全代表 TME 暴露水平，警示跨物种外推风险"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_5_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_5_P01",
            "unit_id": "U3_5",
            "ordinal": 1,
            "point": "客观评估当前血浆/粪便代谢组学作为 ICI 疗效预测工具的效能与固有偏差。",
            "development": "基于 P0582 与 P0363，承认宏观代谢物检测在临床可行性上的优势，同时指出其无法区分游离态与结合态、无法反映组织滞留时间的缺陷。",
            "source_handles": [
              "P0582",
              "P0363"
            ]
          }
        ]
      }
    },
    "Ch3::U3_5::U3_5_P02": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_5::U3_5_P02",
      "original_task_id": "U3_5_P02",
      "unit_id": "U3_5",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_5_P02",
        "point": "深入剖析人体 TME 内代谢物绝对浓度数据缺失对机制研究与临床转化的具体阻碍，特别强调肌苷案例。",
        "development": "结合 P0584 与 P0413 的药代动力学与递送障碍分析，说明缺乏 TME 浓度阈值如何导致体外有效浓度无法在体内复现，以及为何单纯提高血浆浓度未必改善疗效。",
        "source_uses": [
          {
            "source_handle": "P0584",
            "role": "主论据",
            "use": "指出体外有效浓度（如 100 μM 肌苷）属人工设定而非内源性实测值，体内浓度受血流灌注与降解酶多重制约"
          },
          {
            "source_handle": "P0413",
            "role": "主论据",
            "use": "从药理学角度分析代谢物在 TME 中的递送效率受血管通透性及转运体限制，导致全身循环与局部有效浓度脱节"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_5_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_5_P02",
            "unit_id": "U3_5",
            "ordinal": 2,
            "point": "深入剖析人体 TME 内代谢物绝对浓度数据缺失对机制研究与临床转化的具体阻碍，特别强调肌苷案例。",
            "development": "结合 P0584 与 P0413 的药代动力学与递送障碍分析，说明缺乏 TME 浓度阈值如何导致体外有效浓度无法在体内复现，以及为何单纯提高血浆浓度未必改善疗效。",
            "source_handles": [
              "P0584",
              "P0413"
            ]
          }
        ]
      }
    },
    "Ch3::U3_5::U3_5_P03": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_5::U3_5_P03",
      "original_task_id": "U3_5_P03",
      "unit_id": "U3_5",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_5_P03",
        "point": "规划填补 TME 浓度缺口的未来技术路线与研究范式。",
        "development": "提出引入原位微透析（microdialysis）、基质辅助激光解吸电离质谱成像（MALDI-MSI）及配对组织 - 血液纵向采样，以建立“局部浓度 - 受体占有率 - 临床结局”的直接定量映射。",
        "source_uses": [
          {
            "source_handle": "P0582",
            "role": "发展",
            "use": "呼吁未来研究需解决 TME 内代谢物浓度测量问题"
          },
          {
            "source_handle": "P0363",
            "role": "发展",
            "use": "主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化"
          },
          {
            "source_handle": "P0413",
            "role": "发展",
            "use": "提出需解决代谢物在 TME 中的递送效率问题"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_5_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_5_P03",
            "unit_id": "U3_5",
            "ordinal": 3,
            "point": "规划填补 TME 浓度缺口的未来技术路线与研究范式。",
            "development": "提出引入原位微透析（microdialysis）、基质辅助激光解吸电离质谱成像（MALDI-MSI）及配对组织 - 血液纵向采样，以建立“局部浓度 - 受体占有率 - 临床结局”的直接定量映射。",
            "source_handles": [
              "P0582",
              "P0363",
              "P0413"
            ]
          }
        ]
      }
    },
    "Ch4::Ch4_U01::Ch4_U01_P01": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U01::Ch4_U01_P01",
      "original_task_id": "Ch4_U01_P01",
      "unit_id": "Ch4_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U01_P01",
        "point": "界定ICI治疗前后30-90天为抗生素暴露的高危窗口，对比术前与术后暴露的生存差异。",
        "development": "比较P0575大样本队列中术后暴露（HR 1.27）与术前暴露（HR 1.04）的OS风险，论证微生物完整性在免疫启动期的脆弱性。",
        "source_uses": [
          {
            "source_handle": "P0575",
            "role": "主论据",
            "use": "提供 UC Health 多中心大样本队列数据，对比术后暴露（HR 1.27）与术前暴露（HR 1.04）的生存差异，界定 ICI 启动前后 30-90 天为抗生素干扰的高危窗口。"
          },
          {
            "source_handle": "P0096",
            "role": "背景",
            "use": "提供 NSCLC 背景下微生物组作为生物标志物与干预策略的综述背景，支持抗生素使用时机对疗效影响的一般性论述。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U01_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch4_U01_P01",
            "unit_id": "Ch4_U01",
            "ordinal": 1,
            "point": "界定ICI治疗前后30-90天为抗生素暴露的高危窗口，对比术前与术后暴露的生存差异。",
            "development": "比较P0575大样本队列中术后暴露（HR 1.27）与术前暴露（HR 1.04）的OS风险，论证微生物完整性在免疫启动期的脆弱性。",
            "source_handles": [
              "P0575"
            ]
          }
        ]
      }
    },
    "Ch4::Ch4_U01::Ch4_U01_P02": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U01::Ch4_U01_P02",
      "original_task_id": "Ch4_U01_P02",
      "unit_id": "Ch4_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U01_P02",
        "point": "建立抗生素疗程长度与OS下降的剂量-反应关系，提示广谱破坏的累积效应。",
        "development": "引用P0061数据展示>10天疗程导致OS骤降（2.8 vs 8.8个月），结合P0052/Meta分析中氟喹诺酮类高风险趋势，说明暴露强度与疗效受损的正相关性。",
        "source_uses": [
          {
            "source_handle": "P0061",
            "role": "主论据",
            "use": "基于印度 Tata 纪念医院真实世界审计数据，展示>10 天疗程导致 OS 骤降（2.8 vs 8.8 个月），建立抗生素暴露强度与疗效受损的正向剂量 - 反应关系。"
          },
          {
            "source_handle": "P0052",
            "role": "主论据",
            "use": "提供 NSCLC 患者抗生素使用对临床结局影响的系统综述与 Meta 分析数据，量化抗生素暴露与较差生存/缓解的强关联。"
          },
          {
            "source_handle": "P0081",
            "role": "比较",
            "use": "提供多种药物效应 Meta 分析数据，作为抗生素作为关键混杂因素或调节变量的大规模实证支持，量化其对预后的影响。"
          },
          {
            "source_handle": "P0417",
            "role": "背景",
            "use": "提供 2019 年系统综述数据，作为抗生素干扰 ICI 疗效的历史证据背景，支持微生物组成预测价值的讨论。"
          },
          {
            "source_handle": "P0564",
            "role": "背景",
            "use": "汇总不同菌属与 ICI 反应及毒性的关联，以及抗生素使用时机和类型对预后的影响，作为解释微生物调节 ICI 疗效的关键背景素材。"
          },
          {
            "source_handle": "P0517",
            "role": "例证",
            "use": "提供 NSCLC 队列中抗生素暴露导致 PD-L1 高表达（≥50%）人群 OS 显著缩短的实证，揭示宿主生物标志物状态与微生物组干预效应的高度情境依赖性。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U01_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch4_U01_P02",
            "unit_id": "Ch4_U01",
            "ordinal": 2,
            "point": "建立抗生素疗程长度与OS下降的剂量-反应关系，提示广谱破坏的累积效应。",
            "development": "引用P0061数据展示>10天疗程导致OS骤降（2.8 vs 8.8个月），结合P0052/Meta分析中氟喹诺酮类高风险趋势，说明暴露强度与疗效受损的正相关性。",
            "source_handles": [
              "P0061",
              "P0052"
            ]
          }
        ]
      }
    },
    "Ch4::Ch4_U01::Ch4_U01_P03": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U01::Ch4_U01_P03",
      "original_task_id": "Ch4_U01_P03",
      "unit_id": "Ch4_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U01_P03",
        "point": "引入HCC等特定癌种的阴性结果，讨论肝硬化背景下的免疫缓冲效应与结论外推边界。",
        "development": "利用P0275 Meta分析指出HCC中抗生素未显著恶化OS/PFS/ORR，结合肝硬化导致的基线免疫抑制与肠肝轴紊乱，解释为何抗生素扰动在此类人群中不转化为明确的生存劣势，警示单一机制模型的局限性。",
        "source_uses": [
          {
            "source_handle": "P0275",
            "role": "主论据",
            "use": "引入 HCC Meta 分析（n=1056 亚洲人群）阴性结果，结合肝硬化基线免疫抑制与肠肝轴紊乱背景，解释抗生素扰动在此类人群中不转化为明确生存劣势。"
          },
          {
            "source_handle": "P0547",
            "role": "比较",
            "use": "通过系统综述量化多数实体瘤中抗生素暴露导致生存率下降的风险幅度，并指出黑色素瘤中的阴性结果，警示单一机制模型的外推边界。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U01_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch4_U01_P03",
            "unit_id": "Ch4_U01",
            "ordinal": 3,
            "point": "引入HCC等特定癌种的阴性结果，讨论肝硬化背景下的免疫缓冲效应与结论外推边界。",
            "development": "利用P0275 Meta分析指出HCC中抗生素未显著恶化OS/PFS/ORR，结合肝硬化导致的基线免疫抑制与肠肝轴紊乱，解释为何抗生素扰动在此类人群中不转化为明确的生存劣势，警示单一机制模型的局限性。",
            "source_handles": [
              "P0275"
            ]
          }
        ]
      }
    },
    "Ch4::Ch4_U02::Ch4_U02_P01": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U02::Ch4_U02_P01",
      "original_task_id": "Ch4_U02_P01",
      "unit_id": "Ch4_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U02_P01",
        "point": "量化PPIs使用与ICI生存结局的负相关，强调使用时窗（基线/ICI前60天）的决定性作用。",
        "development": "整合P0339 Meta分析数据（OS HR 1.31, PFS HR 1.30），对比不同暴露时窗的效应差异，确立PPI作为独立预后不良因子的地位。",
        "source_uses": [
          {
            "source_handle": "P0339",
            "role": "主论据",
            "use": "整合 33 项研究 Meta 分析数据（OS HR=1.31, PFS HR=1.30），量化 PPI 使用与 ICI 生存结局的负相关，强调基线或 ICI 前 60 天内使用时窗的决定性作用。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U02_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch4_U02_P01",
            "unit_id": "Ch4_U02",
            "ordinal": 1,
            "point": "量化PPIs使用与ICI生存结局的负相关，强调使用时窗（基线/ICI前60天）的决定性作用。",
            "development": "整合P0339 Meta分析数据（OS HR 1.31, PFS HR 1.30），对比不同暴露时窗的效应差异，确立PPI作为独立预后不良因子的地位。",
            "source_handles": [
              "P0339"
            ]
          }
        ]
      }
    },
    "Ch4::Ch4_U02::Ch4_U02_P02": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U02::Ch4_U02_P02",
      "original_task_id": "Ch4_U02_P02",
      "unit_id": "Ch4_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U02_P02",
        "point": "揭示化疗近期暴露对PPI效应的修饰作用，并提出“口腔化”易位与菌群多样性丧失的机制假说。",
        "development": "结合P0537发现化疗<1年间隔消除PPI负面影响，以及P0289/P0088关于PPI促进口腔细菌定植、降低α多样性的描述，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。",
        "source_uses": [
          {
            "source_handle": "P0537",
            "role": "主论据",
            "use": "揭示化疗结束至 ICI 开始间隔<1 年可消除 PPI 负面影响（HR 1.09），并报告 PPI 使用者乳酸杆菌科和韦荣球菌属相对丰度较高，构建“胃酸抑制→菌群失调→免疫 priming 受损”的逻辑链。"
          },
          {
            "source_handle": "P0289",
            "role": "例证",
            "use": "描述 PPI 促进口腔细菌定植、降低α多样性的机制证据，结合 P0537 构建“胃酸抑制→菌群失调→免疫 priming 受损”的逻辑链。"
          },
          {
            "source_handle": "P0088",
            "role": "例证",
            "use": "提供 PPI 改变乳酸杆菌科和韦荣球菌属相对丰度的微生物组数据，支持 PPI 诱导特定菌群失调从而干扰免疫稳态的生物学基础。"
          },
          {
            "source_handle": "P0585",
            "role": "比较",
            "use": "提供 JCOG2007 试验中化疗 - 免疫联合治疗背景下的微生物组数据，作为化疗时序修饰药物效应的外部验证与对照。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U02_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch4_U02_P02",
            "unit_id": "Ch4_U02",
            "ordinal": 2,
            "point": "揭示化疗近期暴露对PPI效应的修饰作用，并提出“口腔化”易位与菌群多样性丧失的机制假说。",
            "development": "结合P0537发现化疗<1年间隔消除PPI负面影响，以及P0289/P0088关于PPI促进口腔细菌定植、降低α多样性的描述，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。",
            "source_handles": [
              "P0537",
              "P0289",
              "P0088"
            ]
          }
        ]
      }
    },
    "Ch4::Ch4_U02::Ch4_U02_P03": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U02::Ch4_U02_P03",
      "original_task_id": "Ch4_U02_P03",
      "unit_id": "Ch4_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U02_P03",
        "point": "对比PPIs与H2B的毒性信号差异，并提供临床用药降级与监测建议。",
        "development": "引用P0286 FAERS信号显示PPI联用显著增加肝胆/皮肤irAEs报告率，结合P0537中H2B未达显著生存影响的观察，提出在必须抑酸时优先考虑H2B或严格限定PPI适应症的实践启示。",
        "source_uses": [
          {
            "source_handle": "P0286",
            "role": "主论据",
            "use": "引用 FAERS 自发报告系统信号显示 ICI+PPI 联用显著升高肝胆疾病（RORadj 7.10）、皮肤及代谢障碍的报告率，对比 H2B 未达显著生存影响的观察，提供临床用药降级与监测建议的实证依据。"
          },
          {
            "source_handle": "P0537",
            "role": "比较",
            "use": "提供 H2B 未达显著生存影响的观察数据，作为 PPI 毒性信号的对照，支持临床用药降级建议。"
