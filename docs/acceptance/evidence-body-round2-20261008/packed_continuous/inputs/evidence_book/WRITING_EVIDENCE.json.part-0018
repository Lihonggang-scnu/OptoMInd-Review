    "atom::64d85960adb517ce19d05f9c": {
      "atom_id": "atom::64d85960adb517ce19d05f9c",
      "source_handle": "P0585",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "本研究未提供直接的机制验证（如动物模型、体外实验或代谢产物测量）。关联不等于因果。方案特异性结果的生物学解释需谨慎，可能涉及药物代谢、免疫微环境改变等多重因素。",
        "contribution": "提供了微生物群落结构与临床结局（生存期和毒性）的关联数据，暗示了微生物可能通过调节宿主免疫反应（进而影响疗效和毒性）发挥作用，但未直接测定分子机制。指出了不同免疫检查点阻断策略（PD-1 vs CTLA-4+PD-1）下微生物效应的差异性（方案特异性）。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b48b92078f04672f80082d0088935adb6508549e41039f2b01120655f16c11f8",
