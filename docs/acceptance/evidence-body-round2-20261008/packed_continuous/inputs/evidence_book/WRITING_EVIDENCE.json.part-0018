          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::909e93d69c5a110886797e4e6a1176ec0d75401b7009eecee9d6127d17db9e26",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::9eb0e2ee092ab9603a4b3f5860ed3de523f9fdb34ce7719fecb2a31f71be2312",
      "multiple_values_in_field": true
    },
    "atom::f6d378b9f95e97eb1941761d": {
      "atom_id": "atom::f6d378b9f95e97eb1941761d",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "评估了FMT、MET、益生菌、饮食等多种干预策略的临床转化潜力。",
        "limits": "大多数微生物组干预措施仍处于早期临床试验阶段，缺乏针对NSCLC的大规模随机对照试验结果，长期安全性和有效性尚不确定。"
      },
      "role": "evidence",
