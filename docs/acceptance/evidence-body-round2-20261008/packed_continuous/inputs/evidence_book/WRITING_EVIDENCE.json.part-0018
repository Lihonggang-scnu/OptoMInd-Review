    "atom::4c396bd4df8d2fa702a9621c": {
      "atom_id": "atom::4c396bd4df8d2fa702a9621c",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "动物模型及初步临床试验",
        "finding": "FMT从ICI响应者转移至小鼠可恢复ICI疗效；口服A. muciniphila可逆转耐药。部分临床试验显示FMT联合ICI在黑色素瘤和NSCLC中具有安全性和初步疗效，但针对NSCLC的大规模数据仍有限。益生菌的效果在不同研究中存在不一致性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
