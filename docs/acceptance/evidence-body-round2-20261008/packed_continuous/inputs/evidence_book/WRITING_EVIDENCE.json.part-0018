    "Ch5::Ch5_U01::Ch5_U01_P01": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U01::Ch5_U01_P01",
      "original_task_id": "Ch5_U01_P01",
      "unit_id": "Ch5_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U01_P01",
        "point": "报告 FMT-LUMINate 与 MIMic 试验在初治实体瘤队列中的 ORR 与生存信号。",
        "development": "对比 NSCLC 单药抗 PD-1（ORR 80%）与黑色素瘤双药抗 PD-1/CTLA-4（ORR 75%）背景下的响应差异，指出单臂设计下的高响应率提示 FMT 具备增效潜力，但需警惕历史对照偏倚。MIMic 试验报告 ORR 65%，中位 PFS 29.6 个月，中位 OS 52.8 个月。",
        "source_uses": [
          {
            "source_handle": "P0583",
            "role": "主论据",
            "use": "提供 FMT-LUMINate 试验在 NSCLC 与黑色素瘤队列中的 ORR 与 PFS 核心数据"
          },
          {
            "source_handle": "P0577",
            "role": "主论据",
            "use": "提供 MIMic 试验在黑色素瘤一线治疗中的 ORR、PFS 及 OS 数据"
          },
          {
            "source_handle": "P0215",
            "role": "背景",
            "use": "提供一线实体瘤队列中 FMT 联合 ICI 的客观缓解率汇总数据，对比不同癌种响应差异"
          },
          {
            "source_handle": "P0343",
            "role": "背景",
            "use": "汇总活体生物疗法及高纤维饮食与 ICI 疗效关联的临床证据链，强化干预策略增效潜力分析"
          },
          {
            "source_handle": "P0585",
            "role": "例证",
            "use": "提供 JCOG2007 III 期试验辅助生物标志物数据，证实特定菌属丰度与化疗免疫联合方案 OS 获益相关"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U01_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U01_P01",
            "unit_id": "Ch5_U01",
            "ordinal": 1,
            "point": "报告 FMT-LUMINate 与 MIMic 试验在初治实体瘤队列中的 ORR 与生存信号。",
            "development": "对比 NSCLC 单药抗 PD-1（ORR 80%）与黑色素瘤双药抗 PD-1/CTLA-4（ORR 75%）背景下的响应差异，指出单臂设计下的高响应率提示 FMT 具备增效潜力，但需警惕历史对照偏倚。MIMic 试验报告 ORR 65%，中位 PFS 29.6 个月，中位 OS 52.8 个月。",
            "source_handles": [
              "P0583",
              "P0577"
            ]
          }
        ]
      }
    },
    "Ch5::Ch5_U01::Ch5_U01_P02": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U01::Ch5_U01_P02",
      "original_task_id": "Ch5_U01_P02",
      "unit_id": "Ch5_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U01_P02",
        "point": "阐述 FMT 起效的潜在机制：基线病原菌清除优于供体定植。",
        "development": "解析 LUMINate 试验发现响应者获益主要依赖基线有害菌属（如 Enterocloster、Clostridium）的大量丢失，伴随色氨酸代谢产物降低与 CD8+ T 细胞扩增；动物回输实验证实消除这些有害菌是疗效必要条件。MIMic 试验也观察到响应者富集产 SCFA 菌群（Blautia, Roseburia, Faecalibacterium）及糖基修饰酶。",
        "source_uses": [
          {
            "source_handle": "P0583",
            "role": "主论据",
            "use": "提供宏基因组与代谢组分析揭示的“有害菌丢失”假说及 CD8+ T 细胞扩增数据"
          },
          {
            "source_handle": "P0577",
            "role": "主论据",
            "use": "提供响应者富集产 SCFA 菌群及糖基修饰酶的观察结果"
          },
          {
            "source_handle": "P0297",
            "role": "发展",
            "use": "补充 NSCLC 背景下肠道菌群向肿瘤易位的实证数据，阐释有益菌如何重塑局部微环境恢复耗竭 CD8+ T 细胞功能"
          },
          {
            "source_handle": "P0333",
            "role": "背景",
            "use": "提供肠道 - 代谢物 - 免疫轴的结构化框架，阐述特定菌群通过 cGAS-STING 通路激活 DC 及 SCFAs 调节 T 细胞分化的分子机制"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U01_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U01_P02",
            "unit_id": "Ch5_U01",
            "ordinal": 2,
            "point": "阐述 FMT 起效的潜在机制：基线病原菌清除优于供体定植。",
            "development": "解析 LUMINate 试验发现响应者获益主要依赖基线有害菌属（如 Enterocloster、Clostridium）的大量丢失，伴随色氨酸代谢产物降低与 CD8+ T 细胞扩增；动物回输实验证实消除这些有害菌是疗效必要条件。MIMic 试验也观察到响应者富集产 SCFA 菌群（Blautia, Roseburia, Faecalibacterium）及糖基修饰酶。",
            "source_handles": [
              "P0583",
              "P0577"
            ]
          }
        ]
      }
    },
    "Ch5::Ch5_U01::Ch5_U01_P03": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U01::Ch5_U01_P03",
      "original_task_id": "Ch5_U01_P03",
