    "Ch7::Ch7_U02::Ch7_U02_P01": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U02::Ch7_U02_P01",
      "original_task_id": "Ch7_U02_P01",
      "unit_id": "Ch7_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U02_P01",
        "point": "界定观察性关联的因果倒置风险",
        "development": "强调多数发现源于横断面或回顾性队列，解释为何“有益菌富集”可能是疗效良好的结果而非原因。",
        "source_uses": [
          {
            "source_handle": "P0031",
            "role": "主论据",
            "use": "提供宏观背景与机制概览，指出肠道微生物组与 ICI 疗效关联的因果性不明及异质性大的局限性。"
          },
          {
            "source_handle": "P0433",
            "role": "主论据",
            "use": "整合多个关键临床队列和基础研究的发现，指出许多机制证据来自小鼠模型，直接外推到人类需谨慎。"
          },
          {
            "source_handle": "P0561",
            "role": "发展",
            "use": "提出“分子模拟”假说及量化方法（TAS），解释观察性关联背后的潜在因果机制，同时指出其验证局限性与 HLA LOH 等负面调节因素。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U02_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch7_U02_P01",
            "unit_id": "Ch7_U02",
            "ordinal": 1,
            "point": "界定观察性关联的因果倒置风险",
            "development": "强调多数发现源于横断面或回顾性队列，解释为何“有益菌富集”可能是疗效良好的结果而非原因。",
            "source_handles": [
              "P0031",
              "P0433"
            ]
          }
        ]
      }
    },
    "Ch7::Ch7_U02::Ch7_U02_P02": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U02::Ch7_U02_P02",
      "original_task_id": "Ch7_U02_P02",
      "unit_id": "Ch7_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U02_P02",
        "point": "评估药物与生活方式暴露的混杂干扰",
        "development": "列举抗生素、PPI及饮食对微生物组的广泛重塑作用，指出其可能掩盖或模拟微生物-ICI的真实关联。",
        "source_uses": [
          {
            "source_handle": "P0012",
            "role": "例证",
            "use": "提供抗生素干扰抗肿瘤治疗疗效的具体反面案例，提示肠道菌群失调可能通过多种机制影响药物疗效。"
          },
          {
            "source_handle": "P0171",
            "role": "主论据",
            "use": "系统列出被报道与疗效相关或无关的具体微生物分类群，分析临床前与临床数据不一致性的方法学局限。"
          },
          {
            "source_handle": "P0375",
            "role": "发展",
            "use": "提出“抗性/易感”微生物群概念框架，指出饮食模式与合并用药的交互作用会重塑菌群功能，警示观察性关联中未控暴露的混杂风险。"
          },
          {
            "source_handle": "P0558",
            "role": "例证",
            "use": "提供 ICI 给药时间与生存结局的观察性数据，作为非微生物因素（时间生物学）干扰疗效的对照证据，警示混杂控制的复杂性。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U02_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch7_U02_P02",
            "unit_id": "Ch7_U02",
            "ordinal": 2,
            "point": "评估药物与生活方式暴露的混杂干扰",
            "development": "列举抗生素、PPI及饮食对微生物组的广泛重塑作用，指出其可能掩盖或模拟微生物-ICI的真实关联。",
            "source_handles": [
              "P0012",
              "P0171"
            ]
          }
        ]
      }
    },
    "Ch7::Ch7_U02::Ch7_U02_P03": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U02::Ch7_U02_P03",
      "original_task_id": "Ch7_U02_P03",
      "unit_id": "Ch7_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U02_P03",
        "point": "剖析跨物种机制外推的生理鸿沟",
        "development": "对比无菌小鼠定植实验与人类复杂生态系统的差异，说明单一菌株效应可能在人体中被网络冗余或宿主遗传所缓冲。",
        "source_uses": [
          {
            "source_handle": "P0229",
            "role": "主论据",
            "use": "详细阐述微生物调节 ICI 和化疗反应的具体机制和潜在生物标志物列表，指出许多机制主要基于小鼠模型。"
          },
          {
            "source_handle": "P0525",
            "role": "主论据",
            "use": "提供计算模型视角，说明特定预测标记物 derived from simulation outputs 可能依赖模型假设。"
          },
          {
            "source_handle": "P0024",
            "role": "比较",
            "use": "借助慢性病毒感染模型展示治疗干预后代谢通路的持续性异常，类比说明宿主病理状态可能掩盖或模拟微生物介导的真实效应。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U02_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch7_U02_P03",
            "unit_id": "Ch7_U02",
            "ordinal": 3,
            "point": "剖析跨物种机制外推的生理鸿沟",
            "development": "对比无菌小鼠定植实验与人类复杂生态系统的差异，说明单一菌株效应可能在人体中被网络冗余或宿主遗传所缓冲。",
            "source_handles": [
              "P0229",
              "P0525"
            ]
          }
        ]
      }
    },
    "Ch7::Ch7_U02::Ch7_U02_P04": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U02::Ch7_U02_P04",
      "original_task_id": "Ch7_U02_P04",
      "unit_id": "Ch7_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U02_P04",
        "point": "审视统计推断工具的适用边界",
        "development": "指出MR等方法在工具变量强度、人群代表性及终点匹配（发病vs疗效）上的局限，主张将其定位为假设生成器。",
        "source_uses": [
          {
            "source_handle": "P0059",
            "role": "主论据",
            "use": "通过孟德尔随机化方法从遗传角度证实肠道微生物及其代谢产物对多种实体瘤的潜在因果影响，但指出未直接涉及 ICI 疗效临床终点。"
          },
          {
            "source_handle": "P0005",
            "role": "主论据",
            "use": "作为高层概念图，链接肠道微生物组组成与 ICI 疗效，提供具体有益细菌例子及作用机制。"
          },
          {
            "source_handle": "P0010",
            "role": "局限",
            "use": "揭示青少年与老年患者基线菌群结构的显著差异，论证年龄发育阶段作为关键混杂变量如何干扰因果链条构建，支持分龄分层分析的必要性。"
          },
          {
            "source_handle": "P0545",
            "role": "局限",
            "use": "提供波兰队列实证，揭示特定菌属与疗效关联的人群依赖性，论证年龄、饮食等混杂变量干扰因果链条构建的风险。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U02_P04"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch7_U02_P04",
            "unit_id": "Ch7_U02",
            "ordinal": 4,
            "point": "审视统计推断工具的适用边界",
            "development": "指出MR等方法在工具变量强度、人群代表性及终点匹配（发病vs疗效）上的局限，主张将其定位为假设生成器。",
            "source_handles": [
              "P0059",
              "P0005"
            ]
          }
        ]
      }
