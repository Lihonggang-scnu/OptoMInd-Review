          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::cee78cb7f2fedf1791b3d66e82a2682454fa584e53919e56815c0f1639402a75",
      "multiple_values_in_field": true
    },
    "atom::ba61cbd812da635037471f05": {
      "atom_id": "atom::ba61cbd812da635037471f05",
      "source_handle": "P0146",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to list candidate microbial biomarkers for predicting ICI efficacy in solid tumors. Helps explain inter-patient variability in treatment response.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::89b8f947d85f7362a3c254e0e002085457319d9cd845107ac15367721f1d4de2",
          "field_path": [
