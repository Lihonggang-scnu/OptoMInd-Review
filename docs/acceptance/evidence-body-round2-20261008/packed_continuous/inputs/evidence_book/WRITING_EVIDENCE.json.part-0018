    "Ch4::Ch4_U03::Ch4_U03_P02": {
      "chapter_id": "Ch4",
      "local_task_id": "Ch4_U03::Ch4_U03_P02",
      "original_task_id": "Ch4_U03_P02",
      "unit_id": "Ch4_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch4_U03_P02",
        "point": "剖析商业益生菌的矛盾证据，强调菌株特异性、生态位竞争及“食物基质优于补充剂”的原则。",
        "development": "对比P0390中非标准化益生菌的负面信号与P0583/P0593中CBM588/LBTs的初步阳性趋势，结合P0249 Avatar模型证明饮食成分可绕过定植障碍直接驱动代谢输出，论证盲目补充的风险与精准靶向的必要性。",
        "source_uses": [
          {
            "source_handle": "P0390",
            "role": "主论据",
            "use": "剖析商业益生菌的矛盾证据，指出非标准化益生菌补充导致抗 PD-1 反应受损（IFN-γ+ CTL 频率降低），论证盲目补充的风险与精准靶向的必要性。"
          },
          {
            "source_handle": "P0249",
            "role": "例证",
            "use": "提供黑覆盆子饮食干预的人源化 Avatar 模型证据，证明饮食成分可绕过定植障碍直接驱动代谢输出，支持“食物基质优于补充剂”原则。"
          },
          {
            "source_handle": "P0583",
            "role": "比较",
            "use": "报告 FMT-LUMINate 试验中响应者基线有害菌种丢失及供体菌株未定植的现象，为剖析商业益生菌/补充剂的矛盾证据提供关键对照。"
          },
          {
            "source_handle": "P0593",
            "role": "负责人指定",
            "use": ""
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch4_U03_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch4_U03_P02",
            "unit_id": "Ch4_U03",
            "ordinal": 2,
            "point": "剖析商业益生菌的矛盾证据，强调菌株特异性、生态位竞争及“食物基质优于补充剂”的原则。",
            "development": "对比P0390中非标准化益生菌的负面信号与P0583/P0593中CBM588/LBTs的初步阳性趋势，结合P0249 Avatar模型证明饮食成分可绕过定植障碍直接驱动代谢输出，论证盲目补充的风险与精准靶向的必要性。",
            "source_handles": [
