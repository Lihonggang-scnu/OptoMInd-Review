    "Ch5::Ch5_U02::Ch5_U02_P02": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U02::Ch5_U02_P02",
      "original_task_id": "Ch5_U02_P02",
      "unit_id": "Ch5_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U02_P02",
        "point": "解析阴性结果的生物学限制：定植动力学短暂与宿主免疫微环境固化。",
        "development": "说明多数受体仅出现短暂供体相似性偏移，持久定植仅见于唯一获益者；基线髓系偏倚（高 CD14+ 单核细胞）与高 IL-8 水平预示不良预后，且 FMT 未能逆转该髓系主导状态，提示疗效受限于宿主固有免疫抑制背景。",
        "source_uses": [
          {
            "source_handle": "P0578",
            "role": "主论据",
            "use": "提供微生物动力学数据及外周血质谱流式显示的基线髓系偏倚与 IL-8 水平关联"
          },
          {
            "source_handle": "P0178",
            "role": "背景",
            "use": "引入“生态药理学”分析框架，阐明在宿主免疫微环境固化背景下，简单添加外源菌群难以逆转获得性耐药"
          },
          {
            "source_handle": "P0304",
            "role": "发展",
            "use": "系统梳理难治性队列中 FMT 干预后的免疫表型变化，指出短暂定植与基线炎症状态的耦合效应"
          },
          {
            "source_handle": "P0358",
            "role": "背景",
            "use": "提供跨癌种微生物特征与 irAEs 发生率的对照清单，为阴性结果提供安全性与疗效权衡的背景参照"
          },
          {
            "source_handle": "P0474",
            "role": "发展",
            "use": "提供肿瘤微环境介导 ICI 耐药的机制综述，补充说明宿主基线免疫抑制背景对 FMT 疗效的限制"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U02_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U02_P02",
            "unit_id": "Ch5_U02",
            "ordinal": 2,
            "point": "解析阴性结果的生物学限制：定植动力学短暂与宿主免疫微环境固化。",
            "development": "说明多数受体仅出现短暂供体相似性偏移，持久定植仅见于唯一获益者；基线髓系偏倚（高 CD14+ 单核细胞）与高 IL-8 水平预示不良预后，且 FMT 未能逆转该髓系主导状态，提示疗效受限于宿主固有免疫抑制背景。",
            "source_handles": [
              "P0578"
            ]
          }
        ]
      }
    },
    "Ch5::Ch5_U02::Ch5_U02_P03": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U02::Ch5_U02_P03",
      "original_task_id": "Ch5_U02_P03",
      "unit_id": "Ch5_U02",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U02_P03",
        "point": "补充 Kim 等研究数据，确认耐药人群中 FMT 整体响应率极低。",
        "development": "引用抗 PD-1 耐药晚期实体瘤单臂研究中 ORR 仅 7.7%、DCR 46.2% 的数据，强调缺乏随机对照与较小样本量，进一步支持 FMT 难以普遍克服已建立的获得性耐药。",
        "source_uses": [
          {
            "source_handle": "P0594",
            "role": "主论据",
            "use": "提供 Kim 等前瞻性单臂研究在抗 PD-1 耐药实体瘤中的 ORR 与 DCR 数据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U02_P03"
        ],
        "source_brief_details": [
