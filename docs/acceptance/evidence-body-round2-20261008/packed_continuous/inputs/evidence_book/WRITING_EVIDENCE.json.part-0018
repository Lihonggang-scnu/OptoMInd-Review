    "Ch5::Ch5_U03::Ch5_U03_P01": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U03::Ch5_U03_P01",
      "original_task_id": "Ch5_U03_P01",
      "unit_id": "Ch5_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U03_P01",
        "point": "评估 CBM588 在 mRCC 一线治疗中对肠道稳态的调节作用。",
        "development": "说明 CBM588 能防止 Eubacterium siraeum 耗竭并纠正 Firmicutes/Bacteroidetes 比率失衡，为临床获益提供微生物学合理性，但早期 I 期合并分析未直接关联 ORR/PFS。",
        "source_uses": [
          {
            "source_handle": "P0006",
            "role": "主论据",
            "use": "提供 CBM588 在 mRCC ICI 治疗中对肠道微生物组组成及失调的具体调节证据"
          },
          {
            "source_handle": "P0143",
            "role": "主论据",
            "use": "提供 CBM588 纠正 F/B 比率失衡及保护特定菌属的微生物标志物数据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U03_P01"
        ],
        "source_brief_details": [
