    "Ch7::Ch7_U03::Ch7_U03_P01": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U03::Ch7_U03_P01",
      "original_task_id": "Ch7_U03_P01",
      "unit_id": "Ch7_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U03_P01",
        "point": "盘点早期试验信号与III期验证的缺席",
        "development": "汇总I/II期FMT与益生菌的概念验证结果，明确指出缺乏大型RCT支持常规临床应用。",
        "source_uses": [
          {
            "source_handle": "P0026",
            "role": "主论据",
            "use": "汇总支持微生物组影响 ICI 疗效的主要菌属及 FMT 克服 ICI 耐药的临床尝试，指出当前证据的方法学局限。"
          },
          {
            "source_handle": "P0215",
            "role": "主论据",
            "use": "提供微生物组调节在 ICI 治疗实体瘤中的基础概述，列举成功和失败的干预例子。"
          },
          {
            "source_handle": "P0178",
            "role": "主论据",
            "use": "提供结构化的临床证据框架，汇总 FMT、LBPs 和定义菌群三类干预的具体试验结果。"
          },
          {
            "source_handle": "P0534",
            "role": "局限",
            "use": "汇总 FMT 与活体细菌产品的概念验证结果，明确指出缺乏大型 RCT 支持常规临床应用，支撑早期试验信号与 III 期验证缺席的判断。"
          },
          {
            "source_handle": "P0439",
            "role": "例证",
            "use": "系统梳理结直肠癌 FMT 与益生菌早期临床试验数据，指出供体筛选困难、定植效率波动及安全性监管缺口。"
          },
          {
            "source_handle": "P0584",
            "role": "局限",
            "use": "梳理早期临床试验（I/II 期）数据，强调供体筛选困难、定植效率波动及安全性监管缺口，支撑干预策略尚未成为标准护理的判断。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U03_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch7_U03_P01",
            "unit_id": "Ch7_U03",
            "ordinal": 1,
            "point": "盘点早期试验信号与III期验证的缺席",
            "development": "汇总I/II期FMT与益生菌的概念验证结果，明确指出缺乏大型RCT支持常规临床应用。",
            "source_handles": [
              "P0026",
              "P0215",
              "P0178"
            ]
          }
        ]
      }
