    "atom::1057b507eca51d0fcea5f768": {
      "atom_id": "atom::1057b507eca51d0fcea5f768",
      "source_handle": "P0585",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "整体队列，关注严重不良事件（≥ Grade 4 AEs）",
        "finding": "较低的微生物α多样性及某些特定菌属的存在与较高的严重AE风险相关。相反，有益菌属（如Fusicatenibacter和Butyricicoccus）的高丰度与较低的严重AE风险相关。"
      },
      "role": "evidence",
