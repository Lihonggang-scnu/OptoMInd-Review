    "atom::931538e398f7fa3ac82bfdbf": {
      "atom_id": "atom::931538e398f7fa3ac82bfdbf",
      "source_handle": "P0585",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于支持综述中关于“有益微生物促进ICI疗效”的论点。可用于举例说明特定菌属（产丁酸菌）在改善预后中的作用。可用于讨论微生物与免疫治疗毒性的关联（安全性维度）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::b48b92078f04672f80082d0088935adb6508549e41039f2b01120655f16c11f8",
