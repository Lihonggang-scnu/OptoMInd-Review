            "use": "论证耦合培养组学与宏基因组测序以表征 ICI 治疗患者肠道微生物组的必要性。"
          },
          {
            "source_handle": "P0566",
            "role": "比较",
            "use": "对比肠道与口腔微生物组预测效力的差异，补充空间异质性带来的分析局限，支持多部位采样与标准化流程的必要性。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
