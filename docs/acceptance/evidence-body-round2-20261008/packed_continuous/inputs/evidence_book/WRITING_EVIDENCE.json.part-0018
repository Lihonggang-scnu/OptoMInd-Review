            "role": "背景",
            "use": "提供 FMT、LBPs 和定义菌群三类干预的安全性汇总及生态药理学因素分析"
          },
          {
            "source_handle": "P0231",
            "role": "背景",
            "use": "提供跨癌种微生物特征与 irAEs 发生率的对照清单，区分不同免疫骨架下的毒性预测价值"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U04_P03"
        ],
        "source_brief_details": [
