            "use": "提供涵盖特定菌属富集、抗生素暴露及 FMT 效果的定量荟萃分析结果，汇总群体水平的统计关联证据"
          },
          {
            "source_handle": "P0573",
            "role": "发展",
            "use": "对比 FMT、益生菌与工程菌的临床转化现状，指出供体筛选标准与给药方案异质性是导致概念验证试验结果分化的主因"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
