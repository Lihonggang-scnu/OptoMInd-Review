  "unit_contexts": {
    "Ch1": {
      "U1_跨癌种关联图谱": {
        "unit_id": "U1_跨癌种关联图谱",
        "focus": "跨癌种观察性队列证实特定肠道微生物特征（分类学与功能通路）与 ICI 疗效存在显著关联，但缺乏普适性单一标志物，证据强度呈癌种特异性分布。",
        "owner_unit_context": {
          "evidence_conditions": "",
          "synthesis": "",
          "transition": "既然基线快照与方案特异性已严重限制单一标志物的泛化，必须审视外部药物暴露如何进一步修饰这些关联。",
          "argument_relations": "共性信号确立微生物-ICI 关联的生物学合理性 → 跨队列异质性统计依据否定普适性单一标志物假设 → 方案特异性修饰效应进一步限制泛化边界。",
          "supporting_studies": [
            {
              "contribution": "提供NSCLC背景下跨癌种（黑色素瘤、肾癌）的微生物特征清单，指出特定菌属富集与疗效正相关但存在阈值风险，支撑综述中“跨癌种共性信号与情境依赖性”的论述。",
              "paper_id": "261e0a3618ae7acf6e831646379929eff88857d5",
              "source_handle": "P0096"
            },
            {
              "contribution": "揭示微生物标志物的肠型特异性（如E2肠型中Collinsella与响应相关），解释为何单一物种难以成为普适性生物标志物，为“无通用标志物”的统计依据提供群落背景视角。",
              "paper_id": "4a1e10851c0bf838d11646a65bc0ee57b10b940a",
              "source_handle": "P0170"
            },
            {
              "contribution": "证明菌株级签名在联合免疫治疗中具有泛癌种预测力，但在单药队列中失效，直接支撑“治疗方案严格修饰微生物效应方向”及“缺乏普适性单一标志物”的核心论点。",
              "paper_id": "08a484e3c782bc9552d2df812bad2ec86f231edc",
              "source_handle": "P0015"
            },
            {
              "contribution": "提供NSCLC与黑色素瘤的大样本荟萃分析数据，量化高α多样性及Akkermansia/Faecalibacterium富集对ICI生存期的正向预后效应，支撑“跨癌种共性信号”的论述。",
              "paper_id": "82318ae05cff1667b2348961675db67dee4d8360",
              "source_handle": "P0298"
            },
            {
              "contribution": "展示HCC多界微生物组特征，揭示细菌/代谢物在持久获益与非获益组间的显著差异而真菌差异较小，用于论证微生物效应具有高度癌种特异性及多界异质性。",
              "paper_id": "58ddfd822378599d43b877cd0905dfe067a4375f",
              "source_handle": "P0204"
            },
            {
              "contribution": "基于SCRUM-Japan大规模队列证实整体α多样性与ICI疗效无普遍关联，且粪便口腔细菌比例升高预测较差PFS（尤其合并PPI使用时），为“无通用标志物”及统计异质性提供关键反例。",
              "paper_id": "7fe882e8b39d1a041fd2fee47d9321c965f01aa5",
              "source_handle": "P0289"
            },
            {
              "contribution": "报道mCRPC患者中A. muciniphila丰度与ICI疗效呈负相关，挑战跨癌种通用正相关假设，并验证ICI治疗期间菌群高度稳定，支撑治疗方案史修饰效应及基线决定论。",
              "paper_id": "74786f8df0c7648840756833a4b4bc49ace34be6",
              "source_handle": "P0270"
            },
            {
              "contribution": "提供多界微生物组（细菌+真菌+古菌+病毒）整合分析证据，证实高多样性及特定属组合与ICI疗效正相关，补充单一细菌视角的局限，支撑“生态网络稳定性促进疗效”的观点。",
              "paper_id": "a9e58de949ced186b4882146c14b79b306ae9ef5",
              "source_handle": "P0393"
            },
            {
              "contribution": "提出“功能趋同”理论框架，解释分类学不一致背后的共享免疫通路（如SCFA产生、DC激活），为跨队列异质性提供机制整合视角，支持向基于功能的生物标志物开发转型。",
              "paper_id": "9dd62eb058feb9dbd44c28e9c8d004181dd8d19d",
              "source_handle": "P0364"
            },
            {
              "contribution": "展示基因水平微生物丰度结合生物先验知识在预测ICI反应中优于传统分类学特征，揭示治疗策略（联合免疫阻断vs单药）对微生物信号泛化性的修饰作用，丰富标志物开发的维度。",
              "paper_id": "bfb5efeaf486304583ce74567d60f84cf138a0ae",
              "source_handle": "P0437"
            },
            {
              "contribution": "提供波兰队列中饮食模式（高植物/低乳制品）与特定菌群协同影响抗PD-1疗效的实证，支撑“微生物标志物具有人群与生活方式依赖性”的分析。",
              "paper_id": "f31246cd559d1a06b99a32b0ee47bb1ce0265772",
              "source_handle": "P0545"
            },
            {
              "contribution": "系统综述黑色素瘤数据，揭示真菌失调与较差预后的关联，补充单一细菌视角局限，论证多界微生物生态对ICI疗效的综合调节作用。",
              "paper_id": "f9a9ef8d406ee51983cd285f9e60fc41574ae937",
              "source_handle": "P0565"
            },
            {
              "contribution": "基于转移性黑色素瘤宏基因组荟萃分析，确认维生素B代谢通路富集与响应正相关，为“功能趋同优于单一分类学标志物”提供跨队列统计支持。",
              "paper_id": "e533262a6b45c7d00cff83bd889cdc367c85f377",
              "source_handle": "P0511"
            }
          ]
        },
        "unit_notes": ""
      },
      "U2_外部干扰与宿主背景": {
        "unit_id": "U2_外部干扰与宿主背景",
        "focus": "外部药物暴露（抗生素、PPIs）及联合治疗方案构成关键混杂/修饰变量，其影响具有明确的时间窗口特异性和剂量依赖性，需在关联分析中严格校正。",
        "owner_unit_context": {
          "evidence_conditions": "",
          "synthesis": "",
          "transition": "外部干扰虽可量化，但基线单次采样仍难以捕捉治疗诱导的生态重塑，必须转向纵向动态监测。",
          "argument_relations": "量化暴露效应与时间窗特异性 → 联合方案修饰/反转效应方向 → 强调校正必要性与残余偏倚风险，确立外部干扰作为核心混杂/修饰变量的地位。",
          "supporting_studies": [
            {
              "contribution": "量化抗酸药（PPIs）使用导致链球菌增加及短PFS的关联，并对比化疗预处理对微生物组的持久影响，支撑“外部药物暴露具有明确时间窗特异性与剂量依赖性”的分析任务。",
              "paper_id": "35f3b135b6c865df8bb304e1f28a8247e55c25fd",
              "source_handle": "P0123"
            },
            {
              "contribution": "汇总抗生素、PPIs及类固醇暴露对ICI预后的负面效应量，特别强调抗生素使用时机（治疗后vs治疗前）的差异，为讨论指示偏倚高估负面效应及需标准化校正提供实证对照。",
              "paper_id": "45ca27020bec6c917c6b71d8b1bad217f5abd0ed",
              "source_handle": "P0157"
            },
            {
              "contribution": "展示PPI使用者与非使用者在微生物动态轨迹上的显著差异（如Streptococcus thermophilus变化方向相反），说明合并用药可重塑菌群演化路径，需在关联分析中作为关键协变量严格校正。",
              "paper_id": "0f25b980517704cd7fa782dd9e51d16b77d00249",
              "source_handle": "P0033"
            },
            {
              "contribution": "提供超5万名实体瘤患者的系统综述与荟萃分析数据，量化全身性抗生素暴露导致PFS和OS显著缩短的效应量，确立抗生素作为负面预后调节因子的流行病学证据等级。",
              "paper_id": "62379160afa6c14c9a9ae85a0684ccec8ed9c07e",
              "source_handle": "P0236"
            },
            {
              "contribution": "聚焦拉丁美洲NSCLC人群，证实抗生素暴露显著降低OS但未影响PFS，提示地域/人群特征可能扰动微生物-疗效轴，补充外部干扰效应的群体异质性背景。",
              "paper_id": "70ba511d3bb0697cd93e53d4880c68ce77471bde",
              "source_handle": "P0266"
            },
            {
              "contribution": "揭示质子泵抑制剂(PPI)使用者粪便中口腔细菌比例显著升高，且该特征在PPI亚组中与更差PFS趋势强相关，阐明合并用药通过重塑肠道生态位构成关键混杂/修饰变量。",
              "paper_id": "7fe882e8b39d1a041fd2fee47d9321c965f01aa5",
              "source_handle": "P0289"
            },
            {
              "contribution": "针对HCC人群的Meta分析显示抗生素使用未显著恶化ICI疗效(OS/PFS/ORR)，提出肝硬化基线免疫抑制状态可能缓冲抗生素扰动，为讨论指示偏倚及肿瘤类型特异性校正必要性提供反面对照。",
              "paper_id": "768ceed11b5509cd8f6c24d07e8fa015646929c0",
              "source_handle": "P0275"
            },
            {
              "contribution": "提供大样本荟萃分析数据，量化PPI使用与ICI生存结局恶化的关联，并细化使用时窗（基线/前60天 vs 同期）的效应差异，为讨论药物暴露的时间依赖性干扰提供流行病学基准。",
              "paper_id": "9225e04c4f9620a87d4eb74932067cab87644bf2",
              "source_handle": "P0339"
            },
            {
              "contribution": "提供妇科肿瘤真实世界数据，明确抗生素使用时长（≥14天）与OS显著缩短的独立关联，区分短期反应指标与长期生存获益的差异，强化用药阈值效应的临床证据。",
              "paper_id": "9cfb62b17064ed5abe1c447f8fa2f46e716b6c0d",
              "source_handle": "P0360"
            },
            {
              "contribution": "提供肌肉量这一非微生物宿主因素对ICI疗效影响的实证数据，显示低肌肉量在肺癌中未降低PFS且不增加毒性，作为对比背景说明除菌群外其他宿主因素的预测价值存在异质性。",
              "paper_id": "b7d5f0bd4b9b2ff5ccb0fca4182d84c2111a7fdf",
              "source_handle": "P0421"
            },
            {
              "contribution": "证实NSCLC中抗生素暴露的负面效应高度依赖PD-L1表达水平，为“宿主生物标志物状态严格修饰微生物干预效应方向”提供临床分层依据。",
              "paper_id": "e8fb88935a5c5757dc683f56d1ff0c0f356b20ae",
              "source_handle": "P0517"
            },
            {
              "contribution": "系统综述明确ICI启动前30天内的抗生素暴露是预后恶化的核心风险窗口，同期暴露影响较弱，量化时间窗特异性并提示需区分暴露时机进行校正。",
              "paper_id": "CorpusId:286786239",
              "source_handle": "P0576"
            },
            {
              "contribution": "整合多尺度证据指出抗生素效应在不同实体瘤中存在异质性，警示简单归因于“菌群破坏”，强调需结合肿瘤免疫原性与疾病背景综合评估。",
              "paper_id": "f381ac20e0012cee8a359a479037e3d12ee6e878",
              "source_handle": "P0548"
            }
          ]
        },
        "unit_notes": ""
      },
      "U3_动态监测与纵向演变": {
        "unit_id": "U3_动态监测与纵向演变",
        "focus": "基线单次采样难以捕捉治疗诱导的生态重塑，纵向动态变化（如病原菌清除或定植失败）比静态丰度更能反映真实疗效轨迹，但纵向数据收集仍面临方法学挑战。",
        "owner_unit_context": {
          "evidence_conditions": "",
          "synthesis": "",
          "transition": "纵向监测虽优，但当前证据整体仍停留在观察性阶段，必须审视干预性研究的阶梯分布与安全边界。",
          "argument_relations": "基线快照局限 → 纵向动态预测价值 → 现实障碍与标准化需求，确立纵向监测优于静态快照的方法学共识。",
          "supporting_studies": [
            {
              "contribution": "通过贝叶斯模型证实基线后微生物SGBs的持续积累轨迹比静态丰度更能区分长/短PFS患者，直接支撑“纵向动态变化优于单次基线采样”的方法学主张。",
              "paper_id": "0f25b980517704cd7fa782dd9e51d16b77d00249",
              "source_handle": "P0033"
            },
            {
              "contribution": "提供小规模前瞻性配对样本数据，显示响应者伴随显著的微生物组波动（如梭菌属增加），而无响应者相对稳定或恶化，为“病原菌清除或定植失败反映真实疗效轨迹”提供早期实证。",
              "paper_id": "3bb355ee930e0893c48cf56a7164df771bf2d7f5",
              "source_handle": "P0134"
            },
            {
              "contribution": "记录ICI治疗期间循环Tregs减少与基线拟杆菌属丰度的纵向关联，提示微生物组可能通过设定免疫稳态“临界点”影响疗效，补充了纵向监测中免疫-微生物互作的动态机制线索。",
              "paper_id": "2709ffca937655fdff12c871b14cb93ee1830d79",
              "source_handle": "P0098"
            },
            {
              "contribution": "提供NSCLC与黑色素瘤纵向队列数据，证明治疗初期微生物稳定性丧失独立于抗生素暴露且与ICI耐药显著相关，支持动态监测优于静态采样的核心主张。",
              "paper_id": "5e9212b7607472bd4faf0f6e2385c37552c9821c",
              "source_handle": "P0227"
            },
            {
              "contribution": "展示晚期NSCLC患者纵向多组学轨迹，发现响应者治疗后微生物特征向健康状态回归而进展期均恶化，并开发结合TMB的跨人群微生物评分，阐释动态演变与多模态分层的临床价值。",
              "paper_id": "57133de914bfeefa962dacc91943374147c07fff",
              "source_handle": "P0200"
            },
            {
              "contribution": "针对EGFR突变NSCLC亚群，记录治疗前后微生物U型与倒U型动态演变模式及特定代谢物(脱氧胆酸、L-瓜氨酸)变化，说明驱动基因背景下的纵向生态重塑特征。",
              "paper_id": "590fbadadd7e854b3435c77a34e74cd5b744c084",
              "source_handle": "P0205"
            },
            {
              "contribution": "报告NSCLC基线队列中肠道微生物组成、SCFA谱及肠屏障通透性指标均未能预测ICI反应或irAEs，指出标准化缺失与参考值未建立是纵向/横断面生物标志物转化的主要方法学障碍。",
              "paper_id": "8b3aa2316f5ec9089bf4d5f6cefbb1c1be74ad79",
              "source_handle": "P0327"
            },
            {
              "contribution": "提供人类黑色素瘤患者宏基因组与宏转录组联合分析证据，识别与PFS相关的特定代谢通路（氨基酸合成、维生素合成）及其转录活性，为纵向动态变化提供分子层面的候选机制线索。",
              "paper_id": "b63bda99b7dbfd8c9d82d9a7246125da767de5c7",
              "source_handle": "P0415"
            },
            {
              "contribution": "提供NSCLC物种水平微生物特征与PFS及PD-L1状态的关联数据，证实化疗预处理虽扰动菌群但不消除特异性预测信号，支持动态监测中治疗史独立性的论证。",
              "paper_id": "c39938e0fe05e9c9d70243715a4b8f8524d956a9",
              "source_handle": "P0443"
            },
            {
              "contribution": "提供黏膜黑色素瘤前瞻性队列初步数据，揭示响应者与非响应者肠道菌群组成差异及肿瘤微环境CD56/CD20表达平行变化，补充罕见实体瘤亚型中纵向生态重塑的早期实证。",
              "paper_id": "da741d94b4d509b96c9490a118677edf3d1417a7",
              "source_handle": "P0485"
            },
            {
              "contribution": "报道早期NSCLC新辅助治疗中低基线α多样性与高纵向稳定性预示较好病理缓解，对比晚期研究结果，阐明疾病阶段与治疗强度对动态标志物的情境修饰。",
              "paper_id": "fbbf5b7b16fb493ff4f0b84691ccb2b202d25d41",
              "source_handle": "P0569"
            },
            {
              "contribution": "详述MIMic试验中供体菌株定植动力学与临床获益的关联，指出持久定植者获得更长生存，为“纵向生态重塑轨迹优于单次静态丰度”提供因果验证线索。",
              "paper_id": "20c143d5373eab0bfea2067cf66b0e260dfeb1ef",
              "source_handle": "P0577"
            },
            {
              "contribution": "梳理活体生物制品与后生元在临床试验中的动态监测需求，指出标准化采样频率与存储条件缺失是阻碍纵向数据转化为临床决策的主要方法学瓶颈。",
              "paper_id": "f32b23ec68d527d1114ddf96e609079a09947e6e",
              "source_handle": "P0546"
            }
          ]
        },
        "unit_notes": ""
      },
      "U4_证据阶梯与转化边界": {
        "unit_id": "U4_证据阶梯与转化边界",
        "focus": "当前证据呈现明显的阶梯状分布：观察性关联最强，概念验证性干预（FMT）显示初步希望但异质性大，Phase III RCT 证据完全缺失，且安全性信号受 ICI 方案严格调节。",
        "owner_unit_context": {
          "evidence_conditions": "",
          "synthesis": "",
          "transition": "综上，本章确立了微生物组作为 ICI 疗效调节因子的观察性基础与转化边界，下一章将深入解析介导这些关联的具体分子与细胞机制。",
          "argument_relations": "观察性证据最强 → 概念验证干预异质性大（阳性 vs 阴性） → Phase III 空白与安全信号情境依赖，确立当前证据阶梯分布与转化边界。",
          "supporting_studies": [
            {
              "contribution": "系统梳理FMT克服耐药的初步临床数据（ORR约20%）及机器学习预测性能，明确指出当前缺乏Phase III RCT证据且方法学异质性大，支撑“证据阶梯分布与转化边界”的批判性评估。",
              "paper_id": "0cf91befe63ec25329391e50e90d14093d3c74d7",
              "source_handle": "P0026"
            },
            {
              "contribution": "汇总FMT及益生菌干预的早期临床试验结果，强调多数证据来自病例报告或小样本系列研究，安全性与长期维持效果尚不确定，用于界定概念验证阶段向常规临床应用转化的现实障碍。",
              "paper_id": "412cf94675e5be84f181d1075570015bc0b66c25",
              "source_handle": "P0144"
            },
            {
              "contribution": "对比FMT、益生菌与饮食干预的临床效果差异，指出普通益生菌使用结果高度依赖菌株特异性且部分研究显示无效甚至有害，为讨论干预策略的异质性及安全性信号的情境依赖性提供核心素材。",
              "paper_id": "478e06158ac52abb764c678cb77109164cd00f5d",
              "source_handle": "P0161"
            },
            {
              "contribution": "报告FMT-LUMINate II期试验中NSCLC患者ORR达80%，且响应源于基线有害菌种丢失而非供体定植，提供概念验证干预的初步希望及疗效归因线索。",
              "paper_id": "071823eff68d7dbea395490dd4643170131b5f6a",
              "source_handle": "P0583"
            },
            {
              "contribution": "详述MITRIC IIa期篮子试验阴性结果(ORR 0%)，剖析快速进展疾病背景、供体匹配次优及髓系主导微环境限制等失败主因，界定FMT转化的现实边界。",
              "paper_id": "d9577b3a29bd8aec60c9e27c6a56a63faf3f4a27",
              "source_handle": "P0578"
            },
            {
              "contribution": "阐述A. muciniphila高丰度虽延长NSCLC患者OS但增加irAE风险，明确疗效与毒性在微生物层面的耦合关系，支撑安全性受ICI方案严格调节的情境依赖性论点。",
              "paper_id": "6f8044dc50ea73203f972ec2f8a2e2527694e3d3",
              "source_handle": "P0260"
            },
            {
              "contribution": "系统梳理早期FMT及定义菌群临床试验现状，强调多数证据来自小样本探索性研究且缺乏大型RCT确证，直接呼应Phase III空白及转化医学的证据阶梯分布特征。",
              "paper_id": "8084192e33a8c5d78c74149b0e22d13f2ca24771",
              "source_handle": "P0291"
            },
            {
              "contribution": "系统对比三类微生物干预措施（益生菌vs菌群组合vs FMT）的临床结局，指出FMT在难治性肿瘤中表现较一致ORR提升而益生菌效果高度特异，支撑“干预复杂度决定疗效”的证据阶梯判断。",
              "paper_id": "a7aa74ce68cc3094e2a185d973f39ba70ae017d9",
              "source_handle": "P0387"
            },
            {
              "contribution": "提供肺癌幸存者长期随访数据，通过地标分析校正时间偏倚，揭示获益者特有的紧凑微生物网络与丁酸高产能力，以及irAEs患者的分子模拟表位富集，界定概念验证阶段向常规应用转化的现实边界。",
              "paper_id": "cc2b555e2b10a62d0141cb12ab5cefa6e47d570c",
              "source_handle": "P0462"
            },
            {
              "contribution": "提供涵盖特定菌属富集、抗生素暴露及FMT效果的定量荟萃分析结果，汇总群体水平的统计关联证据，用于评估当前证据等级及未来标准化需求的核心素材。",
              "paper_id": "d01d7681c26311e53a792fec4a5c6d8c608be0d6",
              "source_handle": "P0470"
            },
            {
              "contribution": "通过人源化小鼠FMT实验确立irAEs发生的微生物因果链，并构建随机森林预测模型，为“安全性信号受宿主免疫背景与菌群特征共同驱动”提供机制与工具支撑。",
              "paper_id": "CorpusId:257062954",
              "source_handle": "P0600"
            },
            {
              "contribution": "对比FMT、益生菌与工程菌的临床转化现状，指出供体筛选标准与给药方案异质性是导致概念验证试验结果分化的主因，界定当前干预策略的适用边界。",
              "paper_id": "ff51b7d7a956ceb17d4fb9e0f36c3446c6a4cf65",
              "source_handle": "P0573"
            },
            {
              "contribution": "提出肠道-代谢物-免疫轴框架，详述特定代谢物（如吲哚类、SCFAs）在减轻irAEs同时维持抗肿瘤活性的潜力，为平衡疗效与毒性提供分子干预思路。",
              "paper_id": "CorpusId:290154100",
              "source_handle": "P0584"
            }
          ]
        },
        "unit_notes": ""
      }
    },
    "Ch2": {
