      "task": {
        "paragraph_id": "Ch7_U03_P02",
        "point": "揭示纵向前瞻性数据的结构性短缺",
        "development": "以正在进行的新辅助治疗研究为例，说明基线多样性与动态变化指标的预测价值仍需前瞻性队列确证。",
        "source_uses": [
          {
            "source_handle": "P0045",
            "role": "主论据",
            "use": "提供正在进行中的研究摘要，主要价值在于其研究设计的描述和可行性报告，而非实证结果。"
          },
          {
            "source_handle": "P0008",
            "role": "主论据",
            "use": "提供儿科肿瘤中微生物组作用的宏观背景和具体临床关联素材，指出许多关联多为观察性结果。"
          },
          {
            "source_handle": "P0030",
            "role": "例证",
            "use": "作为肝癌辅助治疗试验方案，明确短程免疫给药窗口与动态监测节点的设计逻辑，反衬当前缺乏大型 RCT 验证及标准化临床路径的现状。"
          },
          {
            "source_handle": "P0329",
            "role": "局限",
            "use": "展示基于回顾性数据的计算模拟预测结果，强调从算法优化到菌株分离培养的临床转化断层，凸显早期概念验证向 III 期确证试验跨越的障碍。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U03_P02"
        ],
        "source_brief_details": [
