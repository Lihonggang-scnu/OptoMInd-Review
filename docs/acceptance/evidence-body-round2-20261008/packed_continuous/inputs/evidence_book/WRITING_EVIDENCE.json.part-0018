    "atom::43d1d2d99f218db8b718a352": {
      "atom_id": "atom::43d1d2d99f218db8b718a352",
      "source_handle": "P0298",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统综述和荟萃分析方法。文献检索涵盖PubMed, Embase, Web of Science, Scopus。纳入标准为成人NSCLC或黑色素瘤患者，接受ICI治疗，有基线肠道微生物组数据（16S rRNA或宏基因组测序），并报告OS, PFS, ORR或irAEs。数据提取后，对α多样性、特定菌属丰度、抗生素使用等暴露因素进行荟萃分析，使用DerSimonian and Laird随机效应模型合并HR和OR。进行亚组分析（癌症类型、测序方法）。使用NOS评估研究质量，使用GRADE评估证据确定性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::55c9545545f492410ec12503bfe34d4cbcc01227b2086ecc1b38434c184e3df0",
      "multiple_values_in_field": false
    },
    "atom::c4d309ac1cde98d6b8709654": {
      "atom_id": "atom::c4d309ac1cde98d6b8709654",
      "source_handle": "P0298",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于肠道微生物组特征（多样性、特定菌属）与NSCLC和黑色素瘤患者ICI疗效及安全性之间关联的综合定量证据。确认了高多样性、Akkermansia、Faecalibacterium的有益关联以及抗生素使用的有害关联。区分了不同ICI类型（抗CTLA-4 vs. 抗PD-1）在irAEs方面的不同微生物关联。",
        "limits": "纳入的研究均为观察性研究，无法确立因果关系。证据确定性被评定为“中等”，主要因研究设计的观察性质和部分结果的不一致性。由于原始数据不可用，无法进行个体参与者数据（IPD）分析，限制了更精细的混杂因素调整。术语上只能界定为“预后”关联，难以严格区分“预测”价值。对于抗PD-1/PD-L1治疗相关的irAEs，因数据异质性过大，未能进行荟萃分析。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::13d83893d902209f0a444b93551aca7ceaaf016748720f3e07d7472c88f2d920",
      "multiple_values_in_field": false
    },
    "atom::d84296b388152c7979fd950b": {
      "atom_id": "atom::d84296b388152c7979fd950b",
      "source_handle": "P0298",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线高肠道微生物α多样性 vs. 低多样性",
        "finding": "显著改善OS (pooled HR 0.52, 95% CI 0.41–0.66) 和 PFS (pooled HR 0.58, 95% CI 0.47–0.71)。在NSCLC和黑色素瘤亚组中均稳健，且不受测序方法（16S vs. 宏基因组）影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::386150db9ba9c38100003f2a01a8b5db6dedd29c4757e1a63a1917774b16704b",
      "multiple_values_in_field": true
    },
    "atom::cdc81546840364f19d0aba86": {
      "atom_id": "atom::cdc81546840364f19d0aba86",
      "source_handle": "P0298",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
