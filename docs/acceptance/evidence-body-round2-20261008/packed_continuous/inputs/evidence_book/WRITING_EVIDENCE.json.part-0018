    "atom::81a434e6c7c8a99518e1508c": {
      "atom_id": "atom::81a434e6c7c8a99518e1508c",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性综述方法，综合分析了近年来关于NSCLC患者微生物组与ICI反应关联的临床研究、回顾性队列分析以及动物模型实验。重点比较了响应者与无响应者的微生物组成差异，分析了抗生素使用对预后的影响机制，并汇总了正在进行的或已完成的涉及FMT、益生菌、饮食等干预措施的临床试验结果。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::769a855a4ccae40446adf28a44c56ae006c315a0908beaebd2b1561b38a1979b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::909e93d69c5a110886797e4e6a1176ec0d75401b7009eecee9d6127d17db9e26",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::4bcb154bef4705f9c8760abd10bb829eed035dc2d15faa36c80f624dcbcb2ae5",
      "multiple_values_in_field": false
    },
    "atom::f0b377715bad283896abfe1e": {
      "atom_id": "atom::f0b377715bad283896abfe1e",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了NSCLC患者微生物组特征与ICI疗效关联的最新证据汇总，明确了关键的保护性和风险性菌属。",
        "limits": "作为综述，其结论依赖于所引用的原始研究，这些研究多为回顾性或单中心小规模试验，存在地理偏倚（主要来自中国和日本）和方法学异质性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::769a855a4ccae40446adf28a44c56ae006c315a0908beaebd2b1561b38a1979b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::909e93d69c5a110886797e4e6a1176ec0d75401b7009eecee9d6127d17db9e26",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::9eb0e2ee092ab9603a4b3f5860ed3de523f9fdb34ce7719fecb2a31f71be2312",
      "multiple_values_in_field": true
    },
    "atom::ee4d72056c99bec83f9087b8": {
      "atom_id": "atom::ee4d72056c99bec83f9087b8",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "详细阐述了抗生素和PPI对ICI疗效的负面干扰机制，为临床合理用药提供依据。",
        "limits": "对于微生物组调节的具体分子机制（如抗原特异性与非特异性机制的细节）尚未完全阐明，文中指出“大部分机制仍未知”。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
