    "Ch5::Ch5_U03::Ch5_U03_P03": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U03::Ch5_U03_P03",
      "original_task_id": "Ch5_U03_P03",
      "unit_id": "Ch5_U03",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U03_P03",
        "point": "概述 MET4 等定义菌群组合的开发困境与监管挑战。",
        "development": "提及 MET4-IO 试验因招募不足终止，反映复杂菌群组合在临床试验中的实施难度；同时指出单株/定义菌群虽利于质控，但疗效信号多为探索性终点，缺乏 OS/PFS 确证。",
        "source_uses": [
          {
            "source_handle": "P0122",
            "role": "主论据",
            "use": "提供 MET4 诱导宿主全身性体液免疫反应及菌群变化的实证数据"
          },
          {
            "source_handle": "P0387",
            "role": "背景",
            "use": "综述微生物治疗辅助剂（益生菌 vs 菌群组合 vs FMT）的临床结局对比，揭示复杂性与效果的关系"
          },
          {
            "source_handle": "P0261",
            "role": "背景",
            "use": "汇总早期临床试验中定义菌群的探索性信号，强调监管标准化与质控优势及缺乏 OS/PFS 确证数据"
          },
          {
            "source_handle": "P0152",
            "role": "例证",
            "use": "提供天然多糖作为免疫佐剂克服 ICI 耐药的机制见解与临床证据，作为定义菌群之外的干预策略补充"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U03_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U03_P03",
            "unit_id": "Ch5_U03",
            "ordinal": 3,
            "point": "概述 MET4 等定义菌群组合的开发困境与监管挑战。",
            "development": "提及 MET4-IO 试验因招募不足终止，反映复杂菌群组合在临床试验中的实施难度；同时指出单株/定义菌群虽利于质控，但疗效信号多为探索性终点，缺乏 OS/PFS 确证。",
            "source_handles": [
              "P0122",
              "P0387"
