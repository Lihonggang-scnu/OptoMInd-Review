    "atom::b948719cef3c84a90bacafe2": {
      "atom_id": "atom::b948719cef3c84a90bacafe2",
      "source_handle": "P0146",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "Despite the success of immunotherapies like ICIs and ACTs, patient responses vary widely due to primary or acquired resistance and adverse events. This review aims to elucidate the role of the gut microbiota in shaping these outcomes, identify potential biomarkers for predicting response, and explore microbiota-based strategies to enhance efficacy and mitigate toxicity.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::89b8f947d85f7362a3c254e0e002085457319d9cd845107ac15367721f1d4de2",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::448ef91485221af0125a17af9795bdf41378362f8b87201dbb6682a18ed3a95a",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::aab188251adff198144a1cd564959d717dd1ad629bd84c06a984f93b1eec07c5",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::6d12bf2da969a638d25a3b4bd3cc9610b811b943b4c1e29fbd6433452e663bcf",
      "multiple_values_in_field": false
    },
    "atom::0b5c58557176e76454e9789e": {
      "atom_id": "atom::0b5c58557176e76454e9789e",
      "source_handle": "P0146",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the gut microbiota and its influence on cancer immunotherapy, specifically immune checkpoint inhibitors (ICIs) and adoptive cell therapies (ACTs). It covers clinical correlations, preclinical mechanisms, intratumoral microbiota, and intervention strategies across various solid tumors and hematologic malignancies.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::89b8f947d85f7362a3c254e0e002085457319d9cd845107ac15367721f1d4de2",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::448ef91485221af0125a17af9795bdf41378362f8b87201dbb6682a18ed3a95a",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::aab188251adff198144a1cd564959d717dd1ad629bd84c06a984f93b1eec07c5",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::5d2c72f1732621a8f75c7bff8cc0b0537a3b79f571dea1d064e46b7f63deb324",
      "multiple_values_in_field": false
    },
    "atom::00e315febc4d75be2605fe4d": {
      "atom_id": "atom::00e315febc4d75be2605fe4d",
      "source_handle": "P0146",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This paper provides a comprehensive overview of how the gut microbiome modulates the efficacy and toxicity of cancer immunotherapies. It traces the historical evolution from early animal studies to recent clinical trials, detailing specific microbial signatures associated with response or resistance to ICIs and ACTs. The authors synthesize mechanistic insights involving innate and adaptive immune modulation, metabolite production, and tumor microenvironment remodeling. Furthermore, it evaluates therapeutic interventions such as fecal microbiota transplantation (FMT), probiotics, dietary modifications, and engineered bacteria, while highlighting challenges in standardization and clinical translation.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::89b8f947d85f7362a3c254e0e002085457319d9cd845107ac15367721f1d4de2",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::448ef91485221af0125a17af9795bdf41378362f8b87201dbb6682a18ed3a95a",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::aab188251adff198144a1cd564959d717dd1ad629bd84c06a984f93b1eec07c5",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::f441d9e25d88050095dabf62789e2b21c813dddf6c7addc95bb56b8e8b8e4fd0",
      "multiple_values_in_field": false
    },
    "atom::c3a7e35f55a2e6c81a8e07ea": {
      "atom_id": "atom::c3a7e35f55a2e6c81a8e07ea",
      "source_handle": "P0146",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a foundational resource for mapping the relationship between gut microbiome composition and ICI efficacy in solid tumors. It provides specific microbial markers (taxa) associated with response/resistance, details mechanistic pathways (metabolites, immune cell crosstalk), and outlines current intervention strategies (FMT, probiotics, diet). It is particularly useful for identifying candidate biomarkers and understanding the biological plausibility of microbiome-mediated modulation, while also highlighting the methodological challenges and variability that complicate definitive conclusions.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::89b8f947d85f7362a3c254e0e002085457319d9cd845107ac15367721f1d4de2",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::448ef91485221af0125a17af9795bdf41378362f8b87201dbb6682a18ed3a95a",
          "field_path": [
