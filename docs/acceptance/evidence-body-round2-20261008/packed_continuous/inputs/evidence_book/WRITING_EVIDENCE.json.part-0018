    "Ch7::Ch7_U01::Ch7_U01_P03": {
      "chapter_id": "Ch7",
      "local_task_id": "Ch7_U01::Ch7_U01_P03",
      "original_task_id": "Ch7_U01_P03",
      "unit_id": "Ch7_U01",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch7_U01_P03",
        "point": "展示标准化重分析的实证启示",
        "development": "引用统一管道重分析案例，论证控制方法学变量后，无响应相关信号的可重复性显著提升，反驳“微生物信号纯属噪音”的极端观点。",
        "source_uses": [
          {
            "source_handle": "P0354",
            "role": "主论据",
            "use": "提供大规模标准化重分析现有微生物组数据的实证，建立稳健的无响应微生物生物标志物集。"
          },
          {
            "source_handle": "P0264",
            "role": "发展",
            "use": "提供免疫监测中微生物样本采集与测序流程标准化的专家共识建议，直接回应技术变异导致跨队列结论不可复现的方法学挑战。"
          },
          {
            "source_handle": "P0436",
            "role": "例证",
            "use": "通过黏膜黑色素瘤多部位同步采样设计，说明区分全身肠道与局部肿瘤微生物信号的方法学必要性，为标准化空间组学整合提供范例。"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch7_U01_P03"
        ],
