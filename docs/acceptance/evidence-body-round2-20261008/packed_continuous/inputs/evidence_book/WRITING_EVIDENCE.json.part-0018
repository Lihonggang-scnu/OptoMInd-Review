    "atom::492c6800fef6fc47aaf6ee2a": {
      "atom_id": "atom::492c6800fef6fc47aaf6ee2a",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管ICI在NSCLC中取得了显著疗效，但许多患者出现原发或继发耐药及免疫相关不良事件（irAEs）。目前尚缺乏有效的预测生物标志物和克服耐药的策略。本研究旨在阐明微生物组如何影响ICI疗效，并探索基于微生物组的新型治疗途径。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
