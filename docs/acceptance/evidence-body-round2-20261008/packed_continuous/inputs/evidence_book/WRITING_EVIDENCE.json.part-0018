    "Ch5::Ch5_U05::Ch5_U05_P02": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U05::Ch5_U05_P02",
      "original_task_id": "Ch5_U05_P02",
      "unit_id": "Ch5_U05",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U05_P02",
        "point": "剖析影响疗效可重复性的关键变量：供体来源、预处理策略与给药途径的异质性。",
        "development": "比较健康供体与 ICI 响应者供体的优劣争议；指出抗生素预处理（如 SER-401 试验）可能破坏保护性免疫准备；口服胶囊与内镜给药的定植效率差异尚未统一。",
        "source_uses": [
          {
            "source_handle": "P0178",
            "role": "主论据",
            "use": "分析影响干预效果的生态学和药理学因素（如抗生素使用、基线菌群状态）"
          },
          {
            "source_handle": "P0304",
            "role": "主论据",
            "use": "系统评价肠道微生物组改变药物及 FMT 对 ICI 疗效与毒性的影响，指出抗生素负面影响的例外情况"
          },
          {
            "source_handle": "P0546",
            "role": "背景",
            "use": "综述肠道微生物组调节 ICI 的机制，指出临床疗效数据主要来自早期试验，效力证据等级有限"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U05_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U05_P02",
            "unit_id": "Ch5_U05",
            "ordinal": 2,
            "point": "剖析影响疗效可重复性的关键变量：供体来源、预处理策略与给药途径的异质性。",
            "development": "比较健康供体与 ICI 响应者供体的优劣争议；指出抗生素预处理（如 SER-401 试验）可能破坏保护性免疫准备；口服胶囊与内镜给药的定植效率差异尚未统一。",
            "source_handles": [
              "P0178",
              "P0304",
              "P0546"
            ]
          }
        ]
      }
    },
    "Ch5::Ch5_U05::Ch5_U05_P03": {
      "chapter_id": "Ch5",
      "local_task_id": "Ch5_U05::Ch5_U05_P03",
      "original_task_id": "Ch5_U05_P03",
      "unit_id": "Ch5_U05",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch5_U05_P03",
        "point": "提出解决转化瓶颈的方法学路径：纵向监测、功能预测模型与生态药理学框架。",
        "development": "强调单次基线测序不足以捕捉动态演变；建议整合宏基因组功能注释、宿主免疫表型与机器学习构建预测模型；倡导将微生物干预视为\"生态扰动\"而非简单药物添加，需制定统一的报告与安全监测标准。",
        "source_uses": [
          {
            "source_handle": "P0363",
            "role": "主论据",
            "use": "提供 gut microbiome–TME axis 综述，界定当前领域边界及识别研究空白（如缺乏前瞻性验证）"
          },
          {
            "source_handle": "P0329",
            "role": "例证",
            "use": "提供设计性活体生物疗法恢复响应者样微生物组特征的预测模型概念验证"
          },
          {
            "source_handle": "P0357",
            "role": "背景",
            "use": "综述益生菌在癌症免疫治疗中的应用，指出当前证据局限性和未来研究方法学建议"
          },
          {
            "source_handle": "P0273",
            "role": "发展",
            "use": "批判性评估当前领域缺乏前瞻性验证与技术标准化的现状，呼吁开展大型多中心队列研究与随机干预试验"
          },
          {
            "source_handle": "P0303",
            "role": "发展",
            "use": "指出测序平台、样本采集时间点及地理饮食混杂因素导致的结果异质性，提出整合宏基因组功能注释与宿主免疫表型的纵向监测协议"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch5_U05_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch5_U05_P03",
            "unit_id": "Ch5_U05",
            "ordinal": 3,
            "point": "提出解决转化瓶颈的方法学路径：纵向监测、功能预测模型与生态药理学框架。",
            "development": "强调单次基线测序不足以捕捉动态演变；建议整合宏基因组功能注释、宿主免疫表型与机器学习构建预测模型；倡导将微生物干预视为\"生态扰动\"而非简单药物添加，需制定统一的报告与安全监测标准。",
            "source_handles": [
              "P0363",
              "P0329",
              "P0357"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U1::Ch6_U1_P01": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U1::Ch6_U1_P01",
      "original_task_id": "Ch6_U1_P01",
      "unit_id": "Ch6_U1",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U1_P01",
        "point": "结肠炎型 irAEs 的微生物指纹与整体多样性下降",
        "development": "比较结肠炎型与非结肠炎型 irAE 患者的粪便宏基因组/16S 特征，指出主要产丁酸菌丰度降低、拟杆菌门/双歧杆菌减少及肠球菌富集是结肠炎的核心表型。P0017 通过抗生素预处理小鼠 FMT 实验验证其因果致病潜力：接受结肠炎型患者菌群移植的小鼠出现致命性严重结肠炎（3/9 死亡），而非结肠炎型菌群移植小鼠全部存活。",
        "source_uses": [
          {
            "source_handle": "P0017",
            "role": "主论据",
            "use": "提供结肠炎型患者菌群移植小鼠出现致命性严重结肠炎的因果证据"
          },
          {
            "source_handle": "P0600",
            "role": "比较",
            "use": "提供肺癌及多癌种队列中结肠炎与非结肠炎 irAEs 的微生物指纹差异，并通过人源化小鼠 FMT 实验确立菌群致结肠炎的因果性"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U1_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U1_P01",
            "unit_id": "Ch6_U1",
            "ordinal": 1,
            "point": "结肠炎型 irAEs 的微生物指纹与整体多样性下降",
            "development": "比较结肠炎型与非结肠炎型 irAE 患者的粪便宏基因组/16S 特征，指出主要产丁酸菌丰度降低、拟杆菌门/双歧杆菌减少及肠球菌富集是结肠炎的核心表型。P0017 通过抗生素预处理小鼠 FMT 实验验证其因果致病潜力：接受结肠炎型患者菌群移植的小鼠出现致命性严重结肠炎（3/9 死亡），而非结肠炎型菌群移植小鼠全部存活。",
            "source_handles": [
              "P0017"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U1::Ch6_U1_P02": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U1::Ch6_U1_P02",
      "original_task_id": "Ch6_U1_P02",
      "unit_id": "Ch6_U1",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U1_P02",
        "point": "胃肠道癌症的保护性菌群与器官特异性毒性差异",
        "development": "聚焦食管癌、胃癌、结直肠癌队列（P0011，n=95），指出 Ruminococcus callidus 和 Bacteroides xylanisolvens 在无重症 irAEs 患者中显著富集，且尿素循环/精氨酸生物合成通路与低毒性相关。同时强调皮肤、血液、内分泌及肝脏毒性各自呈现独立的微生物通路特征，反驳单一通用标志物假设。但需注意该研究样本量有限且缺乏外部验证。",
        "source_uses": [
          {
            "source_handle": "P0011",
            "role": "主论据",
            "use": "提供胃肠道癌症队列中 Ruminococcus callidus 和 Bacteroides xylanisolvens 富集与低毒性相关的实证数据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U1_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U1_P02",
            "unit_id": "Ch6_U1",
            "ordinal": 2,
            "point": "胃肠道癌症的保护性菌群与器官特异性毒性差异",
            "development": "聚焦食管癌、胃癌、结直肠癌队列（P0011，n=95），指出 Ruminococcus callidus 和 Bacteroides xylanisolvens 在无重症 irAEs 患者中显著富集，且尿素循环/精氨酸生物合成通路与低毒性相关。同时强调皮肤、血液、内分泌及肝脏毒性各自呈现独立的微生物通路特征，反驳单一通用标志物假设。但需注意该研究样本量有限且缺乏外部验证。",
            "source_handles": [
              "P0011"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U1::Ch6_U1_P03": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U1::Ch6_U1_P03",
      "original_task_id": "Ch6_U1_P03",
      "unit_id": "Ch6_U1",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U1_P03",
        "point": "预测模型的构建困境与非结肠炎 irAEs 证据不足",
        "development": "评估基于机器学习（如 RF14 分类器，P0308）的 irAEs 预测模型性能，指出尽管 AUC 可达 0.88，但在多重检验校正后部分特征显著性不足。P0312 综述指出，即使在大样本队列中，非结肠炎 irAEs（如心肌炎、神经毒性）的样本量仍不足以支持独立的微生物组分析，当前证据主要集中于结肠炎。不同研究间测序平台、CTCAE 分级版本及队列异质性导致模型泛化能力受限。",
        "source_uses": [
          {
            "source_handle": "P0308",
            "role": "主论据",
            "use": "提供 RF14 分类器性能数据及多重检验校正后特征显著性不足的证据"
          },
          {
            "source_handle": "P0312",
            "role": "背景",
            "use": "综述指出非结肠炎 irAEs 样本量不足以支持独立微生物组分析的限制"
          },
          {
            "source_handle": "P0049",
            "role": "局限",
            "use": "揭示 F. prausnitzii 等标志物在多重检验下的不一致性及大样本队列中非结肠炎亚组样本量极小（n=2）的现状"
          },
          {
            "source_handle": "P0605",
            "role": "局限",
            "use": "量化心肌炎/脑膜炎等亚组样本量极小，直接支撑预测模型构建困境及非结肠炎毒性证据不足的论述"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U1_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U1_P03",
            "unit_id": "Ch6_U1",
            "ordinal": 3,
            "point": "预测模型的构建困境与非结肠炎 irAEs 证据不足",
            "development": "评估基于机器学习（如 RF14 分类器，P0308）的 irAEs 预测模型性能，指出尽管 AUC 可达 0.88，但在多重检验校正后部分特征显著性不足。P0312 综述指出，即使在大样本队列中，非结肠炎 irAEs（如心肌炎、神经毒性）的样本量仍不足以支持独立的微生物组分析，当前证据主要集中于结肠炎。不同研究间测序平台、CTCAE 分级版本及队列异质性导致模型泛化能力受限。",
            "source_handles": [
              "P0308",
              "P0312"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U2::Ch6_U2_P01": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U2::Ch6_U2_P01",
      "original_task_id": "Ch6_U2_P01",
      "unit_id": "Ch6_U2",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U2_P01",
        "point": "共享免疫激活通路的\"双刃剑\"效应",
        "development": "指出高丰度 Akkermansia muciniphila 在 NSCLC 队列中与延长 OS 正相关，但同时增加 irAEs 风险（P0260），提示微生物介导的 CD8+ T 细胞活化与 IFN-γ分泌是疗效提升与自身免疫毒性共有的上游驱动力。这种关联是观察性的，不能推断因果。",
        "source_uses": [
          {
            "source_handle": "P0260",
            "role": "主论据",
            "use": "提供 Akkermansia muciniphila 与 OS 正相关但增加 irAEs 风险的观察性关联证据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U2_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U2_P01",
            "unit_id": "Ch6_U2",
            "ordinal": 1,
            "point": "共享免疫激活通路的\"双刃剑\"效应",
            "development": "指出高丰度 Akkermansia muciniphila 在 NSCLC 队列中与延长 OS 正相关，但同时增加 irAEs 风险（P0260），提示微生物介导的 CD8+ T 细胞活化与 IFN-γ分泌是疗效提升与自身免疫毒性共有的上游驱动力。这种关联是观察性的，不能推断因果。",
            "source_handles": [
              "P0260"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U2::Ch6_U2_P02": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U2::Ch6_U2_P02",
      "original_task_id": "Ch6_U2_P02",
      "unit_id": "Ch6_U2",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U2_P02",
        "point": "解耦路径：特定菌属与无毒性响应的共存",
        "development": "对比黑色素瘤纵向队列数据（P0239），发现 Eubacterium siraeum 高丰度与无 irAEs 的客观缓解状态显著相关，且短链脂肪酸产生菌（如 Coprococcus comes, Blautia glucerasea）在未发生 irAEs 的患者中同样富集（P0428），挑战\"毒性必然预示疗效\"的直觉假设。但需注意这些发现主要来自回顾性分析。",
        "source_uses": [
          {
            "source_handle": "P0239",
            "role": "主论据",
            "use": "提供 Eubacterium siraeum 高丰度与无 irAEs 的客观缓解状态显著相关的纵向队列数据"
          },
          {
            "source_handle": "P0428",
            "role": "例证",
            "use": "证实 SCFA 产生菌在无 irAEs 响应者中显著富集，为解耦疗效与毒性提供直接的表型证据"
          },
          {
            "source_handle": "P0314",
            "role": "例证",
            "use": "识别 Blautia luti 等 Lachnospiraceae 成员与“有效且无 irAE\"状态的独立关联，补充代谢功能菌群线索"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U2_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U2_P02",
            "unit_id": "Ch6_U2",
            "ordinal": 2,
            "point": "解耦路径：特定菌属与无毒性响应的共存",
            "development": "对比黑色素瘤纵向队列数据（P0239），发现 Eubacterium siraeum 高丰度与无 irAEs 的客观缓解状态显著相关，且短链脂肪酸产生菌（如 Coprococcus comes, Blautia glucerasea）在未发生 irAEs 的患者中同样富集（P0428），挑战\"毒性必然预示疗效\"的直觉假设。但需注意这些发现主要来自回顾性分析。",
            "source_handles": [
              "P0239",
              "P0428"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U2::Ch6_U2_P03": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U2::Ch6_U2_P03",
      "original_task_id": "Ch6_U2_P03",
      "unit_id": "Ch6_U2",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U2_P03",
        "point": "基线免疫稳态与纵向动态变化的中介作用",
        "development": "整合黑色素瘤配对粪便与外周血 PBMC 纵向数据（P0098，n=126），显示基线拟杆菌属（Bacteroides）高丰度与治疗后 Tregs 频率显著下降相关，且 Tregs 耗竭程度直接预测严重 irAEs 的发生；相反，瘤胃球菌科（Ruminococcaceae）主导的基线状态则与更好的治疗响应及较低的毒性风险同步出现。",
        "source_uses": [
          {
            "source_handle": "P0098",
            "role": "主论据",
            "use": "提供基线拟杆菌属高丰度与 Tregs 频率下降及严重 irAEs 相关的纵向免疫细胞动态数据"
          },
          {
            "source_handle": "P0049",
            "role": "发展",
            "use": "揭示基线病原共生菌富集与治疗早期产丁酸菌耗竭的时序特征，为免疫稳态失衡提供临床动态证据"
          },
          {
            "source_handle": "P0605",
            "role": "发展",
            "use": "通过纵向宏基因组数据证实 Ruminococcaceae 动态耗竭与严重 irAEs 关联，补充免疫稳态失衡的微生物组证据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U2_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U2_P03",
            "unit_id": "Ch6_U2",
            "ordinal": 3,
            "point": "基线免疫稳态与纵向动态变化的中介作用",
            "development": "整合黑色素瘤配对粪便与外周血 PBMC 纵向数据（P0098，n=126），显示基线拟杆菌属（Bacteroides）高丰度与治疗后 Tregs 频率显著下降相关，且 Tregs 耗竭程度直接预测严重 irAEs 的发生；相反，瘤胃球菌科（Ruminococcaceae）主导的基线状态则与更好的治疗响应及较低的毒性风险同步出现。",
            "source_handles": [
              "P0098"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U3::Ch6_U3_P01": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U3::Ch6_U3_P01",
      "original_task_id": "Ch6_U3_P01",
      "unit_id": "Ch6_U3",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U3_P01",
        "point": "FMT-LUMINate 试验的疗效分化与毒性起病时间提前",
        "development": "报告 NSCLC 队列（抗 PD-1 单药，n=20）ORR 达 80% 且无≥3 级 AEs；而黑色素瘤队列（抗 PD-1+ 抗 CTLA-4 双免，n=20）ORR 为 75%，但 65% 患者经历≥3 级 AEs，其中腹泻/结肠炎占 20%，心肌炎发生率高达 15%（文献报道通常<1%），且严重毒性中位起病时间提前至 40 天（P0583）。需明确这是 Phase II 单臂试验，非 Phase III RCT。",
        "source_uses": [
          {
            "source_handle": "P0583",
            "role": "主论据",
            "use": "报告 FMT-LUMINate 试验中双免背景下 ORR 75% 但 65% 患者经历≥3 级 AEs 及心肌炎发生率高达 15% 的数据"
          },
          {
            "source_handle": "P0578",
            "role": "比较",
            "use": "提供 MITRIC 试验在难治人群中 ORR 0% 的结果，对比显示干预效果在初治与难治人群中的异质性"
          },
          {
            "source_handle": "P0212",
            "role": "背景",
            "use": "荟萃分析量化 FMT 联合 ICI 的总体 ORR 及 3-4 级 AE 发生率，为安全性边界提供定量基准"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U3_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U3_P01",
            "unit_id": "Ch6_U3",
            "ordinal": 1,
            "point": "FMT-LUMINate 试验的疗效分化与毒性起病时间提前",
            "development": "报告 NSCLC 队列（抗 PD-1 单药，n=20）ORR 达 80% 且无≥3 级 AEs；而黑色素瘤队列（抗 PD-1+ 抗 CTLA-4 双免，n=20）ORR 为 75%，但 65% 患者经历≥3 级 AEs，其中腹泻/结肠炎占 20%，心肌炎发生率高达 15%（文献报道通常<1%），且严重毒性中位起病时间提前至 40 天（P0583）。需明确这是 Phase II 单臂试验，非 Phase III RCT。",
            "source_handles": [
              "P0583"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U3::Ch6_U3_P02": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U3::Ch6_U3_P02",
      "original_task_id": "Ch6_U3_P02",
      "unit_id": "Ch6_U3",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U3_P02",
        "point": "供体微生物组聚类与特定毒性事件的因果关联",
        "development": "基于 Bray-Curtis 指数无监督聚类将健康供体分为 Cluster A 与 Cluster B（含供体 5、11）。Cluster B 以 Segatella copri、Prevotella sp. Marseille-P4119 等高丰度为特征。接受 Cluster B 供体 FMT 的黑色素瘤患者中，这些菌属显著富集并与≥3 级 AEs 强相关；进一步流式分析显示 S. copri 定植与外周血 CD4+ T 细胞亚群比例增加相关，且该毒性仅在双 ICI 背景下显现，单药抗 PD-1 治疗中未观察到类似风险（P0583）。但 Prevotella 诱导心肌炎的具体分子机制（抗原或代谢物）尚未解析。",
        "source_uses": [
          {
            "source_handle": "P0583",
            "role": "主论据",
            "use": "提供供体无监督聚类结果及 Cluster B（Prevotella 富集）与≥3 级 AEs 强相关的因果关联证据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U3_P02"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U3_P02",
            "unit_id": "Ch6_U3",
            "ordinal": 2,
            "point": "供体微生物组聚类与特定毒性事件的因果关联",
            "development": "基于 Bray-Curtis 指数无监督聚类将健康供体分为 Cluster A 与 Cluster B（含供体 5、11）。Cluster B 以 Segatella copri、Prevotella sp. Marseille-P4119 等高丰度为特征。接受 Cluster B 供体 FMT 的黑色素瘤患者中，这些菌属显著富集并与≥3 级 AEs 强相关；进一步流式分析显示 S. copri 定植与外周血 CD4+ T 细胞亚群比例增加相关，且该毒性仅在双 ICI 背景下显现，单药抗 PD-1 治疗中未观察到类似风险（P0583）。但 Prevotella 诱导心肌炎的具体分子机制（抗原或代谢物）尚未解析。",
            "source_handles": [
              "P0583"
            ]
          }
        ]
      }
    },
    "Ch6::Ch6_U3::Ch6_U3_P03": {
      "chapter_id": "Ch6",
      "local_task_id": "Ch6_U3::Ch6_U3_P03",
      "original_task_id": "Ch6_U3_P03",
      "unit_id": "Ch6_U3",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "Ch6_U3_P03",
        "point": "益生菌的双向调节与伴随用药的干扰效应",
        "development": "指出特定共生菌（如 LGG）可通过释放脂磷壁酸激活巨噬细胞保护肠上皮，但在免疫抑制状态下存在机会性感染风险（P0040）；同时汇总药物警戒数据，显示 PPI 联用可能增加肝胆及皮肤毒性报告率（P0088），而近期广谱抗生素暴露不仅削弱疗效，还独立增加严重结肠炎风险（P0310）。",
        "source_uses": [
          {
            "source_handle": "P0040",
            "role": "主论据",
            "use": "指出 LGG 激活巨噬细胞保护肠上皮但在免疫抑制状态下存在机会性感染风险"
          },
          {
            "source_handle": "P0088",
            "role": "例证",
            "use": "汇总药物警戒数据，显示 PPI 联用可能增加肝胆及皮肤毒性报告率"
          },
          {
            "source_handle": "P0310",
            "role": "例证",
            "use": "显示近期广谱抗生素暴露独立增加严重结肠炎风险"
          },
          {
            "source_handle": "P0357",
            "role": "发展",
            "use": "系统梳理益生菌菌株特异性效应及商业制剂异质性，阐明其在调节 irAEs 中的双向作用及定植挑战"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "Ch6_U3_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "Ch6_U3_P03",
            "unit_id": "Ch6_U3",
            "ordinal": 3,
            "point": "益生菌的双向调节与伴随用药的干扰效应",
            "development": "指出特定共生菌（如 LGG）可通过释放脂磷壁酸激活巨噬细胞保护肠上皮，但在免疫抑制状态下存在机会性感染风险（P0040）；同时汇总药物警戒数据，显示 PPI 联用可能增加肝胆及皮肤毒性报告率（P0088），而近期广谱抗生素暴露不仅削弱疗效，还独立增加严重结肠炎风险（P0310）。",
            "source_handles": [
