      "original_task_id": "U3_3_P01",
      "unit_id": "U3_3",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_3_P01",
        "point": "阐述次级胆汁酸（TDCA, UDCA 等）通过 TGR5/FXR 受体增强 CD8+ T 细胞杀伤与巨噬细胞 M1 极化的机制。",
        "development": "整合 P0481 与 P0424 的证据，说明胆汁酸如何克服抗生素介导的菌群耗竭，并在 HCC 患者中转化为可测量的预后标志物。",
        "source_uses": [
          {
            "source_handle": "P0481",
            "role": "主论据",
            "use": "证实牛磺脱氧胆酸经 TGR5 受体直接增强 CD8+ T 细胞毒性，并在菌群失调模型中恢复 ICI 疗效"
          },
          {
            "source_handle": "P0424",
            "role": "主论据",
            "use": "提供不可切除肝细胞癌队列中次级胆汁酸丰度与更长 PFS 的正向关联"
          },
          {
            "source_handle": "P0186",
            "role": "背景",
            "use": "基于毛螺菌科比较基因组学预测胆汁酸转化基因簇，为核受体配体生成提供菌株特异性功能线索"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_3_P01"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_3_P01",
            "unit_id": "U3_3",
            "ordinal": 1,
            "point": "阐述次级胆汁酸（TDCA, UDCA 等）通过 TGR5/FXR 受体增强 CD8+ T 细胞杀伤与巨噬细胞 M1 极化的机制。",
            "development": "整合 P0481 与 P0424 的证据，说明胆汁酸如何克服抗生素介导的菌群耗竭，并在 HCC 患者中转化为可测量的预后标志物。",
