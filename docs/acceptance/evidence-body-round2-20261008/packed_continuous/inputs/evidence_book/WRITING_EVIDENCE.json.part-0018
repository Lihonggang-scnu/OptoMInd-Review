    "Ch3::U3_1::U3_1_P04": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_1::U3_1_P04",
      "original_task_id": "U3_1_P04",
      "unit_id": "U3_1",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_1_P04",
        "point": "分析微环境缺氧状态与代谢物浓度阈值对 SCFAs 效应方向的决定性影响。",
        "development": "利用 P0377 与 P0544 的机制发现，指出在葡萄糖剥夺或严重缺氧条件下，SCFAs 可能被肿瘤细胞逆向摄取作为碳源，从而逆转其预期的抑癌效果。",
        "source_uses": [
          {
            "source_handle": "P0377",
            "role": "主论据",
            "use": "展示缺氧微环境中癌细胞逆向摄取丁酸供能的反常现象"
          },
          {
            "source_handle": "P0544",
            "role": "背景",
            "use": "提供 CRC 中调节微生物群增强 ICI 疗效的机制视角"
          },
          {
            "source_handle": "P0220",
            "role": "发展",
            "use": "梳理 SCFA 在不同浓度与癌种下的矛盾功能，为解释情境依赖性提供理论框架"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_1_P04"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_1_P04",
            "unit_id": "U3_1",
            "ordinal": 4,
            "point": "分析微环境缺氧状态与代谢物浓度阈值对 SCFAs 效应方向的决定性影响。",
            "development": "利用 P0377 与 P0544 的机制发现，指出在葡萄糖剥夺或严重缺氧条件下，SCFAs 可能被肿瘤细胞逆向摄取作为碳源，从而逆转其预期的抑癌效果。",
            "source_handles": [
              "P0377",
              "P0544"
            ]
          }
        ]
      }
    },
    "Ch3::U3_2::U3_2_P01": {
