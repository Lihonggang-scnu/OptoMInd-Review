    "atom::c769007484209b19fef83328": {
      "atom_id": "atom::c769007484209b19fef83328",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受抗PD-1/PD-L1治疗的NSCLC患者",
        "finding": "特定细菌丰度与疗效相关：A. muciniphila、Ruminococcus、Faecalibacterium、Blautia等通常与良好预后相关；而Parabacteroides、Fusobacterium、Hungatella等则与耐药相关。值得注意的是，A. muciniphila丰度过高（超过第77百分位）可能与较短的总生存期相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
