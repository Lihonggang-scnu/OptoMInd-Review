    "Ch3::U3_2::U3_2_P03": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_2::U3_2_P03",
      "original_task_id": "U3_2_P03",
      "unit_id": "U3_2",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_2_P03",
        "point": "区分肌苷的肿瘤内在作用（UBA6 抑制）与 T 细胞外在作用（A2AR 激活/碳源补充）。",
        "development": "结合 P0124 与 P0584，对比肌苷在肿瘤细胞内直接抑制 UBA6 与在 T 细胞内通过 A2AR/cAMP 通路或替代糖酵解途径发挥作用的平行机制，避免机制混淆。",
        "source_uses": [
          {
            "source_handle": "P0124",
            "role": "主论据",
            "use": "阐释双歧杆菌来源肌苷经 A2AR/cAMP 通路促进 Th1 分化及作为替代碳源维持效应 T 细胞存活"
          },
          {
            "source_handle": "P0251",
            "role": "比较",
            "use": "对比生态与还原论方法，明确双歧杆菌通过肌苷-A2AR 轴增强 T 细胞活性的分子路径"
          },
          {
            "source_handle": "P0584",
            "role": "背景",
            "use": "提供腺苷脱氨酶将免疫抑制性腺苷转化为肌苷的药代动力学数据"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_2_P03"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_2_P03",
            "unit_id": "U3_2",
            "ordinal": 3,
            "point": "区分肌苷的肿瘤内在作用（UBA6 抑制）与 T 细胞外在作用（A2AR 激活/碳源补充）。",
            "development": "结合 P0124 与 P0584，对比肌苷在肿瘤细胞内直接抑制 UBA6 与在 T 细胞内通过 A2AR/cAMP 通路或替代糖酵解途径发挥作用的平行机制，避免机制混淆。",
            "source_handles": [
              "P0124",
              "P0251",
              "P0584"
            ]
          }
        ]
      }
    },
    "Ch3::U3_2::U3_2_P04": {
      "chapter_id": "Ch3",
      "local_task_id": "U3_2::U3_2_P04",
      "original_task_id": "U3_2_P04",
      "unit_id": "U3_2",
      "kind": "paragraph",
      "task": {
        "paragraph_id": "U3_2_P04",
        "point": "明确标注人体 TME 内肌苷绝对浓度数据的缺失现状及药代动力学挑战。",
        "development": "综合 P0582 与 P0584 的讨论，指出腺苷快速降解（~10 秒）与肌苷较长半衰期（~15 小时）导致的测量窗口限制，以及缺乏原位微透析或空间代谢组学数据的现状，强调这是限制机制确证的关键缺口。",
        "source_uses": [
          {
            "source_handle": "P0582",
            "role": "局限",
            "use": "明确指出因样本完整性问题未能在人体肿瘤队列中直接检测肌苷浓度"
          },
          {
            "source_handle": "P0584",
            "role": "局限",
            "use": "指出体外有效浓度属人工设定而非内源性实测值，体内浓度受血流灌注与降解酶多重制约"
          }
        ],
        "carried_over": true,
        "point_changed_from_brief": false,
        "source_briefs": [
          "U3_2_P04"
        ],
        "source_brief_details": [
          {
            "paragraph_id": "U3_2_P04",
            "unit_id": "U3_2",
            "ordinal": 4,
            "point": "明确标注人体 TME 内肌苷绝对浓度数据的缺失现状及药代动力学挑战。",
            "development": "综合 P0582 与 P0584 的讨论，指出腺苷快速降解（~10 秒）与肌苷较长半衰期（~15 小时）导致的测量窗口限制，以及缺乏原位微透析或空间代谢组学数据的现状，强调这是限制机制确证的关键缺口。",
            "source_handles": [
              "P0582",
              "P0584"
            ]
          }
        ]
      }
    },
    "Ch3::U3_3::U3_3_P01": {
      "chapter_id": "Ch3",
