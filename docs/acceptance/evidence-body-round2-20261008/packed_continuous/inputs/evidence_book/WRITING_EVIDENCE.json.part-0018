    "atom::1d5e3fc0fe0da2736280b832": {
      "atom_id": "atom::1d5e3fc0fe0da2736280b832",
      "source_handle": "P0096",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI治疗前近期使用抗生素（特别是β-内酰胺酶抑制剂、氟喹诺酮类）",
        "finding": "抗生素使用导致肠道菌群失调，显著缩短NSCLC患者的中位总生存期（OS）和无进展生存期（PFS），且这种负面影响在ICI治疗前30天内最为明显。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9577f4b99b0d1e6b2a5a3adc086d4a1134bbaccb95c2ed9dfc05e5af2dd0837c",
          "field_path": [
