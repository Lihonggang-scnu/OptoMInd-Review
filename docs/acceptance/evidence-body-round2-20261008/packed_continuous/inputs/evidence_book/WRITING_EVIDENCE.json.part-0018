            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0ae7a2ce7e591525b4e4371de63f51471a9389ea67438dfadcfbdde2c16c835a",
      "multiple_values_in_field": true
    },
    "atom::19a8e7d15677ffe195b38d93": {
