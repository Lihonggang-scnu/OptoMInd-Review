          ]
        },
        {
          "record_id": "record::d1590c0e09f64bdeb0f7b69bc925181bb5bf6cf12262b59e2e52cbc9f99d8e7c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::251f2b19ce9221d4e524f7cb4313c6e964abc70cd918712d6b3ba25d43a99a70",
      "multiple_values_in_field": true
    },
    "atom::77f7f442b2ee33b41d52bb77": {
      "atom_id": "atom::77f7f442b2ee33b41d52bb77",
      "source_handle": "P0573",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "In non-responders or specific trials (e.g., NCT03817125 with SER-401)",
        "finding": "FMT or defined bacterial formulations may fail to improve or even worsen outcomes, potentially due to the expansion of immunosuppressive cells, activation of resistance pathways, or introduction of harmful metabolites/bacteria."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
