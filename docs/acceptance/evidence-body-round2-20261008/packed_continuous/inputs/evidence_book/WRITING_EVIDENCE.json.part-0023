    "atom::b8e04f6cbd2d5473dc58d3c7": {
      "atom_id": "atom::b8e04f6cbd2d5473dc58d3c7",
      "source_handle": "P0028",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节来自小鼠模型（如MC38, AOM/DSS），在人体内的适用性存在不确定性；部分机制（如AhR）涉及复杂的转录调控，需结合其他研究验证其在人类患者中的普遍性。",
        "contribution": "详细阐述了介导微生物-IICI互作的分子机制。包括：1) Fn通过抑制cGAS-IFN-β通路减少CD8+ T细胞浸润；2) NaB通过HDAC抑制调节Treg/Th17平衡；3) IDO1-Kyn-AhR轴调节T细胞分化；4) 工程菌分泌细胞因子（IL-15, FLT3L）直接激活免疫细胞。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e27d1d80c8c6c9f4ae73314bd22ff0935a8d3123315c96a88d1ffa23e65098de",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::2fa45b6fa7124eda36df1743210ebbbb9849de0b4a952a370a50a6d6a4ae9fa7",
      "multiple_values_in_field": true
    },
