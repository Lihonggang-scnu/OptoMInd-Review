          "field_path": [
            "supplement_materials"
          ]
        }
      ],
      "variant_group": "field::925ca6608ae52fc6ca5430fc7ef2eb3e2a8783c71c65d6bd631ec1f615eab10a",
      "multiple_values_in_field": false
    },
