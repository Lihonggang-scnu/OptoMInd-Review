    },
    "atom::c024714554d6bd9bfa71d6cf": {
      "atom_id": "atom::c024714554d6bd9bfa71d6cf",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "详细描述了微生物疗法在临床试验中面临的监管难题（难以标准化复现的产品）、患者招募困难以及抗生素预处理带来的潜在危害（如SER-401试验中的负面结果）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
