    "atom::9cd4b7884f4f52223ba2f677": {
      "atom_id": "atom::9cd4b7884f4f52223ba2f677",
      "source_handle": "P0114",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "“非响应者”背景下的实验结果可能受供体粪便复杂成分的影响，需区分是菌株本身的作用还是菌群整体重塑的结果。",
