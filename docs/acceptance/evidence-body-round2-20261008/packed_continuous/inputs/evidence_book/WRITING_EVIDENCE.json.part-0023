    "atom::d68a0a45b28262f047176315": {
      "atom_id": "atom::d68a0a45b28262f047176315",
      "source_handle": "P0260",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The paper's primary focus is on *adverse events* (irAEs), not efficacy. Any claims about efficacy modulation are secondary mentions or part of the discussion on shared mechanisms/toxicity risks.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dad3b7f35d836145e9d038518b7bba2ecdb12e93da3eb3dcfc5256f4d871718b",
          "field_path": [
