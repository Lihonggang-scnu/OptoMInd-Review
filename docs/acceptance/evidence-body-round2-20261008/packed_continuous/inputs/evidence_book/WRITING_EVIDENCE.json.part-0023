    "atom::1e6a32e501a7d8c22219430c": {
      "atom_id": "atom::1e6a32e501a7d8c22219430c",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "为综述提供基础背景，解释为何需要研究微生物与ICI的相互作用，以及当前的临床痛点（即大部分患者无响应）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
