            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::bb0ce434bcf83cde29f4228ea76a9912fa3476466123da8c8c96455b180f571c",
      "multiple_values_in_field": true
    },
    "atom::4a43c8c569fda1a67abdda11": {
      "atom_id": "atom::4a43c8c569fda1a67abdda11",
      "source_handle": "P0144",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节主要基于动物模型或体外研究，在人体内的确切效力和剂量依赖性尚需验证；部分代谢物（如肌苷）的作用具有情境依赖性。",
        "contribution": "详细阐述了微生物群调节抗肿瘤免疫的具体分子和细胞机制。包括：1) 代谢物（SCFAs, Inosine, Tryptophan derivatives）对T细胞功能的重编程；2) PRR信号通路（TLR/NOD）对DC成熟和抗原呈递的增强；3) 肠-肺轴介导的远端器官免疫调节。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::178b52a66c197f4a779bdd77938708ef26a8fa680b8b03abc8cc07ab57251e1f",
      "multiple_values_in_field": true
    },
