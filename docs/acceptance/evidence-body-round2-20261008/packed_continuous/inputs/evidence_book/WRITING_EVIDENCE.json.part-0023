        {
          "record_id": "record::a28036d77e210b3d249c89e237585e5ef08b69310c0a73b3496c2cab0c87ade4",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::509a9f4ddd885fd9ae5711d829488b0795547f532ff79d447832f39d233e1569",
      "multiple_values_in_field": true
    },
    "atom::45538ddfc2fb94b27b1abfa3": {
      "atom_id": "atom::45538ddfc2fb94b27b1abfa3",
      "source_handle": "P0260",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The link between gut microbiota and efficacy is described as correlational (e.g., abundance levels associated with survival) rather than definitively causal or mechanistically fully elucidated in this text.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dad3b7f35d836145e9d038518b7bba2ecdb12e93da3eb3dcfc5256f4d871718b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        },
        {
          "record_id": "record::a28036d77e210b3d249c89e237585e5ef08b69310c0a73b3496c2cab0c87ade4",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::509a9f4ddd885fd9ae5711d829488b0795547f532ff79d447832f39d233e1569",
      "multiple_values_in_field": true
    },
    "atom::7fb4e1dd9b8b2e79cb3e9d81": {
      "atom_id": "atom::7fb4e1dd9b8b2e79cb3e9d81",
      "source_handle": "P0260",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Specific microbial species mentioned (e.g., Akkermansia) are linked to outcomes in specific contexts (NSCLC), and results may not be generalizable to all solid tumors or all ICI types without further verification.",
      "role": "evidence",
      "origins": [
        {
