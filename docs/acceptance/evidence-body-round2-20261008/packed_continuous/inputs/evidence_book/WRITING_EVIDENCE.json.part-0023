    "atom::cf74ca178c3b440b7a73380d": {
      "atom_id": "atom::cf74ca178c3b440b7a73380d",
      "source_handle": "P0028",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要基于CRC背景，其他实体瘤的数据较少；多为观察性关联或小样本研究，因果链条需结合其他实证研究确认。",
        "contribution": "提供了微生物组影响ICI疗效的具体临床关联和现象描述。指出高丰度的Fn与抗PD-1耐药相关，而B. fragilis和多糖类物质可增强免疫治疗响应。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e27d1d80c8c6c9f4ae73314bd22ff0935a8d3123315c96a88d1ffa23e65098de",
          "field_path": [
