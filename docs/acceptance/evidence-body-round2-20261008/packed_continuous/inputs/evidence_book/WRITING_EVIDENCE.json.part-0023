          ]
        }
      ],
      "variant_group": "field::b8ecb26b5fcb95615f26a35446df1e0e3ac899448ab7532598de306174803f29",
      "multiple_values_in_field": true
    },
    "atom::f62b887d1b251fb36e63bda9": {
      "atom_id": "atom::f62b887d1b251fb36e63bda9",
      "source_handle": "P0600",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "结肠炎型irAE患者 vs 非结肠炎型irAE患者",
        "finding": "微生物组成显著不同（P=0.003）。结肠炎型患者中拟杆菌属（Bacteroides）和双歧杆菌丰度较低，肠球菌属（Enterococcus）丰度较高。主要丁酸产生菌丰度也较低（P=0.018）。"
      },
      "role": "evidence",
      "origins": [
