    "atom::307ba8b829e2c5c2fed7647d": {
      "atom_id": "atom::307ba8b829e2c5c2fed7647d",
      "source_handle": "P0573",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the integration of fecal microbiota transplantation (FMT) with immune checkpoint inhibitors (ICIs) for cancer treatment. It covers clinical evidence from various solid tumors (melanoma, colorectal cancer, etc.), preclinical mechanistic studies, and optimization strategies for FMT protocols.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::b8f4ede79d64928928c3569c7f920cea77ba135b6eb8184f6ac26c844bb27ccc",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::d1590c0e09f64bdeb0f7b69bc925181bb5bf6cf12262b59e2e52cbc9f99d8e7c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::2c39a6a15916755c36c51af530a64aedc2d3963b0776d0345e52be90ea0fa7eb",
      "multiple_values_in_field": false
    },
    "atom::1bdd4c29ead36b61ef77d66e": {
      "atom_id": "atom::1bdd4c29ead36b61ef77d66e",
      "source_handle": "P0573",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This is a comprehensive narrative review that critically examines the controversial effects of combining FMT with ICIs. It synthesizes evidence from clinical trials and preclinical studies to explain why FMT sometimes enhances ICI efficacy while other times shows no benefit or adverse effects. The paper outlines mechanisms involving gut microbiota modulation, metabolite profiles, and tumor microenvironment changes, and discusses factors influencing outcomes such as donor selection, recipient characteristics, and administration protocols. It concludes by proposing future research directions including large-scale trials, multi-omics integration, and alternative microbiome-based therapies.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::b8f4ede79d64928928c3569c7f920cea77ba135b6eb8184f6ac26c844bb27ccc",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::d1590c0e09f64bdeb0f7b69bc925181bb5bf6cf12262b59e2e52cbc9f99d8e7c",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::ab9e17db4ca6e42b2c16d84e66da64a30158f91d1b253cd72f0dce241ce7e040",
      "multiple_values_in_field": false
    },
    "atom::23712539ed02f3506bbf2e7a": {
      "atom_id": "atom::23712539ed02f3506bbf2e7a",
      "source_handle": "P0573",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a high-level conceptual map for understanding the 'gut-immune-tumor' axis in the context of ICI therapy. It provides a comprehensive categorization of mechanisms (microbiota, metabolites, TME, signaling) and clinical contexts where FMT interacts with ICIs. It is particularly useful for structuring the discussion on *how* the microbiome modulates ICI efficacy and *why* responses vary, offering a synthesis of both positive and negative evidence rather than just supportive cases.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::b8f4ede79d64928928c3569c7f920cea77ba135b6eb8184f6ac26c844bb27ccc",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::d1590c0e09f64bdeb0f7b69bc925181bb5bf6cf12262b59e2e52cbc9f99d8e7c",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::32dc53c87f800849b118fec12d8674e52b937b405dba8a65acfd68605db067ca",
      "multiple_values_in_field": false
    },
    "atom::5013ece2973d969d51eb7c45": {
      "atom_id": "atom::5013ece2973d969d51eb7c45",
      "source_handle": "P0573",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Evidence is drawn from various trial phases and tumor types; generalizations across all solid tumors should be cautious due to varying baseline microbiomes and tumor immunogenicity.",
        "contribution": "Summarizes clinical evidence showing that FMT can enhance ICI efficacy in specific solid tumors (melanoma, MSS-mCRC) by correlating with increased microbial diversity and beneficial taxa enrichment. Also reports cases where FMT failed or showed adverse effects.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
