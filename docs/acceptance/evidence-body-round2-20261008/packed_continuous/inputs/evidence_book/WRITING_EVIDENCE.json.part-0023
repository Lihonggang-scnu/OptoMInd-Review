    },
    "atom::bf5d9ab2e65ee7a5c7b0216a": {
      "atom_id": "atom::bf5d9ab2e65ee7a5c7b0216a",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "批评了传统还原论方法（寻找单一因果基因/蛋白）在微生物研究中的失效，提出需要机器学习/AI模型来处理微生物组的复杂性，并指出小鼠模型与人类微生物组的差异是转化研究的瓶颈。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
