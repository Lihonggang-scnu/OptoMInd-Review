      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于解释为何尽管有初步 promising 结果，但临床转化缓慢。这有助于理解现有文献中阴性或中止试验的背景原因，避免误读为生物学上的完全无效。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
