      ],
      "variant_group": "field::1525d43d6a726d1543ff49e48a859ab3bae912486449b6a9fa09191ff7f87439",
      "multiple_values_in_field": true
    },
    "atom::977e34b869812395e375c53f": {
      "atom_id": "atom::977e34b869812395e375c53f",
      "source_handle": "P0462",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论微生物代谢产物如何直接促进抗肿瘤免疫或改善预后。可作为支持“有益菌群通过代谢物发挥作用”这一观点的具体证据。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::51342908369a3d1c46566ac349d7838235724e931a9dbba397c30430387a91e3",
