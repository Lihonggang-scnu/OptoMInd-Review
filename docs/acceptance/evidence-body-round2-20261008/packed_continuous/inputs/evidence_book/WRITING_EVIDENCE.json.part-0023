    "atom::112d9578ce10a63f148df4a4": {
      "atom_id": "atom::112d9578ce10a63f148df4a4",
      "source_handle": "P0144",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "针对PD-1/PD-L1治疗的多种实体瘤（非小细胞肺癌、肾细胞癌、黑色素瘤）",
        "finding": "应答者中Akkeermansia muciniphila的丰度显著高于无应答者；动物模型显示转移应答者粪菌可恢复ICI疗效，补充Akk可部分逆转抗生素导致的耐药。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::193cda8f441729935fbc2068c81e16a51b2cba6ff1dc9c8b78066be24d1ff2be",
      "multiple_values_in_field": true
    },
    "atom::c15cda0bf0ad48989d90f6c0": {
      "atom_id": "atom::c15cda0bf0ad48989d90f6c0",
      "source_handle": "P0144",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "涉及Bacteroides属的研究",
        "finding": "证据不如Akkermansia robust；某些菌株（如B. fragilis）可能通过促进Th1反应增强抗CTLA-4疗效，但其他报告将高丰度Bacteroides与较低响应率或较短PFS关联，结果受肿瘤类型、宿主特征和菌株特异性影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::193cda8f441729935fbc2068c81e16a51b2cba6ff1dc9c8b78066be24d1ff2be",
      "multiple_values_in_field": true
    },
    "atom::a04d064eba5b73c0c8e327da": {
      "atom_id": "atom::a04d064eba5b73c0c8e327da",
      "source_handle": "P0144",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物群多样性指标",
        "finding": "较高的Alpha多样性通常与更好的ICI响应和生存期相关，但并非所有研究都发现显著差异，表明单一生态参数不足以预测疗效，需结合功能基因和代谢组学。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::193cda8f441729935fbc2068c81e16a51b2cba6ff1dc9c8b78066be24d1ff2be",
      "multiple_values_in_field": true
    },
    "atom::6925d702ce7aa3def981ef82": {
      "atom_id": "atom::6925d702ce7aa3def981ef82",
      "source_handle": "P0144",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "代谢物调节机制",
        "finding": "SCFAs（如丁酸）通过抑制HDAC和激活GPCRs调节T细胞代谢和分化；肌苷通过腺苷A2A受体促进Th1/Tc1极化；色氨酸代谢物通过AhR通路调节T细胞分化，而IDO介导的犬尿氨酸则抑制T细胞增殖。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::193cda8f441729935fbc2068c81e16a51b2cba6ff1dc9c8b78066be24d1ff2be",
      "multiple_values_in_field": true
    },
    "atom::11ba96025eeeabf75cbd48c4": {
      "atom_id": "atom::11ba96025eeeabf75cbd48c4",
      "source_handle": "P0144",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "FMT治疗难治性ICI相关结肠炎",
        "finding": "短期疗效显著，多数病例报告显示临床症状迅速缓解，机制涉及局部炎症环境向抗炎状态转变（CD8+ T细胞减少，Treg增加）；但长期维持效果不确定，复发率可能介于溃疡性结肠炎（高复发）和复发性艰难梭菌感染（低复发）之间。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::193cda8f441729935fbc2068c81e16a51b2cba6ff1dc9c8b78066be24d1ff2be",
      "multiple_values_in_field": true
    },
    "atom::7ab1ee6746be7b6db9b26c28": {
