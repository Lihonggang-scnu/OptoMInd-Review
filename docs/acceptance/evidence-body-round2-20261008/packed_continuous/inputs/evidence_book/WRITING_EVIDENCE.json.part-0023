      "atom_id": "atom::fc4f4250ca72e6fc61a9fbd4",
      "source_handle": "P0161",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "文中提到的机制多为相关性或动物模型证据，不能直接等同于人类临床因果链条。",
