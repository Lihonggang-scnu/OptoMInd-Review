    "atom::6b3c39236af481f48796c5a5": {
      "atom_id": "atom::6b3c39236af481f48796c5a5",
      "source_handle": "P0260",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "As a narrative review, the authors synthesized existing literature on ICI-induced irAEs. The structure follows a logical progression: first, elucidating core immunopathological mechanisms (T-cell, B-cell, cytokine, monocyte axes); second, analyzing multidimensional risk factors (host, environment, treatment, tumor, genetics); third, detailing clinical features, grading, and management strategies for irAEs across major organ systems; and fourth, proposing future research directions focusing on shared mechanisms, predictive models, and optimized intervention strategies. The approach relies on summarizing clinical studies, experimental data, and meta-analyses cited in the references.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dad3b7f35d836145e9d038518b7bba2ecdb12e93da3eb3dcfc5256f4d871718b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::a28036d77e210b3d249c89e237585e5ef08b69310c0a73b3496c2cab0c87ade4",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::7b6910882399da24e98be129b69e64dd942ebdaa0d6f08f4c208fff697a66a31",
      "multiple_values_in_field": false
    },
    "atom::b674d56e73dd08f9bbfecb45": {
      "atom_id": "atom::b674d56e73dd08f9bbfecb45",
      "source_handle": "P0260",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive, up-to-date synthesis of the multifaceted mechanisms (cellular and molecular) underlying irAEs, integrating T-cell, B-cell, cytokine, and monocyte pathways.",
        "limits": "As a review, it does not present new primary experimental data or validate predictive biomarkers clinically; it summarizes existing evidence which may be heterogeneous."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dad3b7f35d836145e9d038518b7bba2ecdb12e93da3eb3dcfc5256f4d871718b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::a28036d77e210b3d249c89e237585e5ef08b69310c0a73b3496c2cab0c87ade4",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::02486541444eca249d087327688c19c18f4e73b3a7a4af28b34435f48e622e44",
      "multiple_values_in_field": true
    },
    "atom::e03a2182581575edeadacd6c": {
      "atom_id": "atom::e03a2182581575edeadacd6c",
      "source_handle": "P0260",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Offers a detailed, organ-system-based classification of irAEs with specific incidence rates, grading criteria, and tiered management strategies, serving as a practical clinical reference.",
        "limits": "Management recommendations are largely based on expert consensus and existing guidelines rather than novel randomized controlled trials presented in this paper."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dad3b7f35d836145e9d038518b7bba2ecdb12e93da3eb3dcfc5256f4d871718b",
          "field_path": [
