          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::8bb78329e41d86197ff2f2648d5a27a155c579c57a29626dd362ce17006c4e66",
      "multiple_values_in_field": true
    },
    "atom::63bb648f1b68b6682edea2c8": {
      "atom_id": "atom::63bb648f1b68b6682edea2c8",
      "source_handle": "P0600",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于综述中阐述微生物群特征如何作为irAEs的风险因素或生物标志物。帮助解释为何某些患者更容易发生毒性反应。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::764ddb58c7d47204119c72b59b439669e230c3e9d3e77cfd06d6412172c36ce1",
