    "atom::584ce14bdd46fd483fcc69fa": {
      "atom_id": "atom::584ce14bdd46fd483fcc69fa",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于综述的方法论讨论部分，提示在综合现有文献时需注意研究设计的局限性（如动物模型的外推风险），并强调未来研究需关注复杂网络而非单一物种。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
