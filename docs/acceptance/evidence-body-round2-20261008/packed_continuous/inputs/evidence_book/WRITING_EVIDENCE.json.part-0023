      "atom_id": "atom::9269ca231cad202dabd3b46a",
      "source_handle": "P0028",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "大部分干预数据来自临床前研究或早期II期试验，缺乏III期确证性数据；供体选择和标准化问题尚未解决。",
        "contribution": "提出了基于微生物的干预策略（如抗生素清除Fn、FMT、工程菌）作为克服ICI耐药的潜在手段。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
