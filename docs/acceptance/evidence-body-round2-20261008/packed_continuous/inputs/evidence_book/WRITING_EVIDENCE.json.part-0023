    "atom::bfaa65a3320dc440ddff00ad": {
      "atom_id": "atom::bfaa65a3320dc440ddff00ad",
      "source_handle": "P0573",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conducted a narrative synthesis of existing literature. They categorized findings into potential benefits (positive clinical responses in melanoma, CRC, etc.) and failures (e.g., SER-401 trial). Mechanisms were analyzed through host physiology alterations (microbiota diversity/composition, metabolites like SCFAs and bile acids, TME immune cell infiltration, signaling pathways). Optimization strategies were derived from donor screening criteria, functional vs. composition-based selection, and monitoring methods. Future perspectives were outlined based on identified gaps in current knowledge.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::b8f4ede79d64928928c3569c7f920cea77ba135b6eb8184f6ac26c844bb27ccc",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::d1590c0e09f64bdeb0f7b69bc925181bb5bf6cf12262b59e2e52cbc9f99d8e7c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::8a1206e1691890a145d667b7710bf2cfd5245f8016a5884293741d722d4442d9",
      "multiple_values_in_field": false
    },
    "atom::95ea94d27b2d7b2268bfea91": {
      "atom_id": "atom::95ea94d27b2d7b2268bfea91",
      "source_handle": "P0573",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a structured overview of the heterogeneous clinical outcomes of FMT-ICI combination therapy across different cancer types.",
        "limits": "As a narrative review, it does not present new primary data or perform a systematic quantitative meta-analysis; conclusions are based on synthesized observations from cited studies."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7370217b0d1083d4f465a9fdaeb367f0c12dababc11cbf52f70b451762bf8bc2",
