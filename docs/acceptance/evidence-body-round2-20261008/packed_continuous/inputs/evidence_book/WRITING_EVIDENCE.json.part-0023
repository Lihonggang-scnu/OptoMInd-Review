    "atom::5b695b9010e7583dbd42ba41": {
      "atom_id": "atom::5b695b9010e7583dbd42ba41",
      "source_handle": "P0462",
      "field_path": [
        "review_planning_B",
        "topic_handles"
      ],
      "value": "Landmark analysis for irAEs to avoid immortal time bias",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::51342908369a3d1c46566ac349d7838235724e931a9dbba397c30430387a91e3",
