          ]
        }
      ],
      "variant_group": "field::a76f48be571492603627d2558434e5ae4580745b9ed55b7c5fa63d9a3e11e511",
      "multiple_values_in_field": true
    },
    "atom::6029d443e0dff261020b281b": {
      "atom_id": "atom::6029d443e0dff261020b281b",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“介导效应的机制”。虽然未提供完整的因果链条，但提供了从临床观察反推的机制假设（如免疫激活状态改变）。可用于解释为何FMT比单一益生菌更可能成功（因为保留了复杂的生态互作网络）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
