    "atom::ba45edbbcb54a7c43bb26d91": {
      "atom_id": "atom::ba45edbbcb54a7c43bb26d91",
      "source_handle": "P0114",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限于该特定菌株（Ruminococcaceae）和CD103+ DCs亚群。其他菌群或DC亚群可能通过不同机制起作用。动物模型结果不能直接等同于人体内的确切剂量和动力学。",
        "contribution": "提供了肠道菌群增强PD-1疗效的具体细胞和分子机制：细菌通过TLRs刺激CD103+ DCs，经IRF8途径分化并迁移至TME和引流淋巴结，进而通过延长与CD8+ T细胞的接触并经由NFATc1信号通路增强其激活和PD-1表达。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cc99c3d791586bf600998617f2582393b2deee81f67e5252733695f1f6287c4f",
          "field_path": [
