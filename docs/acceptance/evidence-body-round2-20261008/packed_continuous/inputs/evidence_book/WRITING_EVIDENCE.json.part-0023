        }
      ],
      "variant_group": "field::10f08fe7f0f45ae7f9860b5215eee27c5ce924a207afcb1c34d2a17de6412887",
      "multiple_values_in_field": true
    },
    "atom::f14b826214aac4ff650215f1": {
      "atom_id": "atom::f14b826214aac4ff650215f1",
      "source_handle": "P0144",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于FMT用于ICI相关irAEs的最新临床证据汇总，区分了其与传统IBD治疗的异同。",
        "limits": "引用的FMT临床数据主要来自小型病例报告和观察性研究，缺乏大规模随机对照试验（RCT）支持；长期安全性和有效性数据不足。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::660a40da6b6fd9baeeaa7c45608863a40eecd9c3ed83eca0e91e4177c1e910fd",
          "field_path": [
