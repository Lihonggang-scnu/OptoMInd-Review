    "atom::57b8483e9f9cd672d266dba2": {
      "atom_id": "atom::57b8483e9f9cd672d266dba2",
      "source_handle": "P0600",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "论文引言部分回顾了微生物群在ICI疗效中的作用，并指出目前研究多集中于黑色素瘤，强调本研究扩展至肺癌等其他实体瘤的重要性。"
      },
      "role": "evidence",
      "origins": [
