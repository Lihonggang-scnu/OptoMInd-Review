    "atom::582929f6f34e9511832eb25d": {
      "atom_id": "atom::582929f6f34e9511832eb25d",
      "source_handle": "P0470",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统综述和荟萃分析方法。首先进行系统性文献检索，筛选评估基线肠道微生物群、FMT、益生菌/益生元干预或抗生素暴露的研究。随后使用随机效应模型汇总估计总生存期（OS）和无进展生存期（PFS）的风险比（HR），以及缓解率和irAEs的比值比（OR）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::66afcfe719fb8b5ee6396eb3d1f93774bc27ac52eb7cff82eb027967c13b7fbb",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::8fbc013ac0a5ac71e5a87ad9b03c4b3e03347342b80e51a84dcb96dd6672ac69",
      "multiple_values_in_field": false
    },
    "atom::d81056a067318e687a986ca0": {
      "atom_id": "atom::d81056a067318e687a986ca0",
      "source_handle": "P0470",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于肠道微生物群关键特征（特定菌属、多样性、抗生素影响、FMT效果）与ICIs疗效及安全性之间关联的定量综合证据。",
        "limits": "所给摘要未交代异质性分析结果、发表偏倚评估细节、具体癌症类型的亚组分析结果、irAEs的具体统计数值（仅提及关联性）、以及纳入研究的原始数据质量评估标准。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::66afcfe719fb8b5ee6396eb3d1f93774bc27ac52eb7cff82eb027967c13b7fbb",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::a78f2edbe721504195dfdc1e971ba39b94b72f766ff72af384cd23f5a1cc3b0e",
      "multiple_values_in_field": false
    },
    "atom::865c3fce85bd3a3a7bb8c697": {
      "atom_id": "atom::865c3fce85bd3a3a7bb8c697",
      "source_handle": "P0470",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定细菌属富集（Akkermansia muciniphila, Bifidobacterium longum, Faecalibacterium prausnitzii）",
        "finding": "与改善的总生存期（HR 0.62, 95% CI 0.51-0.76）和无进展生存期（HR 0.69, 95% CI 0.55-0.83）显著相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::66afcfe719fb8b5ee6396eb3d1f93774bc27ac52eb7cff82eb027967c13b7fbb",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::49b03b9082031037ce76a325d20ec802ffe40b7cfa79c76a9f1e70765fe08422",
      "multiple_values_in_field": true
    },
    "atom::55e5fca6e95dbafa7b97ba97": {
      "atom_id": "atom::55e5fca6e95dbafa7b97ba97",
      "source_handle": "P0470",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在ICI治疗前或期间暴露于抗生素",
        "finding": "与较差的总生存期相关（HR 1.84, 95% CI 1.45-2.34）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::66afcfe719fb8b5ee6396eb3d1f93774bc27ac52eb7cff82eb027967c13b7fbb",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::49b03b9082031037ce76a325d20ec802ffe40b7cfa79c76a9f1e70765fe08422",
      "multiple_values_in_field": true
    },
    "atom::afa5de82594d6caa0498c1c3": {
      "atom_id": "atom::afa5de82594d6caa0498c1c3",
      "source_handle": "P0470",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受来自反应者的FMT",
        "finding": "表现出更高的客观缓解率（OR 2.91, 95% CI 1.48-5.73）。"
      },
      "role": "evidence",
