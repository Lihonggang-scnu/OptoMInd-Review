    "atom::cb21724cdddb728c61b9904e": {
      "atom_id": "atom::cb21724cdddb728c61b9904e",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述主要关注细菌疗法，虽提及真菌、古菌和病毒，但未深入展开，阅读时需限定在细菌层面。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
