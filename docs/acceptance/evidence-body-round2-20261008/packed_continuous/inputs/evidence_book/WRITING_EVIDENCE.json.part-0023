    },
    "atom::6e001846f5b8f5af505a919f": {
      "atom_id": "atom::6e001846f5b8f5af505a919f",
      "source_handle": "P0028",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中关于“微生物组成如何预测或改变ICI疗效”的部分，提供具体的正反例证（Fn vs B. fragilis）。",
      "role": "planning",
      "origins": [
