    "atom::eea15867a2ef88a5f0c77406": {
      "atom_id": "atom::eea15867a2ef88a5f0c77406",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "Helps distinguish between general immunomodulatory effects of the microbiome and those specific to cancer immunotherapy. Highlights that while mechanisms overlap, the clinical implications and specific microbial drivers may differ between prophylactic/treatment vaccines and cancer ICIs.",
