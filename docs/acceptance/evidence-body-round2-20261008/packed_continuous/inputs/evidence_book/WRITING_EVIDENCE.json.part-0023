    "atom::27dd931bd58169567e4a4506": {
      "atom_id": "atom::27dd931bd58169567e4a4506",
      "source_handle": "P0462",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "首次提供实证证据支持微生物组通过分子模拟驱动irAEs（自身免疫抗原模拟）和ICI疗效（肿瘤抗原模拟）的假设。揭示了长期获益者特有的紧凑微生物网络和丁酸高产能力。明确了菌株水平变异（而非仅物种丰度）对临床表型的决定性作用。",
        "limits": "样本量较小（宏基因组n=54，代谢组n=49），可能限制统计效力。抗原模拟分析依赖于公共数据库中的已知表位，可能遗漏未表征的关键表位。菌株分析仅针对丰度较高的少数物种。所有样本为基线采集，无法反映治疗过程中的动态变化。外部验证队列的治疗方案和肿瘤类型不完全一致（如黑色素瘤vs肺癌）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::51342908369a3d1c46566ac349d7838235724e931a9dbba397c30430387a91e3",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::59aab1e2a170fac4e9fc15c61d0812e90cfed356cae053ebe34124e25d62e1c0",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
