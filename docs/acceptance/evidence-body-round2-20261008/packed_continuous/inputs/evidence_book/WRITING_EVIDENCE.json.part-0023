    "atom::1cdfbbb48f5f9c98936fc044": {
      "atom_id": "atom::1cdfbbb48f5f9c98936fc044",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "机制研究与模型转化",
        "finding": "目前缺乏明确的单一因果细菌物种；机制涉及T细胞浸润、代谢物（如短链脂肪酸）产生及免疫基因集变化。小鼠模型与人类微生物组差异巨大，限制了直接外推。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
