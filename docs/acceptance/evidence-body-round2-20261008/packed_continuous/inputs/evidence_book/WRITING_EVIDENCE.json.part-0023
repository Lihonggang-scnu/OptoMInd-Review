    "atom::c9b2027b3a0424f0cc72a3de": {
      "atom_id": "atom::c9b2027b3a0424f0cc72a3de",
      "source_handle": "P0161",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制基于小鼠模型或体外实验推断；人类体内确证证据有限；不同机制间可能存在重叠或协同，文中未明确量化各机制的贡献权重。",
        "contribution": "详细列举了五种潜在机制：(1) 微生物蛋白模拟肿瘤抗原引发T细胞交叉反应；(2) 调节免疫检查点分子表达（如PD-L1/PD-L2）创造‘热’肿瘤微环境；(3) 激活PRRs（如TLR, NOD2, STING）促进DC成熟和T细胞活化；(4) 释放代谢物（SCFAs, 肌苷, TMAO等）调节全身和局部免疫；(5) 肠道微生物易位至肿瘤内部直接影响肿瘤内免疫微环境。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
