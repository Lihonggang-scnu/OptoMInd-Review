      "multiple_values_in_field": true
    },
    "atom::6dfe07d80a5574e49e3c294a": {
      "atom_id": "atom::6dfe07d80a5574e49e3c294a",
      "source_handle": "P0080",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠MC38肿瘤模型，口服补充LPS",
        "finding": "口服六酰化LPS显著增强抗PD-1介导的抗肿瘤免疫（减少肿瘤负荷，增加肿瘤浸润IFNγ+/TNF+ CD8+ T细胞），而五酰化LPS无效且体外实验中可拮抗六酰化LPS诱导的免疫激活。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::856c2af998f7879e7615a72698280a17f2b6ec268708f333d3b34f00e105a962",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::21ad3684f0c465c1db4704b5985cf21b789794970667318676cd19fa0f137f0c",
      "multiple_values_in_field": true
    },
    "atom::e9a88ce47aaabb6964b058ad": {
      "atom_id": "atom::e9a88ce47aaabb6964b058ad",
      "source_handle": "P0080",
      "field_path": [
