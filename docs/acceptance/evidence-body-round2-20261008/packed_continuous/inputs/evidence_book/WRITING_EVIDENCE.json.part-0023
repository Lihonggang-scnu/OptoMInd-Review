    },
    "atom::df7c1c8cdb1b19415f16bd7c": {
      "atom_id": "atom::df7c1c8cdb1b19415f16bd7c",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性综述方法，梳理已发表的临床试验数据（包括已完成和正在进行的研究）。作者按干预类型（益生菌、菌群组合、FMT）分类整理证据，对比各试验的设计、患者人群、疗效指标（ORR, mPFS）及不良事件。同时，结合讨论部分，分析导致临床结果不一致的原因（如物种特异性、定植能力、抗生素预处理的影响），并评估当前监管框架和研究方法论（如小鼠模型的局限性）对转化研究的制约。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::b108064ede6712f9e766ace8d39a3f7b19bba3048d6628f37ab8aea8eb7325db",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::c7c01cfda4346acfbf8fe480ea5a7150b84f6da4b0b6e043fcd9f3716d0662bf",
      "multiple_values_in_field": false
    },
    "atom::ad144ff01b7112fa74c4f766": {
      "atom_id": "atom::ad144ff01b7112fa74c4f766",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于微生物疗法作为ICI辅助治疗的全景式临床证据汇总，特别是区分了益生菌、菌群组合和FMT在不同实体瘤中的表现差异。",
        "limits": "作为综述，未提供新的原始实验数据；对机制的解释主要基于作者对现有文献的综合推断，具体分子通路尚不明确；所引用的临床试验多为小样本或早期阶段，统计效力有限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::b108064ede6712f9e766ace8d39a3f7b19bba3048d6628f37ab8aea8eb7325db",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::f8831e1d5ee9283d810fdf6aaa10ed751ce4173bf9b4a730be213b4b5155d2c0",
      "multiple_values_in_field": true
    },
    "atom::18fce5dbd3407432b774c9dd": {
      "atom_id": "atom::18fce5dbd3407432b774c9dd",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "指出了当前领域面临的非科学障碍，如监管标准不适用于复杂微生物产品、患者招募困难及抗生素预处理策略的潜在风险。",
        "limits": "这些观点属于领域内的共识性讨论，并非该综述独有的实证发现；对于如何解决这些系统性问题，仅提出了方向性建议（如AI建模、标准化供体筛选），未提供具体解决方案。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::b108064ede6712f9e766ace8d39a3f7b19bba3048d6628f37ab8aea8eb7325db",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::f8831e1d5ee9283d810fdf6aaa10ed751ce4173bf9b4a730be213b4b5155d2c0",
      "multiple_values_in_field": true
    },
    "atom::e026da3395f4a6e48096eefc": {
      "atom_id": "atom::e026da3395f4a6e48096eefc",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用单一或少数菌株益生菌（如CBM588）联合ICI",
        "finding": "在某些特定癌种（如转移性肾细胞癌）中显示出较高的ORR提升（58%-74% vs 对照20%），但在其他癌种（如微卫星稳定型结直肠癌）中效果不佳或无效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::b108064ede6712f9e766ace8d39a3f7b19bba3048d6628f37ab8aea8eb7325db",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::793dcf51cfb56df4093013096e834dd52f392386af71eb3ae38fd5e84fff30ed",
      "multiple_values_in_field": true
    },
    "atom::7ffe37d5b7bd2ed2749dc96b": {
      "atom_id": "atom::7ffe37d5b7bd2ed2749dc96b",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用多菌株微生物菌群组合（如MET4, SER-401, VE800）",
        "finding": "结果高度异质。MET4在部分队列中显示潜在获益，但受限于招募失败；SER-401因早期终止且初步数据显示疗效不优于安慰剂而终止；VE800整体ORR极低（1.9%），仅在黑色素瘤亚组中观察到一定益处。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::b108064ede6712f9e766ace8d39a3f7b19bba3048d6628f37ab8aea8eb7325db",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::793dcf51cfb56df4093013096e834dd52f392386af71eb3ae38fd5e84fff30ed",
      "multiple_values_in_field": true
    },
    "atom::e58ae790bec32ee11a9df4c4": {
      "atom_id": "atom::e58ae790bec32ee11a9df4c4",
      "source_handle": "P0387",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用粪便微生物移植（FMT）联合ICI",
        "finding": "在多种难治性实体瘤（黑色素瘤、NSCLC、MSI-H癌症等）中显示出一致的积极信号，ORR普遍较高（20%-77%），且安全性总体可控，提示其可能具有广谱抗肿瘤活性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
