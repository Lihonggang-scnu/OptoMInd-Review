    "atom::9be2b26a5b5e661354c8e867": {
      "atom_id": "atom::9be2b26a5b5e661354c8e867",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法。作者检索并筛选了关于肠道微生物群与ICI疗效关系的临床研究和临床前模型研究。通过分类整理不同干预措施（FMT、益生菌、饮食）的效果数据，对比反应者与不反应者的微生物组成差异，并从免疫微环境、系统性免疫、代谢产物及炎症通路等角度综合现有的机制解释文献，形成对领域现状的综合评述。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::529c789cd2353aaccee819a869575df51c5e28f5f7c3eeceae49c5727c8c0d34",
      "multiple_values_in_field": false
    },
    "atom::dbace3cc395d30e590ee9887": {
      "atom_id": "atom::dbace3cc395d30e590ee9887",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统整合了肠道微生物群调节ICI疗效的临床证据（FMT、益生菌、饮食），并归纳了多层次的潜在生物学机制，为理解微生物-免疫互作提供了框架。",
        "limits": "作为综述，依赖已发表研究的汇总，未进行新的原始数据分析；许多机制仍处于假设或初步验证阶段，缺乏大规模随机对照试验的最终确认；不同研究间微生物分析方法、人群异质性导致结果难以直接比较。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::0e113d0ec4da2467cb0ebc7a45104c623f3509048b809f4b44be7194dd580272",
      "multiple_values_in_field": false
    },
    "atom::bc4daf35fe4d8c8c789ca825": {
      "atom_id": "atom::bc4daf35fe4d8c8c789ca825",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "临床观察与队列研究",
        "finding": "特定微生物特征（如双歧杆菌、阿克曼菌、粪杆菌等）与ICI治疗的良好临床结局相关；抗生素诱导的菌群失调会损害ICI疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::05b660154e8f6da05c68bc9d76be9ab8bfc7f2df1650ca69df816773d0655250",
      "multiple_values_in_field": true
    },
    "atom::798ebbfdd0dde971c93cb6a4": {
      "atom_id": "atom::798ebbfdd0dde971c93cb6a4",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "FMT干预",
        "finding": "来自ICI反应者的粪便移植可改善黑色素瘤患者对PD-1抑制剂的响应，且安全性良好；健康供体的FMT联合PD-1抑制剂也显示出优于单药治疗的客观缓解率。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::05b660154e8f6da05c68bc9d76be9ab8bfc7f2df1650ca69df816773d0655250",
      "multiple_values_in_field": true
    },
    "atom::cfba85626e547e4916a78d0a": {
      "atom_id": "atom::cfba85626e547e4916a78d0a",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "益生菌/菌群联合体",
        "finding": "某些特定菌株（如CBM588中的丁酸梭菌）在随机对照试验中显示出提高客观缓解率和延长无进展生存期的潜力；但其他回顾性研究显示普通益生菌使用效果不一，甚至可能有害，表明菌株特异性至关重要。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::05b660154e8f6da05c68bc9d76be9ab8bfc7f2df1650ca69df816773d0655250",
      "multiple_values_in_field": true
    },
    "atom::0f707e214620de54c46991b3": {
      "atom_id": "atom::0f707e214620de54c46991b3",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "饮食干预",
        "finding": "高纤维饮食与较长的无进展生存期相关，可能通过增加α多样性和有益菌丰度发挥作用；Omega-3摄入也与反应者相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::05b660154e8f6da05c68bc9d76be9ab8bfc7f2df1650ca69df816773d0655250",
      "multiple_values_in_field": true
    },
    "atom::10c3f5ac4aaead4dcaace7a3": {
      "atom_id": "atom::10c3f5ac4aaead4dcaace7a3",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "机制研究",
        "finding": "肠道微生物可通过分子模拟引发T细胞交叉反应、激活PRRs促进树突状细胞成熟、产生短链脂肪酸等代谢物调节T细胞功能、以及通过易位影响肿瘤内微生物组等多种途径增强抗肿瘤免疫。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::05b660154e8f6da05c68bc9d76be9ab8bfc7f2df1650ca69df816773d0655250",
      "multiple_values_in_field": true
    },
    "atom::3b58b7d1aae69de5bc159dab": {
      "atom_id": "atom::3b58b7d1aae69de5bc159dab",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::120ef79e19245ab08463813cc284fc00afb93df9ee0a127ae521389cbbba2d29",
      "multiple_values_in_field": false
    },
    "atom::b49504fca86b3118cf108630": {
      "atom_id": "atom::b49504fca86b3118cf108630",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管ICIs改善了部分癌症患者的预后，但大多数患者仍无充分响应或产生耐药性，且现有生物标志物预测能力有限。肠道微生物群被认为是导致耐药的重要内在/外在因素，但其具体如何影响ICI疗效、哪些微生物特征有利、如何通过干预手段优化疗效以及其背后的生物学机制尚需系统总结。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::690b0917686c18fa83f7b9e6cd57bb76be39f533645583cd4376fc50b5a9fdc8",
      "multiple_values_in_field": false
    },
    "atom::8ab5ca807f03f82ccece9553": {
      "atom_id": "atom::8ab5ca807f03f82ccece9553",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "免疫检查点抑制剂（ICIs）在实体瘤治疗中的应用，重点聚焦于肠道微生物群对ICI疗效的影响、调节策略及其潜在机制。涵盖黑色素瘤、非小细胞肺癌（NSCLC）、肾细胞癌等常见实体瘤类型。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::cc82752f5f2af113a75d11e4cca9cfe259c6327224afe79ff0ab42f30d9e1755",
      "multiple_values_in_field": false
    },
    "atom::ebada6823701e6a1c1f35757": {
      "atom_id": "atom::ebada6823701e6a1c1f35757",
      "source_handle": "P0161",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本文是一篇综述，旨在系统梳理肠道微生物群与免疫检查点抑制剂（ICIs）疗效之间的关联。文章首先阐述了肠道微生物群作为影响ICI耐药性的关键因素，总结了反应者与非反应者之间微生物组成的差异，并定义了“有利”和“不利”的微生物特征。随后，文章详细评估了通过粪便微生物移植（FMT）、益生菌/菌群联合体以及饮食干预等手段调节肠道微生物群以增强ICI疗效的临床前和临床研究进展。此外，论文还探讨了这种调节作用对免疫相关不良事件（irAEs）的影响，并归纳了包括分子模拟、模式识别受体激活、代谢物释放及肿瘤内微生物组调控在内的多种潜在作用机制。最后，文章指出了当前研究在供体选择、标准化、机制验证等方面的局限性，并提出了未来研究方向。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::bae3bacd9361391114ec10f030f34954d9d3996f5f2b66a2ff72e791480ddba4",
      "multiple_values_in_field": false
    },
    "atom::a87239f6c966e15e405791a8": {
      "atom_id": "atom::a87239f6c966e15e405791a8",
      "source_handle": "P0161",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物群如何影响实体瘤中ICI疗效提供了全面的背景框架和机制分类。它特别有价值地整理了三种主要调节策略（FMT、益生菌、饮食）的临床证据对比，并详细拆解了从分子模拟到代谢物调节的具体机制路径。对于综述而言，此文可作为阐述“微生物调节策略有效性比较”及“机制多样性”的核心素材。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::813644af890e426843064fd4566052aec7cc204d7b0ee4dfae9b016a673b7f79",
      "multiple_values_in_field": false
    },
    "atom::38a7687d425e30b58ce18d7c": {
      "atom_id": "atom::38a7687d425e30b58ce18d7c",
      "source_handle": "P0161",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "多数临床数据来自小规模试点研究或非随机对照试验；不同癌症类型的敏感性可能存在差异；益生菌效果高度依赖于具体菌株而非通用类别。",
        "contribution": "提供了FMT、益生菌和饮食三种调节策略在实体瘤（主要是黑色素瘤和NSCLC）中的具体临床效果数据。例如，FMT来自反应者可提高客观缓解率；特定益生菌CBM588在RCT中显示优势；高纤维饮食与PFS延长相关。同时指出普通益生菌使用的争议性结果。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::eebc32db06f2bee6998bdb37a6a21f3950c57b3c5705bffea0c2fdfd17bbdf47",
      "multiple_values_in_field": true
    },
    "atom::89637262b7a70e92fbd3a29d": {
      "atom_id": "atom::89637262b7a70e92fbd3a29d",
      "source_handle": "P0161",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物群如何调节ICI疗效”中的干预措施部分，比较不同调节手段的有效性和适用情境。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
