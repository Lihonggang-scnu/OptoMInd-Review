    },
    "atom::6150bc781f7918a9915bfded": {
      "atom_id": "atom::6150bc781f7918a9915bfded",
      "source_handle": "P0387",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "介绍了ICI的作用原理（PD-1/PD-L1, CTLA-4抑制，T细胞增殖）及其在“冷”肿瘤中的局限性。定义了“热”与“冷”肿瘤的概念，并引入肠道微生物群作为潜在的共治疗手段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2982acd184049ed5bf73367d1e56cb56bfcf761c3939d1e15a0f3babd76b4ce8",
          "field_path": [
