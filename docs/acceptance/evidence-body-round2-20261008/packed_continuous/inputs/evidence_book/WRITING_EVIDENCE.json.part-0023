    "atom::ff5140480eb6af44c5698502": {
      "atom_id": "atom::ff5140480eb6af44c5698502",
      "source_handle": "P0080",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限黑色素瘤患者数据为主，其他癌症类型证据不足。",
        "contribution": "提供了肠道微生物群通过产生特定结构LPS（六酰化）增强抗PD-1疗效的证据。显示响应者中lpxM基因富集，非响应者中lpxL（五酰化）基因富集。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::856c2af998f7879e7615a72698280a17f2b6ec268708f333d3b34f00e105a962",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::198c7d1eb9b117ab8e3c4d98a0019d14e994ca52ba20fa110ef192173c378557",
      "multiple_values_in_field": true
    },
    "atom::782fe310b0d58f5000ffb55c": {
      "atom_id": "atom::782fe310b0d58f5000ffb55c",
      "source_handle": "P0080",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物群如何调节ICI疗效”，展示微生物代谢物作为正向调节因子的例子。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::856c2af998f7879e7615a72698280a17f2b6ec268708f333d3b34f00e105a962",
          "field_path": [
            "review_planning_B",
