    "atom::827da2bac4d68e9836b04872": {
      "atom_id": "atom::827da2bac4d68e9836b04872",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Associations are primarily observational in humans; causality is largely established in preclinical mouse models. Effects may vary by cancer type and ICI agent (anti-PD-1 vs anti-CTLA-4).",
        "contribution": "Identifies specific gut microbial signatures associated with ICI efficacy in solid tumors. Clinically, higher diversity and abundance of Faecalibacterium prausnitzii, Bifidobacterium longum, and Akkermansia muciniphilia are linked to better outcomes in melanoma, NSCLC, and RCC. Antibiotic use is frequently associated with reduced efficacy.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::48cafa877ec53bf8522e21d00214962cb63eb9f19bd0e7f932b8f28fd8fc21ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::3aed7be819f2193580cc29502d0565b7afe425eebb8ec3d7aa4f591831033ab4",
      "multiple_values_in_field": true
    },
    "atom::f1abe8fb4be78343b6f5df5b": {
      "atom_id": "atom::f1abe8fb4be78343b6f5df5b",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to support arguments about the predictive value of specific bacterial taxa or overall diversity for ICI response in solid tumors. Provides examples of patient stratification based on microbiome composition.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::48cafa877ec53bf8522e21d00214962cb63eb9f19bd0e7f932b8f28fd8fc21ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::b5047d268462f635784d44adf4e5ec9b03a710587f6f015dbf337260af3fbdb9",
      "multiple_values_in_field": true
    },
    "atom::38f1ad86e5e0d277737673b3": {
      "atom_id": "atom::38f1ad86e5e0d277737673b3",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Many mechanistic details are derived from preclinical models (mice). The review notes that SCFA effects can be context-dependent (e.g., butyrate may inhibit ICI in some contexts while promoting vaccine response). Direct translation of these mechanisms to human tumor microenvironments requires caution.",
        "contribution": "Details three main mechanistic pathways: 1) SCFAs (e.g., butyrate) influencing DC maturation and T cell activation; 2) MAMPs (e.g., flagellin, peptidoglycan) stimulating TLRs/NOD2 on APCs to promote Th1 polarization and antigen presentation; 3) Microbiome-derived cytokines (IL-12, IFN-gamma) shaping the immune tone.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::48cafa877ec53bf8522e21d00214962cb63eb9f19bd0e7f932b8f28fd8fc21ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::3aed7be819f2193580cc29502d0565b7afe425eebb8ec3d7aa4f591831033ab4",
      "multiple_values_in_field": true
    },
    "atom::a366f4d56ee100c99ce24991": {
      "atom_id": "atom::a366f4d56ee100c99ce24991",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Provides a structured framework for explaining *how* the microbiome modulates ICI efficacy. Useful for discussing cellular and molecular mechanisms, particularly the role of dendritic cells and T cell polarization.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::48cafa877ec53bf8522e21d00214962cb63eb9f19bd0e7f932b8f28fd8fc21ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::b5047d268462f635784d44adf4e5ec9b03a710587f6f015dbf337260af3fbdb9",
      "multiple_values_in_field": true
    },
    "atom::54165241954f1a387f790c04": {
      "atom_id": "atom::54165241954f1a387f790c04",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review provides a high-level synthesis of how the gut microbiome influences the efficacy of immune checkpoint inhibitors (ICIs) and vaccines. For the user's review on solid tumors and ICIs, this paper offers valuable background on the general principles of microbiome-immune interaction, identifies key microbial taxa and metabolites associated with ICI response, and discusses the mechanisms (SCFAs, MAMPs, cytokines) through which these effects occur. It also serves as a useful comparator for understanding why similar mechanisms might apply to other immune interventions.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::48cafa877ec53bf8522e21d00214962cb63eb9f19bd0e7f932b8f28fd8fc21ca",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::5ce44fa104f56647bc211e05919ae5fbabbe516c7e81f646d5ebca742a2c12cb",
      "multiple_values_in_field": false
    },
    "atom::7b5283260c0e718f8177c2a3": {
      "atom_id": "atom::7b5283260c0e718f8177c2a3",
      "source_handle": "P0309",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review covers multiple cancer types (melanoma, NSCLC, RCC, urothelial) and ICI agents (anti-PD-1, anti-PD-L1, anti-CTLA-4). Findings should not be assumed to be uniform across all solid tumors or ICI types.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::48cafa877ec53bf8522e21d00214962cb63eb9f19bd0e7f932b8f28fd8fc21ca",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
