    },
    "atom::cf335aeca2ee1231aa9ee0b1": {
      "atom_id": "atom::cf335aeca2ee1231aa9ee0b1",
      "source_handle": "P0114",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在肿瘤微环境中，CD103+ DCs与CD8+ T细胞互作。",
        "finding": "延长的互作导致多种肿瘤抗原特异性CD8+ T细胞的激活，并通过NFATc1核转位增强激活信号，促使这些细胞表达PD-1，形成富含PD-1+ CD8+ T细胞的效应细胞群，且具备更广泛的TCR库。"
      },
      "role": "evidence",
      "origins": [
