    },
    "atom::c55de4c11d644214110ff8a6": {
      "atom_id": "atom::c55de4c11d644214110ff8a6",
      "source_handle": "P0114",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "机制层面，该菌株作用于肠道免疫系统。",
        "finding": "通过刺激多个Toll样受体，促进IRF8驱动的CD103+ DCs的分化、成熟及其向肿瘤微环境和肿瘤引流淋巴结的迁移与积累。"
      },
      "role": "evidence",
