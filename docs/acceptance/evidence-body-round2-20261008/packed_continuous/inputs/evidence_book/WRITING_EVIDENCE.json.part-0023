            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::0b5d5b0fae72f6a17c3680a836ca69303b0854db61ccc57c58d26a72207a7867",
      "multiple_values_in_field": true
    },
    "atom::65232b9dd11887f7c3c947ee": {
      "atom_id": "atom::65232b9dd11887f7c3c947ee",
      "source_handle": "P0600",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "小鼠模型使用了抗生素预处理和联合抗体治疗，与人体的生理状态存在差异。功能分析仅为基于16S的预测，非直接代谢物测量。并非所有接受FMT的小鼠都发病，表明其他宿主因素也参与。",
        "contribution": "通过FMT小鼠实验证明了来自irAE患者的微生物群能够因果性地诱导免疫性结肠炎。同时指出丁酸产生菌丰度降低和特定代谢通路（如氨基酸、维生素代谢）的差异，提示代谢机制可能在介导irAEs中起作用。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::764ddb58c7d47204119c72b59b439669e230c3e9d3e77cfd06d6412172c36ce1",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::715592e26e584e7d4af212b0db47bf6afa146544cdd15ac6af576128c9121ed6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::8bb78329e41d86197ff2f2648d5a27a155c579c57a29626dd362ce17006c4e66",
      "multiple_values_in_field": true
    },
    "atom::3faf6c0ca857130795399ba3": {
      "atom_id": "atom::3faf6c0ca857130795399ba3",
      "source_handle": "P0600",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论irAEs的潜在生物学机制，特别是微生物群-宿主免疫互作中的代谢调节作用。支持“微生物群驱动毒性”的观点，并为通过调节菌群（如补充益生菌）预防irAEs提供理论依据。",
      "role": "planning",
      "origins": [
