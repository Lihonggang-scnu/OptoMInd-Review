    "atom::45419cbabdbf3d3db270910f": {
      "atom_id": "atom::45419cbabdbf3d3db270910f",
      "source_handle": "P0114",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是基于单一菌株的发现，不能代表所有有益菌的作用模式。非响应者背景下的效果需结合具体实验设计解读，可能存在个体异质性。",
        "contribution": "证实了特定肠道细菌（源自响应者）可以作为一种生物佐剂，增强PD-1阻断疗法在实体瘤中的临床疗效，即使在非响应者背景下也有潜在增效作用。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
