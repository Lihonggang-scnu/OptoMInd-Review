            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::3ba51bbd517b6a105846168817ae50f4d7e02bf3ce97339200b1c0aa201d6a05",
      "multiple_values_in_field": false
    },
    "atom::48c7437a9bc25839f3746846": {
      "atom_id": "atom::48c7437a9bc25839f3746846",
      "source_handle": "P0462",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "对比获益组与耐药组（宏基因组预测+代谢组验证）",
        "finding": "获益组富集丙酸（P=0.01）和丁酸/异丁酸（P=0.12/0.02）。乙酸、丙酸、丁酸水平越高，PFS越长，肿瘤进展风险越低（HR<1, P<0.05）。丁酸生产主要受乙酰辅酶A途径介导。"
      },
      "role": "evidence",
      "origins": [
