      "source_handle": "P0161",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述涵盖的实体瘤类型有限，主要集中在黑色素瘤、NSCLC和肾细胞癌，对其他实体瘤（如结直肠癌、胰腺癌）的证据较少或仅为个案/早期研究，外推需谨慎。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::58905f5b7dead4e9c1149816261992a934a9e12555ec1be6fa3633317b57674d",
