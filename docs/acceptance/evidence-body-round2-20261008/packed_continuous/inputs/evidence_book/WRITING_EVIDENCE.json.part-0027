    "atom::44f2d548690b4b10bf73e2c7": {
      "atom_id": "atom::44f2d548690b4b10bf73e2c7",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Akkermansia muciniphila与STING通路",
        "finding": "A. muciniphila产生cdAMP，激活STING信号，诱导I型干扰素产生，招募NK细胞和树突状细胞，从而增强抗肿瘤免疫。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
