    },
    "atom::f5b4029a4db9047fd36c2c50": {
      "atom_id": "atom::f5b4029a4db9047fd36c2c50",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统性文献回顾与综合的方法。作者检索并整理了从临床前研究到临床研究的相关证据，按照代谢物的化学类别（SCFAs、肌苷、TMAO、色氨酸衍生物、胆汁酸及其他分子）进行分类叙述。对于每一类代谢物，综述了其在动物模型和临床试验中的观察结果，归纳了其作用的免疫细胞类型（如CD8+ T细胞、Treg、巨噬细胞等）及关键信号通路（如HDAC、mTOR、GPRs、AhR、NOD2等）。同时，对比分析了同一代谢物在不同治疗背景下的矛盾发现，以评估其复杂性和情境依赖性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::cda2017b2135b3476af5c0d6a6eaf258ad08eceef6b9de997094c87a9aeadf3b",
      "multiple_values_in_field": false
    },
    "atom::596759d47ba6a21459261d96": {
      "atom_id": "atom::596759d47ba6a21459261d96",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统性地汇总了肠道微生物代谢物调节ICIs疗效的多维证据，特别是揭示了同一代谢物（如SCFAs）在不同ICIs靶点（PD-1 vs CTLA-4）下可能具有截然相反的免疫调节作用，强调了治疗策略的情境依赖性。",
        "limits": "作为综述，依赖于已发表研究的总结，未提供新的原始实验数据；部分机制（如肌苷的双重作用、特定代谢物的精确剂量效应）仍需更多临床验证；未能涵盖所有可能的微生物代谢物种类。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::8088bfe969136f20bcbd168103c553b99561db66e0efc5839d0774f726178e7a",
      "multiple_values_in_field": false
    },
    "atom::e6a84e8e4a4530184c544641": {
      "atom_id": "atom::e6a84e8e4a4530184c544641",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受PD-1/PD-L1阻断治疗的实体瘤患者及小鼠模型",
        "finding": "粪便中高浓度的短链脂肪酸（SCFAs，如丙酸、丁酸、戊酸）与较长的无进展生存期（PFS）及更好的治疗反应相关；SCFAs通过抑制HDAC、激活GPRs和调节mTOR通路增强CD8+ T细胞的细胞毒性和分化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::726a643f1c5cf3607c95364c09e472c5d5ac44ee63e5e1e5dcf466c20fad6d76",
      "multiple_values_in_field": true
    },
    "atom::4ccaa4344a587186290f3b5e": {
      "atom_id": "atom::4ccaa4344a587186290f3b5e",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受CTLA-4阻断治疗的转移性黑色素瘤患者及小鼠模型",
        "finding": "血清中高浓度的丁酸和丙酸与较差的ICIs疗效负相关；丁酸抑制记忆T细胞的积累和树突状细胞上CD80/CD86的上调，增加Treg比例，从而削弱抗CTLA-4疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::726a643f1c5cf3607c95364c09e472c5d5ac44ee63e5e1e5dcf466c20fad6d76",
      "multiple_values_in_field": true
    },
    "atom::36d5718059c065b3b3c074a7": {
      "atom_id": "atom::36d5718059c065b3b3c074a7",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "膀胱癌和小肠癌小鼠模型",
        "finding": "肠道菌群产生的肌苷（Inosine）可通过A2aR-cAMP-PKA通路促进Th1分化，增加IFN-γ+ CD4+和CD8+ T细胞浸润，增强抗CTLA-4和抗PD-L1疗效；但在缺乏外源IFN-γ时可能抑制Th1分化，且需CpG共刺激。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::726a643f1c5cf3607c95364c09e472c5d5ac44ee63e5e1e5dcf466c20fad6d76",
      "multiple_values_in_field": true
    },
    "atom::1e1bdc01a956b0ad950e688c": {
      "atom_id": "atom::1e1bdc01a956b0ad950e688c",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠肿瘤模型及部分临床数据",
        "finding": "氧化三甲胺（TMAO）通过激活PERK介导的内质网应激和Gasdermin-E介导的细胞焦亡，增强CD8+ T细胞介导的抗肿瘤免疫，提高抗PD-1疗效；高血浆TMAO水平与较长PFS相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::726a643f1c5cf3607c95364c09e472c5d5ac44ee63e5e1e5dcf466c20fad6d76",
      "multiple_values_in_field": true
    },
    "atom::93ea60f675ed97e4c3550dac": {
      "atom_id": "atom::93ea60f675ed97e4c3550dac",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "胰腺导管腺癌小鼠模型 vs. 结肠癌/乳腺癌模型",
        "finding": "乳酸杆菌来源的吲哚类色氨酸代谢物（如Indoles）在胰腺癌中通过激活TAMs上的A2aR抑制CD8+ T细胞释放IFN-γ，抑制免疫；而双歧杆菌产生的ILA可诱导结肠癌细胞凋亡，IPA可抑制乳腺癌生长，显示出色氨酸代谢物效应的异质性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
