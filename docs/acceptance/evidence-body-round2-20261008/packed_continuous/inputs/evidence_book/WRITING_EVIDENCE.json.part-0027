      "multiple_values_in_field": true
    },
    "atom::2a2ad8f127a3e2f7fb383b60": {
      "atom_id": "atom::2a2ad8f127a3e2f7fb383b60",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "短链脂肪酸（SCFAs）的作用",
        "finding": "SCFAs（如丁酸盐）对ICB的影响具有双重性：通常促进Treg和效应T细胞分化，但在某些情况下（如抗CTLA-4治疗）可能产生负面影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
