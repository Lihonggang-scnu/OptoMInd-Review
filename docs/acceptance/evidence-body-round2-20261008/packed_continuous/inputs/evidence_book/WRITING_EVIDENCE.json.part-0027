    },
    "atom::b33beb873f2d36553ab5f184": {
      "atom_id": "atom::b33beb873f2d36553ab5f184",
      "source_handle": "P0547",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同抗生素类别",
        "finding": "部分分析显示氟喹诺酮类与其他类别相比与更差的生存率相关，提示可能存在类别特异性效应而非统一的抗生素风险。"
      },
      "role": "evidence",
