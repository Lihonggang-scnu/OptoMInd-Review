    "atom::97db6278f07b6d2c881ba3ee": {
      "atom_id": "atom::97db6278f07b6d2c881ba3ee",
      "source_handle": "P0564",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述包含多种实体瘤（肺癌、黑色素瘤、肾癌、肝癌等），不同癌种的微生物特征和ICI疗效关系可能存在差异，应用时需考虑癌种特异性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
