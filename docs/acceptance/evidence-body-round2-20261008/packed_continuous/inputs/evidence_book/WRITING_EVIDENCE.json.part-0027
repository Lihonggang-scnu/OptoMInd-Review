    "atom::57385b54d5b2477dd3e654c4": {
      "atom_id": "atom::57385b54d5b2477dd3e654c4",
      "source_handle": "P0564",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "所引用的机制研究（如抗原呈递、T细胞功能）多为小样本探索性研究，其普适性需谨慎对待。",
      "role": "evidence",
      "origins": [
