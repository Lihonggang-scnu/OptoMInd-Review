    "atom::4a33dc878424e5c612918cf2": {
      "atom_id": "atom::4a33dc878424e5c612918cf2",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "分子模拟机制",
        "finding": "E. hirae中的噬菌体尾长测量蛋白（TMP）含有与宿主PSMB4蛋白相似的表位，引发交叉反应性CD8+ T细胞，增强抗PD-1疗效。"
      },
