    "atom::797d3a421d1f68362d67ff56": {
      "atom_id": "atom::797d3a421d1f68362d67ff56",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性机制综述的方法，结合结构化文献检索。检索范围涵盖PubMed/MEDLINE、Embase和Scopus数据库（2010年1月至2026年3月）。筛选标准侧重于具有机制见解和临床应用价值的原创研究、临床试验和高影响力综述。数据提取聚焦于分类特征、生化通路和临床结果，并使用“机制框架分析”将发现归类为系统性免疫调节、局部肿瘤微环境变化和异生物质代谢。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::9383bb2fbc2f267c434749e6552d9e6ca55e215bd7e5e07d436ec5f4084be422",
      "multiple_values_in_field": false
    },
    "atom::fdbb1bb278c9d55b926ad36d": {
      "atom_id": "atom::fdbb1bb278c9d55b926ad36d",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统性地整合了微生物组影响癌症治疗疗效和毒性的多种机制，包括代谢物介导的免疫调节、瘤内微生物群的直接药物相互作用以及性别特异性差异。",
        "limits": "作为叙述性综述，其证据等级依赖于所选文献的代表性和作者的解释框架；未提供新的原始实验数据或严格的荟萃分析统计结果；不同人群（如东西方）的微生物基线差异可能导致普适性限制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::40779549b4aed51ee6b26daa2622ac0157c01e84e10d29972a56c4d835b008ee",
      "multiple_values_in_field": false
    },
    "atom::b441a0e563eea1ef2fc56dea": {
      "atom_id": "atom::b441a0e563eea1ef2fc56dea",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受免疫检查点抑制剂治疗的实体瘤患者",
        "finding": "特定的细菌组合（如Akkermansia muciniphila、Ruminococcaceae家族成员）及其产生的生物活性代谢物（肌苷、短链脂肪酸、色氨酸衍生物）是ICI成功的关键先决条件；抗生素使用与ICI疗效降低相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::d8197d25e0243d9bf6ca4802585af8ef3790334a3865b612e8b30494eff1839d",
      "multiple_values_in_field": true
    },
    "atom::2ea197db957bf7d3cfdcc713": {
      "atom_id": "atom::2ea197db957bf7d3cfdcc713",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "胰腺癌等实体瘤的微环境",
        "finding": "瘤内微生物群（主要是Gammaproteobacteria）表达胞苷脱氨酶（CDA），可将吉西他滨转化为无活性形式，导致化疗耐药；消除这些细菌可恢复药物疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::d8197d25e0243d9bf6ca4802585af8ef3790334a3865b612e8b30494eff1839d",
      "multiple_values_in_field": true
    },
    "atom::509a27efd20b1e28804a2fdc": {
      "atom_id": "atom::509a27efd20b1e28804a2fdc",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "全身免疫系统调节",
        "finding": "短链脂肪酸（特别是丁酸盐）作为组蛋白去乙酰化酶抑制剂，增强T细胞适应性；肌苷通过腺苷A2A受体信号通路增强Th1分化，绕过肿瘤微环境的抑制信号。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::d8197d25e0243d9bf6ca4802585af8ef3790334a3865b612e8b30494eff1839d",
      "multiple_values_in_field": true
    },
    "atom::9e9df2e7f615e7f48d48fd7e": {
      "atom_id": "atom::9e9df2e7f615e7f48d48fd7e",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "异生物质代谢与毒性",
        "finding": "肠道细菌产生的β-葡萄糖醛酸酶可重新激活伊立替康，导致严重的黏膜损伤和腹泻；微生物特征可用于预测药物诱导的毒性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::d8197d25e0243d9bf6ca4802585af8ef3790334a3865b612e8b30494eff1839d",
      "multiple_values_in_field": true
    },
    "atom::4b580cf8eb1d746db1a372d5": {
      "atom_id": "atom::4b580cf8eb1d746db1a372d5",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "造血干细胞移植（HSCT）后",
        "finding": "肠道微生物多样性丧失是移植相关死亡和移植物抗宿主病（GVHD）的独立风险因素；Blautia属与GVHD相关死亡率降低有关，而肠球菌属扩张加剧炎症。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::d8197d25e0243d9bf6ca4802585af8ef3790334a3865b612e8b30494eff1839d",
      "multiple_values_in_field": true
    },
    "atom::f209ce7fa8f5c1d829658755": {
      "atom_id": "atom::f209ce7fa8f5c1d829658755",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::2de8dde6c9b9124cde38b865722c4cda6dd3bfc066e88ef0ff7ea447d20970a6",
      "multiple_values_in_field": false
    },
    "atom::7550f9285711774c6b8d8c12": {
      "atom_id": "atom::7550f9285711774c6b8d8c12",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "现代肿瘤学正从将肿瘤视为孤立组织块转向将其视为复杂多物种生态系统的一部分。本研究旨在解决的关键问题是：微生物组（特别是肠道和瘤内微生物群）如何调节宿主抗肿瘤免疫，并具体通过哪些机制影响当前化疗和免疫治疗方案的疗效和毒性？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::76154f5be690c5e6df10df45ab1ba0560bcdfeaad1dfa7f7f1cb86b5792010ec",
      "multiple_values_in_field": false
    },
    "atom::fa09930a8f323cd8b3d7bdfe": {
      "atom_id": "atom::fa09930a8f323cd8b3d7bdfe",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "肿瘤治疗中的微生物组-宿主轴，涵盖肠道微生物群、瘤内微生物群及其对免疫检查点抑制剂（ICIs）疗效和化疗毒性的影响。研究对象包括成人及儿科实体瘤和血液恶性肿瘤患者，涉及机制模型、临床队列和代谢组学数据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::c72efe37f7929eb43af099fee3c0d0929c9eb34813868fa03c617cb5eec200dc",
      "multiple_values_in_field": false
    },
    "atom::e69c0f1b8396d14a848d7c3e": {
      "atom_id": "atom::e69c0f1b8396d14a848d7c3e",
      "source_handle": "P0124",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本文是一篇叙述性机制综述，旨在全面分析微生物组-宿主轴在癌症治疗中的作用。文章综合了57篇关键文献，探讨了特定细菌群落及其生物活性代谢物（如肌苷、短链脂肪酸、色氨酸衍生物）如何作为免疫检查点抑制剂成功的先决条件。此外，还讨论了细菌酶（如胞苷脱氨酶）在局部药物降解和化疗耐药中的作用，以及新兴的“微生物性别组”在治疗反应和毒性谱中的性别特异性差异。结论强调将微生物监测纳入标准临床协议对于个性化肿瘤治疗和长期生存质量的重要性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::0d171b9b0e703ff5f9297cb7e315a480c38c6f8aee8ca4ed64b0ec507dd546e1",
      "multiple_values_in_field": false
    },
    "atom::6a7cff23d275b7d35b240921": {
      "atom_id": "atom::6a7cff23d275b7d35b240921",
      "source_handle": "P0124",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物群如何调节实体瘤中免疫检查点抑制剂（ICI）的疗效提供了详细的机制背景。它特别强调了特定细菌代谢物（如肌苷、SCFAs）和瘤内微生物酶（如CDA）的具体作用路径，这对于回答“微生物组如何调节ICI疗效”及其“介导机制”至关重要。同时，它也提供了关于抗生素使用、饮食干预和粪菌移植（FMT）等临床策略的背景信息。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::0d860cad987f10c34f4698e7ffc773f19331eee3c6c95b128550ba9b3152850a",
      "multiple_values_in_field": false
    },
    "atom::4002992b9211ba4203b37df2": {
      "atom_id": "atom::4002992b9211ba4203b37df2",
      "source_handle": "P0124",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要基于综述引用的观察性研究和临床试验结果，具体关联强度因研究而异；未提供统一的量化效应值。",
        "contribution": "提供了特定肠道菌群（如Akkermansia muciniphila, Bifidobacterium pseudolongum）与ICI疗效正相关的证据，以及抗生素使用导致疗效下降的观察结果。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
