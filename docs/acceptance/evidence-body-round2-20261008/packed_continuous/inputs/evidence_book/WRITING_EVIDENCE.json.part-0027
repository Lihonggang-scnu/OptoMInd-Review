    "atom::3f5f0daf2a7d5184926a1115": {
      "atom_id": "atom::3f5f0daf2a7d5184926a1115",
      "source_handle": "P0209",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于支持“特定微生物代谢物能预测或伴随ICI疗效”的观点，作为微生物组调节免疫治疗有效性的临床证据之一。",
      "role": "planning",
      "origins": [
