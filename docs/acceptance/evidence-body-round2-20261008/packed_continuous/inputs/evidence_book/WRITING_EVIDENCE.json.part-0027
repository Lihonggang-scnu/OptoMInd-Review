            "0"
          ]
        }
      ],
      "variant_group": "field::c2514ebd6f1702457b8099bec056e9f8bc0400d1c6c84094dc86eefe69af0f1f",
      "multiple_values_in_field": true
    },
    "atom::33965bfc7521fb669b7873d2": {
      "atom_id": "atom::33965bfc7521fb669b7873d2",
      "source_handle": "P0124",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于支持肠道微生物群组成是影响ICI疗效的关键因素这一论点，并可作为比较不同研究中菌群特征的基准。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
          "field_path": [
