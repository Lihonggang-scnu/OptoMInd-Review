    "atom::4abe48e8e01b0acc7b17e16a": {
      "atom_id": "atom::4abe48e8e01b0acc7b17e16a",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肌苷（Inosine）通路",
        "finding": "B. pseudolongum等产生的肌苷通过结合T细胞上的A2AR受体，协同TLR9激动剂增强抗CTLA-4疗效，但单独使用不足以完全重现表型。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
