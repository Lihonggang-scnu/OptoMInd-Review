          ]
        }
      ],
      "variant_group": "field::550caa86ae9aa0cb750962731d2c086e53307ed4cebdee4488ca11ddb9d9d2db",
      "multiple_values_in_field": true
    },
    "atom::d73bbddfc536c0c0f0dd7141": {
      "atom_id": "atom::d73bbddfc536c0c0f0dd7141",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "展示如何更准确地模拟体内微环境以研究免疫治疗机制，可能启发对其他研究中模型选择的评估。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::8de5fa20bb1d462006e562f12933e512af41165eecb2fb9292c63b917d528afa",
      "multiple_values_in_field": true
    },
    "atom::b4f974291ec8a2895147fd89": {
      "atom_id": "atom::b4f974291ec8a2895147fd89",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "介绍一种用于研究肿瘤-免疫-基质相互作用的先进体外模型（3D异型球体），为综述中提到的研究方法学提供参考。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::3e16cc091486d8bf92e42b2aef298e82c84cd915df767a39d3ba3afd6e524898",
      "multiple_values_in_field": true
    },
    "atom::8121765f2d33d98b9a499eae": {
      "atom_id": "atom::8121765f2d33d98b9a499eae",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限于PDAC模型和体外实验结果；未直接展示与肠道菌群的交互；未直接测试ICI单药或联合ICI的最终响应率，仅推断其增敏潜力。",
        "contribution": "提供了CAFs通过产生ECM和调节免疫细胞浸润来介导PDAC免疫抑制的具体机制细节；展示了IL-15联合化疗如何通过增加效应T细胞和NK细胞浸润及其活化（IFNγ, Granzyme B）来克服这种抑制。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::ba1555e2cbf34eb7d2e5975b8917a0c218a2b1be38c7372db0b7eadc8689e0f8",
      "multiple_values_in_field": true
    },
    "atom::818565d05a958d5805913b0a": {
      "atom_id": "atom::818565d05a958d5805913b0a",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释固体瘤中非肿瘤细胞成分（如CAFs）如何构成免疫治疗屏障，以及针对这些基质成分的联合策略如何恢复免疫监视。可用作机制层面的例证，说明微环境重塑是增强ICI疗效的一种途径。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::3010b46ff761a2f8d219fcf539794f416063f6395133e083093655203d304005",
      "multiple_values_in_field": true
    },
    "atom::fd72b2c63bb5ecd391404f65": {
      "atom_id": "atom::fd72b2c63bb5ecd391404f65",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "不涉及肠道菌群本身或其代谢产物；不能直接回答菌群如何调制ICI疗效，只能说明微环境的其他方面同样重要。",
        "contribution": "间接相关：展示了在不依赖肠道菌群的情况下，通过药物组合（IL-15+化疗）改变局部微环境以增强免疫反应的可能性。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::ba1555e2cbf34eb7d2e5975b8917a0c218a2b1be38c7372db0b7eadc8689e0f8",
      "multiple_values_in_field": true
    },
    "atom::7bc774d958521b68324fcd76": {
      "atom_id": "atom::7bc774d958521b68324fcd76",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "作为对照或背景信息，用于讨论除了微生物调节外，宿主自身微环境因素（如基质密度、CAFs活性）也是决定ICI疗效的关键变量。有助于全面理解“哪些因素调制ICI疗效”。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::3010b46ff761a2f8d219fcf539794f416063f6395133e083093655203d304005",
      "multiple_values_in_field": true
    },
    "atom::e4204913f285a0a024405cdc": {
      "atom_id": "atom::e4204913f285a0a024405cdc",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了一个关于PDAC肿瘤微环境中CAFs介导免疫抑制的具体机制证据，以及IL-15联合化疗逆转这种抑制、增强免疫浸润的实验数据。对于综述而言，它提供了固体瘤中非微生物因素（基质成分）如何影响免疫治疗响应的具体案例，特别是展示了如何通过重塑微环境来潜在增敏免疫检查点抑制剂。虽然不直接涉及肠道菌群，但其揭示的“基质-免疫”互作机制可作为对比或背景，用于讨论除微生物外的其他微环境调控因素。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::5141e5e22cb2edf3ff0afb772b339acd4a9546fc0f6de071e81eb551fe587f4e",
      "multiple_values_in_field": false
    },
    "atom::c2f84871ae9ff129ffa627bd": {
      "atom_id": "atom::c2f84871ae9ff129ffa627bd",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究仅在体外3D模型中进行，其发现的免疫浸润增强和抗肿瘤效果尚未在体内动物模型或人体临床试验中得到验证。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::0579f860283309e20fb50c80fa243e31adccc31a6e04a8fe347036855c0956c5",
      "multiple_values_in_field": true
    },
    "atom::2ca004664fa5d6006e05d602": {
      "atom_id": "atom::2ca004664fa5d6006e05d602",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "IL-15联合化疗的效果是在PDAC特定背景下观察到的，不能直接外推至所有类型的固体瘤。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0579f860283309e20fb50c80fa243e31adccc31a6e04a8fe347036855c0956c5",
      "multiple_values_in_field": true
    },
    "atom::8da0b84f853c4edc59889b40": {
      "atom_id": "atom::8da0b84f853c4edc59889b40",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "虽然目标是增敏ICI，但本摘要未报告ICI（如抗PD1）的实际联合使用结果，仅提及未来计划。因此，不能据此断言该策略已证实能增敏ICI。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::0579f860283309e20fb50c80fa243e31adccc31a6e04a8fe347036855c0956c5",
      "multiple_values_in_field": true
    },
    "atom::607d75ac9a0e62020785db54": {
      "atom_id": "atom::607d75ac9a0e62020785db54",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "使用的PBMCs来自健康供体，而非PDAC患者，这可能无法完全反映患者体内耗竭或异常免疫细胞的状态。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "3"
          ]
        }
      ],
      "variant_group": "field::0579f860283309e20fb50c80fa243e31adccc31a6e04a8fe347036855c0956c5",
      "multiple_values_in_field": true
