    "atom::c39ac91daaf79faae9546bf8": {
      "atom_id": "atom::c39ac91daaf79faae9546bf8",
      "source_handle": "P0061",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "仅报告了总体队列和按使用时长的亚组分析，未报告按抗生素类别、肿瘤类型或CPI类型的分层分析，限制了结果的泛化性。",
