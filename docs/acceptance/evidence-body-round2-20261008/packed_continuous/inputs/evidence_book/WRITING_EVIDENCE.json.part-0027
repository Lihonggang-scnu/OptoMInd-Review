    "atom::329da487d85d9d75356b7d93": {
      "atom_id": "atom::329da487d85d9d75356b7d93",
      "source_handle": "P0564",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些机制描述主要引用自被综述的研究（如Gopalakrishnan et al., Frankel et al.），本综述本身未进行新的机制实验验证；机制细节在不同研究中表述不一，需结合原文进一步确认。",
        "contribution": "提出了潜在的机制解释：有益菌群通过增强抗原呈递和改善效应T细胞功能来增强抗肿瘤免疫；有害菌群或抗生素引起的菌群失调导致抗原呈递减弱和肿瘤内淋巴/髓系浸润不足。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
