    "atom::e7fda87890cf100670bbed03": {
      "atom_id": "atom::e7fda87890cf100670bbed03",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Enterococcus sagA蛋白与NOD2通路",
        "finding": "肠球菌表达的SagA蛋白降解肽聚糖产生muropeptides，激活宿主NOD2受体，促进炎症环境和CD8+ T细胞浸润。"
      },
      "role": "evidence",
      "origins": [
