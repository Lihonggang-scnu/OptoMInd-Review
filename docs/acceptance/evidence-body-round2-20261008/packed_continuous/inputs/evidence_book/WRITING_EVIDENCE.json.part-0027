    "atom::3bca396122a57c5c6cb6d384": {
      "atom_id": "atom::3bca396122a57c5c6cb6d384",
      "source_handle": "P0124",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制描述主要来源于体外实验和小鼠模型，部分在人体中的验证程度在所给材料中未完全交代；不同代谢物之间的协同作用细节有限。",
        "contribution": "详细阐述了肌苷通过A2A受体信号通路增强Th1分化的机制，以及短链脂肪酸（丁酸盐）通过表观遗传修饰和代谢重编程增强CD8+ T细胞功能的机制。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374",
