    "atom::07f07877dcebdfd835240f4c": {
      "atom_id": "atom::07f07877dcebdfd835240f4c",
      "source_handle": "P0251",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "对比了生态方法（FMT、饮食调整、定义菌群）与还原论方法（小分子、工程化益生菌）的优缺点。指出前者面临标准化和个体差异挑战，后者更具精准性但开发难度大。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1"
          ]
        },
        {
