    "atom::81de4c9543a29d42bda91fff": {
      "atom_id": "atom::81de4c9543a29d42bda91fff",
      "source_handle": "P0424",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "生存分析（训练集）",
        "finding": "Lachnoclostridium高丰度且Prevotella 9低丰度的“良好”微生物特征组合显著预测更好的总生存期（OS）。在多变量Cox模型中，该特征仍是OS的独立预测因子。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a43af420403a250e3f63baf03447951c2efc1015280fcab4046f9358bfa219b1",
          "field_path": [
