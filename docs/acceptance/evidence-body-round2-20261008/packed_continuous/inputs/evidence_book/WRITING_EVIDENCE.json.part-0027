        "connection_to_review"
      ],
      "value": "可用于综述的背景部分，说明当前研究的局限性及未来方向，强调从单一细菌关注扩展到多界微生物和全身微生态系统的必要性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
