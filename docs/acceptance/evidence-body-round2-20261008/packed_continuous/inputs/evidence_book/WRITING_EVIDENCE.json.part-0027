    "atom::0f036c918cd390f5edcdaebe": {
      "atom_id": "atom::0f036c918cd390f5edcdaebe",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用还原论视角，从生态水平的菌群相关性分析转向分子水平的机制解析。具体路线包括：1) 梳理建立相关性的大规模测序研究和动物模型实验；2) 验证相关性并识别宿主表型（如CD8+ T细胞浸润）；3) 深入探讨具体的分子机制，分为T细胞刺激、髓系细胞刺激和分子模拟三个子主题；4) 评估基于分子机制的工程化益生菌应用前景。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::6c9adb8dafbf57ee773f2f0979d81c6a6b1ef9f270b51ab7fbbe22075859a989",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::07dab5fb190d6514436b95df08b036ea0e8b1ef23d7faa7d61240030466db81e",
      "multiple_values_in_field": false
    },
    "atom::e6663c1509a79bf070ff83d5": {
      "atom_id": "atom::e6663c1509a79bf070ff83d5",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统性地从分类学相关性过渡到分子机制，详细列举了多种微生物代谢物和蛋白质如何通过特定受体（GPCRs, A2AR, STING, NOD2, TLR5）和信号通路影响宿主免疫系统。",
        "limits": "所给摘要未交代具体的文献检索策略和纳入排除标准；主要依赖已发表的小鼠模型和少量临床数据，缺乏大规模前瞻性干预试验的直接证据；对于非细菌类微生物（真菌、古菌）及抑制性微生物的关注不足。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::6c9adb8dafbf57ee773f2f0979d81c6a6b1ef9f270b51ab7fbbe22075859a989",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::353074f7e9890c43dcdf17e833d17393388521422a2b207362bb2902b133a93d",
      "multiple_values_in_field": false
    },
    "atom::efc4edd784b59555aab5bd43": {
      "atom_id": "atom::efc4edd784b59555aab5bd43",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠模型及患者队列中的相关性研究",
        "finding": "特定细菌属（如双歧杆菌、拟杆菌、阿克曼氏菌、普拉梭菌）的存在与ICB疗效正相关，但不同研究间结果存在异质性，且相关性不等于因果性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
            "study_summary_A",
            "key_findings",
