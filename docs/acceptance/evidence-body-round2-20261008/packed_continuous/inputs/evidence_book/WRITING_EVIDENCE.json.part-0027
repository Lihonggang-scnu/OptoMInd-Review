    "atom::43162a461155225b85089ba5": {
      "atom_id": "atom::43162a461155225b85089ba5",
      "source_handle": "P0052",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究仅针对非小细胞肺癌（NSCLC），在将其结论应用于其他实体瘤（如黑色素瘤、肾癌等，这些也是ICI研究热点）时需格外谨慎，尽管机制可能相似，但效应大小可能不同。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::29b2e791ffadef6009ebde09934c8f52a55536156d92e802ac5de914dc06a226",
      "multiple_values_in_field": true
    },
    "atom::06b11c6b33c0657f52d70e12": {
      "atom_id": "atom::06b11c6b33c0657f52d70e12",
      "source_handle": "P0052",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗生素是一个异质性群体，本研究未区分抗生素的种类、谱系或疗程，因此“抗生素”作为一个整体类别的效应掩盖了潜在的差异性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::29b2e791ffadef6009ebde09934c8f52a55536156d92e802ac5de914dc06a226",
      "multiple_values_in_field": true
    },
    "atom::46c7117af78a699a33d170c9": {
      "atom_id": "atom::46c7117af78a699a33d170c9",
      "source_handle": "P0052",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "观察性研究的汇总存在固有的混杂偏倚风险（如抗生素使用可能与感染严重程度、一般健康状况相关），尽管荟萃分析试图控制，但不能完全确立因果关系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::29b2e791ffadef6009ebde09934c8f52a55536156d92e802ac5de914dc06a226",
      "multiple_values_in_field": true
    },
    "atom::566faadc0c97ad2f9a4e567d": {
      "atom_id": "atom::566faadc0c97ad2f9a4e567d",
      "source_handle": "P0052",
      "field_path": [
