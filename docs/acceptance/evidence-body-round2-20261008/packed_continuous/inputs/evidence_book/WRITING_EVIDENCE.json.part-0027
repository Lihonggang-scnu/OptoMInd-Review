    "atom::984f00d5107ee7976faec997": {
      "atom_id": "atom::984f00d5107ee7976faec997",
      "source_handle": "P0564",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "综述未涵盖益生菌、粪便微生物移植（FMT）等其他微生物干预措施的效果，因此不能据此推断所有微生物调节手段的有效性。",
