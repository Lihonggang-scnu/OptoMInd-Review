            "1"
          ]
        }
      ],
      "variant_group": "field::f6587ffec914f09ed2e5e16dbec7e281ce7098608d326094cfae8c6eb604ad62",
      "multiple_values_in_field": true
    },
    "atom::d04137336fdb4b225e907ac7": {
      "atom_id": "atom::d04137336fdb4b225e907ac7",
      "source_handle": "P0481",
      "field_path": [
