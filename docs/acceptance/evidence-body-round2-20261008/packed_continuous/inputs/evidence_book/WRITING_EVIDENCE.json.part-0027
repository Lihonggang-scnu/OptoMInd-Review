            "broader_review_uses",
            "1"
          ]
        }
      ],
      "variant_group": "field::6a1d5f494265cb0b0084e3b55e13d257c50db7d1230fa9a0cb4364addde0acaf",
      "multiple_values_in_field": true
    },
    "atom::7043fd94541357a3fdd5e8ac": {
      "atom_id": "atom::7043fd94541357a3fdd5e8ac",
      "source_handle": "P0251",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "可用于讨论部分，比较不同干预策略的可行性、精准度和临床转化潜力，为提出综合治疗建议提供依据。",
      "role": "planning",
      "origins": [
