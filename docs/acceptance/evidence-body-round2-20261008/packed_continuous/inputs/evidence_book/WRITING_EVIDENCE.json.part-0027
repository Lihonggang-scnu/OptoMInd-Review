    "atom::511c6539987cda5f95a9cca8": {
      "atom_id": "atom::511c6539987cda5f95a9cca8",
      "source_handle": "P0481",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "目前仅为概念验证，缺乏人体临床试验数据支持；需考虑代谢物的给药途径、剂量及稳定性问题。",
        "contribution": "提出了‘代谢物替代疗法’作为克服抗生素相关ICT低响应的潜在策略，证明了补充单一代谢物TDCA即可恢复疗效。",
        "facet_id": "F1"
