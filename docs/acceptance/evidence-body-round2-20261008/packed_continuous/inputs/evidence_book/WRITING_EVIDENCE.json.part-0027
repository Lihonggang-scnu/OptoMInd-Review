    "atom::e31bd726bed36cb5ed5e8fce": {
      "atom_id": "atom::e31bd726bed36cb5ed5e8fce",
      "source_handle": "P0547",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统综述设计。检索策略基于MeSH术语，限定为过去10年内发表的英语人类研究，关键词组合包括抗生素、免疫检查点抑制剂、癌症及治疗结局。从576条记录中筛选出175篇进行详细审查，最终纳入25项报告了按抗生素暴露分层生存结局的研究。分析重点在于比较抗生素暴露组与非暴露组的总体生存率，并考察肿瘤类型、抗生素类别及合并感染状态对结果的调节作用。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e8d01d45808cf092b87f9be9f15c7e72e245cc0726cc9a6dfb762781c1f159ab",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::51bb0ece6d91811f942c880cec0684cc51fa091752a52c30d6af1d936a43df41",
      "multiple_values_in_field": false
    },
    "atom::508c3fe653060c37151841b0": {
      "atom_id": "atom::508c3fe653060c37151841b0",
      "source_handle": "P0547",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于抗生素暴露与ICI疗效关联的大规模汇总证据（25项研究，~73,567例），明确了在非黑色素瘤实体瘤中的负面关联趋势，并识别了黑色素瘤和HCC作为潜在的特异性情境。",
        "limits": "所给摘要未交代具体的数据综合方法（如是否进行Meta分析）、偏倚风险评估细节以及各单项研究的基线特征差异。结论主要基于观察性数据的汇总，因果推断能力受限。作者提出的临床建议（如延迟ICI启动）属于推测性指导，需进一步前瞻性研究验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e8d01d45808cf092b87f9be9f15c7e72e245cc0726cc9a6dfb762781c1f159ab",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::964e571f2ca5a7054afe1ace68999dc54df648c86415fd562d9a85d5e3648ba5",
      "multiple_values_in_field": false
    },
    "atom::dd615146c98f41a4f0d8a8b6": {
      "atom_id": "atom::dd615146c98f41a4f0d8a8b6",
      "source_handle": "P0547",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "除黑色素瘤和特定HCC外的多数实体瘤",
        "finding": "抗生素暴露（治疗前30-60天或期间）与较差的总生存期（OS）显著相关，风险比（HR）范围通常在1.08至2.55之间，个别研究报道风险极高（HR 7.4）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e8d01d45808cf092b87f9be9f15c7e72e245cc0726cc9a6dfb762781c1f159ab",
          "field_path": [
