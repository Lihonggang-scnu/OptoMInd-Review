    "atom::94a6889bcbe787f7db45c6f2": {
      "atom_id": "atom::94a6889bcbe787f7db45c6f2",
      "source_handle": "P0575",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制解释为作者推测（hypothesis），非实验验证；缺乏微生物组数据支持；无法区分是抗生素直接杀灭了有益菌，还是改变了菌群结构或代谢产物；不同肿瘤类型的差异机制尚不明确。",
        "contribution": "提出了“术后早期是关键脆弱窗口”的临床观察，并推测这与肿瘤反应性T细胞的扩增和致敏阶段重叠。虽然未直接阐明分子机制，但其发现的“术前暴露悖论”（基线较差但术后暴露预后更差）暗示了微生物群在ICI诱导的免疫激活过程中的动态作用。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::abfcf11587495686a3fdc90846cdad2a36b96d1f9170b20018af4840cb171b16",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::7b087c921442d6631743ac746a0ef55fb7b105a6cfbcd65d6655cddc7327aa87",
      "multiple_values_in_field": true
    },
    "atom::dfb58d9aa6b8c461dfa2d5dd": {
      "atom_id": "atom::dfb58d9aa6b8c461dfa2d5dd",
      "source_handle": "P0575",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于讨论部分机制假说，即微生物信号可能在ICI启动后的特定时间窗内对T细胞功能至关重要。可与其他提供具体菌株（如Akkermansia）或代谢物机制的研究形成互补，前者提供临床时间窗证据，后者提供分子路径。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::abfcf11587495686a3fdc90846cdad2a36b96d1f9170b20018af4840cb171b16",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::2f9cab859adcaf63734ca0d5acd9d85c69b53084a153bfff91db3066eeff4318",
      "multiple_values_in_field": true
    },
