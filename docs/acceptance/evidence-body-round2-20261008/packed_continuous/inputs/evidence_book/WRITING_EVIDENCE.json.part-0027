    },
    "atom::11831df00927849d2569d08f": {
      "atom_id": "atom::11831df00927849d2569d08f",
      "source_handle": "P0547",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "摘要未提供具体的分子机制或微生物物种层面的数据，仅停留在临床结局和药物类别层面。不能直接用于解释具体的免疫细胞浸润或信号通路变化，需引用其他机制研究论文补充。",
        "contribution": "提示了抗生素类别特异性（如氟喹诺酮类）和宿主因素（HCC中的肝炎状态）可能调节抗生素对免疫治疗的影响。这暗示了不同的微生物群扰动模式或宿主-微生物互作机制可能导致不同的临床结局。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e8d01d45808cf092b87f9be9f15c7e72e245cc0726cc9a6dfb762781c1f159ab",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::9db6daaf55a32155993057cb4cef576e3aaa905f035a6d12597bdb6cedb9b864",
      "multiple_values_in_field": true
    },
    "atom::7e675a64c5930f45f542cac5": {
      "atom_id": "atom::7e675a64c5930f45f542cac5",
      "source_handle": "P0547",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于讨论机制的复杂性，即并非所有抗生素对微生物群的破坏程度相同，且宿主基础疾病（如慢性病毒感染）可能改变微生物群-免疫轴的平衡。有助于解释为何单一机制模型可能无法涵盖所有临床现象。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e8d01d45808cf092b87f9be9f15c7e72e245cc0726cc9a6dfb762781c1f159ab",
