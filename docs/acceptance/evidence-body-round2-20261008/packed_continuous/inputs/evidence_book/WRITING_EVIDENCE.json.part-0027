      "multiple_values_in_field": true
    },
    "atom::f500276a42430cc5a45e0812": {
      "atom_id": "atom::f500276a42430cc5a45e0812",
      "source_handle": "P0481",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "OT-I转基因小鼠CD8+ T细胞体外杀伤实验及过继转移",
        "finding": "TDCA直接增强抗原特异性CD8+ T细胞的细胞毒性，促进靶细胞死亡；过继转移经TDCA处理的CD8+ T细胞可延缓肿瘤生长。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3655ccef0398dfb4668a60473ea2994f2955bd800b708f1ff71f10ca31884a95",
