    "atom::74c88068f005c81f56b07174": {
      "atom_id": "atom::74c88068f005c81f56b07174",
      "source_handle": "P0481",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于评估不同微生物干预策略的优缺点，为综述中关于未来治疗策略的讨论提供依据。",
      "role": "planning",
