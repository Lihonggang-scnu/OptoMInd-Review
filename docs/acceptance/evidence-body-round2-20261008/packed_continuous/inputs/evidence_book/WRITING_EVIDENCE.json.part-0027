            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::0953e6fab5f81b7b2da82d4bae520d8db67d790c33374d80b87468e157e44838",
      "multiple_values_in_field": true
    },
    "atom::0d88cc9ec2296d5ef9927be6": {
      "atom_id": "atom::0d88cc9ec2296d5ef9927be6",
      "source_handle": "P0424",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "验证集",
        "finding": "具有“良好”微生物特征的患者表现出更长的无进展生存期（PFS: 8.8 vs 1.8个月）和总生存期（OS: 未达vs 6.5个月，p<0.001）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a43af420403a250e3f63baf03447951c2efc1015280fcab4046f9358bfa219b1",
