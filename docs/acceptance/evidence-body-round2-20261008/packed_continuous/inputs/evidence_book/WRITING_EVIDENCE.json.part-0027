    "atom::7e9b749275c2a0633b3a9c10": {
      "atom_id": "atom::7e9b749275c2a0633b3a9c10",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "提供固体瘤（特别是胰腺癌）中基质屏障阻碍免疫治疗的具体实例，丰富综述中关于“物理/生物屏障”影响ICI疗效的背景知识。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::3e16cc091486d8bf92e42b2aef298e82c84cd915df767a39d3ba3afd6e524898",
      "multiple_values_in_field": true
    },
    "atom::b5e0a37b1dce62b652e59150": {
      "atom_id": "atom::b5e0a37b1dce62b652e59150",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "使用PDAC细胞、CAFs和PBMCs构建3D模型，并结合IMC进行空间分析的方法描述。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26e503e28ee99506046ac36b6eb3f94a",
          "field_path": [
            "review_planning_B",
