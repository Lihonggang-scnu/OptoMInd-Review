      "multiple_values_in_field": true
    },
    "atom::3da564e62e72a5b2f97f63e1": {
      "atom_id": "atom::3da564e62e72a5b2f97f63e1",
      "source_handle": "P0061",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "抗生素使用时长亚组分析：≤10天 vs. >10天",
        "finding": "在抗生素使用者中，使用≤10天的患者中位OS为8.8个月（95% CI: 4.2-11.2），而使用>10天的患者中位OS仅为2.8个月（95% CI: 1.2-4.4），差异具有统计学意义（p=0.025，HR 2.0, 95% CI: 1.1-3.7）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::bf3e35a7389266d71780c2b14ec5d3f58ccee4bcf2709b7d1c6aee470881772b",
