            "1"
          ]
        }
      ],
      "variant_group": "field::2453bf56b15239407e16cb89c3dbcc853a5773ebe68f9f781c5fd22bbaa83e55",
      "multiple_values_in_field": true
    },
    "atom::64323e56dab74fcf0143885b": {
      "atom_id": "atom::64323e56dab74fcf0143885b",
      "source_handle": "P0209",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于阐述微生物代谢途径（色氨酸-吲哚通路）如何介导免疫调节，以及特定细菌群落在其中的潜在角色。可作为机制探讨中“微生物-代谢物-免疫细胞”互动的具体案例。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::3e241ae4a3e5d38d53cd830c774b8c9b74bd0e9424e149689f23a4c8a42d6dd2",
