    },
    "atom::3b164cce26337f952c15d4f4": {
      "atom_id": "atom::3b164cce26337f952c15d4f4",
      "source_handle": "P0481",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制验证依赖于TGR5药理学拮抗剂，未排除其他潜在受体或细胞类型的作用；下游信号通路细节尚不明确。",
        "contribution": "揭示了TDCA通过直接结合TGR5受体，增强CD8+ T细胞的效应功能和细胞毒性，从而恢复ICT疗效的分子机制。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3655ccef0398dfb4668a60473ea2994f2955bd800b708f1ff71f10ca31884a95",
          "field_path": [
