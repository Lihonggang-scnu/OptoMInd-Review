    "atom::f51c017331aab2810b6e9b6f": {
      "atom_id": "atom::f51c017331aab2810b6e9b6f",
      "source_handle": "P0061",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "这是一项回顾性审计研究。数据来源为前瞻性收集的患者数据库。纳入标准为在指定时间段内接受CPI治疗的晚期实体瘤患者。暴露变量为抗生素的使用情况（记录CPI前两周及同期使用的抗生素）。主要结局指标为中位PFS和中位OS。统计分析使用SPSS软件进行，包括生存分析和比较两组间的差异。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::bf3e35a7389266d71780c2b14ec5d3f58ccee4bcf2709b7d1c6aee470881772b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::6cb5ca9d957fe3ce102cba778c7f49b20109d16a5dd2bbff9c06356ae2f7a0b4",
      "multiple_values_in_field": false
    },
    "atom::5c946a3613351913b56abfff": {
      "atom_id": "atom::5c946a3613351913b56abfff",
      "source_handle": "P0061",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了来自印度单一中心真实世界环境中，抗生素与CPI联用对晚期实体瘤患者生存影响的初步数据，特别是揭示了抗生素使用时长与OS之间的关联。",
        "limits": "所给摘要未交代具体的统计调整方法（如是否校正了基线特征、肿瘤类型、CPI种类等混杂因素）；样本量较小（N=155）；单中心回顾性设计可能存在选择偏倚；PFS结果不显著，仅OS显示趋势或亚组显著；无法直接推断因果关系，仅能提示关联。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::bf3e35a7389266d71780c2b14ec5d3f58ccee4bcf2709b7d1c6aee470881772b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::2af88c10f96a1d9e7a7726f0ed3997d62431fe2011daac8362a3b371d40d6d63",
      "multiple_values_in_field": false
    },
    "atom::d6d33c000e690eeacf47c6c1": {
      "atom_id": "atom::d6d33c000e690eeacf47c6c1",
      "source_handle": "P0061",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "总体队列对比：抗生素使用组 vs. 非使用组",
        "finding": "中位PFS在抗生素组为1.7个月（95% CI: 1.1-2.3），非抗生素组为3.6个月（95% CI: 2.3-4.8），差异无统计学意义（p=0.912）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::bf3e35a7389266d71780c2b14ec5d3f58ccee4bcf2709b7d1c6aee470881772b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::e6f9dd1a521384e964691c0d35d6c20636e7e05c84586d1ba721be2ec6121c77",
      "multiple_values_in_field": true
    },
    "atom::b38ea4d2cfe0699caf8b8e1f": {
      "atom_id": "atom::b38ea4d2cfe0699caf8b8e1f",
      "source_handle": "P0061",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "总体队列对比：抗生素使用组 vs. 非使用组",
        "finding": "中位OS在抗生素组为3.9个月（95% CI: 1.8-11.4），非抗生素组为9.2个月（95% CI: 4.2-12.3），呈现显著性趋势（p=0.053，HR-1.023; 95%CI: 1.00-1.04）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::bf3e35a7389266d71780c2b14ec5d3f58ccee4bcf2709b7d1c6aee470881772b",
          "field_path": [
