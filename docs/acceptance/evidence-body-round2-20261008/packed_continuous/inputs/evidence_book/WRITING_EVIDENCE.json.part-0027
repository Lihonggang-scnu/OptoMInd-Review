    "atom::10a552f0403c6bc7bd1ba053": {
      "atom_id": "atom::10a552f0403c6bc7bd1ba053",
      "source_handle": "P0564",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用PRISMA 2020指南进行系统综述。检索策略限定于2016-2021年发表的中英文全文，纳入标准包括成人患者、至少接受一种ICI治疗、关注微生物或抗生素对ICI的影响。排除儿童、动物实验、病例报告及无法获取全文的文章。由两名独立审稿人筛选文献、提取数据并进行质量评估（使用Newcastle-Ottawa量表评估队列研究，使用定性研究清单评估综述文章）。最终纳入16篇文章进行综合叙述性总结。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::15e60382df32cc8f5546f1cd04a7fea154c603fec2e1eeda0d218a1d7e25101f",
      "multiple_values_in_field": false
    },
    "atom::52c211f46afcc282555cadea": {
      "atom_id": "atom::52c211f46afcc282555cadea",
      "source_handle": "P0564",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "综合了2016-2021年间关于微生物/抗生素与ICI疗效关联的临床证据，明确了抗生素使用的负面预测价值及特定有益菌群的标志物潜力。",
        "limits": "仅纳入英语文章；未考虑饮食、运动、年龄等混杂因素；缺乏对益生菌等其他微生物调节手段的充分评估；多为观察性研究，因果机制未完全阐明。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::d60d755382d1d4c276ddd19d0827466cb8dd854b429b914bd4d6a4a0c2ea3752",
      "multiple_values_in_field": false
    },
    "atom::be9aed60cc0db2a411ec994c": {
      "atom_id": "atom::be9aed60cc0db2a411ec994c",
      "source_handle": "P0564",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "抗生素使用与ICI疗效的关系",
        "finding": "大多数研究表明抗生素使用与较差的ICI反应率、较短的PFS和OS相关。抗生素使用时间（如ICI开始前30天或开始后6周内）显著影响疗效。广谱抗生素比窄谱抗生素对疗效的负面影响更大。但有一项研究（Kaderbhai et al.）显示抗生素对nivolumab疗效无显著影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::9a94eebddb5ad39285d75b9c083f9370b246afd55f6f3950029e8d4200af5a3a",
      "multiple_values_in_field": true
    },
    "atom::25232d098efcc9ffff732071": {
      "atom_id": "atom::25232d098efcc9ffff732071",
      "source_handle": "P0564",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定微生物群与ICI疗效的关系",
        "finding": "富含Firmicutes门（特别是Faecalibacterium）、Ruminococcaceae家族的菌群与更好的ICI反应、更长的PFS和OS相关，但也可能增加结肠炎风险。富含Bacteroides属的菌群与较差的反应相关。不同ICI药物（如anti-PD-1 vs anti-CTLA-4）对应的优势菌种存在差异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::9a94eebddb5ad39285d75b9c083f9370b246afd55f6f3950029e8d4200af5a3a",
      "multiple_values_in_field": true
    },
    "atom::14307ba04853412ac6827f28": {
      "atom_id": "atom::14307ba04853412ac6827f28",
      "source_handle": "P0564",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物多样性与ICI疗效",
        "finding": "高微生物多样性的患者通常对ICI反应更好，而非响应者往往表现出Proteobacteria的增加和整体多样性的降低。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::9a94eebddb5ad39285d75b9c083f9370b246afd55f6f3950029e8d4200af5a3a",
      "multiple_values_in_field": true
    },
    "atom::52eb6b4ccda8306408681c85": {
