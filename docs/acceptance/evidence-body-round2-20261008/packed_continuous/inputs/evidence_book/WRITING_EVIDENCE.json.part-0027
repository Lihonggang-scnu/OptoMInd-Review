          ]
        }
      ],
      "variant_group": "field::9db6daaf55a32155993057cb4cef576e3aaa905f035a6d12597bdb6cedb9b864",
      "multiple_values_in_field": true
    },
    "atom::1cd394a7fdc40252ac249d6a": {
      "atom_id": "atom::1cd394a7fdc40252ac249d6a",
      "source_handle": "P0547",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于论证微生物群完整性对ICI疗效的重要性，特别是在非黑色素瘤实体瘤中。可作为背景证据说明为何保护微生物群对维持ICI疗效至关重要。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e8d01d45808cf092b87f9be9f15c7e72e245cc0726cc9a6dfb762781c1f159ab",
