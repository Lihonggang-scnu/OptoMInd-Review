    "atom::de9b3c04c3524edaecdf7bc7": {
      "atom_id": "atom::de9b3c04c3524edaecdf7bc7",
      "source_handle": "P0564",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗生素的影响具有时间依赖性（使用前、中、后）和类型依赖性（广谱vs窄谱），简单概括为“抗生素有害”可能忽略具体情境。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
