      "multiple_values_in_field": true
    },
    "atom::d07bb8210ca700dedb9a661a": {
      "atom_id": "atom::d07bb8210ca700dedb9a661a",
      "source_handle": "P0413",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多种癌症模型",
        "finding": "次级胆汁酸代谢物3-oxoLCA和isoLCA通过抑制ROR-γt抑制Th17细胞分化；去氧胆酸（DCA）在某些情况下促进血管生成模拟。"
      },
      "role": "evidence",
