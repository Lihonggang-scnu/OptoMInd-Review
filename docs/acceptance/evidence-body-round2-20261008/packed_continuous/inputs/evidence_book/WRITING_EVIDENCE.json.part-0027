    "atom::195234883ee2c22f9c7f65b8": {
      "atom_id": "atom::195234883ee2c22f9c7f65b8",
      "source_handle": "P0363",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用统一的操作框架（Microbiome → Metabolites → Immune Modulation → TME State → ICI Response）进行综合。首先从机制层面分析微生物代谢物（SCFAs、胆汁酸、色氨酸衍生物、多胺）对适应性免疫细胞（CD8+ T细胞、Treg、Th1/Th17）和固有免疫效应细胞（巨噬细胞、DC、NK细胞）的重编程作用。其次，回顾2015-2018年 landmark 临床研究及后续FMT概念验证试验，评估微生物组成与ICI预后的关联。最后，基于证据等级（观察性数据 vs. 随机对照试验缺失、样本量限制、技术异质性）对FMT、益生菌、饮食干预及下一代微生物制剂进行转化潜力和临床就绪度评估。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4c223c48c000f6845789e3b9d36bdf3513e6445337f93a3a961bc3608c82c611",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::34a888801e8e6d821b26426340c87e03f660d9e8ccd4d5483b2edf8d0e593eaa",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::cecf4315d34ee794cbf0a6cc75b7e83b204d17d7c595870e0afb14f5bbce8277",
      "multiple_values_in_field": false
    },
    "atom::2185cc3f8d466cf3b2e9e28c": {
      "atom_id": "atom::2185cc3f8d466cf3b2e9e28c",
      "source_handle": "P0363",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了一个统一的机制-临床整合框架，明确了肠道微生物组通过代谢物介导的TME重编程路径。",
        "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及偏倚风险评估方法。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4c223c48c000f6845789e3b9d36bdf3513e6445337f93a3a961bc3608c82c611",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::34a888801e8e6d821b26426340c87e03f660d9e8ccd4d5483b2edf8d0e593eaa",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::a8ba844133329f6a4a2dcb8b9ff4eec8dc421c30e5ff9c35df8827d237795908",
      "multiple_values_in_field": true
    },
    "atom::e3b16c024dc89bf6c3b836ae": {
      "atom_id": "atom::e3b16c024dc89bf6c3b836ae",
      "source_handle": "P0363",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "澄清了SCFAs作用的上下文依赖性（Context-dependent），解释了其在不同微环境中的双重角色，纠正了盲目补充的误区。",
        "limits": "关于SCFAs在人体肿瘤中的确切浓度-反应关系尚不明确，所给材料未提供具体的人体肿瘤内SCFA浓度数据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4c223c48c000f6845789e3b9d36bdf3513e6445337f93a3a961bc3608c82c611",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::34a888801e8e6d821b26426340c87e03f660d9e8ccd4d5483b2edf8d0e593eaa",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::a8ba844133329f6a4a2dcb8b9ff4eec8dc421c30e5ff9c35df8827d237795908",
      "multiple_values_in_field": true
    },
    "atom::dce060fe112e7c5c200443c9": {
      "atom_id": "atom::dce060fe112e7c5c200443c9",
      "source_handle": "P0363",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "批判性地评估了微生物组生物标志物的临床就绪度，指出了技术异质性、缺乏前瞻性验证和地理差异等关键局限。",
        "limits": "结论基于已发表的观察性和小规模干预研究，尚未包含大规模多中心前瞻性验证结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4c223c48c000f6845789e3b9d36bdf3513e6445337f93a3a961bc3608c82c611",
          "field_path": [
            "study_summary_A",
