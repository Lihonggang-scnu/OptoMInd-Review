    "atom::c862a9f0e53059cee0615b43": {
      "atom_id": "atom::c862a9f0e53059cee0615b43",
      "source_handle": "P0481",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "TGR5/FXR/VDR报告基因 assay 及体内TGR5拮抗剂（SBI-115）干预",
        "finding": "TDCA主要激活TGR5受体；药理学阻断TGR5可抵消TDCA对肿瘤生长的控制和CD8+ T细胞的效应功能，证实TDCA通过TGR5信号通路发挥作用。"
      },
      "role": "evidence",
      "origins": [
        {
