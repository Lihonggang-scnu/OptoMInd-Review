    "atom::3b21322b3c2a9132505b4be2": {
      "atom_id": "atom::3b21322b3c2a9132505b4be2",
      "source_handle": "P0052",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统综述和荟萃分析方法。文献检索来源为PubMed和主要肿瘤学会议论文集。纳入标准包括报告基于抗生素暴露的HR或Kaplan-Meier曲线（用于OS和PFS），以及ORR和PD数据的研究。统计分析计算合并的HR（OS, PFS）和OR（ORR, PD），并按抗生素暴露的时间窗口进行亚组分析以评估时序效应。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::6d8780cd5bde32a19cb03321f656b0e50ffe2be2cecc4f80208c6895c8ec744d",
      "multiple_values_in_field": false
    },
    "atom::da109f1ebbcdc5d6f2ef54f8": {
      "atom_id": "atom::da109f1ebbcdc5d6f2ef54f8",
      "source_handle": "P0052",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了截至2021年中期的最新大规模荟萃分析证据，量化了抗生素对NSCLC患者ICI治疗OS、PFS、ORR和PD的综合影响，并细化了时间窗口的效应差异。",
        "limits": "所给材料未交代具体的异质性检验结果、发表偏倚评估细节、抗生素种类/疗程的细分分析、以及纳入研究的基线特征平衡情况。机制部分仅引用文献讨论，未在本研究中提供新的实验验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::3913a2beca50ecb40b00a5a2821a7495a39e1215bc9993f3a49627916af70afc",
      "multiple_values_in_field": false
    },
    "atom::6aa00d38dd2f8ad3784ffcaa": {
      "atom_id": "atom::6aa00d38dd2f8ad3784ffcaa",
      "source_handle": "P0052",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "纳入35个独立队列，共12,235名NSCLC患者；比较抗生素暴露组与非暴露组。",
        "finding": "合并HR显示OS为1.63 [95% CI 1.37-1.94]，PFS为1.49 [95% CI 1.26-1.76]，表明抗生素暴露显著降低生存率。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::6ce66203b0bcb16dcc1cc40df9e8bcda4862ff26b573f9556b2fef732c0e4eac",
      "multiple_values_in_field": true
    },
    "atom::b9a8a0e465e1a8a6737b9e5c": {
      "atom_id": "atom::b9a8a0e465e1a8a6737b9e5c",
      "source_handle": "P0052",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "针对ORR和PD的分析，分别纳入1,992名和1,272名患者。",
        "finding": "合并OR显示ORR为0.66 [95% CI 0.44-0.99]，PD为1.98 [95% CI 1.39-2.8]，表明抗生素使用者治疗反应几率降低，疾病进展几率几乎翻倍。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::6ce66203b0bcb16dcc1cc40df9e8bcda4862ff26b573f9556b2fef732c0e4eac",
      "multiple_values_in_field": true
    },
    "atom::65429ad017216a89c4e2c9b4": {
      "atom_id": "atom::65429ad017216a89c4e2c9b4",
      "source_handle": "P0052",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于抗生素暴露时间窗口的亚组分析。",
        "finding": "在ICI启动前后使用抗生素显示出更明显的有害效应。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
