      "multiple_values_in_field": true
    },
    "atom::692ff74a4b546e35a604cdb7": {
      "atom_id": "atom::692ff74a4b546e35a604cdb7",
      "source_handle": "P0413",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些矛盾结果提示了复杂的调控网络，不能简单地将某一代谢物归类为‘好’或‘坏’。",
        "contribution": "指出了代谢物效应的矛盾性和情境依赖性。例如，SCFAs在抗PD-1中有益，在抗CTLA-4中可能有害；色氨酸代谢物在胰腺癌中抑制免疫，在结肠癌中可能抑制肿瘤发生。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::ed8dd713ceb2fcc95eda14ab6581488a077accccf970108bc5a4652768fe07c3",
      "multiple_values_in_field": true
    },
    "atom::3edf66afcfb08e1784360b24": {
