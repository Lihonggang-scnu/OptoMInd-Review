          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::0c838fbaf4faa85f45a53e2762a9a59a83e40df7240462796259ea5ad633bb37",
      "multiple_values_in_field": true
    },
    "atom::4eb4f4671e999f3795550859": {
      "atom_id": "atom::4eb4f4671e999f3795550859",
      "source_handle": "P0251",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "综述指出目前大多数研究集中在细菌，而忽略了真菌、古菌以及具有免疫抑制作用的负相关微生物；同时提到了远端器官（如肿瘤内部）微生物群的潜在作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0"
          ]
        },
        {
