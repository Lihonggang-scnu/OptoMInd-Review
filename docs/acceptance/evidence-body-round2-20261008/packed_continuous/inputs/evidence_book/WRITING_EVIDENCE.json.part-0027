    "atom::c795da1eca5470b6d5a3d608": {
      "atom_id": "atom::c795da1eca5470b6d5a3d608",
      "source_handle": "P0481",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "单细胞RNA测序与流式细胞术分析肿瘤浸润免疫细胞",
        "finding": "TDCA处理增加了肿瘤内效应CD8+ T细胞、γδ T细胞和NK细胞的比例，减少了耗竭型CD8+ T细胞，并提高了IFN-γ、TNF-α和颗粒酶B等效应细胞因子的水平。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3655ccef0398dfb4668a60473ea2994f2955bd800b708f1ff71f10ca31884a95",
