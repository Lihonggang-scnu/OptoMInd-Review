    "atom::ecd58694847575793224fe55": {
      "atom_id": "atom::ecd58694847575793224fe55",
      "source_handle": "P0209",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "微生物来源主要基于计算预测（TrpNet）和小样本测序验证，需注明其推测性质；未直接展示CD8+ T细胞激活等下游机制的实验细节。",
        "contribution": "提出了IPA及其前体（indole pyruvate）的微生物来源假设，并关联了Pasteurellaceae和Lachnospiraceae与初始ICI响应的关系。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3e241ae4a3e5d38d53cd830c774b8c9b74bd0e9424e149689f23a4c8a42d6dd2",
          "field_path": [
