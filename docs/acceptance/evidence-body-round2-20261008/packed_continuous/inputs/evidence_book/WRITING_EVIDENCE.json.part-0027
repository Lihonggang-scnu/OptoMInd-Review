          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::1b7384ac1a7a54bcbd452c6c40b234440b35e2f04b0fe64a0c5f84d6028e7d26",
      "multiple_values_in_field": true
    },
    "atom::39351d21f351bf132aaa24af": {
      "atom_id": "atom::39351d21f351bf132aaa24af",
      "source_handle": "P0251",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "粪菌移植（FMT）和单菌定植实验",
        "finding": "来自响应者的FMT可重现抗肿瘤效应，增加肿瘤内CD8+ T细胞浸润；特定菌株（如A. muciniphila, Bifidobacterium spp.）的单菌定植足以增强ICB疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a711d661f19a142c0c3e45ea8a35fa3da456e65d9624ddb0a9e7af0f413aa26a",
