    "atom::107a3be4bd8567f3889b635f": {
      "atom_id": "atom::107a3be4bd8567f3889b635f",
      "source_handle": "P0481",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "文中指出不同抗生素对菌群和代谢组的扰动程度不同，导致ICT响应差异，这解释了为何临床研究中抗生素对免疫治疗的影响不一致。"
      },
      "role": "evidence",
      "origins": [
        {
