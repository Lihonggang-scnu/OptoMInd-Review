    },
    "atom::f703234a9a62db92de4c7264": {
      "atom_id": "atom::f703234a9a62db92de4c7264",
      "source_handle": "P0481",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "CD4+ T细胞、CD8+ T细胞或NK细胞特异性耗竭实验",
        "finding": "CD8+ T细胞的完全耗竭消除了TDCA的抗肿瘤效应，证明CD8+ T细胞是TDCA介导肿瘤控制的主要效应细胞。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3655ccef0398dfb4668a60473ea2994f2955bd800b708f1ff71f10ca31884a95",
