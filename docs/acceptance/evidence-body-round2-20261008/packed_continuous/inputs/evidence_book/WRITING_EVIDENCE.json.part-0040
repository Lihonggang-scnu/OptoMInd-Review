    "record::fa942646656c220debc219bb0d0ab46789c6676bed1b259b4dc41e8340fd710d": {
      "source_handle": "P0027",
      "title": "Research on microbial communities in tumor microenvironments: cutting-edge dynamics and future trends from a bibliometric perspective",
      "year": "2026",
      "doi": "10.3389/fimmu.2026.1745842",
      "paper_id": "0d116cefa4ed9b159e99be9fd9220ff4e6f7f4a9",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用双轨并行的文献计量与综述综合路线： 1. 宏观知识图谱构建：检索Web of Science Core Collection中关于“intratumoral microbiota”的文献（截至2025年12月22日），经筛选保留1,278篇，使用VOSviewer、CiteSpace和SCImago Graphica进行年度发文量、国家/机构/作者合作网络、关键词共现、聚类及突现词分析，以揭示领域结构和演进路径。 2. 微观干预证据汇总：检索PubMed中与肿瘤内微生物干预抗肿瘤疗效相关的临床研究及临床前试验，依据PICO原则筛选出69项符合条件的研究（包括动物实验、纳米研究、工程菌、RCT等），按肿瘤部位、干预类型、微生物种类及治疗效果（正向/负向）进行分类统计和分析。",
        "contribution_and_limits": [
          {
            "contribution": "提供了肿瘤内微生物研究领域的系统性全景图，明确了从基础关联到机制探索再到临床转化的演进脉络；梳理了针对肿瘤内微生物的干预策略分类及其在联合治疗中的潜在角色；指出了低生物量样本检测中的污染控制这一关键方法论瓶颈。",
            "limits": "作为文献计量学综述，其结论依赖于数据库收录情况和检索策略，可能遗漏非索引或非英文文献； bibliometric指标无法直接反映单篇研究的临床质量或生物学因果机制；对69项干预研究的分析仅为描述性统计，未进行严格的偏倚风险评估或Meta分析；所引用的具体机制细节多来自转述其他研究，本文本身未提供新的原始实验数据。"
          }
        ],
        "key_findings": [
          {
            "conditions": "基于Web of Science数据库的1,278篇文献",
            "finding": "自2012年起发文量总体上升，2020年后显著加速；中国和是美国两大中心；关键词聚类显示“肿瘤免疫治疗”和“免疫微环境”是两大重要分支；具核梭杆菌、肠道微生物群、结直肠癌是高频主题。"
          },
          {
            "conditions": "基于PubMed筛选的69项干预研究",
            "finding": "绝大多数研究（约48/69）报告肿瘤内细菌对治疗产生负面影响（促进耐药或免疫抑制），其中25项涉及具核梭杆菌；部分研究（如乳酸杆菌、阿克曼氏菌）显示对免疫检查点抑制剂有增效作用；目前仅有极少数进入临床试验阶段，大部分仍处于动物模型或体外实验阶段。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "肿瘤内微生物研究领域的发展现状如何？其核心研究热点、合作网络及演进轨迹是什么？目前针对肿瘤内微生物的干预策略（特别是与免疫治疗的结合）处于何种阶段，存在哪些主要挑战和未来方向？",
        "research_scope": "肿瘤微环境（TME）内的微生物群（intratumoral microbiota, ITM），涵盖其分布、与宿主免疫的相互作用、检测技术进展及在抗肿瘤治疗（特别是免疫治疗）中的干预潜力。数据来源为Web of Science和PubMed收录的文献，时间跨度至2025年12月。",
        "work_summary": "本研究是一篇基于文献计量学和可视化分析的综述论文，旨在系统描绘肿瘤内微生物研究领域的知识结构、热点演变及未来趋势。作者利用VOSviewer、CiteSpace等工具对1,278篇WoS核心合集文献进行宏观图谱分析，识别出“肿瘤免疫治疗”和“免疫微环境”为核心聚类；同时整合PubMed数据，筛选出69项针对肿瘤内微生物干预的临床前及临床试验，重点分析了以具核梭杆菌（Fusobacterium nucleatum）为代表的目标菌种在不同癌症类型和治疗模式下的作用效果。研究发现该领域自2020年起进入快速发展期，中国和美国为主要贡献国，当前研究正从单纯的菌群特征描述向机制解析和临床转化过渡，但多数干预手段仍停留在临床前阶段，且面临低生物量带来的污染控制挑战。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述规划提供了关于“肠道微生物群-肿瘤轴”及“肿瘤内微生物对免疫检查点抑制剂（ICI）疗效影响”的宏观背景、研究热点分布及现有干预证据的结构化概览。它特别指出了肠道微生物群在肿瘤定植方面的新兴热点，以及具核梭杆菌等特定菌种在调节ICI疗效中的双重作用（促进或抑制）。虽然缺乏具体的分子机制深度数据，但其对干预策略的分类（如纳米递送、工程菌、益生菌）和对临床转化阶段的评估，有助于定位当前证据的成熟度。",
        "facet_contributions": [
          {
            "boundaries": "仅提供了相关性描述和干预结果的汇总，未深入解释具体的分子或细胞机制；对于“如何调节”的回答仅限于表型结果（如T细胞浸润增加），缺乏通路层面的细节。",
            "contribution": "提供了肠道微生物群与肿瘤内微生物群重叠性的宏观观察，指出乳酸杆菌、双歧杆菌等常见肠道菌也在肿瘤中被检测到；总结了69项干预研究中，不同微生物（包括肠道来源菌）对ICI疗效的影响方向（正向增强或负向抑制），例如Lactobacillus reuteri和Akkermansia muciniphila被报道可增强CD8+ T细胞浸润和ICI疗效。",
            "facet_id": "F1",
            "possible_uses": "可用于回答“肠道微生物群如何调节ICI疗效”中的现象层面问题，即确认哪些肠道相关菌种在肿瘤中存在并表现出特定的疗效调节作用（增强或削弱）。"
          },
          {
            "boundaries": "这些机制描述是基于对其他研究的转述和综述，并非本文的新发现；具体信号通路细节（如miRNA3655/SURF6/IRF7/IFNβ轴）虽被提及，但未在本综述中展开验证；需结合其他提供具体机制实验数据的论文来充实这部分内容。",
            "contribution": "讨论了微生物代谢物（如短链脂肪酸丁酸、乳酸）作为连接微生物与宿主免疫的关键中介因素；提到丁酸可增强TCR信号传导，而厌氧菌产生的乳酸可导致微环境酸化并抑制iNKT细胞功能；强调了多组学整合在揭示微生物-代谢-免疫互作中的重要性。",
            "facet_id": "F2",
            "possible_uses": "可为“介导机制”提供代谢层面的理论框架和假设，特别是关于免疫代谢（immunometabolism）的部分，如丁酸对T细胞的正向作用和乳酸对免疫抑制的微环境影响。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "界定研究背景和现状",
            "material": "肿瘤内微生物研究自2020年后的快速上升趋势，以及从关联研究向机制和临床转化转变的总体轨迹。",
            "purpose": "用于综述引言或背景部分，说明为何关注肿瘤内微生物及其与免疫治疗的交互是当前前沿热点。"
          },
          {
            "connection_to_review": "提供方法学警示",
            "material": "低生物量样本中污染控制的极端重要性，以及不同研究中心间检测标准不统一的问题。",
            "purpose": "在讨论现有证据局限性或设计未来研究时，强调严格质控和标准化流程的必要性，避免将测序假阳性误认为真实定植。"
          },
          {
            "connection_to_review": "列举干预策略类型",
            "material": "针对肿瘤内微生物的多种干预手段，包括特异性清除（纳米药物、疫苗）、重塑微生态（益生菌、工程菌）及联合治疗。",
            "purpose": "作为综述中“治疗策略”部分的分类参考，展示当前除了传统抗生素外，更精准的微生物调控手段正在兴起。"
          }
        ],
        "scope_interpretation_cautions": [
          "该论文是文献计量学和综述性质的文章，其提供的“发现”多为对已有研究的统计归纳和趋势判断，而非新的原始实验证据。",
          "关于肠道微生物群在肿瘤中定植的结论，主要基于对现有文献中共同检出菌群的观察，尚未建立完整的因果链条或定植机制的确证，需谨慎解读其普遍性。",
          "干预研究的效果总结（如“大多数为负面”）是基于纳入的69项研究的简单计数，未考虑研究设计的异质性、肿瘤亚型差异及统计学效力，不能直接推断所有肿瘤内微生物均有害。",
          "文中提到的具体机制（如丁酸、乳酸的作用）是作者对他人研究的综合转述，引用时需追溯原始实验研究以获取确切的分子细节。"
        ],
        "topic_handles": [
          "gut microbiome colonization in tumors",
          "immune checkpoint inhibitors (ICIs) efficacy modulation",
          "Fusobacterium nucleatum in tumor microenvironment",
          "intratumoral microbiota intervention strategies (nano-delivery, engineered bacteria)",
          "low-biomass detection and contamination control",
          "multi-omics integration in tumor microbiome research"
        ]
      },
