    "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca": {
      "source_handle": "P0534",
      "title": "Gut Microbiome Modulation and Outcomes of Immune Checkpoint Inhibitors in Solid Tumors: A Secondary Qualitative Review",
      "year": "2026",
      "doi": "10.25258/ijddt.16.30s.72",
      "paper_id": "ee8eab6a2dc467e53087607197bbc6701429b8ae",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用二次定性综述设计。检索策略包括对PubMed、Europe PMC、Crossref和Google Scholar的结构化搜索，以及对相关文献的向后引文追踪。纳入标准为2017年至2026年4月发表的人类原发性研究，要求提供肠道微生物组组成或微生物组调节暴露与实体瘤ICI临床结局之间的连接。排除综述、动物研究和纯机制实验室论文（但用于背景框架）。最终选取15项具有代表性的主要临床研究，通过解释性主题程序（interpretive thematic procedure）对研究进行编码，按调节类型分类并 juxtapose（并列比较）重复出现的解释模式。",
        "contribution_and_limits": [
          {
            "contribution": "提出了从“分类学焦点”向“功能焦点”和“生态系统模型”的范式转变观点，强调微生物多样性、代谢物相互作用和黏膜屏障活性作为系统性免疫控制层的作用。",
            "limits": "所给摘要未交代具体的统计检验方法或严格的纳入排除评分标准细节；证据基础偏向黑色素瘤，其他实体瘤的干预数据较少；现有研究样本量小、测序平台不统一、缺乏对饮食和地理因素的充分控制，导致无法支持简单的通用处方。"
          }
        ],
        "key_findings": [
          {
            "conditions": "基线微生物特征与响应表型",
            "finding": "响应者表型反复与较高的微生物多样性及特定菌属富集相关，包括Akkermansia、Ruminococcaceae、Faecalibacterium和Bifidobacterium。这种关联在不同肿瘤队列中表现出生态学模式的一致性，但具体物种因人群和测序平台而异。"
          },
          {
            "conditions": "生态干扰与偶然调节（抗生素与益生菌）",
            "finding": "在启动ICI期间无控制的抗生素暴露与较差的预后相关（尤其在上皮肿瘤和非小细胞肺癌中），提示生态脆弱性。益生菌补充的效果数据难以解释，可能受混杂因素影响，且高剂量益生菌有时与多样性降低相关，表明简单的细菌添加不如维持生态完整性重要。"
          },
          {
            "conditions": "治疗性微生物组工程化",
            "finding": "粪便微生物群移植（FMT）、高纤维饮食和活体细菌产品展示了概念验证（proof of concept），证明可以通过治疗性操纵使微生物群落对ICI疗法更具反应性。例如，FMT在抗PD-1难治性黑色素瘤患者中诱导了新的临床反应，CBM588联合疗法在肾癌中显示积极信号。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "传统生物标志物（如PD-L1、TMB）无法充分解释ICI疗效的异质性；需要理解肠道微生物组是否不仅是相关性指标，而是可被重塑以影响免疫状态和治疗的宿主决定因素，以及目前的证据基础在方法学上存在哪些优势与局限。",
        "research_scope": "人类实体肿瘤患者，聚焦肠道微生物组（Gut Microbiome）与免疫检查点抑制剂（ICI）疗效及毒性的关联。涵盖黑色素瘤、非小细胞肺癌、肾细胞癌、肝细胞癌等实体瘤类型。",
        "work_summary": "本文是一篇二次定性综述（Secondary Qualitative Review），旨在综合临床证据，探讨肠道微生物组如何作为宿主决定因素影响实体瘤患者的免疫检查点抑制剂（ICI）反应、生存期及毒性。研究通过结构化搜索PubMed、Europe PMC等数据库并结合引文追踪，筛选出15项主要临床研究进行主题合成。文章未进行定量荟萃分析，而是从响应表型、生态干扰（如抗生素/益生菌暴露）和治疗性工程化（如FMT、饮食干预）三个主题出发，评估微生物组调节的机制合理性与临床可行性。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物组如何作为宿主生态因子调节ICI疗效提供了理论框架和临床证据的综合视图。其核心价值在于将分散的临床观察整合为三个主题：基线生态签名、生态干扰风险和治疗性工程潜力。它不直接提供单一因果机制的实验数据，而是通过主题合成揭示了当前证据的方法学局限性和生物学合理性，有助于界定综述中关于“微生物组作为疗效预测因子”和“微生物组干预策略”的讨论边界。",
        "facet_contributions": [
          {
            "boundaries": "仅基于15项研究的定性合成，非定量荟萃分析；具体菌种的普适性受限，不能直接外推至所有实体瘤亚型；未提供具体的效应量数值。",
            "contribution": "提供了关于肠道微生物组特征与ICI疗效关联的主题综合。指出响应者通常具有高多样性和特定有益菌（Akkermansia, Faecalibacterium等）富集，而抗生素暴露与较差预后相关。同时强调了不同肿瘤类型间具体菌种的不一致性，提示需关注生态整体而非单一标记物。",
            "facet_id": "F1",
            "possible_uses": "可用于回答“肠道微生物组如何调节ICI疗效”中的描述性问题，即哪些微生物特征与疗效正/负相关。可用于论证微生物组作为宿主生物标志物的合理性，同时引用其关于跨肿瘤异质性的发现来限制过度概括。"
          },
          {
            "boundaries": "机制部分主要基于作者引用的理论框架和对现有研究的解读，而非本篇提供的原始实验数据；具体分子通路细节未在文中展开，需结合其他机制研究；干预试验的因果效力尚未在大样本随机对照试验中得到确证。",
            "contribution": "提供了微生物组调节疗效的理论机制框架，包括癌症免疫循环、生态韧性理论和精准宿主调节。解释了为何多样性比单一菌种更重要（生态韧性），以及微生物如何通过抗原呈递、T细胞 priming 和短链脂肪酸生成影响免疫状态。同时指出了当前干预试验（FMT、活体产品）处于早期阶段，机制尚不完全明确。",
            "facet_id": "F2",
            "possible_uses": "可用于回答“介导效应的机制是什么”，提供理论解释路径（如免疫激活、代谢物产生）。可用于讨论为何单纯补充益生菌效果不佳（生态干扰 vs. 主动工程化），并为未来研究指明方向（如标准化采样、功能导向终点）。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "为综述提供理论背景，解释为何传统肿瘤生物标志物不足，以及为何需要引入宿主微生物组视角。",
            "material": "文章提出的从“分类学”到“功能/生态系统”的范式转变，以及癌症免疫循环、生态韧性理论在解释ICI异质性中的应用。",
