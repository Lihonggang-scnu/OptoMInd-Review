    "record::25ed99df7ccdce29b4e0690045bbf72ca8e2ce6ccb9cda48c406f44fca8fee1a": {
      "source_handle": "P0302",
      "title": "Salivary microbiome changes distinguish response to chemoradiotherapy in patients with oral cancer",
      "year": "2023",
      "doi": "10.1186/s40168-023-01677-w",
      "paper_id": "83ee66187aff0ae19e2706481c06aa696e21465b",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "1. **研究对象与样本收集**：纳入109名SCC患者，收集基线（诊断时）和随访期（6个月或12个月）的刺激性全唾液样本。根据治疗方案分为化疗放疗组（n=50基线，n=33配对）、单纯手术组（n=15配对）等亚组。 2. **微生物组分析**：提取唾液DNA，扩增16S rRNA基因V4区，使用Illumina MiSeq测序。利用mothur软件进行序列处理，基于97%相似度聚类OTUs。使用NMDS、AMOVA评估群落结构差异；使用ALDEx2和LEfSe进行差异丰度分析；使用PICRUSt预测KEGG通路功能。 3. **蛋白表达分析**：对部分患者（n=48用于WB，n=28用于ELISA）的唾液样本进行DMBT1蛋白定量，采用Western Blot和ELISA技术，并使用线性混合模型分析时间效应。 4. **动物实验验证**：在裸鼠皮下注射UM-SCC-1细胞构建肿瘤模型，监测肿瘤生长，并在不同时间点收集唾液，通过Western Blot检测DMBT1表达变化，以验证SCC对宿主蛋白表达的抑制作用。 5. **关联分析**：计算唾液DMBT1蛋白表达水平与微生物组OTU丰度之间的Pearson相关系数，探索两者间的联系。",
        "contribution_and_limits": [
          {
            "contribution": "提供了SCC治疗前后唾液微生物组纵向变化的详细图谱，区分了化疗放疗和单纯手术的不同影响模式。",
            "limits": "样本量相对有限，特别是单纯手术组和长期随访数据不足，限制了统计效力和对长期预后的推断。"
          },
          {
            "contribution": "首次在同一队列中将唾液微生物组变化与宿主抗菌蛋白DMBT1的表达联系起来，提出了“微生物-宿主蛋白”互作的可能机制线索。",
            "limits": "相关性分析基于小样本子集（n=20），且为观察性研究，无法确立因果关系；16S测序分辨率限制了对具体菌株功能的精确解析。"
          },
          {
            "contribution": "识别了潜在的预后生物标志物（如基线Prevotella、治疗后Gemella/DMBT1），为无创监测治疗反应提供了方向。",
            "limits": "发现的特异性细菌标记物需在大独立队列中验证；作者承认多种分析方法（ALDEx2 vs LEfSe）结果不一致，提示方法学敏感性。"
          }
        ],
        "key_findings": [
          {
            "conditions": "所有SCC患者治疗后（6个月 vs 基线）",
            "finding": "唾液微生物组的整体丰富度和多样性显著降低；Firmicutes门丰度增加，Bacteroidetes、Fusobacteria和Proteobacteria门丰度减少；Porphyromonaceae和Prevotellaceae科减少，Lactobacillaceae科增加。"
          },
          {
            "conditions": "化疗放疗组（n=33配对）",
            "finding": "治疗后微生物群落结构发生显著变化；Richness降低但Alpha多样性无显著变化；Prevotellaceae、Pasteurellaceae等减少，Lactobacillaceae增加。"
          },
          {
            "conditions": "单纯手术组（n=15配对）",
            "finding": "治疗后Richness显著降低，但群落结构（Beta多样性）和Alpha多样性无显著变化；LEfSe显示术前富集未分类Lactobacillales spp.，术后富集Pseudomonas。"
          },
          {
            "conditions": "化疗放疗响应者 vs 非响应者（基线）",
            "finding": "群落结构有显著差异，但Alpha多样性无差异；LEfSe显示非响应者基线时Prevotella (OTU0029) 丰度较高，而响应者中未分类Pasteurellaceae、Veillonella等较多。"
          },
          {
            "conditions": "化疗放疗响应者 vs 非响应者（治疗后6个月）",
            "finding": "群落结构差异更显著（p=0.006）；响应者中Veillonella、Streptococcus、Rothia、Gemella等丰度较高；PICRUSt预测响应者氨基酸合成代谢通路富集，非响应者糖代谢和脂肪酸合成通路富集。"
          },
          {
            "conditions": "SCC患者唾液DMBT1表达",
            "finding": "治疗前DMBT1表达较低；治疗后6个月和12个月DMBT1表达显著升高（约1.9-2.1倍）。"
          },
          {
            "conditions": "小鼠肿瘤模型（UM-SCC-1注射）",
            "finding": "与对照组相比，携带肿瘤的裸鼠唾液DMBT1分泌显著减少，证实SCC抑制宿主DMBT1表达。"
          },
          {
            "conditions": "DMBT1表达与微生物组相关性",
            "finding": "治疗后DMBT1水平的增加与Gemella、Pasteurellaceae、Lactobacillus和Oribacterium等菌群丰度的增加呈正相关。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "1. SCC治疗（特别是化疗放疗与手术）如何改变患者的唾液微生物组结构和功能？ 2. 治疗前后的唾液微生物组特征是否能预测SCC患者对化疗放疗的反应？ 3. 唾液中的抗菌蛋白DMBT1在治疗过程中的表达变化如何，且其与微生物组的变化是否存在关联？",
        "research_scope": "口腔鳞状细胞癌（SCC）患者的唾液微生物组及抗菌蛋白DMBT1表达；涉及化疗放疗联合治疗与单纯手术治疗的纵向对比，以及治疗反应（响应者vs非响应者）的关联分析。",
        "work_summary": "本研究是一项针对口腔鳞状细胞癌（SCC）患者的纵向研究，旨在探讨癌症治疗对唾液微生物组的影响，并考察这些变化与治疗反应及唾液抗菌蛋白DMBT1表达之间的关联。研究纳入了接受不同治疗方案（化疗放疗、单纯手术等）的患者，通过16S rRNA基因测序分析基线（0个月）和治疗后（6个月）的唾液样本。结果显示，治疗后唾液微生物组的丰富度和多样性普遍降低，且特定菌群结构发生显著变化。在化疗放疗患者中，响应者与未响应者在治疗前后的微生物组成存在差异，其中Prevotella属与非响应相关，而Gemella属等与响应相关。此外，研究发现SCC会抑制唾液DMBT1的表达，治疗后DMBT1水平回升，且DMBT1水平的增加与Gemella等特定菌群的丰度增加呈正相关。该研究首次在同一队列中纵向追踪了SCC治疗引起的唾液微生物组变化及其与宿主免疫蛋白表达的关联。"
      },
      "review_planning_B": {
        "planning_summary": "该论文虽聚焦于口腔鳞状细胞癌（SCC）而非直接研究肠道微生物组与免疫检查点抑制剂（ICIs），但其核心逻辑——即肿瘤微环境/局部微生物组通过调节宿主免疫因子（如DMBT1）进而影响治疗反应——为综述提供了重要的旁证和机制类比素材。它展示了实体瘤治疗（化疗放疗）中微生物组作为预后因子的潜力，以及宿主-微生物互作在调节治疗结局中的作用。对于综述而言，此文可作为“非肠道微生物组在实体瘤治疗反应中的作用”或“宿主免疫蛋白介导的微生物-治疗反应关联”的案例，补充关于局部微环境（口腔）而非全身肠道微生物组的证据，并提示DMBT1等分子可能作为连接微生物与宿主免疫反应的潜在桥梁。",
        "facet_contributions": [
          {
            "boundaries": "研究对象为口腔癌，治疗手段为化疗放疗而非ICIs；样本量较小；仅展示关联性，未证明因果。",
            "contribution": "提供了实体瘤（SCC）中局部微生物组（唾液）与治疗反应（化疗放疗响应）关联的证据。虽然不涉及ICIs，但证明了微生物组特征（如Gemella, Prevotella）可区分响应者与未响应者，支持微生物组作为治疗反应生物标志物的概念。",
            "facet_id": "F1",
            "possible_uses": "用于综述中讨论“微生物组作为实体瘤治疗反应生物标志物的普适性”，或作为“非肠道微生物组在肿瘤治疗中作用”的对比案例，说明局部微环境微生物同样重要。"
          },
          {
            "boundaries": "机制仅为相关性观察，未通过干预实验验证DMBT1是否直接导致菌群变化或改善疗效；DMBT1主要涉及先天免疫凝集作用，与ICIs涉及的适应性免疫（T细胞）机制不同。",
            "contribution": "揭示了宿主抗菌蛋白DMBT1在SCC中被抑制，治疗后恢复，且其水平与特定菌群（Gemella等）正相关。这提供了一个具体的分子机制假设：宿主免疫蛋白可能通过调节微生物组成来影响治疗微环境。",
            "facet_id": "F2",
            "possible_uses": "用于综述中探讨“宿主免疫因子介导的微生物-治疗反应机制”。可作为不同于肠道菌群代谢产物或抗原呈递的另一类机制（黏膜免疫蛋白调节）的例子，丰富对“mechanisms mediate that effect”的理解维度，尽管其直接适用性有限。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "帮助综述理解除了肠道外，其他部位（如口腔、肿瘤局部）微生物组在治疗过程中的动态变化规律，拓宽对“tumor microbiome”范畴的认识。",
            "material": "SCC患者治疗后唾液微生物组多样性降低、特定菌群（Lactobacillaceae增加，Porphyromonaceae减少）变化的描述。",
            "purpose": "提供实体瘤局部微环境微生物组变化的背景知识"
          },
          {
            "connection_to_review": "虽然DMBT1不是ICIs的直接靶点，但该案例支持“宿主免疫状态受微生物调控，进而影响治疗结局”这一更广泛的生物学原理，可与ICIs章节中提到的微生物调节免疫微环境的论述形成互补或对比。",
            "material": "DMBT1在肿瘤状态下被抑制，治疗后恢复并与有益菌群（Gemella）增加相关的发现。",
            "purpose": "作为宿主-微生物互作影响治疗反应的实例"
          },
          {
            "connection_to_review": "在综述的方法学讨论或局限性部分，引用此案例说明微生物组研究中数据分析方法和测序技术对结果解释的影响，强调多中心大样本验证的重要性。",
            "material": "研究中提到ALDEx2和LEfSe分析结果的不一致性，以及16S测序物种分辨率的限制。",
            "purpose": "提示微生物组异质性和方法学挑战"
          }
        ],
        "scope_interpretation_cautions": [
          "本文研究的是口腔鳞状细胞癌（SCC）的化疗放疗反应，而非黑色素瘤或其他实体瘤的免疫检查点抑制剂（ICIs）反应。因此，其发现的微生物标志物（如Gemella, Prevotella）不能直接外推至ICIs疗效预测。",
          "DMBT1是一种唾液抗菌蛋白，主要参与先天免疫和病原体凝集，与ICIs作用的适应性免疫通路（PD-1/PD-L1, CTLA-4）不同。将其机制直接套用于ICIs需谨慎，应视为不同的免疫调节路径。",
          "研究样本量有限（特别是配对样本和长期随访数据），且为单中心研究，结果的普适性有待验证。",
          "微生物组与治疗反应的关联多为观察性，未排除混杂因素（如抗生素使用、口腔卫生状况等）的潜在影响。"
        ],
        "topic_handles": [
          "Oral squamous cell carcinoma (SCC)",
          "Salivary microbiome longitudinal changes",
          "Chemoradiotherapy response prediction",
          "DMBT1 (Deleted in malignant brain tumors 1) expression",
          "Host-microbiome interaction in cancer treatment",
          "Gemella spp., Prevotella spp. as biomarkers",
          "Local mucosal immunity vs systemic gut microbiome"
        ]
      },
