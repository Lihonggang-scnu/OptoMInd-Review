    "record::a5c3368011d84ece3131c8dde30de1dbc801a91e528e0f1c12feeb2411201cc8": {
      "source_handle": "P0295",
      "title": "Checkpoint inhibitor responses can be regulated by the gut microbiota – A systematic review",
      "year": "2023",
      "doi": "10.1016/j.neo.2023.100923",
      "paper_id": "8171fbde7084a1b5b6311504ed716c3a29b3797e",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统综述方法。1. 检索策略：基于PICO框架，在三个主要数据库中搜索关于实体瘤患者ICI治疗与肠道微生物群的研究。2. 筛选：两名审稿人独立筛选摘要和全文，依据纳入/排除标准确定最终18项研究。3. 质量评估：使用修改版的ROBINS-I工具评估偏倚风险；因数据异质性高且缺乏置信区间，未使用GRADE系统评估证据质量。4. 数据合成：定性叙事综合。将细菌按分类学层级整理，并根据其在响应者（R）或无响应者（NR）中的出现情况，归类为“有利预后”或“不良预后”。重点比较不同癌症类型下的细菌分布，并讨论测序技术（16S vs MSS）和方法学差异带来的局限性。",
        "contribution_and_limits": [
          {
            "contribution": "提供了截至2021年关于肠道微生物群与ICI疗效关联的综合图谱，明确了多个具有重复性的潜在预测性细菌物种（如F. prausnitzii, B. obeum）。",
            "limits": "所给摘要未交代具体的统计检验细节（如p值校正方法），仅进行了定性归纳。由于研究间异质性大（测序平台、样本采集时间、癌症类型、ICI药物种类不同），无法得出因果结论或统一的效应量。证据质量被评定为低或极低。"
          },
          {
            "contribution": "指出了当前领域的方法学不一致性，特别是16S rRNA测序与宏基因组鸟枪法测序结果的不可直接比较性，以及粪便样本与黏膜微生物群的差异。",
            "limits": "未能解决选择性报告偏倚的问题，因为许多原始研究的协议未在clinicaltrials.gov注册或未公开。对于混杂因素（如饮食、抗生素使用前的基线状态控制）的处理能力有限，因为原始研究对这些变量的报告不完整。"
          }
        ],
        "key_findings": [
          {
            "conditions": "在所有纳入的实体瘤患者中，对比ICI响应者（R）与无响应者（NR）",
            "finding": "观察到特定的微生物群模式。最常报道与较好预后相关的物种包括：Faecalibacterium prausnitzii, Streptococcus parasanguinis, Bacteroides caccae, 和 Prevotella copri。最常报道与较差预后相关的物种包括：Blautia obeum 和 Bacteroides ovatus。此外，Akkermansia muciniphila 在两组中均有发现，不具有特异性区分度。"
          },
          {
            "conditions": "不同癌症亚组（MM, NSCLC, mRCC, HCC/GI）",
            "finding": "虽然总体趋势一致，但具体细菌丰度和显著性在不同癌症类型间存在差异。例如，F. prausnitzii 在多种癌症中被提及，而某些细菌仅在特定癌症类型的研究中显著。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "动机在于尽管ICI疗法在某些癌症亚组中显示出持久疗效，但患者反应差异巨大且缺乏有效的预测生物标志物。已知肠道微生物群可能调节ICI疗效，但具体哪些微生物特征与反应相关尚不明确。本研究试图通过系统综述厘清粪便微生物群组成与ICI治疗反应（响应vs无响应）之间的关联模式。",
        "research_scope": "针对接受免疫检查点抑制剂（ICI，包括抗PD-1、抗PD-L1或抗CTLA-4）治疗的实体瘤患者，研究其粪便肠道微生物群组成与ICI治疗反应之间的关联。涵盖的癌症类型包括转移性黑色素瘤（MM）、非小细胞肺癌（NSCLC）、转移性肾细胞癌（mRCC）、肝细胞癌（HCC）和胃肠道癌症。",
        "work_summary": "这是一篇2023年发表的系统综述，旨在调查肠道微生物群作为预测生物标志物的潜力。作者遵循PRISMA指南，检索了EMBASE、Medline和Cochrane Library数据库，筛选出18项涉及775名实体瘤患者的队列研究。由于各研究在测序方法（16S rRNA、宏基因组鸟枪法测序等）、癌症类型及反应定义上的异质性，无法进行定量荟萃分析，因此采用定性叙事综合的方法。研究识别出与良好预后（响应者）和不良预后（无响应者）相关的特定细菌物种，并讨论了不同技术方法和混杂因素对结果解释的影响。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关键的实证汇总素材，主要用于回答“哪些肠道微生物与ICI疗效相关”这一描述性问题。它不直接提供机制解释，而是列出了观察到的关联列表。对于规划员而言，其价值在于提供了一个经过筛选的、跨多种癌症类型的细菌清单，可作为后续机制探讨的基础背景，同时其讨论部分关于方法学局限性的内容有助于在综述中解释为何不同研究结果可能存在冲突。",
        "facet_contributions": [
          {
            "boundaries": "仅展示观察性关联，不涉及因果机制。结果受限于原始研究的定义（如RECIST标准 vs irRC标准）和测序深度。不能直接外推至所有ICI药物或所有癌症类型，需结合具体癌症背景使用。",
            "contribution": "提供了具体的细菌物种列表及其与ICI疗效（响应/无响应）的关联方向。例如，确认了F. prausnitzii, S. parasanguinis, B. caccae, P. copri常出现在响应者中，而B. obeum, B. ovatus常出现在无响应者中。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中构建“微生物群特征与临床结局关联”的证据基础，支持或反驳特定细菌作为生物标志物的假设。"
          },
          {
            "boundaries": "本综述未进行功能富集分析或代谢通路分析，因此提供的机制信息是间接的、基于文献引用的，而非本研究的新发现。不能替代专门的机制研究来解释“如何”调节。",
            "contribution": "在讨论部分简要提及了一些细菌的功能背景（如F. prausnitzii维持肠道稳态，B. obeum可能具有抗生素抗性），并引用了其他研究关于FMT（粪菌移植）克服耐药性的案例。",
            "facet_id": "F2",
            "possible_uses": "可作为机制部分的背景引入，提示潜在的生物学通路（如炎症调节、屏障功能），但本综述本身未深入解析分子机制。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "用于综述的方法学批判部分，解释为何不同研究间的微生物组数据难以直接整合，以及未来研究需要标准化测序方法的重要性。",
            "material": "讨论了16S rRNA测序与宏基因组鸟枪法测序（MSS）的技术差异，指出前者覆盖率高但偏差大，后者可分析功能但成本高且易受宿主DNA干扰。",
            "purpose": "提供方法学背景，帮助读者理解现有证据的不一致性来源。"
          },
          {
            "connection_to_review": "用于讨论生物标志物采样的局限性，指出基于粪便的检测可能存在的代表性偏差。",
            "material": "提到粪便样本与黏膜微生物群的差异，以及粪便样本可能无法完全代表与宿主免疫系统相互作用的黏膜相关菌群。",
            "purpose": "提供采样策略的批判性视角，建议未来研究考虑多部位采样或验证粪便与黏膜的一致性。"
          },
          {
            "connection_to_review": "作为干预性证据的背景，说明调节微生物群可能逆转耐药性的可能性，连接观察性发现与治疗应用。",
            "material": "提及FMT在黑色素瘤患者中恢复ICI响应的案例研究。",
            "purpose": "提供从相关性到干预性的过渡素材，支持“微生物群是可调节的治疗靶点”这一论点。"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述包含的是观察性关联，而非因果关系。细菌的存在可能与疗效相关，但不一定导致疗效。",
          "结果受到原始研究中“响应者”定义不一致的影响（部分研究将稳定疾病SD视为响应，部分视为无响应），这可能导致某些细菌的分类模糊。",
          "不同癌症类型的微生物背景不同，不能简单地将一种癌症中发现的细菌标志物推广到其他癌症，除非有跨癌症的一致证据。",
          "由于未进行定量荟萃分析，所谓的“最常被报道”是基于频率的定性判断，而非统计学上的显著优势比。"
        ],
        "topic_handles": [
          "肠道微生物群与ICI疗效的关联",
          "预测性生物标志物：有益菌（Responders-associated bacteria）",
          "预测性生物标志物：有害菌（Non-responders-associated bacteria）",
          "测序技术差异（16S rRNA vs Metagenomic Shotgun Sequencing）",
          "粪便样本作为肠道微生物代理指标的局限性",
          "不同实体瘤类型（黑色素瘤、肺癌、肾癌、肝癌、胃肠癌）中的微生物差异"
        ]
      },
