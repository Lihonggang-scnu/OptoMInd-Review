    "record::00d239e3c8565ecdd8015fe6e4a3374b236994367571e7c90eb742936fcea6d0": {
      "source_handle": "P0436",
      "title": "Abstract 6699: Delineating germline, tumor and extrinsic factors driving mucosal melanoma (MM) risk and response to immune checkpoint inhibitor (ICI) treatment",
      "year": "2024",
      "doi": "10.1158/1538-7445.am2024-6699",
      "paper_id": "bf7682bc64d82a0342f438a261f4ce8de81ed9c0",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用前瞻性纵向队列设计。方法包括：对新鲜肿瘤组织进行全基因组测序（WGS）、RNA测序和T细胞受体（TCR）测序；对FFPE标本进行NanoString数字空间蛋白组学（DSP）；对粪便标本及受累的黏膜和肿瘤部位（拭子）进行全基因组鸟枪法宏基因组分析和16S rRNA基因测序；对正常组织和肿瘤组织进行配对测序。同时收集参与者生活方式、患者报告结果（PROs）和饮食评估。利用新鲜组织开发患者来源的异种移植（PDX）模型和细胞系。",
        "contribution_and_limits": [
          {
            "contribution": "提供了一个大规模、多维度（基因组、转录组、蛋白组、微生物组、临床表型）的前瞻性MM队列的资源框架和基线数据。",
            "limits": "当前仅为中期进展报告，缺乏最终的因果关联分析、机制验证及统计学结论。样本量相对较小（n=98），且为单中心研究，可能限制外推性。"
          }
        ],
        "key_findings": [
          {
            "conditions": "截至2023年11月的初步队列数据（n=98）",
            "finding": "描述了人口统计学特征（中位年龄64岁，白人占85%）、原发部位分布（鼻口腔24%，泌尿生殖道30%，肛门直肠27%等）及临床体细胞突变情况（KIT 16%, NRAS 11%, BRAF 12%）。记录了样本收集进度（血液95例，粪便50例，黏膜拭子38例等）及生存随访数据（中位随访16个月，死亡率18%）。"
          },
          {
            "conditions": "所给摘要未交代最终分析结果",
            "finding": "摘要明确指出这是正在进行的研究，预期将提供关于肿瘤/微环境/宿主相互作用的见解，但具体的微生物组与ICI疗效的相关性发现、机制验证或统计显著性结果在提供的材料中缺失。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "黏膜黑色素瘤的生物学机制尚不清楚，且对ICI治疗反应率低。研究旨在解决如何全面描绘MM患者的分子、微生物组和生活方式特征，以阐明驱动MM风险和ICI治疗反应/耐药的种系、肿瘤和外在因素之间的相互作用。",
        "research_scope": "黏膜黑色素瘤（Mucosal Melanoma, MM）患者队列，涉及分子变异、种系易感性、免疫状态、肠道/黏膜/肿瘤微生物组及可改变风险因素。研究情境为MD Anderson癌症中心的前瞻性纵向收集项目，截至2023年11月数据截止点。",
        "work_summary": "该论文介绍了一项针对罕见且生物学特性独特的黏膜黑色素瘤（MM）的前瞻性、统一且全面的队列研究。鉴于MM具有低免疫原性和低肿瘤突变负荷，其对免疫检查点抑制剂（ICI）的反应率较低，本研究旨在通过多组学 profiling 确定分子变异、种系易感性、宿主免疫、微生物组（肠道、黏膜和肿瘤）以及可改变风险因素与晚期MM中ICI反应和耐药性之间的相互作用。目前处于数据收集和初步分析阶段，已入组98名患者，并建立了包括PDX模型和细胞系在内的生物样本库。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于黏膜黑色素瘤这一特定实体瘤亚型的详细基线特征和多组学数据采集框架。虽然尚未提供最终的微生物组-ICI疗效关联结果，但其详细的样本类型（粪便、黏膜拭子、肿瘤组织）和方法论（宏基因组、16S、DSP）为理解如何在固体肿瘤中整合微生物组数据提供了重要的技术参考和研究设计范例。它特别强调了黏膜部位特异性微生物组与肠道微生物组的并行采集策略。",
        "facet_contributions": [
          {
            "boundaries": "仅提供了数据采集的规模和类型，未提供微生物组组成与ICI疗效的具体相关性数据或统计结果。",
            "contribution": "提供了黏膜黑色素瘤患者队列中肠道微生物组（粪便）与局部微生物组（黏膜/肿瘤拭子）同步采集的方法论实例和基线样本量数据。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中讨论在固体肿瘤研究中如何区分和整合全身（肠道）与局部（肿瘤微环境）微生物组信号的策略。"
          },
          {
            "boundaries": "具体机制通路尚未在摘要中揭示，仅作为计划中的分析路线。",
            "contribution": "介绍了结合数字空间蛋白组学（DSP）与微生物组测序的多组学分析路线，旨在探索宿主-微生物-肿瘤相互作用。",
            "facet_id": "F2",
            "possible_uses": "可作为综述中探讨潜在机制研究手段（如空间定位免疫微环境与微生物群的关联）的技术背景或未来方向参考。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "作为固体肿瘤中微生物组研究的案例，展示罕见肿瘤亚型的数据收集挑战和处理方式。",
            "material": "98例患者的详细人口学、解剖部位分布及体细胞突变谱（KIT/NRAS/BRAF比例）。",
            "purpose": "用于对比不同实体瘤亚型（特别是黏膜vs皮肤黑色素瘤）在分子特征和微生物组研究背景下的差异，强调疾病特异性的基线特征。"
          },
          {
            "connection_to_review": "提供关于可改变风险因素（生活方式、饮食）在微生物组调节中作用的背景信息。",
            "material": "提到收集了患者报告结果（PROs）和饮食评估，并计划调查可改变的微生物组决定因素。",
            "purpose": "用于综述中讨论非药物干预（如饮食调整）作为调节微生物组以提高ICI疗效的潜在策略的理论依据和数据收集现状。"
          }
        ],
        "scope_interpretation_cautions": [
          "该论文目前仅提供基线数据和队列描述，严禁将其预期的“洞察”解读为已证实的结论。",
          "所有关于微生物组影响ICI疗效的陈述均为研究目标或假设，而非本摘要中的实证发现。",
          "样本量有限（n=98），且为单中心前瞻性研究，其基线特征不能代表所有黏膜黑色素瘤患者。",
          "需明确区分“计划进行的分析”与“已完成的结果”，避免混淆研究设计与实际发现。"
        ],
        "topic_handles": [
          "mucosal melanoma (MM)",
          "immune checkpoint inhibitors (ICIs)",
          "gut microbiome vs. mucosal/tumor microbiome",
          "prospective longitudinal cohort design",
          "multi-omics integration (WGS, RNA-seq, DSP, Metagenomics)",
          "patient-derived xenografts (PDX) and cell lines",
          "modifiable risk factors and lifestyle"
        ]
      },
