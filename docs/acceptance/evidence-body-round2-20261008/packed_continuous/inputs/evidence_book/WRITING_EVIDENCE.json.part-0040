    "record::51f89be549975819db34d833a902728b2f5ee0cf8443c6b08bf2477413b64280": {
      "source_handle": "P0217",
      "title": "Myokine-mediated mechanisms of immune checkpoint inhibitors-associated colorectal injury and repair in rectal cancer",
      "year": "2026",
      "doi": "10.3389/fimmu.2026.1852152",
      "paper_id": "5babbfef7caecfce48f24a69bac030cd4c5dd4e0",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "作为一篇综述，本文通过系统梳理免疫学、分子病理学和放射组学的多学科证据，构建了一个整合性的“骨骼肌-肌动蛋白-肠道损伤-修复”调控网络。具体路线包括：1. 描述直肠癌TME的组成及其在免疫治疗下的动态重塑；2. 详细分析ICI诱导肠道损伤的核心机制（T细胞毒性、炎症风暴、菌群失调、血管/代谢紊乱、基质纤维化）；3. 引入骨骼肌作为非肿瘤因素，解析关键肌动蛋白（IL-6, IL-15, Irisin）的信号通路及其双向调节作用；4. 总结多模态影像技术在量化监测黏膜、血管和纤维化病变中的应用；5. 提出基于肌动蛋白稳态恢复的分层修复与管理方案。",
        "contribution_and_limits": [
          {
            "contribution": "构建了以肌动蛋白为核心的“骨骼肌-肠道”交互调控网络，将全身性肌肉状态与局部肠道免疫毒性联系起来，超越了以往仅关注局部肠道损伤的视角。",
            "limits": "主要基于现有文献的理论综合和机制推演，缺乏大规模前瞻性临床队列数据验证肌动蛋白作为预测生物标志物的特异性截断值和多中心标准化协议。"
          },
          {
            "contribution": "提供了从分子机制到多模态影像表型再到分层干预策略的完整转化链条，为临床精准干预提供了系统性框架。",
            "limits": "许多提出的干预策略（如肌动蛋白靶向药物、特定运动营养方案）仍处于临床前研究或早期临床试验阶段，尚未成为标准护理流程。"
          }
        ],
        "key_findings": [
          {
            "conditions": "在dMMR/MSI-H直肠癌TME中",
            "finding": "ICI通过阻断PD-1/PD-L1和CTLA-4通路解除免疫抑制，但过度激活的CD8+ T细胞会错误识别肠上皮细胞抗原，导致黏膜溃疡和穿孔。"
          },
          {
            "conditions": "骨骼肌健康状态良好时",
            "finding": "分泌保护性肌动蛋白IL-15和Irisin，分别通过JAK/STAT5和CSF-1/STAT3通路增强抗肿瘤免疫并抑制M2型巨噬细胞极化，从而保护肠黏膜屏障。"
          },
          {
            "conditions": "存在肌肉萎缩（Sarcopenia）时",
            "finding": "病理性高浓度IL-6持续激活NF-κB和JAK/STAT3通路，引发炎症风暴并促进成纤维细胞活化，加剧肠道炎症和纤维化，形成“肌肉萎缩-肠道损伤”恶性循环。"
          },
          {
            "conditions": "应用多模态影像技术时",
            "finding": "NBI可早期发现黏膜糜烂和隐窝破坏；EUS-SWE可定量评估组织弹性以区分炎症水肿与不可逆纤维化；PET-CT可通过SUV值量化免疫细胞浸润和代谢活性。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管ICI对dMMR/MSI-H直肠癌疗效显著，但过度激活的免疫系统会导致严重的ICI相关结直肠损伤（ICI-CRI），且现有研究往往孤立地关注肠道免疫毒性或肌肉萎缩。本研究旨在阐明ICI-CRI的复杂病理机制，特别是骨骼肌-肌动蛋白轴在其中的核心调控作用，并整合影像学评估与分层修复策略，以解决免疫治疗中疗效与毒性平衡的临床难题。",
        "research_scope": "直肠癌（Rectal Cancer）免疫治疗，特别是针对dMMR/MSI-H亚型的免疫检查点抑制剂（ICIs）治疗；聚焦于ICI相关的结直肠损伤（ICI-CRI）及其与骨骼肌健康、肌动蛋白分泌的关联。",
        "work_summary": "该综述系统阐述了直肠癌肿瘤微环境（TME）的特征及免疫治疗引起的动态重塑，重点探讨了ICI诱导的结直肠损伤（ICI-CRI）的多重病理机制，包括CD8+ T细胞介导的细胞毒性、炎症因子风暴、肠道菌群失调导致的内毒素易位、微血管低灌注和基质纤维化。文章创新性地提出了“骨骼肌-肌动蛋白-肠道损伤”调控轴，指出骨骼肌分泌的肌动蛋白（IL-6, IL-15, Irisin）在调节抗肿瘤免疫与维持肠道稳态之间起核心作用：IL-15和Irisin具有保护作用，而过度分泌的IL-6则加剧炎症。此外，综述还介绍了结合多模态影像（如NBI结肠镜、EUS-SWE、PET-CT）和放射组学的定量监测方法，以及包括阶梯式免疫抑制、微生态重建、代谢支持和肌肉靶向运动/营养在内的分层修复策略，旨在为个性化直肠癌免疫治疗提供理论参考，以最大化疗效并减少胃肠道毒性。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物群如何影响ICI疗效提供了重要的间接机制背景，特别是通过“肠道-肌肉”轴和炎症级联反应。虽然其核心焦点是肌动蛋白而非直接研究菌群，但它详细描述了菌群失调如何通过LPS易位和TLR4/NF-κB通路放大炎症，以及菌群重建（如FMT）如何作为修复策略的一部分。这有助于解释菌群失调在ICI毒性中的放大作用，以及为何调节宿主全身状态（如肌肉健康）可能间接影响菌群-免疫互作。",
        "facet_contributions": [
          {
            "boundaries": "未直接提供菌群改变ICI抗肿瘤疗效的直接因果证据，而是侧重于其在毒性放大中的作用。",
            "contribution": "提供了肠道菌群失调（如Akkermansia muciniphila减少，致病菌增殖）导致LPS易位并激活TLR4/NF-κB通路的机制描述，解释了菌群变化如何加剧ICI引起的全身和局部炎症。",
            "facet_id": "F1",
            "possible_uses": "用于解释菌群失调如何作为ICI毒性的放大器，以及为何微生态重建（FMT）能改善预后。"
          },
          {
            "boundaries": "主要关注肌动蛋白介导的机制，未深入探讨菌群代谢产物（如短链脂肪酸）对肌动蛋白分泌的直接调控细节，需结合其他文献完善菌群-肌肉互作机制。",
            "contribution": "详细阐述了肌动蛋白（IL-6, IL-15, Irisin）信号通路如何调节免疫细胞功能（CD8+ T细胞、NK细胞、Tregs、巨噬细胞）和肠道屏障完整性，揭示了肌肉-肠道轴在介导ICI效应中的分子机制。",
            "facet_id": "F2",
            "possible_uses": "用于补充说明宿主全身状态（肌肉健康）如何通过内分泌信号调节肠道免疫微环境，进而影响ICI的治疗窗口和毒性谱。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "帮助理解为什么某些患者对ICI响应好而另一些产生严重毒性，引入宿主全身因素（肌肉）作为解释个体差异的新维度。",
            "material": "综述中关于直肠癌TME异质性（热肿瘤vs冷肿瘤）与免疫治疗响应关系的描述，以及骨骼肌作为全身免疫调节器官的概念。",
            "purpose": "背景与概念框架"
          },
          {
            "connection_to_review": "作为宿主因素调节ICI疗效和毒性的具体实例，支持“宿主-肿瘤-微生物”三方互作的观点。",
            "material": "提到的肌肉萎缩患者更易发生严重ICI-Colitis，以及通过运动/营养改善肌动蛋白谱后可减轻损伤的案例。",
            "purpose": "实例与反例"
          },
          {
            "connection_to_review": "提供评估ICI相关肠道损伤的非侵入性工具，可用于监测菌群重建或免疫调节治疗后的组织学变化。",
            "material": "多模态影像（NBI, EUS-SWE, PET-CT）在评估ICI相关肠道损伤严重程度和纤维化阶段的临床应用价值。",
            "purpose": "实践知识"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述主要聚焦于直肠癌，特别是dMMR/MSI-H亚型，其结论外推至其他实体瘤或MSS型结直肠癌时需考虑TME异质性差异。",
          "肌动蛋白的作用多为机制推演和小型研究支持，尚缺乏大规模随机对照试验证实肌动蛋白靶向治疗的普适性。",
          "影像学生物标志物的标准化和外部验证仍在进行中，不同中心的阈值可能存在差异。"
        ],
        "topic_handles": [
          "Immune Checkpoint Inhibitors (ICIs) in Rectal Cancer",
          "Gut Microbiome Dysbiosis and Endotoxin Translocation",
          "Myokines (IL-6, IL-15, Irisin) as Mediators",
          "Skeletal Muscle Atrophy (Sarcopenia)",
          "Intestinal Fibrosis and ECM Remodeling",
          "Multimodal Imaging Biomarkers (NBI, EUS-SWE, PET-CT)",
          "Stratified Repair Strategies (Immunosuppression, FMT, Metabolic Support)"
        ]
      },
      "locator": {
