    "record::ca0cd8cf75bc9b1aa650c230b683b301f22d44519b8b9e055b3ce5b2a5e50c3e": {
      "source_handle": "P0472",
      "title": "Immunometabolism: The role of gut‐derived microbial metabolites in optimising immune response during checkpoint inhibitor therapy",
      "year": "2025",
      "doi": "10.1002/ctm2.70472",
      "paper_id": "d16dfaee360f4d850878948581e3cdae9911db48",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "作为一篇综述，本文采用主题综合路线：1. 背景引入：阐述CIT的临床现状、耐药性及代谢组学在理解肿瘤-免疫互作中的价值。2. 微生物调控机制：综述微生物群对免疫过程的影响，比较益生菌干预的争议性结果（如小鼠模型 vs 人类数据）。3. 关键代谢物分析：分章节深入讨论SCFA（乙酸、丙酸、丁酸等）的作用机制（HDAC抑制、GPCR激活）、对T细胞分化/记忆的影响，以及色氨酸-犬尿氨酸通路的免疫抑制机制。4. 临床证据汇总：整合来自不同癌症类型（黑色素瘤、NSCLC等）的患者队列研究，列举特定代谢物水平与无进展生存期（PFS）或总生存期（OS）的相关性。5. 转化与挑战：讨论直接补充代谢物的可行性、纳米递送策略的前景，以及IDO抑制剂临床试验失败的原因分析。6. 展望：提出将代谢组学纳入临床实践以监测疗效和不良事件的建议。",
        "contribution_and_limits": [
          {
            "contribution": "系统梳理了肠道微生物代谢物（SCFA、色氨酸代谢物）在CIT疗效中的双重作用（促进效应T细胞 vs 诱导耐受/抑制），提供了从分子机制到临床生物标志物的全景视图。",
            "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及质量评价方法，属于叙述性综述而非系统性综述。部分结论基于小规模临床研究或动物模型，外推至人类需谨慎。"
          },
          {
            "contribution": "指出了IDO抑制剂临床试验失败的潜在原因（剂量、患者选择、缺乏代谢物监测），为未来试验设计提供反思。",
            "limits": "对于SCFA直接补充在肿瘤患者中的安全性及有效性，目前仅停留在理论推测和小规模自身免疫病数据支持阶段，缺乏大规模肿瘤临床试验证据。"
          }
        ],
        "key_findings": [
          {
            "conditions": "黑色素瘤和肾癌患者接受CIT治疗",
            "finding": "基线至第4周犬尿氨酸/色氨酸（Kyn/Trp）比率增加超过50%的患者，其总生存期显著低于比率降低的患者（黑色素瘤中位OS 15.7个月 vs >38个月；肾癌中16.7个月 vs 31.3个月）。"
          },
          {
            "conditions": "非小细胞肺癌（NSCLC）患者接受二线Nivolumab治疗",
            "finding": "粪便中丙酸、丁酸、赖氨酸和烟酸的升高水平与超过12个月的无进展生存期（PFS）相关。"
          },
          {
            "conditions": "黑色素瘤患者接受CIT治疗",
            "finding": "响应者血浆中乳酸水平显著高于非响应者，而丙酮酸水平较低，提示响应者T细胞向糖酵解模式发生代谢重编程；而非响应者血清中丙酮酸和丙氨酸水平较高。"
          },
          {
            "conditions": "小鼠黑色素瘤模型",
            "finding": "补充商业益生菌（如长双歧杆菌、鼠李糖乳杆菌）反而导致肿瘤增大，伴随浸润性IFN-γ产生CD8+ T细胞频率降低；而罗伊氏乳杆菌（L. reuteri）通过释放吲哚-3-甲醛（I3A）激活AhR受体，增强了抗肿瘤免疫。"
          },
          {
            "conditions": "自身免疫性疾病（如多发性硬化症、类风湿关节炎）",
            "finding": "SCFA（如丙酸）补充可增加调节性T细胞（Tregs）数量和功能，表明其在免疫调节方面的潜力，但在肿瘤学中尚未系统应用。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管CIT是实体瘤治疗的常规手段，但存在显著的耐药性和进展问题，且缺乏可靠的预测性生物标志物。本研究旨在理解肿瘤-药物-免疫系统相互作用中的动态事件，特别是通过代谢组学视角，探索如何利用微生物衍生的代谢物来增强免疫反应、克服耐药性，并识别潜在的预测性生物标志物。",
        "research_scope": "免疫检查点抑制剂（CIT）治疗下的实体瘤患者；聚焦于肠道微生物群及其代谢产物（特别是短链脂肪酸SCFA和色氨酸代谢物）对免疫系统及肿瘤微环境（TME）的影响。",
        "work_summary": "这是一篇2025年发表的综述文章，旨在探讨免疫代谢在优化CIT疗效中的作用。文章首先指出CIT面临耐药性和生物标志物缺乏的挑战，随后系统回顾了肠道微生物衍生的代谢物如何调节免疫反应。重点讨论了短链脂肪酸（SCFA）通过表观遗传和代谢重编程增强CD8+ T细胞功能及记忆形成，以及色氨酸分解代谢（IDO1/Kynurenine通路）作为原发性CIT失败预测因子的角色。此外，文章还分析了葡萄糖、氨基酸和脂质等其他代谢特征与CIT预后的关联，并评估了直接补充代谢物或靶向递送策略的潜力，同时指出了当前临床转化的局限性和未来方向。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为“肠道微生物群如何调节实体瘤免疫检查点抑制剂疗效”这一核心问题提供了详细的机制解释和临床关联素材。它特别适用于回答关于微生物代谢物具体作用机制（F2）的问题，包括SCFA对T细胞功能的正向调节、色氨酸代谢导致的免疫抑制，以及这些代谢变化如何作为预测性生物标志物。此外，它还提供了关于益生菌干预复杂性的反面案例，有助于全面评估微生物调控策略的风险与收益。",
        "facet_contributions": [
          {
            "boundaries": "样本量较小（如Botticelli et al. n=11, Nomura et al. n=52），且不同研究间代谢物测量部位（粪便vs血浆）和癌症类型不同，结果可能存在异质性。不能直接推断因果关系，仅为观察性关联。",
            "contribution": "提供了肠道微生物代谢物影响CIT疗效的具体临床关联证据。例如，粪便SCFA水平与NSCLC患者PFS的正相关性，以及色氨酸代谢异常与黑色素瘤/肾癌患者OS的负相关性。",
            "facet_id": "F1",
            "possible_uses": "用于论证微生物代谢物作为CIT疗效预测生物标志物的潜力，支持“微生物群状态决定治疗响应”的观点。"
          },
          {
            "boundaries": "许多机制细节源自小鼠模型（如germ-free mice, adoptive transfer），需注明物种差异限制。作者提到的“代谢重编程”多为假设性解释，需结合其他实验验证。",
            "contribution": "详细阐述了微生物代谢物调节免疫细胞的分子机制。包括：1) SCFA通过抑制HDAC和激活GPCRs（如GPR43, GPR41）促进CD8+ T细胞效应功能和记忆形成；2) 色氨酸分解通过IDO1途径产生犬尿氨酸，抑制T细胞增殖并诱导Treg分化；3) 代谢重编程（如糖酵解增强）对T细胞功能的重要性。",
            "facet_id": "F2",
            "possible_uses": "用于解释微生物群影响CIT疗效的具体生物学路径，区分不同的代谢通路（脂肪酸 vs 氨基酸 vs 脂质）对免疫细胞的不同影响。"
          },
          {
            "boundaries": "主要依据是小鼠预临床数据，人类数据有限且多为自我报告或小型观察性研究。不能据此推荐或反对通用的益生菌使用。",
            "contribution": "提供了关于益生菌干预效果的矛盾证据。指出某些商业益生菌在小鼠模型中损害抗肿瘤免疫，而特定菌株（L. reuteri）可能有益，强调了菌株特异性和情境依赖性。",
            "facet_id": "F2",
            "possible_uses": "用于说明并非所有微生物干预都是有益的，强调精准微生物调控的重要性，反驳“益生菌普遍有益”的简单化观点。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供代谢组学技术在CIT监测中的应用前景背景。",
            "material": "综述提到血清代谢组学（LC-MS, GC-MS）可捕捉全身代谢改变，而单细胞/空间代谢组学可解析TME内的异质性。",
            "purpose": "作为技术背景，说明为何需要更精细的代谢分析方法来超越传统的影像学评估，以早期识别耐药或不良反应。"
          },
          {
            "connection_to_review": "提供IDO抑制剂临床试验失败的教训。",
            "material": "ECHO-301/Keynote 252试验显示Epacadostat联合Pembrolizumab无显著获益，原因可能包括剂量不足、缺乏患者分层（基于IDO表达或代谢物水平）。",
            "purpose": "作为反面案例或警示，说明即使机制明确，临床转化仍面临挑战，强调未来试验设计需考虑代谢物监测和精准分层。"
          },
          {
            "connection_to_review": "提供代谢物与免疫相关不良事件（irAEs）关联的背景信息。",
            "material": "升高的Kyn/Trp比率与更高的irAEs风险相关；脂质代谢改变可区分结肠炎或肝炎患者。",
            "purpose": "扩展综述范围，不仅关注疗效，还关注安全性，说明微生物代谢物可能同时影响疗效和毒性。"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述为叙述性综述，非系统性综述，其结论代表作者对现有文献的综合解读，而非经过严格统计合并的证据等级。",
          "文中引用的多项临床研究样本量较小，且多为回顾性或横断面研究，因果推断能力有限。",
          "动物模型（尤其是无菌小鼠）的结果不能直接外推到人类，需注意种属间免疫系统和微生物组的差异。",
          "关于SCFA补充剂的讨论主要基于自身免疫病数据和理论推导，在肿瘤患者中的安全性和有效性尚未经过大规模随机对照试验证实。",
          "IDO抑制剂临床试验的失败并不意味着IDO通路不重要，而是提示当前治疗策略或试验设计的局限性。"
        ],
        "topic_handles": [
          "short-chain fatty acids (SCFA) / butyrate / propionate / acetate",
          "tryptophan catabolism / IDO1 / kynurenine-to-tryptophan ratio",
          "glycolysis / lactate / pyruvate in T cells",
          "branched-chain amino acids (BCAA)",
          "sphingolipid metabolism",
          "probiotic supplementation outcomes (murine models vs clinical data)",
          "nanomedicine delivery of metabolites",
          "immune-related adverse events (irAEs) prediction"
        ]
      },
