    "record::75e6dfc7ae3a6e8eb59675917ad6fe0c85254d3393fc36f8992b36ec4993b742": {
      "source_handle": "P0012",
      "title": "Antibiotic use reduces efficacy of tyrosine kinase inhibitors in patients with advanced melanoma and non-small-cell lung cancer",
      "year": "2021",
      "doi": "10.1016/j.esmoop.2022.100430",
      "paper_id": "04d758358071fe0987733466b05a84fae0fcde9f",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用单中心回顾性队列设计。纳入标准：确诊晚期黑色素瘤或NSCLC，接受指定TKI（达非替尼、维莫非尼、吉非替尼、阿法替尼、厄洛替尼）一线治疗。暴露定义：在TKI开始前2周至开始后6周内使用任何抗生素（ABX+组）vs. 该期间未使用抗生素（ABX-组）。主要终点：PFS和OS，依据RECIST v1.1标准评估。统计分析：首先进行单变量Cox比例风险模型分析筛选显著因素，随后构建多变量Cox模型以调整年龄、ECOG体能状态（PS）、LDH水平、脑转移等协变量，评估ABX使用的独立预后价值。探索性分析包括ABX累积使用次数及ABX与PS的交互作用。",
        "contribution_and_limits": [
          {
            "contribution": "提供了早期证据，表明在常规临床实践中，抗生素使用是接受TKI治疗的晚期黑色素瘤和NSCLC患者不良预后的独立预测因子。",
            "limits": "研究为回顾性观察性设计，无法确立因果关系；样本量较小（仅55例ABX使用者），限制了按抗生素类别细分分析的效力；未能控制感染本身对预后的潜在影响；所涵盖的TKI药物组合（如单药达非替尼/维莫非尼）已非当前晚期黑色素瘤的标准治疗（现常联合MEK抑制剂），结果的外推性受限。"
          }
        ],
        "key_findings": [
          {
            "conditions": "全队列（n=168），多变量调整后",
            "finding": "抗生素使用与缩短的PFS [HR 1.71, 95% CI 1.15-2.54, P=0.008] 和 OS [HR 2.24, 95% CI 1.47-3.39, P<0.0001] 独立相关。"
          },
          {
            "conditions": "体能状态较差亚组（ECOG PS ≥2）",
            "finding": "抗生素使用对OS的负面影响尤为显著，HR高达3.82 (95% CI 1.18-12.36, P=0.025)。"
          },
          {
            "conditions": "不同抗生素使用模式",
            "finding": "单次使用与累积多次使用抗生素相比，未显示出显著不同的有害效应差异；累积使用并未证明有“安全阈值”。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "抗生素的使用是否会影响接受酪氨酸激酶抑制剂（TKI）治疗的晚期黑色素瘤和NSCLC患者的生存结局？其影响方向及强度如何？",
        "research_scope": "回顾性队列研究，对象为2015年1月至2017年4月在英国The Christie NHS Foundation Trust接受一线酪氨酸激酶抑制剂（TKI）治疗的晚期黑色素瘤和非小细胞肺癌（NSCLC）患者。",
        "work_summary": "本研究旨在探讨抗生素（ABX）使用对接受靶向治疗（TKI）的晚期实体瘤患者疗效的影响。鉴于既往研究显示抗生素通过破坏肠道菌群可能降低免疫检查点抑制剂和化疗的疗效，但其在TKI治疗中的作用尚不明确，作者利用回顾性临床数据，比较了在使用TKI前后特定时间窗内使用抗生素与未使用抗生素患者的无进展生存期（PFS）和总生存期（OS）。研究纳入了168名可评估患者，通过多变量分析调整混杂因素后，发现抗生素使用与较短的PFS和OS独立相关，且这种负面影响在体能状态较差的患者中更为显著。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了抗生素干扰抗肿瘤治疗疗效的一个具体反面案例：在靶向治疗（TKI）而非免疫治疗背景下，抗生素同样与生存获益减少相关。这有助于综述论证“抗生素对多种抗癌疗法具有普遍负面影响的假设”，并提示肠道菌群失调可能不仅限于调节免疫反应，也可能通过其他机制（如炎症、代谢或药代动力学）影响靶向药物疗效。同时，它指出了现有研究中关于因果机制（感染 vs. 菌群）的不确定性。",
        "facet_contributions": [
          {
            "boundaries": "该研究针对的是TKI，不能直接外推至所有类型的免疫治疗或新型靶向药物；且为观察性关联，非机制性解释。",
            "contribution": "证实了在非免疫治疗（TKI）情境下，抗生素使用依然与较差的临床结局（PFS/OS）相关，支持了抗生素广泛抑制抗癌疗效的观点。",
            "facet_id": "F1",
            "possible_uses": "用于综述中讨论抗生素对不同类别抗癌药物（不仅是ICI，还包括TKI和化疗）的普遍负面影响，反驳“抗生素仅影响免疫治疗”的片面观点。"
          },
          {
            "boundaries": "作者明确指出未进行粪便微生物分析，因此这些机制仅为基于文献的推测和药理学合理性假设，并非本研究的实证发现。感染本身的免疫抑制效应未被排除。",
            "contribution": "提出了抗生素影响TKI疗效的可能机制假说，包括肠道菌群多样性丧失、全身炎症反应改变以及潜在的药代动力学相互作用（如CYP3A4酶诱导/抑制）。",
            "facet_id": "F2",
            "possible_uses": "用于综述中探讨机制部分，特别是当缺乏直接微生物组测序证据时，如何利用临床表型（如PS状态、感染背景）来推断潜在的生物生物学路径。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "帮助区分不同治疗模式下抗生素影响的异质性，或论证共同的上游驱动因素（如菌群紊乱）。",
            "material": "TKI治疗中ABX使用导致PFS和OS缩短的多变量分析结果，特别是HR值和时间窗定义。",
            "purpose": "提供对比案例：展示抗生素在非免疫治疗中的负面效应，丰富综述中关于“抗生素干扰抗癌治疗”的证据广度。"
          },
          {
            "connection_to_review": "在评估其他观察性研究时，作为方法论上的警示，强调需要仔细区分“抗生素的直接药理/菌群效应”与“严重感染导致的生理应激效应”。",
            "material": "研究中关于ABX与ECOG PS交互作用的发现，以及作者承认未探索感染原因的限制。",
            "purpose": "识别混杂因素与局限性：提醒在综合其他研究时，需考虑患者基础状况（如PS评分）和感染背景对结果的潜在混淆。"
          },
          {
            "connection_to_review": "扩展机制讨论的范围，不仅限于免疫调节，还包括直接的代谢酶相互作用，尽管这在TKI中可能不如在ICI中重要，但仍是一个值得考虑的次要路径。",
            "material": "讨论部分提到的大环内酯类抗生素对CYP3A4的抑制作用可能影响TKI代谢。",
            "purpose": "药代动力学视角的补充：引入药物-药物相互作用（DDI）作为潜在机制之一。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究结论仅限于回顾性观察到的关联，不可解读为抗生素必然导致TKI失效的因果证据。",
          "研究对象为2015-2017年的患者，使用的黑色素瘤治疗方案（单药BRAF抑制剂）已过时，结果可能不适用于当前的双药联合疗法（BRAF+MEK抑制剂）。",
          "研究中ABX使用者的样本量较小（n=55），且未按抗生素种类进行分层分析，因此无法判断特定类别抗生素的影响差异。",
          "未能区分抗生素使用是因为预防性措施还是治疗活动性感染，后者本身可能就是预后不良的标志。"
        ],
        "topic_handles": [
          "抗生素使用与靶向治疗（TKI）疗效的关联",
          "实体瘤（黑色素瘤、NSCLC）中的抗生素副作用",
          "体能状态（ECOG PS）作为抗生素负面效应的修饰因子",
          "回顾性真实世界数据中的抗生素暴露定义",
          "非免疫治疗途径下的抗生素-肿瘤相互作用"
        ]
      },
