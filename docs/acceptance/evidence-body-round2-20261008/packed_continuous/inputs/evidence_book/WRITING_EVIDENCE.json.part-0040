    "record::cbe0edda2ebe4eadd9e19df3564ad6771cff4ada58ee339a5655f3aba217db93": {
      "source_handle": "P0310",
      "title": "Association of antibiotic exposure with overall survival and colitis in patients with stage III and IV melanoma receiving immune checkpoint inhibitors.",
      "year": "2020",
      "doi": "10.1200/jco.2020.38.5_suppl.56",
      "paper_id": "85a36859d78332d758a8b240a964fcdac76937f6",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用回顾性队列研究设计。利用机构数据库筛选出2004-2019年间接受首次ICI治疗的III/IV期黑色素瘤患者。定义暴露组（Abx+）为在ICI开始前3个月内使用过抗生素的患者，对照组（Abx-）为未使用者。通过多变量分析（MV analysis）和Fine-Grey竞争风险模型评估抗生素暴露对总生存期（OS）和免疫介导性结肠炎的影响。此外，进行了敏感性分析以排除重症感染住院患者的干扰。",
        "contribution_and_limits": [
          {
            "contribution": "提供了在真实世界临床实践中，近期抗生素暴露与黑色素瘤患者ICI治疗疗效（OS）及安全性（结肠炎）之间关联的实证数据，支持了抗生素可能负面调节ICI疗效的假设。",
            "limits": "所给摘要未交代具体的混杂因素列表、统计模型的具体协变量选择过程、抗生素种类分布及微生物组测序数据。作为回顾性观察研究，无法确立因果关系，仅能证明关联。结论仅限于黑色素瘤人群，且受限于单中心数据。"
          }
        ],
        "key_findings": [
          {
            "conditions": "IV期黑色素瘤患者，经多变量分析调整基线特征后",
            "finding": "抗生素暴露组（Abx+）的总生存期显著差于非暴露组，风险比（HR）为1.6（95% CI 1.1-2.2）。"
          },
          {
            "conditions": "III期黑色素瘤患者，经多变量分析调整基线特征后",
            "finding": "抗生素暴露组（Abx+）的总生存期显著差于非暴露组，风险比（HR）为2.8（95% CI 1.3-5.9）。"
          },
          {
            "conditions": "敏感性分析：排除接受静脉注射抗生素或因感染住院的患者后",
            "finding": "抗生素暴露组（Abx+）的生存劣势依然存在，HR为1.7（95% CI 1.2-2.4）。"
          },
          {
            "conditions": "使用Fine-Grey竞争风险多变量模型分析免疫介导性结肠炎发生率",
            "finding": "抗生素暴露组发生需要静脉注射类固醇治疗的免疫介导性结肠炎的风险更高，HR为2.1（95% CI 1.02-4.5）。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "基于肠道微生物群可能调节癌症治疗反应的假设，以及广谱抗生素已知会导致菌群失调的事实，本研究试图验证近期抗生素暴露是否会恶化接受ICI治疗的黑色素瘤患者的临床结局（生存率和免疫相关不良反应）。",
        "research_scope": "研究对象为接受免疫检查点抑制剂（ICI）治疗的III期和IV期黑色素瘤患者。研究情境为单中心机构数据库回顾性分析，时间跨度为2004年至2019年。主要关注抗生素暴露与ICI治疗结局之间的关联。",
        "work_summary": "本研究旨在探讨近期抗生素暴露是否会影响黑色素瘤患者对免疫检查点抑制剂（ICI）的治疗反应。研究团队从机构数据库中识别了接受首次ICI治疗的患者，定义抗生素暴露为在首次ICI输注前3个月内使用过抗生素。主要终点为总生存期（OS），次要终点为需要静脉注射类固醇治疗的免疫介导性结肠炎。研究分别对III期和IV期患者进行了独立分析，并通过多变量分析调整了基线特征差异。结果显示，抗生素暴露与较差的生存预后及更高的结肠炎风险相关。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于抗生素暴露影响免疫检查点抑制剂（ICI）疗效的临床证据，具体涉及总生存期（OS）和免疫介导性结肠炎两个关键结局。它直接回应了“肠道微生物群如何调节ICI疗效”这一主题中的外部干预因素（抗生素导致的菌群失调）及其临床后果。虽然未直接测量微生物组，但其结果间接支持了微生物群介导的机制假说，并为综述中讨论“宿主因素/药物相互作用对ICI疗效的影响”提供了重要的临床相关性素材。",
        "facet_contributions": [
          {
            "boundaries": "仅限黑色素瘤；未提供微生物组直接证据；关联不等于因果；未区分抗生素类型或具体菌群变化。",
            "contribution": "提供了抗生素暴露作为负面调节因子影响ICI疗效的具体临床数据。数据显示，在III期和IV期黑色素瘤中，近期抗生素使用均与OS降低显著相关（HR分别为2.8和1.6），并增加了严重结肠炎风险（HR 2.1）。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中论证“外部因素（如抗生素）如何通过潜在机制（如菌群失调）削弱ICI疗效”的部分。特别是用于说明这种负面影响不仅存在于生存获益上，还体现在毒性管理（结肠炎）上。"
          },
          {
            "boundaries": "缺乏直接的微生物组数据或机制通路验证；不能单独证明机制，需结合其他微生物组学研究。",
            "contribution": "虽然未直接阐明分子机制，但通过展示抗生素暴露与不良临床结局（OS下降、结肠炎增加）的强关联，为“微生物群介导的ICI疗效调节”这一机制假说提供了间接的支持性临床背景。其敏感性分析排除了重症感染本身的直接影响，增强了抗生素本身（而非伴随疾病）作用的合理性。",
            "facet_id": "F2",
            "possible_uses": "可作为机制讨论部分的临床佐证，说明如果微生物群确实是中介变量，那么破坏它的行为（抗生素使用）应导致预期的负面临床结果。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "帮助综述读者理解理论上的微生物群-ICI交互作用在实际临床决策中的重要性，即避免不必要的抗生素使用可能对改善ICI疗效具有实际意义。",
            "material": "抗生素暴露导致OS风险增加1.6-2.8倍，结肠炎风险增加2.1倍的统计数据。",
            "purpose": "提供临床实践中的警示案例和量化风险估计"
          },
          {
            "connection_to_review": "可用于讨论在不同疾病阶段或不同肿瘤类型中，微生物群调节效应的强度可能存在差异，提示未来研究需考虑分期和肿瘤类型。",
            "material": "研究专门分析了III期和IV期黑色素瘤，发现两期别均有显著负面影响，但III期的HR更高（2.8 vs 1.6）。",
            "purpose": "区分不同癌症类型的潜在异质性"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为观察性关联，不能推断抗生素必然导致疗效下降，可能存在未测量的混杂因素（尽管已调整多项基线特征）。",
          "结果仅适用于黑色素瘤患者，外推至其他实体瘤需谨慎。",
          "抗生素定义为“3个月内使用”，未区分抗生素种类、疗程或给药途径（除敏感性分析排除静脉用药外），不同抗生素对菌群的影响差异巨大，此处视为整体暴露。",
          "结肠炎风险的增加可能与生存期缩短有关（竞争风险），Fine-Grey模型已部分处理此问题，但仍需注意解释。",
          "所给材料未提供微生物组测序数据，因此不能直接用于描述具体的菌群变化，只能作为菌群失调后果的临床代理指标。"
        ],
        "topic_handles": [
          "antibiotic exposure timing (within 3 months prior to ICI)",
          "melanoma stage III vs IV outcomes",
          "overall survival (OS) hazard ratios",
          "immune-mediated colitis requiring IV steroids",
          "gut microbiome dysbiosis proxy via antibiotic use"
        ]
      },
