    "record::a7a7de9fbd4946fc2daa9ddf973518ada8921541825d72e42c020528eab8a38a": {
      "source_handle": "P0354",
      "title": "A uniform computational approach improved on existing pipelines to reveal microbiome biomarkers of non-response to immune checkpoint inhibitors",
      "year": "2021",
      "doi": "10.1158/1078-0432.ccr-20-4834",
      "paper_id": "9ab8366e1190d9c05b04e4dcee48581a8e9c0db5",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "The authors performed a meta-analysis of raw 16S rRNA amplicon and whole-genome shotgun (WGS) metagenomic sequencing data from five public datasets (Chaput, Frankel, Gopalakrishnan, Matson, Routy). They applied a uniform bioinformatics pipeline: Resphera Insight for 16S taxonomic assignment and MetaPhlAn2 for WGS. Statistical analysis included random effects meta-analysis models (Hedges' g) to identify species enriched in R or NR groups, correcting for false discovery rate (FDR). An 'integrated microbiome prediction index' was constructed using weighted coefficients of significant species. Validation was performed on three independent cohorts (Peters, Hakozaki, Zheng) representing melanoma, NSCLC, and hepatocellular carcinoma (HCC). Sensitivity/specificity analyses (AUC) were used to evaluate index performance.",
        "contribution_and_limits": [
          {
            "contribution": "Provides a standardized bioinformatics pipeline for reanalyzing heterogeneous microbiome data, demonstrating that consistent methods can resolve inconsistencies in prior reports.",
            "limits": "Relies on retrospective reanalysis of publicly available data; response criteria varied across original studies (e.g., definition of Stable Disease); limited information on concurrent medications other than antibiotics; validation cohorts were small and diverse in tumor type."
          },
          {
            "contribution": "Identifies a robust set of bacterial signatures associated with ICI non-response, suggesting that targeting these microbes may be a viable therapeutic strategy.",
            "limits": "Correlation does not imply causation; mechanistic insights are limited to functional pathway predictions (PICRUSt) and require experimental validation."
          },
          {
            "contribution": "Develops an integrated prediction index that outperforms single-species or literature-derived indices in predicting non-response.",
            "limits": "Index performance varied by tumor type (better in Melanoma/HCC than NSCLC); requires further validation in larger prospective cohorts."
          }
        ],
        "key_findings": [
          {
            "conditions": "Reanalysis of 5 cohorts (n=303) using random effects model and FDR correction",
            "finding": "Confirmed enrichment of Faecalibacterium prausnitzii, Bifidobacterium longum, Collinsella aerofaciens, and Enterococcus faecium in responders (R). Identified novel R-enriched OTUs including Roseburia hominis, Oxalobacter formigenes, and Prevotella buccalis."
          },
          {
            "conditions": "Reanalysis of 5 cohorts (n=303) using random effects model",
            "finding": "Identified multiple species enriched in non-responders (NR), including Veillonella parvula, Bacteroides spp. (fragilis, coprocola, thetaiotaomicron, uniformis), Clostridium spp., Parasutterella excrementihominis, Scardovia wiggsiae, Oribacterium sinus, and Megasphaera micronuciformis. NR signals were generally stronger and more consistent than R signals."
          },
          {
            "conditions": "Comparison of integrated index vs. literature-based indices",
            "finding": "The NR-associated integrated index showed the strongest association with ICI outcome (mean AUC 70.3%), outperforming literature-based indices which did not show significant NR signals. The composite index also modestly improved over literature indices."
          },
          {
            "conditions": "Validation in 3 independent cohorts (Melanoma, NSCLC, HCC; n=105)",
            "finding": "The sum integrated index performed well in Melanoma (AUC >80) and HCC (AUC >80). Performance in NSCLC was lower but improved when patients with recent antibiotic exposure were excluded. Antibiotic exposure negatively impacted alpha diversity and index performance."
          },
          {
            "conditions": "Longitudinal analysis (Chaput and Routy cohorts)",
            "finding": "No significant changes in beta diversity or specific taxa over time during ICI treatment, suggesting stability of the gut microbiome during therapy."
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "Previous studies on the gut microbiome and ICI response have yielded inconsistent results due to variable analytic methods, small sample sizes, and differing bioinformatics pipelines. This study aims to determine if a standardized computational approach can reveal robust, generalizable microbial biomarkers for ICI outcomes across different cancer types and geographic locations, specifically focusing on identifying signals for both responders and non-responders.",
        "research_scope": "The study focuses on the gut microbiome as a biomarker for predicting clinical outcomes (response vs. non-response) in patients with solid tumors (melanoma, NSCLC, RCC, HCC) treated with immune checkpoint inhibitors (ICIs). It reanalyzes raw 16S rRNA and metagenomic sequencing data from five previously published cohorts (n=303 unique patients) and validates findings in three independent cohorts (n=105).",
        "work_summary": "This empirical study addresses the inconsistency in microbial biomarkers for ICI efficacy across previous small-scale studies by applying a uniform computational pipeline to reanalyze raw sequencing data from multiple cohorts. The authors identified novel bacterial signatures associated with responders (R) and non-responders (NR), developed an integrated microbiome prediction index, and found that signals associated with non-response were stronger and more consistent than those for response. The study highlights the potential of NR-associated indices to identify patients who might benefit from microbiome-based interventions."
      },
      "review_planning_B": {
        "planning_summary": "This paper provides a large-scale, standardized reanalysis of existing microbiome data related to ICI efficacy. Its primary value lies in establishing a robust set of microbial biomarkers for non-response (NR) to ICIs, which contrasts with earlier focus on responders. It offers specific bacterial species and an integrated index that can be used to contextualize the consistency of microbiome signals across different solid tumors and to discuss the impact of technical variability (pipelines) on biomarker discovery.",
        "facet_contributions": [
          {
            "boundaries": "Findings are based on retrospective reanalysis; causal mechanisms are not established. Performance varies by tumor type (e.g., weaker in NSCLC validation).",
            "contribution": "Identifies specific bacterial species and OTUs consistently associated with ICI non-response (NR) across multiple cohorts, including Veillonella parvula, Bacteroides spp., and Clostridium spp. Also identifies responder-associated species like Faecalibacterium prausnitzii and novel ones like Roseburia hominis.",
            "facet_id": "F1",
            "possible_uses": "Can be used to list specific microbial correlates of ICI failure or success in the review. Helps address the inconsistency problem by showing which signals persist under standardized analysis."
          },
          {
            "boundaries": "Index validation was done on small independent cohorts; generalizability to all solid tumors is not fully confirmed.",
            "contribution": "Demonstrates that an integrated microbiome prediction index based on NR-associated species has higher predictive power (AUC ~70%) than literature-based indices or responder-only indices.",
            "facet_id": "F1",
            "possible_uses": "Supports arguments about the utility of multi-species indices over single-biomarker approaches. Highlights the potential of NR-focused biomarkers for patient stratification."
          },
          {
            "boundaries": "Antibiotic timing and definitions varied across cohorts; only a subset of cohorts had detailed antibiotic metadata.",
            "contribution": "Shows that antibiotic exposure negatively impacts microbiome diversity and reduces the predictive accuracy of the integrated index, particularly in NSCLC.",
            "facet_id": "F1",
            "possible_uses": "Provides evidence for the confounding effect of antibiotics on microbiome-ICI studies, useful for discussing methodological challenges or patient selection criteria."
          },
          {
            "boundaries": "Functional predictions are inferred from taxonomy (PICRUSt) and not directly measured via metatranscriptomics or metabolomics; correlation does not prove mechanism.",
