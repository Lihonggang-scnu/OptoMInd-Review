    "record::80ee6d0031e9d81e9747aece45c770ad293c2fc6b8d11bb4e1c369c56d2ba38f": {
      "source_handle": "P0544",
      "title": "Modulating the gut microbiota to enhance immune checkpoint inhibitor efficacy in colorectal cancer: mechanisms, therapeutic strategies, and clinical perspectives",
      "year": "2026",
      "doi": "10.1080/19490976.2026.2652476",
      "paper_id": "f2eed100d2b1243d762c69b5b04f8a2a7e2cc82c",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统性文献回顾与综合的方法。作者梳理了关于肠道微生物群组成、功能及其与宿主免疫互作的现有研究，重点归纳了从分子机制（信号通路、代谢途径）到临床前模型证据，再到早期临床试验数据的多层次信息。文章按机制分类（特定菌株、代谢物、生物活性成分、昼夜节律）和组织治疗策略（饮食、FMT、LBPs等）进行逻辑编排，未提供新的原始实验数据，而是对已有证据进行分类、解释和综合评议。",
        "contribution_and_limits": [
          {
            "contribution": "系统整合了肠道微生物群调节ICI疗效的多维机制，包括菌株特异性效应、代谢物介导的信号通路及昼夜节律维度；提供了从基础机制到临床转化策略的全面图谱。",
            "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及质量评估方法；主要依赖已发表文献的综合，缺乏对异质性的大规模定量Meta分析；部分结论基于动物模型，临床验证尚处于早期阶段。"
          }
        ],
        "key_findings": [
          {
            "conditions": "基于小鼠模型及部分人类队列观察",
            "finding": "特定益生菌株（如LGG、B. breve JCM92、C. butyricum）可通过激活DCs、促进CD8+ T细胞浸润或减少Tregs来增强ICI疗效；而某些病原体（如F. nucleatum的不同存在形式）可能通过代谢物介导免疫抑制或局部激活适应性抵抗。"
          },
          {
            "conditions": "体外及动物实验机制研究",
            "finding": "微生物代谢物（丁酸盐、ICA、肌苷、UB）通过表观遗传修饰、受体激活（AHR, A2aR）等途径直接调节T细胞功能和分化；但某些代谢物（琥珀酸、4-HPA、脱氧胆酸）可诱导MDSCs浸润或Treg积累，导致ICI耐药。"
          },
          {
            "conditions": "跨学科理论推导与初步临床观察",
            "finding": "肠道微生物群和免疫细胞均具有昼夜节律，干扰节律可能导致代谢紊乱和免疫抑制；同步ICI给药时间与免疫/微生物节律高峰可能提高疗效（时间免疫治疗概念）。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "解决结直肠癌中大多数MSS患者对ICI治疗原发性耐药的临床困境，探索通过调节肠道微生物群来增强ICI疗效的潜在机制和治疗策略。",
        "research_scope": "结直肠癌（CRC），特别是微卫星稳定型（MSS）患者对免疫检查点抑制剂（ICIs）的耐药问题；聚焦肠道微生物群及其代谢产物、生物活性成分在调节ICI疗效中的双重作用，以及昼夜节律的影响。",
        "work_summary": "本文是一篇综述，旨在阐明肠道微生物群如何通过特定菌株、代谢物和生物活性成分调节宿主免疫系统，进而影响结直肠癌中ICIs的疗效。文章首先分析了有益菌和致病菌通过抗原呈递、T细胞浸润及免疫抑制细胞调控等机制对ICI反应的双向影响；其次探讨了微生物代谢物（如短链脂肪酸、色氨酸代谢物、肌苷等）作为免疫调节信使的作用；接着引入了肠道微生物群与宿主免疫细胞的昼夜节律交互概念，提出时间免疫治疗的潜力；最后综合了饮食干预、粪便微生物移植（FMT）、益生菌/益生元补充及靶向抗生素等临床转化策略，并评估了其成熟度与挑战。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为“肠道微生物群如何调节实体瘤ICI疗效”这一核心问题提供了详尽的机制分类框架和临床策略评估。其价值在于将分散的菌株、代谢物和节律研究整合为一个连贯的解释体系，特别适用于构建关于微生物-免疫互作机制的综述章节，并为评估不同干预手段（FMT vs LBPs vs 饮食）的临床证据等级提供参考。",
        "facet_contributions": [
          {
            "boundaries": "多数机制证据来自小鼠模型，人类临床相关性多为相关性研究或早期试验，因果链条在人体内的确证程度不一。",
            "contribution": "提供了肠道微生物群影响ICI疗效的具体生物学路径：包括通过DCs成熟、CD8+ T细胞招募/活化、Treg/M2 TAM抑制来增强抗肿瘤免疫，以及通过代谢物诱导MDSCs/Treg来抑制免疫。",
            "facet_id": "F1",
