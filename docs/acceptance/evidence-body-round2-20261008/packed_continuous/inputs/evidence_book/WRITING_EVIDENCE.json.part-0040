    "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c": {
      "source_handle": "P0558",
      "title": "Overall survival according to timing of immune checkpoint inhibitors administration in patients with advanced cancer: Results from a large single-centre cohort analysis.",
      "year": "2025",
      "doi": "10.1200/jco.2025.43.16_suppl.2662",
      "paper_id": "f7345b03e8a5419417513da6cf1833522f3be7ed",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "Retrospective cohort study. Patients receiving ICIs for advanced/metastatic disease between Jan 2018 and Dec 2023 were grouped based on infusion timing relative to the median time of all treatments ('early group': <50% cycles after median time; 'late group': ≥50%). Primary endpoint was OS. Multivariable-adjusted Hazard Ratios (HRs) were estimated using standard Cox models and time-dependent Cox models to account for potential changes in group assignment over time. Sensitivity analyses were performed.",
        "contribution_and_limits": [
          {
            "contribution": "Provides evidence from a large sample size suggesting a benefit in OS with early ICI administration, utilizing time-dependent Cox models to reduce immortal time bias.",
            "limits": "Retrospective design limits causal inference; results may be specific to the single-centre setting; no difference found when chemotherapy is included; sensitivity analysis results varied by model type."
          }
        ],
        "key_findings": [
          {
            "conditions": "Overall cohort (n=2631)",
            "finding": "Median OS was significantly shorter in the late group (13.1 months) compared to the early group (21.4 months). Time-dependent Cox model showed HR 1.30 (95% CI 1.16-1.44) for death in the late group."
          },
          {
            "conditions": "Regimens with ICIs alone (n=1886) or ICIs plus tyrosine kinase inhibitors (n=163)",
            "finding": "The association between later administration and shorter OS remained significant."
          },
          {
            "conditions": "Regimens comprising chemotherapy (n=582)",
            "finding": "No significant difference in OS was observed between early and late groups."
          },
          {
            "conditions": "Sensitivity analysis based on exposure at 3 months",
            "finding": "Standard model showed no difference (HR 1.09, 95% CI 0.98-1.20); time-dependent model showed higher risk of death for late group (HR 1.14, 95% CI 1.02-1.26)."
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "To determine if the time of day of ICI infusion affects treatment response and overall survival in patients with advanced solid tumours, addressing limitations of previous small-scale studies with methodological biases.",
        "research_scope": "Advanced solid tumours (lung cancer, melanoma, renal carcinoma, head and neck, urothelial cancer) treated with immune checkpoint inhibitors (ICIs) at a large tertiary cancer centre; retrospective cohort analysis.",
        "work_summary": "This study investigates whether the timing of ICI administration influences overall survival (OS), based on evidence of circadian dependence in the immune system. Using a large single-centre cohort of 2631 patients, the authors compared outcomes between 'early' and 'late' treatment groups, defined by whether ≥50% of cycles were administered after the median infusion time. The analysis employed Cox models with and without time-dependent variables to mitigate immortal time bias, adjusting for age, sex, ECOG status, cancer type, and treatment regimen."
      },
      "review_planning_B": {
        "planning_summary": "This paper offers observational data linking ICI administration timing to survival outcomes in solid tumours, specifically highlighting a potential circadian effect. It provides quantitative evidence (HRs, OS differences) that can serve as a comparative baseline or contextual factor when evaluating the gut microbiome's role in ICI efficacy, particularly regarding non-microbial factors influencing treatment response timing or variability.",
        "facet_contributions": [
          {
            "boundaries": "Does not address microbiome mechanisms directly. Results are associative, not causal. The lack of effect in chemo-combined regimens suggests interaction with other drug classes, which complicates direct comparison to microbiome studies that might focus on different regimen types.",
            "contribution": "Provides observational data on how non-microbial factors (administration timing) correlate with ICI efficacy in solid tumours. Specifically, it shows that earlier administration is associated with better OS in ICI-only and ICI+TKI regimens, but not in chemo-combined regimens.",
            "facet_id": "F1",
            "possible_uses": "Can be used to control for or discuss confounding variables related to treatment scheduling in reviews focusing on microbiome effects. It helps isolate whether observed microbiome effects are independent of temporal administration patterns."
          },
          {
            "boundaries": "The mechanism is proposed based on general immune system circadian dependence, not specifically linked to gut microbiota in this study. It does not provide evidence for microbiome-mediated mechanisms.",
            "contribution": "Offers a mechanistic hypothesis (circadian dependence of the immune system) as an alternative or complementary explanation for ICI efficacy variation.",
            "facet_id": "F2",
            "possible_uses": "Can be cited when discussing potential biological clocks or physiological rhythms that might interact with or modulate microbiome-immune interactions. It highlights the need to consider temporal factors alongside microbial composition."
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "Contextualizes ICI efficacy within broader clinical practice factors beyond microbiome.",
            "material": "Findings on the impact of infusion timing on OS across different cancer types and regimen combinations.",
            "purpose": "To illustrate that multiple factors (including timing) influence ICI outcomes, emphasizing the complexity of predicting response and the need to disentangle microbial from non-microbial determinants."
          },
          {
            "connection_to_review": "Highlights methodological considerations in studying ICI efficacy.",
            "material": "Use of time-dependent Cox models to address immortal time bias.",
            "purpose": "To suggest rigorous analytical approaches that could be applied or considered in microbiome-Ici studies to avoid similar biases, although the current material does not detail such applications."
          }
        ],
        "scope_interpretation_cautions": [
          "The study is retrospective and single-centre, limiting generalizability.",
          "Associations do not imply causation; unmeasured confounders may exist.",
          "The 'early' vs 'late' grouping is based on median infusion time, which may not reflect optimal biological timing.",
          "Results differ by regimen type (chemo vs non-chemo), so findings cannot be universally applied to all ICI treatments.",
          "Sensitivity analysis yielded mixed results depending on the statistical model used."
        ],
        "topic_handles": [
          "ICI administration timing (circadian rhythm hypothesis)",
          "Solid tumour subtypes (lung, melanoma, renal, H&N, urothelial)",
          "Treatment regimens (ICI monotherapy vs. ICI+TKI vs. ICI+chemotherapy)",
          "Survival outcomes (OS, HRs)",
          "Methodological approach (time-dependent Cox models for immortal time bias)"
        ]
      },
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch7.json",
        "source_handle": "P0558",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\f7345b03e8a5419417513da6cf1833522f3be7ed\\6e02c6cc733420f52280cb4cbec2c832\\attempt-01\\PAPER_READING_CARD.json"
      },
      "card_material": {
        "known_gaps": [
          {
            "kind": "identity",
            "reason": "source identity was not independently verified",
            "status": "input_attributed"
          },
          {
            "kind": "coverage",
            "reason": "no complete research body was indexed",
            "status": "partial"
          },
          {
            "kind": "coverage",
            "reason": "only abstract or non-title snippets were available",
            "status": "partial"
          }
        ],
        "material_scope": "abstract_only"
      },
      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\f7345b03e8a5419417513da6cf1833522f3be7ed\\6e02c6cc733420f52280cb4cbec2c832\\attempt-01\\PAPER_READING_CARD.json"
