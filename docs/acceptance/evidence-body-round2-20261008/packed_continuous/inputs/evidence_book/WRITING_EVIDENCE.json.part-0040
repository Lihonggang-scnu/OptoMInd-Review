    "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10": {
      "source_handle": "P0524",
      "title": "Challenges and knowledge gaps with immune checkpoint inhibitors monotherapy in the management of patients with non-small-cell lung cancer: a survey of oncologist perceptions",
      "year": "2023",
      "doi": "10.1016/j.esmoop.2022.100764",
      "paper_id": "eb8389aa4db9c7fa1d42d82f39f1ba4436f3b701",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "横断面意见调查（Survey）。设计包含Likert量表、多选题和开放式问题的问卷，覆盖特定临床情境。通过电子邮件和社交媒体分发，限制每个IP地址一次有效回答，并要求受访者具备一定临床经验（>20例ICI治疗NSCLC患者）以确保数据质量。使用描述性统计方法分析计数和百分比。",
        "contribution_and_limits": [
          {
            "contribution": "提供了关于ICI单药治疗NSCLC临床实践中主要知识空白的全球专家共识视图，特别是针对被排除在关键试验之外的患者亚群。",
            "limits": "样本存在选择偏差（由作者网络发起，虽经多渠道扩散但仍可能偏向特定群体）；自我报告的意见主观性强，不一定代表广泛的实际经验；定义可能缺乏共识；仅反映观点而非客观临床结果。"
          }
        ],
        "key_findings": [
          {
            "conditions": "老年患者（>70岁）",
            "finding": "74%的医生认为ICI在老年患者中的安全性和有效性等同于年轻患者；但承认该领域仍有重要证据缺口。"
          },
          {
            "conditions": "ECOG PS 0-2 vs PS 3-4",
            "finding": "94%同意治疗PS 0-2患者；36%同意治疗PS 3患者；仅6%认为PS 4合理。多数（63%）认为PS 2-3患者缺乏证据。"
          },
          {
            "conditions": "无症状 vs 有症状脑转移",
            "finding": "81%相信ICI对无症状脑转移有效；仅30%同意治疗有症状脑转移。后者被视为第二大研究优先级。"
          },
          {
            "conditions": "自身免疫疾病（AIDs）",
            "finding": "77%仅在低严重程度情况下治疗；74%认为安全性较差，但65%认为疗效相似。"
          },
          {
            "conditions": "HIV感染",
            "finding": "近60%认为控制良好的HIV患者ICI安全有效；对于未控制HIV，约50%医生不确定或认为存在差异。"
          },
          {
            "conditions": "实体器官移植",
            "finding": "大多数拒绝治疗心脏（69%）、肺（67%）或肝脏（59%）移植患者；肾脏移植拒绝率较低（42%）。医生表现出防御性行为，承认缺乏知识。"
          },
          {
            "conditions": "糖皮质激素剂量阈值",
            "finding": "医生对降低ICI效力的激素剂量阈值意见不一：37%认为是0-10mg，34%是11-30mg，11%是>30mg，15%不知道。48%认为抗生素可能降低ICI效力。"
          },
          {
            "conditions": "肠道微生物组",
            "finding": "61%相信调节肠道菌群可能增加ICI疗效；认为这是一个重要的未来挑战。"
          },
          {
            "conditions": "超进展（HPD）与假性进展（PPD）",
            "finding": "62%报告诊断过HPD，81%报告过PPD。讨论指出医生可能低估HPD高估PPD，且机制尚不明确。"
          },
          {
            "conditions": "治疗持续时间",
            "finding": "90%同意治疗持续时间是重要挑战；大多数医生即使达到完全缓解也不会在24个月前停药。"
          },
          {
            "conditions": "疗效预测因子",
            "finding": "被63%的医生投票为最重要的未来研究挑战。目前PD-L1预测价值有限，TMB争议大，其他生物标志物正在研究中。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "尽管ICI改变了NSCLC的治疗格局，但关键临床试验排除了许多真实世界常见患者群体（如老年人、脑转移、合并症患者），导致临床证据存在缺口。本研究试图明确医生在实际操作中遇到的主要挑战，并确定哪些领域最需要前瞻性临床研究来填补证据空白。",
        "research_scope": "非小细胞肺癌（NSCLC）患者使用免疫检查点抑制剂（ICIs）单药治疗的临床实践挑战；调查对象为有ICI治疗经验的肿瘤科医生，重点关注老年人群、体能状态（PS）、脑转移、合并症（自身免疫病、HIV、器官移植）、伴随用药（激素、抗生素）、肠道微生物组影响、疗效预测因子、治疗持续时间及不典型反应等情境。",
        "work_summary": "本研究旨在评估肿瘤科医生在NSCLC临床实践中使用ICI单药治疗时面临的主要挑战和知识空白。通过Oncodistinct跨国研究网络发起了一项在线问卷调查，涵盖18个具体主题和一个开放性问题。问卷经过两轮专家试点测试验证。数据收集于2019年9月至2020年2月，采用雪球法传播。最终分析纳入106名完全填写问卷且自报治疗过至少20名NSCLC患者的医生的回答。结果以描述性统计呈现，识别了临床决策中的不确定性领域和优先研究方向。"
      },
      "review_planning_B": {
        "planning_summary": "该论文通过调查肿瘤科医生的意见，量化了ICI单药治疗NSCLC中未被充分研究的临床场景的重要性排序。对于综述而言，它提供了关于哪些临床情境（如脑转移、合并症、伴随用药）被认为最具挑战性且急需证据的专家视角，并指出了当前生物标志物预测能力的不足。特别地，它确认了肠道微生物组和抗生素使用作为潜在疗效调节因素的临床关注度。",
        "facet_contributions": [
          {
            "boundaries": "这是基于医生意见的调查数据，而非直接的微生物组机制研究或临床干预结果。未提供具体的微生物种类或代谢产物数据。",
            "contribution": "提供了临床医生对肠道微生物组影响ICI疗效的认知现状：61%的医生认为调节肠道菌群可增加ICI疗效，且将其列为重要挑战。同时提到质子泵抑制剂也可能通过影响微生物组降低ICI疗效。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中说明临床界面对微生物组干预潜力的认可度，以及当前证据不足以指导常规临床决策的现状。可作为背景支持为何需要深入研究微生物组机制。"
          },
          {
            "boundaries": "主要引用回顾性研究和观察性研究的相关性，未阐明具体的分子或免疫学机制。机制部分（如HPD/PPD的生物机制）明确指出尚未完全理解。",
            "contribution": "讨论了抗生素可能通过改变肠道微生物组导致菌群失调（dysbiosis），进而与较低的ICI结局相关。提及粪菌移植（FMT）和活体生物疗法正在临床试验中被探索以增强ICI疗效。",
            "facet_id": "F2",
            "possible_uses": "可用于综述中概述当前关于微生物组介导机制的假设性解释（如菌群失调），并指出现有证据多为相关性而非因果性。可引出后续需要机制研究的方向。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "帮助综述确立研究重点，说明为何某些领域（如精准预测、特殊人群管理）是当前研究的热点和难点，为综述的结构安排提供依据。",
            "material": "医生将疗效预测因子（63%）、脑转移治疗（第二高优先级）、治疗持续时间（90%认为重要）列为最关键的未满足需求。",
            "purpose": "背景与优先级设定"
          },
          {
            "connection_to_review": "可用于讨论现有证据的外部效度问题，强调从实验室/试验环境向复杂临床情境转化时的挑战。",
            "material": "揭示了临床试验证据（如CheckMate系列）与真实世界临床决策之间的差距，例如医生对PS 3患者、有症状脑转移患者的治疗态度与指南推荐的差异。",
            "purpose": "对比基线与临床现实"
          },
          {
            "connection_to_review": "提醒综述在综合不同研究时需考虑定义标准的一致性，特别是在讨论不典型反应时。",
            "material": "指出HPD和PPD的定义缺乏共识，医生感知与文献报道的发生率存在差异。",
            "purpose": "概念澄清与定义差异"
          }
        ],
        "scope_interpretation_cautions": [
          "本材料反映的是医生的主观意见和感知，而非客观的临床结果或机制证据。",
          "样本主要来自欧洲（80%），可能存在地域文化或医疗体系带来的偏差。",
          "关于微生物组和抗生素的内容主要是关联性观察和医生信念，不能直接推导因果关系。",
          "未提供具体的微生物组测序数据或机制实验细节，仅作为临床需求的背景。"
        ],
        "topic_handles": [
          "gut microbiome modulation of ICI efficacy",
          "antibiotic use and ICI response",
          "corticosteroid dose thresholds with ICIs",
          "predictors of response (biomarkers)",
          "brain metastases treatment with ICIs",
          "comorbidities (autoimmune, HIV, transplant) in ICI therapy",
          "treatment duration and discontinuation timing"
        ]
      },
      "locator": {
