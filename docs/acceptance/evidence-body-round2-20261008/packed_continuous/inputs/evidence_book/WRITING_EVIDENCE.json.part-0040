    "record::820c5fef183c1e2973da4cf6ef051dbdc5a260b40a12f028144c9bc5fb01561d": {
      "source_handle": "P0428",
      "title": "Comparison of baseline gut microbiome features between response subgroups of patients (pts) with advanced melanoma undergoing immune checkpoint inhibitor (ICI) therapy.",
      "year": "2026",
      "doi": "10.1200/jco.2026.44.16_suppl.9528",
      "paper_id": "bb6b1be372fbcd8282307d93b91745ca4c844e92",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用回顾性队列设计。首先从机构粪便生物库中识别90名接受ICI治疗的晚期黑色素瘤患者，要求有≥1个治疗前或治疗中的粪便样本进行16S rRNA扩增子测序。其次，根据临床反应将患者分为三个亚组：响应者（R，无进展）、原发耐药（pR，起始后<6个月进展）和获得性耐药（aR，起始后≥6个月进展）。统计分析包括：使用Kaplan-Meier和Cox比例风险模型分析临床协变量与生存的关系；使用Alpha和Beta多样性指标比较微生物特征；在各分类水平上使用Wilcoxon秩和检验进行成对比较。",
        "contribution_and_limits": [
          {
            "contribution": "提供了基线肠道微生物组特征与ICI疗效亚型及irAEs关联的具体实证数据，特别是指出了SCFA产生菌（如F. prausnitzii）在响应者中高丰度的现象。",
            "limits": "所给摘要未交代具体的统计校正细节（除p adj外）、微生物鉴定的具体分辨率（种/属水平）、以及样本量较小（n=90）带来的统计效力限制。结论仅为相关性提示，未证实因果机制。"
          }
        ],
        "key_findings": [
          {
            "conditions": "比较不同响应亚组（R, pR, aR）及irAE发生情况",
            "finding": "基线α多样性在各亚组间无显著差异；β多样性呈现差异趋势（p=0.084），但未达统计学显著性。"
          },
          {
            "conditions": "比较响应者与不同耐药亚组的特定菌属",
            "finding": "产丁酸菌Faecalibacterium prausnitzii在响应者（R）中的丰度显著高于原发耐药者（pR）和获得性耐药者（aR）。"
          },
          {
            "conditions": "比较其他SCFA产生菌",
            "finding": "其他短链脂肪酸（SCFA）产生菌，如Coprococcus comes, Dorea longicatena, Blautia glucerasea，在响应者中丰度显著更高，且在未发生irAEs的患者中丰度也更高。"
          },
          {
            "conditions": "irAEs与生存期的关联",
            "finding": "发生irAEs的患者进展无病生存期（PFS）显著长于未发生irAEs的患者（中位PFS 1412天 vs. 106天，p=0.026）。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "尽管已知肠道微生物组可能作为ICI疗效的生物标志物，但尚不清楚基线微生物组组成能否预测特定的ICI耐药亚型（原发vs.获得性）或irAEs的发生。本研究试图定义与这些临床结果相关的基线微生物组特征。",
        "research_scope": "研究对象为接受免疫检查点抑制剂（ICI）治疗的晚期黑色素瘤患者。研究情境基于机构内的粪便生物库，纳入90名具有治疗前或治疗中粪便样本的患者。范围限定于基线肠道微生物组特征与ICI疗效亚型（原发耐药、获得性耐药、响应者）及免疫相关不良事件（irAEs）之间的关联分析。",
        "work_summary": "本研究旨在探讨基线肠道微生物组组成是否能预测特定类型的ICI耐药性或irAEs的发生。研究团队从生物库中筛选出90名晚期黑色素瘤患者，根据疾病进展时间将其分为三组：响应者（R）、原发耐药者（pR）和获得性耐药者（aR）。通过16S rRNA扩增子测序分析基线微生物特征，并结合临床数据评估其与生存结局及irAEs的相关性。结果显示，虽然各组间α多样性无显著差异，但短链脂肪酸（SCFA）产生菌丰度在响应者中显著更高，且这些菌群也与不出现irAEs相关，提示SCFAs可能在介导ICI疗效和保护免受irAEs方面发挥作用。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于肠道微生物组如何影响ICI疗效的具体微生物学证据，特别是聚焦于短链脂肪酸（SCFA）产生菌的作用。它直接关联到微生物组调节ICI疗效的潜在机制（代谢产物介导），并引入了irAEs作为另一个重要的临床表型维度，有助于区分疗效增强与毒性增加之间的关系。",
        "facet_contributions": [
          {
            "boundaries": "仅针对晚期黑色素瘤；样本量有限；主要基于相关性而非功能性验证。",
            "contribution": "提供了特定微生物类群（SCFA产生菌）与ICI疗效正相关的实证数据。发现响应者中F. prausnitzii及其他SCFA产生菌丰度显著高于耐药者。",
            "facet_id": "F1",
            "possible_uses": "可用于支持“有益微生物促进ICI疗效”的观点，作为微生物组调节疗效的具体案例。"
          },
          {
            "boundaries": "机制假说性质强，缺乏直接的代谢物测量或功能实验验证；观察性研究无法确立因果链条。",
            "contribution": "提出了SCFAs（特别是丁酸）可能作为介导ICI疗效和防止irAEs的潜在机制分子。发现高丰度SCFA产生菌既与响应相关，也与不发生irAEs相关。",
            "facet_id": "F2",
            "possible_uses": "用于讨论微生物组调节免疫治疗的代谢机制，特别是SCFA在平衡疗效与毒性方面的潜在双重作用。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "有助于综述中讨论为何单一多样性指标可能不足以预测疗效，需关注特定功能菌群。",
            "material": "研究区分了原发耐药和获得性耐药，发现基线α多样性无差异，但β多样性有趋势差异，说明整体群落结构可能不如特定功能菌群重要。",
            "purpose": "提供临床背景下的微生物组异质性证据"
          },
          {
            "connection_to_review": "可用于综述中探讨微生物组与免疫毒性之间的复杂关系，避免简单线性推断。",
            "material": "数据显示irAEs发生与更长PFS相关，且SCFA产生菌在未发生irAEs者中更高，这似乎与直觉相悖（通常认为irAEs预示更好疗效），提示微生物组可能通过复杂途径同时影响疗效和毒性。",
            "purpose": "引入irAEs作为微生物组研究的关联终点"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为观察性关联，不能证明SCFA产生菌直接导致更好的疗效或更少的irAEs。",
          "样本来自单一机构，可能存在选择偏倚或人群特异性。",
          "16S rRNA测序仅提供分类学信息，未提供功能基因或代谢物水平的直接证据，机制解释为作者推测。",
          "“未发生irAEs”与“高SCFA产生菌”的正相关可能与“发生irAEs”与“好疗效”的正相关存在复杂的交互作用，需谨慎解读。"
        ],
        "topic_handles": [
          "short-chain fatty acid (SCFA) producers",
          "Faecalibacterium prausnitzii",
          "immune-related adverse events (irAEs)",
          "primary vs. acquired resistance",
          "alpha/beta diversity metrics",
          "16S rRNA amplicon sequencing"
        ]
      },
      "locator": {
