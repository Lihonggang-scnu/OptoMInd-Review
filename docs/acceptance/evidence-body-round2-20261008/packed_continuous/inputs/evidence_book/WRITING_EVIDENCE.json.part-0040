        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\0cf91befe63ec25329391e50e90d14093d3c74d7\\ecd518ef49818a70b8900c1e6a7dadc5\\attempt-01\\PAPER_READING_CARD.json"
      },
      "card_material": {
        "material_scope": "fulltext"
      },
      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\0cf91befe63ec25329391e50e90d14093d3c74d7\\ecd518ef49818a70b8900c1e6a7dadc5\\attempt-01\\PAPER_READING_CARD.json"
