    "record::a54c4177705f169c0abc452e87dbdd8df0774d51f5a4cad109ff4767db37385c": {
      "source_handle": "P0030",
      "title": "Efficacy and safety of adjuvant short-course immune checkpoint inhibitors following TACE combined with MWA in patients with BCLC A–B hepatocellular carcinoma: a single-arm, prospective, phase II study protocol",
      "year": "2025",
      "doi": "10.1136/bmjopen-2025-111786",
      "paper_id": "0e52b2409fa157d1812995e5c089e1e03b4bad34",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用单臂、前瞻性、II期临床试验设计。纳入标准为BCLC A–B期HCC、ECOG评分0–1、器官功能良好且在TACE后2周及MWA后1周影像学评估均达到mRECIST完全缓解的患者。排除既往接受过其他免疫调节剂、存在活动性感染或严重合并症者。所有患者在接受TACE和MWA后2周内开始接受特瑞普利单抗治疗，持续6个月。随访直至复发、死亡或研究结束。统计分析计划包括Kaplan-Meier估计RFS和OS，Cox比例风险模型计算HR，以及描述性统计次要终点。样本量计算基于历史数据预期中位RFS从15.5个月提升至27个月（HR=0.57），需30名参与者以检测显著差异。",
        "contribution_and_limits": [
          {
            "contribution": "提供了针对特定亚群（BCLC A–B期，TACE+MWA后CR）的辅助免疫治疗标准化方案细节，包括药物剂量、疗程（6个月短程）、评估时间点及安全性监测流程。",
            "limits": "作为方案文件，缺乏实际临床结局数据；单臂设计无法提供因果推断证据，依赖外部历史数据进行比较；样本量较小（n=30），可能限制对罕见不良反应的检测能力及结果的普遍适用性；随访时间较短，无法评估长期“尾部效应”。"
          }
        ],
        "key_findings": [
          {
            "conditions": "当前材料为临床试验方案阶段",
            "finding": "所给摘要未交代实际疗效数据、安全性结果或统计学结论。文中仅包含基于历史数据的预期结果（如预期RFS改善）和研究设计的理论依据。"
          }
        ],
        "paper_kind": "methods",
        "problem_or_question": "针对早期至中期HCC患者在接受TACE联合MWA等根治性局部治疗后面临高复发率（5年内高达70%）且缺乏标准化辅助治疗的问题，探究短程辅助PD-1抑制剂（特瑞普利单抗）是否能有效降低复发风险并改善预后，同时评估其安全性。",
        "research_scope": "研究对象为巴塞罗那肝癌临床分期（BCLC）A–B期肝细胞癌（HCC）患者；情境为经动脉化疗栓塞（TACE）联合微波消融（MWA）局部治疗后达到完全缓解（CR）的高复发风险人群；范围聚焦于评估短期辅助免疫检查点抑制剂（特瑞普利单抗/Tislelizumab）的疗效与安全性。",
        "work_summary": "本文是一篇单臂、前瞻性、II期临床试验方案，旨在评估在TACE联合MWA治疗BCLC A–B期HCC并确认完全缓解后，使用6个月短程辅助特瑞普利单抗（200 mg，每3周一次）的疗效和安全性。研究主要终点为无复发生存期（RFS），次要终点包括局部肿瘤进展、肝内远处复发、肝外疾病时间、总生存期及不良事件。该研究基于TACE诱导免疫原性细胞死亡与MWA协同作用产生有利免疫微环境的理论假设，试图验证短程辅助免疫治疗的可行性。由于这是一份试验方案（Protocol），目前尚未报告实际的患者入组数据或最终结果。"
      },
      "review_planning_B": {
        "planning_summary": "该论文作为临床试验方案，虽无结果数据，但详细定义了“介入治疗（TACE/MWA）+ 辅助免疫”这一特定干预组合的操作规范、患者筛选标准及评估体系。对于综述而言，其价值在于明确该联合疗法的具体实施路径、潜在的理论机制（免疫原性细胞死亡与抗原释放）以及当前证据等级的局限性（单臂、小样本、无对照）。可用于说明该领域正在进行的探索方向及现有证据的缺口。",
        "facet_contributions": [
          {
            "boundaries": "仅提供方案设定，不提供疗效对比数据；不能证明该方案优于其他方案或观察性研究中的效果。",
            "contribution": "明确了TACE联合MWA后辅助使用PD-1抑制剂的具体给药方案（特瑞普利单抗 200mg q3w x 6个月）及适用人群（BCLC A-B, CR状态）。",
            "facet_id": "F1",
            "possible_uses": "用于回答“哪些ICIs被用于实体瘤辅助治疗”或“介入治疗后辅助免疫的标准方案有哪些”，提供具体的药物、剂量和疗程参数。"
          },
          {
            "boundaries": "这是基于文献引用的理论机制阐述，而非本研究实测的机制数据；不同介入方式（如RFA vs MWA）的效果可能存在差异，需注意外推限制。",
            "contribution": "阐述了TACE和MWA通过诱导缺血、化疗毒性及热损伤导致免疫原性细胞死亡，释放肿瘤新抗原，从而重塑肿瘤免疫微环境并增强T细胞反应的机制假设。",
            "facet_id": "F2",
            "possible_uses": "用于解释“介入治疗如何增强免疫检查点抑制剂的疗效”，提供局部治疗与免疫治疗协同作用的生物学机制背景。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供HCC辅助治疗领域的现状背景及证据缺口信息。",
            "material": "文中指出目前尚无标准化的辅助治疗方案，IMbrave050等III期研究结果存在长期获益不维持的情况，且多数研究聚焦于手术切除而非消融/介入治疗后的辅助治疗。",
            "purpose": "用于综述的背景部分，说明为何需要开展此类针对介入治疗后辅助免疫的研究，以及当前领域内证据的不一致性。"
          },
          {
            "connection_to_review": "提供关于“短程”免疫治疗可行性的讨论素材。",
            "material": "文中提到近期研究表明6个月的维持免疫治疗可提供与连续治疗相当的疗效，同时具有良好的安全性和依从性。",
            "purpose": "用于探讨ICIs治疗时长优化的相关议题，作为支持短程辅助治疗策略的文献依据之一。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为单臂试验方案，无对照组，因此任何关于疗效的声称均为预期值或基于历史数据的推测，不能作为确证性证据。",
          "研究对象限定为BCLC A-B期且经TACE+MWA达到CR的患者，结果不可直接外推至其他分期、其他局部治疗方式（如单纯TACE或RFA）或未达CR的患者。",
          "机制部分主要引用自其他研究，本研究本身未进行生物标志物或机制层面的实证分析。",
          "所给材料未交代实际入组进度、脱落情况及最终安全性数据，无法评估真实世界的耐受性。"
        ],
