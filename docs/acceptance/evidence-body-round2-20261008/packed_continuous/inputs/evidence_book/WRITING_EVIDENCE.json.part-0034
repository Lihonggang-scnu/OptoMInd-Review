          ]
        }
      ],
      "variant_group": "field::b8d492566225f7573e4d62470f054677b16a8e4da1d90fed1915d2248d8065d9",
      "multiple_values_in_field": false
    },
    "atom::ff1549e2dd006e44224958c5": {
      "atom_id": "atom::ff1549e2dd006e44224958c5",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "传统的癌症研究主要关注编码区的基因突变和信号网络，但许多肿瘤生物学现象无法用此解释。作者试图解决的核心问题是：如何利用高通量技术和多组学整合，揭示那些被忽视的、类似病原体感染的“暗物质”机制（如病毒模拟、非规范肽段、微生物互作等），以阐明癌症免疫原性的真正驱动因素，并为克服免疫治疗耐药性和实现精准医疗提供新的理论框架和治疗靶点。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::592e8e679a203ec0e4c7ccac4cd53d286f55ad435a7147b75a2d86822c0771c3",
      "multiple_values_in_field": false
    },
    "atom::48614036d2e2bbe827611111": {
      "atom_id": "atom::48614036d2e2bbe827611111",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "肿瘤免疫学中的“暗物质”（cancer dark matter），涵盖癌症细胞内在的遗传、表观遗传和代谢异常，以及影响宿主在肿瘤微环境（TME）中反应的多种因素。重点讨论病毒模拟（VM）、非规范开放阅读框（ncORFs）、转录超保守区域（T-UCRs）、微生物组、离子组和代谢组等未被传统方法充分探索的领域。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::c48382926804c959e1e97e3cae8143c524a6c4f213e4cd2d23386d8fe63899cd",
      "multiple_values_in_field": false
    },
    "atom::9a4d94abf42b8e9761236bdb": {
      "atom_id": "atom::9a4d94abf42b8e9761236bdb",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "这是一篇综述文章，旨在重新定义并扩展“癌症暗物质”的概念，从仅指代癌细胞内在的非编码RNA和蛋白质，扩展到包括影响肿瘤微环境中细胞网络的更广泛元素。文章系统梳理了多组学技术（基因组、转录组、蛋白质组、代谢组、微生物组等）如何揭示这些隐藏的生物机制，特别是通过“病毒模拟”现象增强癌症细胞的免疫原性。它探讨了这些发现对理解免疫介导的癌症排斥、免疫逃逸及治疗耐药性的意义，并提出了利用这些新靶点开发个性化免疫疗法（如基于ncORF的疫苗和CAR-T细胞疗法）的策略。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::05be2c9c1ca8c2c2ba3738623317b672b7643a0194c9d3d30e36449a258ca26b",
      "multiple_values_in_field": false
    },
    "atom::bff525444300dffc8e973e17": {
      "atom_id": "atom::bff525444300dffc8e973e17",
      "source_handle": "P0323",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物组如何影响实体瘤免疫检查点抑制剂（ICI）疗效提供了重要的背景机制和概念框架。虽然它不是专门针对微生物组与ICI相互作用的原始研究，但它明确指出了微生物组是“癌症暗物质”的重要组成部分，并通过代谢产物、免疫调节和表观遗传修饰影响TME。它为后续深入探讨具体菌种（如Akkermansia）如何通过特定分子途径增强ICI疗效提供了理论支撑和多组学整合的研究思路。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::e82426b0c20c20845a5fd328ac39556bdc2243de229cfeb39ee4b6de878c1373",
      "multiple_values_in_field": false
    },
    "atom::149d1d98058273f16a39f845": {
      "atom_id": "atom::149d1d98058273f16a39f845",
      "source_handle": "P0323",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该论文未提供具体的因果机制细节或定量比较数据，仅列举了观察到的关联；不能直接用于证明某一特定菌株的确切作用机制，需结合其他原始研究。",
        "contribution": "提供了肠道微生物组作为癌症免疫治疗关键调节因子的宏观视角，指出特定细菌物种（如Bifidobacterium, Akkermansia muciniphila）与改善抗PD-1疗法反应相关，而另一些（如Fusobacterium nucleatum）则与免疫逃逸相关。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
