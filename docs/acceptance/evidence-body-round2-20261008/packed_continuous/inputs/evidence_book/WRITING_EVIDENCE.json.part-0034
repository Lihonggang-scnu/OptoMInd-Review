      "variant_group": "field::7e06b7f8c8919fa8e968873489470ca709084e7d47f6df362e9b187bf0920d7d",
      "multiple_values_in_field": true
    },
    "atom::385432c46d26b970b5c3ca3e": {
      "atom_id": "atom::385432c46d26b970b5c3ca3e",
      "source_handle": "P0050",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制描述多为推论性或基于动物模型/小规模人类研究的汇总；具体代谢物介导的详细分子通路在本综述中未深入展开，需参考原文引用的具体研究。",
        "contribution": "阐述了微生物群通过全身免疫调节影响ICI疗效的潜在机制：有益菌群促进Th1相关反应和树突状细胞激活，增强T细胞 priming；不利菌群则促进调节性T细胞（Tregs）或髓系抑制细胞（MDSCs）。还提到微生物代谢物（如短链脂肪酸等，虽未详述但暗示代谢联系）的影响。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::2ab5e6377794919cbb52588e8cf3232d380c0b0a00349f9f7c901de13222164c",
      "multiple_values_in_field": true
    },
    "atom::171465fbfaf3786f57a84342": {
      "atom_id": "atom::171465fbfaf3786f57a84342",
