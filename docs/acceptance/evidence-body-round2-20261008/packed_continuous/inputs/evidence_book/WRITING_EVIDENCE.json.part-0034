    "atom::1d752c6ac999e16ec53adf54": {
      "atom_id": "atom::1d752c6ac999e16ec53adf54",
      "source_handle": "P0030",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "研究对象限定为BCLC A-B期且经TACE+MWA达到CR的患者，结果不可直接外推至其他分期、其他局部治疗方式（如单纯TACE或RFA）或未达CR的患者。",
      "role": "evidence",
