    "atom::0a3f8d22a54c5b8ceceaa816": {
      "atom_id": "atom::0a3f8d22a54c5b8ceceaa816",
      "source_handle": "P0030",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是基于文献引用的理论机制阐述，而非本研究实测的机制数据；不同介入方式（如RFA vs MWA）的效果可能存在差异，需注意外推限制。",
        "contribution": "阐述了TACE和MWA通过诱导缺血、化疗毒性及热损伤导致免疫原性细胞死亡，释放肿瘤新抗原，从而重塑肿瘤免疫微环境并增强T细胞反应的机制假设。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a54c4177705f169c0abc452e87dbdd8df0774d51f5a4cad109ff4767db37385c",
          "field_path": [
