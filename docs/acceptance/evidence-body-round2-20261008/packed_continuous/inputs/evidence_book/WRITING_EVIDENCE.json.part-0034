    },
    "atom::afae07208eb7b402094ef87d": {
      "atom_id": "atom::afae07208eb7b402094ef87d",
      "source_handle": "P0054",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇综述，本研究采用定性综合的方法。作者检索并筛选了关于AI在多组学分析中应用的文献，按主题分类：1) ICI响应的生物学机制（基因、表观、代谢、微生物）；2) AI算法在数据处理和特征提取中的应用；3) 预测模型的构建与性能评估；4) 临床转化挑战与未来方向。通过归纳不同癌症类型（如NSCLC、黑色素瘤、HCC等）的研究案例，总结AI-多组学集成的模式、优势及局限性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e019bc638d7f5519719278f1c816f7c200e1a8e21b65fce45b14b857ca023898",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::4fac4af84c92cd190f21b3e35d0316b605a57b7d95555626a4567169674e420a",
      "multiple_values_in_field": false
    },
    "atom::45e2edd4cbc10440b9d83ce3": {
      "atom_id": "atom::45e2edd4cbc10440b9d83ce3",
      "source_handle": "P0054",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了AI-多组学在ICI研究领域的全面框架，涵盖了从生物学机制到临床应用的完整链条，特别强调了微生物组和代谢组的作用。",
        "limits": "作为叙事性综述，未进行定量荟萃分析；所引用的研究多为回顾性或早期临床试验，缺乏大规模前瞻性随机对照试验的证据支持；不同研究间的模型性能和数据预处理方法差异较大，难以直接比较。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e019bc638d7f5519719278f1c816f7c200e1a8e21b65fce45b14b857ca023898",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::127bca7624b5dcf94db873634687f4c38e03dafc465584889074933dd87989cd",
      "multiple_values_in_field": false
    },
    "atom::b1cd20585f97af6ed463ce8f": {
      "atom_id": "atom::b1cd20585f97af6ed463ce8f",
      "source_handle": "P0054",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多种实体瘤（如NSCLC, HCC, 结直肠癌等）",
        "finding": "AI整合多组学数据（如影像+基因组+转录组）能显著优于单一生物标志物（如TMB或PD-L1），在预测ICI响应方面表现出更高的AUC（例如DenseNet模型在NSCLC中AUC>0.80）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e019bc638d7f5519719278f1c816f7c200e1a8e21b65fce45b14b857ca023898",
          "field_path": [
