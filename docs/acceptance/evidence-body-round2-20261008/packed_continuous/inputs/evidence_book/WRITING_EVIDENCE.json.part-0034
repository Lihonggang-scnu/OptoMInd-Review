    "atom::0c14d18e270937674dbe4e5a": {
      "atom_id": "atom::0c14d18e270937674dbe4e5a",
      "source_handle": "P0172",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review emphasizes limitations such as the lack of full immune component reconstitution in standard organoids, meaning findings on immune modulation may underestimate the complexity of systemic immune responses.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dea5130f2fbcac109466b46f6b88db27c77fe21845e1abee159e9a28d8c4c73b",
          "field_path": [
