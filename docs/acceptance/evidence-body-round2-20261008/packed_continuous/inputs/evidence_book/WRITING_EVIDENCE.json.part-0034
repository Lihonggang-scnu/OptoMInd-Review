            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::fa722cc4389ef19fb5c1ff5be10aa0600b9a2fc647a043aa1774245b64dd2ae6",
      "multiple_values_in_field": true
    },
    "atom::52c38d7e3a9d69f7fec13c01": {
      "atom_id": "atom::52c38d7e3a9d69f7fec13c01",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统总结了多组学技术（特别是质谱、单细胞测序、宏基因组学）在揭示癌症免疫学隐藏层面上的应用潜力和方法论进展。",
        "limits": "所给摘要未交代各技术在实际临床转化中的具体成功率、成本效益分析或标准化程度；部分技术应用仍处于早期阶段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::fa722cc4389ef19fb5c1ff5be10aa0600b9a2fc647a043aa1774245b64dd2ae6",
      "multiple_values_in_field": true
    },
    "atom::8d0dc0277036cb1f22c8130d": {
      "atom_id": "atom::8d0dc0277036cb1f22c8130d",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "强调了“病毒模拟”作为连接表观遗传异常与固有免疫反应的关键桥梁，为增强免疫治疗敏感性提供了新的机制解释。",
        "limits": "所给摘要未交代VM在不同癌症类型中的普遍性差异及个体间变异的具体量化数据；VM诱导的细胞死亡与免疫原性细胞死亡（ICD）的重叠机制尚需更多实证支持。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
