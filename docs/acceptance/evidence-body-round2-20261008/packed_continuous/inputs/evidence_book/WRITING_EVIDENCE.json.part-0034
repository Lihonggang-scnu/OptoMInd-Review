      "multiple_values_in_field": true
    },
    "atom::5b0aaf48f0f8d7206265fb06": {
      "atom_id": "atom::5b0aaf48f0f8d7206265fb06",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "HIV感染",
        "finding": "近60%认为控制良好的HIV患者ICI安全有效；对于未控制HIV，约50%医生不确定或认为存在差异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::538fdbfc7e4217ee73ed0c421d332a41c9a839837015cf08f4ab5202fd74532d",
      "multiple_values_in_field": true
    },
    "atom::6cf8b3e8698f6301f7a11732": {
      "atom_id": "atom::6cf8b3e8698f6301f7a11732",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "实体器官移植",
        "finding": "大多数拒绝治疗心脏（69%）、肺（67%）或肝脏（59%）移植患者；肾脏移植拒绝率较低（42%）。医生表现出防御性行为，承认缺乏知识。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "5"
          ]
        }
      ],
      "variant_group": "field::538fdbfc7e4217ee73ed0c421d332a41c9a839837015cf08f4ab5202fd74532d",
      "multiple_values_in_field": true
    },
    "atom::bb4aee60aad6b4020e4c26e6": {
      "atom_id": "atom::bb4aee60aad6b4020e4c26e6",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "糖皮质激素剂量阈值",
        "finding": "医生对降低ICI效力的激素剂量阈值意见不一：37%认为是0-10mg，34%是11-30mg，11%是>30mg，15%不知道。48%认为抗生素可能降低ICI效力。"
      },
      "role": "evidence",
