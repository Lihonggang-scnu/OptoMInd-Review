      "variant_group": "field::a92f96b839bb04fca40920a2d015090ea19cb4142d9916e364f92cf16194248d",
      "multiple_values_in_field": false
    },
    "atom::27849e2682f5ca0e4d6edbc7": {
      "atom_id": "atom::27849e2682f5ca0e4d6edbc7",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法。作者系统检索并整理了近年来关于肠道微生物与各类癌症治疗相互作用的研究文献。结构上，先按治疗类型（放疗、化疗、靶向、免疫、中药、康复）分类讨论微生物的影响；再按生物学机制（代谢、免疫、生物物理、胞内定植、DNA损伤）归纳深层原理；最后评估临床转化现状与挑战。文中引用了大量动物模型实验、临床试验结果及体外研究数据，并通过图表（Figure 1, 2, 3; Table 1, 2）可视化关键微生物、治疗方式及机制之间的联系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::d54b74214d59ba14e0a113f31bb9e593633dbad7e8832d85de5b81bab6a35d8b",
      "multiple_values_in_field": false
    },
    "atom::10955ca45dfa3dfb1db68a2f": {
      "atom_id": "atom::10955ca45dfa3dfb1db68a2f",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物影响多种癌症治疗模式的系统性框架，将分散的机制（代谢、免疫、生物物理等）与治疗类型（放化疗、免疫、靶向等）进行了交叉关联。",
        "limits": "作为综述，主要汇总已有观察性研究和部分临床前/临床证据，缺乏原创性的因果验证实验。所引用的机制多为相关性发现或动物模型结果，其在人类中的普适性和因果链条尚需更多功能性研究证实。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::0a480b9203ff00463636592b4b52f413bb22cdee4af9813d5b9017a5902e14c8",
      "multiple_values_in_field": true
    },
    "atom::e29eef617749cc8ea9ecb1b0": {
      "atom_id": "atom::e29eef617749cc8ea9ecb1b0",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "识别了关键的微生物标志物（如Bifidobacterium, Akkermansia, Fusobacterium）及其在不同治疗背景下的双向作用（增强疗效或导致耐药/毒性）。",
        "limits": "许多微生物-治疗关联仅在特定肿瘤类型或特定实验条件下观察到，存在显著的异质性。综述未提供具体的预测模型或标准化的临床干预方案。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::0a480b9203ff00463636592b4b52f413bb22cdee4af9813d5b9017a5902e14c8",
      "multiple_values_in_field": true
    },
    "atom::c12092fd56c97aaaa22d771f": {
      "atom_id": "atom::c12092fd56c97aaaa22d771f",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "强调了微生物干预的临床转化挑战，包括个体差异、安全性（如FMT风险）、标准化缺失及AI应用的潜力。",
        "limits": "对于如何解决这些挑战的具体技术路径（如AI模型的具体架构、工程菌的安全阈值）仅做概念性探讨，未提供实证数据支持。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::0a480b9203ff00463636592b4b52f413bb22cdee4af9813d5b9017a5902e14c8",
      "multiple_values_in_field": true
    },
    "atom::9efd44c8d2b98d8ed571bc9f": {
      "atom_id": "atom::9efd44c8d2b98d8ed571bc9f",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "免疫检查点抑制剂（ICI）治疗",
        "finding": "特定微生物（如Bifidobacterium spp., Akkermansia muciniphila）可增强CD8+ T细胞浸润和树突状细胞激活，提高ICI疗效；而Fusobacterium nucleatum等则通过抑制IFN-I信号或结合TIGIT抑制免疫反应。FMT从ICI响应者捐赠者转移至小鼠可增强PD-1阻断疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::49e01ff8751e10135154e699e842e2df1dcecaa395a30fc136b9ff4e3b1ba03d",
      "multiple_values_in_field": true
    },
    "atom::ce092787822bf7cdfcdcc03d": {
      "atom_id": "atom::ce092787822bf7cdfcdcc03d",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "化疗与放疗",
        "finding": "微生物可通过代谢药物（如Bacteroides fragilis代谢5-FU）或产生酶（如β-葡萄糖醛酸酶再活化SN-38）影响药效和毒性。某些益生菌（如Lactobacillus）可减轻放化疗引起的黏膜炎和腹泻，改善患者耐受性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::49e01ff8751e10135154e699e842e2df1dcecaa395a30fc136b9ff4e3b1ba03d",
      "multiple_values_in_field": true
    },
    "atom::ee989f3ceb5add1c8a7074f5": {
      "atom_id": "atom::ee989f3ceb5add1c8a7074f5",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "靶向治疗",
        "finding": "肠道菌群多样性与结直肠癌患者接受西妥昔单抗或贝伐珠单抗的治疗结局相关。低丰度的Trichoderma和Bifidobacterium与赫赛汀无响应相关。前列腺癌中，某些细菌可将雄激素前体转化为活性形式，削弱去势治疗疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::49e01ff8751e10135154e699e842e2df1dcecaa395a30fc136b9ff4e3b1ba03d",
      "multiple_values_in_field": true
    },
    "atom::9d371a48fcc97e6e9950d06d": {
      "atom_id": "atom::9d371a48fcc97e6e9950d06d",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "传统中药（TCM）",
        "finding": "TCM成分可被肠道微生物生物转化，影响其生物利用度；同时TCM可重塑菌群组成，通过肠-肝、肠-脑轴调节免疫和炎症，可能作为现代免疫治疗的辅助手段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::49e01ff8751e10135154e699e842e2df1dcecaa395a30fc136b9ff4e3b1ba03d",
      "multiple_values_in_field": true
    },
    "atom::a3082c99e7ddae67c17ed1db": {
      "atom_id": "atom::a3082c99e7ddae67c17ed1db",
      "source_handle": "P0532",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肿瘤微环境（TME）重塑",
        "finding": "微生物代谢物（如SCFAs、色氨酸衍生物）可调节肿瘤细胞代谢和免疫细胞功能。某些细菌（如Clostridium perfringens）可通过表观遗传调控促进糖酵解。微生物还可改变ECM刚度和细胞骨架，促进转移。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::985cab2b009c52150a52917972e753786f42fe951a33ac6dbc282218b7ae260d",
