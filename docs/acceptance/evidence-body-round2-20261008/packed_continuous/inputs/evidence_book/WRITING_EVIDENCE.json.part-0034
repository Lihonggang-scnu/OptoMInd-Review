          ]
        }
      ],
      "variant_group": "field::fa722cc4389ef19fb5c1ff5be10aa0600b9a2fc647a043aa1774245b64dd2ae6",
      "multiple_values_in_field": true
    },
    "atom::6dba659dc8e8f1a92e6f3d8a": {
      "atom_id": "atom::6dba659dc8e8f1a92e6f3d8a",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在癌症细胞中，特别是在存在表观遗传失调或DNA损伤的情况下",
        "finding": "内源性逆转录病毒（ERVs）的激活导致双链RNA（dsRNA）积累，引发“病毒模拟”（VM），进而激活干扰素刺激基因（ISGs），招募并激活CD8+ T细胞，形成免疫排斥常数（ICR）特征。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::e56c8ee00cce0e1f609e8a101ff87de9e11e63a4aad6c59cfdd1ab80887d932a",
      "multiple_values_in_field": true
    },
    "atom::196a97718b5b6019ccd08b7d": {
      "atom_id": "atom::196a97718b5b6019ccd08b7d",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在非编码基因组区域",
        "finding": "非规范开放阅读框（ncORFs）和转录超保守区域（T-UCRs）可产生非规范肽段或调控性RNA，这些产物在正常组织中不表达，因此被视为“外来”抗原，具有高度免疫原性，可作为个性化免疫治疗的靶点。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
