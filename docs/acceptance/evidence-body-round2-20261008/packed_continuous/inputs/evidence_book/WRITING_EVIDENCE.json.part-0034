      ],
      "value": "提供AI在多组学整合中的角色概述，特别是如何将微生物数据与其他生物标志物结合。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "review_planning_B",
