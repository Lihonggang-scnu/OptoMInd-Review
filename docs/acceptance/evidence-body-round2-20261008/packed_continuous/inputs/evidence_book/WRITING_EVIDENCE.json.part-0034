            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::f23d084733b62197c79fe37505ea44f14ce9fdb8d64af4b06cefdac3e5d19d7a",
      "multiple_values_in_field": true
    },
    "atom::3ddbb86f153b8174e4273209": {
      "atom_id": "atom::3ddbb86f153b8174e4273209",
      "source_handle": "P0323",
      "field_path": [
