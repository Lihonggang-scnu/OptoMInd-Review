    "atom::ceeec32b7353a2937b49cad2": {
      "atom_id": "atom::ceeec32b7353a2937b49cad2",
      "source_handle": "P0172",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review focuses heavily on colorectal cancer and intestinal organoids; extrapolation to other solid tumors should be done with caution as the TME and microbiome composition differ significantly across cancer types.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dea5130f2fbcac109466b46f6b88db27c77fe21845e1abee159e9a28d8c4c73b",
          "field_path": [
