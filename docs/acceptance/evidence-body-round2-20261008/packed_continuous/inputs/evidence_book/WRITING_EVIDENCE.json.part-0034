      "multiple_values_in_field": true
    },
    "atom::2dfae72d584f66d8e321a1a6": {
      "atom_id": "atom::2dfae72d584f66d8e321a1a6",
      "source_handle": "P0054",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肠道微生物组分析",
        "finding": "特定菌群（如Bacteroides caccae, Prevotella copri）丰度与ICI响应正相关，抗生素使用导致的菌群失调与耐药相关；AI可识别这些微生物特征并预测疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e019bc638d7f5519719278f1c816f7c200e1a8e21b65fce45b14b857ca023898",
          "field_path": [
