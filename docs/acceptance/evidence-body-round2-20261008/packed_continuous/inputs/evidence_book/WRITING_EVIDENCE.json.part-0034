    "atom::46682478facb5aaa26af0904": {
      "atom_id": "atom::46682478facb5aaa26af0904",
      "source_handle": "P0008",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "化疗副作用",
        "finding": "特定菌群（如肠球菌科、链球菌科）的高丰度与中性粒细胞发热、腹泻等急性并发症相关；Faecalibacterium减少可能与长期肥胖和代谢综合征风险相关。"
      },
