    "atom::98aeff8a1cc25ec30c221b66": {
      "atom_id": "atom::98aeff8a1cc25ec30c221b66",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "横断面意见调查（Survey）。设计包含Likert量表、多选题和开放式问题的问卷，覆盖特定临床情境。通过电子邮件和社交媒体分发，限制每个IP地址一次有效回答，并要求受访者具备一定临床经验（>20例ICI治疗NSCLC患者）以确保数据质量。使用描述性统计方法分析计数和百分比。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::50607fdeb39b2b2d3d90e821dad2724b47ec8aef50cf4e20bc9bf318731b3628",
      "multiple_values_in_field": false
    },
    "atom::3a53d08ff4d0e3d27fa021a7": {
      "atom_id": "atom::3a53d08ff4d0e3d27fa021a7",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于ICI单药治疗NSCLC临床实践中主要知识空白的全球专家共识视图，特别是针对被排除在关键试验之外的患者亚群。",
        "limits": "样本存在选择偏差（由作者网络发起，虽经多渠道扩散但仍可能偏向特定群体）；自我报告的意见主观性强，不一定代表广泛的实际经验；定义可能缺乏共识；仅反映观点而非客观临床结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::071ea7bb2c42ff660ac61251c80512b17a191038e493311d5db9a9c4cceced6a",
      "multiple_values_in_field": false
    },
    "atom::58cec9b865f75116325cab3c": {
      "atom_id": "atom::58cec9b865f75116325cab3c",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "老年患者（>70岁）",
        "finding": "74%的医生认为ICI在老年患者中的安全性和有效性等同于年轻患者；但承认该领域仍有重要证据缺口。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::538fdbfc7e4217ee73ed0c421d332a41c9a839837015cf08f4ab5202fd74532d",
      "multiple_values_in_field": true
    },
    "atom::6980f2c5b915fb7b596040f9": {
      "atom_id": "atom::6980f2c5b915fb7b596040f9",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ECOG PS 0-2 vs PS 3-4",
        "finding": "94%同意治疗PS 0-2患者；36%同意治疗PS 3患者；仅6%认为PS 4合理。多数（63%）认为PS 2-3患者缺乏证据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::538fdbfc7e4217ee73ed0c421d332a41c9a839837015cf08f4ab5202fd74532d",
      "multiple_values_in_field": true
    },
    "atom::60341f6cf52d4d3f131b80f3": {
      "atom_id": "atom::60341f6cf52d4d3f131b80f3",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "无症状 vs 有症状脑转移",
        "finding": "81%相信ICI对无症状脑转移有效；仅30%同意治疗有症状脑转移。后者被视为第二大研究优先级。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::538fdbfc7e4217ee73ed0c421d332a41c9a839837015cf08f4ab5202fd74532d",
      "multiple_values_in_field": true
    },
    "atom::63c21e6923221667803db965": {
      "atom_id": "atom::63c21e6923221667803db965",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "自身免疫疾病（AIDs）",
        "finding": "77%仅在低严重程度情况下治疗；74%认为安全性较差，但65%认为疗效相似。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "key_findings",
