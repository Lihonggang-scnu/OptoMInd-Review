        }
      ],
      "variant_group": "field::7a44e61d3dccb37dd4b87236a0d86fd7f9f2aa8fcfa1e165513c38a670f784b8",
      "multiple_values_in_field": true
    },
    "atom::5e2cdcb660a4282a1d40663d": {
      "atom_id": "atom::5e2cdcb660a4282a1d40663d",
      "source_handle": "P0172",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
