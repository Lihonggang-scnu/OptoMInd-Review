    "atom::9924eec753c39941138d19c7": {
      "atom_id": "atom::9924eec753c39941138d19c7",
      "source_handle": "P0555",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "大多数干预措施的效果在临床研究中仍处于早期阶段（I/II期），样本量小，结果不一致。需要区分哪些是已证实有效的，哪些仅是潜在策略。",
        "contribution": "讨论了克服ICIs耐药的微生物策略，包括FMT、益生菌（如Lactobacillus gallinarum）、益生元（如菊粉凝胶）、饮食干预（生酮饮食）及药物联合（如Salinomycin）。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9d6752483bee6d7741694b722ecf47186cc6e16922d9962fbd38123f308151ac",
