    "atom::d1619fdda7516b77df89edca": {
      "atom_id": "atom::d1619fdda7516b77df89edca",
      "source_handle": "P0439",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性综述方法，综合了来自临床前研究（动物模型、体外实验）和临床研究（人类队列、病例报告、准实验研究）的证据。作者并未进行系统性的文献检索或定量荟萃分析，而是基于已有文献对微生物组组成、代谢产物、免疫细胞互作以及各类干预手段的效果进行定性描述和机制解释。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00ae381a8034efc1a09ecfba7f2db97f097122981f23691eb955bf881c3494e2",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::0a5e7e38224a418f41aea9f933e23b25d81e60b81a56eee239d64a9105b99c30",
      "multiple_values_in_field": false
    },
    "atom::c52075ce0089f1f796870060": {
      "atom_id": "atom::c52075ce0089f1f796870060",
      "source_handle": "P0439",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统梳理了肠道微生物组影响CRC免疫治疗响应的多种机制路径（包括代谢物、免疫细胞招募、屏障功能等），并汇总了益生菌、FMT、饮食及中药等多种干预手段的临床前和部分临床证据。",
        "limits": "作为叙事性综述，未进行系统性文献检索或偏倚风险评估；结论受限于所引用研究的异质性（样本量小、设计多样）；部分发现（如A. muciniphila的作用）存在矛盾；缺乏对干预措施直接比较的定量证据；安全性讨论主要基于个案或小规模试验，尚不足以确立常规临床应用的规范。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00ae381a8034efc1a09ecfba7f2db97f097122981f23691eb955bf881c3494e2",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::f9fa560ea726cbcf22ed1ae80d818365db9a4a5856d5cec412d010eb02ce22ba",
      "multiple_values_in_field": false
    },
    "atom::84c41d1446ea2fd02ca22186": {
      "atom_id": "atom::84c41d1446ea2fd02ca22186",
      "source_handle": "P0439",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "MSS/pMMR CRC模型及临床背景",
        "finding": "特定微生物群（如Akkermansia muciniphila, Bifidobacterium, Lactobacillus等）及其代谢产物（如短链脂肪酸SCFAs）可通过促进CD8+ T细胞浸润、抑制调节性T细胞（Tregs）和髓源性抑制细胞（MDSCs），增强抗PD-1/PD-L1疗法的疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00ae381a8034efc1a09ecfba7f2db97f097122981f23691eb955bf881c3494e2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::820aaa1a9c5a2dcb7dff2bcdb05cde724af0ca2143256a6f3cb2ff4abd0c3cfc",
      "multiple_values_in_field": true
    },
    "atom::0bb6354b1ffa085e58316dd9": {
      "atom_id": "atom::0bb6354b1ffa085e58316dd9",
      "source_handle": "P0439",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同菌株作用",
        "finding": "部分病原体（如Fusobacterium nucleatum, Porphyromonas gingivalis）通过诱导免疫抑制微环境降低ICIs疗效；而某些益生菌株（如L. paracasei sh2020）可增强抗CTLA-4疗法效果。A. muciniphila的作用存在争议，既有促癌报道也有抑癌报道，但与C. butyricum联用可协同增强疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00ae381a8034efc1a09ecfba7f2db97f097122981f23691eb955bf881c3494e2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::820aaa1a9c5a2dcb7dff2bcdb05cde724af0ca2143256a6f3cb2ff4abd0c3cfc",
      "multiple_values_in_field": true
    },
    "atom::eeec402edb49ca9e42b9e1d0": {
      "atom_id": "atom::eeec402edb49ca9e42b9e1d0",
      "source_handle": "P0439",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "FMT临床应用",
        "finding": "FMT联合ICIs在MSS转移性CRC的II期临床试验（RENMIN-215）中显示出改善生存率和可控的安全性，外周γδ2 T细胞水平升高与响应相关。但FMT存在供体筛选困难、耐药基因转移及感染风险等安全顾虑。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00ae381a8034efc1a09ecfba7f2db97f097122981f23691eb955bf881c3494e2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::820aaa1a9c5a2dcb7dff2bcdb05cde724af0ca2143256a6f3cb2ff4abd0c3cfc",
      "multiple_values_in_field": true
    },
    "atom::85a176f85847c29434a827f6": {
      "atom_id": "atom::85a176f85847c29434a827f6",
      "source_handle": "P0439",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "其他干预手段",
        "finding": "中药复方（如清解胶囊、葛根芩连汤）和膳食纤维饮食可调节菌群结构，增加有益菌丰度，抑制肿瘤生长；工程化益生菌和纳米技术递送系统展示了克服免疫耐药的潜力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00ae381a8034efc1a09ecfba7f2db97f097122981f23691eb955bf881c3494e2",
