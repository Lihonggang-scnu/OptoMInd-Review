            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::e56c8ee00cce0e1f609e8a101ff87de9e11e63a4aad6c59cfdd1ab80887d932a",
      "multiple_values_in_field": true
    },
    "atom::704d0e893ed1e1ad020b1e48": {
      "atom_id": "atom::704d0e893ed1e1ad020b1e48",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在肿瘤微环境（TME）中",
        "finding": "肠道和肿瘤驻留微生物群通过代谢产物、免疫细胞信号和表观遗传修饰调节宿主免疫反应，特定细菌物种（如Bifidobacterium, Akkermansia muciniphila）与免疫检查点抑制剂（CPI）疗效正相关，而其他物种（如Fusobacterium nucleatum）则促进免疫逃逸。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65e5130149e6543e9b31644991917228a0cce9335c3e4b4847c3a019becb8ee4",
          "field_path": [
