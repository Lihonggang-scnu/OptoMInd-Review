    "atom::9c3df0e28beb6af3be145e7b": {
      "atom_id": "atom::9c3df0e28beb6af3be145e7b",
      "source_handle": "P0054",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述是叙事性的，其结论依赖于对所引用文献的选择性综合，可能存在发表偏倚。",
      "role": "evidence",
      "origins": [
