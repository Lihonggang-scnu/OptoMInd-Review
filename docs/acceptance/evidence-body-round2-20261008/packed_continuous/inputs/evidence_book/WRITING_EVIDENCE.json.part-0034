    "atom::ebe0cc71c6bcd5001050b0cf": {
      "atom_id": "atom::ebe0cc71c6bcd5001050b0cf",
      "source_handle": "P0172",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Many mechanistic insights are derived from in vitro organoid models or animal studies cited within the review; these do not constitute direct clinical evidence from human ICI trials.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dea5130f2fbcac109466b46f6b88db27c77fe21845e1abee159e9a28d8c4c73b",
