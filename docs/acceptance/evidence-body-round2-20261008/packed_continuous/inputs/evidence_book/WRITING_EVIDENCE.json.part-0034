            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::859ee4fdd7c5d3fa7e96842e42354a02538072e4e896522a9218c0396d663f73",
      "multiple_values_in_field": false
    },
    "atom::122ca4b0f3810fb148bbb794": {
      "atom_id": "atom::122ca4b0f3810fb148bbb794",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管ICI改变了NSCLC的治疗格局，但关键临床试验排除了许多真实世界常见患者群体（如老年人、脑转移、合并症患者），导致临床证据存在缺口。本研究试图明确医生在实际操作中遇到的主要挑战，并确定哪些领域最需要前瞻性临床研究来填补证据空白。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::3acd4dc7dbf38ecf7b97f3579d4ce37b20b6712f4c8fe551ded8562b293abff4",
      "multiple_values_in_field": false
    },
    "atom::88701ff49db3112307221f93": {
      "atom_id": "atom::88701ff49db3112307221f93",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "非小细胞肺癌（NSCLC）患者使用免疫检查点抑制剂（ICIs）单药治疗的临床实践挑战；调查对象为有ICI治疗经验的肿瘤科医生，重点关注老年人群、体能状态（PS）、脑转移、合并症（自身免疫病、HIV、器官移植）、伴随用药（激素、抗生素）、肠道微生物组影响、疗效预测因子、治疗持续时间及不典型反应等情境。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::97c9efb6db8d0df26bc2a15800a8525b9ac879d40c51c9d63f8398209ed315fe",
      "multiple_values_in_field": false
    },
    "atom::60a2f20875af05d3fe99a0bc": {
      "atom_id": "atom::60a2f20875af05d3fe99a0bc",
      "source_handle": "P0524",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在评估肿瘤科医生在NSCLC临床实践中使用ICI单药治疗时面临的主要挑战和知识空白。通过Oncodistinct跨国研究网络发起了一项在线问卷调查，涵盖18个具体主题和一个开放性问题。问卷经过两轮专家试点测试验证。数据收集于2019年9月至2020年2月，采用雪球法传播。最终分析纳入106名完全填写问卷且自报治疗过至少20名NSCLC患者的医生的回答。结果以描述性统计呈现，识别了临床决策中的不确定性领域和优先研究方向。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::997072e4e78cd15e0ceed7eb01e1e155083a6c659b1bd81eeb4722fbec8c4e1e",
      "multiple_values_in_field": false
    },
    "atom::cfac5899880e3cc0c32dd898": {
      "atom_id": "atom::cfac5899880e3cc0c32dd898",
      "source_handle": "P0524",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文通过调查肿瘤科医生的意见，量化了ICI单药治疗NSCLC中未被充分研究的临床场景的重要性排序。对于综述而言，它提供了关于哪些临床情境（如脑转移、合并症、伴随用药）被认为最具挑战性且急需证据的专家视角，并指出了当前生物标志物预测能力的不足。特别地，它确认了肠道微生物组和抗生素使用作为潜在疗效调节因素的临床关注度。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::6fea54cc08765cee6d74a6cbe91208acaec414cad01f3cd9be63441ac192d946",
      "multiple_values_in_field": false
    },
    "atom::7a0d2c48407b62f03e6e40c9": {
      "atom_id": "atom::7a0d2c48407b62f03e6e40c9",
      "source_handle": "P0524",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是基于医生意见的调查数据，而非直接的微生物组机制研究或临床干预结果。未提供具体的微生物种类或代谢产物数据。",
        "contribution": "提供了临床医生对肠道微生物组影响ICI疗效的认知现状：61%的医生认为调节肠道菌群可增加ICI疗效，且将其列为重要挑战。同时提到质子泵抑制剂也可能通过影响微生物组降低ICI疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::91dba533a4ceebd9fd1a3655c8d03c7751be2d46717f8d698f27f19d9c8697a0",
      "multiple_values_in_field": true
    },
    "atom::dfab2cb4f81592a9396c94e7": {
      "atom_id": "atom::dfab2cb4f81592a9396c94e7",
      "source_handle": "P0524",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于综述中说明临床界面对微生物组干预潜力的认可度，以及当前证据不足以指导常规临床决策的现状。可作为背景支持为何需要深入研究微生物组机制。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::7d81d1d2f16ac2b2e0fc98a55b7d9b01200a9e53c1ebf6d4884ab2ccbcad215a",
      "multiple_values_in_field": true
    },
    "atom::efc7e397075ef5d4d8a3d1e9": {
      "atom_id": "atom::efc7e397075ef5d4d8a3d1e9",
      "source_handle": "P0524",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要引用回顾性研究和观察性研究的相关性，未阐明具体的分子或免疫学机制。机制部分（如HPD/PPD的生物机制）明确指出尚未完全理解。",
        "contribution": "讨论了抗生素可能通过改变肠道微生物组导致菌群失调（dysbiosis），进而与较低的ICI结局相关。提及粪菌移植（FMT）和活体生物疗法正在临床试验中被探索以增强ICI疗效。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::73c7e44b19c4b9d1fe3f5c8d057db778987486580e8579626ba6d6df95f47c10",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::91dba533a4ceebd9fd1a3655c8d03c7751be2d46717f8d698f27f19d9c8697a0",
      "multiple_values_in_field": true
    },
    "atom::f4921f1ecbdfeec9961b1fb7": {
      "atom_id": "atom::f4921f1ecbdfeec9961b1fb7",
      "source_handle": "P0524",
      "field_path": [
