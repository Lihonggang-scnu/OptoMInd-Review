    "atom::255c1ac5573e1e3e404d5afb": {
      "atom_id": "atom::255c1ac5573e1e3e404d5afb",
      "source_handle": "P0172",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conduct a narrative review by systematically categorizing existing literature on organoid-based microbiome-TME research. They structure the analysis around: (1) classification of organoid models and their comparative advantages; (2) specific mechanistic insights gained from organoid studies (e.g., inflammation, genotoxicity, metabolite effects); (3) technological integrations (multi-omics, organ-on-a-chip); and (4) clinical translation potential (drug screening, biomarkers). The approach involves summarizing findings from cited empirical studies, highlighting methodological trends, and providing critical commentary on the limitations of current organoid platforms.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dea5130f2fbcac109466b46f6b88db27c77fe21845e1abee159e9a28d8c4c73b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::940585233c15319bb0493dca8140cfc22140ea8715b1412f3231cc4af3681a2e",
      "multiple_values_in_field": false
    },
