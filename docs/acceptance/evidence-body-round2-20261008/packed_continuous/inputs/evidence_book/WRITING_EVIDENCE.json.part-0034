            "broader_review_uses",
            "1"
          ]
        }
      ],
      "variant_group": "field::6c30e99ef73cb1b6f17c0431d2dc655dbfedee8cf36a4a3c6bd4f89ead90bc0a",
      "multiple_values_in_field": true
    },
    "atom::7b021788de862378651fbff0": {
      "atom_id": "atom::7b021788de862378651fbff0",
      "source_handle": "P0045",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "可用于强调当前领域缺乏高质量的前瞻性数据，特别是关于GM多样性（而非特定菌属）对新辅助治疗反应的影响，从而突出本综述的必要性和未来研究方向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::b5ffa54698a5c4af1cec136e412ab56d7b386ea322f04fcab115740db1fa1a6e",
