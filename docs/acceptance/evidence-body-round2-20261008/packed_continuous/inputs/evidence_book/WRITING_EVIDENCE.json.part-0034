      "variant_group": "field::76c3b271a8ae1e2ae10251f4b976b8910effc2b6939edcd6d214de678b3f98dc",
      "multiple_values_in_field": true
    },
    "atom::913de4464db2b6d75d05700f": {
      "atom_id": "atom::913de4464db2b6d75d05700f",
      "source_handle": "P0054",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肿瘤微环境与干细胞特性",
        "finding": "高干细胞评分（如MKI67/STMN1表达）和冷肿瘤微环境（免疫排斥）与较差的ICI预后相关；AI模型可识别这些特征并建议联合治疗（如化疗或靶向药）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e019bc638d7f5519719278f1c816f7c200e1a8e21b65fce45b14b857ca023898",
