    },
    "atom::23e2dbdd103ad4a082674b6a": {
      "atom_id": "atom::23e2dbdd103ad4a082674b6a",
      "source_handle": "P0323",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
