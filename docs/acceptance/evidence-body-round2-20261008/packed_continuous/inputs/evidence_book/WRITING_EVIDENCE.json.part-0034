        "broader_review_uses"
      ],
      "value": {
        "material": "摘要明确指出“little is known about how the GM diversity influences complete pathological response”，且研究预计2025年出结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b5ffa54698a5c4af1cec136e412ab56d7b386ea322f04fcab115740db1fa1a6e",
          "field_path": [
