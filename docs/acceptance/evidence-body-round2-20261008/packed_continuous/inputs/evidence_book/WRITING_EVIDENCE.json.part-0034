    "atom::0ce1b951dbdb5d2b97b5edac": {
      "atom_id": "atom::0ce1b951dbdb5d2b97b5edac",
      "source_handle": "P0050",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇综述，本研究通过系统性梳理现有文献，归纳了ICI耐药的多组学机制（第2节），分类总结了不同癌症类型中AI整合多组学的代表性研究及其性能指标（Table 2, 第3节），分析了AI在临床决策支持（如组合疗法推荐、影像病理工作流嵌入）中的具体应用案例（第4节），并评估了从实验室到临床转化的现实挑战（数据标准化、隐私、伦理、成本）及新兴技术趋势（第5节）。未进行新的原始实验或系统检索流程报告。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::1e0d4b774d8beabd6bcb1b5ba72b350ed34d29542b3d5d81c1828d2dc91ca732",
      "multiple_values_in_field": false
    },
    "atom::5060ee12ac9d77c757e11b38": {
      "atom_id": "atom::5060ee12ac9d77c757e11b38",
      "source_handle": "P0050",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了ICI耐药机制的多组学全景图，并将AI技术定位为整合这些复杂数据的关键工具；总结了当前AI多组学模型在不同癌症类型中的性能表现和应用模式。",
        "limits": "作为综述，其结论依赖于所引用的原始研究的质量和设计；大多数被引用的AI模型基于回顾性队列，缺乏大规模前瞻性随机对照试验（RCT）的最终验证；作者未提供新的实证数据来证明所述模型的普适性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::e4e07084199e293296cbf31950c7b678f91780d830af5300a6003ad9abab8a34",
      "multiple_values_in_field": false
    },
    "atom::4dfc07039e516d5ef86ad422": {
      "atom_id": "atom::4dfc07039e516d5ef86ad422",
      "source_handle": "P0050",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "非小细胞肺癌（NSCLC）、黑色素瘤、肾细胞癌（RCC）等多种实体瘤",
        "finding": "多组学整合模型（结合基因组、转录组、影像或微生物组）的预测性能（AUC通常0.70-0.85）普遍优于单一标志物（如PD-L1或TMB，AUC约0.6-0.7），能更准确区分响应者与无响应者。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::aea239e87eedca07dc5840e32c42d3f4577bf0e410c7784fc859582f0b653bb5",
      "multiple_values_in_field": true
    },
    "atom::87abb19ba45c4ce814542c99": {
      "atom_id": "atom::87abb19ba45c4ce814542c99",
      "source_handle": "P0050",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肠道微生物群分析",
        "finding": "特定菌群（如Bacteroides, Prevotella）丰度与ICI疗效正相关；抗生素使用或菌群失调导致疗效下降；粪菌移植（FMT）在部分研究中显示出逆转耐药的潜力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::aea239e87eedca07dc5840e32c42d3f4577bf0e410c7784fc859582f0b653bb5",
      "multiple_values_in_field": true
    },
    "atom::7cecb6d0693e3c6ac5332efd": {
      "atom_id": "atom::7cecb6d0693e3c6ac5332efd",
      "source_handle": "P0050",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "AI模型可解释性应用",
        "finding": "SHAP和Grad-CAM等方法能将黑盒模型的预测结果映射回具体的生物学特征（如CXCL9表达、特定突变、组织形态区域），增强了临床信任并为机制假设提供依据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::aea239e87eedca07dc5840e32c42d3f4577bf0e410c7784fc859582f0b653bb5",
      "multiple_values_in_field": true
    },
    "atom::48aaab455fe838ba03e358ca": {
      "atom_id": "atom::48aaab455fe838ba03e358ca",
      "source_handle": "P0050",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "临床转化场景",
        "finding": "AI不仅用于预测疗效，还能指导联合治疗策略（如针对高干细胞特征肿瘤推荐EGFR靶向药，针对高乳酸产生肿瘤推荐代谢抑制剂），并在新辅助治疗和液体活检监测中展现潜力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::561c4734f5520cfca65ea498c914551fd5515e599fb97bfa442a8164105d6352",
