    "atom::c823cde6fd7be8f3503cb7e3": {
      "atom_id": "atom::c823cde6fd7be8f3503cb7e3",
      "source_handle": "P0008",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "系统性文献回顾。作者检索了EMBASE、Web of Science、MEDLINE等数据库，关键词包括(gut microbiota OR gut microbiome) AND (cancer OR oncology) AND (paediatric OR children)。文章结构上先介绍一般背景，再分章节讨论致癌机制、全身治疗相互作用、儿科特异性（发病率、治疗诱导的变化、急慢性并发症）、干预措施，最后总结局限性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9dc603c11ee193c68e27ba99a21eecc233485dce2740f45527209f089d28f6d",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::498eccf4529af2cf5b4977044bd611a290bdfce68ee17fadd28f027f800efd9d",
      "multiple_values_in_field": false
    },
    "atom::304fdc7a467cbc5937eb2a85": {
      "atom_id": "atom::304fdc7a467cbc5937eb2a85",
      "source_handle": "P0008",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统梳理了儿科肿瘤中微生物组研究的现状，特别区分了血液恶性肿瘤和实体瘤的证据差异。",
        "limits": "主要基于观察性研究和小型试点研究，缺乏大规模前瞻性试验；无法确立因果关系（是原因还是结果）；实体瘤数据极度匮乏。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9dc603c11ee193c68e27ba99a21eecc233485dce2740f45527209f089d28f6d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::866b78d5936aaefb212ea3f256fa85d2c9e20424a301aabea4f083c4e15514fc",
      "multiple_values_in_field": true
    },
    "atom::31af98e275ea3928cfba54b1": {
      "atom_id": "atom::31af98e275ea3928cfba54b1",
      "source_handle": "P0008",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了微生物组作为预测生物标志物和个性化治疗靶点的潜力。",
        "limits": "目前尚无标准化的干预方案（如益生菌、FMT）在儿科肿瘤中的确切疗效和安全性数据，部分干预存在潜在风险（如菌血症）。"
      },
      "role": "evidence",
      "origins": [
