    "atom::12363531687bd0f2719c4c07": {
      "atom_id": "atom::12363531687bd0f2719c4c07",
      "source_handle": "P0270",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为反例，证明并非所有癌症都对相同的微生物组合产生反应，反对过度泛化的微生物生物标志物主张。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
