      "multiple_values_in_field": true
    },
    "atom::bda9398beeaca0e40b1be14c": {
      "atom_id": "atom::bda9398beeaca0e40b1be14c",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Longitudinal analysis (n=9 patients across treatment cycles)",
        "finding": "帕博利珠单抗治疗未引起全局微生物组成的显著变化；个体内样本聚类紧密，时间点对变异贡献极小（<3%）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
