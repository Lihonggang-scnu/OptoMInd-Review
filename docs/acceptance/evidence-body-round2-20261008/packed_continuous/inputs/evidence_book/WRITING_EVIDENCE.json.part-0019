      "atom_id": "atom::6ec3f9ffb629d6a51133142e",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "First Timepoint cohort (n=23), 16S sequencing & qPCR",
        "finding": "整体α和β多样性在反应者与非反应者间无显著差异；个体间变异占主导（~50%）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
