          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::6c426dc26a1f59f04ad247330690ecbd36127e3ead51b6611660113734a9e427",
      "multiple_values_in_field": true
    },
