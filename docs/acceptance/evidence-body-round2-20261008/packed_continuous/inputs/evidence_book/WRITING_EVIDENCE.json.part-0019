    "atom::3fdef1c619b12e2eea118d7b": {
      "atom_id": "atom::3fdef1c619b12e2eea118d7b",
      "source_handle": "P0298",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "建议未来研究应关注微生物组的功能潜力（而非仅分类学），采用宏基因组测序，并进行前瞻性干预试验（如饮食、益生菌、FMT）以验证因果性和治疗潜力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7",
