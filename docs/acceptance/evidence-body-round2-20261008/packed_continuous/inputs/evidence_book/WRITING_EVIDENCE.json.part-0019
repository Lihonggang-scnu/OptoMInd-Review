      "multiple_values_in_field": true
    },
    "atom::7d922f870245277cb78e9a52": {
      "atom_id": "atom::7d922f870245277cb78e9a52",
      "source_handle": "P0204",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "预测模型构建",
        "finding": "建立了包含18个细菌物种的模型，用于预测免疫治疗是否带来持续获益，曲线下面积（AUC）为75.63%。"
      },
      "role": "evidence",
