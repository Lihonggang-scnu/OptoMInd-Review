      "atom_id": "atom::ce841060b0ddf5f713ebf86b",
      "source_handle": "P0298",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究结论仅限于NSCLC和黑色素瘤，不能直接外推到其他实体瘤或血液肿瘤。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7",
