    "atom::e8a2aaa35d093c8ed7f79883": {
      "atom_id": "atom::e8a2aaa35d093c8ed7f79883",
      "source_handle": "P0364",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用混合方法：首先进行文献计量学映射，包括关键词共现网络、引用共现分析、主题演化分析和战略主题图，以描绘科学产出、智力结构和主题演变；其次，检索ClinicalTrials.gov评估干预性临床试验的活动；最后，进行定性的跨队列功能综合，选取具有明确响应者/非响应者定义的代表性临床研究（Level 4）和临床前研究（Level 2），比较其微生物特征、代谢通路和免疫机制，构建概念框架。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::09453c46fe36046e2b9f48ff6256228cf0dc85f082eb8d8faf50756318235919",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ab78503775b7936aca4c4ba81427d2681bfc80175c98343391229b00152f21a3",
      "multiple_values_in_field": false
    },
    "atom::8e2687bbb100ff34b25cb2d9": {
      "atom_id": "atom::8e2687bbb100ff34b25cb2d9",
      "source_handle": "P0364",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了将文献计量学结构与跨队列功能解释相结合的综合视角，解释了分类学不一致背后的功能趋同可能性，并为基于功能的生物标志物开发提供了理论依据。",
        "limits": "所给摘要未交代具体的统计检验细节；定性综合依赖于单作者筛选，可能存在选择偏差；未能提供合并效应量；依赖单一数据库（WoSCC）和英语文献，可能存在语言和数据库偏差；因果推断仍受限于观察性研究和混杂因素。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::09453c46fe36046e2b9f48ff6256228cf0dc85f082eb8d8faf50756318235919",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::2ff1c8b2d00110526efbc9c6d236f8c0b08aff64e8d9896dd777f18a952eaf4e",
      "multiple_values_in_field": false
    },
    "atom::f70f007dd2cadd7ff269cb8e": {
      "atom_id": "atom::f70f007dd2cadd7ff269cb8e",
      "source_handle": "P0364",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "2013-2025年文献计量学与临床试验数据",
        "finding": "研究产出呈指数增长，2018年标志性人类队列研究后出现转化激增，临床试验启动在2021年达到峰值。主题从早期的机制探索和特定药物关注转向以FMT、微生物代谢物和多组学为核心的临床干预导向。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::09453c46fe36046e2b9f48ff6256228cf0dc85f082eb8d8faf50756318235919",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::d8204990bf09a3777f76f1c305c3c01e8c6c33a86654ac7769c552b8520495f3",
      "multiple_values_in_field": true
    },
    "atom::cc17e4f3c24c70c94dd6fc02": {
      "atom_id": "atom::cc17e4f3c24c70c94dd6fc02",
      "source_handle": "P0364",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "跨队列代表性临床及临床前研究（n=8）",
        "finding": "响应者相关的微生物群表现出支持代谢和免疫有利的特征，如短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏；而非响应者则显示失调和免疫抑制特征。尽管具体菌种不同，但免疫通路呈现功能趋同。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::09453c46fe36046e2b9f48ff6256228cf0dc85f082eb8d8faf50756318235919",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::d8204990bf09a3777f76f1c305c3c01e8c6c33a86654ac7769c552b8520495f3",
      "multiple_values_in_field": true
    },
    "atom::9b134360649fc3d7a4fc5945": {
      "atom_id": "atom::9b134360649fc3d7a4fc5945",
      "source_handle": "P0364",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "概念框架综合",
        "finding": "提出了一个统一框架，将宿主因素、微生物组成、代谢物信号和免疫反应联系起来，表明微生物-ICI相互作用由功能趋同通路驱动，而非单一菌种。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::09453c46fe36046e2b9f48ff6256228cf0dc85f082eb8d8faf50756318235919",
          "field_path": [
