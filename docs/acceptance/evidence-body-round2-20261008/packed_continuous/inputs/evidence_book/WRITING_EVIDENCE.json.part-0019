    "atom::c3ecf3adcf46365b03881880": {
      "atom_id": "atom::c3ecf3adcf46365b03881880",
      "source_handle": "P0204",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性观察性研究设计。纳入2018年11月至2022年4月期间接受ICI治疗的80例晚期HCC患者。通过宏基因组测序分析细菌群落，通过ITS2测序分析真菌群落，并通过代谢组学分析代谢产物。将患者分为持久临床获益（DCB）和非持久临床获益（NDB）两组，比较两组间微生物多样性、物种组成及代谢物的差异。利用统计建模筛选预测ICI持续获益的细菌物种模型，并识别预测生存的预后生物标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::79c14d42539eae37ca42ccd39104efa8087b4f6d5658b688c65c57555f6d6a2b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ae1d96f1a79f5a12ff3e5016c041b7de724b1b4f680b7391f05f4b024b233b36",
      "multiple_values_in_field": false
    },
    "atom::ca894a19b9d6186300e39433": {
      "atom_id": "atom::ca894a19b9d6186300e39433",
      "source_handle": "P0204",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "首次在多组学水平描述了ICI治疗HCC患者中肠道细菌、真菌及其代谢物的状态和特征。",
        "limits": "所给摘要未交代具体的统计校正方法、样本量计算依据、外部验证情况以及潜在的混杂因素控制细节。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::79c14d42539eae37ca42ccd39104efa8087b4f6d5658b688c65c57555f6d6a2b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::448a7fc167d9602d872faaafa7f247cfa919de602b14d4ed9a698595005c9d53",
      "multiple_values_in_field": true
    },
    "atom::529d5d3fb9dcc888fd8bbfe5": {
      "atom_id": "atom::529d5d3fb9dcc888fd8bbfe5",
      "source_handle": "P0204",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了基于多界微生物群的ICI疗效预测和预后评估的生物标志物候选列表。",
        "limits": "预测模型的泛化能力仅限于当前80人的单中心或特定队列，缺乏独立验证集的支持；作者声称的“首次”描述需结合领域内其他类似研究进行核实，且单一队列的结果可能存在情境依赖性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::79c14d42539eae37ca42ccd39104efa8087b4f6d5658b688c65c57555f6d6a2b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::448a7fc167d9602d872faaafa7f247cfa919de602b14d4ed9a698595005c9d53",
      "multiple_values_in_field": true
    },
    "atom::ff7855f2bf0d8e5cf45f51c0": {
      "atom_id": "atom::ff7855f2bf0d8e5cf45f51c0",
      "source_handle": "P0204",
      "field_path": [
