          ]
        }
      ],
      "variant_group": "field::a9e134dea5b15a820f56091c4a4ab125b3ec4194bf8f1025b2714b7174c31453",
      "multiple_values_in_field": true
    },
    "atom::0982efcdb938bbab4f561a53": {
      "atom_id": "atom::0982efcdb938bbab4f561a53",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "12个月无进展生存期（PFS）预测",
        "finding": "在Ashray_2024队列中，整合生物先验知识的RPKM特征预测12个月PFS的AUC为0.88，优于仅使用临床因素或传统分类学特征。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::a9e134dea5b15a820f56091c4a4ab125b3ec4194bf8f1025b2714b7174c31453",
      "multiple_values_in_field": true
    },
    "atom::24da6e6e61b40253d81d17e4": {
      "atom_id": "atom::24da6e6e61b40253d81d17e4",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "年龄分层分析（>60岁 vs ≤60岁）",
        "finding": "年轻患者的预测性能略高于老年患者（AUC 0.91 vs 0.87）。归因分析显示不同年龄组的贡献微生物存在差异：老年响应者中Bifidobacterium属贡献为正，而年轻响应者中UBA11524等未培养属贡献显著；非响应者中两组的特征分布也截然不同。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
