    "atom::9d2025bfc4afb44a959e7a39": {
      "atom_id": "atom::9d2025bfc4afb44a959e7a39",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "First Timepoint cohort, GLM analysis of multiple hypervariable regions",
        "finding": "Streptococcus salivarius在反应者粪便中显著富集（p=0.004），且qPCR证实该趋势；但该菌在口腔漱口水中的水平与反应无关，且口腔与粪便水平不相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
