    "atom::a8533f72081519948b26da59": {
      "atom_id": "atom::a8533f72081519948b26da59",
      "source_handle": "P0289",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "对照组为其他实体瘤患者而非健康人，限制了与健康基线的直接比较；手术影响的结论仅限于胃/胰腺癌术后患者。",
        "contribution": "展示了不同癌症类型（如上消化道肿瘤vs结直肠癌）中微生物组特征的差异，以及手术（胃/胰腺切除术）对口腔细菌富集的额外影响。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
