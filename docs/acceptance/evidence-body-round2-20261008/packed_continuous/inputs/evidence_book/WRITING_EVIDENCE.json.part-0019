    "atom::b179774ce990c059a2dda07d": {
      "atom_id": "atom::b179774ce990c059a2dda07d",
      "source_handle": "P0270",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为实例说明非侵入性口腔采样可能无法准确代表肠道微生物状态，特别是在涉及特定口腔来源但定植于肠道的细菌时，强调采样部位选择的重要性。",
      "role": "planning",
