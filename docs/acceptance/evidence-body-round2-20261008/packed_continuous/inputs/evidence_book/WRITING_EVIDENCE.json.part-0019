    "atom::873c23476f247afe6b8f4d1e": {
      "atom_id": "atom::873c23476f247afe6b8f4d1e",
      "source_handle": "P0270",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究结果严格限定于“恩杂鲁胺治疗进展后”的mCRPC患者，其微生物组状态深受既往内分泌治疗影响，不能直接推广至未经内分泌治疗的前列腺癌患者或初治实体瘤患者。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        },
        {
          "record_id": "record::153a59be1d09157a4ef3f70816efa0c7f6788de60095c609bebda9e7b57a3c59",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::6c426dc26a1f59f04ad247330690ecbd36127e3ead51b6611660113734a9e427",
      "multiple_values_in_field": true
    },
    "atom::7bcbe549d1bc887488ac8986": {
      "atom_id": "atom::7bcbe549d1bc887488ac8986",
      "source_handle": "P0270",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "A. muciniphila在反应者中的减少与多数其他ICI研究相反，这可能与前列腺癌的特定病理生理环境（如肌苷促转移风险）或既往用药有关，解读时需避免将其视为普适规律。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
