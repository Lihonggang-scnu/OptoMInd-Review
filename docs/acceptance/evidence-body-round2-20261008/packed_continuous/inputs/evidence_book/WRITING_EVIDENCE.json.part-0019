        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节ICI疗效”中的相关性证据部分，列举具体的预测性微生物标志物。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
