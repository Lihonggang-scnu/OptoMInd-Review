    "atom::651c73017c31fc42504ecc89": {
      "atom_id": "atom::651c73017c31fc42504ecc89",
      "source_handle": "P0289",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于说明“癌症类型和解剖位置”是微生物组-宿主互作的重要分层因素，解释为何某些癌种中观察到特定的微生物变化。",
      "role": "planning",
