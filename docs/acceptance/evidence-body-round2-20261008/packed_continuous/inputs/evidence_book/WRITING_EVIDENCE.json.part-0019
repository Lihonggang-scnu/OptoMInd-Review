    "atom::336d3e9f649133c8318edf00": {
      "atom_id": "atom::336d3e9f649133c8318edf00",
      "source_handle": "P0545",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性队列研究设计。纳入标准：组织学确诊的不可切除III期或IV期皮肤黑色素瘤患者，接受抗PD-1单药治疗（纳武利尤单抗或帕博利珠单抗）。对照组为患者的直系亲属（健康人）。主要终点：根据RECIST v.1.1标准评估的治疗反应（完全缓解CR、部分缓解PR定义为响应者；疾病稳定SD、进展PD定义为非响应者）。数据采集：治疗前通过问卷收集社会人口学、临床、生活方式和饮食变量；采集基线粪便样本。实验室分析：使用DNeasy PowerSoil Pro提取DNA，扩增16S rRNA基因V3-V4区进行Illumina MiSeq测序，使用DADA2流程生成ASVs并基于SILVA数据库进行分类；对部分样本进行宏基因组鸟枪法测序以重建MAGs。统计分析：比较各组间的菌群多样性（Alpha/Beta）、相对丰度及临床特征差异，使用Kruskal-Wallis检验、Fisher精确检验及limma线性模型识别差异物种。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1bb80f168552ffb9a6448494df1485fd1e32c886ba6c242a17b324b2dd9e89a7",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::f8979429b0413510bd6a75a462efc3524c95b7d8a8eef31dbe5f5d84300106c4",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::eec02636f808717b875527c26c54d632d642a1bbb79b6b6d5c4b01c957a7ca3e",
      "multiple_values_in_field": false
    },
    "atom::7ba2dfedc1eb207addb32c68": {
      "atom_id": "atom::7ba2dfedc1eb207addb32c68",
      "source_handle": "P0545",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了波兰这一特定欧洲人群背景下，肠道微生物组特征与抗PD-1治疗反应的关联证据，指出了与该人群饮食模式（如高植物摄入）相关的潜在有益菌属（P. copri, B. uniformis）。",
        "limits": "样本量较小（尤其是对照组仅10人，且年龄显著小于患者组）；观察性研究设计无法确立因果关系；饮食数据依赖自我报告问卷，可能存在回忆偏倚；未直接测量微生物代谢产物机制；不同研究间关于特定菌属（如Faecalibacterium）作用的矛盾结果提示人群异质性，限制了单一生物标志物的普适性。"
      },
      "role": "evidence",
      "origins": [
