            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::54bb9f83067505c539d7dbffe23d6fcbe397ad10e17bf5e3a92600bd969338d7",
      "multiple_values_in_field": false
    },
    "atom::259f0cfcceea861e804f58f0": {
      "atom_id": "atom::259f0cfcceea861e804f58f0",
      "source_handle": "P0478",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "Advanced cutaneous melanoma patients treated with immune checkpoint inhibitors (ICIs); gut microbiome composition and functional potential; multiple observational cohorts across UK, Netherlands, Spain, and public datasets.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144",
