      "multiple_values_in_field": true
    },
    "atom::2f6ddcc433e831150bfc885a": {
      "atom_id": "atom::2f6ddcc433e831150bfc885a",
      "source_handle": "P0393",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
