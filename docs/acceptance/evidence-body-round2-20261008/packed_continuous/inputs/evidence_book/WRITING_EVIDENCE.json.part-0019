    "atom::30712a563b2a8c6a99667cd6": {
      "atom_id": "atom::30712a563b2a8c6a99667cd6",
      "source_handle": "P0298",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于综述的方法论部分，展示如何综合观察性研究证据，或作为评估其他类似综述质量的参照。警示在解读微生物组-疗效关联时需考虑混杂因素和研究设计局限。",
      "role": "planning",
