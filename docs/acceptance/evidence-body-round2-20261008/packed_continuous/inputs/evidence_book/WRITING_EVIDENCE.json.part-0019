      "value": {
        "conditions": "接受ICI治疗的晚期实体瘤患者 (n=333)",
        "finding": "粪便中高比例口腔细菌与较短的PFS显著相关（中位4.34 vs 6.97个月; HR=1.38, 95% CI 1.07–1.78）。"
      },
      "role": "evidence",
