    "atom::803f6a171c14bc5338d08571": {
      "atom_id": "atom::803f6a171c14bc5338d08571",
      "source_handle": "P0298",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "发现的关联是预后的，不等于预测性的；即微生物组特征与结局相关，但不一定特异性地预测ICI相对于其他治疗的额外获益。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7",
          "field_path": [
