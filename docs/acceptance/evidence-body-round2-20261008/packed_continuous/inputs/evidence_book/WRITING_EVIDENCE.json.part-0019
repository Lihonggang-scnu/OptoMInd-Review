    "atom::7bf91791d72061e224f94980": {
      "atom_id": "atom::7bf91791d72061e224f94980",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "既往研究表明肠道微生物影响ICI疗效，但在mCRPC背景下，特别是经过雄激素受体抑制剂（如恩杂鲁胺）预处理后的患者中，微生物组特征如何预测帕博利珠单抗的治疗反应？是否存在不同于其他实体瘤（如黑色素瘤）的微生物标志物？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::153a59be1d09157a4ef3f70816efa0c7f6788de60095c609bebda9e7b57a3c59",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::9d26feaf687662ec9d04c77e1ed68af95671221ef6221e39e3bee38aac3f323b",
      "multiple_values_in_field": false
    },
    "atom::0bb8230bd3b4569513ecd72d": {
      "atom_id": "atom::0bb8230bd3b4569513ecd72d",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "转移性去势抵抗性前列腺癌（mCRPC）患者，在恩杂鲁胺治疗进展后接受抗PD-1免疫检查点抑制剂（帕博利珠单抗）治疗。样本为粪便和口腔漱口水DNA。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
            "study_summary_A",
