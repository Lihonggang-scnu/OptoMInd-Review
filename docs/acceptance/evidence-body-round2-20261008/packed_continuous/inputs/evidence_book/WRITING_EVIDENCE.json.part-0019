          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::c9fff4fd9141199aa0c091491e6a7a706981cfb35e4223742b8238025418f0ff",
      "multiple_values_in_field": true
    },
    "atom::bd960d547384d8e00b93a6b1": {
      "atom_id": "atom::bd960d547384d8e00b93a6b1",
      "source_handle": "P0478",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to illustrate that while universal biomarkers are elusive, certain beneficial taxa appear repeatedly, suggesting a core set of potentially helpful microbes.",
      "role": "planning",
      "origins": [
