    "atom::8ee5a9383b2afdaa5c1326e9": {
      "atom_id": "atom::8ee5a9383b2afdaa5c1326e9",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性观察性队列设计。收集23名mCRPC患者在基线及治疗期间的直肠拭子（粪便）和口腔漱口水样本。使用Ion Torrent平台进行16S rRNA基因多重高变区测序，结合DADA2去噪和QIIME2分析流程进行物种分类。使用GLM整合多区域数据以评估差异丰度。通过qPCR独立验证关键菌种（S. salivarius, A. muciniphila）。纵向分析了9名患者的全程治疗样本以评估时间效应。将结果与既往文献及Shaikh等人的“综合指数”进行比较。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::153a59be1d09157a4ef3f70816efa0c7f6788de60095c609bebda9e7b57a3c59",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::740bb96b78e7e8b6f8b6565cb36df4382572dcf16d10e45740a8f374063ade2e",
      "multiple_values_in_field": false
    },
    "atom::f316b32406a559e063321e21": {
      "atom_id": "atom::f316b32406a559e063321e21",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了首个针对mCRPC患者在接受ICI治疗前/初期微生物组特征的系统描述，揭示了该人群中特有的微生物-反应关联模式（如S. salivarius的正向关联和A. muciniphila的负向关联）。",
        "limits": "样本量较小（n=23），统计效力有限；仅使用16S rRNA测序而非宏基因组，分辨率受限；未深入探讨具体的代谢机制或因果路径；结果可能受既往恩杂鲁胺治疗、饮食、地理因素等混杂因素影响；作者承认部分分类学鉴定存在不确定性（如Roseburia属）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::153a59be1d09157a4ef3f70816efa0c7f6788de60095c609bebda9e7b57a3c59",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::811c6b151914300725f7968e030768472ae7323c14d81a3af39b2775ab44d692",
      "multiple_values_in_field": false
    },
