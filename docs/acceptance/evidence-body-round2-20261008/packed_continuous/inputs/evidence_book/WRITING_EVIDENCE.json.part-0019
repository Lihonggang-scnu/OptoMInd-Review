            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::524c79f1550cbc8ad914ff54f1770461ad0a8c2bbcfd2b6ddcb77e877a283f2e",
      "multiple_values_in_field": false
