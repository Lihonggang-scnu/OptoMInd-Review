    "atom::77ac8a223ad7408d068e55df": {
      "atom_id": "atom::77ac8a223ad7408d068e55df",
      "source_handle": "P0289",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制假说基于相关性分析和文献引用，缺乏直接的分子机制实验验证；需区分PPI的直接药理作用与间接微生物组效应。",
        "contribution": "提出了PPI使用导致胃酸抑制，进而促进口腔细菌在粪便中富集，并可能由此削弱ICI疗效的机制路径。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dfe0416f25528e22fe6c9a2942ea518e78fea681a3b797ca34340c88fe5d2306",
