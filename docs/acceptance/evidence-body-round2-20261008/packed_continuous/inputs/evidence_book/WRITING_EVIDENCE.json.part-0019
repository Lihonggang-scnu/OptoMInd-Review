    },
    "atom::6fed30a6e8f8955de005bcdf": {
      "atom_id": "atom::6fed30a6e8f8955de005bcdf",
      "source_handle": "P0289",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用观察性队列研究设计。Cohort 1（n=817）为一线全身治疗前的化疗初治患者，用于分析微生物组基线分布及其与临床特征（癌症类型、生活方式、合并用药）的关系；Cohort 2（n=333）为接受ICI治疗的患者，用于评估微生物组特征与ICI疗效（PFS、OS）的关联。样本采集后通过16S rRNA扩增子测序进行微生物组分析，定义“口腔细菌”为基于Atarashi等人研究的24个OTUs对应的10个菌属。统计分析包括α/β多样性比较、ALDEx2差异丰度分析、Kaplan-Meier生存分析及Cox比例风险模型，并使用倾向性评分匹配调整混杂因素。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dfe0416f25528e22fe6c9a2942ea518e78fea681a3b797ca34340c88fe5d2306",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::273320fd385e1eb5738c37b6ad1ac99c6ca7008237ac2326c5379910e83d0d74",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ccbb79e82c1987b5ef62adfb3cbe349a062f4c5e16bbf07256f48a1e3b9013ab",
      "multiple_values_in_field": false
    },
    "atom::27a993cf2e3838e65cfab860": {
      "atom_id": "atom::27a993cf2e3838e65cfab860",
      "source_handle": "P0289",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了跨多种晚期实体瘤类型的微生物组基线图谱，证实了上消化道肿瘤和PPI使用与粪便中口腔细菌富集的关联。",
        "limits": "所给摘要未交代具体的多变量模型构建细节及所有协变量的平衡情况；仅使用16S rRNA测序，无法提供物种水平的精确功能注释或菌株水平变异；ICI治疗队列样本量相对较小且包含多种治疗线和联合方案，可能引入异质性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dfe0416f25528e22fe6c9a2942ea518e78fea681a3b797ca34340c88fe5d2306",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::273320fd385e1eb5738c37b6ad1ac99c6ca7008237ac2326c5379910e83d0d74",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::0d6fc149daff92072f83c734a4bddc4a82576c6592188197a83d2eeb30df9226",
      "multiple_values_in_field": true
    },
    "atom::e034ff071253c2b3ab8712ff": {
      "atom_id": "atom::e034ff071253c2b3ab8712ff",
      "source_handle": "P0289",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "挑战了“高α多样性总是预测良好ICI疗效”的普遍观点，指出其预测价值可能依赖于癌症类型和治疗背景。",
        "limits": "α多样性的亚组分析多为探索性，统计效力不足，不能确立因果机制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dfe0416f25528e22fe6c9a2942ea518e78fea681a3b797ca34340c88fe5d2306",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::273320fd385e1eb5738c37b6ad1ac99c6ca7008237ac2326c5379910e83d0d74",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::0d6fc149daff92072f83c734a4bddc4a82576c6592188197a83d2eeb30df9226",
      "multiple_values_in_field": true
    },
    "atom::d62fa2c39b648d37d174a574": {
      "atom_id": "atom::d62fa2c39b648d37d174a574",
      "source_handle": "P0289",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了PPI通过增加粪便口腔细菌从而削弱ICI疗效的潜在机制假设，并为临床干预（如口腔护理）提供了依据。",
        "limits": "观察性研究设计无法确证因果关系；公共数据集验证样本量小且仅部分OTU可比，结果仅为支持性而非决定性证据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dfe0416f25528e22fe6c9a2942ea518e78fea681a3b797ca34340c88fe5d2306",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        },
        {
          "record_id": "record::273320fd385e1eb5738c37b6ad1ac99c6ca7008237ac2326c5379910e83d0d74",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::0d6fc149daff92072f83c734a4bddc4a82576c6592188197a83d2eeb30df9226",
      "multiple_values_in_field": true
    },
    "atom::03e062188fa13a809c033fb1": {
      "atom_id": "atom::03e062188fa13a809c033fb1",
      "source_handle": "P0289",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "化疗初治晚期实体瘤患者 (n=817)",
        "finding": "上消化道肿瘤（特别是胃/胰腺癌术后）及PPI使用者粪便中口腔细菌比例显著高于其他人群；抗生素和益生菌使用降低α多样性并改变菌群组成。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::dfe0416f25528e22fe6c9a2942ea518e78fea681a3b797ca34340c88fe5d2306",
