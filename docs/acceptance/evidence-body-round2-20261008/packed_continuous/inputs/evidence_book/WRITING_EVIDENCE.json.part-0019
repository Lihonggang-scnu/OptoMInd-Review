    "atom::735a6eea6250b61a60f2d9a7": {
      "atom_id": "atom::735a6eea6250b61a60f2d9a7",
      "source_handle": "P0298",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "详细描述了系统综述和荟萃分析的方法，包括数据标准化策略（处理不同多样性指标和阈值）、效应量提取层级、亚组分析设计、以及GRADE证据质量评估。强调了观察性研究的因果推断限制和术语精确性（预后vs预测）。"
      },
      "role": "evidence",
      "origins": [
