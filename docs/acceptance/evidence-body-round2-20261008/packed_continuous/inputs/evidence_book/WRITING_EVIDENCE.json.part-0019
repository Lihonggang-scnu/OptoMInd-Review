    "atom::9de9bb00bcf661142800e275": {
      "atom_id": "atom::9de9bb00bcf661142800e275",
      "source_handle": "P0289",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可作为“特定微生物特征（口腔细菌）负向调节ICI疗效”的证据，支持综述中关于微生物组组成而非单纯多样性影响疗效的观点。",
      "role": "planning",
      "origins": [
