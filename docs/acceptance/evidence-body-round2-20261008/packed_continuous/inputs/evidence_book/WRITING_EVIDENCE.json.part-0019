            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::27be7ea29ff31b903c0436c384e88aec8f17721aa16c19283a682a63280a79bd",
      "multiple_values_in_field": true
    },
    "atom::83561df9577bb9b3b630c124": {
      "atom_id": "atom::83561df9577bb9b3b630c124",
      "source_handle": "P0393",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "所给材料未提供直接的机制实验数据（如动物模型或体外细胞实验），所有机制解释均为基于文献的推测和关联分析，属于理论假说层面，需注明其为作者的解释而非已验证的因果链条。",
        "contribution": "提出了多界微生物通过维持肠道生态稳定性和产生免疫调节代谢物（如短链脂肪酸）来增强抗肿瘤免疫的潜在机制假设。讨论了Bacteroides fragilis诱导树突状细胞成熟和Th1细胞浸润，以及Malassezia激活补体级联反应导致免疫抑制的可能路径。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3cdad2d48d4bf97ae9b840521b9daee5693ee31da53ab53a98c9725795cc021b",
          "field_path": [
