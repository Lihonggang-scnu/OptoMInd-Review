          ]
        }
      ],
      "variant_group": "field::0a21cbae670745fed5afa556cdc9d79eb986faa973b3d3ef74f02f3f46472f4b",
      "multiple_values_in_field": true
    },
    "atom::d0c260a1ef0fdd89c3f4b239": {
      "atom_id": "atom::d0c260a1ef0fdd89c3f4b239",
      "source_handle": "P0511",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "pooled MM patients, MetaCyc pathways",
        "finding": "响应者中富集29个差异代谢通路，主要涉及维生素B代谢（硫胺素、钴胺素）、淀粉/糖苷降解及肽聚糖成熟；非响应者中富集核苷酸生物合成和好氧呼吸通路（部分由Campylobacter和Citrobacter驱动）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::0a21cbae670745fed5afa556cdc9d79eb986faa973b3d3ef74f02f3f46472f4b",
      "multiple_values_in_field": true
    },
    "atom::1fc1719e2f84d3ef36ac1a91": {
      "atom_id": "atom::1fc1719e2f84d3ef36ac1a91",
      "source_handle": "P0511",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "independent validation cohort (Peters et al., N=27)",
        "finding": "基于训练集特征训练的RF分类器在验证集上达到AUC=0.624 (95% CI: 0.348-0.899)。根据分类结果分组，响应者组的无进展生存期（PFS）风险比HR=0.35，但未达到统计学显著性（P=0.081），作者归因于样本量不足导致的统计效力低。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::0a21cbae670745fed5afa556cdc9d79eb986faa973b3d3ef74f02f3f46472f4b",
      "multiple_values_in_field": true
    },
    "atom::d69529e5163214f7d8a22900": {
      "atom_id": "atom::d69529e5163214f7d8a22900",
      "source_handle": "P0511",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "empirical",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::e17a3a3e4a6c2f0b859cf944e066a7f8d12b83bd049b8810e013ba97366630ee",
      "multiple_values_in_field": false
    },
    "atom::7050aedeb5fae84b617bd737": {
      "atom_id": "atom::7050aedeb5fae84b617bd737",
      "source_handle": "P0511",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "肠道微生物组的特征在不同患者队列中是否具有普遍适用性以预测癌症免疫治疗（ICI）的疗效？是否存在一致的微生物组成或功能签名来区分ICI治疗的响应者与未响应者？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::5aae8d0547bc088160aaf9e7bce4c945672d391c0c2424888b2185a6dde9e923",
      "multiple_values_in_field": false
    },
    "atom::c1fd6ecce3da93617b89cc09": {
      "atom_id": "atom::c1fd6ecce3da93617b89cc09",
      "source_handle": "P0511",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "转移性黑色素瘤（MM）患者，接受抗PD-1、抗CTLA-4或联合免疫检查点抑制剂（ICI）治疗。研究基于4项已发表的粪便宏基因组鸟枪法测序（MGS）数据，共130名患者（66名响应者R，64名非响应者NR），并使用Peters等的一项独立队列（27名MM患者）进行验证。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::772ba62c3699e4f6ccd17c59e4c755154f9357462f5477e17e9f7b9e9692cb01",
      "multiple_values_in_field": false
    },
    "atom::e396d9f078e9bdde5d4f8296": {
      "atom_id": "atom::e396d9f078e9bdde5d4f8296",
      "source_handle": "P0511",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在通过荟萃分析确定跨不同患者队列预测ICI治疗响应的肠道微生物组特征。作者对来自4项研究的公开MGS数据进行重新处理和分析，比较响应者与未响应者在分类学组成和功能代谢通路上的差异。研究发现，尽管整体群落结构（Alpha/Beta多样性）在组间无显著差异，但存在一组特定的物种和代谢通路在响应者中富集。基于这些差异特征构建的随机森林分类器在训练集中表现适度，并在独立验证队列中以AUC=0.625区分了响应状态，且该分类预测与无进展生存期（PFS）呈趋势性相关（HR=0.35, P=0.081）。结论认为存在一个跨研究的粪便微生物组签名，可能用于诊断或治疗目的，但需进一步验证。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::bedec0cb32368ca3133837662b25f3daf083771046c3a2958c374ca321d625ed",
      "multiple_values_in_field": false
    },
    "atom::04ae68bb280dfbac327b3c24": {
      "atom_id": "atom::04ae68bb280dfbac327b3c24",
      "source_handle": "P0511",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了关于肠道微生物组预测实体瘤（特别是黑色素瘤）免疫检查点抑制剂疗效的综合实证数据。其核心价值在于通过荟萃分析确认了特定菌属（Faecalibacterium, Barnesiella）和维生素B代谢通路与治疗响应的关联，并展示了跨队列验证的可能性。对于综述而言，它支持“微生物组可作为ICI疗效预测因子”的观点，并提示功能层面（代谢）可能比单一物种更具泛化性，同时也指出了当前预测模型的精度局限性和机制解释的缺失。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::f2a83925d5430369ffd9972666fe66f553c0f7f93a26f754370b1c6218e409b2",
      "multiple_values_in_field": false
    },
    "atom::757d1e0f130f3664010486ba": {
      "atom_id": "atom::757d1e0f130f3664010486ba",
      "source_handle": "P0511",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "研究对象仅限于转移性黑色素瘤；使用的是回顾性荟萃分析数据，非前瞻性干预试验；统计方法未校正多重比较。",
        "contribution": "提供了跨多个独立队列一致的微生物分类学和功能性特征列表，证明某些微生物特征（如Faecalibacterium富集和维生素B代谢增强）与ICI响应正相关。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::876d049940377080941b53c18d98c0ee0c4938538398907d0622b468858c87d2",
          "field_path": [
