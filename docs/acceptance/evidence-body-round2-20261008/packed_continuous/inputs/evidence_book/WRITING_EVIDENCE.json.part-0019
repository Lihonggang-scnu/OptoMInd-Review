      "source_handle": "P0545",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "钙卫蛋白差异无统计学意义；未直接测定免疫细胞浸润或细胞因子水平；机制链条不完整。",
        "contribution": "探讨了肠道菌群组成与宿主肠道炎症状态（通过粪便钙卫蛋白衡量）的潜在联系，尽管统计上不显著，但趋势显示响应者炎症水平较低。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1bb80f168552ffb9a6448494df1485fd1e32c886ba6c242a17b324b2dd9e89a7",
