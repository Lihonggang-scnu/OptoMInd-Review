        "key_findings"
      ],
      "value": {
        "conditions": "接受ICI治疗的晚期实体瘤患者 (n=333)",
        "finding": "整体肠道微生物组α多样性（ASV计数、Shannon指数）与ICI疗效无显著关联（HR=0.94, 95% CI 0.73–1.21）；仅Simpson指数与较好疗效相关。"
      },
      "role": "evidence",
