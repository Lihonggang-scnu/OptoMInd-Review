    "atom::5d3b818dded26c255a8e023a": {
      "atom_id": "atom::5d3b818dded26c255a8e023a",
      "source_handle": "P0478",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The study utilized a multi-cohort design combining prospective observational cohorts (PRIMM-UK, PRIMM-NL) and retrospective cohorts (Manchester, Leeds, Barcelona) alongside public datasets. Baseline stool samples were subjected to shotgun metagenomic sequencing. Taxonomic profiling was performed using MetaPhlAn 3.0, and functional potential using HUMAnN 3.0. Statistical associations were tested using PERMANOVA, ANCOM-BC, and various differential abundance methods within a meta-analysis framework. Machine learning prediction capabilities were assessed using Lasso logistic regression with nested cross-validation for within-cohort accuracy and leave-one-cohort-out validation for cross-cohort generalizability.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::6cbf5c2e297396b264657b8ee9f3b0d7563b927fc99a785abd805b74c3b66cd1",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::5ce8efe6097687ab98bbbc540235df6dece3bee22abef5a8780c079989bd88bf",
      "multiple_values_in_field": false
    },
    "atom::eeee15fdf99e533bd9e1ddae": {
      "atom_id": "atom::eeee15fdf99e533bd9e1ddae",
      "source_handle": "P0478",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides one of the largest integrated metagenomic analyses of ICI response in melanoma, demonstrating that while microbiome-response links exist, they are strongly context-dependent and lack universal single-species biomarkers.",
        "limits": "Sample sizes per cohort remain relatively small for robust strain-level resolution. The study focuses on cutaneous melanoma, limiting generalizability to other solid tumors or mucosal/uveal melanoma subtypes. Confounding factors like diet and medication use were adjusted for but residual confounding cannot be fully excluded. The inability to establish universal biomarkers suggests current methodological and biological complexities prevent simple translation to clinical practice without larger, standardized trials."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::6cbf5c2e297396b264657b8ee9f3b0d7563b927fc99a785abd805b74c3b66cd1",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::1f116282cd023a1babab932332d16df9558b4923d4a3380d6835a70509ab6325",
      "multiple_values_in_field": false
    },
    "atom::711aa5e1a8bdcd2e13053617": {
      "atom_id": "atom::711aa5e1a8bdcd2e13053617",
      "source_handle": "P0478",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Within individual cohorts (PRIMM-UK vs PRIMM-NL)",
        "finding": "Microbiome composition showed significant association with ORR in PRIMM-UK (PERMANOVA P=0.05) but not in PRIMM-NL (P=0.61). Prediction accuracy varied by endpoint and cohort (e.g., AUC-ROC 0.78 for ORR in UK vs 0.53 in NL)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::6cbf5c2e297396b264657b8ee9f3b0d7563b927fc99a785abd805b74c3b66cd1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::2111e67ed0b237bdfab087e46d9a615a533652dd47ac2e5dffe549a5ad0ca8b9",
      "multiple_values_in_field": true
    },
    "atom::881ab16104a14e18bbf02cbe": {
      "atom_id": "atom::881ab16104a14e18bbf02cbe",
      "source_handle": "P0478",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Cross-cohort integration and meta-analysis",
        "finding": "Cohort effects explained nearly ten times more variance than clinical variables. No single bacterial species served as a fully consistent biomarker across all datasets. However, a panel of species including Bifidobacterium pseudocatenulatum, Roseburia spp., and Akkermansia muciniphila were consistently enriched in responders."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::6cbf5c2e297396b264657b8ee9f3b0d7563b927fc99a785abd805b74c3b66cd1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::2111e67ed0b237bdfab087e46d9a615a533652dd47ac2e5dffe549a5ad0ca8b9",
      "multiple_values_in_field": true
    },
    "atom::3af1744df727f5ab3481d47b": {
      "atom_id": "atom::3af1744df727f5ab3481d47b",
      "source_handle": "P0478",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Machine learning prediction across cohorts",
        "finding": "Models trained on one cohort generally failed to predict response in another (AUC-ROC often <0.6). Leave-one-cohort-out validation yielded modest average performance (AUC ~0.59-0.60), indicating limited cross-population reproducibility of microbiome-based signatures."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7b396e8ca2b15ce24520d38572e01e4776bb941e0383acb6d1cc44e7abdf144",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::6cbf5c2e297396b264657b8ee9f3b0d7563b927fc99a785abd805b74c3b66cd1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::2111e67ed0b237bdfab087e46d9a615a533652dd47ac2e5dffe549a5ad0ca8b9",
      "multiple_values_in_field": true
    },
