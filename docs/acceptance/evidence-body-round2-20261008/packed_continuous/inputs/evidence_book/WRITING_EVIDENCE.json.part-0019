    "atom::0bc7e06cc2254e622da225b1": {
      "atom_id": "atom::0bc7e06cc2254e622da225b1",
      "source_handle": "P0289",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受ICI治疗且使用PPI的患者",
        "finding": "高口腔细菌比例在PPI使用者中与更差的PFS趋势相关（中位3.15 vs 2.04个月; P=0.08），而在非PPI使用者中无此关联（P=0.74），提示PPI与口腔细菌存在交互作用。"
      },
      "role": "evidence",
      "origins": [
