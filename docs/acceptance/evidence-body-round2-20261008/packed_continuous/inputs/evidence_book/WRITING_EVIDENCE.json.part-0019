    "atom::771f97678f72c2d83a88fcba": {
      "atom_id": "atom::771f97678f72c2d83a88fcba",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "研究设计采用多队列回顾性数据分析路线。首先，对来自四个独立研究的347个粪便样本进行宏基因组测序数据的预处理（质控、去宿主DNA）。其次，构建自定义参考基因组集：从Ashray_2024队列中提取contigs，生成两类参考集——用于提取生物先验知识的“Top 1”最长contig集（1269个）和用于计算基因丰度的“Top 200”最长contig集（161,107个）。接着，使用CoverM计算每个样本相对于自定义参考集的RPKM基因水平丰度矩阵；同时使用ESM-2模型将“Top 1”contigs的蛋白序列编码为320维嵌入向量作为生物先验知识。最后，构建变分自编码器（VAE）架构的BioP-VAE模型，通过注意力机制融合生物先验知识与RPKM特征，进行ICI反应和二分类预测。评估指标包括AUC、AUPR和准确率，并使用集成梯度（IG）方法进行特征归因分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::70fc407942dc015cfc9e2fc0e959369eb43daa9f93f8f044a8ef849d55845aa2",
      "multiple_values_in_field": false
    },
    "atom::97cf36ede5ecfff3824fd105": {
      "atom_id": "atom::97cf36ede5ecfff3824fd105",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了BioP-VAE模型，证明基因水平微生物丰度结合生物先验知识在预测ICI反应方面优于传统的分类学特征，特别是在CICB治疗背景下具有跨癌种泛化潜力。",
        "limits": "所给摘要未交代具体的统计检验细节（如多重比较校正）。跨队列泛化能力受限于治疗策略（CICB vs 单药）和队列间的异质性，模型在单药治疗间的泛化效果不佳。未包含真菌、病毒等非细菌微生物组数据，也未整合宿主多维生物学信息（如肿瘤突变负荷、免疫微环境）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::b92c9ef25a9243261540858afe96af15db915460048f1e114c64ffef37ead0b6",
      "multiple_values_in_field": false
    },
    "atom::a91acbcf0d7d10e3af6178ee": {
      "atom_id": "atom::a91acbcf0d7d10e3af6178ee",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Ashray_2024队列（CICB治疗，罕见实体瘤）内部验证",
        "finding": "整合生物先验知识的过滤后RPKM特征在预测ICI反应中表现最佳，平均AUC为0.89，准确率为92.68%，显著优于所有层级的分类学丰度特征（最高AUC 0.72）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::a9e134dea5b15a820f56091c4a4ab125b3ec4194bf8f1025b2714b7174c31453",
      "multiple_values_in_field": true
    },
    "atom::e1c25a7f5e0305dddaab98ac": {
      "atom_id": "atom::e1c25a7f5e0305dddaab98ac",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "跨队列评估（训练集与测试集分离）",
        "finding": "在CICB治疗背景下，模型展现出一定的跨队列泛化能力（Ashray_2024训练，Frankel_2017 CICB子集测试，AUC=0.88）。但在单药治疗队列（Lee_2022, Matson_2018）之间或向单药子集的泛化能力较差（AUC < 0.60-0.64）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::a9e134dea5b15a820f56091c4a4ab125b3ec4194bf8f1025b2714b7174c31453",
      "multiple_values_in_field": true
    },
    "atom::9804a41fd821fa289bc29c6a": {
      "atom_id": "atom::9804a41fd821fa289bc29c6a",
      "source_handle": "P0437",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "单药治疗队列内部验证",
        "finding": "在抗PD-1/CTLA-4单药治疗的内部队列中，BioP-VAE实现了极高的预测性能，平均AUC达到0.97。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::632dbc6fb80b78c563de25fc6054f20c4b3951feab575d7acd899b23a764d03d",
          "field_path": [
            "study_summary_A",
