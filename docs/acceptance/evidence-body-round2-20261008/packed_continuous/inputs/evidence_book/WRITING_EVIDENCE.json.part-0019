          ]
        }
      ],
      "variant_group": "field::d079218f37a96a830ae6f15db2a0a28c1005552bea8abb0cd521f8b9c7817852",
      "multiple_values_in_field": true
    },
    "atom::ffafb5672748b5626324548d": {
