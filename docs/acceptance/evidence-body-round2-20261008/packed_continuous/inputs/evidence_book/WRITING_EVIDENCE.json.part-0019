      "variant_group": "field::0ad6135192cafd5f520e6a68f0b2298062db491b1dabea0769f4447d926cc434",
      "multiple_values_in_field": true
    },
    "atom::fa6aa5bedd8fdde4e228b38d": {
      "atom_id": "atom::fa6aa5bedd8fdde4e228b38d",
      "source_handle": "P0015",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "关键驱动菌株功能分析",
        "finding": "正向关联的主要菌株属于Firmicutes门Ruminococcaceae科，特别是Faecalibacterium属，且这些菌株普遍拥有完整的乙酰辅酶A丁酸生成途径；而负向关联菌株中部分缺乏该途径。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::69b4d0d71a34e929f405655da8bc53219cc0d44dce89b09788cbd51e2649de5f",
          "field_path": [
