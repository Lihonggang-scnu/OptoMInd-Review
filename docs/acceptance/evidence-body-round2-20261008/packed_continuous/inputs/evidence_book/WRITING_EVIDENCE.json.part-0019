    "atom::cfb9a770641f543a9e72f1b5": {
      "atom_id": "atom::cfb9a770641f543a9e72f1b5",
      "source_handle": "P0437",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究的泛化性结论严格限定在治疗策略上：CICB背景下的基因特征具有跨癌种一致性，但单药背景下的特征不具备同等泛化性。",
      "role": "evidence",
      "origins": [
        {
