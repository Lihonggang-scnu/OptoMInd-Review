    "atom::b680146affc0dd87c9f0f5d6": {
      "atom_id": "atom::b680146affc0dd87c9f0f5d6",
      "source_handle": "P0289",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "口腔细菌的定义基于特定参考集；关联性强但因果机制需进一步验证；主要适用于接受ICI治疗的晚期实体瘤患者。",
        "contribution": "识别出粪便中高比例口腔细菌与ICI治疗后较短PFS的显著关联，特别是在PPI使用者中这一关联更强。",
        "facet_id": "F1"
      },
