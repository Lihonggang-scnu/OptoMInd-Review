    },
    "atom::0c84a99ade10a4cb256364e9": {
      "atom_id": "atom::0c84a99ade10a4cb256364e9",
      "source_handle": "P0393",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多界微生物组成差异分析",
        "finding": "C2亚型富集有益菌属，如细菌界的Bacteroides、Parabacteroides，真菌界的Kluyveromyces；C1亚型富集潜在有害菌属，如Malassezia。古菌和病毒界也显示出显著的亚型特异性分布。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3cdad2d48d4bf97ae9b840521b9daee5693ee31da53ab53a98c9725795cc021b",
