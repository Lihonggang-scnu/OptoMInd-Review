    "atom::a447f23b5eb80f91530dd4b0": {
      "atom_id": "atom::a447f23b5eb80f91530dd4b0",
      "source_handle": "P0170",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "E2肠型及其亚群几乎全部由黑色素瘤患者组成，因此观察到的反应率差异可能是肿瘤类型、微生物群落和队列效应的混合结果，不能简单归因于肠型本身。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f43e442780a4b5a132af9350ba6631299cdb484f88c84a7f17cea3f912a9657a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::6110f71e6f22f8f55652c007a60d96196f52a48fe294d53cd86286638dc6466b",
      "multiple_values_in_field": true
    },
    "atom::505e9176d5a9c7129b3c92cc": {
      "atom_id": "atom::505e9176d5a9c7129b3c92cc",
      "source_handle": "P0170",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "独立验证队列（MOC）仅包含卓越响应者，没有非响应者，因此所谓的“一致性”仅表示这些标志物在卓越响应者中存在，并不代表它们能区分响应者和非响应者。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f43e442780a4b5a132af9350ba6631299cdb484f88c84a7f17cea3f912a9657a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::6110f71e6f22f8f55652c007a60d96196f52a48fe294d53cd86286638dc6466b",
      "multiple_values_in_field": true
    },
    "atom::9f38bb2796a923f40c75dc77": {
      "atom_id": "atom::9f38bb2796a923f40c75dc77",
      "source_handle": "P0170",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "机器学习的高准确率仅在高度选择性的子集（如仅CR患者）中获得，不代表其在真实世界异质性人群中的通用预测能力。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f43e442780a4b5a132af9350ba6631299cdb484f88c84a7f17cea3f912a9657a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::6110f71e6f22f8f55652c007a60d96196f52a48fe294d53cd86286638dc6466b",
      "multiple_values_in_field": true
    },
    "atom::2a219e547ecf9345c1ce9c3d": {
