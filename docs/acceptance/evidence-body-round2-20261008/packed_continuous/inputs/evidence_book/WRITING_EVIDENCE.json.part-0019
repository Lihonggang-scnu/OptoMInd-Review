            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::ef807bdbc3dbc669225154f74a1e54ec6de41cbfda38e8851905257c0bce6c34",
      "multiple_values_in_field": true
    },
    "atom::fc83d59bc85334f3faa9c2cb": {
      "atom_id": "atom::fc83d59bc85334f3faa9c2cb",
      "source_handle": "P0270",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "First Timepoint cohort, 16S sequencing (V6-7 region) & qPCR",
        "finding": "Akkermansia muciniphila在反应者中显著降低（与黑色素瘤等其他癌症报道相反），qPCR确认了这一减少趋势。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::936d6b010edab5e9feddf7a0bc634d16d9a3921bd96d2fd6dd62c60bd972e531",
