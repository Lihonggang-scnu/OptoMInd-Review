      "multiple_values_in_field": true
    },
    "atom::a06d831e0fc3bfa9575865c1": {
      "atom_id": "atom::a06d831e0fc3bfa9575865c1",
      "source_handle": "P0393",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于WSNF聚类的两个亚型（C1 vs C2），涉及965例多癌种ICI治疗患者",
        "finding": "C2亚型表现出显著更高的Alpha多样性（Shannon和Observed species指数）和更复杂的Beta多样性结构；C2亚型中响应者比例更高，且总体生存期（OS）和无进展生存期（PFS > 6个月）显著优于C1亚型。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3cdad2d48d4bf97ae9b840521b9daee5693ee31da53ab53a98c9725795cc021b",
          "field_path": [
