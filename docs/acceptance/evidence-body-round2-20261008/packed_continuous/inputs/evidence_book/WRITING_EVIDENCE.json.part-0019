    "atom::85f2c57212b2af458d68af2d": {
      "atom_id": "atom::85f2c57212b2af458d68af2d",
      "source_handle": "P0565",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "综述指出当前研究存在严重的异质性，包括测序平台、生物信息学管道、差异丰度分析方法（如LEfSe, DESeq2, ANCOM）的不一致，以及组成型数据的统计陷阱。这解释了为什么难以获得统一的生物标志物。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::08de776306040abe73aecd87d2fabdbd99227dd11a0c0b0866dc9fe657088a28",
          "field_path": [
