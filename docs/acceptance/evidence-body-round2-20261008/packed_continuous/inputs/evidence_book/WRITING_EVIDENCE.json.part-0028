      "variant_group": "field::479baffd4deede51baf79bf5c3265fc1f6f3e28c4dd91e04ec1bc5c25ac8e3f9",
      "multiple_values_in_field": true
    },
    "atom::018e8f34896aa645686741aa": {
      "atom_id": "atom::018e8f34896aa645686741aa",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a foundational source for mapping the bidirectional relationship between gut microbiota and ICI outcomes. It provides specific bacterial taxa associated with both positive tumor response and negative immune-related adverse events (colitis), offering concrete examples for mechanistic and clinical facets. It also summarizes intervention strategies (FMT, probiotics, antibiotics) and their observed impacts, which is critical for discussing modulation strategies in the broader review.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::05e7349a8720a6d94ce4271d463d652283c20f425e19290982329ed210de7547",
      "multiple_values_in_field": false
    },
    "atom::4ba50f817c64f0ce6df15740": {
      "atom_id": "atom::4ba50f817c64f0ce6df15740",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review aggregates findings from diverse cancer types (melanoma, NSCLC, RCC) and ICI classes; associations may not be universal across all solid tumors or drug targets.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::49246c916d1eeef38cfaabb293858901e013842c78b14760bfd3935cdee31796",
      "multiple_values_in_field": true
    },
    "atom::19ee0ed702ff60f6b8b4e49a": {
      "atom_id": "atom::19ee0ed702ff60f6b8b4e49a",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Mechanistic claims are often based on preclinical models; direct translation to human pathophysiology should be treated with caution.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
