    "atom::a289121bf72235e8f59365a5": {
      "atom_id": "atom::a289121bf72235e8f59365a5",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To understand the systemic influence of gut dysbiosis on extraintestinal carcinogenesis and to evaluate how microbiome composition affects the efficacy of cancer therapies, particularly immune checkpoint inhibitors (ICIs) and chemotherapy.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::e58207bfe1a47f5946738c3a1fb7b9b57f0795d5850822932d4f4e8a18839dd3",
      "multiple_values_in_field": false
    },
    "atom::34965801076da9b1117eb66b": {
      "atom_id": "atom::34965801076da9b1117eb66b",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the role of gut microbiota in extraintestinal malignancies, specifically breast cancer, lung cancer (non-small cell lung cancer, NSCLC), melanoma, and prostate cancer. It covers mechanisms of interaction (metabolic, immune, hormonal) and microbiome-targeted interventions (FMT, probiotics, diet).",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::0597b2d7ff6b14422791a3f13eadbd11221ec96b2978f4ef44f0ccad26520fd9",
      "multiple_values_in_field": false
    },
    "atom::7342069c333ed3df2f86b2ea": {
      "atom_id": "atom::7342069c333ed3df2f86b2ea",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This is a narrative review synthesizing current evidence on how the gut microbiome influences the development and treatment response of non-gastrointestinal cancers. It outlines the 'gut-microbiota-cancer axis', detailing mechanisms such as immune modulation, metabolic reprogramming (e.g., estrobolome, SCFAs), and inflammatory signaling. The paper highlights specific microbial taxa associated with tumor promotion or suppression across different cancer types and evaluates emerging therapeutic strategies like fecal microbiota transplantation (FMT), defined live biotherapeutics, and dietary interventions.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::e978129a2bb901d74f0b4995890d6b3eb8ff1c20dee8ff33643ea4c9087b5e7e",
      "multiple_values_in_field": false
    },
    "atom::cbbe0d5a1dd2685cac6d53bc": {
      "atom_id": "atom::cbbe0d5a1dd2685cac6d53bc",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "Discussion of the 'estrobolome' in breast cancer and androgen-producing bacteria in prostate cancer."
      },
      "role": "evidence",
