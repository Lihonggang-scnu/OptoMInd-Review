    "atom::1f526359e0fe9ad8b7fe6bab": {
      "atom_id": "atom::1f526359e0fe9ad8b7fe6bab",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conducted a narrative synthesis of existing literature, organizing the content by cancer type (breast, lung, melanoma, prostate) and mechanism (immune, metabolic, hormonal). They summarize findings from animal models (germ-free mice, xenografts) and human observational/interventional studies (cohort studies, clinical trials of FMT/probiotics). The review categorizes microbial taxa by their pro-tumor or anti-tumor associations and discusses the translational potential of microbiome-based therapies.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::8d79e02a544f9f8a15cc480ce717f9b7587d6c54762e8ee519c21c0828416551",
      "multiple_values_in_field": false
    },
    "atom::37aca1a17037abe8f9ae5bdc": {
      "atom_id": "atom::37aca1a17037abe8f9ae5bdc",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive overview of the mechanistic links (immune, metabolic, hormonal) between gut microbiota and four major extraintestinal cancers. Summarizes key microbial taxa and their functional roles in cancer progression and therapy response.",
        "limits": "As a narrative review, it does not present new primary data or a systematic meta-analysis. Many cited mechanisms are derived from animal models or small-scale human observational studies, limiting generalizability. The review acknowledges significant inter-individual variability and methodological heterogeneity in microbiome research."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::828d77854e85a305f051260d942027ebe85b6354536bdb1d97a423bb12bb45be",
      "multiple_values_in_field": false
    },
    "atom::466b4d987cae6a6b85a04410": {
      "atom_id": "atom::466b4d987cae6a6b85a04410",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Melanoma and NSCLC patients undergoing ICI therapy",
        "finding": "Higher baseline gut microbial diversity and abundance of specific taxa (e.g., Akkermansia muciniphila, Bifidobacterium, Ruminococcaceae) correlate with improved response rates and survival. Conversely, low diversity or dominance of Bacteroidales is linked to resistance."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::0854ff4518524443dee705034d65700c1f564f79a17ea958f8e4c35d493a5705",
      "multiple_values_in_field": true
    },
    "atom::287a2c8f90d90427cd11577f": {
      "atom_id": "atom::287a2c8f90d90427cd11577f",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Mouse models of melanoma and lung cancer",
        "finding": "Fecal microbiota transplantation (FMT) from ICI-responsive donors can restore sensitivity to PD-1/PD-L1 blockade in resistant hosts, demonstrating a causal link between specific microbiomes and therapeutic efficacy."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::0854ff4518524443dee705034d65700c1f564f79a17ea958f8e4c35d493a5705",
      "multiple_values_in_field": true
    },
    "atom::c9f3c671bc75811e92b5b12d": {
      "atom_id": "atom::c9f3c671bc75811e92b5b12d",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Breast cancer context",
        "finding": "Gut microbes via the 'estrobolome' regulate estrogen metabolism; dysbiosis increasing beta-glucuronidase activity elevates free estrogen, promoting ER+ breast cancer risk. Certain taxa (e.g., ETBF) may translocate to breast tissue and promote metastasis via inflammation."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::0854ff4518524443dee705034d65700c1f564f79a17ea958f8e4c35d493a5705",
      "multiple_values_in_field": true
    },
    "atom::c733efa57e2f11dac038a3e8": {
      "atom_id": "atom::c733efa57e2f11dac038a3e8",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Prostate cancer context",
        "finding": "Gut microbes can influence androgen receptor signaling; some bacteria synthesize androgens fueling castration-resistant prostate cancer (CRPC), while others (e.g., Prevotella stercorea) may suppress tumor growth."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::0854ff4518524443dee705034d65700c1f564f79a17ea958f8e4c35d493a5705",
      "multiple_values_in_field": true
    },
    "atom::d71bd7f5f7d34d701e6677bc": {
      "atom_id": "atom::d71bd7f5f7d34d701e6677bc",
      "source_handle": "P0118",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "General immunotherapy context",
        "finding": "Antibiotic use around the time of ICI initiation is associated with significantly reduced progression-free and overall survival, likely due to depletion of beneficial commensals required for immune priming."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::0854ff4518524443dee705034d65700c1f564f79a17ea958f8e4c35d493a5705",
      "multiple_values_in_field": true
    },
