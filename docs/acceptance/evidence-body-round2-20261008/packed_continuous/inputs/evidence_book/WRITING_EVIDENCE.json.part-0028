            "0"
          ]
        }
      ],
      "variant_group": "field::f71b762c6dfb252526d0872e4975bdf6870c3413ab3e30a41d0d5bb23c1ba29e",
      "multiple_values_in_field": true
    },
    "atom::0ee1f89ce9752d4834de52d4": {
      "atom_id": "atom::0ee1f89ce9752d4834de52d4",
      "source_handle": "P0215",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Clinical trials of Probiotics (CBM588)",
        "finding": "Small prospective trials in mRCC showed significantly improved progression-free survival and overall response rates when CBM588 was added to ICI-based regimens, though sample sizes were limited (n=30 per arm)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::05df8fdca8777120f8d5467388d6a4c6da147dadf5c01015c34a8219aa2ab3b7",
          "field_path": [
            "study_summary_A",
