      "source_handle": "P0390",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "商业益生菌补充剂的使用与较差的ICB反应相关（尤其在低纤维背景下）。"
      },
      "role": "evidence",
