    "atom::0b6d2c06d5666c47f4cadeae": {
      "atom_id": "atom::0b6d2c06d5666c47f4cadeae",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "The paper addresses the complex interplay between the gut microbiome and ICI therapy. Specifically, it seeks to summarize how microbial composition affects ICI efficacy (anti-tumor response) and toxicity (immune-related colitis), and evaluate whether manipulating the microbiome can enhance therapeutic benefits while mitigating side effects.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::4810e2675df32fa1abe5867ff188daea57621f5ece867d8802597bf6252ea24a",
      "multiple_values_in_field": false
    },
    "atom::a19109e78e57e4f80d611645": {
      "atom_id": "atom::a19109e78e57e4f80d611645",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review covers the relationship between the gut microbiome and immune checkpoint inhibitor (ICI) therapy, specifically focusing on anti-tumor efficacy and immune-related adverse events (irAEs), with a primary emphasis on immune-related colitis. The scope includes human clinical studies and preclinical animal models involving melanoma, non-small cell lung cancer (NSCLC), renal cell carcinoma (RCC), and other solid tumors.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::340abe478654ce0ffd861d363464572e71228126488a12fa381758d0c83bd8d3",
      "multiple_values_in_field": false
    },
    "atom::f798506e69d3128826396008": {
      "atom_id": "atom::f798506e69d3128826396008",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This 2023 review article synthesizes existing literature on how the gut microbiome influences the outcomes of ICI therapy. It first outlines the mechanisms of ICIs (targeting CTLA-4, PD-1, and PD-L1). It then reviews evidence linking specific microbial compositions to improved or reduced anti-tumor responses in various cancers. Subsequently, it discusses interventions such as fecal microbiota transplantation (FMT), probiotics, and antibiotics to modulate these effects. Finally, it examines the association between the gut microbiome and ICI-induced colitis, exploring potential predictive biomarkers and therapeutic strategies using microbiome modulation to manage this adverse event.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::e0a35720b45c97fd37e868545753e7ae95e204b6e2760a09f0c3281a9f838726",
      "multiple_values_in_field": false
    },
