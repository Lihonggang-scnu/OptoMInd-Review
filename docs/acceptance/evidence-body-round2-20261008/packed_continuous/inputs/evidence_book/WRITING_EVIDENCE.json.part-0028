            "3"
          ]
        }
      ],
      "variant_group": "field::1a8b7c8060752379794dadedd642ffdd9c02e8f1e95960cab1fce07786e17a96",
      "multiple_values_in_field": true
    },
    "atom::109b9e7b7e341f82f8560f2c": {
      "atom_id": "atom::109b9e7b7e341f82f8560f2c",
      "source_handle": "P0430",
      "field_path": [
