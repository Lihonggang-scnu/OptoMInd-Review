    "atom::f55db604b37d718415014d16": {
      "atom_id": "atom::f55db604b37d718415014d16",
      "source_handle": "P0147",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "区分MDD和亚综合征抑郁的建议虽被提出，但实际应用中需警惕不同研究中抑郁评估工具（SCID-5 vs PHQ-9/HADS）的不一致性带来的混杂。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4a75936e13c7ac85238470aece6c80da0a4f3e7abd84360908298d95d6cbd5ab",
          "field_path": [
