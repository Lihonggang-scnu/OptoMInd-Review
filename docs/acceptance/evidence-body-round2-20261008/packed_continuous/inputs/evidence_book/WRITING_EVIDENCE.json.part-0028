        }
      ],
      "variant_group": "field::b59e688cb7638400d9eac323f981169fe5f26e6c65b422b910e60fc3ab3c5be5",
      "multiple_values_in_field": true
    },
    "atom::a324c79e6b9cc050b47beff5": {
      "atom_id": "atom::a324c79e6b9cc050b47beff5",
      "source_handle": "P0224",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Use to hypothesize mechanisms by which microbiome-derived signals (e.g., SCFAs, bile acids, indoles) might regulate immune cell function (e.g., Tregs, Th17, macrophages) relevant to checkpoint blockade response.",
