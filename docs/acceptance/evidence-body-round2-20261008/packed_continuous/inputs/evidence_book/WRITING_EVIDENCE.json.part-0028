    },
    "atom::31f35b2531529bc9a5ee8553": {
      "atom_id": "atom::31f35b2531529bc9a5ee8553",
      "source_handle": "P0286",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "用于说明预临床发现与临床结果之间的不一致性，以及临床情境（如用药指征）对药物效应的关键影响，提醒在解读微生物群或其他机制研究时需考虑临床背景。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
