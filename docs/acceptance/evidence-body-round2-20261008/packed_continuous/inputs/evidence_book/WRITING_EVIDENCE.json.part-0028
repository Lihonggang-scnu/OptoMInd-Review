    "atom::54dcd292242a5291d8534099": {
      "atom_id": "atom::54dcd292242a5291d8534099",
      "source_handle": "P0088",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "可用于讨论不同类别ICI在安全性管理上的细微差别，或作为未来研究需要区分ICI亚型的依据。",
      "role": "planning",
      "origins": [
