    "atom::6a77b53a16f1542d379f2044": {
      "atom_id": "atom::6a77b53a16f1542d379f2044",
      "source_handle": "P0215",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Preclinical and observational clinical studies",
        "finding": "Specific bacterial taxa (Ruminococcaceae, Akkermansia, Bifidobacterium) correlate with favorable responses to anti-PD-1 antibodies, while antibiotic use before/during ICI initiation is associated with higher primary resistance and shorter overall survival."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::05df8fdca8777120f8d5467388d6a4c6da147dadf5c01015c34a8219aa2ab3b7",
          "field_path": [
            "study_summary_A",
