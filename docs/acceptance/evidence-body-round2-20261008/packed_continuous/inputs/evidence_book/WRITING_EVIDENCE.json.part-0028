    "atom::f4fcf557233ac972a458ffcb": {
      "atom_id": "atom::f4fcf557233ac972a458ffcb",
      "source_handle": "P0249",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用多阶段混合方法：1) 临床前小鼠模型：使用含5%冻干黑覆盆子粉的合成饮食喂养小鼠，检测肠道菌群变化；2) 人体临床试验（BEWELL Study）：设计为安慰剂对照、随机、交叉试验，纳入96名具有>30包年吸烟史且年龄55-77岁的高危肺癌人群，每日摄入2x80mL黑覆盆子花蜜4周，收集前后肠道微生物组及血液/尿液样本进行分析；3) 转化验证：将BEWELL研究中受试者的粪便移植至无菌或特定条件下的小鼠（C57BL/6J），构建人源化微生物组Avatar模型，皮下注射mc38结肠癌细胞，并给予抗PD-1抗体或同型对照，比较干预前后菌群移植组的肿瘤体积差异。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::739b9062383569e86b04707c05b5d1db6953ac2a2ba6faf70f7f3ccb8f4e8c20",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::b11e9007d9c31803b4617477d7c45139b5676d307262993abbee38e0d242577a",
      "multiple_values_in_field": false
    },
    "atom::23b5efcdf05aefc8c316c165": {
      "atom_id": "atom::23b5efcdf05aefc8c316c165",
      "source_handle": "P0249",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了黑覆盆子饮食干预影响人体肠道微生物组的初步证据，并建立了从人体菌群到小鼠肿瘤模型的转化验证路径",
        "limits": "人体试验中目标菌种A. muciniphila未达到统计学显著性；肿瘤抑制结果来自初步实验（Preliminary experiments），样本量和统计效力有限；未直接证明机制，仅展示相关性"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::739b9062383569e86b04707c05b5d1db6953ac2a2ba6faf70f7f3ccb8f4e8c20",
          "field_path": [
