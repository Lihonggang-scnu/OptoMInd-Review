      "atom_id": "atom::3e8ae734ac7383c2861b9bc3",
      "source_handle": "P0188",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "NSCLC队列",
        "finding": "Aspergillus pseudonomiae高丰度与良好预后相关；Saccharomyces cerevisiae高丰度与疗效受损相关；Sacc_type肠型在部分指标上显示优势。"
      },
