    "atom::2c7ba4d9f00632b687c76984": {
      "atom_id": "atom::2c7ba4d9f00632b687c76984",
      "source_handle": "P0286",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "概念框架构建与文献综合。首先基于免疫生物学原理定义iDDIs，随后按三大机制领域（微生物群、全身免疫抑制、TME调节）分类整理常见伴随用药的临床证据（主要引用荟萃分析和观察性研究）。接着，分析传统分析方法在处理iDDIs时的局限性，进而综述各类AI技术（NLP、LLM、ML、XAI、组学与知识图谱）在解决数据提取、时序建模、因果推断和临床决策支持方面的应用现状与挑战。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::a825b3337cf267d898a936ab8fdd75bcf63d9300fd134d6cda8f6c1a06c2b2b9",
      "multiple_values_in_field": false
    },
    "atom::bb72a0c0f8dd1ce7029fd25b": {
      "atom_id": "atom::bb72a0c0f8dd1ce7029fd25b",
      "source_handle": "P0286",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了iDDIs的概念框架，将伴随用药影响分为微生物群、全身免疫抑制和TME调节三类；系统总结了各类药物的临床证据和AI应用现状。",
        "limits": "作为综述，依赖已发表的观察性研究和荟萃分析，因果推断受限；未提供新的原始实验数据；AI部分多为理论探讨和技术综述，缺乏实证结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::6c48a66caab0988a69c650a823d52ad061848ce2b6a2bb50ef8af72a6685a6e7",
      "multiple_values_in_field": false
    },
    "atom::1fba7a5d9f0d1add57212315": {
      "atom_id": "atom::1fba7a5d9f0d1add57212315",
      "source_handle": "P0286",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "围ICI期使用抗生素或PPIs",
        "finding": "多项荟萃分析显示与较差的总生存期（OS）和无进展生存期（PFS）相关，其中抗生素暴露于ICI启动前30-90天效果最强；存在“病人用户偏差”混杂。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::9d73387b1bf9d25bfe93de53c0bb04bee1f91e89a8d622ba9e118759fb48b792",
      "multiple_values_in_field": true
    },
    "atom::1afc5eb8828695f641a57e87": {
      "atom_id": "atom::1afc5eb8828695f641a57e87",
      "source_handle": "P0286",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "皮质类固醇用于姑息治疗 vs. irAE管理",
        "finding": "表现出“指征反转”现象：用于姑息治疗时与较差预后相关，而用于irAE管理时通常不损害生存；峰值剂量比累积暴露量更具预测性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::9d73387b1bf9d25bfe93de53c0bb04bee1f91e89a8d622ba9e118759fb48b792",
      "multiple_values_in_field": true
    },
    "atom::a99e5c48976b2c22d1d9f41a": {
      "atom_id": "atom::a99e5c48976b2c22d1d9f41a",
      "source_handle": "P0286",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "RAAS抑制剂（ACEi/ARBs）",
        "finding": "部分回顾性研究显示可能改善OS，尤其在尿路上皮癌和肾细胞癌中，但证据来自观察性研究。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::9d73387b1bf9d25bfe93de53c0bb04bee1f91e89a8d622ba9e118759fb48b792",
      "multiple_values_in_field": true
    },
    "atom::40df3200499600cf92d9d22b": {
      "atom_id": "atom::40df3200499600cf92d9d22b",
      "source_handle": "P0286",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "当前AI应用状态",
        "finding": "处于早期阶段，多为概念验证；缺乏外部验证和标准化数据集；LLM存在幻觉风险；需结合多模态数据和前瞻性研究。"
