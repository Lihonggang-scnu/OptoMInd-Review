    "atom::a38e12937b2ab796304cbf28": {
      "atom_id": "atom::a38e12937b2ab796304cbf28",
      "source_handle": "P0224",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Human data on functional biomarkers in the context of sleep are limited; most mechanistic details come from rodent models.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65d1d201a18946b88612ec88989dcf0cf75c17f3f27fd250b4782daff97ca912",
