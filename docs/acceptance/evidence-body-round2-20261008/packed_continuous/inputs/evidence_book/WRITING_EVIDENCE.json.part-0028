    "atom::8f36efceb939e4c305ac0ba1": {
      "atom_id": "atom::8f36efceb939e4c305ac0ba1",
      "source_handle": "P0147",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制描述来自预实验或相关性研究，人类体内的因果链条尚未完全证实。特别是心理压力通过微生物群影响免疫治疗的具体分子路径仍需更多实证支持。",
        "contribution": "详细阐述了介导微生物群影响免疫治疗疗效的潜在机制，包括：1) 微生物代谢物（短链脂肪酸）调节肠道屏障和全身炎症；2) 微生物群通过肠-脑轴影响神经递质和应激反应；3) 抑郁症引发的HPA轴激活和炎症细胞因子释放（如IL-6, TNF-α）通过色氨酸代谢途径抑制T细胞功能。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4a75936e13c7ac85238470aece6c80da0a4f3e7abd84360908298d95d6cbd5ab",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::ed0cb3db3ca9164210e1e1b33010b82b9cbed3a73357c6047fd8352ac37fae5e",
      "multiple_values_in_field": true
    },
    "atom::965decd360037d04495c0f4a": {
      "atom_id": "atom::965decd360037d04495c0f4a",
      "source_handle": "P0147",
      "field_path": [
