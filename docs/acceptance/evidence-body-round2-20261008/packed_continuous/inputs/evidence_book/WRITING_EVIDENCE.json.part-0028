    "atom::a4f284369b720684f5b84087": {
      "atom_id": "atom::a4f284369b720684f5b84087",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "这是一项观察性临床研究设计。首先，在CHUM微生物组中心，由营养师使用经过验证的DHQ-II问卷前瞻性收集147名晚期NSCLC患者的饮食史。其次，采用单变量和多变量Cox回归分析，考察全球饮食模式和72种宏微观营养素（以中位数为截断值）与PFS的关联，并调整BMI等协变量。同时，分析饮食与irAEs发生率的关联。最后，对69名患者的粪便样本进行鸟枪法宏基因组测序（WMS），利用线性判别分析、热图和MaAsLin2工具确定细菌丰度的差异，以建立饮食-微生物组-临床结局的联系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::97ab063bda3e4c6400a7d31c6076ace8ea653dc3e26b9c97f14974c4c5d0ed00",
      "multiple_values_in_field": false
    },
    "atom::b9288d216e53cb88c871a592": {
      "atom_id": "atom::b9288d216e53cb88c871a592",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了在晚期NSCLC人群中，特定饮食模式（特别是高脂/低淀粉）和单一营养素（维生素K）与ICI治疗PFS及irAEs关联的临床证据。",
        "limits": "研究为观察性设计，无法确立因果关系；样本量相对较小（尤其是微生物组子集仅69人）；未控制所有潜在混杂因素（如抗生素使用、其他生活方式因素）；结果需在随机对照试验中验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::ab07a1d3073e982a35ecae7163451d59cb61559eccd3a4644412b30108abf2fb",
      "multiple_values_in_field": true
    },
    "atom::a35a04dbf48da9976085f315": {
      "atom_id": "atom::a35a04dbf48da9976085f315",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "通过宏基因组测序揭示了饮食-微生物组-临床结局的潜在生物学机制线索，将临床表型与特定细菌丰度变化联系起来。",
        "limits": "微生物组分析仅为相关性信号，未进行功能验证或因果推断；所发现的细菌标志物需在其他队列中复现。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::ab07a1d3073e982a35ecae7163451d59cb61559eccd3a4644412b30108abf2fb",
      "multiple_values_in_field": true
    },
    "atom::31331d0a3ebfd8a941d1aa41": {
      "atom_id": "atom::31331d0a3ebfd8a941d1aa41",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "全队列（N=147），调整基础代谢率后",
        "finding": "总热量摄入与PFS无显著关联（p = 0.3）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "key_findings",
