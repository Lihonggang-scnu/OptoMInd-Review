    "atom::7e8e1c7963e3ec51c6320f27": {
      "atom_id": "atom::7e8e1c7963e3ec51c6320f27",
      "source_handle": "P0088",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "提示不同靶点的ICI与PPI可能存在不同的相互作用风险谱，例如PD-1更关联肝毒性和皮肤毒性，而PD-L1更关联代谢问题。",
      "role": "planning",
      "origins": [
        {
