    "atom::3817e05c447ed495c9d2af42": {
      "atom_id": "atom::3817e05c447ed495c9d2af42",
      "source_handle": "P0286",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "提到某些药物（如二甲双胍）在临床研究中未显示出益处甚至有害，尽管有预临床数据支持；皮质类固醇的“指征反转”现象。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
