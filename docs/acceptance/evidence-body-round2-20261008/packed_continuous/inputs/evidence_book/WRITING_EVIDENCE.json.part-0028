    "atom::ad265986258531782c598fac": {
      "atom_id": "atom::ad265986258531782c598fac",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "topic_handles"
      ],
      "value": "跨界微生物互作（细菌-真菌网络）",
      "role": "planning",
