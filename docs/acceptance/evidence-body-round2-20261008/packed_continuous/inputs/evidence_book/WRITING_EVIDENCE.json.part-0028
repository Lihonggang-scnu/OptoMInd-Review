      "variant_group": "field::5373f128266075d0a0763cf9ec88537170e1e94a79155272cada92da1c1a1f76",
      "multiple_values_in_field": true
    },
    "atom::b97c043183769f200de404ee": {
      "atom_id": "atom::b97c043183769f200de404ee",
      "source_handle": "P0147",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "微生物群与免疫治疗疗效的关联在不同癌症类型（如黑色素瘤 vs 肺癌）中可能存在差异，本综述未详细区分具体癌种的特异性发现。",
