    "atom::059d3f40b149cda601516251": {
      "atom_id": "atom::059d3f40b149cda601516251",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇叙述性综述，作者基于现有文献（包括观察性研究、临床试验、指南和机制研究），系统性地归纳了影响ICI疗效的非肿瘤内在因素（如炎症、微生物群、生活方式），并据此分类讨论了各类整合肿瘤学干预手段（营养、运动、微生物调节、补充剂、心理干预、草药等）的证据等级、潜在机制及临床建议。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::826e4d7885f21e6b26d1f78ac6000b1b8edff2292a9a7f5c3093c3e454e30f41",
      "multiple_values_in_field": false
    },
    "atom::65d778840757126d567a9fcb": {
      "atom_id": "atom::65d778840757126d567a9fcb",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了整合肿瘤学策略支持ICI治疗的全面概览，特别强调了从“预测”转向“响应行动”的转化医学思路（如利用炎症标志物指导干预时机）。",
        "limits": "所引用的多数证据来自观察性研究或小样本试验，缺乏大规模随机对照试验（RCT）的确证；对于许多干预措施（如特定益生菌、中草药、身心疗法），其因果效应和最佳剂量/方案尚未明确。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::0c2ac2b224893727af2898624faa7cc8f7bee25d3b52661aa18ded15f4f206af",
      "multiple_values_in_field": true
    },
    "atom::ec1a190580c88365600c5078": {
      "atom_id": "atom::ec1a190580c88365600c5078",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "明确了医疗大麻在ICI治疗中的潜在负面信号，以及维生素D补充的具体获益阈值。",
        "limits": "对某些新兴领域（如真菌疗法、具体中药方剂）仅提及预临床证据或正在进行的试验，缺乏直接的临床结果支持。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::0c2ac2b224893727af2898624faa7cc8f7bee25d3b52661aa18ded15f4f206af",
      "multiple_values_in_field": true
    },
    "atom::8860efde974ad499faa50edc": {
      "atom_id": "atom::8860efde974ad499faa50edc",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "成人实体瘤患者，基线或治疗期间",
        "finding": "系统性炎症标志物（如NLR, CRP, LIPI）升高与较差的ICI预后相关；CRP flare（治疗后初期CRP升高后下降）可能与良好的免疫反应相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::86bbfc61afb51265803c7da4": {
      "atom_id": "atom::86bbfc61afb51265803c7da4",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "饮食干预",
        "finding": "摄入至少20g/天膳食纤维的地中海式饮食与晚期黑色素瘤患者的无进展生存期（PFS）延长相关；避免超加工食品和高糖饮料有助于维持健康的肠道微生物群。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::2b876bfc226ae5503a44cc9d": {
      "atom_id": "atom::2b876bfc226ae5503a44cc9d",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "运动干预",
        "finding": "回顾性研究显示，接受仑伐替尼联合抗PD-1治疗的肝细胞癌患者中，活跃运动组比久坐组具有更长的总生存期（OS）和无进展生存期（PFS）；但针对ICI的特异性RCT数据仍有限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::cd932a80a64060bbecc8f4d4": {
      "atom_id": "atom::cd932a80a64060bbecc8f4d4",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肠道微生物群调节",
        "finding": "粪菌移植（FMT）可使部分ICI耐药患者产生客观缓解；口服活体生物疗法（LBTs，如MRx0518, CBM588）显示出免疫调节和增强ICI疗效的潜力，且可能减轻胃肠道irAEs。益生菌效果存在争议，取决于菌株特异性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::5523d14b166740380cf649fd": {
      "atom_id": "atom::5523d14b166740380cf649fd",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "维生素D补充",
        "finding": "PROVIDENCE前瞻性研究表明，将血清25-羟基维生素D水平补充至≥75 nmol/l可显著延长晚期癌症患者的OS，降低疾病控制失败风险，并减少甲状腺irAEs的发生率。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::fb25fb43e17b2e5e04ea16bb": {
      "atom_id": "atom::fb25fb43e17b2e5e04ea16bb",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "医疗大麻使用",
        "finding": "一项前瞻性观察性研究发现，医疗大麻的使用与时间至肿瘤进展缩短及总生存期（OS）显著降低相关；尽管另一项小样本研究未达统计学显著差异，但鉴于潜在风险，建议谨慎使用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "5"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::6cc18e204e7d4239bb2970d5": {
      "atom_id": "atom::6cc18e204e7d4239bb2970d5",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "慢性压力与身心疗法",
        "finding": "治疗前的情绪困扰和慢性心理压力被证实是黑色素瘤和非小细胞肺癌（NSCLC）患者ICI疗效差的独立预后因素；身心疗法（瑜伽、太极等）在此领域尚需进一步临床研究。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "6"
          ]
        }
      ],
      "variant_group": "field::cf6380a0086080bbe7473b77d04d4368fb81f9004ae1ddd2338954c718e4de84",
      "multiple_values_in_field": true
    },
    "atom::007442678434e9f15c3c399d": {
      "atom_id": "atom::007442678434e9f15c3c399d",
      "source_handle": "P0343",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
