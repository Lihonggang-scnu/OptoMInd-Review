    "atom::58fc7bce94ad7dddfc571d45": {
      "atom_id": "atom::58fc7bce94ad7dddfc571d45",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "建议未来研究应关注功能而非单纯的物种组成，设计针对特定功能的免疫刺激联合体，并探索宿主因素（如BMI、性别、饮食）对微生物定植和治疗反应的影响。"
