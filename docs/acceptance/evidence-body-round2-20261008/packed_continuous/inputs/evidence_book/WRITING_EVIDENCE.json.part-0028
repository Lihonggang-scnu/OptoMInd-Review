    "atom::15bb2d6be9797932dbb12d3b": {
      "atom_id": "atom::15bb2d6be9797932dbb12d3b",
      "source_handle": "P0537",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "黑色素瘤队列（n=42）",
        "finding": "PPI使用者与非使用者在Alpha/Beta多样性上无显著差异，但特定菌属丰度不同：PPI使用者乳酸杆菌科（Lactobacillaceae）和韦荣球菌属（Veillonella）相对丰度较高，而非使用者梭菌科（Clostridiaceae）和拟杆菌属（Bacteroides）较多，且部分双歧杆菌仅在非使用者中发现。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::168b1c9fa84a53731e07089c8b4c42fa48d3b09c2773b17b23a203a5dbd72e28",
