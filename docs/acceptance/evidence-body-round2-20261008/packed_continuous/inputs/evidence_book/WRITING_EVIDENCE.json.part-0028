    "atom::bc2e3955d3688d39265e21f7": {
      "atom_id": "atom::bc2e3955d3688d39265e21f7",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Many mechanistic insights are derived from murine models (e.g., cross-reactivity of Bifidobacterium breve). Human validation is ongoing. The review notes that intricate mechanisms remain fully understood.",
        "contribution": "Outlines mechanistic pathways: 1) Activation of innate immunity via PRRs leading to adaptive immune response; 2) Production of metabolites like SCFAs influencing T-cell differentiation; 3) Molecular mimicry/cross-reactivity between commensal bacteria and tumor antigens.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::1b58a53a4c76f7ad31bedea47e026dc1b7ab85dc3b82fd6211bd56d202fadaef",
      "multiple_values_in_field": true
    },
    "atom::b2915267a1f6abe9a43df25a": {
      "atom_id": "atom::b2915267a1f6abe9a43df25a",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Directly addresses 'what mechanisms mediate that effect?' by detailing biological processes linking microbes to immune activation and tumor control.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
