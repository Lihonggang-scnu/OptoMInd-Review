      "multiple_values_in_field": true
    },
    "atom::cbcb099dbb300df0550a1e8f": {
      "atom_id": "atom::cbcb099dbb300df0550a1e8f",
      "source_handle": "P0249",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该模型本身是工具而非机制解释；具体的分子机制（如抗原呈递、T细胞活化等）在本摘要中未详细阐述，仅表现为肿瘤体积减小。",
        "contribution": "展示了利用‘人体微生物组Avatar模型’（Human microbiome avatar models）来桥接人体菌群变化与肿瘤免疫反应之间关系的实验设计。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::739b9062383569e86b04707c05b5d1db6953ac2a2ba6faf70f7f3ccb8f4e8c20",
