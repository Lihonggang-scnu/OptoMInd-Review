    "atom::d0f8420c3b102ace86487de1": {
      "atom_id": "atom::d0f8420c3b102ace86487de1",
      "source_handle": "P0224",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "To provide context on how non-pharmacological factors (sleep) can induce systemic inflammation and metabolic shifts that may confound or interact with ICI efficacy. Highlights the importance of considering host physiological state (inflammation, barrier function) when interpreting microbiome-ICI relationships.",
      "role": "planning",
      "origins": [
