      ],
      "variant_group": "field::2d6b145e1855f4e062f9c285044fd94e7d4ad1cdb8179024b5ea22e619e2b6a6",
      "multiple_values_in_field": true
    },
    "atom::8339dcdf922b81a5ed70de0a": {
      "atom_id": "atom::8339dcdf922b81a5ed70de0a",
      "source_handle": "P0249",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "确认了黑覆盆子干预能引起非目标菌群的改变，提示其对微生物组有广泛影响",
        "limits": "具体哪些菌群变化导致了肿瘤抑制效果尚不明确，缺乏详细的机制解析"
      },
      "role": "evidence",
      "origins": [
