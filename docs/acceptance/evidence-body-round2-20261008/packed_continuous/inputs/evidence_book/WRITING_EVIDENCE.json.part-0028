          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "3"
          ]
        }
      ],
      "variant_group": "field::1b58a53a4c76f7ad31bedea47e026dc1b7ab85dc3b82fd6211bd56d202fadaef",
      "multiple_values_in_field": true
    },
    "atom::20dad2ca1e29677ab7f93d32": {
      "atom_id": "atom::20dad2ca1e29677ab7f93d32",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Provides evidence for mechanistic links between microbiome restoration and immune tolerance in the context of irAEs.",
      "role": "planning",
