    "atom::ee58555179dd935deaaa06ba": {
      "atom_id": "atom::ee58555179dd935deaaa06ba",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "在综述中评估当前肠道真菌研究的可靠性时，可作为方法论案例，说明如何处理宏基因组数据中的低丰度信号和批次效应，以及如何审慎解读观察性关联。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::17fb2577c178c470fc673d49f4a7a7ee5b5e91b4bd4aaffef78bca18cd17d412",
      "multiple_values_in_field": true
    },
    "atom::2f38f1e7a04dd20a865d399c": {
      "atom_id": "atom::2f38f1e7a04dd20a865d399c",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "研究发现响应者中细菌-真菌互作网络更复杂，且某些真菌（如D. hansenii）可能通过影响细菌或免疫微环境发挥作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
