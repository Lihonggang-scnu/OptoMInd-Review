    "atom::cdfa84ab658337a937308d5b": {
      "atom_id": "atom::cdfa84ab658337a937308d5b",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Associations vary by cancer type and ICI class. Evidence is primarily observational/correlational in humans; causality is often inferred from animal models. Sample sizes in cited studies are modest.",
        "contribution": "Identifies specific gut microbial signatures associated with ICI efficacy. For example, Akkermansia muciniphila and Faecalibacterium are linked to better responses in NSCLC and melanoma, respectively. Conversely, prior antibiotic use is linked to reduced efficacy.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::1b58a53a4c76f7ad31bedea47e026dc1b7ab85dc3b82fd6211bd56d202fadaef",
      "multiple_values_in_field": true
    },
    "atom::d025db0d27340c9c0859d2e1": {
      "atom_id": "atom::d025db0d27340c9c0859d2e1",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to answer 'How does the gut microbiome modulate efficacy?' by providing concrete examples of beneficial and detrimental microbial profiles and the impact of external factors like antibiotics.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::479baffd4deede51baf79bf5c3265fc1f6f3e28c4dd91e04ec1bc5c25ac8e3f9",
      "multiple_values_in_field": true
    },
    "atom::d7b382d3afc2fe6a1d2f3dc5": {
      "atom_id": "atom::d7b382d3afc2fe6a1d2f3dc5",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Conflicting results across studies mean no single taxon is universally accepted as a predictor. The review explicitly states evidence is inconsistent.",
        "contribution": "Discusses the inconsistent predictive value of microbiome composition for ICI-induced colitis. Some studies link Firmicutes to colitis, while others link Bacteroidetes to resistance.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::1b58a53a4c76f7ad31bedea47e026dc1b7ab85dc3b82fd6211bd56d202fadaef",
      "multiple_values_in_field": true
    },
    "atom::0871632a1a9090829c833c72": {
      "atom_id": "atom::0871632a1a9090829c833c72",
      "source_handle": "P0359",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Useful for discussing the complexity of predicting irAEs and the lack of consensus on biomarkers for colitis risk.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
