    "atom::6c712fe08a8ae1a16d31b925": {
      "atom_id": "atom::6c712fe08a8ae1a16d31b925",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些关联多为观察性研究结果，存在因果推断的局限；不同研究间的一致性较差，需结合其他证据谨慎解读。",
        "contribution": "详细列出了在不同癌症类型（黑色素瘤、NSCLC、HCC、CRC等）中，与ICI疗效正相关或负相关的特定细菌类群及其丰度变化。例如，指出Ruminococcaceae、Lachnospiraceae、Akkermansiaceae通常在响应者中富集，而某些Bacteroides物种在非响应者中更常见。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
