    "atom::fe7499ea9b2c83abb0ab9571": {
      "atom_id": "atom::fe7499ea9b2c83abb0ab9571",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "支持综述中关于“微生物组整体生态”而非单一物种重要性的论点，强调细菌-真菌协同作用在ICI疗效中的潜在角色。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::17fb2577c178c470fc673d49f4a7a7ee5b5e91b4bd4aaffef78bca18cd17d412",
      "multiple_values_in_field": true
    },
    "atom::96446b4dfdcd1af2e6aa5ad8": {
      "atom_id": "atom::96446b4dfdcd1af2e6aa5ad8",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "关联结果基于观察性荟萃分析，存在混杂因素风险；部分物种（如植物病原菌）的临床意义尚未完全明确；NSCLC队列样本量限制使得结论不如黑色素瘤稳健。",
        "contribution": "提供了具体的真菌物种与ICI疗效关联的方向性证据。例如，在黑色素瘤中，Aspergillus avenaceus正向关联，而Rhizophagus irregularis和Debaryomyces hansenii负向关联；在NSCLC中，Aspergillus pseudonomiae正向关联。这有助于解释为何不同研究中微生物标志物存在异质性，提示需按菌种甚至癌症类型细分。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::7a448c00693836b4581b0410a60b12e0dfb890abb84e1211e646d90f487784cf",
      "multiple_values_in_field": true
    },
    "atom::8d6f59d921b3ba2014e26d62": {
      "atom_id": "atom::8d6f59d921b3ba2014e26d62",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论肠道真菌作为生物标志物的潜力，特别是强调真菌组成的异质性及癌症类型依赖性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5ebfef2920ef50846e91aaae907277ba6c01ca9b9a619a20ef3d676d817269fa",
      "multiple_values_in_field": true
    },
    "atom::39cd933fa99047001c444f36": {
      "atom_id": "atom::39cd933fa99047001c444f36",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "体内实验仅展示了表型和相关性变化，未深入解析具体的分子通路（如具体细胞因子级联反应）；其他阳性关联真菌（如A. avenaceus）的机制在本研究中未经验证；作者提及的机制多为文献推测，需结合其他研究综合判断。",
        "contribution": "提供了真菌影响ICI疗效的潜在机制线索。通过小鼠实验证实Debaryomyces hansenii可通过减少CD8+ T细胞浸润和降低趋化因子（CCL5, CXCL10）表达来抑制PD-1单抗疗效。此外，讨论了真菌细胞壁成分（如β-葡聚糖）激活免疫受体（如Dectin-1/CARD9）的可能性，以及真菌代谢物对细菌生长的影响。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::7a448c00693836b4581b0410a60b12e0dfb890abb84e1211e646d90f487784cf",
      "multiple_values_in_field": true
    },
    "atom::008468d8e2d99de2079913a5": {
      "atom_id": "atom::008468d8e2d99de2079913a5",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中阐述真菌调节抗肿瘤免疫的具体途径，特别是真菌如何通过调节T细胞功能或免疫检查点表达来影响治疗反应。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5ebfef2920ef50846e91aaae907277ba6c01ca9b9a619a20ef3d676d817269fa",
      "multiple_values_in_field": true
    },
    "atom::3f7770bcb1276640c3f3eba1": {
      "atom_id": "atom::3f7770bcb1276640c3f3eba1",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "肠型的定义依赖于聚类算法和特定数据集，不同队列间分布存在差异；细菌肠型在本研究中未显示显著关联，突显了真菌肠型的独特性但也限制了通用性。",
        "contribution": "提出了“真菌肠型”概念，发现Aspergillus主导型（Asper_high）和Saccharomyces主导型（Sacc_type）与较好的ICI疗效相关。这为将复杂的微生物组数据简化为可操作的临床分层工具提供了依据。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::7a448c00693836b4581b0410a60b12e0dfb890abb84e1211e646d90f487784cf",
      "multiple_values_in_field": true
    },
    "atom::489072405cf23f4972090f54": {
      "atom_id": "atom::489072405cf23f4972090f54",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中探讨微生物组分层的策略，比较基于物种丰度与基于群落结构（肠型）的方法优劣。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5ebfef2920ef50846e91aaae907277ba6c01ca9b9a619a20ef3d676d817269fa",
      "multiple_values_in_field": true
    },
    "atom::67a4390dbbc70ca23fe5f0aa": {
      "atom_id": "atom::67a4390dbbc70ca23fe5f0aa",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于肠道真菌（而非仅细菌）调节ICI疗效的关键实证素材。其核心价值在于区分了不同癌症类型（黑色素瘤vs NSCLC）中真菌标志物的特异性，揭示了真菌肠型作为分层工具的潜力，并通过动物实验初步建立了“特定真菌-免疫微环境-疗效”的因果链条，特别是针对负面调控因子（D. hansenii）的机制探索。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::994ca80a766abed2632583d6264fc120699bb6d812b846699d61c468bc3598d3",
      "multiple_values_in_field": false
    },
    "atom::d0588e755227e0c16ae8c111": {
      "atom_id": "atom::d0588e755227e0c16ae8c111",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究主要基于黑色素瘤和NSCLC数据，RCC数据因样本量小而结论有限，不能直接推广至所有实体瘤。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::7a2f49f4d5e188c8c9ebdb865fc800a5cc0b9df0092ab6d1feea5204d59f42ae",
      "multiple_values_in_field": true
    },
    "atom::82ff46c5d7d5e5d5a9a26245": {
      "atom_id": "atom::82ff46c5d7d5e5d5a9a26245",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "发现的真菌标志物多为相关性，除D. hansenii外，其他物种的因果机制尚属假设，需在综述中区分观察性发现与机制性证据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::7a2f49f4d5e188c8c9ebdb865fc800a5cc0b9df0092ab6d1feea5204d59f42ae",
      "multiple_values_in_field": true
    },
    "atom::27dc64ed9ac314212e043361": {
      "atom_id": "atom::27dc64ed9ac314212e043361",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "NSCLC中观察到的互作网络趋势与黑色素瘤相反，作者归因于样本量和测序深度，这在解释跨癌种一致性时需格外谨慎。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::7a2f49f4d5e188c8c9ebdb865fc800a5cc0b9df0092ab6d1feea5204d59f42ae",
      "multiple_values_in_field": true
    },
    "atom::303f86ca687562251288362f": {
      "atom_id": "atom::303f86ca687562251288362f",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "部分鉴定出的真菌（如植物病原菌）在人体肠道中的定植能力和致病性尚存争议，其临床意义需结合后续培养和功能研究验证。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
