    },
    "atom::67b35a380c5b90cb53f1a95d": {
      "atom_id": "atom::67b35a380c5b90cb53f1a95d",
      "source_handle": "P0390",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "基于小鼠模型，机制链条（从纤维/益生菌到T细胞）在人类中尚未完全证实；仅涉及抗PD-1通路；IFN-γ+ T细胞仅为单一指标，未涵盖其他免疫细胞亚群或细胞因子网络。",
        "contribution": "在小鼠模型中揭示了低纤维饮食或益生菌使用导致抗肿瘤免疫反应受损的机制线索：肿瘤微环境中IFN-γ+细胞毒性T细胞频率降低。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd4bd19193b9b492311379f8d50d16916f9b53fd38c3501cf1dbc484ebc8a2cf",
          "field_path": [
