    "atom::ada97554e765f25f023d3519": {
      "atom_id": "atom::ada97554e765f25f023d3519",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "As a narrative review, the authors systematically organized and summarized findings from previously published human clinical trials and preclinical studies. The approach involved categorizing evidence by: 1) Mechanisms of ICIs; 2) Correlations between baseline/response microbiome profiles and ICI efficacy; 3) Impact of microbiome-modulating interventions (FMT, probiotics, antibiotics) on ICI outcomes; 4) Underlying immunological mechanisms (e.g., SCFAs, cross-reactivity); and 5) The role of the microbiome in ICI-induced colitis, including diagnostic markers and treatment options. The authors compiled data from tables summarizing key human-based studies to compare associations across different malignancies and ICI types.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::0f8c081bc015d6ba015cf9d18dc497ca8e4ddbbd905c771d05e61888e8ae53d5",
      "multiple_values_in_field": false
    },
    "atom::d69793bb8d5b2e4cef50bf38": {
      "atom_id": "atom::d69793bb8d5b2e4cef50bf38",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive synthesis of current human and preclinical evidence linking specific gut microbial taxa to ICI efficacy and toxicity across major solid tumors (melanoma, NSCLC, RCC).",
        "limits": "As a narrative review, it does not present new primary data or perform a systematic meta-analysis. The summary highlights inconsistencies in the literature (e.g., conflicting biomarkers for colitis) rather than resolving them."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::875a4fb7673690a74134aa76e79d020d85e501a7f05b01ef5d59fdcdcbb8a42d",
      "multiple_values_in_field": true
    },
    "atom::027edf095a16cd156d8189d9": {
      "atom_id": "atom::027edf095a16cd156d8189d9",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Clarifies the mechanistic pathways through which the microbiome influences immunity, including PRR activation, SCFA production, and T-cell cross-reactivity.",
        "limits": "Mechanistic details are largely derived from animal models or small-scale human correlative studies; the precise causal chains in humans remain partially understood and warrant further research."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::875a4fb7673690a74134aa76e79d020d85e501a7f05b01ef5d59fdcdcbb8a42d",
      "multiple_values_in_field": true
    },
    "atom::13c35c577af67fe07894700a": {
      "atom_id": "atom::13c35c577af67fe07894700a",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Evaluates the clinical potential of microbiome interventions (FMT, probiotics, antibiotics avoidance) as adjuncts to ICI therapy.",
        "limits": "Clinical trial data on interventions are limited in sample size and scope (mostly Phase 1/2 or case series). The review notes that large-scale randomized controlled trials are needed to confirm efficacy and safety."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::875a4fb7673690a74134aa76e79d020d85e501a7f05b01ef5d59fdcdcbb8a42d",
      "multiple_values_in_field": true
    },
    "atom::406abbb01f8205dd1c17cc7a": {
      "atom_id": "atom::406abbb01f8205dd1c17cc7a",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Melanoma treated with anti-CTLA-4",
        "finding": "Enrichment of Faecalibacterium genus and Firmicutes was associated with longer progression-free survival (PFS) and overall survival (OS), whereas Bacteroides enrichment was linked to poorer outcomes."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::08fdb7e8e660c27dabb7e9421b9ded291b38726930fe4ba176d385ea7afeda67",
      "multiple_values_in_field": true
    },
    "atom::40ae49ee550559ff59b401e5": {
      "atom_id": "atom::40ae49ee550559ff59b401e5",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Metastatic melanoma treated with anti-PD-1",
        "finding": "Responders showed higher abundance of Ruminococcaceae family members (specifically Faecalibacterium, Bifidobacterium longum, Collinsella aerofaciens, and Enterococcus faecium) compared to non-responders."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::08fdb7e8e660c27dabb7e9421b9ded291b38726930fe4ba176d385ea7afeda67",
      "multiple_values_in_field": true
    },
    "atom::8cbbd30b3a0b49cf326becaf": {
      "atom_id": "atom::8cbbd30b3a0b49cf326becaf",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "NSCLC and RCC treated with anti-PD-1",
        "finding": "Akkermansia muciniphila enrichment correlated with favorable clinical response. In NSCLC responders, Ruminococcus, Alistipes, and Eubacterium were enriched, while Bifidobacterium adolescentis and Parabacteroides distasonis were less abundant."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::08fdb7e8e660c27dabb7e9421b9ded291b38726930fe4ba176d385ea7afeda67",
      "multiple_values_in_field": true
    },
    "atom::d959ace0a2a6d1679a5c4fb8": {
      "atom_id": "atom::d959ace0a2a6d1679a5c4fb8",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Pre-treatment antibiotic use",
        "finding": "Prior use of broad-spectrum antibiotics (especially beta-lactams) up to 30 days before ICI therapy was consistently associated with worse OS, lower response rates, and shorter PFS across multiple cancer types, likely due to induced dysbiosis."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::08fdb7e8e660c27dabb7e9421b9ded291b38726930fe4ba176d385ea7afeda67",
      "multiple_values_in_field": true
    },
    "atom::4413358bbb889b8c6b743b10": {
      "atom_id": "atom::4413358bbb889b8c6b743b10",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI-induced colitis risk prediction",
        "finding": "Evidence is inconsistent regarding predictive biomarkers. Some studies link Firmicutes (e.g., Faecalibacterium prausnitzii) to colitis occurrence, while others associate Bacteroidetes (e.g., Bacteroides species) with resistance to colitis. Decreased diversity and shifts in composition are generally observed in patients developing colitis."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::08fdb7e8e660c27dabb7e9421b9ded291b38726930fe4ba176d385ea7afeda67",
      "multiple_values_in_field": true
    },
    "atom::fa872619d9266018cead4748": {
      "atom_id": "atom::fa872619d9266018cead4748",
      "source_handle": "P0359",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Microbiome modulation via FMT/Probiotics",
        "finding": "FMT from ICI responders improved clinical response in refractory melanoma patients. Probiotic administration showed mixed results: no effect on survival in one melanoma study, but improved PFS in an RCC study with dual ICI. Animal models suggest certain probiotics (e.g., Bifidobacterium, Lactobacillus reuteri) can mitigate colitis severity without compromising anti-tumor immunity."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a5e79d2dd3544aec229eec5d2b779ec39af46eadc0eda55b5f463a549cabb15f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "5"
          ]
        }
      ],
      "variant_group": "field::08fdb7e8e660c27dabb7e9421b9ded291b38726930fe4ba176d385ea7afeda67",
      "multiple_values_in_field": true
    },
    "atom::6b94a7309dca482470c3b780": {
