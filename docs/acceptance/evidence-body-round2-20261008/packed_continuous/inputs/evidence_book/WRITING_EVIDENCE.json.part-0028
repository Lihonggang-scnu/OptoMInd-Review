      "multiple_values_in_field": true
    },
    "atom::c48436c4afd6b366cbf40c34": {
      "atom_id": "atom::c48436c4afd6b366cbf40c34",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
