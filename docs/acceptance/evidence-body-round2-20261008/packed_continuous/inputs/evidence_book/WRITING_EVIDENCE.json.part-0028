      "multiple_values_in_field": true
    },
    "atom::e9d44f19afd97a22d2ca0758": {
      "atom_id": "atom::e9d44f19afd97a22d2ca0758",
      "source_handle": "P0188",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠体内验证",
        "finding": "灌胃Debaryomyces hansenii显著促进肿瘤生长，削弱PD-1单抗疗效，伴随肿瘤组织中CD8+ T细胞比例下降及CCL5/CXCL10/PD-L1表达降低。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
