    "atom::232ea9e9bb77421c8012a9a2": {
      "atom_id": "atom::232ea9e9bb77421c8012a9a2",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Evidence is largely correlative in humans; causal proof comes from mouse models and small FMT trials. Results vary by cancer type and patient cohort.",
        "contribution": "Summarizes clinical evidence linking specific gut microbiome compositions (high diversity, presence of Akkermansia/Bifidobacterium) to improved ICI outcomes in melanoma and NSCLC. Highlights the negative impact of antibiotic use on ICI efficacy.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::1ec732767a8f2823bc4ac4e72e09100670ccb661636207ef523cec9d3e7f46df",
      "multiple_values_in_field": true
    },
    "atom::90191e01d08906b80c720e75": {
      "atom_id": "atom::90191e01d08906b80c720e75",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Use to support the association between microbiome profiles and ICI efficacy in solid tumors. Can cite the specific taxa identified as positive predictors.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::9924c763c7eea16cf0d406df8db15a91588013ba42261e239e8e36a8d07b5894",
      "multiple_values_in_field": true
    },
    "atom::76550e45dcbca304bc012b84": {
      "atom_id": "atom::76550e45dcbca304bc012b84",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Many mechanistic details are inferred from animal studies or in vitro data. The exact molecular pathways in humans are still being elucidated. The review notes that 'MMSP' (microbiome-mediated secretory phenotype) is a proposed unifying concept but requires further validation.",
        "contribution": "Details mechanisms including: 1) Immune priming (enhancing CD8+ T-cell infiltration and dendritic cell maturation); 2) Metabolic modulation (SCFA production, bile acid alteration); 3) Hormonal regulation (estrobolome in breast cancer, androgen synthesis in prostate cancer); 4) Inflammatory signaling (NF-kB activation).",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::1ec732767a8f2823bc4ac4e72e09100670ccb661636207ef523cec9d3e7f46df",
      "multiple_values_in_field": true
    },
    "atom::76423a4e48320d9586e7e6c6": {
      "atom_id": "atom::76423a4e48320d9586e7e6c6",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Use to explain *how* the microbiome modulates ICI efficacy. Specifically, use the immune priming mechanism (DC/T-cell interaction) and metabolic pathways (SCFAs) as mechanistic explanations.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::9924c763c7eea16cf0d406df8db15a91588013ba42261e239e8e36a8d07b5894",
      "multiple_values_in_field": true
    },
    "atom::da26e18af85bf89faa5e6892": {
      "atom_id": "atom::da26e18af85bf89faa5e6892",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review provides a structured framework for linking gut microbiome features to ICI efficacy in solid tumors (melanoma, lung, breast, prostate). It offers specific mechanistic hypotheses (immune priming, metabolic modulation) and identifies key microbial taxa (Akkermansia, Bifidobacterium) and interventions (FMT, antibiotics avoidance) that are directly relevant to the user's facets on ICI modulation and underlying mechanisms.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::4087798d8d234df5bbf502582cdba26baa97dcd8d51a49eb10625cbafd976888",
      "multiple_values_in_field": false
    },
    "atom::46e130e66b6357be2b87ea04": {
      "atom_id": "atom::46e130e66b6357be2b87ea04",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review covers multiple cancer types; findings in melanoma/lung may not apply to other solid tumors without verification.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::627ef3163700c5a942869f17e8109187b5526b9b9983d8b6de307b50584fb230",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::308c86324c48b16b1528393b6689ffe64845186780b3c52d785185565ed9a323",
      "multiple_values_in_field": true
    },
    "atom::cc5c4f37818ed015bd0a29c5": {
      "atom_id": "atom::cc5c4f37818ed015bd0a29c5",
      "source_handle": "P0118",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Mechanisms described often rely on murine models; direct translation to human physiology should be cautious.",
      "role": "evidence",
