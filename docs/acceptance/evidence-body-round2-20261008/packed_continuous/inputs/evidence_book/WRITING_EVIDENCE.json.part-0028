        "possible_uses"
      ],
      "value": "直接用于回答“介导机制是什么”的问题，提供分子和细胞层面的解释，帮助理解微生物如何通过免疫途径增强或抑制治疗效果。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5e13905ef3e05c75c21b6b569212dfd0abe08f94dcd145fe5e8148acfee6c689",
      "multiple_values_in_field": true
    },
    "atom::1e95336552e6ea2b93258cbf": {
      "atom_id": "atom::1e95336552e6ea2b93258cbf",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "临床数据主要来自小规模试验或单臂研究，缺乏大规模随机对照试验的支持；干预方案（如菌株选择、剂量、给药时机）尚未标准化。",
        "contribution": "评估了FMT、益生菌和细菌联合体作为ICI辅助治疗的临床前和早期临床证据。例如，提到FMT在难治性黑色素瘤患者中的成功案例，以及特定益生菌（如Bifidobacterium EDP150）在结直肠癌患者中的安全性及初步疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::435392314f70929ab64f039299888c178ae5663a8a4a92405dc92e6a48de1edd",
      "multiple_values_in_field": true
    },
    "atom::57d23b367f431e7c93e2250e": {
      "atom_id": "atom::57d23b367f431e7c93e2250e",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于探讨微生物群干预策略的有效性和可行性，为“如何通过调节微生物群改善ICI疗效”提供实践参考。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5e13905ef3e05c75c21b6b569212dfd0abe08f94dcd145fe5e8148acfee6c689",
      "multiple_values_in_field": true
    },
    "atom::4c5612a870ef5967caf52a73": {
      "atom_id": "atom::4c5612a870ef5967caf52a73",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物群如何调节实体瘤免疫治疗疗效提供了详细的机制分类和证据汇总。它特别适用于回答“微生物群如何调节ICI疗效”及其“介导机制”的问题，通过列举具体的细菌类群、代谢物和免疫通路，为构建微生物-免疫互作的综合图景提供了丰富的素材。同时，它也提供了关于干预策略（FMT、益生菌）的现状评估及领域局限性的背景信息。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::2c71d32fd84914ff345e0f7ba2358e0e55fc3b8ce9cc328539695242095e473c",
      "multiple_values_in_field": false
    },
    "atom::fde037723789ef84dfca69a9": {
      "atom_id": "atom::fde037723789ef84dfca69a9",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述涵盖多种实体瘤，不同癌症类型的微生物-免疫互作可能存在特异性，应用时需考虑癌症类型的情境依赖性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::788c6163f811d2b4e77e74389fb79ce0c0b176b4e99a2a17796d6f54cb4c734a",
      "multiple_values_in_field": true
