      "variant_group": "field::f47ecec131e9d9ed120dd0c49eecc5751e018fdfb775dbb793cc3d0fe5ca2f85",
      "multiple_values_in_field": false
    },
    "atom::91b300a3e1ba3689b33d58da": {
      "atom_id": "atom::91b300a3e1ba3689b33d58da",
      "source_handle": "P0188",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "既往研究多聚焦于肠道细菌，而肠道真菌在ICIs疗效中的作用尚不明确。本研究试图回答：哪些特定的肠道真菌物种或群落结构与ICIs疗效相关？真菌与细菌的相互作用如何影响治疗反应？是否存在可验证的因果机制？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::d49372cb1421975d9b6ca8a53c336fbed42b5c89868318fbd4ecdc76e71ab6e8",
      "multiple_values_in_field": false
    },
    "atom::dd3300c47724462669710375": {
      "atom_id": "atom::dd3300c47724462669710375",
      "source_handle": "P0188",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "研究对象为接受免疫检查点抑制剂（ICIs）治疗的黑色素瘤、非小细胞肺癌（NSCLC）和肾细胞癌（RCC）患者。研究范围涵盖8个队列的976例粪便宏基因组数据，以及小鼠体内验证实验。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::9a980e22977c6f83c9c242156b22d72bbde1085403a7f14c1a99bd625275762d",
      "multiple_values_in_field": false
    },
    "atom::ffdff79183e93c3c12d9a635": {
      "atom_id": "atom::ffdff79183e93c3c12d9a635",
      "source_handle": "P0188",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在探究肠道真菌对ICIs疗效的影响。通过整合8个队列的宏基因组测序数据，识别与ICI疗效相关的真菌标志物及真菌肠型。研究发现特定真菌丰度与疗效相关，且响应者中细菌-真菌互作更强。进一步通过小鼠模型验证了Debaryomyces hansenii通过减少CD8+ T细胞浸润降低PD-1单抗疗效的机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::1b7e547ffdc301425539ccf53b2415065bc6be7fd7c2fe721f01f0cbe1dd3b77",
      "multiple_values_in_field": false
    },
    "atom::2bfbefec9e86e3caebce5297": {
      "atom_id": "atom::2bfbefec9e86e3caebce5297",
      "source_handle": "P0188",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "研究采用了标准化的真菌注释流程（Kraken2 + Bracken + 自定义数据库），并使用了MMUPHin进行批次校正。同时，作者坦诚了低测序深度、缺乏阴性对照、地理局限性等不足。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::04be87fe99a135a3e7c71ac27b4651338690b7f49d456bfeedbef5d40638352e",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::0144a7c3738b644691513554420cf14fc16060dbbda20f1140c22b931b0b30a2",
      "multiple_values_in_field": true
    },
