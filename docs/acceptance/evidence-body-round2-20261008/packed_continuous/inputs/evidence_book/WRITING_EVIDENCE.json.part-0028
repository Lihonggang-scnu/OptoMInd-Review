        }
      ],
      "variant_group": "field::04ab20b7375f5584ebeaea85330e19a35aa9a35045145b3c833c5f037094ab7e",
      "multiple_values_in_field": true
    },
    "atom::6158f99746252e98c84b88fd": {
      "atom_id": "atom::6158f99746252e98c84b88fd",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "单变量分析",
        "finding": "维生素K（HR 0.62, p=0.03）和脂肪（HR 0.65, p=0.04）摄入与改善的PFS相关；淀粉（HR 1.61, p=0.03）、碳水化合物（HR 1.56, p=0.04）、蔗糖（HR 1.62, p=0.03）和铁（HR 1.7, p=0.016）摄入与较差的PFS相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::04ab20b7375f5584ebeaea85330e19a35aa9a35045145b3c833c5f037094ab7e",
      "multiple_values_in_field": true
    },
    "atom::5e5f3d0f18e0b09eb09cb0dd": {
      "atom_id": "atom::5e5f3d0f18e0b09eb09cb0dd",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多变量分析（调整BMI）",
        "finding": "维生素K摄入仍显著关联于改善的PFS（HR 0.60, 95% CI 0.37-0.97, p=0.04）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::04ab20b7375f5584ebeaea85330e19a35aa9a35045145b3c833c5f037094ab7e",
      "multiple_values_in_field": true
    },
    "atom::49ab0295266eb7f29575d84a": {
      "atom_id": "atom::49ab0295266eb7f29575d84a",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "饮食模式比较",
        "finding": "基于脂肪的饮食（如类生酮饮食：高脂、低淀粉）在单变量（HR 0.47, p=0.008）和多变量分析（HR 0.37, 95% CI 0.2-0.68, p=0.001）中均与改善的PFS相关。相比之下，西方饮食（高脂、高淀粉）相比高淀粉饮食，与任何等级irAEs风险增加相关（54% vs 24%, p=0.01）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::04ab20b7375f5584ebeaea85330e19a35aa9a35045145b3c833c5f037094ab7e",
      "multiple_values_in_field": true
    },
    "atom::f9302bfbb1fb7e1d4e0c6f2c": {
      "atom_id": "atom::f9302bfbb1fb7e1d4e0c6f2c",
      "source_handle": "P0155",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物组关联（N=69）",
        "finding": "基于脂肪的饮食与有益共生菌（如Ruminococcus lactaris, Butyricimonas faecihominis, Lachnospiraceae spp）的富集相关，低脂饮食与有害菌Veillonella atypica相关。基于淀粉的饮食与高Prevotella spp相关。富含蔗糖的饮食与已知发酵蔗糖的Candidatus saccharibacteria富集相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6f413ed171ed03a1aa9c2e1eb8bc1288e2d51b48614adffc60767f858eeafc0c",
