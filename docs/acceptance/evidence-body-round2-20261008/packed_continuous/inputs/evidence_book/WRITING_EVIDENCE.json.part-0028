    "atom::a8b8014af7324221217aeb00": {
      "atom_id": "atom::a8b8014af7324221217aeb00",
      "source_handle": "P0390",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠模型，低纤维饮食或益生菌补充 + 抗PD-1治疗",
