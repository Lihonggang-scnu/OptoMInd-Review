          "record_id": "record::78c448ac93100acb4520a4dd81d48cb27a8ebf389c89735e86e1deb8cb00c046",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::3d4b21255facf10cc5707187e3b8e5119668b0683f8aef1c4e6c3c342821f84b",
      "multiple_values_in_field": true
    },
    "atom::4b0cfd8bded0f61458f40655": {
      "atom_id": "atom::4b0cfd8bded0f61458f40655",
      "source_handle": "P0215",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Provides context for mechanistic hypotheses. Can be used to illustrate proposed pathways (e.g., SCFA production, immune activation) that require further investigation.",
      "role": "planning",
