    "atom::64d60c81f3170ce140d46869": {
      "atom_id": "atom::64d60c81f3170ce140d46869",
      "source_handle": "P0286",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "提出了iDDIs区别于传统PK/PD DDIs的概念，强调其系统性、时间动态性和情境依赖性。讨论了AI技术在处理高维、非结构化临床数据中的潜在作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a191b990962ed40dd3ae9df09476c9d7fcfa71eab67bda617ebf6a9633ab60fa",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::e5b0b19a80347c8afc6680e22c9d000d608b9d7304da4ce90b0eafb918db39ad",
      "multiple_values_in_field": true
    },
    "atom::b955aa4443834d471ff6da67": {
      "atom_id": "atom::b955aa4443834d471ff6da67",
      "source_handle": "P0286",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "为综述提供iDDIs的理论背景和方法学挑战的讨论素材，特别是在讨论如何整合多模态数据或应对混杂因素时。",
      "role": "planning",
