      "atom_id": "atom::247e6fd8346fe68e0539c605",
      "source_handle": "P0286",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "AI部分内容为技术综述，不代表已验证的临床工具，其实际效用尚不确定。",
