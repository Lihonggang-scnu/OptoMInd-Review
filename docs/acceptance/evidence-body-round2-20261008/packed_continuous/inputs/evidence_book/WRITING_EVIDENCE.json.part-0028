    "atom::a09db3099a0ed3c2db818982": {
      "atom_id": "atom::a09db3099a0ed3c2db818982",
      "source_handle": "P0224",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "A scoping review methodology was used to select and synthesize preclinical and human studies. Studies were included if they assessed sleep/circadian disruption, gut microbiome outcomes, and at least one functional biomarker (hormones, metabolites, neurotransmitters, or inflammation). Data were stratified by sample type (plasma/serum, GI tissue, brain tissue, etc.) and categorized using hierarchical databases (HMDB, KEGG, LIPID MAPS). Results were grouped by intervention type (sleep disruption vs. circadian disruption) and biomarker class to identify convergent functional signatures.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65d1d201a18946b88612ec88989dcf0cf75c17f3f27fd250b4782daff97ca912",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::fbeb980e80a855e451e2301c57d7759e53d8f2c6484deffb8687183d8f272830",
      "multiple_values_in_field": false
    },
    "atom::6efa165bc403cf644757409c": {
      "atom_id": "atom::6efa165bc403cf644757409c",
      "source_handle": "P0224",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive synthesis of functional biomarker responses to sleep/circadian disruption across multiple biological compartments, highlighting convergent metabolic and inflammatory signatures despite taxonomic variability.",
        "limits": "Most included studies are observational or cross-sectional, limiting causal inference. Human data are sparse and heterogeneous. The review does not establish direct causal mediation by specific taxa but rather associations. Specific mechanisms like kynurenine pathway metabolites were noted as under-measured in current literature."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65d1d201a18946b88612ec88989dcf0cf75c17f3f27fd250b4782daff97ca912",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::7122ecc168a98725c579e94b41fab1ba5eceefa764c082156249d9a409e012e5",
      "multiple_values_in_field": false
    },
    "atom::24245b407bd3aba75316f923": {
      "atom_id": "atom::24245b407bd3aba75316f923",
      "source_handle": "P0224",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Preclinical sleep disruption",
        "finding": "Increased HPA axis activity (CRH, ACTH, cortisol/corticosterone); decreased GABA, serotonin, melatonin; increased pro-inflammatory cytokines (IL-1β, IL-6, TNF-α); decreased fecal SCFAs; downregulated amino acid and lipid metabolism; upregulated glycolysis/TCA cycle."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65d1d201a18946b88612ec88989dcf0cf75c17f3f27fd250b4782daff97ca912",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::30460f6928753c66a70d9a1209932b7073bdd02824487a7ef02e2b769b0d46e3",
      "multiple_values_in_field": true
    },
    "atom::62821807859d589c0cfd01fc": {
      "atom_id": "atom::62821807859d589c0cfd01fc",
      "source_handle": "P0224",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Preclinical circadian disruption",
        "finding": "Increased primary bile acids and decreased secondary bile acids; increased LPS biosynthesis and bacterial virulence pathways; localized GI inflammation (IL-1β, TNF-α, IL-17)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::65d1d201a18946b88612ec88989dcf0cf75c17f3f27fd250b4782daff97ca912",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::30460f6928753c66a70d9a1209932b7073bdd02824487a7ef02e2b769b0d46e3",
      "multiple_values_in_field": true
    },
    "atom::f0a28ca289149b2b1d3e0889": {
      "atom_id": "atom::f0a28ca289149b2b1d3e0889",
      "source_handle": "P0224",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Human studies",
        "finding": "Limited data; generally paralleled preclinical inflammatory responses (increased IL-1β, IL-6, TNF-α, LPS); decreased fecal SCFAs associated with poor sleep quality/short duration; conflicting cortisol responses compared to rodents."
      },
      "role": "evidence",
      "origins": [
