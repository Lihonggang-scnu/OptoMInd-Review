        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "挑战‘益生菌总是有益’的常识，提示在免疫治疗期间，某些商业益生菌产品可能干扰内源性微生物组的有益作用或竞争定植位点，需区分益生元（纤维）与益生菌的不同影响。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::cd4bd19193b9b492311379f8d50d16916f9b53fd38c3501cf1dbc484ebc8a2cf",
