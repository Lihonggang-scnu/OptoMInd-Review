    "atom::d30359c2b25a882bf29e259a": {
      "atom_id": "atom::d30359c2b25a882bf29e259a",
      "source_handle": "P0430",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多种实体瘤接受ICI治疗",
        "finding": "某些拟杆菌属（Bacteroides spp.）成员在非响应者中更常见，可能与外周Treg和髓源性抑制细胞（MDSCs）频率增加及细胞因子反应减弱有关；但部分菌株（如B. fragilis）在特定背景下可能具有免疫刺激作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::1a8b7c8060752379794dadedd642ffdd9c02e8f1e95960cab1fce07786e17a96",
      "multiple_values_in_field": true
    },
    "atom::2ad9b803ec5c4bc35b3d770b": {
      "atom_id": "atom::2ad9b803ec5c4bc35b3d770b",
      "source_handle": "P0430",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "临床前模型及部分临床试验",
        "finding": "粪菌移植（FMT）从ICI响应者到非响应者患者可恢复对PD-1阻断剂的敏感性；特定益生菌（如Bifidobacterium, Lactobacillus）在动物模型中能增强ICI疗效，但在人体中的确切疗效仍需更多前瞻性验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::1a8b7c8060752379794dadedd642ffdd9c02e8f1e95960cab1fce07786e17a96",
      "multiple_values_in_field": true
    },
    "atom::7f131b5541af68e27d52a5a2": {
      "atom_id": "atom::7f131b5541af68e27d52a5a2",
      "source_handle": "P0430",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同研究队列和分析方法",
        "finding": "微生物群组成与ICI疗效的关联存在显著异质性，受地理、饮食、抗生素使用、测序技术及数据分析流程的影响，导致关键生物标志物的检测缺乏一致性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
            "study_summary_A",
