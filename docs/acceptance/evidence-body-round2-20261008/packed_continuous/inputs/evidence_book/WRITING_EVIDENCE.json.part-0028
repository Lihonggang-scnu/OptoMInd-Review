    "atom::5f72ca9ad048afe65f359240": {
      "atom_id": "atom::5f72ca9ad048afe65f359240",
      "source_handle": "P0224",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review emphasizes association over causation; do not present these findings as proven causal drivers of ICI outcomes.",
      "role": "evidence",
