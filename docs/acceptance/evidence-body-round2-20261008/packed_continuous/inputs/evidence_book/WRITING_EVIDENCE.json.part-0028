    "atom::9271c4554f8af19913c42362": {
      "atom_id": "atom::9271c4554f8af19913c42362",
      "source_handle": "P0430",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节主要基于动物模型或体外实验，在人体中的验证程度不一；部分机制（如AhR激活）的具体配体和后果仍存在争议。",
        "contribution": "阐述了微生物群影响ICI疗效的具体机制，包括：1) 通过TLR/NLR受体激活先天免疫；2) 产生代谢产物（如SCFAs、肌苷）调节T细胞功能和肿瘤微环境；3) 调节Treg和效应T细胞的平衡；4) 促进趋化因子分泌以招募T细胞至肿瘤部位。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5dca8d9e29d732c182092886c1b07ec27a6c8c5d0b287863996ebc896002d3c9",
          "field_path": [
