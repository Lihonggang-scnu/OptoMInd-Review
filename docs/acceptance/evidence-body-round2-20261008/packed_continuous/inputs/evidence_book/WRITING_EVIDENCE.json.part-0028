    "atom::1e929cb317710158399babe5": {
      "atom_id": "atom::1e929cb317710158399babe5",
      "source_handle": "P0188",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物互作分析",
        "finding": "黑色素瘤响应者中细菌-真菌互作网络更复杂且正相关性更强；NSCLC中趋势相反，可能受样本量和测序深度影响。"
      },
