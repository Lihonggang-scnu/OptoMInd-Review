        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于综述中讨论饮食作为免疫治疗辅助因素的实证案例，特别是支持‘有益饮食模式’的观点。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::cd4bd19193b9b492311379f8d50d16916f9b53fd38c3501cf1dbc484ebc8a2cf",
          "field_path": [
            "review_planning_B",
