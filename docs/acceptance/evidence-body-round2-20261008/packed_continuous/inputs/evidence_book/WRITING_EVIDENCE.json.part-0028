        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\bba4d44f2619609e877d370b4051f1127ed24a5d\\3017dbe0b2027bcdb6d0bebb20ddfece\\attempt-01\\PAPER_READING_CARD.json"
