    "atom::31f6db31aa0dc90df5e47c1c": {
      "atom_id": "atom::31f6db31aa0dc90df5e47c1c",
      "source_handle": "P0579",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI 治疗后肿瘤微环境分析",
        "finding": "ICI 治疗未增加肿瘤内效应 T 细胞浸润，反而降低了 CD3+、CD8+ T 细胞和 B 细胞密度，同时增加了 CD68+ 髓系细胞密度；试图用 anti-Gr-1 耗竭髓系细胞失败。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
