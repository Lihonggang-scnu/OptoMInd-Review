    "atom::ea2710a6f2ba44ba33b20f81": {
      "atom_id": "atom::ea2710a6f2ba44ba33b20f81",
      "source_handle": "P0581",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用回顾性队列设计，利用已完成的II期随机对照试验（CO.26）的生物样本库数据。将患者按基线血清Artemin中位数（1.051 ng/ml）分为高、低两组。使用Kaplan-Meier法估算生存曲线，Log-rank检验比较组间差异，Cox比例风险模型评估Artemin对PFS和OS的预后及预测价值，并计算多变量交互作用p值以评估预测效应。同时监测治疗第8周及进展时的Artemin动态变化。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::e0ccb28407450dcd4408ab7da8e083d07b626abb1788e24a37d3199babe5d8c4",
      "multiple_values_in_field": false
    },
    "atom::bc0eaf38380a92d7ce81fe76": {
      "atom_id": "atom::bc0eaf38380a92d7ce81fe76",
      "source_handle": "P0581",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了Artemin作为MSS mCRC患者ICI治疗潜在预测生物标志物的临床证据，特别是高基线水平可能指示从双免疫治疗中获益。",
        "limits": "研究为事后分析（post-hoc），样本量相对较小（N=161），交互作用p值（0.061）未达到传统显著性阈值，结论需谨慎解读。未直接涉及肠道微生物组机制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::13911cde313c942eb9fec59efecb1af1f6975bfb1ea392197593e7e58bf584bf",
      "multiple_values_in_field": false
    },
    "atom::c9293a222f96cddd2d673b66": {
      "atom_id": "atom::c9293a222f96cddd2d673b66",
      "source_handle": "P0581",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "BSC组，基线高Artemin vs 低Artemin",
        "finding": "高Artemin组OS较短（3.17个月 vs 5.65个月），HR 1.74 (95% CI 0.94-3.25, p=0.080)，提示其为不良预后标志物，但未达到统计学显著性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::764d25578fd45b963bb0508122e06acc850066d5a1f0e11d4887cdb167d9ed6d",
      "multiple_values_in_field": true
    },
    "atom::38f0a59cb9fe01727456a3f7": {
      "atom_id": "atom::38f0a59cb9fe01727456a3f7",
      "source_handle": "P0581",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "D+T组 vs BSC组，基线高Artemin亚群",
        "finding": "在高Artemin患者中，D+T显著改善OS（6.44个月 vs 3.17个月），HR 0.54 (95% CI 0.33-0.91, p=0.020)。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244",
          "field_path": [
