            "2"
          ]
        }
      ],
      "variant_group": "field::ad98301dcab1fd048e17002e3c8ac3d548c95a285dc194b83a6f8ad08bb5361a",
      "multiple_values_in_field": true
    },
    "atom::0b38b8d7b54d9b9a10638b0b": {
      "atom_id": "atom::0b38b8d7b54d9b9a10638b0b",
      "source_handle": "P0220",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
