      "multiple_values_in_field": true
    },
    "atom::a32b0f50b916d531152549a1": {
      "atom_id": "atom::a32b0f50b916d531152549a1",
      "source_handle": "P0377",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
