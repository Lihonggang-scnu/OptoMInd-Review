      "variant_group": "field::54487e21a69d6975c9f9c2f24ec07a68402ba0735a829469b5467055e43cf89d",
      "multiple_values_in_field": true
    },
    "atom::cc0bd417229ac67f8358b8ee": {
      "atom_id": "atom::cc0bd417229ac67f8358b8ee",
      "source_handle": "P0593",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制仅限于别嘌醇-肌苷轴，不能推广为所有ICI增效剂的通用机制。人类证据仅为相关性，因果链条在人体中尚待确证。",
        "contribution": "详细阐述了别嘌醇增强ICI疗效的具体分子机制：抑制XDH -> 增加肌苷 -> 上调MHC I/PD-L1 -> 增强T细胞杀伤。同时指出MDSCs减少是响应性TME的标志。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::253f9e6877830f43e32548d1663b5d3343f4b8c35ed536798a8e99b0b962a5b6",
