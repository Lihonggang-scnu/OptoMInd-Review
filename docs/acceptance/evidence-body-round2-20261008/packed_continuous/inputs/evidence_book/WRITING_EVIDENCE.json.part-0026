    "atom::a8bf25585c4571d85531e094": {
      "atom_id": "atom::a8bf25585c4571d85531e094",
      "source_handle": "P0220",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这部分内容主要针对化疗，与ICI的直接关联较弱，除非综述主题包含广义的癌症治疗反应。",
        "contribution": "提供了关于微生物代谢物影响化疗药物疗效和毒性的背景信息，特别是伊立替康和吉西他滨的代谢机制。指出微生物酶（如β-葡萄糖醛酸酶、胞苷脱氨酶）可激活或失活化疗药物，导致耐药性或严重副作用。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c74ceafaf0f44d4428d1f44c9834e5d308c0933c5efca4ee53b7106017abb26b",
          "field_path": [
