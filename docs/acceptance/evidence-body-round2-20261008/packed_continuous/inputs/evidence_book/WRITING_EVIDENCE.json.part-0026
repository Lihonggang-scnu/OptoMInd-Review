    "atom::3807d2041e40006087ff9fae": {
      "atom_id": "atom::3807d2041e40006087ff9fae",
      "source_handle": "P0588",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于探讨除了传统的PD-L1表达或TMB之外，全身炎症状态和生活方式因素是否影响肠道代谢物介导的免疫治疗响应。提示未来研究可能需要结合宿主生理状态来优化代谢物疗法。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::93c6a2bc5ca1c43be2fd189fb473aa761e120adadfbb9d47d57314ce2ef6769a",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::7a1565c123dfbaa2ddac4501cc12b723a883c91c338a3ed82c7f61b99a30e026",
      "multiple_values_in_field": true
    },
    "atom::330b20611a2b60f0bfb9cb57": {
      "atom_id": "atom::330b20611a2b60f0bfb9cb57",
      "source_handle": "P0588",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "本文是II期单中心研究，样本量较小，OS结果不显著可能受随访时间不足或后续治疗干扰，解读时需谨慎，避免过度推断长期生存获益。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::93c6a2bc5ca1c43be2fd189fb473aa761e120adadfbb9d47d57314ce2ef6769a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::14bf13f5109922fab584e4448a16236895310fa733dd9b3998d48782004f03cb",
      "multiple_values_in_field": true
    },
    "atom::d7b8f615eb29b4d96eed30ee": {
      "atom_id": "atom::d7b8f615eb29b4d96eed30ee",
      "source_handle": "P0588",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "亚组分析多为探索性且未预设校正，显著性结果可能存在假阳性风险，应视为假设生成而非确证。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::93c6a2bc5ca1c43be2fd189fb473aa761e120adadfbb9d47d57314ce2ef6769a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
