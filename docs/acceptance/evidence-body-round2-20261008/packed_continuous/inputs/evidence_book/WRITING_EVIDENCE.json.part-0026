    "atom::f6db37f0d699f01596d921ed": {
      "atom_id": "atom::f6db37f0d699f01596d921ed",
      "source_handle": "P0581",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "在讨论“机制”部分时，可列举多种微环境细胞类型（如MDSCs, Tregs, EPCs等）及其分泌因子，说明肿瘤微环境的多元调控网络，避免将机制单一化归因于微生物组。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244",
