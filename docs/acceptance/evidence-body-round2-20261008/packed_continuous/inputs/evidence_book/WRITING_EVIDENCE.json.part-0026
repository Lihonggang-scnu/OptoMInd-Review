      "multiple_values_in_field": true
    },
    "atom::f645e1b6ccc9d462148f398b": {
      "atom_id": "atom::f645e1b6ccc9d462148f398b",
      "source_handle": "P0581",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "D+T组 vs BSC组，基线低Artemin亚群",
        "finding": "在低Artemin患者中，D+T未显示OS优势（6.64个月 vs 5.65个月），HR 0.87 (95% CI 0.53-1.43, p=0.58)。多变量交互作用p值为0.061，提示预测趋势但不确证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244",
