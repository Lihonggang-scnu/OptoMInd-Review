    "atom::d6f2c080372a18438124a4d3": {
      "atom_id": "atom::d6f2c080372a18438124a4d3",
      "source_handle": "P0582",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "UBA6作为靶点的普适性需在不同肿瘤类型中进一步验证；目前证据显示其效果依赖于肿瘤细胞的基础UBA6表达水平。",
        "contribution": "证明了UBA6是肿瘤内在的免疫检查点，其高表达导致免疫抑制性微环境和ICB耐药，而UBA6缺失或抑制可逆转这一过程。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
