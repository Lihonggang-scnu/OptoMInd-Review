    "atom::4f486a10e036032c79861cfc": {
      "atom_id": "atom::4f486a10e036032c79861cfc",
      "source_handle": "P0593",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Allopurinol (AP) 联合抗PD-1治疗",
        "finding": "AP通过抑制黄嘌呤脱氢酶（XDH）增加肌苷合成并分泌至胞外，肌苷上调肿瘤细胞MHC I类和PD-L1表达，增强CD8+ T细胞介导的细胞毒性。在CT26模型中，AP联合抗PD-1实现4/6小鼠完全治愈。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::253f9e6877830f43e32548d1663b5d3343f4b8c35ed536798a8e99b0b962a5b6",
