    "atom::d946a8943fc577a27de79421": {
      "atom_id": "atom::d946a8943fc577a27de79421",
      "source_handle": "P0586",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "如何解决AML等实体/血液肿瘤中因免疫抑制性微环境（特别是高浓度腺苷和低水平刺激性细胞因子）限制细胞免疫疗法疗效的问题？具体而言，如何在不引起全身毒性的前提下，同时提供免疫刺激信号并清除免疫抑制代谢物？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::557c827faf2f9d5a37b6275d7da24a01457a7734e931bf8ff59bf8fa00b96b12",
      "multiple_values_in_field": false
    },
    "atom::4b4b3aa2a2b8c1d62a34a1ba": {
      "atom_id": "atom::4b4b3aa2a2b8c1d62a34a1ba",
      "source_handle": "P0586",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "急性髓系白血病（AML）及黑色素瘤（B16-F10模型）的肿瘤微环境（TME），研究对象为工程化非致病性大肠杆菌（E. coli K12 DH5α），重点考察其对自然杀伤细胞（NK细胞）免疫功能的调节作用。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::fdb09284ff2656404ad6d7527e6069658dabf3ee50fd0bd68c1420f4da50903c",
      "multiple_values_in_field": false
    },
    "atom::c62be582e3a78a5a5752aadc": {
      "atom_id": "atom::c62be582e3a78a5a5752aadc",
      "source_handle": "P0586",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "该研究针对AML中因免疫抑制性代谢物（如腺苷）积累和刺激性细胞因子缺乏导致的免疫治疗失效问题，开发了一种双功能工程化细菌平台。通过在大肠杆菌表面共展示IL-12细胞因子和腺苷脱氨酶（ADA），旨在实现局部细胞因子递送与代谢重编程。体外实验证实，该策略能显著增强NK细胞的活化标志物表达及针对AML细胞的细胞毒性，并在高腺苷环境下维持免疫功能。体内实验显示，静脉注射该工程菌可在骨髓中特异性聚集，显著延长AML小鼠模型的生存期，并在黑色素瘤模型中诱导完全缓解及持久的免疫记忆。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::00067a8886447fdf3460c2d049b7342a6d929bb8392fbd7af871aa764a69f555",
      "multiple_values_in_field": false
    },
    "atom::b89d6a4816a61495b5c6062c": {
      "atom_id": "atom::b89d6a4816a61495b5c6062c",
