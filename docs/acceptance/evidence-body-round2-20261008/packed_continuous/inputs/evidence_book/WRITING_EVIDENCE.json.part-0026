    "atom::dd76543604f649c7803fe6e2": {
      "atom_id": "atom::dd76543604f649c7803fe6e2",
      "source_handle": "P0220",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于解释为何同一微生物组特征在不同患者或不同癌症类型中可能产生截然不同的治疗效果，避免简单化的因果推断。",
      "role": "planning",
      "origins": [
        {
