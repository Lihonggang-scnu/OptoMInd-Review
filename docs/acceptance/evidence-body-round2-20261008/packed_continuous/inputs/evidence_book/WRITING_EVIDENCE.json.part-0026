      "multiple_values_in_field": true
    },
    "atom::74c5b2e8f9ad9092d0a7de55": {
      "atom_id": "atom::74c5b2e8f9ad9092d0a7de55",
      "source_handle": "P0589",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "支持综述中关于使用更贴近人类的模型（如PDX而非原位鼠瘤）来研究微生物-宿主-药物相互作用的重要性。如果后续文献使用类似模型研究微生物对ICI的影响，本文可为该模型系统的合理性提供支持。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1fb52b3621e1fe1f515eb59106e26772ff4abbab4d4d6339018f2e44cd8c5270",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::6dcc9412e37f9789e67900040e355c6be43ffeb22c541549df2fa7c86e731960",
      "multiple_values_in_field": true
    },
    "atom::2a6ddd4d8328a67567c817ce": {
      "atom_id": "atom::2a6ddd4d8328a67567c817ce",
      "source_handle": "P0589",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "本研究未涉及肠道微生物群，也未测试免疫检查点抑制剂（ICI）。它仅建立了监测代谢物的能力，未解释微生物如何通过代谢影响ICI疗效。",
        "contribution": "提供了使用PDX模型结合微透析技术监测实体瘤局部代谢变化的方法学参考。",
        "facet_id": "F1"
      },
      "role": "evidence",
