          "record_id": "record::4f1fac3cb1126bd412aa5f23d6fa9f53374fe76c4899ab6c911fa5ffaed6b231",
          "field_path": [
            "supplement_material"
          ]
        }
      ],
      "variant_group": "field::df4dcf97d33e84dd4528b5b89691209c3ff089e3152bc0821b136db06e6a158b",
      "multiple_values_in_field": false
    },
