    "atom::bc6b57f494bd389836ec9257": {
      "atom_id": "atom::bc6b57f494bd389836ec9257",
      "source_handle": "P0582",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "肌苷的来源具有多源性（肠道微生物、饮食、癌细胞自身），本论文侧重于其作为循环代谢物对肿瘤细胞的直接作用，解读时需区分其与肠道微生物群的间接联系与直接靶向关系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::21192accde617a8baebf596b0accc1b99c136b6ad9e174934c65f008343ffa43",
      "multiple_values_in_field": true
    },
    "atom::8c03a2c7f2fcb1164d5f8077": {
      "atom_id": "atom::8c03a2c7f2fcb1164d5f8077",
      "source_handle": "P0582",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "UBA6的作用具有肿瘤类型特异性，不能将其在所有实体瘤中的功能外推至所有情况，需注意不同肿瘤细胞系中UBA6基础表达水平的差异对治疗效果的决定性影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::21192accde617a8baebf596b0accc1b99c136b6ad9e174934c65f008343ffa43",
      "multiple_values_in_field": true
    },
    "atom::c72d9b498e6ac469eba1251b": {
      "atom_id": "atom::c72d9b498e6ac469eba1251b",
      "source_handle": "P0582",
      "field_path": [
