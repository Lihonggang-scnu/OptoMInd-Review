            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::550caa86ae9aa0cb750962731d2c086e53307ed4cebdee4488ca11ddb9d9d2db",
      "multiple_values_in_field": true
    },
    "atom::a679a962836c5f69d11b9d73": {
      "atom_id": "atom::a679a962836c5f69d11b9d73",
      "source_handle": "P0592",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "帮助读者理解为什么某些实体瘤对ICI无响应，以及除了微生物之外，还有哪些微环境因素需要被考虑或靶向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::81a463e17c47335f75f1bad1e3dfd53a26