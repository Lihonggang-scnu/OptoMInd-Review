    },
    "atom::22e1bcf7c11fd480b7798b6e": {
      "atom_id": "atom::22e1bcf7c11fd480b7798b6e",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "LAG-3, TIM-3, TIGIT, B7-H3 配体在 ccRCC 中的高表达及其与 PD-1/CTLA-4 的低表达对比。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1"
          ]
        }
      ],
      "variant_group": "field::fb9f1a2f703344d8dcb048209ae02c31d2324cff6a64b824e82c2c3f15fabe9d",
      "multiple_values_in_field": true
    },
    "atom::ddb1db5dbd3731c81547cf47": {
      "atom_id": "atom::ddb1db5dbd3731c81547cf47",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "提供潜在的联合治疗靶点列表，用于讨论未来 ICI 联合疗法的策略方向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::b22682505ff8cda1576c2780c0840c4ab3fe1f94a2b5a8028f53098345c8b248",
      "multiple_values_in_field": true
    },
    "atom::3c2f7ef425b5580f83e1be16": {
      "atom_id": "atom::3c2f7ef425b5580f83e1be16",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于建议“双特异性抗体”或“多靶点联合疗法”的合理性，特别是在那些 PD-1/CTLA-4 通路贡献较小的肿瘤类型中。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::366d68f3d6f640f40696927345d465eaa4b1e36c63c75ba81d673da6017611f9",
      "multiple_values_in_field": true
    },
    "atom::403087c31fccfa7efe0183d7": {
      "atom_id": "atom::403087c31fccfa7efe0183d7",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该研究未涉及肠道菌群，因此不能直接回答 F1 的核心问题，仅能提供关于肿瘤局部免疫抑制的背景信息。",
        "contribution": "提供了 ccRCC 对标准 ICI 疗法原发性耐药的体内证据，并指出这种耐药并非由于缺乏 T 细胞浸润或激活潜力，而是由于微环境抑制。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::5e0fb6de08e15b74e11228971ba115a4a17d29c15cebd14f3e7afdcc827cb986",
      "multiple_values_in_field": true
    },
    "atom::99a3d58b932b5563ea1a28e2": {
      "atom_id": "atom::99a3d58b932b5563ea1a28e2",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道菌群如何调节 ICI 疗效”之外的背景问题，即“哪些宿主内在因素（如肿瘤微环境组成）决定了 ICI 在固体瘤中的疗效差异”。可作为对比案例，说明即使在没有肠道菌群干预的情况下，肿瘤 intrinsic 特性也可导致耐药。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::f2041ff29aa87a9ad6e5fa530e9caf935b4682350b5dcf84f910e76d5dd6838b",
      "multiple_values_in_field": true
    },
    "atom::b3bf82b15ce1a3131865d0e5": {
      "atom_id": "atom::b3bf82b15ce1a3131865d0e5",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些机制是在 ccRCC 背景下发现的，虽然原理可能通用，但具体配体-受体对的丰度在不同瘤种间可能存在差异。需注明这是 ccRCC 特有的高表达模式。",
        "contribution": "详细描述了介导 ICI 耐药的具体分子机制：1) 髓系细胞（PMN-MDSC 和 Mono-macrophage）通过分泌抑制性因子和占据空间抑制 T 细胞；2) 高表达非 PD-1/CTLA-4 的检查点配体（Galectin-3, Galectin-9, HMGB1, PVR, CD276）持续抑制 T 细胞。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::5e0fb6de08e15b74e11228971ba115a4a17d29c15cebd14f3e7afdcc827cb986",
      "multiple_values_in_field": true
    },
    "atom::c12f3954497171315b68f8ac": {
      "atom_id": "atom::c12f3954497171315b68f8ac",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "直接支持 F2 “mediating mechanisms” 的回答。具体可用于阐述“髓系细胞介导的免疫抑制”和“多路检查点冗余机制”。提供了具体的分子名称（Lgals3, Lgals9, Pvr, Cd276）和细胞亚群（Cluster 0, Cluster 2），便于综述中分类讨论不同的抑制途径。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::f2041ff29aa87a9ad6e5fa530e9caf935b4682350b5dcf84f910e76d5dd6838b",
      "multiple_values_in_field": true
    },
    "atom::483cfdac546137e68cf162b7": {
      "atom_id": "atom::483cfdac546137e68cf162b7",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于“免疫检查点抑制剂在实体瘤中耐药机制”的重要反面证据和替代机制素材。它证明了在某些 ccRCC 亚型中，即使存在系统性 T 细胞活化，肿瘤微环境也能通过髓系细胞和非经典检查点配体完全阻断局部效应。这有助于解释为何单纯阻断 PD-1/CTLA-4 不足以治愈所有患者，并为综述中讨论“超越 PD-1/CTLA-4 的新型免疫调节策略”及“髓系细胞在免疫抑制中的作用”提供了具体的分子靶点和细胞类型证据。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::42d38bdcc1b4f9715f22dd8bbf3115603ac94953679934fd19c9cae09f39bb38",
      "multiple_values_in_field": false
    },
    "atom::be5a7c9cbdb5f7fe73af9ef0": {
      "atom_id": "atom::be5a7c9cbdb5f7fe73af9ef0",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究使用的是自发性小鼠模型，其免疫系统和肿瘤演进过程与人类存在种属差异，结论外推至人类需谨慎。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::60c1827aecf81fcf066971cbdd41044a7fc86683f5e1316c8650851bd000dbe2",
      "multiple_values_in_field": true
    },
    "atom::5f81f5ac57953c9a010bd5be": {
      "atom_id": "atom::5f81f5ac57953c9a010bd5be",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "VpR 模型缺乏 RB1 突变（人类 ccRCC 中罕见），因此其免疫特征可能不代表所有 ccRCC 亚型，尤其是那些由其他驱动基因（如 PBRM1, SETD2）突变的病例。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::60c1827aecf81fcf066971cbdd41044a7fc86683f5e1316c8650851bd000dbe2",
      "multiple_values_in_field": true
    },
    "atom::6879dada6936072d180b5b0c": {
      "atom_id": "atom::6879dada6936072d180b5b0c",
      "source_handle": "P0579",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "关于非经典检查点配体的作用是相关性观察，尚未通过功能性阻断实验确证其在体内的因果效力。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
