    },
    "atom::1d9741a6b234cdffcc9ac89a": {
      "atom_id": "atom::1d9741a6b234cdffcc9ac89a",
      "source_handle": "P0591",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "帮助综述确立评估微生物组研究质量的基准：微生物衍生的血液标志物（如SCFAs）目前被视为探索性工具，其临床效用尚未通过严格的预测性验证。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
