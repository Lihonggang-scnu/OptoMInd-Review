    },
    "atom::cac038d23f7533f37b94046c": {
      "atom_id": "atom::cac038d23f7533f37b94046c",
      "source_handle": "P0592",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
