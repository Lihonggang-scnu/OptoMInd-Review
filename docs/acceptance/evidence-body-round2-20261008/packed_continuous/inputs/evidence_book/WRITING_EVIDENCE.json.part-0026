            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::7e5f595bdacece1ca418670d0888da02d417da73fc42c80574a3f6883e5c58b7",
      "multiple_values_in_field": true
    },
    "atom::ede7b03dc750dbb5f68495ca": {
      "atom_id": "atom::ede7b03dc750dbb5f68495ca",
      "source_handle": "P0586",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体内黑色素瘤模型（B16-F10），瘤内注射IL-12+ADA工程菌",
        "finding": "诱导肿瘤完全消退，100%生存率；再挑战实验确认了持久的抗肿瘤免疫记忆。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
