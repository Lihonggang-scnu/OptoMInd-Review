    "atom::dd120e3a6cc93c94a279398e": {
      "atom_id": "atom::dd120e3a6cc93c94a279398e",
      "source_handle": "P0591",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "类比到微生物组研究，提示未来的研究应关注治疗期间微生物组成的动态变化及其与免疫反应的时序关系，而非仅依赖基线微生物特征。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "2",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::c431ad9d016deb0119c26d9ed8a027869435d4c28a444cfa6dfa313a51431676",
