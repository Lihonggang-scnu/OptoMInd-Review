    "atom::6c57407c01615cda2048f28e": {
      "atom_id": "atom::6c57407c01615cda2048f28e",
      "source_handle": "P0580",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "CT26模型中CX-5461与抗LAG3联合治疗",
        "finding": "CX-5461诱导LAG3表达，显著增敏CT26肿瘤对抗LAG3治疗的反应，导致肿瘤显著消退和更深层的抗肿瘤免疫反应，且未引起明显的体重下降或DNA损伤副作用。"
      },
