      "multiple_values_in_field": true
    },
    "atom::8548377a67596dffc00c7727": {
      "atom_id": "atom::8548377a67596dffc00c7727",
      "source_handle": "P0581",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "D+T组内，疾病进展（PD）vs 疾病稳定（SD）",
        "finding": "PD患者在第8周的Artemin水平较基线显著升高（p=0.026），而SD患者无显著变化（p=0.14）。"
      },
      "role": "evidence",
