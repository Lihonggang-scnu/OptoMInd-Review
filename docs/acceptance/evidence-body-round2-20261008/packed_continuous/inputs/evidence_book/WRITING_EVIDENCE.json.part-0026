    "atom::45965bc00adfc9b0222818a8": {
      "atom_id": "atom::45965bc00adfc9b0222818a8",
      "source_handle": "P0589",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用体内微透析（in vivo microdialysis）技术，结合PDX小鼠模型。具体步骤包括：1) 使用特定的人类肿瘤PDX品系；2) 监控肿瘤生长至>400 mm³后手术植入探针至肿瘤及无瘤侧；3) 灌注透析液并连续收集样本；4) 使用EIA或LC-MS/MS检测ATP、肌苷和犬尿氨酸代谢物；5) 比较肿瘤侧与对侧以及不同肿瘤类型间的生物标志物水平差异。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1fb52b3621e1fe1f515eb59106e26772ff4abbab4d4d6339018f2e44cd8c5270",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::853d240c0f18a4c9bed03dddaa7d3ebf34e65bad0e042a8478aa14d500436152",
      "multiple_values_in_field": false
    },
    "atom::2a337ff8b73b7e69c9f08a58": {
      "atom_id": "atom::2a337ff8b73b7e69c9f08a58",
      "source_handle": "P0589",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了在自由移动的PDX小鼠中使用体内微透析监测肿瘤微环境生化成分（ATP、肌苷、犬尿氨酸代谢物）的方法学验证；证明了PDX模型能反映人类肿瘤特有的微环境代谢特征。",
        "limits": "所给摘要未交代具体的统计学显著性数据、样本量大小、不同PDX品系的详细名称或病理类型、以及具体的代谢物浓度数值。仅展示了概念验证性质的发现，未提供针对免疫检查点抑制剂或肠道微生物群的具体实验数据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1fb52b3621e1fe1f515eb59106e26772ff4abbab4d4d6339018f2e44cd8c5270",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::8270a1ffd3f9beca662d4aa998e3f21963dd9a4848e863c3be5cda265fc1863b",
      "multiple_values_in_field": false
    },
