    },
    "atom::52288a2d56e1284b00af58bb": {
      "atom_id": "atom::52288a2d56e1284b00af58bb",
      "source_handle": "P0580",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICB治疗响应患者队列",
        "finding": "在响应ICB治疗的患者中，高核糖体活性的免疫抑制性T细胞亚群（如HSP70+ CD8+ T细胞和Tregs）在治疗后显著减少，表明这些细胞是维持免疫耐受的关键。"
      },
      "role": "evidence",
