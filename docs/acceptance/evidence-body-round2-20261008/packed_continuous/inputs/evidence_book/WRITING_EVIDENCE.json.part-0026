          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
          "field_path": [
            "deep_read_material",
            "current_question_material",
            "0"
          ]
        }
      ],
      "variant_group": "field::2ff79bc0e1704dd08567b4340e6c64337a642a2d7f010bc1a9689a85b124fa90",
      "multiple_values_in_field": false
    },
