    },
    "atom::ae4d00fb49f9bc51ac7600ee": {
      "atom_id": "atom::ae4d00fb49f9bc51ac7600ee",
      "source_handle": "P0582",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "人类肿瘤队列（黑色素瘤、NSCLC等）",
        "finding": "肿瘤细胞中高UBA6表达与ICB治疗后的较差无进展生存期（PFS）和总生存期（OS）相关；低UBA6表达与较高的客观缓解率（ORR）和CD8+ T细胞浸润正相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
