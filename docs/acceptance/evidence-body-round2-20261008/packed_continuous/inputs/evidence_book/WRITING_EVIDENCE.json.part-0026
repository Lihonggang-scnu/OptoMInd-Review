      "multiple_values_in_field": true
    },
    "atom::29bb4fb3c94b0aa691d92f8c": {
      "atom_id": "atom::29bb4fb3c94b0aa691d92f8c",
      "source_handle": "P0579",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI 治疗后脾脏 T 细胞与自体 ccRCC 细胞体外共培养",
        "finding": "部分 ICI 治疗动物的脾脏 T 细胞在接触自体肿瘤细胞后显示出 IFN-γ 和 Granzyme B 的上调，表明系统性 T 细胞活化被肿瘤局部微环境所抑制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::66a35a3223d5575800d19c28a5c6cc70d7045e2087cac0345c80f25087802de6",
      "multiple_values_in_field": true
    },
    "atom::ceeb8577311efccb3d5a5610": {
      "atom_id": "atom::ceeb8577311efccb3d5a5610",
      "source_handle": "P0579",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "scRNA-seq 分析 VpR 肿瘤髓系细胞",
        "finding": "鉴定出两类主要免疫抑制髓系群体：一类表达 Cd300ld、S100a8/a9 的 PMN-MDSC 样细胞；另一类表达 Trem2、Apoe、Fn1 且缺乏抗原呈递分子的 Mono-macrophage 样细胞，后者与人类晚期 ccRCC 中的 TAM2 样细胞相似。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::66a35a3223d5575800d19c28a5c6cc70d7045e2087cac0345c80f25087802de6",
      "multiple_values_in_field": true
    },
    "atom::00b245fd90ad200dfa97d1eb": {
      "atom_id": "atom::00b245fd90ad200dfa97d1eb",
      "source_handle": "P0579",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "免疫检查点配体表达谱分析（鼠 vs 人）",
        "finding": "PD-L1/PD-L2 表达极低；而 LAG-3 配体（Galectin-3）、TIM-3 配体（Galectin-9, HMGB1）、TIGIT 配体（PVR）以及 B7-H3 (CD276) 在肿瘤细胞和多种髓系细胞中高表达，提示这些非经典通路可能是主要的 T 细胞抑制力量。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
