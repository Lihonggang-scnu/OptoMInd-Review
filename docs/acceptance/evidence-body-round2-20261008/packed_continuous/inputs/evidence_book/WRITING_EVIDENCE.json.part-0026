            "3"
          ]
        }
      ],
      "variant_group": "field::dc1fb443dea97f75a7dbbc98ca1a777426c73288367b4044777fdc78b944cf2e",
      "multiple_values_in_field": true
    },
    "atom::738f3bcda3e274730a37d403": {
      "atom_id": "atom::738f3bcda3e274730a37d403",
      "source_handle": "P0582",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "LiP-SMap筛选与CRISPR筛选",
        "finding": "肌苷直接结合并抑制UBA6活性；UBA6缺失使肿瘤细胞对T细胞和NK细胞介导的杀伤更敏感。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
