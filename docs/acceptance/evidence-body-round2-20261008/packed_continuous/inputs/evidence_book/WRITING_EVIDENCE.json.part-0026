          ]
        }
      ],
      "variant_group": "field::dc1fb443dea97f75a7dbbc98ca1a777426c73288367b4044777fdc78b944cf2e",
      "multiple_values_in_field": true
    },
    "atom::9a27e1609bb7eff8810d2f34": {
      "atom_id": "atom::9a27e1609bb7eff8810d2f34",
      "source_handle": "P0582",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体外T细胞-肿瘤细胞共培养",
        "finding": "肌苷预处理肿瘤细胞而非T细胞，显著增强肿瘤细胞对T细胞介导的细胞毒性的敏感性；肌苷上调肿瘤细胞表面MHC-I表达及抗原加工/呈递相关基因。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
          "field_path": [
