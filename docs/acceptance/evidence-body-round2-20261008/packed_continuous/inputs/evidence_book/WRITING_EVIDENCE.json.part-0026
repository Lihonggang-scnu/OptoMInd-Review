            "broader_review_uses",
            "0",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::295ab99d1f430320b27f1cb25ad560096f6f3f71bf64db0780f507fee947ff55",
      "multiple_values_in_field": true
    },
    "atom::aae45e23fc3175ffb28822c5": {
      "atom_id": "atom::aae45e23fc3175ffb28822c5",
      "source_handle": "P0589",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为背景知识，强调实体瘤微环境并非均质，其代谢状态（如能量消耗）具有肿瘤特异性和个体差异性。这在理解为何不同患者对ICI反应不同时，提供了一个非免疫细胞层面的视角（即代谢微环境的基础状态）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1fb52b3621e1fe1f515eb59106e26772ff4abbab4d4d6339018f2e44cd8c5270",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::6dcc9412e37f9789e67900040e355c6be43ffeb22c541549df2fa7c86e731960",
      "multiple_values_in_field": true
    },
    "atom::48a99a95c620d8fc82fa66bd": {
      "atom_id": "atom::48a99a95c620d8fc82fa66bd",
      "source_handle": "P0589",
      "field_path": [
