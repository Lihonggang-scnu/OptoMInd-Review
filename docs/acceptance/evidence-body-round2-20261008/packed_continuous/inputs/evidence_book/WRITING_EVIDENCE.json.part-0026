    "atom::da3ae787e2b5c4f0bd17db85": {
      "atom_id": "atom::da3ae787e2b5c4f0bd17db85",
      "source_handle": "P0593",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释‘代谢产物介导的免疫增强’这一具体机制路径。可与菌群代谢产物（如短链脂肪酸）的作用机制进行比较，区分内源性代谢物与外源性（菌群）代谢物的不同作用靶点。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::253f9e6877830f43e32548d1663b5d3343f4b8c35ed536798a8e99b0b962a5b6",
