    "atom::1ead72c668dd628bcb544967": {
      "atom_id": "atom::1ead72c668dd628bcb544967",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "有助于理解ICI疗效受阻的潜在代谢机制，即使ICI主要作用于PD-1/PD-L1，但微环境中的腺苷积累同样构成屏障。此材料可补充综述中关于“多重免疫抑制机制”的部分。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::a4021915de7261da59f022eed0ee759bb4a8fcaeeeb2e55c852ba66fbd47956e",
      "multiple_values_in_field": true
    },
    "atom::7e8d638314470b9d7233c364": {
      "atom_id": "atom::7e8d638314470b9d7233c364",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
