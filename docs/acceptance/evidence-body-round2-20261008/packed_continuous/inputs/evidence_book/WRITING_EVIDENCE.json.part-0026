      "multiple_values_in_field": true
    },
    "atom::cda68675ffa3e23b902c5ad9": {
      "atom_id": "atom::cda68675ffa3e23b902c5ad9",
      "source_handle": "P0591",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "背景与概念界定",
      "role": "planning",
