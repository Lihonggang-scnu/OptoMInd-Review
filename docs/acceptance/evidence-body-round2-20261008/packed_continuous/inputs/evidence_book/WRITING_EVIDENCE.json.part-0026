    "atom::ef496a9b4a88daae4f841123": {
      "atom_id": "atom::ef496a9b4a88daae4f841123",
      "source_handle": "P0582",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "UBA6功能缺失模型",
        "finding": "UBA6缺失模拟肌苷效应，上调TNF-α、IFN响应基因及MHC-I表达；UBA6缺失消除了肌苷对基因表达的进一步诱导作用，表明肌苷通过抑制UBA6发挥作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "5"
          ]
        }
      ],
      "variant_group": "field::dc1fb443dea97f75a7dbbc98ca1a777426c73288367b4044777fdc78b944cf2e",
      "multiple_values_in_field": true
    },
    "atom::69e97b9a59ffba6e35ecb95f": {
      "atom_id": "atom::69e97b9a59ffba6e35ecb95f",
      "source_handle": "P0582",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同肿瘤细胞系（MC38 vs 4T1/B16）",
        "finding": "肌苷仅在高表达UBA6的肿瘤细胞（4T1, B16）中增强免疫原性；在低表达UBA6的MC38细胞中无效，但在过表达UBA6的MC38细胞中恢复效应。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::307f071228c50505d3184f8a10b4f3a24055793cf25ab7a71094ce8baeea22af",
          "field_path": [
