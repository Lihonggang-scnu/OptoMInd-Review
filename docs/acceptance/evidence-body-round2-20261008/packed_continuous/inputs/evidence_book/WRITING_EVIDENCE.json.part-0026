    "atom::13b75fe0affb6edd8981d33b": {
      "atom_id": "atom::13b75fe0affb6edd8981d33b",
      "source_handle": "P0593",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "CT26小鼠模型scRNA-seq分析",
        "finding": "药物处理导致肿瘤细胞比例下降，免疫细胞（特别是巨噬细胞、DCs）浸润增加，但MDSCs显著减少。oxypurinol表现出最强的TME重塑能力，显著降低MDSCs并增加抗原呈递相关细胞。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::253f9e6877830f43e32548d1663b5d3343f4b8c35ed536798a8e99b0b962a5b6",
