          ]
        }
      ],
      "variant_group": "field::939e43ff02dfd936a770656850d4986d222bd808b17695decdfffd4e6e9c741c",
      "multiple_values_in_field": true
    },
    "atom::f9f47d7274d6ce123558914d": {
      "atom_id": "atom::f9f47d7274d6ce123558914d",
      "source_handle": "P0593",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "L1000平台筛选739种化合物",
        "finding": "识别出54种在多癌种中重复出现的候选药物，主要靶向CDKs、HDAC1、PI3K等通路。低剂量处理更倾向于产生非细胞毒性的免疫调节效应，而高剂量常伴随免疫抑制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::253f9e6877830f43e32548d1663b5d3343f4b8c35ed536798a8e99b0b962a5b6",
