      "multiple_values_in_field": true
    },
    "atom::4e04f12db45a36c1855a42ff": {
      "atom_id": "atom::4e04f12db45a36c1855a42ff",
      "source_handle": "P0580",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于scRNA-seq数据的核糖体状态分析",
        "finding": "构建了包含73个元基因的核糖体状态签名，证实高核糖体活性与不良预后相关；鉴定出HSP70+ CD8+ T细胞（T_str）和MRC1+ TAMs具有极高的核糖体生物合成活性，且对CX-5461敏感。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5f35d65e992214fe2688905acd5293501aef3c04672830bf52ef3308e86149fd",
