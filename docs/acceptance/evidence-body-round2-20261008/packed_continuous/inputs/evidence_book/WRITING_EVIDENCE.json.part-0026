    "atom::869400c02ba6da77069305d2": {
      "atom_id": "atom::869400c02ba6da77069305d2",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用机制导向的概念框架进行综合：1. 定义预测性与预后性生物标志物的区别；2. 按生物学维度（肿瘤来源、免疫细胞来源、可溶性介质）分类评估现有标志物；3. 引入时间维度（静态vs动态）分析标志物的药代动力学意义；4. 评估新兴技术（TCR谱、EVs、单细胞测序）和复合模型的潜力与局限；5. 总结临床转化现状与未来优先事项。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ba04d0edf1dfddf4e9156ba3088b718488114b2f23cf244794b43349acca35bb",
      "multiple_values_in_field": false
    },
    "atom::d3256470d85cb1f3d20e62a9": {
      "atom_id": "atom::d3256470d85cb1f3d20e62a9",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了一个清晰的机制框架，严格区分了外周血生物标志物的预测功能与预后功能，纠正了临床解读中的常见误区。",
        "limits": "作为综述，其结论依赖于对现有文献的综合评价，而非新的原始实验数据；对于具体标志物的阈值和最佳采样窗口，文中指出目前仍缺乏统一标准。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::97d95ce4f17f8465812646dff4627b834464673271f836bec4babff25114b205",
      "multiple_values_in_field": true
    },
    "atom::bd43ba91a7a04f9a476a014d": {
      "atom_id": "atom::bd43ba91a7a04f9a476a014d",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统梳理了从传统血清学到新兴多组学技术的各类外周血标志物的证据等级和转化成熟度。",
        "limits": "由于领域内研究设计异质性大（回顾性为主、队列差异），许多结论是基于趋势性证据而非确凿的随机对照试验结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::97d95ce4f17f8465812646dff4627b834464673271f836bec4babff25114b205",
      "multiple_values_in_field": true
    },
    "atom::6891f84f9ae475ac6b00dbf0": {
      "atom_id": "atom::6891f84f9ae475ac6b00dbf0",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线测量/单一时间点",
        "finding": "大多数传统肿瘤来源标志物（基线ctDNA、bTMB、CTCs）和炎症指标（NLR、LDH、CRP）主要提供预后信息，反映肿瘤负荷或全身炎症，缺乏对PD-1/PD-L1阻断的特异性预测能力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::b6bdb003d23f266dc38a7ff45f743288c374856227faa48044d3f9681db84946",
      "multiple_values_in_field": true
    },
    "atom::f50cbfb7c62caa04147b283e": {
      "atom_id": "atom::f50cbfb7c62caa04147b283e",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "动态变化/纵向监测",
        "finding": "早期ctDNA清除和循环CD8+ T细胞的动态激活/增殖是更有潜力的药代动力学监测工具和探索性预测标志物，因为它们直接反映了治疗诱导的肿瘤控制和免疫再充盈。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::b6bdb003d23f266dc38a7ff45f743288c374856227faa48044d3f9681db84946",
      "multiple_values_in_field": true
    },
    "atom::05a825bdcb86d3869081e5e3": {
      "atom_id": "atom::05a825bdcb86d3869081e5e3",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "新兴技术/高维数据",
        "finding": "TCR谱系重塑、外泌体（EVs）和单细胞免疫表型具有更高的机制特异性，但目前受限于标准化不足、成本高昂和缺乏前瞻性验证，仍处于探索阶段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::b6bdb003d23f266dc38a7ff45f743288c374856227faa48044d3f9681db84946",
      "multiple_values_in_field": true
    },
    "atom::53599326b156040d83ba62f4": {
      "atom_id": "atom::53599326b156040d83ba62f4",
      "source_handle": "P0591",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "复合模型",
        "finding": "整合互补生物学维度（如肿瘤负荷+免疫状态+炎症背景）的纵向复合模型（如DIREct-On, SCORPIO）比单一标志物具有更好的预测性能，但需独立验证以排除过拟合和保证时间偏倚。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::54f28890ea704080b8c5ab58bc4e5568bf7b967b94983a9bf7c7a7a790b2d837",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::b6bdb003d23f266dc38a7ff45f743288c374856227faa48044d3f9681db84946",
      "multiple_values_in_field": true
    },
