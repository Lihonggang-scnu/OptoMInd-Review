      "multiple_values_in_field": true
    },
    "atom::40b8ff80b2e9e514cd07158f": {
      "atom_id": "atom::40b8ff80b2e9e514cd07158f",
      "source_handle": "P0592",
      "field_path": [
        "study_summary_A",
