            "0"
          ]
        }
      ],
      "variant_group": "field::6260d5b934669fcf67e3236b500a65a78133699981d874ac9056fadfb710350f",
      "multiple_values_in_field": true
    },
    "atom::8b25d531e39d74c58d1b7c7e": {
      "atom_id": "atom::8b25d531e39d74c58d1b7c7e",
      "source_handle": "P0593",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于讨论除了微生物组之外，宿主自身代谢干预和肿瘤局部代谢环境如何调节ICI疗效。可作为‘代谢微环境’章节的重要素材。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::253f9e6877830f43e32548d1663b5d3343f4b8c35ed536798a8e99b0b962a5b6",
          "field_path": [
