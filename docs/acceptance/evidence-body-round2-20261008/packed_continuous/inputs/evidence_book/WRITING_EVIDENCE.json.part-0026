      "source_handle": "P0581",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "红细胞祖细胞（EPCs）作为非典型免疫调节细胞，通过分泌Artemin影响肿瘤进程。"
      },
      "role": "evidence",
      "origins": [
