      "value": {
        "material": "VpR 模型中 ICI 导致 T 细胞减少而髓系细胞增加的现象；体外共培养证明 T 细胞具备反应能力但被局部抑制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f5279671fd44e5c2d6abcf8983dc1c0f2d330d3a727583c7d3c713c0ac749d57",
