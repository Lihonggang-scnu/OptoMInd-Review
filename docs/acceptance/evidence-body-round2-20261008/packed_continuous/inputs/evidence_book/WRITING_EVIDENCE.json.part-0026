      "multiple_values_in_field": true
    },
    "atom::67ad48bb69b58272df9096c8": {
      "atom_id": "atom::67ad48bb69b58272df9096c8",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该机制主要在NK细胞层面验证，未涉及T细胞或其他免疫亚群在ICI背景下的具体反应；且未直接涉及肠道菌群与系统性ICI疗效的关系。",
        "contribution": "提供了具体的代谢-免疫交互机制证据：揭示了IL-12虽能激活NK细胞，但同时会诱导CD73和A2AR表达，增加细胞对腺苷的敏感性；而ADA工程菌通过清除腺苷抵消了这一副作用，从而维持NK细胞功能。这说明了单纯免疫刺激可能不足以克服代谢抑制，需要联合代谢干预。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::8cd82da14aaa7ae2ea82a5e612b890c8e93acc092c6883487a8316c3a642f146",
      "multiple_values_in_field": true
    },
    "atom::ed882d39c82140ea83d40b48": {
      "atom_id": "atom::ed882d39c82140ea83d40b48",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于解释为何某些免疫治疗失败源于微环境代谢抑制，以及为何联合代谢调节剂（如ADA抑制剂或工程菌）可能增强免疫治疗效果。可作为“微环境代谢调控影响免疫细胞功能”的具体实例。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::bb682a69a8796a7d1e5ed101d011e0d6f296fb60c4c93d1490538e20bb92b572",
      "multiple_values_in_field": true
    },
    "atom::622327aae553ae237825829b": {
      "atom_id": "atom::622327aae553ae237825829b",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "本研究使用的是工程化大肠杆菌，而非天然肠道菌群；给药途径为静脉或瘤内，而非口服肠道菌群移植。因此不能直接用于回答“肠道菌群组成如何影响ICI疗效”，但可作为“微生物疗法”这一大类下的技术路线参考。",
        "contribution": "展示了活体微生物作为免疫调节平台的潜力：证明了非致病性细菌可以安全地在肿瘤部位（包括骨髓）定植并发挥功能，且能诱导持久的免疫记忆。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::8cd82da14aaa7ae2ea82a5e612b890c8e93acc092c6883487a8316c3a642f146",
      "multiple_values_in_field": true
    },
    "atom::5ac54421a6b375cebbfeac5d": {
      "atom_id": "atom::5ac54421a6b375cebbfeac5d",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可作为综述中讨论“微生物疗法（Microbiome-based therapy）”或“活体生物药（Live Biotherapeutic Products, LBPs）”在癌症免疫治疗中的应用前景和技术挑战的对比案例。特别适用于讨论细菌载体在克服免疫抑制微环境方面的优势。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::bb682a69a8796a7d1e5ed101d011e0d6f296fb60c4c93d1490538e20bb92b572",
      "multiple_values_in_field": true
    },
    "atom::6e870da4cb50937550534f05": {
      "atom_id": "atom::6e870da4cb50937550534f05",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了一个关于“活体微生物作为免疫调节载体”的具体案例，展示了如何通过工程化细菌同时解决免疫抑制微环境中的代谢障碍（腺苷堆积）和细胞因子不足问题。虽然其直接应用场景是AML和黑色素瘤，而非肠道菌群介导的ICIs疗效，但其揭示的“细菌定植-代谢重编程-免疫细胞激活”机制链条，以及细菌在肿瘤微环境中的归巢特性，可为综述中讨论“微生物疗法作为ICI辅助手段”或“微环境代谢调控对免疫检查点阻断的影响”提供重要的机制参考和对比素材。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::a43c6c10dce2874d2afb3d0b1c2f673ec48c8696e5b21a0ddc398d8f076c3404",
      "multiple_values_in_field": false
    },
    "atom::ceded61f628412f8cdf75af7": {
      "atom_id": "atom::ceded61f628412f8cdf75af7",
      "source_handle": "P0586",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
