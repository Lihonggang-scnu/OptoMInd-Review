      "Ch7::Ch7_U04::Ch7_U04_P04": {
        "chapter_id": "Ch7",
        "local_task_id": "Ch7_U04::Ch7_U04_P04",
        "original_task_id": "Ch7_U04_P04",
        "unit_id": "Ch7_U04",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch7_U04_P04",
          "point": "提出精准干预的标准化路径与安全框架",
          "development": "总结工程菌、定义菌群及生态药理学的前景，强调供体标准化、制剂工艺优化、昼夜节律同步及长期安全性监测的必要性。",
          "source_uses": [
            {
