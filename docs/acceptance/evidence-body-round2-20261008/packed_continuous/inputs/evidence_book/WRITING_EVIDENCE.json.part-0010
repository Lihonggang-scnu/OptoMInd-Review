      "Ch5::Ch5_U02::Ch5_U02_P01": {
        "chapter_id": "Ch5",
        "local_task_id": "Ch5_U02::Ch5_U02_P01",
        "original_task_id": "Ch5_U02_P01",
        "unit_id": "Ch5_U02",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch5_U02_P01",
          "point": "报告 MITRIC 试验在 ICI 耐药篮子队列中的 ORR、PFS 及临床获益分布。",
          "development": "指出全队列 ORR 为 0%，仅 1 例获得长期疾病稳定（SD>6 个月），中位 PFS 仅 1.5 个月，明确 FMT 在此类高度经治人群中缺乏挽救性活性。",
          "source_uses": [
            {
              "source_handle": "P0578",
              "role": "主论据",
              "use": "提供 MITRIC 试验在 ICI 耐药实体瘤中的 ORR、PFS 及临床获益具体数据"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
