      "Ch6::Ch6_U4::Ch6_U4_P01": {
        "chapter_id": "Ch6",
        "local_task_id": "Ch6_U4::Ch6_U4_P01",
        "original_task_id": "Ch6_U4_P01",
        "unit_id": "Ch6_U4",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch6_U4_P01",
          "point": "肠道屏障受损与内毒素易位的促炎级联",
          "development": "描述 Akkermansia 等黏液降解菌减少或致病菌扩张导致的紧密连接蛋白（ZO-1, Occludin）表达下调，促使 LPS 入血并持续激活 TLR4/NF-κB 通路，为全身性 irAEs 提供持续的先天免疫刺激背景（P0217）。",
          "source_uses": [
            {
              "source_handle": "P0217",
              "role": "主论据",
              "use": "描述 Akkermansia 等黏液降解菌减少致 LPS 入血并激活 TLR4/NF-κB 通路的机制"
            },
            {
              "source_handle": "P0284",
              "role": "例证",
              "use": "揭示 Paraclostridium bifermentans 通过活菌破坏上皮屏障致结肠炎的具体机制"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch6_U4_P01"
          ],
          "source_brief_details": [
