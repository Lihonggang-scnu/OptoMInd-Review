        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch7_U01_P02",
          "point": "剖析测序策略分歧与分辨率限制",
          "development": "对比16S与宏基因组的技术参数，阐明引物偏好、宿主DNA占比及生信管道差异如何导致菌种列表不一致。",
          "source_uses": [
            {
              "source_handle": "P0055",
              "role": "主论据",
              "use": "综述微生物组在癌症免疫治疗中的新兴角色，整理多个独立研究发现的共性模式和潜在通路。"
            },
            {
              "source_handle": "P0295",
              "role": "主论据",
              "use": "提供经过筛选的、跨多种癌症类型的细菌清单，作为后续机制探讨的基础背景。"
            },
            {
              "source_handle": "P0565",
              "role": "比较",
              "use": "通过黑色素瘤系统综述展示测序平台与生信管道差异导致的菌种列表不一致性，为剖析技术变异削弱结论可靠性提供具体案例。"
            },
            {
              "source_handle": "P0302",
              "role": "局限",
              "use": "以口腔局部微环境为例，展示低生物量样本检测中的污染控制难题及宿主蛋白互作对菌群信号的干扰，补充空间异质性带来的分析局限。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch7_U01_P02"
          ],
          "source_brief_details": [
            {
