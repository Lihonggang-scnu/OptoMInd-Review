      "Ch4::Ch4_U03::Ch4_U03_P01": {
        "chapter_id": "Ch4",
        "local_task_id": "Ch4_U03::Ch4_U03_P01",
        "original_task_id": "Ch4_U03_P01",
        "unit_id": "Ch4_U03",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch4_U03_P01",
          "point": "论证高纤维/特定宏量营养素饮食对ICI疗效的正向调节，关联产SCFAs菌属富集与PFS延长。",
          "development": "利用P0155 NSCLC队列数据展示高脂低淀粉饮食（HR 0.37）与Ruminococcus lactaris等有益菌富集的关联，对比P0390黑色素瘤队列中高纤维饮食的PFS获益，确立饮食底物对菌群功能的定向塑造作用。",
          "source_uses": [
            {
              "source_handle": "P0155",
              "role": "主论据",
              "use": "利用 NSCLC 前瞻性队列（N=147）宏基因组数据，展示高脂低淀粉饮食（HR 0.37）与 Ruminococcus lactaris 等有益菌富集的关联，确立饮食底物对菌群功能的定向塑造作用。"
            },
            {
              "source_handle": "P0390",
              "role": "比较",
              "use": "提供黑色素瘤队列中高纤维饮食的 PFS 获益数据，与 P0155 形成癌种间饮食效应比较，支持饮食模式对 ICI 疗效的正向调节。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch4_U03_P01"
          ],
          "source_brief_details": [
            {
