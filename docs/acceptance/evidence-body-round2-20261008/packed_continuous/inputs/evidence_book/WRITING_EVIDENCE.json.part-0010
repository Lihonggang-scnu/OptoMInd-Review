      "Ch3::U3_4::U3_4_P02": {
        "chapter_id": "Ch3",
        "local_task_id": "U3_4::U3_4_P02",
        "original_task_id": "U3_4_P02",
        "unit_id": "U3_4",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "U3_4_P02",
          "point": "阐述代谢物驱动的表观遗传重编程（HDAC 抑制、染色质开放）如何决定免疫细胞的功能状态。",
          "development": "整合 P0220 与 P0587 的机制发现，解释代谢物如何作为表观遗传酶的变构调节剂或底物，锁定 T 细胞或巨噬细胞的效应/耗竭表型。",
          "source_uses": [
            {
              "source_handle": "P0220",
              "role": "主论据",
              "use": "阐述代谢物作为表观遗传修饰底物或直接抑制 HDAC，改变染色质开放性以重编程巨噬细胞与 T 细胞转录程序"
            },
            {
              "source_handle": "P0587",
              "role": "发展",
              "use": "整合多组学数据揭示微生物代谢物系统性调节宿主免疫细胞氧化磷酸化与糖酵解平衡，决定效应与耗竭 T 细胞命运"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "U3_4_P02"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "U3_4_P02",
              "unit_id": "U3_4",
              "ordinal": 2,
              "point": "阐述代谢物驱动的表观遗传重编程（HDAC 抑制、染色质开放）如何决定免疫细胞的功能状态。",
              "development": "整合 P0220 与 P0587 的机制发现，解释代谢物如何作为表观遗传酶的变构调节剂或底物，锁定 T 细胞或巨噬细胞的效应/耗竭表型。",
              "source_handles": [
                "P0220",
                "P0587"
              ]
            }
          ]
        }
      },
      "Ch3::U3_4::U3_4_P03": {
        "chapter_id": "Ch3",
