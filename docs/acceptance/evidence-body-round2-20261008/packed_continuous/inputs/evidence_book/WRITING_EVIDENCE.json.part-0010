      "Ch3::U3_5::U3_5_P01": {
        "chapter_id": "Ch3",
        "local_task_id": "U3_5::U3_5_P01",
        "original_task_id": "U3_5_P01",
        "unit_id": "U3_5",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "U3_5_P01",
          "point": "客观评估当前血浆/粪便代谢组学作为 ICI 疗效预测工具的效能与固有偏差。",
          "development": "基于 P0582 与 P0363，承认宏观代谢物检测在临床可行性上的优势，同时指出其无法区分游离态与结合态、无法反映组织滞留时间的缺陷。",
          "source_uses": [
            {
              "source_handle": "P0582",
              "role": "主论据",
              "use": "指出因样本完整性问题未能在人体肿瘤队列中直接检测肌苷浓度，仅能以 UBA6 表达作为通路活性代理"
            },
            {
              "source_handle": "P0363",
              "role": "背景",
              "use": "强调多数机制证据来自小鼠模型，血浆/粪便浓度不能完全代表 TME 暴露水平，警示跨物种外推风险"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "U3_5_P01"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "U3_5_P01",
              "unit_id": "U3_5",
              "ordinal": 1,
              "point": "客观评估当前血浆/粪便代谢组学作为 ICI 疗效预测工具的效能与固有偏差。",
              "development": "基于 P0582 与 P0363，承认宏观代谢物检测在临床可行性上的优势，同时指出其无法区分游离态与结合态、无法反映组织滞留时间的缺陷。",
              "source_handles": [
                "P0582",
                "P0363"
              ]
            }
          ]
        }
      },
      "Ch3::U3_5::U3_5_P02": {
        "chapter_id": "Ch3",
        "local_task_id": "U3_5::U3_5_P02",
        "original_task_id": "U3_5_P02",
        "unit_id": "U3_5",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "U3_5_P02",
          "point": "深入剖析人体 TME 内代谢物绝对浓度数据缺失对机制研究与临床转化的具体阻碍，特别强调肌苷案例。",
          "development": "结合 P0584 与 P0413 的药代动力学与递送障碍分析，说明缺乏 TME 浓度阈值如何导致体外有效浓度无法在体内复现，以及为何单纯提高血浆浓度未必改善疗效。",
          "source_uses": [
            {
              "source_handle": "P0584",
              "role": "主论据",
              "use": "指出体外有效浓度（如 100 μM 肌苷）属人工设定而非内源性实测值，体内浓度受血流灌注与降解酶多重制约"
            },
            {
              "source_handle": "P0413",
              "role": "主论据",
              "use": "从药理学角度分析代谢物在 TME 中的递送效率受血管通透性及转运体限制，导致全身循环与局部有效浓度脱节"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "U3_5_P02"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "U3_5_P02",
              "unit_id": "U3_5",
              "ordinal": 2,
              "point": "深入剖析人体 TME 内代谢物绝对浓度数据缺失对机制研究与临床转化的具体阻碍，特别强调肌苷案例。",
              "development": "结合 P0584 与 P0413 的药代动力学与递送障碍分析，说明缺乏 TME 浓度阈值如何导致体外有效浓度无法在体内复现，以及为何单纯提高血浆浓度未必改善疗效。",
              "source_handles": [
                "P0584",
                "P0413"
              ]
            }
          ]
        }
      },
      "Ch3::U3_5::U3_5_P03": {
        "chapter_id": "Ch3",
        "local_task_id": "U3_5::U3_5_P03",
        "original_task_id": "U3_5_P03",
        "unit_id": "U3_5",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "U3_5_P03",
          "point": "规划填补 TME 浓度缺口的未来技术路线与研究范式。",
          "development": "提出引入原位微透析（microdialysis）、基质辅助激光解吸电离质谱成像（MALDI-MSI）及配对组织 - 血液纵向采样，以建立“局部浓度 - 受体占有率 - 临床结局”的直接定量映射。",
          "source_uses": [
            {
              "source_handle": "P0582",
              "role": "发展",
              "use": "呼吁未来研究需解决 TME 内代谢物浓度测量问题"
            },
            {
              "source_handle": "P0363",
              "role": "发展",
              "use": "主张采用多组学整合与机器学习模型捕捉代谢功能的动态变化"
            },
            {
              "source_handle": "P0413",
              "role": "发展",
              "use": "提出需解决代谢物在 TME 中的递送效率问题"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "U3_5_P03"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "U3_5_P03",
              "unit_id": "U3_5",
              "ordinal": 3,
              "point": "规划填补 TME 浓度缺口的未来技术路线与研究范式。",
              "development": "提出引入原位微透析（microdialysis）、基质辅助激光解吸电离质谱成像（MALDI-MSI）及配对组织 - 血液纵向采样，以建立“局部浓度 - 受体占有率 - 临床结局”的直接定量映射。",
              "source_handles": [
                "P0582",
                "P0363",
                "P0413"
              ]
            }
          ]
        }
      },
      "Ch4::Ch4_U01::Ch4_U01_P01": {
        "chapter_id": "Ch4",
        "local_task_id": "Ch4_U01::Ch4_U01_P01",
        "original_task_id": "Ch4_U01_P01",
        "unit_id": "Ch4_U01",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch4_U01_P01",
          "point": "界定ICI治疗前后30-90天为抗生素暴露的高危窗口，对比术前与术后暴露的生存差异。",
          "development": "比较P0575大样本队列中术后暴露（HR 1.27）与术前暴露（HR 1.04）的OS风险，论证微生物完整性在免疫启动期的脆弱性。",
          "source_uses": [
            {
              "source_handle": "P0575",
              "role": "主论据",
              "use": "提供 UC Health 多中心大样本队列数据，对比术后暴露（HR 1.27）与术前暴露（HR 1.04）的生存差异，界定 ICI 启动前后 30-90 天为抗生素干扰的高危窗口。"
            },
            {
              "source_handle": "P0096",
              "role": "背景",
              "use": "提供 NSCLC 背景下微生物组作为生物标志物与干预策略的综述背景，支持抗生素使用时机对疗效影响的一般性论述。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch4_U01_P01"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "Ch4_U01_P01",
              "unit_id": "Ch4_U01",
              "ordinal": 1,
              "point": "界定ICI治疗前后30-90天为抗生素暴露的高危窗口，对比术前与术后暴露的生存差异。",
              "development": "比较P0575大样本队列中术后暴露（HR 1.27）与术前暴露（HR 1.04）的OS风险，论证微生物完整性在免疫启动期的脆弱性。",
              "source_handles": [
                "P0575"
              ]
            }
          ]
        }
      },
      "Ch4::Ch4_U01::Ch4_U01_P02": {
        "chapter_id": "Ch4",
        "local_task_id": "Ch4_U01::Ch4_U01_P02",
        "original_task_id": "Ch4_U01_P02",
        "unit_id": "Ch4_U01",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch4_U01_P02",
          "point": "建立抗生素疗程长度与OS下降的剂量-反应关系，提示广谱破坏的累积效应。",
          "development": "引用P0061数据展示>10天疗程导致OS骤降（2.8 vs 8.8个月），结合P0052/Meta分析中氟喹诺酮类高风险趋势，说明暴露强度与疗效受损的正相关性。",
          "source_uses": [
            {
              "source_handle": "P0061",
              "role": "主论据",
              "use": "基于印度 Tata 纪念医院真实世界审计数据，展示>10 天疗程导致 OS 骤降（2.8 vs 8.8 个月），建立抗生素暴露强度与疗效受损的正向剂量 - 反应关系。"
            },
            {
              "source_handle": "P0052",
              "role": "主论据",
              "use": "提供 NSCLC 患者抗生素使用对临床结局影响的系统综述与 Meta 分析数据，量化抗生素暴露与较差生存/缓解的强关联。"
            },
            {
              "source_handle": "P0081",
              "role": "比较",
              "use": "提供多种药物效应 Meta 分析数据，作为抗生素作为关键混杂因素或调节变量的大规模实证支持，量化其对预后的影响。"
            },
            {
              "source_handle": "P0417",
              "role": "背景",
              "use": "提供 2019 年系统综述数据，作为抗生素干扰 ICI 疗效的历史证据背景，支持微生物组成预测价值的讨论。"
            },
            {
              "source_handle": "P0564",
              "role": "背景",
              "use": "汇总不同菌属与 ICI 反应及毒性的关联，以及抗生素使用时机和类型对预后的影响，作为解释微生物调节 ICI 疗效的关键背景素材。"
            },
            {
              "source_handle": "P0517",
              "role": "例证",
              "use": "提供 NSCLC 队列中抗生素暴露导致 PD-L1 高表达（≥50%）人群 OS 显著缩短的实证，揭示宿主生物标志物状态与微生物组干预效应的高度情境依赖性。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch4_U01_P02"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "Ch4_U01_P02",
              "unit_id": "Ch4_U01",
              "ordinal": 2,
              "point": "建立抗生素疗程长度与OS下降的剂量-反应关系，提示广谱破坏的累积效应。",
              "development": "引用P0061数据展示>10天疗程导致OS骤降（2.8 vs 8.8个月），结合P0052/Meta分析中氟喹诺酮类高风险趋势，说明暴露强度与疗效受损的正相关性。",
              "source_handles": [
