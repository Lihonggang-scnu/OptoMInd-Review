      "Ch4::Ch4_U01::Ch4_U01_P03": {
        "chapter_id": "Ch4",
        "local_task_id": "Ch4_U01::Ch4_U01_P03",
        "original_task_id": "Ch4_U01_P03",
        "unit_id": "Ch4_U01",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch4_U01_P03",
          "point": "引入HCC等特定癌种的阴性结果，讨论肝硬化背景下的免疫缓冲效应与结论外推边界。",
          "development": "利用P0275 Meta分析指出HCC中抗生素未显著恶化OS/PFS/ORR，结合肝硬化导致的基线免疫抑制与肠肝轴紊乱，解释为何抗生素扰动在此类人群中不转化为明确的生存劣势，警示单一机制模型的局限性。",
          "source_uses": [
            {
              "source_handle": "P0275",
              "role": "主论据",
              "use": "引入 HCC Meta 分析（n=1056 亚洲人群）阴性结果，结合肝硬化基线免疫抑制与肠肝轴紊乱背景，解释抗生素扰动在此类人群中不转化为明确生存劣势。"
            },
            {
              "source_handle": "P0547",
              "role": "比较",
              "use": "通过系统综述量化多数实体瘤中抗生素暴露导致生存率下降的风险幅度，并指出黑色素瘤中的阴性结果，警示单一机制模型的外推边界。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch4_U01_P03"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "Ch4_U01_P03",
              "unit_id": "Ch4_U01",
              "ordinal": 3,
              "point": "引入HCC等特定癌种的阴性结果，讨论肝硬化背景下的免疫缓冲效应与结论外推边界。",
              "development": "利用P0275 Meta分析指出HCC中抗生素未显著恶化OS/PFS/ORR，结合肝硬化导致的基线免疫抑制与肠肝轴紊乱，解释为何抗生素扰动在此类人群中不转化为明确的生存劣势，警示单一机制模型的局限性。",
              "source_handles": [
                "P0275"
              ]
            }
          ]
        }
