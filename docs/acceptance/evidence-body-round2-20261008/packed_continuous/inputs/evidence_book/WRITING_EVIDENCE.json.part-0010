              "unit_id": "Ch7_U01",
              "ordinal": 2,
              "point": "剖析测序策略分歧与分辨率限制",
              "development": "对比16S与宏基因组的技术参数，阐明引物偏好、宿主DNA占比及生信管道差异如何导致菌种列表不一致。",
              "source_handles": [
