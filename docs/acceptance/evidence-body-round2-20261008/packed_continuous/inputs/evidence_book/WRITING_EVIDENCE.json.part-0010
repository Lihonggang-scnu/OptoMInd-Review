            }
          ]
        }
      },
      "Ch4::Ch4_U02::Ch4_U02_P02": {
        "chapter_id": "Ch4",
        "local_task_id": "Ch4_U02::Ch4_U02_P02",
        "original_task_id": "Ch4_U02_P02",
        "unit_id": "Ch4_U02",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch4_U02_P02",
          "point": "揭示化疗近期暴露对PPI效应的修饰作用，并提出“口腔化”易位与菌群多样性丧失的机制假说。",
          "development": "结合P0537发现化疗<1年间隔消除PPI负面影响，以及P0289/P0088关于PPI促进口腔细菌定植、降低α多样性的描述，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。",
          "source_uses": [
            {
              "source_handle": "P0537",
              "role": "主论据",
              "use": "揭示化疗结束至 ICI 开始间隔<1 年可消除 PPI 负面影响（HR 1.09），并报告 PPI 使用者乳酸杆菌科和韦荣球菌属相对丰度较高，构建“胃酸抑制→菌群失调→免疫 priming 受损”的逻辑链。"
            },
            {
              "source_handle": "P0289",
              "role": "例证",
              "use": "描述 PPI 促进口腔细菌定植、降低α多样性的机制证据，结合 P0537 构建“胃酸抑制→菌群失调→免疫 priming 受损”的逻辑链。"
            },
            {
              "source_handle": "P0088",
              "role": "例证",
              "use": "提供 PPI 改变乳酸杆菌科和韦荣球菌属相对丰度的微生物组数据，支持 PPI 诱导特定菌群失调从而干扰免疫稳态的生物学基础。"
            },
            {
              "source_handle": "P0585",
              "role": "比较",
              "use": "提供 JCOG2007 试验中化疗 - 免疫联合治疗背景下的微生物组数据，作为化疗时序修饰药物效应的外部验证与对照。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch4_U02_P02"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "Ch4_U02_P02",
              "unit_id": "Ch4_U02",
              "ordinal": 2,
              "point": "揭示化疗近期暴露对PPI效应的修饰作用，并提出“口腔化”易位与菌群多样性丧失的机制假说。",
              "development": "结合P0537发现化疗<1年间隔消除PPI负面影响，以及P0289/P0088关于PPI促进口腔细菌定植、降低α多样性的描述，构建“胃酸抑制→菌群失调→免疫priming受损”的逻辑链。",
              "source_handles": [
                "P0537",
                "P0289",
                "P0088"
              ]
            }
          ]
        }
      },
      "Ch4::Ch4_U02::Ch4_U02_P03": {
        "chapter_id": "Ch4",
        "local_task_id": "Ch4_U02::Ch4_U02_P03",
        "original_task_id": "Ch4_U02_P03",
        "unit_id": "Ch4_U02",
        "kind": "paragraph",
        "task": {
          "paragraph_id": "Ch4_U02_P03",
          "point": "对比PPIs与H2B的毒性信号差异，并提供临床用药降级与监测建议。",
          "development": "引用P0286 FAERS信号显示PPI联用显著增加肝胆/皮肤irAEs报告率，结合P0537中H2B未达显著生存影响的观察，提出在必须抑酸时优先考虑H2B或严格限定PPI适应症的实践启示。",
          "source_uses": [
            {
              "source_handle": "P0286",
              "role": "主论据",
              "use": "引用 FAERS 自发报告系统信号显示 ICI+PPI 联用显著升高肝胆疾病（RORadj 7.10）、皮肤及代谢障碍的报告率，对比 H2B 未达显著生存影响的观察，提供临床用药降级与监测建议的实证依据。"
            },
            {
              "source_handle": "P0537",
              "role": "比较",
              "use": "提供 H2B 未达显著生存影响的观察数据，作为 PPI 毒性信号的对照，支持临床用药降级建议。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "Ch4_U02_P03"
          ],
          "source_brief_details": [
            {
