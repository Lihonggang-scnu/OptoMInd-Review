    "atom::f8897d3045f6cf3e35e01d33": {
      "atom_id": "atom::f8897d3045f6cf3e35e01d33",
      "source_handle": "P0113",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "不同研究间存在显著的方法学差异和结果不一致性（如Shen et al.报告Akkermansia在无响应者中富集，与Zheng et al.相反），需谨慎引用，需注明情境依赖性。样本量普遍较小。",
        "contribution": "提供了HCC患者中ICI治疗响应者与无响应者的具体微生物分类学差异清单。例如，响应者富集Akkermansia muciniphila, Ruminococcaceae, Faecalibacterium; 无响应者富集Bacteroides, Proteobacteria, Prevotella。同时也提到了联合治疗（ICI+TKI）下的特定菌群变化。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7cecf289760510f7dd19eb85c46f4754526a0d83f4dd4564a98bda0d4ff03596",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::517e243b34d82bfcfe02bf8b21ab883698d06656ba327f71844823cdefe78465",
      "multiple_values_in_field": true
    },
    "atom::c7d70f5450c3875337c823aa": {
      "atom_id": "atom::c7d70f5450c3875337c823aa",
      "source_handle": "P0113",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“哪些微生物特征与ICIs疗效相关”，作为预测生物标志物的证据来源。可用于比较不同研究间的共识与分歧。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::7cecf289760510f7dd19eb85c46f4754526a0d83f4dd4564a98bda0d4ff03596",
          "field_path": [
