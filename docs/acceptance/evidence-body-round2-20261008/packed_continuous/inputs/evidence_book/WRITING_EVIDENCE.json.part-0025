    "atom::03e48468f16d50d713772897": {
      "atom_id": "atom::03e48468f16d50d713772897",
      "source_handle": "P0352",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Limited to advanced NSCLC; small cohort (n=26); retrospective association only.",
        "contribution": "Identifies specific lower respiratory tract microbial taxa associated with ICI response in NSCLC: Bacillus enrichment correlates with positive response, while Sphingomonas and Sediminibacterium correlate with progression. Demonstrates that beta-diversity of the lung microbiome is a significant discriminator of clinical outcome.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::80663154eab12c4d18bfb7c0d72165f5b8e7c0b03bb35fba422b7fe014004571",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::d7fb9fdfeba6a218c0032603f46a4d87d2daf732ca222e057acc906d6562efba",
      "multiple_values_in_field": true
    },
    "atom::b8682e411ff91537aad47c35": {
      "atom_id": "atom::b8682e411ff91537aad47c35",
      "source_handle": "P0352",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Use to support arguments that site-specific microbiomes (lung vs. gut) have distinct predictive values. Can be cited as evidence for 'protective' vs 'detrimental' microbial signatures in solid tumors outside the GI tract.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::80663154eab12c4d18bfb7c0d72165f5b8e7c0b03bb35fba422b7fe014004571",
