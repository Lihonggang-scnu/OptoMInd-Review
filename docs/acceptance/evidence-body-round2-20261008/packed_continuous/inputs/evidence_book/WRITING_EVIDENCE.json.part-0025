    "atom::aaf47d69d976269623c51569": {
      "atom_id": "atom::aaf47d69d976269623c51569",
      "source_handle": "P0457",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "跨多种癌症类型的综合分析",
        "finding": "识别出三个反复出现的机制：1) 通过抗原呈递和Th1极化激活免疫；2) 通过调节性T细胞募集和基质重塑抑制免疫；3) 通过微生物信号传导调节检查点和导致T细胞耗竭"
      },
      "role": "evidence",
      "origins": [
