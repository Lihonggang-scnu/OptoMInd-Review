    "atom::a3c7dac3cc503addf493e45b": {
      "atom_id": "atom::a3c7dac3cc503addf493e45b",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "PDAC部分的直接证据多来自小鼠模型（抗生素+ICI协同），人体数据较少。黑色素瘤的数据不能直接外推至PDAC，但提供了潜在的菌种参考。",
        "contribution": "提供了肠道微生物组影响PDAC对免疫治疗（特别是抗PD-1）疗效的证据。指出PDAC本身对单药ICI反应不佳，但抗生素清除肠道菌群或与ICI联用可增强疗效。同时引用了黑色素瘤中特定菌种（如Akkermansia, Bifidobacterium）与ICI响应相关的阳性结果，提示PDAC中可能存在类似机制。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::e3a2c5218c6d0e174d400203c4e882c46637336031823fc64cf86be6ce3347c6",
      "multiple_values_in_field": true
    },
    "atom::f9f0069e9b76d1694f25ae1f": {
      "atom_id": "atom::f9f0069e9b76d1694f25ae1f",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于论证肠道微生物组是PDAC免疫治疗耐药性的一个潜在决定因素，并支持通过调节微生物组来改善ICI疗效的策略。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::ed0acad3c350839dc756bffe31b157d2fc622972c005b4799c8edf9307208282",
      "multiple_values_in_field": true
    },
    "atom::f1117f6e4fabd83614ff0aff": {
      "atom_id": "atom::f1117f6e4fabd83614ff0aff",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制研究主要基于小鼠模型和体外细胞实验。人体中具体的细菌-巨噬细胞互作细节尚不明确。",
        "contribution": "详细描述了介导微生物组影响免疫反应的三大机制：1) 全身性：通过Th17/IL-17轴调节外周免疫细胞；2) 局部性：通过细菌易位形成肿瘤内微生物组，激活PRRs（如TLR9），诱导巨噬细胞（TAMs）向免疫抑制表型转化，从而抑制T细胞活化；3) 代谢性：通过SCFAs等代谢产物调节炎症。特别强调了巨噬细胞在其中的核心枢纽作用。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::e3a2c5218c6d0e174d400203c4e882c46637336031823fc64cf86be6ce3347c6",
      "multiple_values_in_field": true
    },
    "atom::ec4906dcede677aa6fd75671": {
      "atom_id": "atom::ec4906dcede677aa6fd75671",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释肠道微生物组如何通过复杂的细胞间通讯（特别是巨噬细胞介导的）在局部微环境中建立免疫抑制屏障，从而阻碍ICIs发挥作用。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::ed0acad3c350839dc756bffe31b157d2fc622972c005b4799c8edf9307208282",
      "multiple_values_in_field": true
    },
    "atom::b62ea299f8c1fd9a09aeaa76": {
      "atom_id": "atom::b62ea299f8c1fd9a09aeaa76",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要针对化疗，与ICIs的直接联系较弱，但有助于全面理解微生物组在治疗反应中的作用。",
        "contribution": "揭示了肠道微生物组对化疗药物（如吉西他滨）代谢的影响，指出肿瘤内驻留细菌可将吉西他滨失活，而抗生素预处理可提高化疗敏感性。这提供了微生物组影响治疗反应的非免疫机制补充。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::e3a2c5218c6d0e174d400203c4e882c46637336031823fc64cf86be6ce3347c6",
      "multiple_values_in_field": true
    },
    "atom::f0d6560b31b5ec1bbaef94d2": {
      "atom_id": "atom::f0d6560b31b5ec1bbaef94d2",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "作为对比或补充机制，说明微生物组不仅影响免疫，还直接影响药物代谢，这可能间接影响免疫治疗的微环境基础。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::ed0acad3c350839dc756bffe31b157d2fc622972c005b4799c8edf9307208282",
      "multiple_values_in_field": true
    },
    "atom::9cfa34218ef4e70c9ba425eb": {
      "atom_id": "atom::9cfa34218ef4e70c9ba425eb",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物组如何影响实体瘤（特别是PDAC）对免疫检查点抑制剂（ICIs）的反应提供了详细的机制背景。它不仅总结了微生物组对全身免疫状态的调节，还深入探讨了肿瘤内微生物组通过巨噬细胞和PRR信号介导的局部免疫抑制机制。这对于回答“肠道微生物组如何调节ICIs疗效”及其“介导机制”至关重要，尤其是提供了从动物模型到人体观察的逻辑链条，以及不同治疗方式（化疗vs免疫治疗）下的微生物组作用差异。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::419fa285ece2fbe6fbfb292bbba8b36262c73b32991619caa734a1ebb7ebd02b",
      "multiple_values_in_field": false
    },
    "atom::346601a66f244afe0eeca05b": {
      "atom_id": "atom::346601a66f244afe0eeca05b",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "本文主要聚焦于PDAC，虽然引用了黑色素瘤等其他癌症的数据来佐证微生物组对ICI疗效的普遍影响，但在应用于其他实体瘤时需保持谨慎，因为不同肿瘤的免疫微环境和微生物定植情况差异巨大。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::e3e890767fb061c801e9a25b2af6ab2b86caa361d5b2050fa78ce645de97e697",
      "multiple_values_in_field": true
    },
    "atom::e00c473049f21132b7c06f8e": {
      "atom_id": "atom::e00c473049f21132b7c06f8e",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "文中大量机制证据来自小鼠模型（如KPC小鼠、抗生素处理小鼠），人体内的实际效应大小、特异性菌种及安全性可能与动物模型存在显著差异。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::e3e890767fb061c801e9a25b2af6ab2b86caa361d5b2050fa78ce645de97e697",
      "multiple_values_in_field": true
    },
    "atom::4de30df2b2a3d5a90bd35e7e": {
      "atom_id": "atom::4de30df2b2a3d5a90bd35e7e",
      "source_handle": "P0084",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "作者提出的‘靶向肠道微生物组’作为治疗策略目前仍处于理论探索和早期试验阶段，尚未成为标准临床实践，阅读时应区分‘潜在机会’与‘既定事实’。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
