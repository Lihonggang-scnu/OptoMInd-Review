        {
          "record_id": "record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::0e8a593f5cde16bf4dcd2b496014d9683c0c847a22222148e7a787315328dc84",
