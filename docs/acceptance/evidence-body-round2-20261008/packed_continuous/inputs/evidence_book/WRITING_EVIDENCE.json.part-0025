    },
    "atom::3e9f231228531d8f8721dc30": {
      "atom_id": "atom::3e9f231228531d8f8721dc30",
      "source_handle": "P0057",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Mechanisms are primarily derived from murine models or in vitro systems. Translational relevance to humans needs careful framing (e.g., TMAO mechanism validated in mice, correlated in small human cohort). Antibiotic depletion models may not fully replicate human dysbiosis.",
        "contribution": "Details mechanistic pathways from preclinical studies: 1) TMAO promotes anti-PD-1 efficacy via GSDME-mediated pyroptosis and CD8+ T cell activation. 2) Gut microbiota depletion reduces Doxorubicin efficacy by impairing CD8+ T cell infiltration and IFN-gamma signaling. 3) Engineered E. coli reduces tumor growth via methionine depletion. 4) Quercetin enhances Cyclophosphamide efficacy via SCFA production and immune modulation.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be960d4dd42c49b7fc35ff7bf63e415de6d5466c4998d29d63522be34e3cdc03",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::a6819c216e6182e907b26e55092200d15a44fee784a546f9ec3d3e4f98a4cbb9",
      "multiple_values_in_field": true
    },
    "atom::ee3c7cdbdcb4c31f4d19359c": {
      "atom_id": "atom::ee3c7cdbdcb4c31f4d19359c",
      "source_handle": "P0057",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Use to explain *how* the microbiome mediates ICB and chemotherapy effects. Provides concrete molecular mechanisms (pyroptosis, metabolic competition, immune priming) to answer the 'mechanisms' part of the review question.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::be960d4dd42c49b7fc35ff7bf63e415de6d5466c4998d29d63522be34e3cdc03",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::91bbed3d322d4ebbb9c7e79dd391555822f892eddfc717af81189ab13e2a2ba4",
      "multiple_values_in_field": true
    },
    "atom::daa45303227f10363c126a18": {
      "atom_id": "atom::daa45303227f10363c126a18",
      "source_handle": "P0057",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a high-level map of the field, confirming the general consensus that microbiome status modulates TNBC therapy response. It provides specific examples of biomarkers (e.g., Faith's PD, intratumoral load) and mechanisms (e.g., TMAO, methionine depletion, macrophage polarization) that can be used to illustrate the breadth of host-microbe-immune interactions in solid tumors. It also highlights the negative impact of antibiotics, serving as a cautionary example of microbiome disruption.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::be960d4dd42c49b7fc35ff7bf63e415de6d5466c4998d29d63522be34e3cdc03",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::2275b55554d88b908e3b7843fb370f08bc10037d4cd98a120c6b1017cd928605",
      "multiple_values_in_field": false
    },
    "atom::ad46602408c995988ee87e8a": {
      "atom_id": "atom::ad46602408c995988ee87e8a",
      "source_handle": "P0057",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review includes both gut and intratumoral microbiome data; ensure distinction when applying findings to specific anatomical sites.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be960d4dd42c49b7fc35ff7bf63e415de6d5466c4998d29d63522be34e3cdc03",
          "field_path": [
