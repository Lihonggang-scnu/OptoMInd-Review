    "atom::5bc5ad830818239b3eb7d189": {
      "atom_id": "atom::5bc5ad830818239b3eb7d189",
      "source_handle": "P0362",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制描述较为广泛，涵盖了多种肿瘤类型，未针对某一特定机制在所有实体瘤中的普遍性或特异性进行定量比较；部分机制间的因果关系多为相关性描述。",
        "contribution": "详细列出了介导效应的多重机制路径，包括：1) 肿瘤内在机制（TMB、抗原呈递、信号通路）；2) 微环境机制（抑制性细胞积累、细胞因子风暴、代谢抑制、缺氧）；3) 宿主机制（HLA限制、激素调节）。同时指出了克服这些机制的具体药物组合策略。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::575a54bd02e5808098914b0e5b89272709ad2eb8bcd4f5ff8da83ec67305e35b",
