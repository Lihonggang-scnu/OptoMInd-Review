    "atom::af7229e313c22cc9f45f4fc4": {
      "atom_id": "atom::af7229e313c22cc9f45f4fc4",
      "source_handle": "P0377",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "文献综述与综合评议。作者通过梳理现有研究，归纳SCFAs的分子作用机制（HDAC抑制、GPCR激活等）、生物学效应（抗肿瘤、免疫调节）以及临床干预手段（益生菌、FMT等）的证据，并对特定代谢物（如丁酸盐）的功能复杂性进行辨析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::806dfb73f7648b306867b1fdb005eff214ab6d3de910f85d7995606f672d2267",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::4f34330d4531e2026ae33d3da0f05faa5088f51c450196f08f95242a9795de59",
      "multiple_values_in_field": false
    },
    "atom::5282d638f57d10663cf8fb0a": {
      "atom_id": "atom::5282d638f57d10663cf8fb0a",
      "source_handle": "P0377",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了SCFAs在肺癌中从分子机制到临床效应的综合框架，特别是明确了其作为免疫检查点抑制剂增效剂和放化疗减毒剂的潜力。",
        "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及证据等级评估方法；对于“双重性”的具体实验数据或临床案例未提供细节；未明确区分不同SCFA种类（如乙酸、丙酸、丁酸）的具体差异贡献。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::806dfb73f7648b306867b1fdb005eff214ab6d3de910f85d7995606f672d2267",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::65e79e36ee792c99b5919fa5f267a6134a4d26cba3294647b0b25a8a9a10eeda",
      "multiple_values_in_field": false
    },
    "atom::dca3f3ee3415a7493c6fdfe2": {
