    "atom::a61414ebf37d6e26fb25c8ab": {
      "atom_id": "atom::a61414ebf37d6e26fb25c8ab",
      "source_handle": "P0544",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统性文献回顾与综合的方法。作者梳理了关于肠道微生物群组成、功能及其与宿主免疫互作的现有研究，重点归纳了从分子机制（信号通路、代谢途径）到临床前模型证据，再到早期临床试验数据的多层次信息。文章按机制分类（特定菌株、代谢物、生物活性成分、昼夜节律）和组织治疗策略（饮食、FMT、LBPs等）进行逻辑编排，未提供新的原始实验数据，而是对已有证据进行分类、解释和综合评议。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01759670cec0ae86b898b9ca771c0193c2e67ef5bb3606c1dbda10890462613d",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::80ee6d0031e9d81e9747aece45c770ad293c2fc6b8d11bb4e1c369c56d2ba38f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ee204d93e8c6cd5f864e9cbfbb8183a44aa6d0a702f7ba58a12784a75890d25e",
      "multiple_values_in_field": false
    },
    "atom::7989217ee9a26ec028a34cad": {
      "atom_id": "atom::7989217ee9a26ec028a34cad",
      "source_handle": "P0544",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统整合了肠道微生物群调节ICI疗效的多维机制，包括菌株特异性效应、代谢物介导的信号通路及昼夜节律维度；提供了从基础机制到临床转化策略的全面图谱。",
        "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及质量评估方法；主要依赖已发表文献的综合，缺乏对异质性的大规模定量Meta分析；部分结论基于动物模型，临床验证尚处于早期阶段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01759670cec0ae86b898b9ca771c0193c2e67ef5bb3606c1dbda10890462613d",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::80ee6d0031e9d81e9747aece45c770ad293c2fc6b8d11bb4e1c369c56d2ba38f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::62c132f2afc09bb9677ddeef9b749d6a00f25c2f7b0cac04f6c530e439f316d3",
      "multiple_values_in_field": false
    },
    "atom::bf373bb67b77ec20f45b7a31": {
      "atom_id": "atom::bf373bb67b77ec20f45b7a31",
      "source_handle": "P0544",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于小鼠模型及部分人类队列观察",
        "finding": "特定益生菌株（如LGG、B. breve JCM92、C. butyricum）可通过激活DCs、促进CD8+ T细胞浸润或减少Tregs来增强ICI疗效；而某些病原体（如F. nucleatum的不同存在形式）可能通过代谢物介导免疫抑制或局部激活适应性抵抗。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01759670cec0ae86b898b9ca771c0193c2e67ef5bb3606c1dbda10890462613d",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::80ee6d0031e9d81e9747aece45c770ad293c2fc6b8d11bb4e1c369c56d2ba38f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::a6cd0d42059e061e1a52d760a33d4af99bb933f25d9c98228763cbd22b30c70c",
      "multiple_values_in_field": true
    },
    "atom::a6217b254e21a2974b6c3c63": {
      "atom_id": "atom::a6217b254e21a2974b6c3c63",
      "source_handle": "P0544",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体外及动物实验机制研究",
        "finding": "微生物代谢物（丁酸盐、ICA、肌苷、UB）通过表观遗传修饰、受体激活（AHR, A2aR）等途径直接调节T细胞功能和分化；但某些代谢物（琥珀酸、4-HPA、脱氧胆酸）可诱导MDSCs浸润或Treg积累，导致ICI耐药。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01759670cec0ae86b898b9ca771c0193c2e67ef5bb3606c1dbda10890462613d",
          "field_path": [
            "study_summary_A",
