      "source_handle": "P0377",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "一般机制层面",
        "finding": "SCFAs通过抑制组蛋白去乙酰化酶、激活G蛋白偶联受体和代谢重编程发挥作用；直接抑制肿瘤生长、诱导凋亡、抑制血管生成并调节上皮-间质转化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::806dfb73f7648b306867b1fdb005eff214ab6d3de910f85d7995606f672d2267",
