    },
    "atom::d21084f927684cbb0ce741ee": {
      "atom_id": "atom::d21084f927684cbb0ce741ee",
      "source_handle": "P0092",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性观察性队列设计。纳入52名计划接受PD-1i治疗的实体瘤患者。在治疗前收集粪便和血液样本，使用UPLC-MS/MS定量分析9种SCFAs及其他代谢物。根据RECIST 1.1标准分类治疗反应（应答者vs非应答者）。使用Mann-Whitney检验比较组间差异，递归分区分析筛选变量，单变量和多变量Cox比例风险模型评估PFS的影响因素（HR及95% CI）。同时，通过逻辑回归分析饮食频率与粪便SCFA浓度的关联。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::2f2a5d2dd33375dea67e017b6c4f6a1e3bbdb34d85e16acc494642336eaf8eb5",
      "multiple_values_in_field": false
    },
    "atom::b2d7a100951317e480d13ca2": {
      "atom_id": "atom::b2d7a100951317e480d13ca2",
      "source_handle": "P0092",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "首次报道了粪便SCFAs（特别是丙酸、丁酸等）浓度与实体瘤患者PD-1i疗效及PFS的正向关联，提示SCFAs可能是连接肠道菌群与免疫治疗疗效的桥梁。",
        "limits": "样本量较小（N=52），缺乏外部验证队列；未进行肠道微生物组的物种鉴定和多样性分析，因此无法直接证实菌群种类与SCFAs的具体对应关系；饮食数据回顾期为确诊前1年，而非治疗期间，可能存在回忆偏倚或时效性问题；观察性研究设计不能确立因果关系。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::50d2cdc02839b34c4bcca985afc8a669facef2ac8c50630b2c3ab20f7e76576c",
      "multiple_values_in_field": false
    },
    "atom::f7180273af7c9191b5b89238": {
      "atom_id": "atom::f7180273af7c9191b5b89238",
      "source_handle": "P0092",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在52例实体瘤患者队列中，治疗前粪便样本",
        "finding": "高浓度的乙酸（HR=0.29）、丙酸（HR=0.08）、丁酸（HR=0.31）和戊酸（HR=0.53）与更长的无进展生存期显著相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::d250a2e45ca720e5ef7728ba67cc310dba8613e1326481a709df0d7f685e27cd",
      "multiple_values_in_field": true
    },
    "atom::cbeaa6220986efc91a30ef25": {
      "atom_id": "atom::cbeaa6220986efc91a30ef25",
      "source_handle": "P0092",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在31例有血浆样本的患者中",
        "finding": "高浓度的血浆异戊酸（HR=0.38）与更长的无进展生存期显著相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::d250a2e45ca720e5ef7728ba67cc310dba8613e1326481a709df0d7f685e27cd",
      "multiple_values_in_field": true
    },
    "atom::bed6397bdb547f9d272b8d55": {
      "atom_id": "atom::bed6397bdb547f9d272b8d55",
      "source_handle": "P0092",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多变量Cox回归分析后",
        "finding": "仅粪便丙酸浓度被确认为与PFS独立相关的保护因子（HR=0.07）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::d250a2e45ca720e5ef7728ba67cc310dba8613e1326481a709df0d7f685e27cd",
      "multiple_values_in_field": true
    },
    "atom::ead73e1926e3f5b1becac608": {
      "atom_id": "atom::ead73e1926e3f5b1becac608",
      "source_handle": "P0092",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "饮食与代谢物关联分析",
        "finding": "高频摄入蘑菇与高粪便丁酸浓度相关；高频摄入绿叶蔬菜和卷心菜与高粪便戊酸浓度相关。高频蘑菇摄入也与较长PFS相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
