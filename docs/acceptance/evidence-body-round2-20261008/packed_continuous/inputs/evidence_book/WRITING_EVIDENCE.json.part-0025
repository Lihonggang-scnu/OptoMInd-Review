    "atom::654ed3c07facb168d01facd3": {
      "atom_id": "atom::654ed3c07facb168d01facd3",
      "source_handle": "P0559",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "To support a discussion on limitations and future directions in microbiome-based cancer therapy research.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "2",
            "purpose"
          ]
        }
      ],
