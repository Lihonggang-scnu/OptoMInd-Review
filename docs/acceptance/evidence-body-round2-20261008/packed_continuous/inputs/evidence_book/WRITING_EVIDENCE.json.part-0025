    "atom::87df1b467b715a1a15d02967": {
      "atom_id": "atom::87df1b467b715a1a15d02967",
      "source_handle": "P0503",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "综述提出了从“分类学导向”向“功能/代谢物导向”转变的观点，认为代谢物比物种丰度更能反映微生物的功能输出，且更稳定、可量化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::10f6f83feb179745fdb9234e2a4388e5355d3aea91f544b7672e922449f3e293",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::d3643ab58114758f821a53427b0c3397f547b5335198ffda5ab0302fbc0755c7",
      "multiple_values_in_field": true
    },
    "atom::38176fdf7f6e3e21319b7733": {
      "atom_id": "atom::38176fdf7f6e3e21319b7733",
      "source_handle": "P0503",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "为综述提供理论依据，说明为何关注代谢物而非仅仅关注细菌种类，有助于解释为何不同研究中细菌物种结果不一致但代谢物趋势可能更一致。",
      "role": "planning",
      "origins": [
        {
