    "atom::76f140dec5c5945869d5d1d4": {
      "atom_id": "atom::76f140dec5c5945869d5d1d4",
      "source_handle": "P0362",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "患者特征维度",
        "finding": "肠道菌群组成影响免疫激活水平；性别及激素（如雌激素）调节TME中的免疫细胞分布和PD-L1表达；HLA-I基因型变异影响新抗原识别效率。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::575a54bd02e5808098914b0e5b89272709ad2eb8bcd4f5ff8da83ec67305e35b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::a56e931dde47da4e9d5c26ef2ac952bdad9eda622d285485bbffb1df42b28622",
      "multiple_values_in_field": true
    },
    "atom::ac5ab8636ce51ccc5050865c": {
      "atom_id": "atom::ac5ab8636ce51ccc5050865c",
      "source_handle": "P0362",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "克服耐药策略",
        "finding": "联合PD-1/PD-L1与CTLA-4抑制剂（如纳武利尤单抗+伊匹木单抗）在多类实体瘤中显示优于单药或化疗的生存获益；联合抗血管生成药物（VEGF抑制剂）可改善TME灌注和T细胞浸润；联合化疗、靶向治疗（BRAF/MEK抑制剂）、表观遗传药物及PARP抑制剂可通过不同机制逆转免疫抑制状态。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::575a54bd02e5808098914b0e5b89272709ad2eb8bcd4f5ff8da83ec67305e35b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::a56e931dde47da4e9d5c26ef2ac952bdad9eda622d285485bbffb1df42b28622",
      "multiple_values_in_field": true
    },
    "atom::afd9d3a90c940409f6f4b6f6": {
      "atom_id": "atom::afd9d3a90c940409f6f4b6f6",
      "source_handle": "P0362",
