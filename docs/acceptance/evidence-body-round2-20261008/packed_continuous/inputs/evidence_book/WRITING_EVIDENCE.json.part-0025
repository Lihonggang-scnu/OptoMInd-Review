        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "讨论了活体生物制品（LBPs）临床试验的失败案例（如SER-401因万古霉素预处理导致丁酸合成受损而失效），以及益生元（如抗性淀粉）和后生元（如UDCA、肌苷）的试验进展。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::10f6f83feb179745fdb9234e2a4388e5355d3aea91f544b7672e922449f3e293",
          "field_path": [
