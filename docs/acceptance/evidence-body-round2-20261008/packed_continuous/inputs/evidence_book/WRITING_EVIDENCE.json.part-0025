      ],
      "value": "To highlight future directions and potential clinical applications of microbiome targeting, although specific clinical trial data for ICI-microbiome interventions is not detailed here.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::592aefafd208990b34ed0f86ee32fd5bca51feaa3368169e179a15c1fe4dd9eb",
