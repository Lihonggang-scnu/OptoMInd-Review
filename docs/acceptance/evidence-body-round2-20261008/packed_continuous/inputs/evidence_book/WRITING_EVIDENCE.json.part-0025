    "atom::221c2187ede4977dfa1dadb7": {
      "atom_id": "atom::221c2187ede4977dfa1dadb7",
      "source_handle": "P0559",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors employ a narrative synthesis approach, organizing the content by metabolite class (SCFAs, Tryptophan metabolites, etc.) and then by therapeutic context (anti-tumor immunity, immunotherapy, chemotherapy). They aggregate findings from cited primary studies (mostly preclinical mouse models and some clinical correlations) to construct mechanistic pathways (e.g., HDAC inhibition, GPCR activation, AHR signaling). The review does not report new experimental data but curates and interprets existing evidence to build a conceptual map of metabolite-mediated immune modulation.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::52a742955c6db8d3f6de12fe8dfd2788b44b1275435be6288d63c111619b6a2f",
      "multiple_values_in_field": false
    },
    "atom::e75a3abec20585306499ff41": {
      "atom_id": "atom::e75a3abec20585306499ff41",
      "source_handle": "P0559",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a structured classification of microbial metabolites and their distinct, often opposing, roles in cancer therapy outcomes. It consolidates mechanistic insights (e.g., specific receptors like TLR5, AHR, GPCRs; epigenetic modifications) linking specific metabolites to immune cell phenotypes.",
        "limits": "As a narrative review, it aggregates heterogeneous data from various study designs (mouse models, human cohorts, in vitro). It does not perform a systematic meta-analysis. Many mechanistic claims are derived from animal models, and direct translation to human physiology is noted as a challenge. The review acknowledges methodological inconsistencies in microbiome research but does not resolve them."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::c465301c3faed6fa7ff3d4c4b9167ce022492da9d49644570ad55b65ab721241",
      "multiple_values_in_field": false
    },
    "atom::fc89388ebe329b72b674f50a": {
      "atom_id": "atom::fc89388ebe329b72b674f50a",
      "source_handle": "P0559",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "General anti-tumor immunity and immunotherapy contexts",
        "finding": "Microbial metabolites act as critical mediators; some enhance anti-tumor immunity (e.g., Butyrate enhancing CD8+ T cell activity via TLR5 or ID2/IL-12 pathways; ILA promoting DC maturation via epigenetic regulation), while others suppress it (e.g., Formate inducing AhR signaling and stemness; Succinic acid inhibiting cGAS-interferon pathway)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::38150ac2faba429d3709efb719f7cb84f62a7efbd6fb8bf5c88b3f0b5a1bd2dc",
      "multiple_values_in_field": true
    },
    "atom::a37833089861a4988eac7fe2": {
      "atom_id": "atom::a37833089861a4988eac7fe2",
      "source_handle": "P0559",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Response to Immune Checkpoint Inhibitors (ICIs)",
        "finding": "Metabolite levels correlate with ICI efficacy. Butyrate can enhance anti-PD-1 efficacy (via histone acetylation of Pdcd1/Cd28) but may reduce anti-CTLA-4 efficacy (by increasing Tregs). TMAO enhances response to ICIs in pancreatic cancer via Type I IFN pathway. DAT facilitates ICI treatment by boosting IFN-I signaling."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::38150ac2faba429d3709efb719f7cb84f62a7efbd6fb8bf5c88b3f0b5a1bd2dc",
      "multiple_values_in_field": true
    },
    "atom::91b489e62aed13f36a47b130": {
      "atom_id": "atom::91b489e62aed13f36a47b130",
      "source_handle": "P0559",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Chemotherapy response",
        "finding": "3-IAA improves chemotherapy efficacy in pancreatic cancer by increasing ROS accumulation via myeloperoxidase. Lactate produced by intratumoral bacteria can induce chemoradiation resistance. Statins may improve CRC prevention by altering microbiota to increase ILA production."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::38150ac2faba429d3709efb719f7cb84f62a7efbd6fb8bf5c88b3f0b5a1bd2dc",
      "multiple_values_in_field": true
    },
