    "atom::56828bb144170e1eacaa62e7": {
      "atom_id": "atom::56828bb144170e1eacaa62e7",
      "source_handle": "P0113",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节来自小鼠模型或体外实验，在人类HCC中的直接验证有限。代谢物水平的因果关系尚需更多临床数据支持。",
        "contribution": "详细阐述了微生物通过代谢物（SCFAs, 胆汁酸, MAMPs）和直接细胞互作（TLR, STING通路）调节抗肿瘤免疫的机制。具体包括：SCFAs维持屏障并抑制增殖；次级胆汁酸激活NKT细胞；A. muciniphila通过STING通路激活DC/NK细胞；L. rhamnosus通过cGAS/STING轴增强CD8+ T细胞交叉呈递。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7cecf289760510f7dd19eb85c46f4754526a0d83f4dd4564a98bda0d4ff03596",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::517e243b34d82bfcfe02bf8b21ab883698d06656ba327f71844823cdefe78465",
      "multiple_values_in_field": true
    },
    "atom::68aaf2118b9afc623cd3fdb7": {
      "atom_id": "atom::68aaf2118b9afc623cd3fdb7",
      "source_handle": "P0113",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“微生物如何调节ICIs疗效”的机制问题。提供分子层面的解释路径，连接微生物组成与免疫效应。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::7cecf289760510f7dd19eb85c46f4754526a0d83f4dd4564a98bda0d4ff03596",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::656eee092e973f6dfaca6fe88c9abc4151d6322389eef056b3143aac17015684",
      "multiple_values_in_field": true
    },
    "atom::6e0090d0ff672afb59ff4ca7": {
      "atom_id": "atom::6e0090d0ff672afb59ff4ca7",
      "source_handle": "P0113",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "大多数干预研究处于早期阶段（Phase I/II或回顾性分析），缺乏大规模随机对照试验证据。FMT的安全性和标准化问题突出。抗生素的影响复杂，取决于类型、时机和剂量。",
        "contribution": "提供了微生物靶向干预（FMT, 益生菌, 益生元, 抗生素）在HCC免疫治疗中的临床前和早期临床证据。例如Probio-M9提高ORR，FMT激活T细胞，抗生素通常降低疗效但存在例外。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7cecf289760510f7dd19eb85c46f4754526a0d83f4dd4564a98bda0d4ff03596",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::517e243b34d82bfcfe02bf8b21ab883698d06656ba327f71844823cdefe78465",
      "multiple_values_in_field": true
    },
    "atom::b0fcef697112fdb5442d3b84": {
      "atom_id": "atom::b0fcef697112fdb5442d3b84",
      "source_handle": "P0113",
      "field_path": [
