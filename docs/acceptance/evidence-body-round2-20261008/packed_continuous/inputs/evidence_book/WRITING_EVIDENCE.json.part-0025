    "atom::0190aee6e65653c45ab9f85a": {
      "atom_id": "atom::0190aee6e65653c45ab9f85a",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法，系统梳理现有文献中关于肠道微生物代谢物与宿主免疫系统相互作用的研究。文章按逻辑模块组织：1) 基础免疫调节机制（先天性与适应性免疫）；2) 主要代谢物类别及其分子机制（受体结合、表观遗传修饰等）；3) 在癌症免疫治疗中的具体作用（增强ICI反应、重塑TME、克服耐药）；4) 临床应用前景与挑战。未进行系统性检索流程描述或定量荟萃分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::0f43fba7d2eace58efd2e91fbad447a759568f6768aac549a1483399d9baf666",
      "multiple_values_in_field": false
    },
    "atom::a9e0be44201b834afc0e41d0": {
      "atom_id": "atom::a9e0be44201b834afc0e41d0",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物代谢物（SCFAs、胆汁酸、色氨酸代谢物）调节先天性和适应性免疫的详细机制框架，特别是它们在重塑肿瘤微环境和增强ICI疗效中的具体分子路径。",
        "limits": "作为叙述性综述，未提供新的实验数据；因果关系的验证仍依赖于未来的研究（如无菌动物模型和人类代谢组学验证）；未能量化不同代谢物在不同癌症类型中的具体效应大小。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::80e2d12379c91c7ee243dd20298fee681122da8b054d2d67c73a0a94b8082f53",
      "multiple_values_in_field": true
    },
    "atom::dd9bb6e8ffb215ae50417294": {
      "atom_id": "atom::dd9bb6e8ffb215ae50417294",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "总结了当前基于微生物群的临床干预策略（FMT、益生菌、代谢物补充）的现状和挑战，为未来个性化治疗提供了方向。",
        "limits": "指出个体异质性、长期安全性及代谢物生物利用度等问题仍是主要障碍，目前缺乏大规模随机对照试验的确证证据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::80e2d12379c91c7ee243dd20298fee681122da8b054d2d67c73a0a94b8082f53",
      "multiple_values_in_field": true
    },
    "atom::9f5239607957a19db0afd224": {
      "atom_id": "atom::9f5239607957a19db0afd224",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于现有文献的综合分析",
        "finding": "SCFAs（如丁酸盐、丙酸盐）通过抑制组蛋白去乙酰化酶（HDACs）和激活GPCRs，促进调节性T细胞（Tregs）分化以维持耐受，同时增强CD8+ T细胞的细胞毒性；丁酸盐还能通过表观遗传机制（FOXP3乙酰化）促进Treg分化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::a470cff262301732c8e208c88435c9c221e3aa844772d68e1b1d31ee666a6091",
      "multiple_values_in_field": true
    },
    "atom::3ebb778a131e2f098cc397f1": {
      "atom_id": "atom::3ebb778a131e2f098cc397f1",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于现有文献的综合分析",
        "finding": "次级胆汁酸通过FXR和GPBAR1受体调节树突状细胞成熟和促炎细胞因子分泌，其代谢失调与ICI反应降低相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::a470cff262301732c8e208c88435c9c221e3aa844772d68e1b1d31ee666a6091",
      "multiple_values_in_field": true
    },
    "atom::c2d3a800d8235cb666344991": {
      "atom_id": "atom::c2d3a800d8235cb666344991",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于现有文献的综合分析",
        "finding": "色氨酸代谢物（吲哚类）通过芳香烃受体（AhR）途径强化黏膜屏障，维持Treg稳态并限制Th17驱动的炎症。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::a470cff262301732c8e208c88435c9c221e3aa844772d68e1b1d31ee666a6091",
      "multiple_values_in_field": true
    },
    "atom::b4643d6cf49328804701dfd1": {
      "atom_id": "atom::b4643d6cf49328804701dfd1",
      "source_handle": "P0515",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于现有文献的综合分析",
        "finding": "FMT从ICI响应者转移至非响应者可在难治性癌症中恢复治疗敏感性，表明代谢物介导的免疫重塑具有临床转化潜力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71",
          "field_path": [
