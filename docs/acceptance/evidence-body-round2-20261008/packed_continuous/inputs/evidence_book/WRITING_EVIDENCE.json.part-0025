    "atom::b942783511a888c80cb58426": {
      "atom_id": "atom::b942783511a888c80cb58426",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性综述方法，系统梳理关于肠道微生物组与PDAC免疫反应关系的现有文献。分析路线包括：1) 阐述肠道微生物组与宿主免疫系统的一般关系；2) 总结肠道微生物组对PDAC全身适应性免疫（如T细胞亚群、细胞因子）的影响；3) 探讨肠道微生物组如何通过细菌易位影响肿瘤内微生物组，进而调节肿瘤微环境中的免疫细胞浸润（特别是T细胞和巨噬细胞）；4) 评估肠道微生物组对PDAC免疫检查点抑制剂和化疗疗效的影响；5) 讨论未来研究方向，包括人体研究的必要性及干预策略（如FMT、益生菌）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::27143ec6a851c4a307c49d1f8a9ab0bb885ccef8ecdfae3333a8738a06a4ec08",
      "multiple_values_in_field": false
    },
    "atom::2bde1d5fb767edcd42ee38b1": {
      "atom_id": "atom::2bde1d5fb767edcd42ee38b1",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "综合阐述了肠道微生物组通过全身（Th17/IL-17轴）和局部（肿瘤内微生物组、巨噬细胞极化、PRR信号）双重途径调节PDAC免疫微环境的机制框架。",
        "limits": "主要证据来源于动物模型和小鼠实验，人体临床数据相对有限，尤其是关于具体菌株与免疫治疗响应的人体直接关联证据尚不充分。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::a032a757c62d17658a4f5dde64da9879001ee64f184ff49187022d2f4ab1e94b",
      "multiple_values_in_field": true
    },
    "atom::43e003d059c2f3f1c354e64f": {
      "atom_id": "atom::43e003d059c2f3f1c354e64f",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "指出了肠道微生物组可能通过代谢产物（如短链脂肪酸、吲哚-3-乙酸）和细菌易位影响PDAC进展和治疗反应的具体路径。",
        "limits": "许多机制细节（如特定细菌-宿主互作的分子靶点）仍基于假设或初步研究，尚未在大规模人体队列中得到验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::a032a757c62d17658a4f5dde64da9879001ee64f184ff49187022d2f4ab1e94b",
      "multiple_values_in_field": true
    },
    "atom::f9986f4f0121ee6312149847": {
      "atom_id": "atom::f9986f4f0121ee6312149847",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了针对肠道微生物组的干预策略（如FMT、下一代益生菌、酶替代疗法）作为增强PDAC免疫治疗和化疗疗效的潜在方向。",
        "limits": "这些干预策略在PDAC患者中的安全性和有效性仍需前瞻性临床试验证实，且存在个体差异和标准化难题。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::a032a757c62d17658a4f5dde64da9879001ee64f184ff49187022d2f4ab1e94b",
      "multiple_values_in_field": true
    },
    "atom::2e91e7d8fb9075046c27d99a": {
      "atom_id": "atom::2e91e7d8fb9075046c27d99a",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠模型中抗生素清除肠道菌群",
        "finding": "减缓PDAC肿瘤生长，增加肿瘤内CD8+ T细胞浸润，减少髓源性抑制细胞（MDSCs），提高Th1:Th2比值，降低Th17细胞比例。该效应依赖于T细胞和IL-17的存在。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::dacc412b868374c3db5c9c984be3e4d8b275f68f82639fc2ec2292e2a5200889",
      "multiple_values_in_field": true
    },
    "atom::9c7ee4bbafa9c614f78986bf": {
      "atom_id": "atom::9c7ee4bbafa9c614f78986bf",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "PDAC小鼠模型的粪便移植实验",
        "finding": "将PDAC易感小鼠（KPC）的粪便移植给无菌或抗生素处理的小鼠，可加速肿瘤生长并减少T细胞浸润；而野生型小鼠的粪便则无此加速作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::dacc412b868374c3db5c9c984be3e4d8b275f68f82639fc2ec2292e2a5200889",
      "multiple_values_in_field": true
    },
    "atom::b3f7e3489be626c86f9a7292": {
      "atom_id": "atom::b3f7e3489be626c86f9a7292",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体外及体内巨噬细胞实验",
        "finding": "暴露于PDAC患者/小鼠肠道菌群的巨噬细胞表现出抑制T细胞活化的能力，并通过TLR信号通路诱导免疫耐受。清除肠道菌群后，肿瘤相关巨噬细胞（TAMs）向促炎的M1样表型转化，增强T细胞激活。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::dacc412b868374c3db5c9c984be3e4d8b275f68f82639fc2ec2292e2a5200889",
      "multiple_values_in_field": true
    },
    "atom::b4dc3f1932b309e2ae162e49": {
      "atom_id": "atom::b4dc3f1932b309e2ae162e49",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "人类黑色素瘤患者及小鼠模型",
        "finding": "对抗PD-1免疫治疗有反应的患者的肠道微生物组具有更高的Alpha多样性，且富集Bifidobacterium longum、Akkermansia muciniphila等特定菌种。FMT从 responder 到小鼠模型可轻微增强抗PD-1疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::dacc412b868374c3db5c9c984be3e4d8b275f68f82639fc2ec2292e2a5200889",
      "multiple_values_in_field": true
    },
    "atom::dca2d7aaf2f41b9840aa72d0": {
      "atom_id": "atom::dca2d7aaf2f41b9840aa72d0",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "PDAC小鼠模型联合治疗",
        "finding": "抗生素预处理联合抗PD-1治疗显示出协同抗肿瘤效果，上调CXCR3和LFA1表达，而单独使用抗PD-1无效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d7781dfd33d8f7ba8a885511550d930fb61383e4ddfa2c259370565fc5382e26",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::dacc412b868374c3db5c9c984be3e4d8b275f68f82639fc2ec2292e2a5200889",
      "multiple_values_in_field": true
    },
    "atom::680c382c9ed585bea43b0110": {
      "atom_id": "atom::680c382c9ed585bea43b0110",
      "source_handle": "P0084",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
