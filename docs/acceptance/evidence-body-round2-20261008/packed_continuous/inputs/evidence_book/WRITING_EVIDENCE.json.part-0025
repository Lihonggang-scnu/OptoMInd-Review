    "atom::de8de63fd7881b2d15e7a917": {
      "atom_id": "atom::de8de63fd7881b2d15e7a917",
      "source_handle": "P0377",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "联合治疗情境",
        "finding": "SCFAs能增强免疫检查点抑制剂（ICIs）的治疗效果，并通过维持黏膜屏障和恢复全身免疫稳态，降低放疗和化疗的毒性。"
      },
      "role": "evidence",
