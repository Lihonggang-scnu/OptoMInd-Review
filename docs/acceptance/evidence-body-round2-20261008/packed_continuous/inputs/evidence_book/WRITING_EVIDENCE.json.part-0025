    },
    "atom::408595ee43f05e0c7296564a": {
      "atom_id": "atom::408595ee43f05e0c7296564a",
      "source_handle": "P0352",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Mechanistic links are correlative (multi-omics integration); causality not proven. Does not isolate specific metabolites or test functional effects directly.",
        "contribution": "Proposes a mechanism where microbiome-derived metabolites (lipid and amino acid metabolism pathways) reshape the local immune microenvironment. Specifically, beneficial microbes promote the release of cytokines (IL-1β, MCP-1, IL-8) that recruit CD8+ T cells and M1 macrophages, enhancing anti-tumor immunity.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::80663154eab12c4d18bfb7c0d72165f5b8e7c0b03bb35fba422b7fe014004571",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::d7fb9fdfeba6a218c0032603f46a4d87d2daf732ca222e057acc906d6562efba",
      "multiple_values_in_field": true
    },
    "atom::ced80778210f10a05a8ac5bd": {
      "atom_id": "atom::ced80778210f10a05a8ac5bd",
      "source_handle": "P0352",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Illustrates a concrete mechanism of microbiome-host interaction in the lung context. Useful for discussing how local microbial metabolism influences immune cell infiltration and function, complementing gut-based mechanisms.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::80663154eab12c4d18bfb7c0d72165f5b8e7c0b03bb35fba422b7fe014004571",
          "field_path": [
