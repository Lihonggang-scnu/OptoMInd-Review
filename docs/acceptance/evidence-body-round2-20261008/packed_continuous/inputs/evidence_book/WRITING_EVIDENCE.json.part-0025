    "atom::5241863596df9f36cf313abc": {
      "atom_id": "atom::5241863596df9f36cf313abc",
      "source_handle": "P0559",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review covers multiple cancer types (CRC, TNBC, PDAC, NSCLC, Melanoma). Effects of metabolites may be cancer-type specific (e.g., TMAO benefit in TNBC/PDAC vs. general cardiovascular risks). Do not generalize findings across all solid tumors without noting context.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::0cab6a65d2f04b536b212bcd90f0138639c9b7ca89543277cc5be9c9f64b9273",
      "multiple_values_in_field": true
    },
    "atom::e31645d6a0093fce292194f4": {
      "atom_id": "atom::e31645d6a0093fce292194f4",
      "source_handle": "P0559",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Many mechanistic claims are based on murine models. Direct extrapolation to human clinical efficacy requires caution.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0cab6a65d2f04b536b212bcd90f0138639c9b7ca89543277cc5be9c9f64b9273",
      "multiple_values_in_field": true
    },
    "atom::b000af9ca97720e495011227": {
      "atom_id": "atom::b000af9ca97720e495011227",
      "source_handle": "P0559",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Butyrate has contradictory effects depending on the ICI target (beneficial for PD-1, potentially detrimental for CTLA-4). This nuance is critical for accurate interpretation.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9c38714850a8edbe294a4d75f35476ffa83fb98c43dddaf9cc0f3fd8a7f3289c",
