    "atom::4639ae6e7b962bd6cc4916a3": {
      "atom_id": "atom::4639ae6e7b962bd6cc4916a3",
      "source_handle": "P0362",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要侧重于菌群对整体免疫状态的宏观影响，未深入探讨特定菌种与特定ICI药物之间的精确分子互作机制。",
        "contribution": "提供了肠道菌群作为免疫反应调节器的具体论述，指出健康菌群可增加效应T细胞水平、上调MHC-II并激活树突状细胞，而菌群失调可能导致治疗抵抗。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::575a54bd02e5808098914b0e5b89272709ad2eb8bcd4f5ff8da83ec67305e35b",
