    "atom::6a555a910e0f65bc9cd6734c": {
      "atom_id": "atom::6a555a910e0f65bc9cd6734c",
      "source_handle": "P0503",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "对比了代谢物在ICI、allo-SCT和CAR-T疗法中的不同作用重点。ICI侧重TME重塑和T细胞浸润；allo-SCT侧重肠道屏障保护和GVHD预防；CAR-T侧重细胞内在代谢状态和持久性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::10f6f83feb179745fdb9234e2a4388e5355d3aea91f544b7672e922449f3e293",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "2"
          ]
        }
      ],
      "variant_group": "field::d3643ab58114758f821a53427b0c3397f547b5335198ffda5ab0302fbc0755c7",
      "multiple_values_in_field": true
    },
    "atom::4b3d04a7d8f9154f3b855756": {
      "atom_id": "atom::4b3d04a7d8f9154f3b855756",
      "source_handle": "P0503",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "虽然用户问题聚焦于实体瘤ICI，但这些比较有助于界定ICI特异性机制的边界，避免过度泛化其他治疗模式中的发现。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::10f6f83feb179745fdb9234e2a4388e5355d3aea91f544b7672e922449f3e293",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "2",
            "connection_to_review"
          ]
        }
      ],
