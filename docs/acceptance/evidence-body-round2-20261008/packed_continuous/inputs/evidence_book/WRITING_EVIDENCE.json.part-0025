    "atom::61269ab287cd16ea7e0ad41c": {
      "atom_id": "atom::61269ab287cd16ea7e0ad41c",
      "source_handle": "P0457",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统综述方法，遵循PRISMA指南。检索策略包括四个主要数据库（PubMed, Scopus, Web of Science, EMBASE），时间范围为2010年1月至2025年4月。纳入标准限定为研究非肠道微生物群（即肿瘤组织内的微生物）并评估特定免疫终点（T细胞浸润、细胞因子、PD-L1、ICI反应性）。排除标准隐含在“非肠道”和“免疫终点”的限定中。由于研究间终点异质性大，作者决定不进行定量荟萃分析，而是进行定性综合。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b68dbdfd2cdbe0ee207c9cbebbe2c9c2a10ec113f22994a4306055a90cbc5d56",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::78e8323142e066cb5fc2521b8791d85ae46420060a4c60df8f260e60ad8f6a5c",
      "multiple_values_in_field": false
    },
    "atom::a5da1b6ec9118c3d38c6879b": {
      "atom_id": "atom::a5da1b6ec9118c3d38c6879b",
      "source_handle": "P0457",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于肿瘤内微生物群（非肠道）在多种实体瘤中调节免疫反应和ICI疗效的系统性定性综述；归纳了三种主要的免疫调节机制；强调了效应的空间结构和肿瘤背景依赖性。",
        "limits": "仅纳入17项研究，样本量有限；由于终点异质性未进行荟萃分析，缺乏量化效应大小；所给摘要未交代具体纳入研究的详细质量评估结果、偏倚风险评估细节以及各癌症亚组的具体效应方向差异；结论部分提出的临床转化建议属于未来展望，非本综述已验证的结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b68dbdfd2cdbe0ee207c9cbebbe2c9c2a10ec113f22994a4306055a90cbc5d56",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::3a14d73653dd48f01c83ee532e3d73fc1b9fd3e666ca00cc145ddfe363e0c4cd",
      "multiple_values_in_field": false
    },
    "atom::dd0bbe730e21fe2f7aa73c83": {
      "atom_id": "atom::dd0bbe730e21fe2f7aa73c83",
      "source_handle": "P0457",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "涉及黑色素瘤、胰腺癌、食管癌、胃癌、乳腺癌、肺癌和结直肠癌等多种实体瘤",
        "finding": "肿瘤内细菌能够调节免疫反应和免疫检查点抑制剂的疗效"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b68dbdfd2cdbe0ee207c9cbebbe2c9c2a10ec113f22994a4306055a90cbc5d56",
