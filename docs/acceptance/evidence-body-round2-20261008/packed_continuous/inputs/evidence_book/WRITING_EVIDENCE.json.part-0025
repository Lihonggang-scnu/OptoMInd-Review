      ],
      "variant_group": "field::e09f9d92bc24d1dda9ea66d7dd5a16847e2bd7f26cba8a354d88b78eb3490bba",
      "multiple_values_in_field": true
    },
    "atom::1584fd8515c96dbece42f2f4": {
      "atom_id": "atom::1584fd8515c96dbece42f2f4",
      "source_handle": "P0092",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制部分主要引用既往文献和本研究的间接证据（如HDAC抑制作用），本研究本身未直接检测免疫细胞亚群或分子通路变化；需结合其他研究确认具体菌种来源。",
        "contribution": "提出了SCFAs可能的免疫调节机制：包括诱导Treg分化、增强CD8+ T细胞IFNγ表达、以及通过抑制组蛋白去乙酰化酶（HDACs）上调PD-1配体并增强抗肿瘤免疫。同时指出粪便丙酸是独立的预后因子。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8966721c01adb52dbb888ee6d0e144a4f5f075a433e7bb110cbc2f0886d9bb2c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::29c7799ec4eb4c54f6b2852674a792f608a4966b6bed9a1f25765c9e9ebf4b54",
      "multiple_values_in_field": true
    },
    "atom::626dc5e028196df11d847819": {
