    "atom::c40c03f49dbc9d4188098c23": {
      "atom_id": "atom::c40c03f49dbc9d4188098c23",
      "source_handle": "P0457",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些机制是基于17项研究的定性综合，未提供量化证据强度；效应具有肿瘤类型特异性，不能简单外推至所有实体瘤；未区分这些机制与肠道菌群衍生的代谢物或免疫细胞之间的直接因果关系，仅描述关联。",
        "contribution": "提供了肿瘤内微生物群调节抗肿瘤免疫的具体机制分类：1. 免疫激活（抗原呈递、Th1极化）；2. 免疫抑制（Treg募集、基质重塑）；3. 检查点调控与T细胞耗竭。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b68dbdfd2cdbe0ee207c9cbebbe2c9c2a10ec113f22994a4306055a90cbc5d56",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::f966b8ed549c1519f87b22f00a69f003da9a271ea1be8177238b15347340026f",
      "multiple_values_in_field": true
    },
    "atom::d760643ad50da46d7101dd2a": {
      "atom_id": "atom::d760643ad50da46d7101dd2a",
      "source_handle": "P0457",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释肿瘤局部微环境中免疫反应的复杂性，特别是作为肠道菌群全身效应之外的局部机制补充。帮助理解微生物信号如何直接作用于肿瘤免疫微环境。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::b68dbdfd2cdbe0ee207c9cbebbe2c9c2a10ec113f22994a4306055a90cbc5d56",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::b76422b7388b9505dbace048634a414ec1b3ecfc1625b42f912fd7d683c8bdfc",
      "multiple_values_in_field": true
    },
    "atom::fc3fdaf5b1978c3cf6587567": {
      "atom_id": "atom::fc3fdaf5b1978c3cf6587567",
      "source_handle": "P0457",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "未提供肿瘤内微生物群与肠道微生物群之间相互作用的具体数据；未明确比较肿瘤内微生物群与肠道微生物群对ICI疗效影响的相对重要性；所给摘要未交代具体哪些细菌物种与疗效改善或恶化相关。",
        "contribution": "确认了肿瘤内微生物群对ICI疗效的影响，指出其效应依赖于肿瘤背景。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b68dbdfd2cdbe0ee207c9cbebbe2c9c2a10ec113f22994a4306055a90cbc5d56",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::f966b8ed549c1519f87b22f00a69f003da9a271ea1be8177238b15347340026f",
      "multiple_values_in_field": true
    },
    "atom::c3edfde50a0b1b3409c71adc": {
      "atom_id": "atom::c3edfde50a0b1b3409c71adc",
      "source_handle": "P0457",
      "field_path": [
