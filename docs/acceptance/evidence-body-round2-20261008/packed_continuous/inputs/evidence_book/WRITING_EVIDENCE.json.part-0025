          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::a6cd0d42059e061e1a52d760a33d4af99bb933f25d9c98228763cbd22b30c70c",
      "multiple_values_in_field": true
    },
    "atom::41de4893349e5dda8838775b": {
      "atom_id": "atom::41de4893349e5dda8838775b",
      "source_handle": "P0544",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "跨学科理论推导与初步临床观察",
        "finding": "肠道微生物群和免疫细胞均具有昼夜节律，干扰节律可能导致代谢紊乱和免疫抑制；同步ICI给药时间与免疫/微生物节律高峰可能提高疗效（时间免疫治疗概念）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01759670cec0ae86b898b9ca771c0193c2e67ef5bb3606c1dbda10890462613d",
          "field_path": [
