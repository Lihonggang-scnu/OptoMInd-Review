    },
    "atom::b42f4e07395763f6f1200396": {
      "atom_id": "atom::b42f4e07395763f6f1200396",
      "source_handle": "P0352",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This paper offers critical evidence that the lower respiratory tract microbiome, independent of the gut, modulates ICI efficacy in NSCLC through local metabolic-immune crosstalk. It provides specific microbial markers (Bacillus as beneficial, Sphingomonas/Sediminibacterium as detrimental) and mechanistic insights involving lipid/amino acid metabolism and cytokine-mediated CD8+ T cell/M1 macrophage recruitment. This supports the broader review's inclusion of site-specific microbiomes beyond the gut.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::80663154eab12c4d18bfb7c0d72165f5b8e7c0b03bb35fba422b7fe014004571",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::ab2de3c6df3fddad5a3b6071583c64e1657340764ffedfd369735da460613037",
      "multiple_values_in_field": false
    },
    "atom::ad7bff57315d0d6ecf80a1a6": {
      "atom_id": "atom::ad7bff57315d0d6ecf80a1a6",
      "source_handle": "P0352",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Do not generalize findings to all solid tumors; this is specific to advanced NSCLC.",
      "role": "evidence",
      "origins": [
