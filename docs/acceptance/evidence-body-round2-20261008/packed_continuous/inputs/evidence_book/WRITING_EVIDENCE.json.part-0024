    "atom::888e46cf068a669f02f24630": {
      "atom_id": "atom::888e46cf068a669f02f24630",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "体内实验：建立B16.OVA黑色素瘤和Panc02胰腺癌皮下移植模型。设置对照组、DAT单药组、ICI单药组及DAT+ICI联合组。引入广谱抗生素（Abx）混合液饮水处理以诱导肠道菌群失调，评估DAT对菌群失调导致的ICI抵抗的补偿作用。使用Ifnar1-/-小鼠验证宿主IFN-I信号在DAT介导的免疫增强中的必要性。体外实验：分离脾脏T细胞和骨髓来源树突状细胞（DC），在TCR刺激或LPS共刺激条件下，检测DAT对细胞活化标志物（如CD25, IFNγ, CD80/86）的影响。分析手段包括流式细胞术（TME免疫细胞图谱）、16S-rRNA测序（肠道菌群组成变化）、靶向代谢组学（粪便DAT水平测定）及生存分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::8b89ef574f72ac46c426d45bbd6fc59f92d8a3cab7321aed4e25c09555358d61",
      "multiple_values_in_field": false
    },
    "atom::7dd61fd659b69e3af70bbfb8": {
      "atom_id": "atom::7dd61fd659b69e3af70bbfb8",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "识别了细菌代谢物DAT作为IFN-I调节剂，能够协同ICI增强抗肿瘤T细胞免疫的具体表型和机制依赖关系。",
        "limits": "所给摘要未交代DAT在体内的确切受体或上游感知机制；仅在小鼠模型中验证，尚未在人类临床试验中证实安全性和有效性；DAT对菌群组成的改变是因果还是伴随现象尚不明确。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::ebfe12fd4284ae0550ee326b6a0a1a58f35f11a70c04c99d80bdf1b4d8d5dec6",
      "multiple_values_in_field": false
    },
    "atom::985c2cbb806631682ca1d391": {
      "atom_id": "atom::985c2cbb806631682ca1d391",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "B16.OVA黑色素瘤模型 + 抗CTLA-4治疗",
        "finding": "口服DAT显著延迟肿瘤生长并提高长期生存率，表现为肿瘤微环境（TME）中IFNγ+ CD4+和CD8+ T细胞以及NK细胞的频率和活性增加。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::77751789e65955468c4edfefccb1e77b01125cec4eaae9d5f1c748647543e82e",
      "multiple_values_in_field": true
    },
    "atom::05f735350695e36e26a7cb93": {
      "atom_id": "atom::05f735350695e36e26a7cb93",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Ifnar1-/-小鼠模型 + 抗CTLA-4治疗",
        "finding": "DAT的协同增效作用完全消失，表明DAT增强ICI疗效严格依赖于宿主完整的IFN-I信号通路。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::77751789e65955468c4edfefccb1e77b01125cec4eaae9d5f1c748647543e82e",
      "multiple_values_in_field": true
    },
    "atom::165122414afb942c2406b476": {
      "atom_id": "atom::165122414afb942c2406b476",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "广谱抗生素（Abx）诱导的菌群失调模型 + 抗CTLA-4治疗",
        "finding": "虽然DAT不能阻止抗生素引起的肠道细菌耗竭，但能部分恢复抗CTLA-4的抗肿瘤疗效，延长生存期，并促进循环中抗原特异性T细胞的扩增。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::77751789e65955468c4edfefccb1e77b01125cec4eaae9d5f1c748647543e82e",
      "multiple_values_in_field": true
    },
    "atom::07ae42b41e4955681f2cc681": {
      "atom_id": "atom::07ae42b41e4955681f2cc681",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体外T细胞培养 + TCR/CD28刺激",
        "finding": "DAT直接增强TCR刺激下的CD8+ T细胞活化（IFNγ+和CD25+表达增加）及CD4+ T细胞向Th1分化（T-bet+）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::77751789e65955468c4edfefccb1e77b01125cec4eaae9d5f1c748647543e82e",
      "multiple_values_in_field": true
    },
    "atom::a093daeeb0d505493c0b4dd2": {
      "atom_id": "atom::a093daeeb0d505493c0b4dd2",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体外DC培养 + LPS刺激",
        "finding": "DAT仅在存在LPS（TLR4配体）共刺激时，才能促进DC表面共刺激分子CD80/CD86的表达成熟。"
      },
      "role": "evidence",
      "origins": [
        {
