      "source_handle": "P0388",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释“哪些类型的肠道菌群有助于ICI疗效”以及“微生物如何远程影响肿瘤免疫”的子问题。可作为微生物调节ICI疗效的正向机制案例。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
          "field_path": [
