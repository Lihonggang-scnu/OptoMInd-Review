    "atom::988c6329a74ed0e48433dd73": {
      "atom_id": "atom::988c6329a74ed0e48433dd73",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用临床前黑色素瘤小鼠模型（C57BL/6J, B16-F10）。主要方法包括：1. 细菌培养与16S rRNA测序分析不同组织（MLN, TDLN, 脾脏, 肿瘤）中的微生物组成和丰度随时间的变化；2. 利用流式细胞术检测DC表面活化标志物及CD8+ T细胞的功能表型；3. 使用基因工程小鼠（CD11c-DTR敲除DC，LTA KO缺乏次级淋巴器官，Ccr7-/-）验证DC和CCR7在细菌转移中的作用；4. 手术切除特定淋巴器官评估其对ICT疗效的影响；5. 组织化学染色观察MLN的结构重塑；6. 抗生素预处理或益生菌回补实验验证因果关系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::c163d32cf39dff09f1d6080bd9eb28715bc22d11a66f136657587e401b0bf42f",
      "multiple_values_in_field": false
    },
    "atom::4ed95b626d58de048e18a282": {
      "atom_id": "atom::4ed95b626d58de048e18a282",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "揭示了ICT诱导肠道细菌向次级淋巴器官转移的新机制，明确了DC和MLN在这一过程中的核心作用，解释了肠道微生物如何影响肠外肿瘤免疫。",
        "limits": "研究仅在黑色素瘤小鼠模型中进行，结果是否适用于其他实体瘤类型尚不明确；联合ICT方案可能比单药治疗引起更显著的副作用和微生物变化，单一药物的效果未单独评估。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::c01cec99dc82e0d40810afa18a72c129887a5d16ad528b054994539f7530ccd0",
      "multiple_values_in_field": false
    },
    "atom::dcfe5e5c896a59037ad17c70": {
      "atom_id": "atom::dcfe5e5c896a59037ad17c70",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受ICT治疗的黑色素瘤小鼠",
        "finding": "ICT显著诱导特定肠道细菌（如Enterococcus faecalis, Lactobacillus johnsonii）从肠道转移至MLN、TDLN和肿瘤中，且这种转移不依赖于全身肠道屏障通透性的增加。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::2e9d04f26801dd865478b2325419bb8e1dd13e02db4445be4faa56bf0b09fb66",
      "multiple_values_in_field": true
    },
    "atom::e4dcc352c756761b8a61df27": {
      "atom_id": "atom::e4dcc352c756761b8a61df27",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "DC耗竭或CCR7缺失小鼠",
        "finding": "DC的缺失或CCR7信号通路的阻断显著抑制了ICT诱导的细菌向MLN和TDLN的转移，表明DC介导的细菌转运是CCR7依赖性的。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::2e9d04f26801dd865478b2325419bb8e1dd13e02db4445be4faa56bf0b09fb66",
      "multiple_values_in_field": true
    },
    "atom::2b772fa4e6379ea2c64e160c": {
      "atom_id": "atom::2b772fa4e6379ea2c64e160c",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "MLN切除术",
        "finding": "切除MLN导致TDLN和肿瘤中的细菌负荷降低，并显著减弱ICT诱导的CD8+ T细胞活化和抗肿瘤疗效，证明MLN在介导肠外免疫反应中的关键枢纽作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::2e9d04f26801dd865478b2325419bb8e1dd13e02db4445be4faa56bf0b09fb66",
      "multiple_values_in_field": true
    },
    "atom::7c8f04eb550557ff4eec973f": {
      "atom_id": "atom::7c8f04eb550557ff4eec973f",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICT治疗组 vs 对照组",
        "finding": "ICT诱导MLN发生结构重塑，表现为高内皮微静脉（HEV）扩张和淋巴管生成增加，这可能促进了细菌从MLN向远端组织的扩散。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::2e9d04f26801dd865478b2325419bb8e1dd13e02db4445be4faa56bf0b09fb66",
      "multiple_values_in_field": true
    },
    "atom::0026c979f4115c02558912ab": {
      "atom_id": "atom::0026c979f4115c02558912ab",
      "source_handle": "P0166",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "抗生素预处理",
        "finding": "抗生素清除肠道菌群后，细菌转移减少，DC活化及多能性CD8+ T细胞反应降低，ICT疗效显著减弱；而补充具有转移能力的特定菌株（E. faecalis, E. coli）可部分恢复疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::2e9d04f26801dd865478b2325419bb8e1dd13e02db4445be4faa56bf0b09fb66",
      "multiple_values_in_field": true
    },
    "atom::c9157c61680949278a6f46a6": {
      "atom_id": "atom::c9157c61680949278a6f46a6",
      "source_handle": "P0166",
      "field_path": [
