    "atom::c2494f38351f5d4ca09c6a2b": {
      "atom_id": "atom::c2494f38351f5d4ca09c6a2b",
      "source_handle": "P0166",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了ICT增强抗肿瘤免疫的一个具体物理机制：肠道细菌的物理转移。它填补了‘微生物存在’与‘远端免疫反应’之间的因果链条空白，特别指出了树突状细胞作为载体和肠系膜淋巴结作为中转站的关键角色。对于综述而言，这是解释‘为什么肠道菌群影响远处肿瘤’的重要机制性证据。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::7183fab48388d36a56b62d987c632c16fff03658268bd633dc3c06815dde26df",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::a27f8fe0d177b89ae019d1dd5088d4bba9b592c09a4f1b33918bb3fc041b1b61",
      "multiple_values_in_field": false
    },
    "atom::211d66f0682eaee4a689e3ec": {
      "atom_id": "atom::211d66f0682eaee4a689e3ec",
      "source_handle": "P0166",
      "field_path": [
