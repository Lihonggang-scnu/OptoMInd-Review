    "atom::317335c57bd28c508a68a6e4": {
      "atom_id": "atom::317335c57bd28c508a68a6e4",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "可作为讨论微生物疗法安全性或“疗效-毒性解耦”潜力的一个具体案例，尽管其机制尚待阐明。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::3db6f696cb499fb5e3fc0fd683c6d62b7506721591afbc6b1b36b98710b2dfd4",
      "multiple_values_in_field": true
    },
    "atom::db13e38b7140591be2a93a13": {
      "atom_id": "atom::db13e38b7140591be2a93a13",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "实例：微生物代谢物对免疫治疗副作用（irAEs）的潜在调节作用。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::964176ec5c24b1f11369177f28496b677089ebdd88091facd1a7d956e5627ed7",
      "multiple_values_in_field": true
    },
    "atom::d09b8a9594eb1b512fbd4ae9": {
      "atom_id": "atom::d09b8a9594eb1b512fbd4ae9",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制主要基于小鼠模型；体外DC成熟需要LPS共刺激，体内具体触发条件尚不完全清楚。",
        "contribution": "揭示了DAT增强ICI疗效的分子机制依赖于宿主IFN-I信号通路（通过Ifnar1-/-小鼠验证），并展示了DAT在体外直接促进T细胞活化和DC成熟（需共刺激）的能力。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::da5db680514b14c8ce836287f3c41b5171494c5b60785a295f6a8c1a43f56291",
      "multiple_values_in_field": true
    },
    "atom::fa22f3485ee715d6d58b9806": {
      "atom_id": "atom::fa22f3485ee715d6d58b9806",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中阐述微生物代谢物如何跨越肠-血屏障影响远端免疫系统的具体分子路径，特别是IFN-I信号在连接微生物信号与适应性免疫中的作用。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::95acd48f50fc2f0476b86dfc099996e50fdda84f51a468b7c68b42b585d11662",
      "multiple_values_in_field": true
    },
    "atom::970a4082112ed9c38f16ae1b": {
      "atom_id": "atom::970a4082112ed9c38f16ae1b",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "DAT并未恢复菌群多样性，仅改善了功能输出；效果不如在正常菌群小鼠中显著。",
        "contribution": "证明了在广谱抗生素诱导的肠道菌群严重失调（模拟临床常见耐药情境）下，外源性补充DAT仍能部分恢复ICI（抗CTLA-4）的抗肿瘤疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::da5db680514b14c8ce836287f3c41b5171494c5b60785a295f6a8c1a43f56291",
      "multiple_values_in_field": true
    },
    "atom::2b98ef3d675ea1cc29d2de85": {
      "atom_id": "atom::2b98ef3d675ea1cc29d2de85",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于讨论肠道菌群完整性对ICI疗效的重要性，以及当菌群受损时，单一代谢物补充是否足以替代复杂菌群功能的实证材料。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::95acd48f50fc2f0476b86dfc099996e50fdda84f51a468b7c68b42b585d11662",
      "multiple_values_in_field": true
    },
    "atom::59f2b3186a5ea5b50d9a0a4c": {
      "atom_id": "atom::59f2b3186a5ea5b50d9a0a4c",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "作者明确指出菌群变化的因果贡献尚不明确，可能是伴随现象。",
        "contribution": "观察到DAT补充改变了肠道菌群结构（增加拟杆菌目等），并提示这种改变可能与有益反应相关，但未确立因果关系。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
