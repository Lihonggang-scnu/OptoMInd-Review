    },
    "atom::3549c78bc8da71f89495a609": {
      "atom_id": "atom::3549c78bc8da71f89495a609",
      "source_handle": "P0388",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制基于合成抗原模型，实际人体内是否存在完全相同的克隆型迁移和表型转换尚需临床数据支持；未涉及髓系细胞或其他免疫细胞的具体贡献细节。",
        "contribution": "揭示了具体的细胞机制：肠道源性ex-T_H17细胞通过分泌IFN-γ和TNF重塑TME，促进CD8+ TILs的招募和活化；并阐明了CD4+与CD8+ T细胞在微生物辅助的ICI治疗中的协同必要性。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::918c405d68674ca01927bd101046af17c04cf0fb78364d6fb3395e982482ad6f",
      "multiple_values_in_field": true
    },
    "atom::857ae9ce025f343ae75c5f0f": {
      "atom_id": "atom::857ae9ce025f343ae75c5f0f",
      "source_handle": "P0388",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
