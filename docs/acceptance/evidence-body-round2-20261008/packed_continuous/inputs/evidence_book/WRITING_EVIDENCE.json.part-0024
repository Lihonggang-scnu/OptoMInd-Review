      "variant_group": "field::5afc8e797b24781a1d8d603f0f74a5e481dee3d9f33d6b74f15b0fd7f8f9c6d3",
      "multiple_values_in_field": true
    },
    "atom::5f0c1a6df76b96cdc6ad0ad4": {
      "atom_id": "atom::5f0c1a6df76b96cdc6ad0ad4",
      "source_handle": "P0085",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于Snyder等人及Balachandran等人的临床研究数据",
        "finding": "在长期生存的胰腺癌患者中，发现针对新抗原的T细胞同时也能够交叉反应于同源的非癌症微生物抗原（如巨细胞病毒、人乳头瘤病毒等），表明微生物暴露史与新抗原免疫原性存在关联。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::db10b53b05a00fdea360343b9e0a064a7ac55c09c6307188143e40b52856bb77",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::200283b5ce5d543ed285b60010d7843cc7f0c9a11f7920d4b72eb92bc76f1507",
      "multiple_values_in_field": true
    },
    "atom::95344087d6be0ca146dd23ac": {
      "atom_id": "atom::95344087d6be0ca146dd23ac",
      "source_handle": "P0085",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "TCR生物学特性及体外实验证据",
        "finding": "TCR具有广泛的交叉反应能力，单个TCR克隆可识别约一百万种不同序列的肽段；新抗原与自身抗原及外源抗原（微生物）在TCR接触位点的相似性决定了其“外来性”程度及免疫原性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::db10b53b05a00fdea360343b9e0a064a7ac55c09c6307188143e40b52856bb77",
          "field_path": [
