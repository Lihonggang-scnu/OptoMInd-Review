    },
    "atom::2d6b0f5be9ac6177edd0917b": {
      "atom_id": "atom::2d6b0f5be9ac6177edd0917b",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性综述方法，综合现有文献，从两个主要维度展开：一是机制层面，分析肠道微生物群及其代谢物如何通过炎症信号、血管生成及特定免疫细胞亚群（如Th17, TAMs, MDSCs, Tregs）的重塑来构建免疫抑制性TME；二是临床转化层面，梳理微生物群特征与ICI及CAR-T疗效关联的证据，并总结基于微生物群的干预策略（如FMT、饮食调整、抗生素管理）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::b290f7a93e1b352c22ac6a025caaf99b2deb55f9bd33693795513b7dc223e8ea",
      "multiple_values_in_field": false
    },
    "atom::cbc566b73e38d625363c1e7e": {
      "atom_id": "atom::cbc566b73e38d625363c1e7e",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物群调控肿瘤免疫逃逸的多细胞机制框架，特别是细化了Th17/IL-17轴、TAM极化及PGE2信号在连接微生物与TME中的作用。",
        "limits": "作为综述，未提供新的原始实验数据；许多机制描述基于动物模型或相关性研究，因果链条在人体内的普遍性尚待验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::d150f041072abda023d1dea614aedffaddc2eb8c61bc275ae711340c399a605d",
      "multiple_values_in_field": true
    },
    "atom::7422ea58075663d76f3d7681": {
      "atom_id": "atom::7422ea58075663d76f3d7681",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "总结了微生物群组成预测ICI疗效的生物标志物潜力，并列出了具体的有益/有害菌种（如Faecalibacterium, Bifidobacterium, Akkermansia）。",
        "limits": "不同研究中菌群与疗效的关系存在矛盾（如拟杆菌在不同癌种或疗法下的相反作用），综述指出了这种复杂性但未给出统一的预测规则。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::d150f041072abda023d1dea614aedffaddc2eb8c61bc275ae711340c399a605d",
      "multiple_values_in_field": true
    },
    "atom::fbcfb3c2ea90da5bc2d1291e": {
      "atom_id": "atom::fbcfb3c2ea90da5bc2d1291e",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了通过FMT、益生菌、饮食纤维补充及抗生素局部清除等策略优化免疫治疗效果的临床路径。",
        "limits": "所提及的干预措施大多处于前临床阶段或小规模临床试验初期，缺乏大规模随机对照试验的支持；摘要未交代具体的检索数据库、时间范围及纳入排除标准。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::d150f041072abda023d1dea614aedffaddc2eb8c61bc275ae711340c399a605d",
      "multiple_values_in_field": true
    },
    "atom::f86c504ca097bdba4b893e5b": {
      "atom_id": "atom::f86c504ca097bdba4b893e5b",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "针对结直肠癌（CRC）模型及人类样本",
        "finding": "特定菌群（如具核梭杆菌 F. nucleatum、产肠毒素脆弱拟杆菌 ETBF）通过诱导M2型TAM极化、抑制CD8+ T细胞浸润或激活STAT3通路，促进肿瘤免疫逃逸和进展。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::499dc95b2af3e946959d1c085b7a7880037cee807b3888a81b0c561b9fc44e6f",
      "multiple_values_in_field": true
    },
    "atom::bbdd0c32bab6d639929c4dd7": {
      "atom_id": "atom::bbdd0c32bab6d639929c4dd7",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "黑色素瘤小鼠模型及PD-1阻断治疗患者",
        "finding": "粪便微生物群移植显示，来自“响应者”的菌群能增强PD-1阻断疗效，增加TME中CD8+ T细胞的活化与浸润；而来自“无响应者”的菌群则无效。双歧杆菌和阿克曼氏菌被证实有助于恢复ICI疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::499dc95b2af3e946959d1c085b7a7880037cee807b3888a81b0c561b9fc44e6f",
      "multiple_values_in_field": true
    },
    "atom::2476a8703a2e47e5d81126fa": {
      "atom_id": "atom::2476a8703a2e47e5d81126fa",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "CTLA-4阻断治疗模型",
        "finding": "某些拟杆菌属（Bacteroides species）通过促进IL-12依赖性的TH1免疫反应增强CTLA-4阻断剂的疗效；但在MSS型CRC中，丰富的拟杆菌可能反而增加Tregs和MDSCs，降低PD-1阻断疗效，显示菌群作用的语境依赖性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
