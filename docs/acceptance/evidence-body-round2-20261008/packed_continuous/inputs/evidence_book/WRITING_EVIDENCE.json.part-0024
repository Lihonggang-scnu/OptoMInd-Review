      "multiple_values_in_field": true
    },
    "atom::45c1d3a0900b76a03cf3aef7": {
      "atom_id": "atom::45c1d3a0900b76a03cf3aef7",
      "source_handle": "P0242",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "单菌定植实验",
        "finding": "从HMB中鉴定的革兰氏阳性厌氧菌Coprobacillus cateniformis单菌定植即可重现HMB的抗肿瘤效果，并显著下调DCs上的PD-L2表达；其表面提取物在体外也能通过MYD88依赖途径抑制PD-L2表达。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::50f6b2c5ac9bd691e19ea9f541284d3dea71a1ff000f8ff332560edd0e0fb6aa",
          "field_path": [
            "study_summary_A",
