    "atom::f605c5022d6c7fd992a64555": {
      "atom_id": "atom::f605c5022d6c7fd992a64555",
      "source_handle": "P0444",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
