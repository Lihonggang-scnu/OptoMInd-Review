    "atom::0233dfb9e934c6136eff77e5": {
      "atom_id": "atom::0233dfb9e934c6136eff77e5",
      "source_handle": "P0388",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限于SFB这一特定菌种及与其抗原匹配的肿瘤模型；未涵盖其他常见益生菌或致病菌的作用。",
        "contribution": "提供了肠道微生物增强ICI疗效的具体生物学路径：SFB定植通过抗原交叉反应，使肠道T_H17细胞迁移至肿瘤并转化为效应状态，从而增强抗肿瘤免疫。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
