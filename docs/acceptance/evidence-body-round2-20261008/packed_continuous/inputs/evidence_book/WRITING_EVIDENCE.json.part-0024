            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::deefc6d18e659cd7ebe27ac2d501d8d33cfe470de9f635bda371fe9fdaf724f5",
      "multiple_values_in_field": true
    },
