    "atom::24143feb8db5e66298440946": {
      "atom_id": "atom::24143feb8db5e66298440946",
      "source_handle": "P0284",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "To discuss methodological considerations in microbiome research, highlighting the value of integrating culture-based methods with sequencing for functional discovery.",
