    },
    "atom::42843a4e5e9d7c60de7057bc": {
      "atom_id": "atom::42843a4e5e9d7c60de7057bc",
      "source_handle": "P0560",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "多数机制细节来自小鼠模型（如无菌鼠、人源化鼠）；人体内的确切分子通路（如特定受体TLR2/NLRP3的具体作用）仍需更多临床验证；作者提出的机制多为假设性或相关性解释，非确证性因果证据。",
        "contribution": "详细阐述了微生物群调节ICI疗效的潜在机制，包括：1）通过代谢物（如肌苷、SCFAs）直接调节T细胞功能；2）通过抗原呈递细胞（DCs）成熟影响T细胞活化；3）通过调节TME中的抑制性细胞（Tregs, MDSCs, M2 TAMs）改变免疫微环境。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::c774ab52f529690104f010242146f1291362fca70aae98d95265d4af6279523b",
      "multiple_values_in_field": true
    },
    "atom::75bd59cf69fe4176d058e64f": {
      "atom_id": "atom::75bd59cf69fe4176d058e64f",
      "source_handle": "P0560",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“机制是什么”的问题；解释微生物群如何通过间接途径（非直接接触肿瘤细胞）影响免疫治疗；为设计联合疗法（如ICI+益生菌/FMT）提供理论依据。",
      "role": "planning",
      "origins": [
        {
