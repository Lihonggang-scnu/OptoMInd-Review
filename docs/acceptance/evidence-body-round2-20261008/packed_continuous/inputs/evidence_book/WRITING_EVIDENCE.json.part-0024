            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::80a4e692b56476ed44bdb7d0ec0d5abf2c0bea988f3b5da10fcade9e9336a8aa",
      "multiple_values_in_field": false
    },
    "atom::cc66c3535d922c39c18a7f9d": {
      "atom_id": "atom::cc66c3535d922c39c18a7f9d",
      "source_handle": "P0388",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管临床数据显示肠道菌群组成与ICB疗效相关，但特定共生菌如何具体影响抗肿瘤免疫反应的因果机制尚不明确。特别是，肠道来源的抗原特异性T细胞是否能通过分子模拟识别肿瘤抗原并远程调控肿瘤免疫微环境？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::fd44ba0ac6ae3bc4814d030d48903d36333e6381ee963fd979be8d90a40b1930",
