      "variant_group": "field::94032fbd7f9a904b0d525402856bc98cca622e5dbb2b285c5462ca7bc191afeb",
      "multiple_values_in_field": true
    },
    "atom::b72644777a4fd00f9afde2f6": {
      "atom_id": "atom::b72644777a4fd00f9afde2f6",
      "source_handle": "P0242",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "RGMb条件性敲除小鼠",
        "finding": "仅在T细胞中敲除RGMb即可改善抗PD-L1治疗的抗肿瘤效果，而在巨噬细胞/粒细胞中敲除则无效，表明RGMb在T细胞上的抑制性信号是关键机制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::50f6b2c5ac9bd691e19ea9f541284d3dea71a1ff000f8ff332560edd0e0fb6aa",
