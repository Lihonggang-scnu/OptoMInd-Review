    "atom::423b87cb6e2ccf6e584bed2c": {
      "atom_id": "atom::423b87cb6e2ccf6e584bed2c",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "结果显示DAT不加重ICI诱导的结肠炎，反而可能减轻亚临床肠道炎症。"
      },
      "role": "evidence",
      "origins": [
        {
