    "atom::e351ade49033b6f5ef507a01": {
      "atom_id": "atom::e351ade49033b6f5ef507a01",
      "source_handle": "P0535",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "Highlights the complexity of the tumor microecology, suggesting that focusing solely on bacteria or gut may miss important synergistic effects.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
