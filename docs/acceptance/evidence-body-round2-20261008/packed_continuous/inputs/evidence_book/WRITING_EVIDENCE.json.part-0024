      "multiple_values_in_field": true
    },
    "atom::9c784ff7e97d2fe254cfb134": {
      "atom_id": "atom::9c784ff7e97d2fe254cfb134",
      "source_handle": "P0085",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "动物模型及临床相关性研究",
        "finding": "特定的肠道菌群（如双歧杆菌、拟杆菌属）与免疫检查点抑制剂（ICI）疗效相关，这种效应部分归因于记忆CD4 T细胞依赖的机制，暗示微生物抗原与新抗原之间的分子模拟可能是ICI起效的机制之一。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::db10b53b05a00fdea360343b9e0a064a7ac55c09c6307188143e40b52856bb77",
          "field_path": [
