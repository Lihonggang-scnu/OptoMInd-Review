    "atom::d609aff3bf1657c5765dacd6": {
      "atom_id": "atom::d609aff3bf1657c5765dacd6",
      "source_handle": "P0560",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "结论多基于回顾性研究、小样本队列或动物模型；不同癌症类型（如黑色素瘤 vs 结直肠癌）和不同ICI靶点（PD-1 vs CTLA-4）下菌群的作用可能截然不同，不可简单外推。",
        "contribution": "提供了肠道微生物群影响ICI疗效的具体证据和方向性结论。指出特定菌群（如双歧杆菌、阿克曼氏菌、部分拟杆菌）与ICI响应正相关，而另一些情况（如高丰度拟杆菌在MSS-CRC中）可能负相关。同时强调了抗生素滥用对ICI疗效的负面影响。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::c774ab52f529690104f010242146f1291362fca70aae98d95265d4af6279523b",
      "multiple_values_in_field": true
    },
    "atom::520623f53c445634054aa26c": {
      "atom_id": "atom::520623f53c445634054aa26c",
      "source_handle": "P0560",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于支持或反驳关于特定菌群与ICI疗效关联的论点；作为解释患者异质性的背景因素；用于讨论微生物群作为生物标志物的潜力。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
