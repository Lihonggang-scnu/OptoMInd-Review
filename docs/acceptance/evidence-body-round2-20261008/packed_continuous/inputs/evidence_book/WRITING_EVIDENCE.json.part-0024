            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::4f884aeeb10467ce515e5d3a7d5b3db1f600476ec47d23f80917924a880ae87b",
      "multiple_values_in_field": true
    },
