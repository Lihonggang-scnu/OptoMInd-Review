    "atom::81ba7ad99d2b68647f51f92c": {
      "atom_id": "atom::81ba7ad99d2b68647f51f92c",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些发现主要基于回顾性队列研究和动物模型，且涉及多种癌症类型（包括胃肠道癌），需结合具体实体瘤类型进行细化。",
        "contribution": "提供了具体的微生物标志物：指出Roseburia hominis富集与ICI响应正相关，Veillonella parvula与非响应相关；提到基于细菌分类群的预测模型（如Prevotella/Bacteroides比例）能准确预测PD-1/PD-L1单药治疗反应。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
