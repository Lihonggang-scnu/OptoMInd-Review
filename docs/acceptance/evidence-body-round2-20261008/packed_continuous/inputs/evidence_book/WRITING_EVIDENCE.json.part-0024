      ],
      "value": "用于回答“微生物调节ICI疗效的机制是什么”。特别适用于描述T细胞亚群的可塑性、肠道-肿瘤轴通讯以及CD4/CD8协作机制。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
