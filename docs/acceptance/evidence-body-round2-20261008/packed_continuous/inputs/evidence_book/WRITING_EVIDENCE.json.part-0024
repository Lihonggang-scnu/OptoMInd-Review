    "atom::d1b3b78fff1cfd7128085c82": {
      "atom_id": "atom::d1b3b78fff1cfd7128085c82",
      "source_handle": "P0154",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇综述，本研究未进行新的实验数据采集，而是通过系统性文献回顾，整合了关于皮肤微生物组组成、空间异质性、免疫调节机制以及临床干预措施的多学科证据。作者将材料组织为：1) 皮肤共生菌的组成与空间分布；2) 共生菌在免疫稳态中的作用机制；3) AD的免疫特征与失衡；4) 菌群-免疫-屏障的恶性循环；5) 基于微生物组的临床应用与未来疗法。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cf4c1b6e827b39baa70b33a919d27d76b14fff98b1c80f2839421faa28beeee5",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::6e680e80f98a27fb33b69494a7a7ff8d885e8031a674c9852d35d37f61ce2038",
      "multiple_values_in_field": false
    },
    "atom::9a05ab0f6a4ed411ae24a7f5": {
      "atom_id": "atom::9a05ab0f6a4ed411ae24a7f5",
      "source_handle": "P0154",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了AD病理中“菌群-免疫-屏障”三角关系的综合机制框架，特别是明确了共生菌代谢物（SCFAs, 色氨酸衍生物）对AHR和HDAC通路的调控作用。",
        "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及质量评价方法；部分机制描述基于动物模型或体外研究，其在人体内的确切效力尚需更多临床数据验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cf4c1b6e827b39baa70b33a919d27d76b14fff98b1c80f2839421faa28beeee5",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::57d69b3af267843c5f4e8ca9536b2f47fc38254114f656316fd253ce3b3a1b5b",
      "multiple_values_in_field": false
    },
    "atom::741772badca9ce611340d694": {
      "atom_id": "atom::741772badca9ce611340d694",
      "source_handle": "P0154",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "健康皮肤 vs AD皮损",
        "finding": "AD皮损中金黄色葡萄球菌（S. aureus）绝对丰度显著增加并与疾病严重程度正相关，而共生菌（如S. epidermidis, C. acnes）丰度降低，导致多样性下降（Shannon指数降低40-60%）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cf4c1b6e827b39baa70b33a919d27d76b14fff98b1c80f2839421faa28beeee5",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::ba2a9c7206f50d57660a66c1ad1c7b3c581ddcd2e83cb4b88d4ef61c9b246e73",
      "multiple_values_in_field": true
    },
    "atom::1c087ac177d0a23542443077": {
      "atom_id": "atom::1c087ac177d0a23542443077",
      "source_handle": "P0154",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "共生菌免疫调节机制",
        "finding": "S. epidermidis通过分泌抗菌肽抑制S. aureus，并通过TLR2信号诱导IL-1β/IL-6促进Th17分化同时上调Foxp3增强Treg功能；色氨酸代谢物（如IAId）作为AHR配体抑制TSLP表达，从而减轻Th2炎症。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cf4c1b6e827b39baa70b33a919d27d76b14fff98b1c80f2839421faa28beeee5",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::ba2a9c7206f50d57660a66c1ad1c7b3c581ddcd2e83cb4b88d4ef61c9b246e73",
      "multiple_values_in_field": true
    },
    "atom::679eb1daad55b087013bfa25": {
      "atom_id": "atom::679eb1daad55b087013bfa25",
      "source_handle": "P0154",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肠道-皮肤轴干预",
        "finding": "口服特定益生菌（如Limosilactobacillus fermentum SLAM216或Bifidobacterium组合）可降低儿童AD患者的SCORAD评分，机制涉及增加粪便短链脂肪酸浓度及调节肠道菌群比例。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cf4c1b6e827b39baa70b33a919d27d76b14fff98b1c80f2839421faa28beeee5",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::ba2a9c7206f50d57660a66c1ad1c7b3c581ddcd2e83cb4b88d4ef61c9b246e73",
      "multiple_values_in_field": true
    },
    "atom::5b1f0eb2fe91c950f3e6dd66": {
      "atom_id": "atom::5b1f0eb2fe91c950f3e6dd66",
      "source_handle": "P0154",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "传统疗法局限性与新疗法潜力",
        "finding": "Dupilumab虽有效但存在潜在淋巴瘤风险；靶向微生物组的疗法（如自体S. hominis A9菌株、噬菌体、内溶素）在早期临床试验中显示出修复屏障和抑制炎症的潜力，但仍处于Phase I/II阶段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cf4c1b6e827b39baa70b33a919d27d76b14fff98b1c80f2839421faa28beeee5",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::ba2a9c7206f50d57660a66c1ad1c7b3c581ddcd2e83cb4b88d4ef61c9b246e73",
      "multiple_values_in_field": true
    },
