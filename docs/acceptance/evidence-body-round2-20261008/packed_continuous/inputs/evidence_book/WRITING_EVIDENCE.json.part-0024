            "2"
          ]
        }
      ],
      "variant_group": "field::da5db680514b14c8ce836287f3c41b5171494c5b60785a295f6a8c1a43f56291",
      "multiple_values_in_field": true
    },
    "atom::a2baffddb0c12a00aa936724": {
      "atom_id": "atom::a2baffddb0c12a00aa936724",
      "source_handle": "P0195",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论微生物组重塑与代谢物补充之间的双向关系，作为菌群组成变化的一个案例。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
