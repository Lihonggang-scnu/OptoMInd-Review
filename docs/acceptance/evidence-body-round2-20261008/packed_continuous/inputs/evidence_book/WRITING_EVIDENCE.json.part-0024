    "atom::46836e81669d4392757543fc": {
      "atom_id": "atom::46836e81669d4392757543fc",
      "source_handle": "P0154",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "帮助读者理解微生物组不仅是病原体载体，更是主动的免疫调节者。这种基础免疫学原理对于理解肠道微生物组如何影响远端器官（如肿瘤微环境）的免疫状态具有概念上的迁移价值。",
      "role": "planning",
