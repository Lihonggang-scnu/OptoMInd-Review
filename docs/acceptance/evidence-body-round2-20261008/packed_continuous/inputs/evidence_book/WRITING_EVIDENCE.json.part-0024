          ]
        }
      ],
      "variant_group": "field::cab94706af255f1b5d431a185887857ff83774d5e7850f8ac559e5f0714f8074",
      "multiple_values_in_field": false
    },
    "atom::8618cf2ef9f8bc59c30802d7": {
      "atom_id": "atom::8618cf2ef9f8bc59c30802d7",
      "source_handle": "P0073",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "芯片暴露于非响应者（NR）粪便全样或上清",
        "finding": "上皮细胞紧密连接蛋白ZO-1和β-catenin显著下调，屏障通透性增加；内皮细胞ICAM-1上调，T细胞粘附增加；转录组显示应激缓冲能力下降、细胞周期抑制及促炎通路（TNF, IL-6, NF-κB）激活。"
      },
      "role": "evidence",
      "origins": [
