    "atom::6c7424e735d637988d2eced9": {
      "atom_id": "atom::6c7424e735d637988d2eced9",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "The clinical utility of ICIs is limited by interpatient variability in efficacy and the occurrence of systemic toxicities (irAEs). The review aims to systematically delineate the microbiome-metabolite-immune axis to understand these variations and optimize the balance between therapeutic gain and toxicity, ultimately guiding the development of precise microbial interventions.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::039b0e4d072e12bd65bd18ea1803ef67b1d121c33ee3d1dd4bfbb3fa87047c8b",
      "multiple_values_in_field": true
    },
    "atom::b70d300ebe4f7a632702a5f0": {
      "atom_id": "atom::b70d300ebe4f7a632702a5f0",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the gut microbiome and its metabolic byproducts as systemic regulators of immune function, specifically in the context of cancer immunotherapy using immune checkpoint inhibitors (ICIs). It covers mechanisms of ICI action (PD-1/PD-L1, CTLA-4, LAG-3, TIGIT, TIM-3), the heterogeneity of microbiome-ICI interactions across different cancer types and cohorts, microbial metabolites (tryptophan derivatives, SCFAs, TMAO, inosine, bile acids, polyamines) as mediators of efficacy and toxicity, and microbiome-based interventions including probiotics, FMT, postbiotics, and dietary fiber.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::aedb92ec416b9953e49754928e5e84aae6aa204d40c2305a14bc0881155c1edc",
      "multiple_values_in_field": true
    },
    "atom::e3b528b07174c7f2c4e9b9b5": {
      "atom_id": "atom::e3b528b07174c7f2c4e9b9b5",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This narrative review synthesizes current evidence on how the gut microbiota and microbe-derived metabolites regulate the efficacy and immune-related adverse events (irAEs) of ICIs. It highlights specific taxa like Bacteroides, Bifidobacterium, and Akkermansia muciniphila that potentiate therapeutic responses via pathways such as cGAS-STING and NOD2. The review also details how microbial metabolites protect organs like the heart and colon from inflammation while enhancing anti-tumor immunity. It evaluates emerging interventions like FMT and next-generation probiotics, noting that while preclinical and Phase I trials show feasibility, substantial hurdles remain regarding cohort heterogeneity, methodological standardization, and the need for large-scale longitudinal studies to establish reproducible predictive models.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::8fbf739cef7b75d2ad3e4af84afee3de52999b5a3cf0f8ccaa148d8f5181d50d",
      "multiple_values_in_field": true
    },
    "atom::7a16470a938828a019a65473": {
      "atom_id": "atom::7a16470a938828a019a65473",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "Critiques the reliance on single-taxa abundance, advocates for topology-based approaches, and highlights logistical barriers like metagenomic turnaround times for precision nutrition."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
