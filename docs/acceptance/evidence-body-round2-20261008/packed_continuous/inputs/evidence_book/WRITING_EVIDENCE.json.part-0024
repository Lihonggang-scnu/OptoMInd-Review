      "atom_id": "atom::995110f30544c2be6aece91c",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Many mechanistic insights are derived from preclinical models (mice) or small clinical cohorts; extrapolation to broader human populations requires caution.",
