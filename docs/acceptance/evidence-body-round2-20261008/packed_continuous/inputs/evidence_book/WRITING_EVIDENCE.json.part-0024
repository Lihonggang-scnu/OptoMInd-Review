      "multiple_values_in_field": true
    },
    "atom::5095fd431387ffd441d38baf": {
      "atom_id": "atom::5095fd431387ffd441d38baf",
      "source_handle": "P0242",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "GF小鼠定植患者粪便（CR vs NR）",
        "finding": "定植无响应者（NR）粪便的小鼠对PD-L1单药治疗无反应，但联合抗PD-L2治疗后肿瘤显著缩小且生存期延长，表明该策略可克服由患者自身微生物群导致的耐药。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::50f6b2c5ac9bd691e19ea9f541284d3dea71a1ff000f8ff332560edd0e0fb6aa",
          "field_path": [
