    "atom::6db51bfc8baee1a77b55af5f": {
      "atom_id": "atom::6db51bfc8baee1a77b55af5f",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "Offers examples of clinical interventions and their outcomes, useful for comparing different strategies to modulate the microbiome for improved ICI outcomes.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "1",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::7c0a1cb40b7de6da5b7a4f510132f0ef5c0334bf2bad0c29edc53fd543433998",
      "multiple_values_in_field": true
    },
    "atom::0cebf65ae6c2fb3a2b3291c3": {
      "atom_id": "atom::0cebf65ae6c2fb3a2b3291c3",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Findings are based on a synthesis of various studies with differing methodologies; causal relationships are often inferred from preclinical models or observational data rather than definitive clinical trials.",
        "contribution": "Details the context-dependent nature of microbiome-ICI interactions, showing that beneficial taxa vary by cancer type and ICI regimen (e.g., Bacteroides for CTLA-4, Faecalibacterium for PD-1, variable role of Akk). It also discusses the trade-off between efficacy and toxicity, noting that some microbes protective in one context may be detrimental in another.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::fb1abf63c32e0d714ba6e487104968c3c14d97c00b058333c81e9e4ff6c0edb7",
      "multiple_values_in_field": true
    },
    "atom::0014aa347c49025164ffa457": {
      "atom_id": "atom::0014aa347c49025164ffa457",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to explain why microbiome signatures are not universal and depend on specific treatment protocols and patient populations. Helps address questions about heterogeneity in ICI response.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5bde61981ec968b195286fcfa62ac72b464ad347efff85b79e1c8e32bf78d645",
      "multiple_values_in_field": true
    },
    "atom::a2d90e74ef12c1e1106eacf6": {
      "atom_id": "atom::a2d90e74ef12c1e1106eacf6",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Many mechanisms are described from murine models or in vitro studies; human concentration thresholds and spatial dynamics within the tumor microenvironment are noted as undefined.",
        "contribution": "Provides specific molecular mechanisms linking microbes/metabolites to immune modulation. For example, it describes how LGG and BF839 activate the cGAS-STING pathway, how tryptophan metabolites act via AhR, and how SCFAs influence T-cell function and barrier integrity through epigenetic and receptor-mediated pathways.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "review_planning_B",
