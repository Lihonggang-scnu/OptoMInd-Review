    "atom::bd05dd22bf395b6bb6a493e0": {
      "atom_id": "atom::bd05dd22bf395b6bb6a493e0",
      "source_handle": "P0284",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "In vivo murine tumor model with oral gavage of P. bifermentans derivatives",
        "finding": "Oral administration of P. bifermentans enhanced anti-tumor response to dual ICI; this beneficial effect was retained by cell-free supernatant filtered to < 3 kDa, indicating mediation by a small-molecule metabolite rather than live bacteria."
      },
      "role": "evidence",
