    },
    "atom::5ad79c8cd8f5e794f9d067b7": {
      "atom_id": "atom::5ad79c8cd8f5e794f9d067b7",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive synthesis of host-based biomarker candidates beyond tumour tissue, categorizing them into immune, genetic, phenotypic, and microbial domains. Highlights the potential for modifiable factors (diet, microbiome, medications) as targets for combination therapies.",
        "limits": "As a narrative review, it does not present new primary data. Many associations described are based on retrospective analyses or small prospective cohorts, lacking robust validation in large-scale randomized trials. Findings show significant heterogeneity across cancer types and study methodologies, limiting immediate clinical applicability. The review explicitly states that these are candidate biomarkers requiring further validation."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::75e8a124cf7a26fc5beafc2d4ce629fa3ac7317e98a56da8cad0a3322c8749c9",
      "multiple_values_in_field": false
    },
    "atom::581d07e319b88eadf79d493d": {
      "atom_id": "atom::581d07e319b88eadf79d493d",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Circulating immune factors",
        "finding": "High baseline neutrophil-to-lymphocyte ratio (NLR) is associated with worse ICI outcomes; eosinophilia is linked to better outcomes. Specific T-cell receptor (TCR) diversity in peripheral PD1+ CD8+ T cells correlates with improved progression-free survival in NSCLC. High IL-8 levels negatively correlate with efficacy."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::409d2d6e3d86737d971bbaad08c7bb09d7dd866ab826ed5c55496f39c9d7f3a9",
      "multiple_values_in_field": true
    },
    "atom::cf4c93036684481a24b171e9": {
      "atom_id": "atom::cf4c93036684481a24b171e9",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Germline genetics",
        "finding": "HLA-A*03 allele association with poorer OS was not consistently replicated. HLA-I heterozygosity and evolutionary divergence generally associate with better outcomes, though effects vary by cancer type (e.g., HLA-B44 supertype has opposite effects in melanoma vs. NSCLC). FCGR3A V158F SNP associates with improved response to ipilimumab in melanoma."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::409d2d6e3d86737d971bbaad08c7bb09d7dd866ab826ed5c55496f39c9d7f3a9",
      "multiple_values_in_field": true
    },
    "atom::b3cfba2f8f859a528c563271": {
      "atom_id": "atom::b3cfba2f8f859a528c563271",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Phenotypic and external features",
        "finding": "An 'obesity paradox' exists where higher BMI correlates with better ICI survival in some cancers, potentially mediated by leptin-induced PD1 expression on T cells. High cholesterol also correlates with better anti-PD1 outcomes. Gender effects are controversial. Corticosteroid use (for supportive care) negatively impacts ICI efficacy, while antihistamines may have a positive effect via histamine pathway modulation."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::409d2d6e3d86737d971bbaad08c7bb09d7dd866ab826ed5c55496f39c9d7f3a9",
      "multiple_values_in_field": true
    },
    "atom::066a2c2fbd5317027ece5054": {
      "atom_id": "atom::066a2c2fbd5317027ece5054",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Gut microbiota",
        "finding": "Baseline gut microbiota composition and diversity influence ICI efficacy. Specific genera (e.g., Bifidobacterium, Akkermansia) are often positively associated, while others (e.g., Bacteroides eggerthii) are negatively associated, though consensus is lacking due to methodological differences. Mechanisms include production of immunomodulatory metabolites (short-chain fatty acids, inosine), activation of innate immune receptors (NOD2, STING), and molecular mimicry between bacterial and tumour antigens."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::409d2d6e3d86737d971bbaad08c7bb09d7dd866ab826ed5c55496f39c9d7f3a9",
      "multiple_values_in_field": true
    },
