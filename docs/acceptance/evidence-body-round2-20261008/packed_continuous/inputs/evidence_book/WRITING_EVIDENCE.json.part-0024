    },
    "atom::86223da55d78e8184ad44dcf": {
      "atom_id": "atom::86223da55d78e8184ad44dcf",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review offers a structured framework for understanding the 'gut-metabolite-immune' axis in the context of solid tumor immunotherapy. It provides detailed mechanistic insights into how specific microbial taxa and metabolites modulate ICI efficacy and toxicity, serving as a valuable resource for explaining biological mechanisms and contextualizing clinical heterogeneity. It also summarizes the current state of microbiome-based interventions, highlighting both promising strategies and translational barriers.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::7e08b510a5a699a5e3192a6aeaa53c1b439fe73619f8c40e4e2781756cbf672e",
      "multiple_values_in_field": true
    },
    "atom::74ec76742b9f6daf3762643e": {
      "atom_id": "atom::74ec76742b9f6daf3762643e",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review is a narrative synthesis and does not provide quantitative meta-analytic results; effect sizes and statistical significance should not be inferred from this text alone.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
