      "variant_group": "field::918c405d68674ca01927bd101046af17c04cf0fb78364d6fb3395e982482ad6f",
      "multiple_values_in_field": true
    },
    "atom::2ed8a3b5d2adb1a3b401d76d": {
      "atom_id": "atom::2ed8a3b5d2adb1a3b401d76d",
      "source_handle": "P0388",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于说明并非所有能与肿瘤抗原交叉反应的微生物都能改善预后，强调初始免疫程序（Th17 vs Treg）的重要性。可用于讨论微生物疗法的选择标准或失败案例的分析框架。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
