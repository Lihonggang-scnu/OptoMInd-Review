    "atom::b5dd6e8c5547a883130fa0bf": {
      "atom_id": "atom::b5dd6e8c5547a883130fa0bf",
      "source_handle": "P0166",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅针对联合抗PD-1/CTLA-4治疗；未区分单药治疗的差异。",
        "contribution": "证明了肠道细菌的存在和转移是ICT疗效的必要条件（通过抗生素耗竭实验证实），且特定转移菌种（如E. faecalis）的回补可恢复疗效。",
        "facet_id": "F1"
