    "atom::57feddb267d9dc7107db6e17": {
      "atom_id": "atom::57feddb267d9dc7107db6e17",
      "source_handle": "P0388",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅针对Hh这一特定菌种；结果取决于该菌在稳态下诱导调节性T细胞的特性。",
        "contribution": "提供了阴性对照证据：H. hepaticus虽能诱导抗原特异性T细胞迁移至肿瘤，但因诱导Foxp3+调节性表型而非效应表型，故不能增强ICI疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e3a78d4894569a6b30fe168fbeb52e8a1b5dd79bc79810b37e8ca5b1b0623dba",
          "field_path": [
