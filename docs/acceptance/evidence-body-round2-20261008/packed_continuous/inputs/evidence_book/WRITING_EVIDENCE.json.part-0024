    },
    "atom::fc1e295c2ab5cc778e7db888": {
      "atom_id": "atom::fc1e295c2ab5cc778e7db888",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "口服DAT干预7天",
        "finding": "改变肠道菌群组成，降低α多样性，增加拟杆菌目（Bacteroidales）和伯克霍尔德菌目（Burkholderiales）的相对丰度，减少梭菌纲（Clostridia）丰度。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f4dd731b745b7c3e483c254790ecac5316734e313a926d8cc187e0653c886263",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "5"
          ]
        }
      ],
      "variant_group": "field::77751789e65955468c4edfefccb1e77b01125cec4eaae9d5f1c748647543e82e",
      "multiple_values_in_field": true
    },
    "atom::e27f805573a80b8a3f3788e3": {
      "atom_id": "atom::e27f805573a80b8a3f3788e3",
      "source_handle": "P0195",
      "field_path": [
        "study_summary_A",
