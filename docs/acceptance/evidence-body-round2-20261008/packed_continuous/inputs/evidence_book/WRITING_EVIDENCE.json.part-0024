    "atom::14e691e33244b8717f4d127f": {
      "atom_id": "atom::14e691e33244b8717f4d127f",
      "source_handle": "P0284",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The research design involves three main components: 1) Clinical Cohort Analysis: Retrospective and prospective analysis of three independent cohorts (melanoma and NSCLC) to assess the association between irAE grades and survival outcomes, correcting for immortal time bias. 2) Microbiome Profiling: Shotgun metagenomics and high-throughput culturomics were performed on fecal samples from patients at baseline and at the onset of ir-colitis to characterize taxonomic shifts and isolate viable bacteria. 3) Functional Validation: Fecal microbiota transplantation (FMT) from ir-colitis patients into antibiotic-treated mice to assess effects on tumor growth and inflammation. Specific isolates (P. bifermentans, C. paraputrificum, P. sordellii) were tested in vitro (Caco-2 co-culture for barrier integrity and cytokine expression) and in vivo (oral gavage in DSS colitis and MCA-205 tumor models) to determine direct effects. Cell-free supernatants and heat-killed bacteria were also tested to distinguish live-bacteria-dependent effects from metabolite-mediated effects.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::c58901e6515c3facd7a044dd86097061d020f1340a66e451142001a9c51eac73",
      "multiple_values_in_field": false
    },
    "atom::7338e32444ea409cd35d5626": {
      "atom_id": "atom::7338e32444ea409cd35d5626",
      "source_handle": "P0284",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides empirical evidence linking specific gut bacteria (P. bifermentans) to both irAE pathogenesis and enhanced ICI efficacy through distinct mechanisms (barrier disruption vs. metabolite secretion).",
        "limits": "The exact nature of the active < 3 kDa metabolite and its precise immune mechanism remain unidentified. The study relies on a limited number of matched longitudinal samples and mouse models that may not fully recapitulate human ir-colitis complexity."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
          "field_path": [
