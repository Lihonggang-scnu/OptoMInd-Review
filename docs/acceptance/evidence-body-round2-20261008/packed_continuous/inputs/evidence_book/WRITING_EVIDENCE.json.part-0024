    "atom::031338a121dcefffb44b207b": {
      "atom_id": "atom::031338a121dcefffb44b207b",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To address the unpredictability of tumour responses to ICIs and the limitations of current tumour-centric biomarkers (such as PD-L1, TMB, and MMR deficiency) which require invasive tissue sampling and lack cross-cancer generalizability. The review aims to identify and evaluate host-based factors that could offer better pre-treatment prediction of ICI benefit.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::bbd324906405f13a67a84c378920aa940470d6cfda760b9e7f458904b11cea30",
      "multiple_values_in_field": false
    },
    "atom::3c83913156da7e0539bfa5a2": {
      "atom_id": "atom::3c83913156da7e0539bfa5a2",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on host factors influencing the response of patients with solid tumours to immune checkpoint inhibitors (ICIs). It covers circulating immune compartments, germline genetic features, phenotypic and external features (exposome), and gut microbial features.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::373c593399a08edf143e484eba918c1a7da17522e2370eae8a7d0898344f41a1",
      "multiple_values_in_field": false
    },
    "atom::82cc9e6fd19a61ef6fee2b48": {
      "atom_id": "atom::82cc9e6fd19a61ef6fee2b48",
      "source_handle": "P0269",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This review article synthesizes emerging evidence regarding non-tumour-centric host factors that may serve as predictive biomarkers for ICI efficacy. The authors argue that current FDA-approved biomarkers are limited by their reliance on tumour tissue and poor generalizability across cancer types. Consequently, they explore alternative host-based predictors, including peripheral blood immune markers (e.g., neutrophil-to-lymphocyte ratio, eosinophils, TCR repertoire), germline genetics (e.g., HLA alleles, Fc-gamma receptor polymorphisms), phenotypic traits (e.g., obesity, cholesterol, gender), exogenous factors (e.g., medications like corticosteroids or antibiotics, diet), and specifically the gut microbiota. The paper highlights the potential modifiability of several factors, suggesting avenues for co-therapies to enhance ICI therapeutic index.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::f1388e7276e30d6b93b3045f15937c72996bd5f92410d1e8a39c2e491b989430",
      "multiple_values_in_field": false
    },
    "atom::c424b1ec5f22edc8c8467b99": {
      "atom_id": "atom::c424b1ec5f22edc8c8467b99",
      "source_handle": "P0269",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "Summaries of circulating immune markers (NLR, eosinophils), germline genetics (HLA, FCGR3A), and phenotypic factors (obesity, cholesterol, gender) and their associations with ICI efficacy."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
