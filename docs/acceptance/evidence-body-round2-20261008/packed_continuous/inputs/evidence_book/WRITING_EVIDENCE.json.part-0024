            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::fb1abf63c32e0d714ba6e487104968c3c14d97c00b058333c81e9e4ff6c0edb7",
      "multiple_values_in_field": true
    },
    "atom::161e0009fa68315b39dbec41": {
      "atom_id": "atom::161e0009fa68315b39dbec41",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Offers detailed mechanistic explanations for how gut microbes influence ICI efficacy and toxicity, suitable for sections discussing biological pathways and molecular targets.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
