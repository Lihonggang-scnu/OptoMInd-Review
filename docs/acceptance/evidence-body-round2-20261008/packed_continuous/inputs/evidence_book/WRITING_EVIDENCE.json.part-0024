    "atom::56b7494e3ac63fd5336cede7": {
      "atom_id": "atom::56b7494e3ac63fd5336cede7",
      "source_handle": "P0444",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "MMR-d/MSI-H前瞻性纵向队列",
        "finding": "MEP通路丰度在响应者中更高，并与较低的功能性菌群失调相关；核黄素合成通路在非响应者中随时间上调。"
      },
      "role": "evidence",
