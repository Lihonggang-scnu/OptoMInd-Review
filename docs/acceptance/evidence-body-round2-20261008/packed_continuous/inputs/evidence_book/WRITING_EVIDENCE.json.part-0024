    "atom::765ffc9d516e0e2dacb55ce7": {
      "atom_id": "atom::765ffc9d516e0e2dacb55ce7",
      "source_handle": "P0154",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为微生物组靶向治疗可行性的佐证，尽管疾病领域不同，但展示了从机制发现到临床转化的路径和挑战（如菌株特异性、个体差异）。可用于讨论微生物组疗法的普遍性挑战或前景。",
      "role": "planning",
      "origins": [
        {
