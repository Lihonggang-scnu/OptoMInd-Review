    "atom::f6d31f17449d65516fa7cb1b": {
      "atom_id": "atom::f6d31f17449d65516fa7cb1b",
      "source_handle": "P0269",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Associations are observational and inconsistent across studies. The review emphasizes that these are correlations, not proven causal relationships for all contexts. Clinical endpoints vary (ORR, PFS, OS).",
        "contribution": "Lists specific gut bacterial species and genera (e.g., Akkermansia muciniphila, Bifidobacterium spp., Bacteroides eggerthii) that have been associated with positive or negative ICI outcomes in various solid tumour cohorts. Notes the lack of consensus and potential reasons for discrepancies (methodology, geography, cancer type).",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::cf93261d72ee0656c7fa52cbc2df875754fc78d8134b308cb1b3c0c1458ab413",
      "multiple_values_in_field": true
    },
    "atom::372c5f1dfc8d2bffaae31265": {
      "atom_id": "atom::372c5f1dfc8d2bffaae31265",
      "source_handle": "P0269",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to compile a list of candidate microbial taxa for the review's analysis of which microbes are consistently linked to ICI response. Helps identify the complexity of microbial signals (single species vs. consortia).",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::9712641b2fb9f0597c19079bcb14a7662cbc433e4e44b267ee53a4539b2c9aeb",
          "field_path": [
