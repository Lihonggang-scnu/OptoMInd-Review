    "atom::e3512766ef2d4d52a7760066": {
      "atom_id": "atom::e3512766ef2d4d52a7760066",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conducted a narrative review, synthesizing evidence from historical milestones, recent high-throughput sequencing studies, spatial profiling, and mechanistic in vitro/in vivo experiments. They organized the content into thematic sections: historical/methodological foundations, bacterial characterization (origin/diversity), effects on tumor initiation/progression, roles in metastasis, immune crosstalk, diagnostic/prognostic value, and therapeutic applications. The review integrates findings from various cancer types, emphasizing context-dependency and methodological rigor (e.g., distinguishing correlation from causation, addressing contamination issues).",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::51f0ae5a121eb9a71b7685e1fe32cc29919908538ff6c1d5494545b36d2fc50a",
      "multiple_values_in_field": false
    },
    "atom::73b1770797f173cefdb41660": {
      "atom_id": "atom::73b1770797f173cefdb41660",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive framework linking intratumoral bacteria to all stages of cancer progression, from initiation to metastasis and therapy response. Highlights the bidirectional nature of immune modulation and the importance of context-dependency.",
        "limits": "As a review, it synthesizes existing literature rather than generating new primary data. Many cited mechanisms are based on specific model systems (e.g., mouse models, cell lines) or correlative human studies; causal relationships in humans require further validation. The field faces significant methodological challenges regarding low biomass and contamination that limit the robustness of some conclusions."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::e6ca9161a59fab48eb8fc334fc3fa2002e9bed72c43b25ceda8d5e9ee5664aa8",
      "multiple_values_in_field": false
    },
    "atom::008594d9c6e5593d51ba00ca": {
      "atom_id": "atom::008594d9c6e5593d51ba00ca",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Across multiple solid tumors, using sequencing and spatial methods",
        "finding": "Intratumoral bacteria are prevalent, tissue-specific, and metabolically active, not merely contaminants. Their composition varies significantly by cancer type and anatomical site."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::22c3b9b3cff20ca9b45ae7299fa49accf5c741b33c72a146a1ce0b4b14d70afa",
      "multiple_values_in_field": true
    },
    "atom::949f2edad1df44d7aa77d089": {
      "atom_id": "atom::949f2edad1df44d7aa77d089",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Mechanistic studies (in vitro/vivo)",
        "finding": "Bacteria like Fusobacterium nucleatum (Fn) and Enterotoxigenic Bacteroides fragilis (ETBF) promote tumorigenesis via genomic instability (colibactin, fragilysin), epigenetic reprogramming, and activation of oncogenic pathways (Wnt/β-catenin, PI3K/AKT)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::22c3b9b3cff20ca9b45ae7299fa49accf5c741b33c72a146a1ce0b4b14d70afa",
      "multiple_values_in_field": true
    },
    "atom::78c302486e7f21f1e486dcec": {
      "atom_id": "atom::78c302486e7f21f1e486dcec",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Metastasis models",
        "finding": "Intratumoral bacteria facilitate metastasis by inducing EMT, remodeling host cell cytoskeletons to resist shear stress, promoting angiogenesis, and establishing pre-metastatic niches via extracellular vesicles and vascular barrier disruption."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::22c3b9b3cff20ca9b45ae7299fa49accf5c741b33c72a146a1ce0b4b14d70afa",
      "multiple_values_in_field": true
    },
    "atom::c51f2463bfce37ed4a4790da": {
      "atom_id": "atom::c51f2463bfce37ed4a4790da",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Immune modulation contexts",
        "finding": "Effects are bidirectional and context-dependent. Pro-tumor bacteria (e.g., Fn, P. gingivalis) often induce immunosuppression (MDSC recruitment, T-cell exhaustion, PD-L1 upregulation), while beneficial taxa (e.g., Bifidobacterium, Akkermansia) can enhance anti-tumor immunity and improve responses to immune checkpoint inhibitors (ICIs)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::22c3b9b3cff20ca9b45ae7299fa49accf5c741b33c72a146a1ce0b4b14d70afa",
      "multiple_values_in_field": true
    },
    "atom::3874e95eeb3bb1557b3306e6": {
      "atom_id": "atom::3874e95eeb3bb1557b3306e6",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Clinical cohorts",
        "finding": "Specific microbial signatures correlate with patient prognosis and survival. Intratumoral bacteria also influence response to chemotherapy (resistance or sensitization), radiotherapy, and immunotherapy, suggesting potential as biomarkers and therapeutic targets."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::22c3b9b3cff20ca9b45ae7299fa49accf5c741b33c72a146a1ce0b4b14d70afa",
      "multiple_values_in_field": true
    },
    "atom::f33da6121926988664675bc5": {
      "atom_id": "atom::f33da6121926988664675bc5",
      "source_handle": "P0535",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
