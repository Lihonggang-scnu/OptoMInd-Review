    "atom::eff2c324f099469aba355172": {
      "atom_id": "atom::eff2c324f099469aba355172",
      "source_handle": "P0444",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "该结论基于宏基因组推断的功能潜力，需结合代谢组数据佐证；不同肿瘤类型的基线失调程度存在差异（如结直肠癌较高）。",
        "contribution": "提供了微生物组功能谱（代谢通路）比物种组成更稳定且更能预测ICB疗效的证据。指出功能性菌群失调程度与非响应正相关，且在治疗过程中恶化。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::623b881452a1bbc406a2e4b5ccbaee8bad2a82c4620e4cc62784608108dda1d1",
