    "atom::0f435c1b5c789138bfe0378f": {
      "atom_id": "atom::0f435c1b5c789138bfe0378f",
      "source_handle": "P0284",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "To provide context on statistical challenges in observational oncology studies involving time-dependent covariates like irAEs.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
