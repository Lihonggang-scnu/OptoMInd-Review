        }
      ],
      "variant_group": "field::499dc95b2af3e946959d1c085b7a7880037cee807b3888a81b0c561b9fc44e6f",
      "multiple_values_in_field": true
    },
    "atom::a1bf0e7e1d636a7829511552": {
      "atom_id": "atom::a1bf0e7e1d636a7829511552",
      "source_handle": "P0560",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "CAR-T治疗小鼠模型",
        "finding": "广谱抗生素使用削弱CAR-T疗效，而万古霉素筛选后的菌群可通过维持IL-12水平增强抗肿瘤T细胞功能；短链脂肪酸（SCFAs）等代谢物通过表观遗传修饰（如抑制HDAC）影响效应分子表达。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a727ee3f2d2808f7e298f50d8690e2cac74446410e738cc1590c3f97c65575fe",
