    "atom::9edc6a56f4559f6669964526": {
      "atom_id": "atom::9edc6a56f4559f6669964526",
      "source_handle": "P0444",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "PDTO与PBMC共培养体系",
        "finding": "产HMBPP细菌的上清液通过BTN3A1/2/3受体特异性激活Vδ2 T细胞，增强其对肿瘤类器官的杀伤作用；核黄素前体5-OP-RU诱导MAIT细胞增殖并抑制CD4+ T细胞的增殖与活化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::623b881452a1bbc406a2e4b5ccbaee8bad2a82c4620e4cc62784608108dda1d1",
          "field_path": [
