            "0"
          ]
        }
      ],
      "variant_group": "field::94032fbd7f9a904b0d525402856bc98cca622e5dbb2b285c5462ca7bc191afeb",
      "multiple_values_in_field": true
    },
    "atom::02fe730e65f5325fef85f568": {
      "atom_id": "atom::02fe730e65f5325fef85f568",
      "source_handle": "P0242",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "GF或ABX小鼠，MC38/B16等肿瘤模型",
        "finding": "单独使用抗PD-L1或抗PD-1无法抑制这些模型中的肿瘤生长；但联合使用抗PD-L2（阻断RGMb相互作用）或抗RGMb抗体可显著抑制肿瘤生长，证明PD-L2/RGMb通路介导了微生物依赖性的耐药。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::50f6b2c5ac9bd691e19ea9f541284d3dea71a1ff000f8ff332560edd0e0fb6aa",
          "field_path": [
