    "atom::782ec3f7244d0ab076658c3c": {
      "atom_id": "atom::782ec3f7244d0ab076658c3c",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conducted a comprehensive literature search across PubMed/MEDLINE, Web of Science Core Collection, and Embase up to May 1, 2026. They included original studies, RCTs, cohort studies, and preclinical investigations examining the effects of gut microbiota or metabolites on ICI efficacy or toxicities. Data extraction was guided by STORMS guidelines. As a narrative review, formal risk-of-bias assessment, quality grading, and statistical meta-analysis were not performed. The synthesis is organized thematically: first covering ICI mechanisms, then the heterogeneity of microbiome-ICI interactions, followed by specific metabolite classes, clinical heterogeneity of irAEs, and finally microbiome-based interventions.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::bb5eb4bfd56825e2ae776a7e3458ad60715c6d90049a29c2f7675af8c68c75c4",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::a13c9c26bcd420313c543d747e01a81080d5049384eb726545e01242db38d78b",
      "multiple_values_in_field": true
    },
    "atom::d7e9648a9d3a228b80acd4f6": {
      "atom_id": "atom::d7e9648a9d3a228b80acd4f6",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive mechanistic synthesis linking specific gut microbes and metabolites to ICI efficacy and irAE mitigation, categorizing interventions by their molecular targets (STING, NOD2, AhR, etc.).",
        "limits": "As a narrative review, it lacks formal risk-of-bias assessment and statistical meta-analysis. Findings are largely derived from preclinical models or small clinical cohorts with limited covariate adjustment. The review acknowledges significant methodological heterogeneity across studies and notes that many proposed biomarkers and interventions require validation in large-scale, standardized longitudinal studies."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::40f0854379f8b3542a576b91e8a7bb6c258d39f083e4c06427e07d66eef9325f",
          "field_path": [
            "study_summary_A",
