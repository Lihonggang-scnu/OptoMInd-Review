    "atom::1c86cb9f75c28b1d4e2c2bd4": {
      "atom_id": "atom::1c86cb9f75c28b1d4e2c2bd4",
      "source_handle": "P0242",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ABX/HMB vs ABX小鼠，MC38肿瘤模型",
        "finding": "定植健康人微生物群显著增强了抗PD-L1治疗的效果，表现为肿瘤内CD8+ T细胞比例增加、耗竭标志物减少及效应功能增强；同时，在引流淋巴结中， responder小鼠的DCs上PD-L2表达显著降低，而PD-L1升高。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::50f6b2c5ac9bd691e19ea9f541284d3dea71a1ff000f8ff332560edd0e0fb6aa",
          "field_path": [
            "study_summary_A",
