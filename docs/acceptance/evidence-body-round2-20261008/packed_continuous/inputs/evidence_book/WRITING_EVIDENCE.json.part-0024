    "atom::59df00ee7bafe5a463382045": {
      "atom_id": "atom::59df00ee7bafe5a463382045",
      "source_handle": "P0535",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "Provides insight into potential interventions to modulate the microbiome-ICI axis, complementing the mechanistic discussion.",
      "role": "planning",
