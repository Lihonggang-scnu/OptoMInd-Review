    "atom::ba339e0712a59351affb82d5": {
      "atom_id": "atom::ba339e0712a59351affb82d5",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制研究多在小鼠模型中进行，人体内的确切通路仍需更多临床验证。",
        "contribution": "阐明了微生物组增强ICI疗效的机制：口服活体乳酸杆菌可增加Lactobacillus murinus和Bacteroides uniformis丰度，通过cGAS/STING轴激活树突状细胞IFN-β产生，进而促进CD8+ T细胞浸润肿瘤；微生物组缺失会削弱CpG-ODN和anti-IL-10R诱导的TNF表达和抗肿瘤效果。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::47a80ac03f96178482c3b8a31acc1cead6c956a0e15f3c2778c58cdf7c1e80a1",
      "multiple_values_in_field": true
    },
    "atom::af24fc1ff639f6068b69e179": {
      "atom_id": "atom::af24fc1ff639f6068b69e179",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释“微生物组如何通过免疫通路调节ICI疗效”，提供分子机制（cGAS/STING, IFN-β, CD8+ T cells）和细胞因子（TNF）层面的证据。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::430122166fbc7d1e8e970af5bffe1e2eae774c0ce363fa492b1a4d154824b9b0",
      "multiple_values_in_field": true
    },
    "atom::c1f2cea1b4ca1341506f1933": {
      "atom_id": "atom::c1f2cea1b4ca1341506f1933",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要针对特定化疗药物（奥沙利铂、5-FU），不一定适用于所有化疗方案。",
        "contribution": "揭示了微生物组影响化疗疗效的机制：微生物核糖核苷酸代谢影响氟尿嘧啶（5-FU）疗效；微生物介导的ROS产生依赖于是氧化铂的抗肿瘤效应；微生物组调控TNF表达影响联合免疫治疗效果。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::47a80ac03f96178482c3b8a31acc1cead6c956a0e15f3c2778c58cdf7c1e80a1",
      "multiple_values_in_field": true
    },
    "atom::a05afdf5917379e6a04367f0": {
      "atom_id": "atom::a05afdf5917379e6a04367f0",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于补充“微生物组不仅影响免疫治疗，也影响化疗”的机制细节，展示微生物组对药物代谢的直接干预。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::430122166fbc7d1e8e970af5bffe1e2eae774c0ce363fa492b1a4d154824b9b0",
      "multiple_values_in_field": true
    },
    "atom::a53346d912c074c14a042c14": {
      "atom_id": "atom::a53346d912c074c14a042c14",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "目前主要处于临床前小鼠模型阶段，尚未成为标准临床实践。",
        "contribution": "提出了工程菌作为增强ICI疗效的新机制：工程菌携带同步裂解电路（SLC）递送PD-L1或CTLA-4纳米抗体，或在肿瘤局部表达GM-CSF，从而系统性激活T细胞反应。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "3"
          ]
        }
      ],
      "variant_group": "field::47a80ac03f96178482c3b8a31acc1cead6c956a0e15f3c2778c58cdf7c1e80a1",
      "multiple_values_in_field": true
    },
    "atom::2da5a75bf997424980ca3a6f": {
      "atom_id": "atom::2da5a75bf997424980ca3a6f",
      "source_handle": "P0132",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于探讨“未来可能的干预机制”或“工程菌如何克服现有ICI耐药”，提供合成生物学角度的机制假设。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
