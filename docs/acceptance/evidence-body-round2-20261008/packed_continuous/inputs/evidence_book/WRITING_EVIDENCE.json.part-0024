    "atom::c0d91dd32d0f6a42456ab635": {
      "atom_id": "atom::c0d91dd32d0f6a42456ab635",
      "source_handle": "P0132",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了微生物组在代谢、肿瘤和感染三大领域作用机制的系统性框架，特别强调了工程菌在精准医疗中的多样化角色（传感、治疗、诊断）。",
        "limits": "作为综述，其结论依赖于引用的原始研究，未提供新的实验数据；对工程菌临床转化的描述主要基于作者对现有文献的综合，实际临床成功率（如SYNB1020的失败案例）提示了当前技术的局限性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::5f9fa7a48e7bd91a8e717c513483bf629d61137274f1caa9fbe48c4815f051e6",
      "multiple_values_in_field": false
    },
    "atom::dabcf19be6b96384e19654a4": {
      "atom_id": "atom::dabcf19be6b96384e19654a4",
      "source_handle": "P0132",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "代谢疾病模型中",
        "finding": "微生物组通过分泌短链脂肪酸（SCFA）、次级胆汁酸和TMAO等代谢物调节宿主代谢；同时，肠道屏障功能障碍导致的低度全身性炎症是代谢疾病的重要驱动因素。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::6252d0212b8167e1277952155e842f18859af4eefca762822dc999cc29b0fe43",
      "multiple_values_in_field": true
    },
    "atom::d30edb082bd96350ff790439": {
      "atom_id": "atom::d30edb082bd96350ff790439",
      "source_handle": "P0132",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肿瘤治疗背景下",
        "finding": "特定肠道菌群组成（如Roseburia hominis富集、Prevotella/Bacteroides比例高）与免疫检查点抑制剂（ICIs）的良好响应相关；而某些菌群（如Veillonella parvula）与非响应相关。微生物组还通过ROS产生、药物代谢（如5-FU）和TNF激活影响化疗效果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::6252d0212b8167e1277952155e842f18859af4eefca762822dc999cc29b0fe43",
      "multiple_values_in_field": true
    },
    "atom::218c82f1989acf02ccf45fb4": {
      "atom_id": "atom::218c82f1989acf02ccf45fb4",
      "source_handle": "P0132",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "病原体感染背景下",
        "finding": "共生微生物组通过营养竞争、抗菌素分泌（直接途径）和激活宿主免疫/产生抗菌肽（间接途径）提供定植抗力。工程菌可设计为感知病原体信号（如CAI-1）并释放毒素或酶进行靶向清除。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::6252d0212b8167e1277952155e842f18859af4eefca762822dc999cc29b0fe43",
      "multiple_values_in_field": true
    },
