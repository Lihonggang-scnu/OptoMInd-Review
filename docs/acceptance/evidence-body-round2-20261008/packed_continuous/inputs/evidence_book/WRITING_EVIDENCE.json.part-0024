    "atom::de73fe9ade530a582fbcc4a4": {
      "atom_id": "atom::de73fe9ade530a582fbcc4a4",
      "source_handle": "P0284",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "The study aims to resolve the mechanism underlying the observed correlation between irAEs and improved ICI efficacy. Specifically, it seeks to determine if specific gut microbial signatures predict irAEs and efficacy, and to identify causal bacterial agents that might drive both inflammation and anti-tumor responses.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::de053a39f10d1178f4ac9bde3ce8a9f27081f5f991be38a4bb2e06f2ab9859d5",
      "multiple_values_in_field": false
    },
    "atom::70fc3918076487e962a70529": {
      "atom_id": "atom::70fc3918076487e962a70529",
      "source_handle": "P0284",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The study focuses on patients with advanced melanoma and non-small cell lung cancer (NSCLC) treated with immune checkpoint inhibitors (ICI). It investigates the relationship between gut microbiome composition, the development of immune-related adverse events (irAEs), and clinical outcomes (overall survival and progression-free survival). The research combines clinical cohort analysis with shotgun metagenomics and culturomics to identify specific bacterial taxa and their functional roles.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::c627bd086785572d5b9878b742fbfe0020174506c8ed8fe71aeced14157bda6f",
      "multiple_values_in_field": false
    },
    "atom::4ae76f027dd241b7100eeee0": {
      "atom_id": "atom::4ae76f027dd241b7100eeee0",
      "source_handle": "P0284",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This study addresses the paradoxical link between immune-related adverse events (irAEs) and improved efficacy in ICI therapy by dissecting the role of the gut microbiome. Using three independent cohorts totaling 589 patients with melanoma or NSCLC, the authors first validated that grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias. They then employed a combined approach of shotgun metagenomics and culturomics on fecal samples collected at baseline and during ir-colitis onset. Metagenomic analysis revealed that patients developing irAEs had lower alpha diversity and enrichment of pro-inflammatory taxa such as Ruminococcus gnavus and Streptococcus vestibularis. Culturomics identified Paraclostridium bifermentans as enriched in patients with acute ir-colitis. Functional validation in mice demonstrated that fecal microbiota transplantation from an ir-colitis patient induced subclinical colitis markers and enhanced anti-tumor activity of dual ICI. Specifically, P. bifermentans was shown to disrupt epithelial barrier integrity in vitro and exacerbate colitis in vivo via live bacteria interaction, while its anti-tumor benefit was mediated by a secreted low-molecular-weight metabolite (< 3 kDa). These findings provide a mechanistic link suggesting that specific pro-inflammatory bacteria can simultaneously drive toxicity and enhance therapeutic efficacy.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::3ae57b67ed7826a9ba5b352a40f7dc31db381f92bf3d1e276b9715d8fe021db0",
      "multiple_values_in_field": false
    },
    "atom::3aba09de1928023c017e60a8": {
      "atom_id": "atom::3aba09de1928023c017e60a8",
      "source_handle": "P0284",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "Comparison of metagenomics and culturomics results showing that culturomics recovers live, low-abundance bacteria (like P. bifermentans) missed or less characterized by sequencing alone."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a",
          "field_path": [
