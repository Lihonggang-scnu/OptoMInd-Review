          {
            "source_handle": "P0001",
            "title": "Mapping the knowledge landscape: a bibliometric analysis of gut microbiota in cancer immunotherapy with implications for clinical translation.",
            "year": "2025",
            "doi": "10.1097/js9.0000000000004476",
            "paper_id": "005941dd5c78609a6e5458830a4371f729017fb3",
            "material_depth": "abstract",
            "material_status": "resolved",
            "aliases": [],
            "study_summary_A": {
              "approach": "采用文献计量学（Bibliometrics）分析方法。具体步骤包括：1. 数据检索：从Web of Science Core Collection检索2001-2025年间的相关文献；2. 筛选：严格筛选后纳入2,669篇出版物；3. 工具与分析参数：使用CiteSpace软件，设置时间切片为1年，每切片Top N=50，采用Pathfinder剪枝算法；4. 分析维度：涵盖时间发表趋势、合作网络（国家/机构/作者）、关键词共现、聚类分析及突现词检测（Burst Detection）。",
              "contribution_and_limits": [
                {
                  "contribution": "提供了癌症免疫治疗与肠道微生物群交叉领域的宏观知识图谱，明确了“微生物-免疫-肿瘤”三角框架的结构特征。",
                  "limits": "作为文献计量学研究，仅反映文献出版层面的统计规律（如引用、合作、关键词频率），未深入探讨具体的生物学机制或临床疗效数据。所给摘要未交代具体的机制细节，仅提及背景中已知的代谢物分泌、免疫细胞调节等一般性机制。"
                }
              ],
              "key_findings": [
                {
                  "conditions": "2001-2025年 WoSCC 数据库",
                  "finding": "研究领域呈现“萌芽-发展-爆发”三阶段增长模式，2024年达到峰值（525篇文章）。"
                },
                {
                  "conditions": "国家合作网络",
                  "finding": "中国（988篇）和美国（762篇）是高产国家；英国具有最高中心性（0.30），是全球合作枢纽。"
                },
                {
                  "conditions": "机构合作网络",
                  "finding": "德克萨斯大学系统（149篇）、INSERM（124篇）和MD Anderson癌症中心（123篇）是高产机构；加州大学系统具有最高中心性（0.19）。"
                },
                {
                  "conditions": "作者影响力",
                  "finding": "发文量前三的作者为Zitvogel, Laurence (50篇), Routy, Bertrand (47篇), Wargo, Jennifer A (39篇)；高中心性作者包括Kroemer, Guido等。"
                },
                {
                  "conditions": "关键词分析",
                  "finding": "高频关键词为gut microbiota, immunotherapy, colorectal cancer；高中心性关键词为immunotherapy, t cells, gut microbiota；新兴突现关键词为microsatellite instability, health, diversity。"
                },
                {
                  "conditions": "聚类分析",
                  "finding": "揭示五大主要研究方向：免疫检查点抑制剂、乳腺癌、结直肠癌、疗效、肿瘤微环境。"
                }
              ],
              "paper_kind": "review",
              "problem_or_question": "随着癌症免疫治疗中肠道微生物群相关研究的迅速增加，传统定性综述方法难以系统性地分析该领域的知识结构、热点演变趋势及跨学科动态。本研究旨在解决如何从宏观层面梳理这一快速增长领域的知识图谱，识别关键研究者、机构及新兴研究方向的问题。",
              "research_scope": "该研究聚焦于癌症免疫治疗领域，具体考察肠道微生物群（gut microbiota）与免疫检查点抑制剂（ICIs）疗效之间的关系。研究对象为2001年1月1日至2025年7月7日期间在Web of Science核心合集（WoSCC）中发表的文献，涵盖国家、机构、作者及关键词等 bibliometric 指标。",
              "work_summary": "这是一篇基于文献计量学的综述论文，旨在绘制癌症免疫治疗中肠道微生物群研究的“知识景观”。鉴于该领域文献爆炸式增长且传统综述难以系统分析其知识结构，作者利用CiteSpace软件对筛选出的2,669篇文献进行定量分析。研究通过时间切片、合作网络、关键词共现、聚类及突现检测等方法，揭示了该领域的增长模式、主要贡献者、国际合作格局以及新兴热点，最终构建了一个“微生物-免疫-肿瘤”三角知识框架，并为未来个性化免疫治疗策略的临床转化提供了宏观视角。"
            },
            "review_planning_B": {
              "planning_summary": "该论文为综述提供了关于“肠道微生物群-免疫检查点抑制剂”领域宏观结构、研究热点演变及主要贡献者的全景式背景素材。它不直接回答具体的分子机制，但能帮助用户定位该领域的知识边界、核心议题（如结直肠癌、MSI状态）及关键学术共同体，适用于综述的引言背景、领域现状描述及未来方向展望部分。",
              "facet_contributions": [
                {
                  "boundaries": "仅提供文献分布统计，不直接提供微生物调节ICI疗效的具体临床效果大小或异质性数据。",
                  "contribution": "提供了该领域研究规模的宏观证据，确认了肠道微生物群与ICI疗效关联已成为一个独立且快速扩张的研究子领域。指出了结直肠癌（colorectal cancer）和免疫检查点抑制剂（immune checkpoint inhibitor）是该领域最核心的关键词集群，暗示了在这些特定癌种中微生物调节ICI疗效的研究最为集中。",
                  "facet_id": "F1",
                  "possible_uses": "用于综述中论证该研究方向的活跃度和重要性；作为背景说明为何选择关注特定癌种（如结直肠癌）中的微生物效应；展示该领域已从基础探索进入爆发期。"
                },
                {
                  "boundaries": "关键词突现代表关注度上升，不代表机制已被完全阐明。摘要未提供具体的分子通路细节，需结合其他实证研究论文来填充具体的机制链条。",
                  "contribution": "通过关键词突现分析（burst detection），识别出“microsatellite instability (MSI)”、“diversity”和“t cells”作为新兴热点。这表明当前机制研究的前沿可能集中在MSI状态下的微生物特征、微生物多样性对T细胞浸润的影响等方面。同时，聚类结果指向“tumor microenvironment”（肿瘤微环境）为主要研究方向之一。",
                  "facet_id": "F2",
                  "possible_uses": "帮助规划综述中机制部分的侧重点，提示读者关注MSI和T细胞相关的微生物机制是当前热点；作为寻找后续具体机制文献的线索（例如搜索包含这些关键词的具体实验研究）。"
                }
              ],
