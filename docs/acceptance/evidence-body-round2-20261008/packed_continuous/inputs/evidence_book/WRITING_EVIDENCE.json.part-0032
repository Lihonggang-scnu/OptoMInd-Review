      "multiple_values_in_field": true
    },
    "atom::4f421cf3b56d28545ad0ddd8": {
      "atom_id": "atom::4f421cf3b56d28545ad0ddd8",
      "source_handle": "P0472",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠黑色素瘤模型",
        "finding": "补充商业益生菌（如长双歧杆菌、鼠李糖乳杆菌）反而导致肿瘤增大，伴随浸润性IFN-γ产生CD8+ T细胞频率降低；而罗伊氏乳杆菌（L. reuteri）通过释放吲哚-3-甲醛（I3A）激活AhR受体，增强了抗肿瘤免疫。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca0cd8cf75bc9b1aa650c230b683b301f22d44519b8b9e055b3ce5b2a5e50c3e",
          "field_path": [
            "study_summary_A",
