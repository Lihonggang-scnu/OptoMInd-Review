            "3"
          ]
        }
      ],
      "variant_group": "field::6a545f5f27a0eaf87c2d8c8530e96b1279b767e189fe1090555ddd028c9578e2",
      "multiple_values_in_field": true
    },
    "atom::f5cc992ca1f801835d1ca7de": {
      "atom_id": "atom::f5cc992ca1f801835d1ca7de",
      "source_handle": "P0472",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "自身免疫性疾病（如多发性硬化症、类风湿关节炎）",
        "finding": "SCFA（如丙酸）补充可增加调节性T细胞（Tregs）数量和功能，表明其在免疫调节方面的潜力，但在肿瘤学中尚未系统应用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca0cd8cf75bc9b1aa650c230b683b301f22d44519b8b9e055b3ce5b2a5e50c3e",
