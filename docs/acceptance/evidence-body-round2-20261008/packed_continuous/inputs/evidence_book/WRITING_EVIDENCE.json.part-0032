    "atom::325542a47112ac639ab70471": {
      "atom_id": "atom::325542a47112ac639ab70471",
      "source_handle": "P0472",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "黑色素瘤患者接受CIT治疗",
        "finding": "响应者血浆中乳酸水平显著高于非响应者，而丙酮酸水平较低，提示响应者T细胞向糖酵解模式发生代谢重编程；而非响应者血清中丙酮酸和丙氨酸水平较高。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca0cd8cf75bc9b1aa650c230b683b301f22d44519b8b9e055b3ce5b2a5e50c3e",
          "field_path": [
