    "atom::cfb9703de7d635e116138ace": {
      "atom_id": "atom::cfb9703de7d635e116138ace",
      "source_handle": "P0055",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是理论假设和早期证据的汇总，许多机制（如具体的交叉反应肽段、特定的代谢物浓度阈值）尚未在人体中得到完全验证或量化。",
        "contribution": "提出了一个系统的机制分类框架，区分了四种主要信使类型（活细菌/MAMPs、代谢物、细胞因子、免疫细胞）及其对应的免疫效应（增强抗原性、佐剂效应、旁观者激活、抑制性调节）。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be68bb0094ea724179acc24003ec835c6c88c7eaba3ff43870323ebac375ca65",
