    },
    "atom::eec2b77994e394a2fefd9cff": {
      "atom_id": "atom::eec2b77994e394a2fefd9cff",
      "source_handle": "P0310",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "敏感性分析：排除接受静脉注射抗生素或因感染住院的患者后",
        "finding": "抗生素暴露组（Abx+）的生存劣势依然存在，HR为1.7（95% CI 1.2-2.4）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cbe0edda2ebe4eadd9e19df3564ad6771cff4ada58ee339a5655f3aba217db93",
          "field_path": [
