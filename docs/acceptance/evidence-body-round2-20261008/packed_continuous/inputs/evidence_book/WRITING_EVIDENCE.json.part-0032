    "atom::d3346c6e9544214a13e3fbb7": {
      "atom_id": "atom::d3346c6e9544214a13e3fbb7",
      "source_handle": "P0055",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用文献综述法。作者检索并综合了关于宿主-微生物互作的基础研究、利用无菌/悉生小鼠进行的机制探索、以及人类临床队列中微生物组特征与治疗反应关联的研究。文章按逻辑模块组织材料：1) 方法论基础；2) 因果证据（从动物到人类）；3) 潜在机制分类（信使类型与免疫效应）；4) 临床应用潜力。未进行新的原始数据收集或系统性Meta分析统计，而是对现有分散证据进行定性归纳和理论框架构建。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be68bb0094ea724179acc24003ec835c6c88c7eaba3ff43870323ebac375ca65",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::84d63ee2dbed78d45b0408850f3583cd840379ed01ae32b7b4d5271cdef6368d",
      "multiple_values_in_field": false
    },
    "atom::88ecd8fa60772b6b885bc028": {
      "atom_id": "atom::88ecd8fa60772b6b885bc028",
      "source_handle": "P0055",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物组影响癌症免疫治疗疗效的综合性机制框架，将分散的实验证据归类为‘信使’（活菌、代谢物、分子模式、细胞因子）和‘效应’（抗原性、佐剂性、旁观者激活）两大维度。",
        "limits": "作为综述，其结论依赖于所引用的原始研究的质量和设计；对于具体菌株在不同人群中的普适性、非细菌组分（真菌、病毒）的作用以及长期安全性等问题的解答仍不充分，属于待研究领域。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be68bb0094ea724179acc24003ec835c6c88c7eaba3ff43870323ebac375ca65",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::46fb6e86ae3d1567fa9c782b7a7aa0757b01c5f3bd53453f0c267112c5d04f5f",
      "multiple_values_in_field": false
    },
    "atom::4374e070f05d81910f56d2a0": {
      "atom_id": "atom::4374e070f05d81910f56d2a0",
      "source_handle": "P0055",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于无菌小鼠模型及人类临床观察",
        "finding": "特定肠道细菌（如双歧杆菌、阿克曼氏菌、拟杆菌属某些种）的存在与对ICB（抗PD-1/CTLA-4）的良好治疗反应正相关，而其他菌群则与耐药或毒性相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be68bb0094ea724179acc24003ec835c6c88c7eaba3ff43870323ebac375ca65",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::080e5d02323ab3b0a54e5db649c419a2c72525c86dd69c1d96653a0aec27257d",
      "multiple_values_in_field": true
    },
    "atom::fedf14dfcbb0e473c9635b14": {
      "atom_id": "atom::fedf14dfcbb0e473c9635b14",
      "source_handle": "P0055",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "机制层面",
        "finding": "微生物可通过多种途径调节免疫：1) 交叉反应性T细胞识别细菌与肿瘤共同抗原；2) MAMPs/PAMPs作为佐剂激活树突状细胞（DCs）；3) 微生物代谢物（如SCFAs）调节免疫细胞功能；4) 诱导局部细胞因子（如IL-12, IL-22）产生系统性影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be68bb0094ea724179acc24003ec835c6c88c7eaba3ff43870323ebac375ca65",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::080e5d02323ab3b0a54e5db649c419a2c72525c86dd69c1d96653a0aec27257d",
      "multiple_values_in_field": true
    },
    "atom::6d16ee714b2e06d982b7651b": {
      "atom_id": "atom::6d16ee714b2e06d982b7651b",
      "source_handle": "P0055",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "临床转化角度",
        "finding": "抗生素使用可能损害ICB疗效；粪便微生物移植（FMT）和特定益生菌/代谢物补充具有改善预后的潜力，但尚处于早期临床试验阶段，且存在个体差异和安全性不确定性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::be68bb0094ea724179acc24003ec835c6c88c7eaba3ff43870323ebac375ca65",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::080e5d02323ab3b0a54e5db649c419a2c72525c86dd69c1d96653a0aec27257d",
      "multiple_values_in_field": true
    },
