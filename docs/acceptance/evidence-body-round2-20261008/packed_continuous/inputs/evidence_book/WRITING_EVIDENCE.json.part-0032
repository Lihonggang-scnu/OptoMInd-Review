    "atom::fc24e6f8a740d9022003f91f": {
      "atom_id": "atom::fc24e6f8a740d9022003f91f",
      "source_handle": "P0126",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "提供临床转化的警示和方向：单纯使用抗生素清除微生物虽能减毒，但可能损害ICB疗效，暗示需要更精准的靶向策略。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::d77a8c0088cfe726193fbc3d84c3f36ee4e72626d48da0759330942407601237",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0",
            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::4834580ed50ccf47980a38cf98ee13715b7e2a28a5e7a657f691c42ee4a9bd72",
      "multiple_values_in_field": true
    },
