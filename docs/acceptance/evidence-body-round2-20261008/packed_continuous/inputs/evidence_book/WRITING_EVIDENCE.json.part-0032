    "atom::833afba9b6b749222c5ed1c3": {
      "atom_id": "atom::833afba9b6b749222c5ed1c3",
      "source_handle": "P0001",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用文献计量学（Bibliometrics）分析方法。具体步骤包括：1. 数据检索：从Web of Science Core Collection检索2001-2025年间的相关文献；2. 筛选：严格筛选后纳入2,669篇出版物；3. 工具与分析参数：使用CiteSpace软件，设置时间切片为1年，每切片Top N=50，采用Pathfinder剪枝算法；4. 分析维度：涵盖时间发表趋势、合作网络（国家/机构/作者）、关键词共现、聚类分析及突现词检测（Burst Detection）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::31f0697c16433c30310122eaf0d0d33be79ed6bd2930fdc2f580dc8140608a81",
      "multiple_values_in_field": false
    },
    "atom::86c93f51292f6ba5a9010b79": {
      "atom_id": "atom::86c93f51292f6ba5a9010b79",
      "source_handle": "P0001",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了癌症免疫治疗与肠道微生物群交叉领域的宏观知识图谱，明确了“微生物-免疫-肿瘤”三角框架的结构特征。",
        "limits": "作为文献计量学研究，仅反映文献出版层面的统计规律（如引用、合作、关键词频率），未深入探讨具体的生物学机制或临床疗效数据。所给摘要未交代具体的机制细节，仅提及背景中已知的代谢物分泌、免疫细胞调节等一般性机制。"
      },
      "role": "evidence",
      "origins": [
