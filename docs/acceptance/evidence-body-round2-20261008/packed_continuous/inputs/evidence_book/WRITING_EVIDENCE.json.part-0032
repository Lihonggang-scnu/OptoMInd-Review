            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::0b9cbe84785f8a3591d9d5bb722fb2abbf0829fcedf104ce5ff55d67bc783647",
      "multiple_values_in_field": true
    },
