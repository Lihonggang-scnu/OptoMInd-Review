          ]
        }
      ],
      "variant_group": "field::7faa83caca7e396af085b3865107ef2b21fafe5b08f4cef7254b12e20dd6bbd0",
      "multiple_values_in_field": true
    },
    "atom::0649fd2cf2b24636e15937e2": {
      "atom_id": "atom::0649fd2cf2b24636e15937e2",
      "source_handle": "P0149",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究结果来自小鼠模型，不能直接外推至人类患者的临床疗效或安全性预测。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::458437782a562f994cbafc812c61da07c559fa9cf0d4ede375d00d4231da3938",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::cc7c748822de1f64a7ef030451e88ccbe54a894dd7437c2cf5ef07c82570b99c",
      "multiple_values_in_field": true
    },
    "atom::e288f8e5544a91be2eaaa961": {
      "atom_id": "atom::e288f8e5544a91be2eaaa961",
      "source_handle": "P0149",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "研究聚焦于心脏毒性机制，未涉及肠道菌群，因此不能直接用于回答菌群如何调节ICI疗效的问题，仅能提供机制层面的旁证或背景。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::458437782a562f994cbafc812c61da07c559fa9cf0d4ede375d00d4231da3938",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::cc7c748822de1f64a7ef030451e88ccbe54a894dd7437c2cf5ef07c82570b99c",
      "multiple_values_in_field": true
    },
    "atom::a9b0af20662549bd10035d57": {
      "atom_id": "atom::a9b0af20662549bd10035d57",
      "source_handle": "P0149",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "作者声称TNF阻断可保留抗肿瘤疗效，但这仅在特定小鼠模型中观察到，实际临床应用中需警惕TNF阻断对肿瘤微环境的潜在负面影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::458437782a562f994cbafc812c61da07c559fa9cf0d4ede375d00d4231da3938",
          "field_path": [
