    },
    "atom::7c0e2107b5b03c47befa9327": {
      "atom_id": "atom::7c0e2107b5b03c47befa9327",
      "source_handle": "P0472",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
