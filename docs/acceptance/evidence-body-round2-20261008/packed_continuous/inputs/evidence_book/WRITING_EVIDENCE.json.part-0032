
    },
    "atom::e6d5db0be949bca0b0eea954": {
      "atom_id": "atom::e6d5db0be949bca0b0eea954",
      "source_handle": "P0428",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅针对晚期黑色素瘤；样本量有限；主要基于相关性而非功能性验证。",
        "contribution": "提供了特定微生物类群（SCFA产生菌）与ICI疗效正相关的实证数据。发现响应者中F. prausnitzii及其他SCFA产生菌丰度显著高于耐药者。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::820c5fef183c1e2973da4cf6ef051dbdc5a260b40a12f028144c9bc5fb01561d",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::694a93c9b4e0fbc052663fb753db4850f45950aaa6747b3918eb67fb90d27d25",
      "multiple_values_in_field": true
    },
    "atom::402e42cccdbbfb03f3719b40": {
      "atom_id": "atom::402e42cccdbbfb03f3719b40",
      "source_handle": "P0428",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于支持“有益微生物促进ICI疗效”的观点，作为微生物组调节疗效的具体案例。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::820c5fef183c1e2973da4cf6ef051dbdc5a260b40a12f028144c9bc5fb01561d",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
