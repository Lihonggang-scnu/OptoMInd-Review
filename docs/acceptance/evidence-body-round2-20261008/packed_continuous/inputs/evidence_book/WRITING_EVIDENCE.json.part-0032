    "atom::0358fad2236acb82385888a5": {
      "atom_id": "atom::0358fad2236acb82385888a5",
      "source_handle": "P0302",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "本文研究的是口腔鳞状细胞癌（SCC）的化疗放疗反应，而非黑色素瘤或其他实体瘤的免疫检查点抑制剂（ICIs）反应。因此，其发现的微生物标志物（如Gemella, Prevotella）不能直接外推至ICIs疗效预测。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::25ed99df7ccdce29b4e0690045bbf72ca8e2ce6ccb9cda48c406f44fca8fee1a",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::83368e6e0a880ef9caf9985a2fb8ba7f617ade40836f55683d167f3a64ce2e4f",
      "multiple_values_in_field": true
    },
    "atom::8d400174eb4e66ce74983b9f": {
      "atom_id": "atom::8d400174eb4e66ce74983b9f",
      "source_handle": "P0302",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "DMBT1是一种唾液抗菌蛋白，主要参与先天免疫和病原体凝集，与ICIs作用的适应性免疫通路（PD-1/PD-L1, CTLA-4）不同。将其机制直接套用于ICIs需谨慎，应视为不同的免疫调节路径。",
      "role": "evidence",
      "origins": [
