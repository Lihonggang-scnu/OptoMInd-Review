      "atom_id": "atom::aacc55e816c49c511f23c40f",
      "source_handle": "P0295",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "提供从相关性到干预性的过渡素材，支持“微生物群是可调节的治疗靶点”这一论点。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::a5c3368011d84ece3131c8dde30de1dbc801a91e528e0f1c12feeb2411201cc8",
