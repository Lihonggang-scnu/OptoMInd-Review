      "variant_group": "field::c3c76b169ef5ac3f53117315cbca50a7b5002a780c4f6e07b05a75522e6be35c",
      "multiple_values_in_field": true
    },
    "atom::16877ef95490bf21b9b15a9b": {
      "atom_id": "atom::16877ef95490bf21b9b15a9b",
      "source_handle": "P0264",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制描述较为通用，未详细阐述针对实体瘤中特定ICI（如抗PD-1/PD-L1）的具体分子或细胞通路细节；未区分不同肿瘤类型的特异性机制。",
        "contribution": "描述了微生物组调节免疫反应的一般机制：微生物群落在上皮屏障表面定植，调节人体生理功能，特别是炎症和免疫。特定的细菌属或种已被鉴定为促进或拮抗不同类型癌症治疗或抗肿瘤宿主免疫反应。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::80fb38ea6982195853e8e4180231a8fa97d31593827a974bda6d72d1d23ad0c8",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
