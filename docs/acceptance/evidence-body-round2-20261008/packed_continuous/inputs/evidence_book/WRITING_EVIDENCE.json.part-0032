    "atom::d85047c537211385cef39384": {
      "atom_id": "atom::d85047c537211385cef39384",
      "source_handle": "P0040",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法。通过梳理文献，从基础生物学背景（肠道菌群功能、癌症微环境）出发，过渡到临床观察（益生菌对胃肠道毒性的缓解作用），再深入到分子机制层面（特定菌株对免疫检查点抑制剂的调节）。文章综合了体外实验、动物模型（FMT移植）和人体临床试验的结果，并对特定菌株LGG进行了专题深入分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a9cc67de57f6216f432e18b5daecf072589838cd65e7ed44461f4dd36d5babb2",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::eee961076b5bc0881c04eec959b9a556e9f14b6185a53c085c8e4c8c22c24fed",
      "multiple_values_in_field": false
    },
    "atom::edb4f97c95ad6d197c44f501": {
      "atom_id": "atom::edb4f97c95ad6d197c44f501",
      "source_handle": "P0040",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统综述了肠道微生物群调节免疫检查点抑制剂疗效的最新证据，并提供了益生菌缓解抗癌治疗胃肠道毒性的临床数据汇总。",
        "limits": "作为综述，其结论依赖于所引用的原始研究；对于益生菌增强免疫治疗疗效的机制多为相关性描述或动物模型推断，缺乏大规模前瞻性人体干预试验的直接因果证据；未提供具体的荟萃分析统计结果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a9cc67de57f6216f432e18b5daecf072589838cd65e7ed44461f4dd36d5babb2",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::c71525e915ba8ebc2d774728dfd91c8e0aa1bd2da555d7888169e4b837c0af16",
      "multiple_values_in_field": false
    },
    "atom::bba8ee6803b73e5fdd19167b": {
      "atom_id": "atom::bba8ee6803b73e5fdd19167b",
      "source_handle": "P0040",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "黑色素瘤患者接受抗PD-1/PD-L1免疫治疗",
        "finding": "作者转述了Routy等人和Gopalakrishnan等人的研究，发现响应者肠道中富集Akkermansia、Alistipes、Clostridiales等菌属；粪菌移植（FMT）至无菌小鼠可改善PD-1阻断疗效，表明特定肠道菌群能增强免疫检查点抑制剂的抗肿瘤效果。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a9cc67de57f6216f432e18b5daecf072589838cd65e7ed44461f4dd36d5babb2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::caff7a9cf24c196bd36b1b7d337e7826982821c5fb9b9fb4230343de9122f06d",
      "multiple_values_in_field": true
    },
    "atom::d35f3c7fa718acde685707ba": {
      "atom_id": "atom::d35f3c7fa718acde685707ba",
      "source_handle": "P0040",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受化疗或放疗的结直肠癌及其他实体瘤患者",
        "finding": "多项随机对照试验显示，口服益生菌（如L. johnsonii, L. acidophilus, B. longum, S. boulardii）能显著减少治疗相关的腹泻、黏膜炎和术后感染，改善肠道菌群组成和局部免疫功能。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a9cc67de57f6216f432e18b5daecf072589838cd65e7ed44461f4dd36d5babb2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::caff7a9cf24c196bd36b1b7d337e7826982821c5fb9b9fb4230343de9122f06d",
      "multiple_values_in_field": true
    },
    "atom::e143d0e94eb670b6a7e529de": {
      "atom_id": "atom::e143d0e94eb670b6a7e529de",
      "source_handle": "P0040",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "接受放化疗的胃肠道肿瘤患者",
        "finding": "模型菌株LGG被证实能通过释放脂磷壁酸（LTA）激活隐窝周围巨噬细胞，从而选择性保护正常肠上皮干细胞免受辐射诱导的凋亡，而不影响肿瘤细胞，起到“时间释放胶囊”般的放射保护作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a9cc67de57f6216f432e18b5daecf072589838cd65e7ed44461f4dd36d5babb2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::caff7a9cf24c196bd36b1b7d337e7826982821c5fb9b9fb4230343de9122f06d",
      "multiple_values_in_field": true
    },
