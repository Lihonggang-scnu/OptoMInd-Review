    "atom::1a73c41b6335085faab23b1f": {
      "atom_id": "atom::1a73c41b6335085faab23b1f",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用二次定性综述设计。检索策略包括对PubMed、Europe PMC、Crossref和Google Scholar的结构化搜索，以及对相关文献的向后引文追踪。纳入标准为2017年至2026年4月发表的人类原发性研究，要求提供肠道微生物组组成或微生物组调节暴露与实体瘤ICI临床结局之间的连接。排除综述、动物研究和纯机制实验室论文（但用于背景框架）。最终选取15项具有代表性的主要临床研究，通过解释性主题程序（interpretive thematic procedure）对研究进行编码，按调节类型分类并 juxtapose（并列比较）重复出现的解释模式。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::b41dcae9513a2094da5f4da6428c25448a40f95eb72269470a6d7c01cc1322ae",
      "multiple_values_in_field": false
    },
    "atom::bb1f3d9c218571d23c4ecf84": {
      "atom_id": "atom::bb1f3d9c218571d23c4ecf84",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了从“分类学焦点”向“功能焦点”和“生态系统模型”的范式转变观点，强调微生物多样性、代谢物相互作用和黏膜屏障活性作为系统性免疫控制层的作用。",
        "limits": "所给摘要未交代具体的统计检验方法或严格的纳入排除评分标准细节；证据基础偏向黑色素瘤，其他实体瘤的干预数据较少；现有研究样本量小、测序平台不统一、缺乏对饮食和地理因素的充分控制，导致无法支持简单的通用处方。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::4212e8f5a3da9eca4472789b75bdc2e933f717d077cff3144636c20b4eb8523e",
      "multiple_values_in_field": false
    },
    "atom::83414a3e3fae35233ee887ad": {
      "atom_id": "atom::83414a3e3fae35233ee887ad",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线微生物特征与响应表型",
        "finding": "响应者表型反复与较高的微生物多样性及特定菌属富集相关，包括Akkermansia、Ruminococcaceae、Faecalibacterium和Bifidobacterium。这种关联在不同肿瘤队列中表现出生态学模式的一致性，但具体物种因人群和测序平台而异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::eb968013184b9f6e1a7940dbffe78aba4555b8b07f66bd326cbbb923ddcdae71",
      "multiple_values_in_field": true
    },
    "atom::9e4dd5f47fda6a2395ed9679": {
      "atom_id": "atom::9e4dd5f47fda6a2395ed9679",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "生态干扰与偶然调节（抗生素与益生菌）",
        "finding": "在启动ICI期间无控制的抗生素暴露与较差的预后相关（尤其在上皮肿瘤和非小细胞肺癌中），提示生态脆弱性。益生菌补充的效果数据难以解释，可能受混杂因素影响，且高剂量益生菌有时与多样性降低相关，表明简单的细菌添加不如维持生态完整性重要。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::eb968013184b9f6e1a7940dbffe78aba4555b8b07f66bd326cbbb923ddcdae71",
      "multiple_values_in_field": true
    },
    "atom::ab04ce96345a2cf76ab4ebf0": {
      "atom_id": "atom::ab04ce96345a2cf76ab4ebf0",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "治疗性微生物组工程化",
        "finding": "粪便微生物群移植（FMT）、高纤维饮食和活体细菌产品展示了概念验证（proof of concept），证明可以通过治疗性操纵使微生物群落对ICI疗法更具反应性。例如，FMT在抗PD-1难治性黑色素瘤患者中诱导了新的临床反应，CBM588联合疗法在肾癌中显示积极信号。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::eb968013184b9f6e1a7940dbffe78aba4555b8b07f66bd326cbbb923ddcdae71",
      "multiple_values_in_field": true
    },
    "atom::141b36432711d0058eb9029b": {
      "atom_id": "atom::141b36432711d0058eb9029b",
      "source_handle": "P0534",
      "field_path": [
