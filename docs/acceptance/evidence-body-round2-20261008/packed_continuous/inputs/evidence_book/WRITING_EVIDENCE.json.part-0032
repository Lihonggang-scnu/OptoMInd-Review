    },
    "atom::164e8028853a939519cae127": {
      "atom_id": "atom::164e8028853a939519cae127",
      "source_handle": "P0217",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要关注肌动蛋白介导的机制，未深入探讨菌群代谢产物（如短链脂肪酸）对肌动蛋白分泌的直接调控细节，需结合其他文献完善菌群-肌肉互作机制。",
        "contribution": "详细阐述了肌动蛋白（IL-6, IL-15, Irisin）信号通路如何调节免疫细胞功能（CD8+ T细胞、NK细胞、Tregs、巨噬细胞）和肠道屏障完整性，揭示了肌肉-肠道轴在介导ICI效应中的分子机制。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::51f89be549975819db34d833a902728b2f5ee0cf8443c6b08bf2477413b64280",
          "field_path": [
