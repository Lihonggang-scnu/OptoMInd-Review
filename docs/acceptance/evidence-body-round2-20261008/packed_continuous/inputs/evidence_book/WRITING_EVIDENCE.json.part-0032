    "atom::593dd584fb31d25664549f76": {
      "atom_id": "atom::593dd584fb31d25664549f76",
      "source_handle": "P0126",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇Perspective文章，本研究未进行新的实验，而是基于对Blake等人原始实证研究的解读、现有文献（如ICB治疗中微生物的作用）的综合分析以及临床转化视角的评议。文章通过对比不同免疫疗法（ICB vs IAA）中微生物作用的异同，构建关于微生物介导毒性的理论框架，并讨论未来研究方向。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d77a8c0088cfe726193fbc3d84c3f36ee4e72626d48da0759330942407601237",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::963e53b1c02a72d67ee44048a56515897a5376be98612e957f8c38ecdabf4e32",
      "multiple_values_in_field": false
    },
    "atom::9d4e88c5861adeacfba25b2b": {
      "atom_id": "atom::9d4e88c5861adeacfba25b2b",
      "source_handle": "P0126",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物群介导免疫激动剂抗体（IAA）特异性毒性的机制解释（MyD88依赖性炎症通路），区分了不同IAA靶点（CD40 vs CD137）下的效应细胞差异（巨噬细胞/中性粒细胞 vs CD8+ T细胞）。",
        "limits": "所给材料为评论性综述，未提供新的原始数据；未深入探讨具体致病菌株或代谢物；未解决抗生素治疗可能削弱整体免疫疗效的两难困境。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d77a8c0088cfe726193fbc3d84c3f36ee4e72626d48da0759330942407601237",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::5cd35b986279812723a46f9ea47715867909cab00036e51021f38d1b59d804f5",
      "multiple_values_in_field": false
    },
    "atom::63ab8a170400cc8b52e2a04f": {
      "atom_id": "atom::63ab8a170400cc8b52e2a04f",
      "source_handle": "P0126",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在抗CD40免疫激动剂抗体（IAA）治疗背景下",
        "finding": "肠道微生物群的存在导致MyD88依赖性的巨噬细胞激活，进而产生TNFα、IL-6和IFN-I等炎症因子，引起急性肝损伤（巨噬细胞和中性粒细胞依赖）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d77a8c0088cfe726193fbc3d84c3f36ee4e72626d48da0759330942407601237",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::3c4b01845b86142bd761274d1a38642a72675fc02d2ce5bc5d0e4823c14c93a8",
      "multiple_values_in_field": true
    },
    "atom::4ba8c40c966a55ac69fa5c46": {
      "atom_id": "atom::4ba8c40c966a55ac69fa5c46",
      "source_handle": "P0126",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在抗CD137免疫激动剂抗体（IAA）治疗背景下",
        "finding": "毒性同样收敛于宿主MyD88被肠道微生物激活，但导致的是CD8+ T细胞依赖的肝损伤和IFNγ驱动的系统性炎症。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::d77a8c0088cfe726193fbc3d84c3f36ee4e72626d48da0759330942407601237",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::3c4b01845b86142bd761274d1a38642a72675fc02d2ce5bc5d0e4823c14c93a8",
      "multiple_values_in_field": true
    },
    "atom::94d67c6b60c901743600ca1d": {
      "atom_id": "atom::94d67c6b60c901743600ca1d",
      "source_handle": "P0126",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "无菌小鼠或经抗生素处理的小鼠模型",
        "finding": "IAA治疗相关的毒性显著降低，且未观察到抗肿瘤免疫力的有害影响。"
      },
      "role": "evidence",
      "origins": [
        {
