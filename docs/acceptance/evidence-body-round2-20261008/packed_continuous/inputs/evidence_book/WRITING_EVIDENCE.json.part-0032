            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::f622c42f3a63963adaa6c2ac1a486e542c3fdde39b90f182691678f257d170f2",
      "multiple_values_in_field": true
    },
    "atom::cf29a57e65e341bf6850f872": {
      "atom_id": "atom::cf29a57e65e341bf6850f872",
      "source_handle": "P0428",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制假说性质强，缺乏直接的代谢物测量或功能实验验证；观察性研究无法确立因果链条。",
        "contribution": "提出了SCFAs（特别是丁酸）可能作为介导ICI疗效和防止irAEs的潜在机制分子。发现高丰度SCFA产生菌既与响应相关，也与不发生irAEs相关。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::820c5fef183c1e2973da4cf6ef051dbdc5a260b40a12f028144c9bc5fb01561d",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::694a93c9b4e0fbc052663fb753db4850f45950aaa6747b3918eb67fb90d27d25",
      "multiple_values_in_field": true
    },
