      "multiple_values_in_field": true
    },
    "atom::ff180dbefd6306f9f063d425": {
      "atom_id": "atom::ff180dbefd6306f9f063d425",
      "source_handle": "P0472",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "黑色素瘤和肾癌患者接受CIT治疗",
        "finding": "基线至第4周犬尿氨酸/色氨酸（Kyn/Trp）比率增加超过50%的患者，其总生存期显著低于比率降低的患者（黑色素瘤中位OS 15.7个月 vs >38个月；肾癌中16.7个月 vs 31.3个月）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca0cd8cf75bc9b1aa650c230b683b301f22d44519b8b9e055b3ce5b2a5e50c3e",
