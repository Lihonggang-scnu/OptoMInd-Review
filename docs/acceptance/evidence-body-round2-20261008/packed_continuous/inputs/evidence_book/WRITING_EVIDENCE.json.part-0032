      "atom_id": "atom::51d4a501c5fb072fb826d98d",
      "source_handle": "P0126",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于讨论微生物干预策略的复杂性和局限性，避免简单化的“杀菌”思路，引导至多组学和功能蛋白靶向的未来方向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::d77a8c0088cfe726193fbc3d84c3f36ee4e72626d48da0759330942407601237",
          "field_path": [
