            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::a88739f242d4eb0b469171787e9bcf37838a6bcd5de943637900e4579ee5d058",
      "multiple_values_in_field": false
    },
    "atom::badff7011b3a302ca2c5e042": {
      "atom_id": "atom::badff7011b3a302ca2c5e042",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "传统生物标志物（如PD-L1、TMB）无法充分解释ICI疗效的异质性；需要理解肠道微生物组是否不仅是相关性指标，而是可被重塑以影响免疫状态和治疗的宿主决定因素，以及目前的证据基础在方法学上存在哪些优势与局限。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::1806e648604fdb26c2bb32ea81137bfb322fcb79906c72b1dde94f99a547af96",
      "multiple_values_in_field": false
    },
    "atom::c044873b9ecec12e1c285594": {
      "atom_id": "atom::c044873b9ecec12e1c285594",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "人类实体肿瘤患者，聚焦肠道微生物组（Gut Microbiome）与免疫检查点抑制剂（ICI）疗效及毒性的关联。涵盖黑色素瘤、非小细胞肺癌、肾细胞癌、肝细胞癌等实体瘤类型。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::cc4c5e4a7687231ea95c05d42e2bd2b1277b6ee20667a47b3ece01c2d2fa2173",
      "multiple_values_in_field": false
    },
    "atom::b13ae81092a39b50e2e4a02d": {
      "atom_id": "atom::b13ae81092a39b50e2e4a02d",
      "source_handle": "P0534",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本文是一篇二次定性综述（Secondary Qualitative Review），旨在综合临床证据，探讨肠道微生物组如何作为宿主决定因素影响实体瘤患者的免疫检查点抑制剂（ICI）反应、生存期及毒性。研究通过结构化搜索PubMed、Europe PMC等数据库并结合引文追踪，筛选出15项主要临床研究进行主题合成。文章未进行定量荟萃分析，而是从响应表型、生态干扰（如抗生素/益生菌暴露）和治疗性工程化（如FMT、饮食干预）三个主题出发，评估微生物组调节的机制合理性与临床可行性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::0b56b75d854a5a5711d0bd3c6022d0a079d45e7196f60e8a9dcdfdbe2aa2134e",
      "multiple_values_in_field": false
    },
    "atom::0793c841b7f3ce068049ed3f": {
      "atom_id": "atom::0793c841b7f3ce068049ed3f",
      "source_handle": "P0534",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物组如何作为宿主生态因子调节ICI疗效提供了理论框架和临床证据的综合视图。其核心价值在于将分散的临床观察整合为三个主题：基线生态签名、生态干扰风险和治疗性工程潜力。它不直接提供单一因果机制的实验数据，而是通过主题合成揭示了当前证据的方法学局限性和生物学合理性，有助于界定综述中关于“微生物组作为疗效预测因子”和“微生物组干预策略”的讨论边界。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::7c80a7662354f53929e8c82bc86a3eaa13f0562e7b2ed13452f13c394ff32d0a",
      "multiple_values_in_field": false
    },
    "atom::8161bac800ee67bffb51c02a": {
      "atom_id": "atom::8161bac800ee67bffb51c02a",
      "source_handle": "P0534",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅基于15项研究的定性合成，非定量荟萃分析；具体菌种的普适性受限，不能直接外推至所有实体瘤亚型；未提供具体的效应量数值。",
        "contribution": "提供了关于肠道微生物组特征与ICI疗效关联的主题综合。指出响应者通常具有高多样性和特定有益菌（Akkermansia, Faecalibacterium等）富集，而抗生素暴露与较差预后相关。同时强调了不同肿瘤类型间具体菌种的不一致性，提示需关注生态整体而非单一标记物。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::3b3c0d8031f46ab82c65580706d4200709420ecf3be8a761671a9bd232305c0e",
      "multiple_values_in_field": true
    },
    "atom::02f0c90c0ff636cd6e53cd35": {
      "atom_id": "atom::02f0c90c0ff636cd6e53cd35",
      "source_handle": "P0534",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于回答“肠道微生物组如何调节ICI疗效”中的描述性问题，即哪些微生物特征与疗效正/负相关。可用于论证微生物组作为宿主生物标志物的合理性，同时引用其关于跨肿瘤异质性的发现来限制过度概括。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::cad123fd97eb3a3dda047d9f189188831d832baf700d95ae64de974996fbc473",
      "multiple_values_in_field": true
    },
    "atom::b889a447834235936ab7bdb8": {
      "atom_id": "atom::b889a447834235936ab7bdb8",
      "source_handle": "P0534",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制部分主要基于作者引用的理论框架和对现有研究的解读，而非本篇提供的原始实验数据；具体分子通路细节未在文中展开，需结合其他机制研究；干预试验的因果效力尚未在大样本随机对照试验中得到确证。",
        "contribution": "提供了微生物组调节疗效的理论机制框架，包括癌症免疫循环、生态韧性理论和精准宿主调节。解释了为何多样性比单一菌种更重要（生态韧性），以及微生物如何通过抗原呈递、T细胞 priming 和短链脂肪酸生成影响免疫状态。同时指出了当前干预试验（FMT、活体产品）处于早期阶段，机制尚不完全明确。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::3b3c0d8031f46ab82c65580706d4200709420ecf3be8a761671a9bd232305c0e",
      "multiple_values_in_field": true
    },
    "atom::fae9724836593f52c45c4886": {
      "atom_id": "atom::fae9724836593f52c45c4886",
      "source_handle": "P0534",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于回答“介导效应的机制是什么”，提供理论解释路径（如免疫激活、代谢物产生）。可用于讨论为何单纯补充益生菌效果不佳（生态干扰 vs. 主动工程化），并为未来研究指明方向（如标准化采样、功能导向终点）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e7f22d9bd792b22114d77cc50052375d7e12115e979c9bd8cfa2022c53f5e0ca",
