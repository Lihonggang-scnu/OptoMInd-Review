      "atom_id": "atom::6d059ff00cd7f4bcb25d5a88",
      "source_handle": "P0428",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "研究区分了原发耐药和获得性耐药，发现基线α多样性无差异，但β多样性有趋势差异，说明整体群落结构可能不如特定功能菌群重要。"
      },
      "role": "evidence",
      "origins": [
