      "multiple_values_in_field": true
    },
    "atom::472b9e06c54aa635de7e36dc": {
      "atom_id": "atom::472b9e06c54aa635de7e36dc",
      "source_handle": "P0472",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "非小细胞肺癌（NSCLC）患者接受二线Nivolumab治疗",
        "finding": "粪便中丙酸、丁酸、赖氨酸和烟酸的升高水平与超过12个月的无进展生存期（PFS）相关。"
      },
      "role": "evidence",
      "origins": [
