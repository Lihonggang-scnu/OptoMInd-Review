    "atom::81e1c5626dc89331329fdfef": {
      "atom_id": "atom::81e1c5626dc89331329fdfef",
      "source_handle": "P0149",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用小鼠模型进行体内实验。具体设计包括：1. 构建心肌细胞限制性抗原表达的小鼠模型，以模拟心脏自身免疫情境；2. 应用不同的免疫检查点阻断策略（单独αPD-1、单独αCTLA-4、联合αCTLA-4+αPD-1），观察对CD8 T细胞扩增、心肌炎症及心律失常的影响；3. 通过遗传学手段（基因敲除CD8 T细胞来源的TNF）或药理学手段（阻断TNFR2）验证特定信号通路在心肌损伤中的作用；4. 评估干预措施对心脏毒性和抗肿瘤疗效的双重影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::458437782a562f994cbafc812c61da07c559fa9cf0d4ede375d00d4231da3938",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::da665a8ea7ee0339b2719c8a17d408caa128319d831fb0d5d3de0d2e9b4638a6",
      "multiple_values_in_field": false
    },
    "atom::e962b12cc27bd595176c8762": {
      "atom_id": "atom::e962b12cc27bd595176c8762",
      "source_handle": "P0149",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "揭示了ICI心肌炎的一个非细胞毒性依赖机制：即CD8 T细胞来源的TNF通过TNFR2信号轴驱动炎症和心律失常，而非传统的穿孔素/颗粒酶途径。",
        "limits": "所给摘要未交代该机制在人类患者中的直接验证情况；未提供具体的临床数据或不同肿瘤类型间的比较；未详细阐述TNF阻断剂的具体类型或给药方案是否已在临床前完全优化。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::458437782a562f994cbafc812c61da07c559fa9cf0d4ede375d00d4231da3938",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::48590438d97f28dd196143be7a5edbfa405e236bdd1f1bcaee44c86cc7a30589",
      "multiple_values_in_field": false
    },
