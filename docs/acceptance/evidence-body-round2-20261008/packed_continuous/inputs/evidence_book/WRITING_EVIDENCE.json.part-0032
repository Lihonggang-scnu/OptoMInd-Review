            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::6ae9c18ac6cbf7b6c367de2c870092708a5862ba9c9777560c4a30f184aac144",
      "multiple_values_in_field": true
    },
    "atom::f1f25d86db4599ba1868cbea": {
      "atom_id": "atom::f1f25d86db4599ba1868cbea",
      "source_handle": "P0302",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制仅为相关性观察，未通过干预实验验证DMBT1是否直接导致菌群变化或改善疗效；DMBT1主要涉及先天免疫凝集作用，与ICIs涉及的适应性免疫（T细胞）机制不同。",
        "contribution": "揭示了宿主抗菌蛋白DMBT1在SCC中被抑制，治疗后恢复，且其水平与特定菌群（Gemella等）正相关。这提供了一个具体的分子机制假设：宿主免疫蛋白可能通过调节微生物组成来影响治疗微环境。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::25ed99df7ccdce29b4e0690045bbf72ca8e2ce6ccb9cda48c406f44fca8fee1a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::468b7ef4596eace14ba4c1087d94d04a7a5cdf393adc1287d2d29cc1625d5251",
      "multiple_values_in_field": true
    },
    "atom::cc3dad3d2265a4d4eeaaaba2": {
      "atom_id": "atom::cc3dad3d2265a4d4eeaaaba2",
      "source_handle": "P0302",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中探讨“宿主免疫因子介导的微生物-治疗反应机制”。可作为不同于肠道菌群代谢产物或抗原呈递的另一类机制（黏膜免疫蛋白调节）的例子，丰富对“mechanisms mediate that effect”的理解维度，尽管其直接适用性有限。",
      "role": "planning",
