      "source_handle": "P0354",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Predictive indices are derived from retrospective cohorts and validated on small independent sets; they are not yet clinically approved tools.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a7a7de9fbd4946fc2daa9ddf973518ada8921541825d72e42c020528eab8a38a",
