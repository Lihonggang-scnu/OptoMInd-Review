      ],
      "value": [
        {
          "allowed_use": [],
          "conditions": [],
          "decision": "stop",
          "intended_use": "",
          "limits": [],
          "need_id": "Nbcf492500208-757e7573bb6bd28e",
          "question": "FMT-LUMINate 试验中 FMT 联合 ICI 的 ORR 数据是多少？供体菌群特征（如 Prevotella）与毒性（心肌炎）的关联机制是什么？",
          "sources": [
            {
              "doi": "10.1038/s41591-025-04186-5",
              "paper_id": "071823eff68d7dbea395490dd4643170131b5f6a",
              "source_handle": "P0583",
              "title": "Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial",
              "year": "2026"
            }
          ],
          "still_missing": "FMT-LUMINate 试验中 FMT 联合 ICI 的 ORR 数据是多少？供体菌群特征（如 Prevotella）与毒性（心肌炎）的关联机制是什么？",
          "usable_content": "{\"question_material\": [{\"question_id\": \"Q01\", \"examples\": [{\"attribution\": \"本研究\", \"use_in_review\": \"提供FMT联合ICI在NSCLC和黑色素瘤一线治疗中的客观缓解率（ORR）具体数据，以及安全性特征。\", \"finding\": \"在FMT-LUMINate试验中，接受健康供体FMT联合抗PD-1单药治疗的非小细胞肺癌（NSCLC）患者（n=20），其客观缓解率（ORR）为80%（16/20），超过了预设的64%主要终点阈值。在黑色素瘤队列中，接受FMT联合抗PD-1加抗CTLA-4双免疫检查点抑制剂治疗的患者（n=20），ORR为75%（15/20）。\", \"conditions\": \"NSCLC队列：一线治疗，无驱动基因突变，PD-L1 TPS ≥ 50%，使用帕博利珠单抗（pembrolizumab）。黑色素瘤队列：一线或既往辅助治疗后复发>6个月，使用纳武利尤单抗（nivolumab）联合伊匹木单抗（ipilimumab）。\", \"reference_ids\": []}, {\"attribution\": \"本研究\", \"use_in_review\": \"揭示供体菌群特征（Prevotella富集）与特定毒性（心肌炎、3级及以上AEs）的关联机制，强调治疗背景（双免疫抑制 vs 单药）的关键调节作用。\", \"finding\": \"供体微生物组聚类显示，Cluster B（包含供体5和11）以高丰度的普雷沃菌属（Prevotella spp.，如Segatella copri, Prevotella sp. Marseille-P4119, P. stercorea）为特征。在黑色素瘤队列中，接受Cluster B供体（特别是供体5）FMT的患者发生了严重的免疫相关不良事件（irAEs），包括3例心肌炎（发生率15%），且发病时间显著提前（中位40天，而文献报道通常为60天）。其中2例心肌炎患者均接受了供体5的FMT，发病迅速（分别为第22天和第25天）。统计分析显示，Cluster B供体的粪便仅在双PD-1和CTLA-4阻断背景下导致毒性（P=0.051），而在抗PD-1单药治疗背景下未观察到此类毒性。此外，S. copri的定植与这些严重AEs患者外周血中CD4+ T细胞亚群增加相关。\", \"conditions\": \"比较对象：接受不同供体FMT的患者；治疗背景对比：黑色素瘤队列（双ICI）vs NSCLC队列及既往MIMIC试验（均为抗PD-1单药）。供体5在MIMIC试验（抗PD-1单药）中提供的7次FMT均未导致3级及以上AEs，而在本试验黑色素瘤队列中导致的FMT均伴随严重AEs。\", \"reference_ids\": []}], \"explanation\": \"该研究阐明了FMT增强ICI疗效的机制并非主要依赖于供体菌株的定植或供主微生物组的相似度，而是取决于患者基线有害菌群的清除。具体来说，响应者（Responders）在接受FMT后表现出比非响应者更显著的基线细菌物种丢失（SGB loss），特别是那些已知与ICI耐药相关的有害菌属（如Enterocloster, Clostridium, Streptococcus等）。这种有害菌的消除导致了色氨酸代谢途径的减弱，降低了血浆中喹啉酸（quinolinic acid）和犬尿氨酸（kynurenine）的水平，从而改善了免疫代谢微环境（增加效应CD8+ T细胞，减少调节性T细胞）。关于毒性机制，研究发现特定的供体菌群特征（富含Prevotella spp.）与双免疫检查点抑制剂（抗PD-1 + 抗CTLA-4）背景下的严重免疫相关不良事件（如心肌炎）存在情境依赖性关联。这种毒性风险在单药抗PD-1治疗中并未出现，提示供体选择需根据具体的ICI治疗方案进行优化。\", \"remaining_points\": [\"Prevotella spp. 诱导心肌炎的具体分子机制（如通过何种抗原或代谢物激活特定T细胞亚群）在本研究中仅表现为相关性，未深入解析其下游信号通路。\", \"虽然发现了基线有害菌丢失是疗效的关键预测因子，但哪些特定的丢失菌种组合对疗效贡献最大，以及是否可以通过定向清除而非全菌群移植来实现这一效果，仍需进一步研究。\"]}], \"plain_text\": \"\"}"
        },
        {
          "allowed_use": [],
          "conditions": [],
          "decision": "stop",
          "intended_use": "",
          "limits": [],
          "need_id": "Nc9621a3d541b-757e7573bb6bd28e",
          "question": "FMT-LUMINate 试验的详细安全性数据及供体聚类分析是 Ch5/Ch6 核心证据，需深入解读其统计方法及毒性事件的具体临床特征。",
          "sources": [
            {
              "doi": "10.1038/s41591-025-04186-5",
              "paper_id": "071823eff68d7dbea395490dd4643170131b5f6a",
              "source_handle": "P0583",
              "title": "Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial",
              "year": "2026"
            }
          ],
          "still_missing": "FMT-LUMINate 试验的详细安全性数据及供体聚类分析是 Ch5/Ch6 核心证据，需深入解读其统计方法及毒性事件的具体临床特征。",
          "usable_content": "{\"question_material\": [{\"question_id\": \"Q01\", \"examples\": [{\"attribution\": \"本研究\", \"use_in_review\": \"提供FMT-LUMINate试验中安全性数据的详细统计结果、毒性事件的具体临床特征（如心肌炎发生率、起病时间）以及与供体微生物组相关的因果关联分析，作为核心证据支持关于FMT安全性的讨论。\", \"finding\": \"在NSCLC队列中，接受FMT联合抗PD-1治疗的患者未出现3级或更高不良事件（AEs），仅15%患者因2级AE使用皮质类固醇；而在黑色素瘤队列中，65%患者经历3级或更高AEs，其中腹泻/结肠炎占20%，心肌炎发生率为15%（3例），显著高于文献报道的<1%。独立数据和安全监测委员会（DSMC）判定该组合总体安全，但指出黑色素瘤队列中的严重AEs起病更早（中位40天 vs 文献60天）。聚类分析显示，来自富含普雷沃菌属（Prevotella spp.）的供体（特别是供体5）与3级及以上AEs的发生密切相关：所有由供体5提供的粪便导致黑色素瘤患者出现3级+ AEs，且2/3例心肌炎患者接受了供体5的FMT。这些毒性仅在双免疫检查点抑制剂（anti-PD-1 + anti-CTLA-4）背景下观察到，而在单药抗PD-1治疗中未出现。\", \"conditions\": \"研究对象为FMT-LUMINate试验中的NSCLC（n=20）和黑色素瘤（n=20）患者。NSCLC组接受单药抗PD-1（pembrolizumab），黑色素瘤组接受双免疫检查点抑制剂（nivolumab + ipilimumab）。供体聚类基于 shotgun metagenomic sequencing 数据，使用 Bray-Curtis 指数进行无监督聚类，并通过 PERMANOVA 评估组间差异。AEs分级依据 CTCAE v5.0。\", \"reference_ids\": []}, {\"attribution\": \"本研究\", \"use_in_review\": \"展示供体微生物组特征与免疫相关不良反应（irAEs）之间的机制性联系，特别是普雷沃菌属定植与特定T细胞亚群变化的关联，用于解释为何某些供体会增加毒性风险。\", \"finding\": \"通过无监督聚类分析，健康供体的肠道微生物组被分为两个 distinct clusters (P = 0.001)。Cluster B（包含供体5和11）以高丰度的普雷沃菌属（如 Segatella copri, Prevotella sp. Marseille-P4119, P. stercorea）为特征。在黑色素瘤患者中，接受 Cluster B 供体FMT后，出现3级+ AEs的患者中这些菌属显著富集（LDA score > 2, P < 0.05）。进一步分析显示，在接受双免疫检查点抑制剂治疗的患者中，S. copri 的定植与外周血中 CD4+ T细胞亚群比例增加相关（P = 0.026），而这种关联在单药抗PD-1治疗中不存在。这表明普雷沃菌属的定植是双免疫检查点抑制背景下毒性增加的驱动因素。\", \"conditions\": \"分析对象包括FMT-LUMINate黑色素瘤队列及之前发表的MIMIC试验（Phase 1, melanoma, anti-PD-1 monotherapy）数据。统计方法包括 Fisher's exact test 比较组间差异，LEfSe 进行线性判别分析效应大小，以及 Spearman's r 相关性分析微生物定植与免疫细胞频率的关系。\", \"reference_ids\": [\"R23\"]}], \"explanation\": \"本研究揭示了FMT联合ICI治疗的安全性与供体微生物组特征及ICI治疗方案之间的复杂相互作用。首先，FMT本身在NSCLC（单药抗PD-1）中表现出良好的耐受性，无3级以上AEs。然而，在黑色素瘤（双药抗PD-1/CTLA-4）中，虽然总体安全性被DSMC认可，但出现了加速发作的严重AEs，特别是心肌炎。这种毒性信号并非随机分布，而是与特定的供体微生物组特征紧密相关。通过供体聚类分析，研究发现富含普雷沃菌属（Prevotella spp.）的供体（Cluster B）与3级以上AEs的发生显著相关。机制上，这种关联依赖于ICI的治疗背景：普雷沃菌属的定植及其引发的CD4+ T细胞变化仅在双免疫检查点抑制（anti-PD-1 + anti-CTLA-4）条件下导致毒性，而在单药抗PD-1条件下不表现。这提示普雷沃菌属可能是双免疫检查点抑制背景下免疫相关不良反应的潜在驱动因子，强调了根据ICI方案选择合适供体的重要性。\", \"remaining_points\": [\"心肌炎的具体病理生理机制尚需进一步探索，尽管已将其列为特殊关注AE。\", \"供体筛选标准如何具体量化‘普雷沃菌属丰富度’阈值以排除高风险供体，文中未给出明确操作指南。\", \"长期随访中，这些早期AEs对最终肿瘤疗效是否有负面影响，文中提到数值上有关联但统计不显著，需更大样本验证。\"]}], \"plain_text\": \"\"}"
        },
        {
          "allowed_use": [],
          "conditions": [],
          "decision": "stop",
          "intended_use": "",
          "limits": [],
          "need_id": "N2cf095665997-757e7573bb6bd28e",
          "question": "FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。",
          "sources": [
            {
              "doi": "10.1038/s41591-025-04186-5",
              "paper_id": "071823eff68d7dbea395490dd4643170131b5f6a",
              "source_handle": "P0583",
              "title": "Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial",
              "year": "2026"
            }
          ],
          "still_missing": "FMT-LUMINate 试验的详细安全性数据及供体聚类分析是本章核心证据，需深入解读其统计方法及毒性事件的具体临床特征。",
          "usable_content": "{\"question_material\": [{\"question_id\": \"Q01\", \"examples\": [{\"attribution\": \"本研究\", \"use_in_review\": \"提供FMT-LUMINate试验中关于安全性数据的具体统计结果、毒性事件临床特征（特别是心肌炎和腹泻/结肠炎的发作时间），以及供体微生物组聚类分析与免疫相关不良事件（irAEs）关联的详细机制证据。\", \"finding\": \"在黑色素瘤队列中，19名患者（95%）出现任何级别的与治疗相关的不良事件（AEs），其中12名（60%）出现3级或更高级别的AEs，1名出现4级AEs。最常见的3级或以上AE是腹泻或结肠炎（20%的患者）。有3名患者（15%）发生心肌炎，这高于文献报道的<1%的发生率。严重毒性的中位发作时间为开始抗PD-1和抗CTLA-4治疗后的40天，早于文献报告的60天。独立数据和安全监测委员会（DSMC）认为这些严重AEs比既往文献报道的发作更早。在NSCLC队列中，没有患者出现3级或更高级别的AEs。通过非监督聚类分析，健康供体的肠道微生物组被分为两个截然不同的簇（P = 0.001）。B簇（包含供体5和供体11）以高丰度的Prevotella spp.为特征。差异丰度分析证实，P. sp. Marseille-P4119、P. stercorea和Prevotellaceae GGB1146 SGB1472在接受双免疫检查点抑制剂治疗的黑色素瘤患者中，若发生3级或以上AEs则显著富集。后FMT定植的P. sp. Marseille-P4119、P. stercorea和Prevotellaceae SGB1472与3级或以上AEs显著相关（P < 0.001, P = 0.023, P < 0.001）。供体5提供的粪便在所有接受双ICI治疗的黑色素瘤患者中均导致3级或以上AEs，且两名发生快速发作心肌炎的患者均接受了来自供体5的FMT。然而，当仅使用抗PD-1单药治疗时（如之前的MIMIC试验中的供体5数据或本研究的NSCLC队列），来自Cluster B的供体并未引起毒性。综合所有经历3级或以上AEs的患者（包括当前研究和之前的MIMIC试验），来自Cluster B供体的粪便仅在联合PD-1和CTLA-4阻断的患者中引起毒性（P = 0.051）。\", \"conditions\": \"研究对象为FMT-LUMINate试验中的非小细胞肺癌（NSCLC, n=20）和黑色素瘤（n=20）患者。黑色素瘤患者接受FMT联合抗PD-1（nivolumab）和抗CTLA-4（ipilimumab）治疗；NSCLC患者接受FMT联合抗PD-1（pembrolizumab）治疗。供体聚类基于41个来自9名供体的样本进行Bray-Curtis不相似度分析。AEs分级依据CTCAE v5.0。\", \"reference_ids\": []}], \"explanation\": \"本研究揭示了FMT结合不同免疫检查点抑制剂（ICI）背景下的安全性差异及其潜在的微生物机制。首先，FMT联合抗PD-1在NSCLC中表现出良好的安全性，无3级或以上AEs；而在联合抗PD-1和抗CTLA-4的黑色素瘤中，虽然总体安全性被DSMC判定为可接受，但出现了加速发作的严重免疫相关不良事件（irAEs），特别是心肌炎和中位发作时间提前至40天。其次，供体微生物组的组成决定了这种毒性风险。通过非监督聚类，供体被分为富含Prevotella spp.的Cluster B和其他Cluster A。Cluster B供体（特别是供体5）与严重的irAEs（包括心肌炎）密切相关，但这种关联具有严格的上下文依赖性：它仅在抗CTLA-4存在的情况下显现，而在抗PD-1单药治疗背景下不引发毒性。这表明特定的微生物类群（如Prevotella spp.）与ICI骨架之间存在情境依赖性的相互作用，可能驱动了双重阻断下的过度免疫反应。因此，供体选择对于未来FMT试验的安全性至关重要，特别是当联合使用抗CTLA-4时。\", \"remaining_points\": [\"心肌炎的具体病理生理机制尚需进一步探索，尽管观察到其与特定菌属定植及CD4+ T细胞亚群变化的关联。\", \"供体筛选标准如何具体量化以避免Cluster B供体，目前仅指出需排除此类供体。\"]}], \"plain_text\": \"\"}"
        },
        {
          "allowed_use": [],
          "conditions": [],
          "decision": "stop",
          "intended_use": "",
          "limits": [],
          "need_id": "Nbcf492500208-757e7573bb6bd28e",
          "question": "FMT-LUMINate 试验中 FMT 联合 ICI 的 ORR 数据是多少？供体菌群特征（如 Prevotella）与毒性（心肌炎）的关联机制是什么？",
          "sources": [
            {
              "doi": "10.1038/s41591-025-04186-5",
              "material_depth": "",
              "paper_id": "071823eff68d7dbea395490dd4643170131b5f6a",
              "reading_role": "",
              "section_path": [],
              "source_handle": "P0583",
              "title": "Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial",
              "year": "2026"
            }
          ],
          "still_missing": "FMT-LUMINate 试验中 FMT 联合 ICI 的 ORR 数据是多少？供体菌群特征（如 Prevotella）与毒性（心肌炎）的关联机制是什么？",
          "usable_content": "{\"question_material\": [{\"question_id\": \"Q01\", \"examples\": [{\"attribution\": \"本研究\", \"use_in_review\": \"提供FMT联合ICI在NSCLC和黑色素瘤一线治疗中的客观缓解率（ORR）具体数据，以及安全性特征。\", \"finding\": \"在FMT-LUMINate试验中，接受健康供体FMT联合抗PD-1单药治疗的非小细胞肺癌（NSCLC）患者（n=20），其客观缓解率（ORR）为80%（16/20），超过了预设的64%主要终点阈值。在黑色素瘤队列中，接受FMT联合抗PD-1加抗CTLA-4双免疫检查点抑制剂治疗的患者（n=20），ORR为75%（15/20）。\", \"conditions\": \"NSCLC队列：一线治疗，无驱动基因突变，PD-L1 TPS ≥ 50%，使用帕博利珠单抗（pembrolizumab）。黑色素瘤队列：一线或既往辅助治疗后复发>6个月，使用纳武利尤单抗（nivolumab）联合伊匹木单抗（ipilimumab）。\", \"reference_ids\": []}, {\"attribution\": \"本研究\", \"use_in_review\": \"揭示供体菌群特征（Prevotella富集）与特定毒性（心肌炎、3级及以上AEs）的关联机制，强调治疗背景（双免疫抑制 vs 单药）的关键调节作用。\", \"finding\": \"供体微生物组聚类显示，Cluster B（包含供体5和11）以高丰度的普雷沃菌属（Prevotella spp.，如Segatella copri, Prevotella sp. Marseille-P4119, P. stercorea）为特征。在黑色素瘤队列中，接受Cluster B供体（特别是供体5）FMT的患者发生了严重的免疫相关不良事件（irAEs），包括3例心肌炎（发生率15%），且发病时间显著提前（中位40天，而文献报道通常为60天）。其中2例心肌炎患者均接受了供体5的FMT，发病迅速（分别为第22天和第25天）。统计分析显示，Cluster B供体的粪便仅在双PD-1和CTLA-4阻断背景下导致毒性（P=0.051），而在抗PD-1单药治疗背景下未观察到此类毒性。此外，S. copri的定植与这些严重AEs患者外周血中CD4+ T细胞亚群增加相关。\", \"conditions\": \"比较对象：接受不同供体FMT的患者；治疗背景对比：黑色素瘤队列（双ICI）vs NSCLC队列及既往MIMIC试验（均为抗PD-1单药）。供体5在MIMIC试验（抗PD-1单药）中提供的7次FMT均未导致3级及以上AEs，而在本试验黑色素瘤队列中导致的FMT均伴随严重AEs。\", \"reference_ids\": []}], \"explanation\": \"该研究阐明了FMT增强ICI疗效的机制并非主要依赖于供体菌株的定植或供主微生物组的相似度，而是取决于患者基线有害菌群的清除。具体来说，响应者（Responders）在接受FMT后表现出比非响应者更显著的基线细菌物种丢失（SGB loss），特别是那些已知与ICI耐药相关的有害菌属（如Enterocloster, Clostridium, Streptococcus等）。这种有害菌的消除导致了色氨酸代谢途径的减弱，降低了血浆中喹啉酸（quinolinic acid）和犬尿氨酸（kynurenine）的水平，从而改善了免疫代谢微环境（增加效应CD8+ T细胞，减少调节性T细胞）。关于毒性机制，研究发现特定的供体菌群特征（富含Prevotella spp.）与双免疫检查点抑制剂（抗PD-1 + 抗CTLA-4）背景下的严重免疫相关不良事件（如心肌炎）存在情境依赖性关联。这种毒性风险在单药抗PD-1治疗中并未出现，提示供体选择需根据具体的ICI治疗方案进行优化。\", \"remaining_points\": [\"Prevotella spp. 诱导心肌炎的具体分子机制（如通过何种抗原或代谢物激活特定T细胞亚群）在本研究中仅表现为相关性，未深入解析其下游信号通路。\", \"虽然发现了基线有害菌丢失是疗效的关键预测因子，但哪些特定的丢失菌种组合对疗效贡献最大，以及是否可以通过定向清除而非全菌群移植来实现这一效果，仍需进一步研究。\"]}], \"plain_text\": \"\"}"
        }
      ],
      "role": "evidence",
