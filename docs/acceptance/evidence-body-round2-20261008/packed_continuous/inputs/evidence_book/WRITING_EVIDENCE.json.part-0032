      "source_handle": "P0428",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于讨论微生物组调节免疫治疗的代谢机制，特别是SCFA在平衡疗效与毒性方面的潜在双重作用。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::820c5fef183c1e2973da4cf6ef051dbdc5a260b40a12f028144c9bc5fb01561d",
