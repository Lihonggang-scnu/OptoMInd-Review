    "atom::6188d154a319812b35e4b48c": {
      "atom_id": "atom::6188d154a319812b35e4b48c",
      "source_handle": "P0310",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用回顾性队列研究设计。利用机构数据库筛选出2004-2019年间接受首次ICI治疗的III/IV期黑色素瘤患者。定义暴露组（Abx+）为在ICI开始前3个月内使用过抗生素的患者，对照组（Abx-）为未使用者。通过多变量分析（MV analysis）和Fine-Grey竞争风险模型评估抗生素暴露对总生存期（OS）和免疫介导性结肠炎的影响。此外，进行了敏感性分析以排除重症感染住院患者的干扰。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cbe0edda2ebe4eadd9e19df3564ad6771cff4ada58ee339a5655f3aba217db93",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::450023315e26e8c3918423207752af00caa07bcf682b802fb9635b47d830639e",
      "multiple_values_in_field": false
    },
    "atom::16ecfa4d3b7f0bc775571a06": {
      "atom_id": "atom::16ecfa4d3b7f0bc775571a06",
      "source_handle": "P0310",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了在真实世界临床实践中，近期抗生素暴露与黑色素瘤患者ICI治疗疗效（OS）及安全性（结肠炎）之间关联的实证数据，支持了抗生素可能负面调节ICI疗效的假设。",
        "limits": "所给摘要未交代具体的混杂因素列表、统计模型的具体协变量选择过程、抗生素种类分布及微生物组测序数据。作为回顾性观察研究，无法确立因果关系，仅能证明关联。结论仅限于黑色素瘤人群，且受限于单中心数据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cbe0edda2ebe4eadd9e19df3564ad6771cff4ada58ee339a5655f3aba217db93",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::a99c3d3bc5270ab398f2add6c9e28af1fb732540e21877cefe6bfce38d78b599",
      "multiple_values_in_field": false
    },
    "atom::0f1adc856e63ef2b3eac0882": {
      "atom_id": "atom::0f1adc856e63ef2b3eac0882",
      "source_handle": "P0310",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "IV期黑色素瘤患者，经多变量分析调整基线特征后",
        "finding": "抗生素暴露组（Abx+）的总生存期显著差于非暴露组，风险比（HR）为1.6（95% CI 1.1-2.2）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cbe0edda2ebe4eadd9e19df3564ad6771cff4ada58ee339a5655f3aba217db93",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::6ca1d139dd8a666e6e5c38cbf1203d58e00c0b70c3bf79c4a4698a49f6e64a9c",
      "multiple_values_in_field": true
    },
    "atom::b0ae20fcaa95bd0597b3930b": {
      "atom_id": "atom::b0ae20fcaa95bd0597b3930b",
      "source_handle": "P0310",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "III期黑色素瘤患者，经多变量分析调整基线特征后",
        "finding": "抗生素暴露组（Abx+）的总生存期显著差于非暴露组，风险比（HR）为2.8（95% CI 1.3-5.9）。"
      },
      "role": "evidence",
      "origins": [
        {
