      ],
      "value": {
        "conditions": "SCC患者唾液DMBT1表达",
        "finding": "治疗前DMBT1表达较低；治疗后6个月和12个月DMBT1表达显著升高（约1.9-2.1倍）。"
      },
      "role": "evidence",
