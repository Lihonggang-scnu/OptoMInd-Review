    "atom::7bdf128c5cc511124c9dd6d3": {
      "atom_id": "atom::7bdf128c5cc511124c9dd6d3",
      "source_handle": "P0001",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "随着癌症免疫治疗中肠道微生物群相关研究的迅速增加，传统定性综述方法难以系统性地分析该领域的知识结构、热点演变趋势及跨学科动态。本研究旨在解决如何从宏观层面梳理这一快速增长领域的知识图谱，识别关键研究者、机构及新兴研究方向的问题。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::503c82023df922b9a23a8d91ec163f6b8037a3fb38dfb9efea1dd7a75e3d0a01",
      "multiple_values_in_field": false
    },
    "atom::ab714a828f5ecb6932ddac7c": {
      "atom_id": "atom::ab714a828f5ecb6932ddac7c",
      "source_handle": "P0001",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "该研究聚焦于癌症免疫治疗领域，具体考察肠道微生物群（gut microbiota）与免疫检查点抑制剂（ICIs）疗效之间的关系。研究对象为2001年1月1日至2025年7月7日期间在Web of Science核心合集（WoSCC）中发表的文献，涵盖国家、机构、作者及关键词等 bibliometric 指标。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::6c9f67523d465c6622cbd7324556b748bea2a6f322b3b30fa69d0a409ba548ef",
      "multiple_values_in_field": false
    },
    "atom::b96b88671b0277df944c9f5a": {
      "atom_id": "atom::b96b88671b0277df944c9f5a",
      "source_handle": "P0001",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "这是一篇基于文献计量学的综述论文，旨在绘制癌症免疫治疗中肠道微生物群研究的“知识景观”。鉴于该领域文献爆炸式增长且传统综述难以系统分析其知识结构，作者利用CiteSpace软件对筛选出的2,669篇文献进行定量分析。研究通过时间切片、合作网络、关键词共现、聚类及突现检测等方法，揭示了该领域的增长模式、主要贡献者、国际合作格局以及新兴热点，最终构建了一个“微生物-免疫-肿瘤”三角知识框架，并为未来个性化免疫治疗策略的临床转化提供了宏观视角。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::d0446f8be52e9f0e7114350b978e3acc0a792381db4dd59d4e511c96f63ec093",
      "multiple_values_in_field": false
    },
    "atom::a0da938e437186cd694c1a1c": {
      "atom_id": "atom::a0da938e437186cd694c1a1c",
      "source_handle": "P0001",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于“肠道微生物群-免疫检查点抑制剂”领域宏观结构、研究热点演变及主要贡献者的全景式背景素材。它不直接回答具体的分子机制，但能帮助用户定位该领域的知识边界、核心议题（如结直肠癌、MSI状态）及关键学术共同体，适用于综述的引言背景、领域现状描述及未来方向展望部分。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::bb268f1b05b23f3575f8d9cd29de474279fdd444deb6b7ed69d57e05d9e9bad2",
      "multiple_values_in_field": false
    },
    "atom::f91958cbdab94422e5faf534": {
      "atom_id": "atom::f91958cbdab94422e5faf534",
      "source_handle": "P0001",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅提供文献分布统计，不直接提供微生物调节ICI疗效的具体临床效果大小或异质性数据。",
        "contribution": "提供了该领域研究规模的宏观证据，确认了肠道微生物群与ICI疗效关联已成为一个独立且快速扩张的研究子领域。指出了结直肠癌（colorectal cancer）和免疫检查点抑制剂（immune checkpoint inhibitor）是该领域最核心的关键词集群，暗示了在这些特定癌种中微生物调节ICI疗效的研究最为集中。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::cad7fdb2c0d422699c38402ec1c4362cbde11e13a58a0b7d0f48a3f3f95dfac0",
      "multiple_values_in_field": true
    },
    "atom::224f02e889f2799723bcaed8": {
      "atom_id": "atom::224f02e889f2799723bcaed8",
      "source_handle": "P0001",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中论证该研究方向的活跃度和重要性；作为背景说明为何选择关注特定癌种（如结直肠癌）中的微生物效应；展示该领域已从基础探索进入爆发期。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::bcb1be6fa9f93ac0c846eab33db0e46669e3b8275ca14506958bee48c9ee2d21",
      "multiple_values_in_field": true
    },
    "atom::f078ddb1ffd8be970ab761ca": {
      "atom_id": "atom::f078ddb1ffd8be970ab761ca",
      "source_handle": "P0001",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "关键词突现代表关注度上升，不代表机制已被完全阐明。摘要未提供具体的分子通路细节，需结合其他实证研究论文来填充具体的机制链条。",
        "contribution": "通过关键词突现分析（burst detection），识别出“microsatellite instability (MSI)”、“diversity”和“t cells”作为新兴热点。这表明当前机制研究的前沿可能集中在MSI状态下的微生物特征、微生物多样性对T细胞浸润的影响等方面。同时，聚类结果指向“tumor microenvironment”（肿瘤微环境）为主要研究方向之一。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::cad7fdb2c0d422699c38402ec1c4362cbde11e13a58a0b7d0f48a3f3f95dfac0",
      "multiple_values_in_field": true
    },
    "atom::903fc928d5dd4eeac87ae3f5": {
      "atom_id": "atom::903fc928d5dd4eeac87ae3f5",
      "source_handle": "P0001",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "帮助规划综述中机制部分的侧重点，提示读者关注MSI和T细胞相关的微生物机制是当前热点；作为寻找后续具体机制文献的线索（例如搜索包含这些关键词的具体实验研究）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::ba6faeb60e6135f42c59cc7b2e64c8197d61434d27abd9a71aed89f0e54be3cb",
