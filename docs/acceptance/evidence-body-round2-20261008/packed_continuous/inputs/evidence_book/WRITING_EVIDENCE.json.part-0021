    "atom::39b705f8ebf7db818dd6cee0": {
      "atom_id": "atom::39b705f8ebf7db818dd6cee0",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "NSCLC亚组的分析是预先指定的敏感性分析，其结果可能不适用于所有实体瘤类型或其他ICI药物组合。",
      "role": "evidence",
      "origins": [
        {
