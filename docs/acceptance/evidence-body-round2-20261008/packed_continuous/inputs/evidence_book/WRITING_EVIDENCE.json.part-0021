            "1",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::906aa19e46647370a9f64e800472d5db5546af60e5886aaf52eff77028d33b5e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::903e4596937214e7ec74dbea065accc5e2a5ac40b9ac3d6b7ff42648c54881d6",
      "multiple_values_in_field": true
    },
    "atom::e680de99c4ef22e30e414764": {
      "atom_id": "atom::e680de99c4ef22e30e414764",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些是作者基于现有文献的解释性假说，并非本Meta分析的新实验发现；缺乏直接的微生物组测序数据支持，属于间接推断。",
        "contribution": "提出了可能的机制假说：抗生素通过广谱消除有益菌破坏免疫反应；PPIs通过改变胃pH值扰乱免疫调节菌群平衡；益生菌通过促进有益菌生长增强抗肿瘤免疫。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
          "field_path": [
            "review_planning_B",
