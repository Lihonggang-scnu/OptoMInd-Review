    "atom::f5c15d548672324d9d04099a": {
      "atom_id": "atom::f5c15d548672324d9d04099a",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "Retrospective observational study design. Data were collected from electronic medical records of 215 patients treated with single-agent anti-PD-1 therapy. Patients were stratified based on antibiotic use within 60 days prior to ICI initiation. Univariate and multivariate Cox proportional hazards models were used to assess associations between baseline characteristics (including antibiotic duration, BMI, ECOG status, chemotherapy-free interval, MMR/MSI status, PD-L1 expression) and Overall Survival. Disease Control Rate was assessed using iRECIST criteria at 8–10 weeks.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::8837f74664dd99bfed2403a41f1f5eac95c297c7203ddb1632a4776388b14423",
      "multiple_values_in_field": false
    },
    "atom::ddfb2254be5c7452ad4e838e": {
      "atom_id": "atom::ddfb2254be5c7452ad4e838e",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides clinical evidence linking prolonged antibiotic use (>14 days) prior to ICI therapy with reduced Overall Survival in recurrent gynecologic cancers, suggesting it as a potential negative prognostic marker.",
        "limits": "The cutoff of 14 days is arbitrary and may be confounded by infection severity. The study lacks direct gut microbiome data (stool sampling was not performed). Small sample size limits subgroup analyses by cancer type (e.g., insufficient endometrial cancer cases). Retrospective design introduces heterogeneity in biomarker testing (PD-L1, MSI/MMR status incomplete for many patients)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::39bb0e8295d9ac5149aab5bebdd48cd3c194f813d513ed2937dfa3f73d61423d",
      "multiple_values_in_field": false
    },
    "atom::622685168278c6c7db9b08f4": {
      "atom_id": "atom::622685168278c6c7db9b08f4",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Multivariate analysis of 215 patients with recurrent gynecologic cancers.",
        "finding": "Prior antibiotic use for a cumulative duration of ≥14 days was independently associated with worse Overall Survival (HR 2.286, 95% CI 1.210–4.318; p = 0.011)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::6eb85baa0bdb257f016bd282fed79d026110f2843a5fa3e38802906cbe080d18",
      "multiple_values_in_field": true
    },
    "atom::ab27face14515573916cb552": {
      "atom_id": "atom::ab27face14515573916cb552",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Comparison of Disease Control Rate (DCR) at 8–10 weeks between groups.",
        "finding": "No significant difference in DCR was observed between patients who received antibiotics (23.4%) and those who did not (33.3%, p = 0.130), nor was DCR significantly affected by antibiotic duration (<14 vs ≥14 days)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
