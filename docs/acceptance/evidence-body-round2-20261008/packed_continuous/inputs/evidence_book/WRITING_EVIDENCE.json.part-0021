    "atom::a7785df44e6eb97a3ddfe002": {
      "atom_id": "atom::a7785df44e6eb97a3ddfe002",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "对于合并用药（如类固醇）的影响，作者明确指出可能存在混杂因素（如患者基线状况），因此在解读时需保持谨慎，避免简单归因。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4e8a6b09792021ffa6ec91290928444bada68e88a4228226a04c52dab3c864dd",
          "field_path": [
