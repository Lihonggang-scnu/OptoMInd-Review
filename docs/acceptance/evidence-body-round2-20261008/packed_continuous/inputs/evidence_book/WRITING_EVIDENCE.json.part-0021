    "atom::08d9491dd9f7bbae2acf9f74": {
      "atom_id": "atom::08d9491dd9f7bbae2acf9f74",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "文章第3节详细列出了基于免疫激活阶段的耐药机制，包括TME物理屏障、抗原呈递缺陷、免疫抑制性细胞因子（TGF-β, IL-10）、代谢压力（缺氧、乳酸）以及替代检查点（TIM-3, LAG3, TIGIT）的上调。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4e8a6b09792021ffa6ec91290928444bada68e88a4228226a04c52dab3c864dd",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0"
          ]
        }
      ],
      "variant_group": "field::0824a233f57aced7590ced00cc54e8767d47261d4ec6b1eaf5350840b345aa9f",
      "multiple_values_in_field": true
    },
    "atom::fa8e2b7184d6d0c1971b6e97": {
      "atom_id": "atom::fa8e2b7184d6d0c1971b6e97",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "虽然综述焦点是微生物群，但了解这些广泛的耐药机制有助于确定微生物群干预主要针对哪一环节（如改善TME免疫浸润或逆转T细胞耗竭）。",
      "role": "planning",
      "origins": [
