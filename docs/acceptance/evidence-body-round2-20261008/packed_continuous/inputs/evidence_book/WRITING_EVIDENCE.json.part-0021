    "atom::8141dc3397c9ac099a6968ba": {
      "atom_id": "atom::8141dc3397c9ac099a6968ba",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "本文是综述性质，其引用的临床试验结果（如KEYNOTE, CheckMate, IMpower150等）代表的是特定研究的设计和结果，不应视为对所有患者的普遍保证。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4e8a6b09792021ffa6ec91290928444bada68e88a4228226a04c52dab3c864dd",
          "field_path": [
