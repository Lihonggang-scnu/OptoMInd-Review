      "multiple_values_in_field": true
    },
    "atom::e0fb0db507c314942437a4ff": {
      "atom_id": "atom::e0fb0db507c314942437a4ff",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "益生菌的益处证据等级较低（Low to Moderate certainty），不应视为确证性结论，仅具提示意义。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
          "field_path": [
