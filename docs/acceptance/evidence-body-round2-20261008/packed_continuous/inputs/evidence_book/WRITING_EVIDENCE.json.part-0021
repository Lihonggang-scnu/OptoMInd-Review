    "atom::bb9fa6649bc07ac89e8a11b8": {
      "atom_id": "atom::bb9fa6649bc07ac89e8a11b8",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To evaluate whether prior antibiotic use affects the efficacy of ICIs (measured by DCR and OS) in patients with recurrent gynecologic malignancies, and to identify independent prognostic factors for survival in this population.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
