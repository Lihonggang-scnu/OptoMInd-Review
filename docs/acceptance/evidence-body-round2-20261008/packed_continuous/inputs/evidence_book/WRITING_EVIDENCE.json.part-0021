    "atom::2ec4b3eaaf35a731acc3f647": {
      "atom_id": "atom::2ec4b3eaaf35a731acc3f647",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "使用时窗的分类（基线、前60天、同期）是基于原始研究报告的聚合，不同研究的具体定义可能存在细微差异，需谨慎外推。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
