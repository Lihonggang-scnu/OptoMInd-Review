      "multiple_values_in_field": false
    },
    "atom::d2a6333196eb31e51bfc64a4": {
      "atom_id": "atom::d2a6333196eb31e51bfc64a4",
      "source_handle": "P0517",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用多中心回顾性队列研究设计。纳入标准：确诊为NSCLC且接受ICI单药治疗的患者。暴露变量：在ICI治疗开始前2个月至开始后1个月内是否使用抗生素。主要结局指标：无进展生存期（PFS）和总生存期（OS）。统计分析方法：使用Kaplan-Meier法绘制生存曲线并进行Log-rank检验，使用Cox比例风险回归模型进行多变量分析以调整混杂因素。亚组分析：根据PD-L1表达水平（<50% vs ≥50%）将患者分为两组，分别评估抗生素使用对各亚组生存预后的影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::66a75b407fbfabec9a6931d8d7e41fbed3adcf34984036faec1b0db7293647c3",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::8e39696d5d023f2a0efe55a9c58160e9abfabc5813cab5426b654cc008eba9c7",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::f4e5b80c0e580833badaa4e9c26f77dfc496eedea9e32e5e7ca3d08a16323fcc",
      "multiple_values_in_field": false
    },
    "atom::51ccf9f282e40e4e28b544a2": {
      "atom_id": "atom::51ccf9f282e40e4e28b544a2",
      "source_handle": "P0517",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了在NSCLC特定人群中，抗生素使用对ICI疗效影响的临床证据，特别是揭示了PD-L1表达水平作为潜在效应修饰因子的重要性。",
        "limits": "所给摘要未交代具体的多变量分析中调整了哪些协变量；未提供PD-L1检测的具体平台或阈值判定细节；样本量虽大但为回顾性研究，可能存在选择偏倚和混杂因素；仅关注ICI单药治疗，未涵盖联合治疗方案；结果仅在NSCLC背景下成立，外推至其他癌种需谨慎。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::66a75b407fbfabec9a6931d8d7e41fbed3adcf34984036faec1b0db7293647c3",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::8e39696d5d023f2a0efe55a9c58160e9abfabc5813cab5426b654cc008eba9c7",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
