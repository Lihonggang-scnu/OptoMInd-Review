    "atom::cc8bb04d83488e2ed0a7e474": {
      "atom_id": "atom::cc8bb04d83488e2ed0a7e474",
      "source_handle": "P0548",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "抗生素效应具有癌症类型依赖性（如在CRC/HCC中可能有益），且不同研究定义的“抗生素暴露”窗口期和种类各异，需谨慎解读。",
        "contribution": "提供了抗生素使用对ICIs疗效负面影响的广泛临床证据汇总，包括多项大型回顾性研究和Meta分析结果，指出抗生素（特别是β-内酰胺类）在ICIs治疗前后使用与较差生存结局相关。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e2fab793e472b9f3fa70686a44560478a939451f647b1f58b500df15fd69c3b8",
