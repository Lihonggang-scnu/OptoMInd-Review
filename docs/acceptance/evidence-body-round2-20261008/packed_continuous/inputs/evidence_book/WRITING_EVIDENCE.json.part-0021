      "multiple_values_in_field": true
    },
    "atom::09837b3b1b752cab988d6e9a": {
      "atom_id": "atom::09837b3b1b752cab988d6e9a",
      "source_handle": "P0421",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究为回顾性单中心研究，结果可能存在选择偏倚和残余混杂，尤其是肺癌亚组中低肌肉量与较好PFS的相关性需谨慎解读，可能受未测量协变量影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::83bafae2b4e03afbb57b0bdb0620482e9b023eed5740d4de2e66bf40ff28a284",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::31f100324748a78ff86c7b115d916d2131f9d9ebc72fe1d04dfd66fd2d45a8f1",
      "multiple_values_in_field": true
    },
    "atom::c72422553a4db6ae27b5c1b3": {
      "atom_id": "atom::c72422553a4db6ae27b5c1b3",
      "source_handle": "P0421",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "肌肉量评估基于L3 CT，虽为标准方法，但无法反映全身肌肉分布或功能，且阈值定义依赖BMI，可能在不同人群中有差异。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::83bafae2b4e03afbb57b0bdb0620482e9b023eed5740d4de2e66bf40ff28a284",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::31f100324748a78ff86c7b115d916d2131f9d9ebc72fe1d04dfd66fd2d45a8f1",
      "multiple_values_in_field": true
    },
    "atom::27ce8fe2aed1a0093735f51b": {
      "atom_id": "atom::27ce8fe2aed1a0093735f51b",
      "source_handle": "P0421",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "未评估轻度毒性，因此对安全性的全面评估有限。",
      "role": "evidence",
