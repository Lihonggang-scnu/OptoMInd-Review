    "atom::f546b1796a81c51782b2c124": {
      "atom_id": "atom::f546b1796a81c51782b2c124",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "关于微生物群与ICI疗效的关系，文中提到的机制多为假设性或基于动物模型/小规模人类研究的推断，尚未形成确凿的因果链条。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4e8a6b09792021ffa6ec91290928444bada68e88a4228226a04c52dab3c864dd",
