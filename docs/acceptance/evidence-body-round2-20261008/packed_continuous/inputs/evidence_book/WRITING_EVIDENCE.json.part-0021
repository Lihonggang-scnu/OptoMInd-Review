    "atom::a45c49dc91d86e47439985d6": {
      "atom_id": "atom::a45c49dc91d86e47439985d6",
      "source_handle": "P0517",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "PD-L1表达 ≥50% 的亚组 (N=部分, 具体人数未明确给出但包含在265名有PD-L1数据的患者中)",
        "finding": "抗生素使用者显示出显著更短的中位PFS（4.2 vs 9.4个月, p=0.012）和中位OS（11.9 vs 28.4个月, p=0.011）。该亚组中抗生素的负面影响比整体人群更为显著。"
      },
      "role": "evidence",
      "origins": [
