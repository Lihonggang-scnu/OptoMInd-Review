    "atom::3ca081140c4fec6f69a7dfd4": {
      "atom_id": "atom::3ca081140c4fec6f69a7dfd4",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "强调研究肠道微生物群对ICI疗效影响的临床紧迫性和现实意义，即优化抗生素使用可能是提高ICI疗效的策略之一。",
      "role": "planning",
      "origins": [
        {
