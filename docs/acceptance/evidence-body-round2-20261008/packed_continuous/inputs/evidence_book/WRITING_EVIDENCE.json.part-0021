    "atom::7d132168f655b05ea9b836b9": {
      "atom_id": "atom::7d132168f655b05ea9b836b9",
      "source_handle": "P0569",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "在早期可切除NSCLC患者中，基线肠道微生物组特征或治疗期间的纵向微生物组变化是否与对新辅助免疫检查点抑制剂的治疗反应（以MPR为代理终点）相关？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2c10f66e656b13b1d08f07b21f5974af1eb5f51d99874e2c3d45338c713e4ade",
