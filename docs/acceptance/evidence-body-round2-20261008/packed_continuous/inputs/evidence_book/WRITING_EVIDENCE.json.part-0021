    "atom::f4afca9cf86d8636a5daf124": {
      "atom_id": "atom::f4afca9cf86d8636a5daf124",
      "source_handle": "P0548",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些关联主要基于回顾性队列和小规模前瞻性研究，存在混杂因素（如饮食、合并用药）未完全控制的风险。不同癌症类型的效应方向不一致，不能简单外推至所有实体瘤。",
        "contribution": "提供了肠道微生物多样性及特定菌属丰度与ICIs疗效（ORR, PFS, OS）关联的临床观察证据。具体包括：在黑色素瘤、肾细胞癌和非小细胞肺癌中，高多样性或与特定有益菌（如双歧杆菌、阿克曼氏菌）正相关；而在结直肠癌等肿瘤中，抗生素使用可能具有不同的影响模式。还提到了FMT从应答者转移到无应答者能恢复疗效的案例。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e2fab793e472b9f3fa70686a44560478a939451f647b1f58b500df15fd69c3b8",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::b5814bcf0094594d1cbb78cdf8cc71b96d4b7638fbca9761be37ba72e7731f6b",
      "multiple_values_in_field": true
    },
    "atom::4980bcef0c29911978d4fbcd": {
      "atom_id": "atom::4980bcef0c29911978d4fbcd",
      "source_handle": "P0548",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于支持“微生物特征可作为ICIs疗效预测因子”的观点，或用于展示微生物干预（如FMT）改善预后的临床潜力。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::e2fab793e472b9f3fa70686a44560478a939451f647b1f58b500df15fd69c3b8",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::6abdd5effb86d7657086242819ee3b3f22d96117bde451d81bc8f24a944debd3",
      "multiple_values_in_field": true
    },
    "atom::33ece1750db86a1d0ce7a270": {
      "atom_id": "atom::33ece1750db86a1d0ce7a270",
      "source_handle": "P0548",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节来自动物模型或体外实验，其在人体内的确切效力和普遍性尚待验证。部分机制（如分子模拟）虽被提出，但在临床样本中的直接证据仍有限。",
        "contribution": "详细阐述了微生物调节抗肿瘤免疫的具体机制，包括：1) 分子模拟导致微生物抗原与肿瘤新抗原交叉反应，激活CD8+ T细胞；2) 代谢物（如SCFAs、吲哚衍生物）通过表观遗传修饰（HDAC抑制）或受体信号（TLR, AhR）调节Treg/Th17平衡及树突状细胞成熟；3) 特定细菌直接作用于免疫细胞（如通过Fap2蛋白抑制NK细胞，或通过SagA酶激活NOD2通路）。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::e2fab793e472b9f3fa70686a44560478a939451f647b1f58b500df15fd69c3b8",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::b5814bcf0094594d1cbb78cdf8cc71b96d4b7638fbca9761be37ba72e7731f6b",
      "multiple_values_in_field": true
    },
    "atom::2ec5a1d30f66ab36976ddd6d": {
      "atom_id": "atom::2ec5a1d30f66ab36976ddd6d",
      "source_handle": "P0548",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释“为什么”微生物会影响ICIs疗效，提供分子和细胞层面的因果链条假设。可用于构建机制模型或解释不同研究结果的生物学基础。",
      "role": "planning",
      "origins": [
        {
