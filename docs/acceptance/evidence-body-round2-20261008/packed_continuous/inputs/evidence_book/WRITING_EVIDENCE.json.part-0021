    "atom::79d62bbddd89e6d8142e93d0": {
      "atom_id": "atom::79d62bbddd89e6d8142e93d0",
      "source_handle": "P0123",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "观察性数据，无法排除适应症偏倚（例如，使用抗酸药的患者可能有不同的基础疾病严重程度）。",
        "contribution": "评估了辅助治疗（抗生素、抗酸药、类固醇）对微生物组组成的干扰。发现抗酸药（PPI/H-blocker）使用与短PFS相关菌种（链球菌）的增加有关，提示药物可能间接影响疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::76339214318d6dae2602ad367f08f2a99141b2ea07bab66c11cf128e5c7be19c",
          "field_path": [
