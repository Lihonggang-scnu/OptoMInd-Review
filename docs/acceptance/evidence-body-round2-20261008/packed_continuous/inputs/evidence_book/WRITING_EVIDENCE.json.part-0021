    "atom::ca99d772ebb7af576860fc44": {
      "atom_id": "atom::ca99d772ebb7af576860fc44",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "文章第4节比较了多种克服耐药的策略，包括联合化疗/放疗（增加免疫原性）、抗VEGF疗法（改善血管和免疫抑制）、靶向替代检查点（LAG3, TIM-3, TIGIT）以及细胞疗法（TILs, CAR-T）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4e8a6b09792021ffa6ec91290928444bada68e88a4228226a04c52dab3c864dd",
