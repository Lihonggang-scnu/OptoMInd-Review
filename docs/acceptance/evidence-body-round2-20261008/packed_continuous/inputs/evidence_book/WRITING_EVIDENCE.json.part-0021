          ]
        },
        {
          "record_id": "record::906aa19e46647370a9f64e800472d5db5546af60e5886aaf52eff77028d33b5e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0ecbcca5ef3aae17d2eca5b160aa096969599f8a655ae1e2f5a631567c8a4d8a",
      "multiple_values_in_field": true
    },
    "atom::61b4405f1aa84d4eb5b663da": {
      "atom_id": "atom::61b4405f1aa84d4eb5b663da",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗生素和PPIs的负面效应可能受到‘适应症偏倚’（即病情重者多用抗生素）的影响，实际因果效应可能被高估。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        },
        {
          "record_id": "record::906aa19e46647370a9f64e800472d5db5546af60e5886aaf52eff77028d33b5e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::0ecbcca5ef3aae17d2eca5b160aa096969599f8a655ae1e2f5a631567c8a4d8a",
      "multiple_values_in_field": true
    },
    "atom::e42dff68106fc73552b6c738": {
      "atom_id": "atom::e42dff68106fc73552b6c738",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "研究未直接测量肠道微生物组的具体组成变化，而是通过药物使用作为代理变量，因此不能直接回答‘哪些特定细菌’介导了疗效变化，只能回答‘哪些药物干扰’影响了疗效。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
          "field_path": [
            "review_planning_B",
