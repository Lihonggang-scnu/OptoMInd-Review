    "atom::043b297b9abc0cea4969e344": {
      "atom_id": "atom::043b297b9abc0cea4969e344",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "提醒综述作者在综合微生物组研究时，必须警惕类似的方法学缺陷，并在评估证据质量时考虑潜在的残余混杂。",
      "role": "planning",
      "origins": [
        {
