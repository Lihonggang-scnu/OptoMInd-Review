    "atom::45660e162c49e4d0842ca1ef": {
      "atom_id": "atom::45660e162c49e4d0842ca1ef",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "接受免疫检查点抑制剂（ICI）治疗的实体瘤患者，考察质子泵抑制剂（PPI）的使用与总生存期（OS）和无进展生存期（PFS）之间的关联。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::7ab3a9600fb4099890be92db2e30fb919b61cdcfafb6f056e156729daad50e20",
      "multiple_values_in_field": false
    },
    "atom::5697786b6fb02d8f3b1a331f": {
      "atom_id": "atom::5697786b6fb02d8f3b1a331f",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "这是一篇系统综述和荟萃分析，旨在解决关于PPI使用对ICI疗效影响的研究结果矛盾问题。作者检索了截至2022年3月的多项数据库及会议摘要，纳入比较ICI单药与ICI联合PPI治疗患者的生存数据研究。通过随机效应模型汇总风险比（HR），并进行亚组分析和Meta回归，以探索异质性来源并确定特定人群中的关联模式。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::884e13b147e28fbb36d2df268fb3ca70123d786df4b45cceb2f02f3987b9109b",
      "multiple_values_in_field": false
    },
    "atom::f4ab56f1bb390e681f4ec099": {
      "atom_id": "atom::f4ab56f1bb390e681f4ec099",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关键的宏观流行病学证据，证实了PPI使用与ICI疗效之间的负面关联，并提出了“使用时窗”这一重要调节变量。它有助于解释为何不同研究间存在异质性，并为“肠道菌群介导”假说提供了间接的临床支持线索（即长期菌群扰动才有害）。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::04b7e7523a88adab8d27fb6743b53df34fc2deb934f82eff01be7b906ee6eec7",
      "multiple_values_in_field": false
    },
    "atom::5afdaa7cd1d185da77388a46": {
      "atom_id": "atom::5afdaa7cd1d185da77388a46",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅证明统计学关联，不直接展示菌群变化过程。不能直接用于解释分子机制，只能作为现象描述的证据。",
        "contribution": "提供了PPI使用对ICI疗效影响的定量汇总证据：整体HR>1，但在不同癌症类型（NSCLC/UC vs. RCC/Melanoma）和使用时窗上存在显著差异。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::b75d717f02e67596e1fe9d1154d554409c3e254c1dcec899aed6942699457a08",
      "multiple_values_in_field": true
    },
    "atom::c722653b0b90cd8f0daeed19": {
      "atom_id": "atom::c722653b0b90cd8f0daeed19",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道菌群如何调节ICI疗效”中的外部因素干扰部分。特别是用于说明当肠道菌群受到药物（PPI）干扰时，ICI疗效可能受损，但这种影响并非在所有情境下都一致。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::44489a57a390ca0b4a1b1dd9255c3a8a8976eecacc0ce3982a682fcf086527b5",
      "multiple_values_in_field": true
    },
    "atom::67a249b0a04db4217aae2c9a": {
      "atom_id": "atom::67a249b0a04db4217aae2c9a",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制解释主要依赖作者对既往文献的引用和推测，而非本研究的实证数据。需结合其他提供直接微生物组数据的研究共同构建机制图景。",
        "contribution": "提出了“使用时窗”作为潜在机制的解释线索：仅在ICI前长期使用PPI才导致疗效下降，暗示需要时间累积的菌群失调（如细菌丰富度降低）是中介因素。同时指出特定菌属（Akkermansia muciniphila, Ruminococcus sp.）可能在NSCLC中起关键作用，而PPI对其有负面影响。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::b75d717f02e67596e1fe9d1154d554409c3e254c1dcec899aed6942699457a08",
      "multiple_values_in_field": true
    },
    "atom::4030853b97b313f1ee83aeda": {
      "atom_id": "atom::4030853b97b313f1ee83aeda",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于辅助回答“机制是什么”。虽然本文未提供直接机制数据，但其讨论部分引用的文献和观察到的时窗效应，为“菌群组成改变->免疫微环境改变->疗效下降”这一链条提供了临床层面的合理性支持和边界条件。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
