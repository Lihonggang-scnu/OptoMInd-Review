            "1"
          ]
        }
      ],
      "variant_group": "field::6af3757829432d2b7378c00d0759a6051aa4cd5fa15261496494a35a496448ee",
      "multiple_values_in_field": true
    },
    "atom::0340ed983bc0e3c14136cc66": {
      "atom_id": "atom::0340ed983bc0e3c14136cc66",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于阐述‘时机’作为关键调节变量的重要性，指导未来研究中暴露定义的标准化。",
      "role": "planning",
      "origins": [
        {
