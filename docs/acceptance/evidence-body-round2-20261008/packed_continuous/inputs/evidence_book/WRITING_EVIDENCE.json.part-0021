    "atom::ff069d73d1526888fa4862b1": {
      "atom_id": "atom::ff069d73d1526888fa4862b1",
      "source_handle": "P0157",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "关于类固醇影响的因果关系存在不确定性，作者指出这可能反映的是患者本身较差的性能状态或肿瘤生物学特征，而非类固醇本身的直接药理作用。证据等级多为回顾性队列研究。",
        "contribution": "指出了干扰肠道微生物群的常见医疗行为（抗生素、PPIs、类固醇）对ICI疗效的负面影响。特别指出抗生素的使用时机可能很重要（治疗后使用可能不影响），而类固醇的使用指征（管理副作用 vs 改善症状）可能与疗效差异相关，但也可能是预后不良的表现。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::4e8a6b09792021ffa6ec91290928444bada68e88a4228226a04c52dab3c864dd",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::d7f70e074a5455528a05910166cc593017328aec4625c5548c9af205dfd666e5",
      "multiple_values_in_field": true
    },
    "atom::801b5b1d5cdf177f6fe6a405": {
      "atom_id": "atom::801b5b1d5cdf177f6fe6a405",
      "source_handle": "P0157",
      "field_path": [
