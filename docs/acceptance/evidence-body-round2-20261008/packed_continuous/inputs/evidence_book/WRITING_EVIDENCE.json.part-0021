      "atom_id": "atom::21c2770b8294ce38478eeaea",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "文章强调了观察性研究中的指示偏倚（Indication Bias），即重症患者更多使用抗生素，导致抗生素负面效应被高估。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
