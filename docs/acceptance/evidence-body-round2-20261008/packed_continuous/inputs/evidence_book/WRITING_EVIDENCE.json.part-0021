    "atom::0f73c6641a8e9c70b79afec8": {
      "atom_id": "atom::0f73c6641a8e9c70b79afec8",
      "source_handle": "P0339",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "“无显著影响”不等于“无关联”，特别是在RCC和黑色素瘤亚组中，可能受限于统计效能或生物学特异性。",
      "role": "evidence",
      "origins": [
