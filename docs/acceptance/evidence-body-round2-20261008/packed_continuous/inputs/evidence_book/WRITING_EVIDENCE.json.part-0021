            "2"
          ]
        },
        {
          "record_id": "record::906aa19e46647370a9f64e800472d5db5546af60e5886aaf52eff77028d33b5e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::ca7c3a6066cb1f5725c92425143dfa2d5546a87fd1576a914d29d06838dc4811",
      "multiple_values_in_field": true
    },
    "atom::e0462e3aa134732c16a98ed0": {
      "atom_id": "atom::e0462e3aa134732c16a98ed0",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "作为理论框架的一部分，用于连接‘药物-微生物组-免疫’通路，尽管这些机制在该文中未被直接验证，但为后续机制研究提供了方向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
