            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::ecf3dba05b9eea3b3919d79544f4f5eea7387f5373a97abacf88892ce0f82c12",
      "multiple_values_in_field": false
    },
    "atom::4c1a462d1cfb008d4580725c": {
      "atom_id": "atom::4c1a462d1cfb008d4580725c",
      "source_handle": "P0275",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "在肝细胞癌（HCC）患者中，抗生素的使用是否会负面影响免疫检查点抑制剂（ICI）的治疗疗效（包括生存期和肿瘤反应）？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::5492f146c6bae3e102694faa72ab6e44d01b593545ebd31f1863de913c259f16",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::20950e034664cad0c970a515d9b3ba6d6fa8047a85a5ee6d30b206f88c1574d7",
      "multiple_values_in_field": false
    },
    "atom::b87ee95cafdd695d34f3e816": {
      "atom_id": "atom::b87ee95cafdd695d34f3e816",
      "source_handle": "P0275",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "肝细胞癌（HCC）患者接受免疫检查点抑制剂（ICI）治疗的情境；聚焦于抗生素使用史对ICI疗效的影响。纳入6项回顾性队列研究，共1056名患者。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::5492f146c6bae3e102694faa72ab6e44d01b593545ebd31f1863de913c259f16",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::2f395e3c47b5d389286a545c97b8b7b3a4abeb1accdd167b2b66333c7fe7cb50",
      "multiple_values_in_field": false
    },
    "atom::48dd4539095dbab4148815a4": {
      "atom_id": "atom::48dd4539095dbab4148815a4",
      "source_handle": "P0275",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究是一项系统综述与Meta分析，旨在评估抗生素使用是否影响接受ICI治疗的HCC患者的生存和临床疗效。鉴于肠道微生物群在ICI疗效中的关键作用以及抗生素对其的潜在干扰，且此前关于HCC中这一关联的研究结论存在争议，作者汇总了截至2022年5月的现有证据。通过对总体生存期（OS）、无进展生存期（PFS）、客观缓解率（ORR）和控制率（DCR）进行合并分析，结果显示抗生素使用并未显著降低HCC患者ICI治疗的疗效。讨论部分提出，由于HCC常伴随肝硬化及固有的免疫抑制微环境，抗生素引起的菌群失调可能不会像在其他癌症中那样进一步恶化预后，甚至可能通过改变免疫平衡产生中性或特定效应。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::5492f146c6bae3e102694faa72ab6e44d01b593545ebd31f1863de913c259f16",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::174e14bc4b0519c063e7b9a4d423ec80d2abcd318a98a0dd3b200bd147f2a83c",
      "multiple_values_in_field": false
    },
    "atom::013a10c4116a9c1a8ca17aeb": {
      "atom_id": "atom::013a10c4116a9c1a8ca17aeb",
      "source_handle": "P0275",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述规划提供了重要的“阴性结果”案例和机制解释素材。它证明了在HCC这一特定实体瘤中，抗生素-微生物轴对ICI疗效的影响模式可能不同于其他癌症。这有助于在综述中构建“肿瘤类型特异性”的比较维度，并支持关于肝硬化背景下免疫微环境独特性的机制讨论。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::5492f146c6bae3e102694faa72ab6e44d01b593545ebd31f1863de913c259f16",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::6d88385b7749b3dfd413c8b49a3b080873646571bad2b617f41d824ae5e80b9f",
      "multiple_values_in_field": false
    },
    "atom::3d0b745c0e4e45b06dd6bbb2": {
      "atom_id": "atom::3d0b745c0e4e45b06dd6bbb2",
      "source_handle": "P0275",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限HCC人群；回顾性数据；未区分抗生素种类；不能外推至所有实体瘤。",
        "contribution": "提供了HCC患者中抗生素使用与ICI疗效关联的定量综合证据（OS, PFS, ORR均无显著负面影响）。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
