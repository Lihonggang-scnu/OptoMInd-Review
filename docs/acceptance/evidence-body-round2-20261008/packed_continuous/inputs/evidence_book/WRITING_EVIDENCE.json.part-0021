      "atom_id": "atom::f67a30fcc4210f4490f80afe",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究为Meta分析，其结论是基于已发表观察性研究的汇总，而非新的原始实验数据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
          "field_path": [
