    "atom::673fe1b1c6fa64b23bbca90c": {
      "atom_id": "atom::673fe1b1c6fa64b23bbca90c",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用PRISMA 2020指南进行系统综述和荟萃分析。检索EMBASE、MEDLINE/PubMed、Cochrane Library及主要肿瘤学会议摘要。纳入标准包括报告ICI治疗癌症患者中PPI使用者与非使用者的OS或PFS HR值的研究。数据提取后，使用随机效应模型合并HR，并通过Cochran's Q检验和I²指数评估异质性。进一步按PPI使用时窗、癌症类型、ICI类型、治疗线数和地理区域进行亚组分析，并使用Meta回归和Egger's检验评估偏倚。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::67c64057a695176f3f425255aad136d0280b77a859af0942ff4cca6689b74f3b",
      "multiple_values_in_field": false
    },
    "atom::3a97877bd2a04cac1e03468c": {
      "atom_id": "atom::3a97877bd2a04cac1e03468c",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了目前最大规模的证据综合，确认了PPI使用与ICI疗效降低之间的整体负相关关系，并细化了这种关联依赖于PPI使用时窗（长期/预防性 vs. 短期/伴随）和癌症类型。",
        "limits": "所给材料未交代具体的微生物组测序数据或机制验证实验，结论基于流行病学观察数据的汇总。亚组分析受限于原始研究中缺失的临床细节（如具体PPI种类、饮食、种族、PD-L1状态），且部分亚组（如抗CTLA-4）样本量不足，无法得出确切结论。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::a7b8288338ec3f31bdc48fc3ac06e14a867dbd9a9b2574eb799eefc5a09020c0",
      "multiple_values_in_field": false
    },
    "atom::c5c7c848d2267c32c1656faa": {
      "atom_id": "atom::c5c7c848d2267c32c1656faa",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "总体人群（33项研究，约15,957名OS患者）",
        "finding": "PPI使用与较短的OS（HR=1.31, 95% CI 1.19–1.44）和PFS（HR=1.30, 95% CI 1.17–1.46）显著相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::b8c659aeac980021ee44034574947c922b61d76798d8607cde15d0a2b88cd63a",
      "multiple_values_in_field": true
    },
    "atom::e5dda61b521df9c7791bf483": {
      "atom_id": "atom::e5dda61b521df9c7791bf483",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "PPI使用时窗：基线治疗或ICI前60天内开始",
        "finding": "在基线使用PPI（Group A）或ICI前60天内开始使用PPI（Group B）的患者中，OS和PFS均显著缩短；而在ICI治疗期间或之后才开始使用PPI（Group C）时，未观察到显著的生存负面影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::b8c659aeac980021ee44034574947c922b61d76798d8607cde15d0a2b88cd63a",
      "multiple_values_in_field": true
    },
    "atom::1559e5554251aed1ed0af220": {
      "atom_id": "atom::1559e5554251aed1ed0af220",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "癌症类型：非小细胞肺癌（NSCLC）和尿路上皮癌（UC）",
        "finding": "PPI使用显著缩短NSCLC和UC患者的OS和PFS；而在肾细胞癌（RCC）和黑色素瘤患者中，未观察到显著的生存影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::f9f824afa05f7d0c7d0e6a65334c45f5e76caeb4d4d83a33a37c177ad704aa51",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::b8c659aeac980021ee44034574947c922b61d76798d8607cde15d0a2b88cd63a",
      "multiple_values_in_field": true
    },
    "atom::8ee45ba2ed470beb951d0886": {
      "atom_id": "atom::8ee45ba2ed470beb951d0886",
      "source_handle": "P0339",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI类型：抗PD-1/PD-L1单抗",
        "finding": "在抗PD-1、抗PD-L1及抗PD-(L)1治疗亚组中，PPI使用显著降低生存率；由于样本量极少，抗CTLA-4单药或联合疗法的亚组结果不具统计效力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98c0f127b9bce83ded2d7d1473a6e4205924312a9dce7060403b91d584707415",
          "field_path": [
