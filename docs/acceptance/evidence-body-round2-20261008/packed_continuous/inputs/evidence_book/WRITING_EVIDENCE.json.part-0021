        }
      ],
      "variant_group": "field::33f66c750c554443a9f914ad279abe880fa6a1f0af01fae352a43a839d7f9ce9",
      "multiple_values_in_field": true
    },
    "atom::1817b1bd2cfbc9780921a06c": {
      "atom_id": "atom::1817b1bd2cfbc9780921a06c",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "抗生素给药时间与ICI启动的关系",
        "finding": "负面关联在ICI启动前短期内（如30天内）给予抗生素时最为明显；而ICI启动后或治疗期间的抗生素使用对生存影响的证据较弱或不一致。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::33f66c750c554443a9f914ad279abe880fa6a1f0af01fae352a43a839d7f9ce9",
      "multiple_values_in_field": true
    },
    "atom::ff45ac7286338d1f91afc20a": {
      "atom_id": "atom::ff45ac7286338d1f91afc20a",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同肿瘤类型",
        "finding": "在黑色素瘤、非小细胞肺癌（NSCLC）和肾细胞癌（RCC）中观察到一致的负面信号；但在肝细胞癌（HCC）中，由于肝硬化、感染风险和肠-肝轴功能障碍，情况更为复杂，混杂因素更多。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::33f66c750c554443a9f914ad279abe880fa6a1f0af01fae352a43a839d7f9ce9",
      "multiple_values_in_field": true
    },
    "atom::a5122d2f44c106df1c8a2c8d": {
      "atom_id": "atom::a5122d2f44c106df1c8a2c8d",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物组干预研究",
        "finding": "早期转化研究和早期干预试验表明，通过粪便微生物移植（FMT）等方式调节肠道微生物群可能部分恢复对ICI的反应性，提供概念验证证据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::33f66c750c554443a9f914ad279abe880fa6a1f0af01fae352a43a839d7f9ce9",
      "multiple_values_in_field": true
    },
    "atom::5599720cdbe584ec8fac742a": {
      "atom_id": "atom::5599720cdbe584ec8fac742a",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::45254e120d19999ddf61aa621c6c532963810a253e0a99386d9908594351b175",
      "multiple_values_in_field": false
    },
    "atom::d316148dbd58eddbdd7a3a7a": {
      "atom_id": "atom::d316148dbd58eddbdd7a3a7a",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管免疫检查点抑制剂改变了癌症治疗格局，但仅部分患者获得持久获益。鉴于肠道微生物群在调节抗肿瘤免疫中的关键作用，抗生素通过破坏微生物稳态可能负面影响免疫治疗的有效性。本研究旨在解决：抗生素暴露如何具体影响ICI疗效？其背后的生物学机制是什么？不同肿瘤类型和时间窗口下的效应是否一致？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::bad4bac9a77d79f173e1a55e568d128ca4c9ee01f826630bb41372ab00fbbd13",
      "multiple_values_in_field": false
    },
    "atom::aeaedf6a7830f65568ba6dc1": {
      "atom_id": "atom::aeaedf6a7830f65568ba6dc1",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "该综述聚焦于实体瘤患者接受免疫检查点抑制剂（ICIs）治疗期间，抗生素暴露对治疗疗效的影响。研究对象涵盖多种实体瘤类型（如黑色素瘤、非小细胞肺癌、肾细胞癌、肝细胞癌等），情境包括临床回顾性队列、前瞻性观察研究及荟萃分析，旨在综合评估抗生素使用与ICI疗效之间的关联及其潜在机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::2f758397e724a1f98978f2e45275e988c151d04abc5b4d3519263005e8f438d1",
      "multiple_values_in_field": false
    },
    "atom::6c16615d51a43890a22ccc2d": {
      "atom_id": "atom::6c16615d51a43890a22ccc2d",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本文是一篇叙述性综述，旨在综合当前关于抗生素暴露如何影响免疫检查点抑制剂（ICIs）疗效的临床前和临床证据。文章首先回顾了肠道微生物群在调节抗肿瘤免疫反应中的关键作用，随后系统梳理了多项回顾性临床研究、肿瘤特异性验证研究以及系统性综述和荟萃分析的结果。研究发现，抗生素暴露（尤其是ICI启动前的短期暴露）与较差的临床结局（如无进展生存期缩短、总生存期降低和治疗反应率下降）一致相关。文章还讨论了这种关联在不同肿瘤类型中的表现差异、时间依赖性特征，并指出目前证据主要基于观察性数据，存在混杂因素，但支持谨慎使用抗生素以优化免疫治疗效果的临床建议。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::cb839baff2098f982ef4c0e05aef3ca4ba4c0a7055b39816777b3fe1b0cce827",
      "multiple_values_in_field": false
    },
    "atom::43d00cbc53fea1a1025e3ec3": {
      "atom_id": "atom::43d00cbc53fea1a1025e3ec3",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物群介导的抗生素对ICI疗效的影响提供了全面的临床证据背景和机制解释。它特别适用于回答抗生素暴露的时间依赖性、不同实体瘤类型的敏感性差异，以及从观察性关联到潜在因果机制（微生物组失调）的逻辑链条。虽然不能提供直接的因果证明，但其综合的荟萃分析和叙述性证据是构建‘微生物群-免疫-药物’相互作用综述的关键背景素材。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::5644bc4e7c78755a5e758c6e14d5add03b04a3b7e70a6d45cb7233935958408e",
      "multiple_values_in_field": false
    },
    "atom::dc5831345b38dd4c7a68afd9": {
      "atom_id": "atom::dc5831345b38dd4c7a68afd9",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些是观察性关联，受混杂因素（如感染严重程度、基线健康状况）影响，不能直接证明抗生素是导致疗效降低的唯一原因。",
        "contribution": "提供了抗生素暴露与ICI疗效负相关的大规模临床证据汇总，包括多个荟萃分析的数据（如Tsikala-Vafea 2021, Wu 2021, Crespin 2023等），证实了跨肿瘤类型的一致性信号。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::6af3757829432d2b7378c00d0759a6051aa4cd5fa15261496494a35a496448ee",
      "multiple_values_in_field": true
    },
    "atom::13215e8458cede64b002abf3": {
      "atom_id": "atom::13215e8458cede64b002abf3",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于支持综述中关于‘抗生素暴露普遍降低ICI疗效’的观察性证据部分，特别是量化效应大小和一致性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "review_planning_B",
