    },
    "atom::b935fb750118e4c26f8b0177": {
      "atom_id": "atom::b935fb750118e4c26f8b0177",
      "source_handle": "P0033",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "纵向采样仅覆盖前12周，未能捕捉长期治疗（如维持治疗阶段）的微生物变化，因此发现的动态模式可能仅代表早期治疗反应。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::80b33fd7b89d6836b1f0d00c8597fd6d579fb8da4ac0b2d58de541e9da29b063",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::2f20cb117d3be40ac17e702e71978bfa4d8e2761f2b14da51953753d19b9ced6",
      "multiple_values_in_field": true
    },
    "atom::c8d09070a5884c4c57ef8508": {
      "atom_id": "atom::c8d09070a5884c4c57ef8508",
      "source_handle": "P0033",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "微生物功能的推断基于基因含量（MetaCyc），而非实际表达的蛋白质或代谢物水平，因此关于SCFA或多胺的作用仅为潜在机制假设。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::80b33fd7b89d6836b1f0d00c8597fd6d579fb8da4ac0b2d58de541e9da29b063",
          "field_path": [
            "review_planning_B",
