    "atom::81c8588b8e6c8ab096386ff9": {
      "atom_id": "atom::81c8588b8e6c8ab096386ff9",
      "source_handle": "P0421",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为对比案例，展示某些传统认为的不良预后因素（如肌肉减少症）在免疫治疗时代可能不再具有相同的负面预测价值。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::83bafae2b4e03afbb57b0bdb0620482e9b023eed5740d4de2e66bf40ff28a284",
          "field_path": [
            "review_planning_B",
