            "1"
          ]
        }
      ],
      "variant_group": "field::c7253f3ae5ff410c4511abb7d0a5a927eddf8148feaae5ab344687284ccc86b5",
      "multiple_values_in_field": true
    },
    "atom::0abe81bb7a64d7526364eb42": {
      "atom_id": "atom::0abe81bb7a64d7526364eb42",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "对于肝细胞癌（HCC）等复杂病例，混杂因素（如肝硬化、感染）可能独立影响预后，因此该人群中的观察结果可能高估或低估抗生素的真实效应。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::c7253f3ae5ff410c4511abb7d0a5a927eddf8148feaae5ab344687284ccc86b5",
      "multiple_values_in_field": true
    },
    "atom::cebd35152668d9cb749c17ac": {
      "atom_id": "atom::cebd35152668d9cb749c17ac",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "微生物组机制的解释主要基于临床前模型和小规模转化研究，人类临床数据中缺乏直接的微生物组-临床结局配对分析，因此机制部分属于‘生物合理性’而非‘直接实证’。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
