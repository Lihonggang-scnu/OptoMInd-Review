    },
    "atom::d5a4895deae81aa7b724d731": {
      "atom_id": "atom::d5a4895deae81aa7b724d731",
      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "文章指出当前证据基础碎片化，大多数研究为回顾性、单中心、小样本，且暴露定义和混杂因素调整不一致。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
