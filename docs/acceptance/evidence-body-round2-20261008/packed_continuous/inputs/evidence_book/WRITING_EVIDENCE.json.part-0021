    "atom::cd81892a7d47681f25583100": {
      "atom_id": "atom::cd81892a7d47681f25583100",
      "source_handle": "P0402",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "不同研究对‘短期’的定义不一（30天、60天等），且多为回顾性数据，精确的时间阈值尚不明确。",
        "contribution": "详细分析了抗生素暴露的时间依赖性，指出ICI启动前短期暴露（<30天）的负面影响最显著，而治疗期间暴露的影响较弱或不一致。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
