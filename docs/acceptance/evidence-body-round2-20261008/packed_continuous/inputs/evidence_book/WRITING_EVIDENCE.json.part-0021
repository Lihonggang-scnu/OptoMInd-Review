    "atom::1f4757c5d2cf31a3d82435c2": {
      "atom_id": "atom::1f4757c5d2cf31a3d82435c2",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法。通过PubMed/MEDLINE、Embase和Web of Science数据库进行聚焦式文献检索，关键词包括“antibiotics”、“immune checkpoint inhibitors”、“PD-1/PD-L1”、“CTLA-4”、“gut microbiome”和“cancer”。纳入标准包括相关的临床前研究、回顾性和前瞻性临床队列以及高质量综述。由于研究设计、肿瘤类型和抗生素暴露定义存在显著异质性，作者未采用正式的系统评价框架，而是对发现进行叙述性综合和分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::901b7d0fa30f6dbdab791130a56fde5dc3071855e51a12684d258258a4b5e3f5",
      "multiple_values_in_field": false
    },
    "atom::aab0c4d15504c95cedd8d64d": {
      "atom_id": "atom::aab0c4d15504c95cedd8d64d",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统性地综合了截至2026年的临床前和临床证据，确立了抗生素暴露（特别是ICI前短期暴露）与ICI疗效降低之间的一致性关联，强调了时间窗口的重要性。",
        "limits": "主要依赖回顾性观察性数据，无法确立因果关系；存在显著的异质性（暴露定义、肿瘤类型、混杂因素）；缺乏常规微生物组 profiling 数据以直接关联微生物变化与临床结果；可能存在发表偏倚。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::a07f54cba50f732eae2e991e85571b4743e1b5d323509d7b4d53fbaa1ab53767",
      "multiple_values_in_field": false
    },
    "atom::86d0069ca2640e59106d1eb1": {
      "atom_id": "atom::86d0069ca2640e59106d1eb1",
      "source_handle": "P0402",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多肿瘤类型回顾性队列及荟萃分析",
        "finding": "抗生素暴露与较差的临床结果一致相关，包括无进展生存期（PFS）、总生存期（OS）和治疗反应率（RR/ORR）降低，以及疾病进展（PD）风险增加。"
      },
      "role": "evidence",
      "origins": [
