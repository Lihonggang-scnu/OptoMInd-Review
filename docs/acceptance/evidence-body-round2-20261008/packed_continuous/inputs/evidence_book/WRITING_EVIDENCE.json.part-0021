    "atom::117a62fe7c8a63af3badf4cc": {
      "atom_id": "atom::117a62fe7c8a63af3badf4cc",
      "source_handle": "P0275",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "遵循PRISMA指南进行系统综述和Meta分析。检索PubMed、EMBASE、Cochrane Library等数据库。纳入标准：确诊HCC、接受ICI治疗、按抗生素使用史分组、报告OS/PFS/ORR/DCR结局。采用随机效应模型（异质性高时）或固定效应模型处理数据，计算HR和OR及其95%置信区间。进行敏感性分析、亚组分析（如排除中国文献以检验稳健性）及发表偏倚检测（Begg's/Egger's test）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::5492f146c6bae3e102694faa72ab6e44d01b593545ebd31f1863de913c259f16",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::7835b8c2924e97b9b0c8e01258a1b95e400e979d817d06e5efe3e76c8daf1ac7",
      "multiple_values_in_field": false
    },
    "atom::20ae11a706774b732e189093": {
      "atom_id": "atom::20ae11a706774b732e189093",
      "source_handle": "P0275",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了首个专门针对HCC人群的Meta分析证据，表明抗生素使用不损害ICI疗效，与其他实体瘤（如肺癌、黑色素瘤）中观察到的负面效应形成对比。",
        "limits": "纳入研究均为回顾性性质，存在选择偏倚风险；样本量相对较小（仅1056人）；主要基于亚洲人群数据；无法进行基于抗生素类型、剂量或具体菌群的亚组分析；未能评估抗生素与ICI相关不良事件的关系。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c67b5d8b30e7f076ea0fed44be195c65def9ab6263f1ac72cd9a93c04a19865b",
          "field_path": [
