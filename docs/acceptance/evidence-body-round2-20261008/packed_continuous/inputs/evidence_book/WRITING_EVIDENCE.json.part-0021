    "atom::17255d138ac250020e5ad8cb": {
      "atom_id": "atom::17255d138ac250020e5ad8cb",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统综述和荟萃分析方法。按照PRISMA 2020指南进行文献检索（PubMed, Scopus, EMBASE），纳入2018-2025年发表的研究。纳入标准包括：评估实体瘤患者ICI治疗期间ABT暴露与时间事件结局关联的研究，且明确定义了ABT暴露窗口。统计分析主要使用随机效应模型。预先指定的敏感性分析专注于NSCLC亚组，因其样本量最大且方法学同质性最高。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::2546759f5c68a90d2a543d7820af59ef05d4fb2d7054f0ade86f68458e3e99df",
      "multiple_values_in_field": false
    },
    "atom::d51753b9deb1908a713b7583": {
      "atom_id": "atom::d51753b9deb1908a713b7583",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了截至2025年关于全身性抗生素暴露影响实体瘤ICI疗效的最新系统综述和荟萃分析数据，特别强调了NSCLC亚组中PFS受损的稳健证据。",
        "limits": "所给摘要未交代具体的抗生素种类、给药时机细节、微生物群具体组成变化机制、以及不同ICI药物类型的分层分析结果。结论基于观察性研究的汇总，因果推断受限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::c63faae8c477ddc2465c419cc5382e06a3745c4c32bb0659cf79909bccdf0f33",
      "multiple_values_in_field": false
    },
    "atom::67f30b284f0468dd246028f1": {
      "atom_id": "atom::67f30b284f0468dd246028f1",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "所有纳入的实体瘤患者（N=52,489）",
        "finding": "ABT暴露与较差的总生存期（OS）相关（随机效应HR 1.16, 95% CI 1.03–1.29），以及数值上较差的无进展生存期（PFS）（随机效应HR 1.11, 95% CI 0.95–1.27）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::4e0a29d75b6ad27ddbdb082898da1ca9b077da2b9a1cf8ac3c445487e5ddf2bc",
      "multiple_values_in_field": true
    },
    "atom::32c37e994a3eb3753a0b281e": {
      "atom_id": "atom::32c37e994a3eb3753a0b281e",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "NSCLC亚组敏感性分析（N=45,896）",
        "finding": "OS方面观察到中度异质性（I² = 51%），合并固定效应HR为1.05 (95% CI 0.996–1.11)，显示ABT暴露倾向于导致生存率下降的趋势。PFS方面无异质性（I² = 0%），ABT暴露与疾病进展风险显著增加相关（HR 1.16, 95% CI 1.02–1.30），固定效应和随机效应估计值一致。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::4e0a29d75b6ad27ddbdb082898da1ca9b077da2b9a1cf8ac3c445487e5ddf2bc",
      "multiple_values_in_field": true
    },
    "atom::3fd44fd7b782ff4952e9c7bf": {
      "atom_id": "atom::3fd44fd7b782ff4952e9c7bf",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::59e64d68ed157a993d226cc471ab1e988a3a76963504b9cba9481585e03e979a",
      "multiple_values_in_field": false
    },
    "atom::5c1371a423934fc6969812f6": {
      "atom_id": "atom::5c1371a423934fc6969812f6",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管免疫检查点抑制剂改变了实体瘤的管理，但只有部分患者能获得持久获益。鉴于肠道微生物群是抗肿瘤免疫的关键调节者，且全身性抗生素治疗会破坏微生物稳态，观察性研究显示抗生素可能损害ICI疗效，但结果异质性大。本研究旨在通过更新的综合分析，特别是针对肿瘤特异性分析，来澄清这种关联。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::a67f1066422197589fe08a2f8d8c29bf27c5ff4fc29687ea0c084467c2f5371b",
      "multiple_values_in_field": false
    },
    "atom::8de64a57f2e00d7504bd561c": {
      "atom_id": "atom::8de64a57f2e00d7504bd561c",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "实体瘤患者接受免疫检查点抑制剂（ICI）治疗期间，全身性抗生素暴露（ABT）与时间事件结局（总生存期OS、无进展生存期PFS）的关联；特别聚焦于非小细胞肺癌（NSCLC）亚组。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::d6fc3486beb4c6c94ba3432fc0676109f164baf5eb8463a2391482e1653edfd2",
      "multiple_values_in_field": false
    },
    "atom::27cdf5686bb05898ae3904a0": {
      "atom_id": "atom::27cdf5686bb05898ae3904a0",
      "source_handle": "P0236",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "该研究旨在综合现有证据，评估在实体瘤免疫治疗背景下，全身性抗生素使用对疗效的影响。作者遵循PRISMA 2020指南进行了系统综述和荟萃分析，检索了2018年至2025年间PubMed、Scopus和EMBASE数据库中的相关研究。主要发现表明，整体而言，抗生素暴露与较差的总生存期相关，且在非小细胞肺癌亚组中，抗生素暴露与显著增加的疾病进展风险（无进展生存期缩短）一致。这支持了微生物群介导的免疫治疗疗效受损假说。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::43c7a54c0f058661b74f16bf45f85832bfa0445be6e887c4a0778d52d9592164",
      "multiple_values_in_field": false
    },
    "atom::2014bb432671c331d6e80ddb": {
      "atom_id": "atom::2014bb432671c331d6e80ddb",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了关于全身性抗生素暴露如何负面影响免疫检查点抑制剂（ICI）疗效的大规模荟萃分析证据，特别是在非小细胞肺癌（NSCLC）中。它为“微生物群介导的ICI疗效受损”这一假设提供了强有力的流行病学支持，并指出了抗生素管理在ICI治疗中的重要性。对于综述而言，它是解释临床观察到的疗效差异的重要背景材料，也是连接微生物群理论与临床预后结果的桥梁。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::925c04f86988faed93cdd3aa1943f1ac27990ed81bc4d8243e5e565dcdc6aa14",
      "multiple_values_in_field": false
    },
    "atom::308857ae59dc55b5f77e4a3f": {
      "atom_id": "atom::308857ae59dc55b5f77e4a3f",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅展示了抗生素暴露与临床预后的关联，未直接测量或分析微生物群的具体变化。不能直接说明是哪种微生物或机制导致了这种效果。",
        "contribution": "提供了大规模荟萃分析数据，证实全身性抗生素暴露与实体瘤（特别是NSCLC）患者ICI治疗后的较差生存结局（OS和PFS）相关。具体数据显示NSCLC患者中PFS风险显著增加（HR 1.16）。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::dc28c8e77ac8ea8c871742f0262d2ddb95cb534545870959a47dfc761b54bd33",
      "multiple_values_in_field": true
    },
    "atom::072c0957f9de98d6f5de4736": {
      "atom_id": "atom::072c0957f9de98d6f5de4736",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物群如何调节实体瘤中免疫检查点抑制剂的疗效”这一问题，提供临床层面的负面调节证据。可作为抗生素干扰ICI疗效的临床后果的具体量化指标。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::6eca3e70348d3d429ec211696770f6242be7fe0cfbd87d1bd5ee973354e9ef1a",
      "multiple_values_in_field": true
    },
    "atom::3201db5ff23b171bd73e2f4b": {
      "atom_id": "atom::3201db5ff23b171bd73e2f4b",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "本身不提供具体的分子或细胞机制细节（如特定菌群、代谢物、免疫细胞通路）。其机制主张是基于观察性关联的推论，需结合其他提供机制详情的研究。",
        "contribution": "提出了“微生物群介导的免疫治疗疗效受损”作为潜在机制的解释框架，并呼吁未来研究整合微生物谱分析和标准化的抗生素暴露定义。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::dc28c8e77ac8ea8c871742f0262d2ddb95cb534545870959a47dfc761b54bd33",
      "multiple_values_in_field": true
    },
    "atom::f0d1849b5f83cc64a900de79": {
      "atom_id": "atom::f0d1849b5f83cc64a900de79",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "为机制探讨提供理论背景和方向指引。虽然未提供直接的分子机制数据，但其结论强化了微生物群在ICI疗效中的核心地位，有助于构建从微生物扰动到临床结局的逻辑链条。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::6eca3e70348d3d429ec211696770f6242be7fe0cfbd87d1bd5ee973354e9ef1a",
      "multiple_values_in_field": true
    },
    "atom::9207249c58ffe931918a996b": {
      "atom_id": "atom::9207249c58ffe931918a996b",
      "source_handle": "P0236",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "指出尽管ICI改变了实体瘤管理，但仅部分患者获益，且抗生素使用常见且可能有害。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c",
