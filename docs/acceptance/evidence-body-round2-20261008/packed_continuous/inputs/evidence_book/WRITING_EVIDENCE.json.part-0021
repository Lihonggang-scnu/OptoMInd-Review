      "source_handle": "P0081",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "建议未来研究应关注特定益生菌菌株和抗生素类别的影响，标准化微生物组测量协议，并进行前瞻性随机对照试验。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::cfd720a60726f8527337227ce6718295b9e92c9d29dad97e90dd74536cdbcfec",
