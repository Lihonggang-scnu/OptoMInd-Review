    },
    "atom::bbd82f3d93056270fa4c5d4e": {
      "atom_id": "atom::bbd82f3d93056270fa4c5d4e",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "Recurrent gynecologic malignancies (ovarian, cervical, endometrial) treated with anti-PD-1 monotherapy (pembrolizumab or nivolumab) at two academic centers in Korea.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::d27ba5146b65a5454b2f8decdcc0d249e3505867d4279d77badb5a946584ec10",
      "multiple_values_in_field": false
    },
    "atom::b65cd3de8f464ec01d8e0c43": {
      "atom_id": "atom::b65cd3de8f464ec01d8e0c43",
      "source_handle": "P0360",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This retrospective cohort study evaluated the association between prior antibiotic use and oncological outcomes in patients with recurrent gynecologic cancers receiving immune checkpoint inhibitors (ICIs). The study analyzed clinical data from 215 patients to determine if antibiotic exposure within 60 days before ICI initiation affected disease control rate (DCR) and overall survival (OS). It identified a cumulative antibiotic duration of >14 days as an independent predictor of poor OS, while noting that DCR was not significantly altered by antibiotic use. The authors attribute these findings to potential gut microbiota dysbiosis induced by prolonged antibiotic therapy.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::c370bcbc3ea45294262b90f8d5468a8fa4ef6d9279fb0617114bc65947725f01",
      "multiple_values_in_field": false
    },
    "atom::8f4571f01074681cc0a730be": {
      "atom_id": "atom::8f4571f01074681cc0a730be",
      "source_handle": "P0360",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This paper provides real-world clinical evidence supporting the hypothesis that antibiotic-induced gut dysbiosis negatively impacts ICI efficacy, specifically manifesting as reduced Overall Survival rather than immediate lack of disease control. It offers specific data on the threshold of antibiotic duration (>14 days) associated with adverse outcomes in gynecologic cancers, serving as a concrete example of the 'antibiotic-microbiome-ICI' interaction axis.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::68a4986a0eb4a3c2ff16c32d9e7ac369ad7723c91de954327f9b98be693fcf82",
      "multiple_values_in_field": false
    },
    "atom::b34f121ad4f2197802092e13": {
      "atom_id": "atom::b34f121ad4f2197802092e13",
      "source_handle": "P0360",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Limited to gynecologic cancers; does not prove causality via microbiome measurement; effect size is observational.",
        "contribution": "Provides empirical clinical data showing that prior antibiotic use (specifically ≥14 days) is associated with reduced Overall Survival in solid tumors (gynecologic cancers), supporting the modulatory role of the microbiome environment on ICI efficacy.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::3dc322e0e38229a9a18f0133dd61b6df304b2a95a24de4e5be1d9c3bd361d0cf",
      "multiple_values_in_field": true
    },
