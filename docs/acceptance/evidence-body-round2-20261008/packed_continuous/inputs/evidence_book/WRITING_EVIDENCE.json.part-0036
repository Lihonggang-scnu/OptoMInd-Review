    "record::1665125cc52bd142aafc9e1a5b64a3dd5f2f4f48cbd957b6f5c0c39a5e075f43": {
      "source_handle": "P0132",
      "title": "Human Microbiome and Its Medical Applications",
      "year": "2022",
      "doi": "10.3389/fmolb.2021.703585",
      "paper_id": "3ae3c79b877e85a192dae9804adf84211ceedab7",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用主题式综合叙述方法。首先按疾病类别（代谢疾病、肿瘤、病原体感染）分别梳理微生物组的作用机制（代谢调节、免疫调节、基因毒性等）；其次，针对每类疾病，对比分析不同层级的干预手段（从非特异性FMT/益生菌到特异性工程菌）；最后，讨论工程菌作为下一代益生菌在体内传感、治疗和生物 containment 方面的技术路线及局限性。",
        "contribution_and_limits": [
          {
            "contribution": "提供了微生物组在代谢、肿瘤和感染三大领域作用机制的系统性框架，特别强调了工程菌在精准医疗中的多样化角色（传感、治疗、诊断）。",
            "limits": "作为综述，其结论依赖于引用的原始研究，未提供新的实验数据；对工程菌临床转化的描述主要基于作者对现有文献的综合，实际临床成功率（如SYNB1020的失败案例）提示了当前技术的局限性。"
          }
        ],
        "key_findings": [
          {
            "conditions": "代谢疾病模型中",
            "finding": "微生物组通过分泌短链脂肪酸（SCFA）、次级胆汁酸和TMAO等代谢物调节宿主代谢；同时，肠道屏障功能障碍导致的低度全身性炎症是代谢疾病的重要驱动因素。"
          },
          {
            "conditions": "肿瘤治疗背景下",
            "finding": "特定肠道菌群组成（如Roseburia hominis富集、Prevotella/Bacteroides比例高）与免疫检查点抑制剂（ICIs）的良好响应相关；而某些菌群（如Veillonella parvula）与非响应相关。微生物组还通过ROS产生、药物代谢（如5-FU）和TNF激活影响化疗效果。"
          },
          {
            "conditions": "病原体感染背景下",
            "finding": "共生微生物组通过营养竞争、抗菌素分泌（直接途径）和激活宿主免疫/产生抗菌肽（间接途径）提供定植抗力。工程菌可设计为感知病原体信号（如CAI-1）并释放毒素或酶进行靶向清除。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "阐明共生微生物组在多种重大疾病（代谢病、癌症、感染）中的病理生理机制，并评估基于微生物组的干预策略（尤其是工程菌）的临床潜力与应用现状。",
        "research_scope": "人类共生微生物组（包括肠道、皮肤、阴道等部位）及其在代谢疾病、肿瘤和病原体感染中的医学应用，重点涵盖传统干预手段（益生菌、FMT）与合成生物学工程菌的应用。",
        "work_summary": "该综述旨在总结共生微生物组在特定疾病中的作用机制及工程菌在疾病预防、检测和治疗的最新进展。文章首先回顾了微生物组通过代谢产物（如SCFA、胆汁酸、TMAO）和炎症调节影响宿主代谢的机制，随后探讨了微生物组在肿瘤发生、转移及治疗反应（特别是免疫检查点抑制剂ICIs和化疗）中的双向作用，最后阐述了微生物组通过定植抗力抵抗病原体感染的机制。在此基础上，文章系统梳理了从非靶向干预（抗生素、饮食、FMT、益生菌）到靶向干预（工程菌作为传感器、治疗剂或诊断工具）的策略演变，并指出了工程菌临床转化面临的挑战。"
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "提供肿瘤内微生物组的背景知识",
            "material": "文章指出肿瘤组织（如乳腺癌、胶质母细胞瘤）中存在独特的微生物组成，且肿瘤内细菌可能随癌细胞转移至转移灶，促进肿瘤生长。",
            "purpose": "用于背景介绍，说明微生物组不仅在肠道起作用，肿瘤微环境本身也存在微生物群落，这可能影响局部免疫和治疗反应。"
          },
          {
            "connection_to_review": "提供微生物组与放疗相互作用的反例/复杂性",
            "material": "文章引用Shiao et al. (2021)的研究，指出肿瘤内细菌对放疗后的抗肿瘤免疫反应是必要的，而肿瘤内真菌通过Dectin-1受体抑制抗肿瘤免疫反应。",
            "purpose": "用于讨论微生物组成分的双向作用或复杂性，说明并非所有微生物都增强疗效，真菌可能起抑制作用，提示干预时需考虑菌群平衡。"
          },
