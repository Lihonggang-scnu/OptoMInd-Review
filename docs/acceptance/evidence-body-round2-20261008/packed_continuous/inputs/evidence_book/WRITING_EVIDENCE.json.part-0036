    "record::a808293b102fa5821c8a3af3eecbf34c4f6d97706d9adcf2e6fde0fc4f12038b": {
      "source_handle": "P0535",
      "title": "Intratumoral Microbiota in Tumor: Current Understandings and Future Perspectives",
      "year": "2026",
      "doi": "10.1002/mco2.70825",
      "paper_id": "eea4059be35526f75d745cc8d16db8ec33658f69",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "The authors conducted a narrative review, synthesizing evidence from historical milestones, recent high-throughput sequencing studies, spatial profiling, and mechanistic in vitro/in vivo experiments. They organized the content into thematic sections: historical/methodological foundations, bacterial characterization (origin/diversity), effects on tumor initiation/progression, roles in metastasis, immune crosstalk, diagnostic/prognostic value, and therapeutic applications. The review integrates findings from various cancer types, emphasizing context-dependency and methodological rigor (e.g., distinguishing correlation from causation, addressing contamination issues).",
        "contribution_and_limits": [
          {
            "contribution": "Provides a comprehensive framework linking intratumoral bacteria to all stages of cancer progression, from initiation to metastasis and therapy response. Highlights the bidirectional nature of immune modulation and the importance of context-dependency.",
            "limits": "As a review, it synthesizes existing literature rather than generating new primary data. Many cited mechanisms are based on specific model systems (e.g., mouse models, cell lines) or correlative human studies; causal relationships in humans require further validation. The field faces significant methodological challenges regarding low biomass and contamination that limit the robustness of some conclusions."
          }
        ],
        "key_findings": [
          {
            "conditions": "Across multiple solid tumors, using sequencing and spatial methods",
            "finding": "Intratumoral bacteria are prevalent, tissue-specific, and metabolically active, not merely contaminants. Their composition varies significantly by cancer type and anatomical site."
          },
          {
            "conditions": "Mechanistic studies (in vitro/vivo)",
            "finding": "Bacteria like Fusobacterium nucleatum (Fn) and Enterotoxigenic Bacteroides fragilis (ETBF) promote tumorigenesis via genomic instability (colibactin, fragilysin), epigenetic reprogramming, and activation of oncogenic pathways (Wnt/β-catenin, PI3K/AKT)."
          },
          {
            "conditions": "Metastasis models",
            "finding": "Intratumoral bacteria facilitate metastasis by inducing EMT, remodeling host cell cytoskeletons to resist shear stress, promoting angiogenesis, and establishing pre-metastatic niches via extracellular vesicles and vascular barrier disruption."
          },
          {
            "conditions": "Immune modulation contexts",
            "finding": "Effects are bidirectional and context-dependent. Pro-tumor bacteria (e.g., Fn, P. gingivalis) often induce immunosuppression (MDSC recruitment, T-cell exhaustion, PD-L1 upregulation), while beneficial taxa (e.g., Bifidobacterium, Akkermansia) can enhance anti-tumor immunity and improve responses to immune checkpoint inhibitors (ICIs)."
          },
          {
            "conditions": "Clinical cohorts",
            "finding": "Specific microbial signatures correlate with patient prognosis and survival. Intratumoral bacteria also influence response to chemotherapy (resistance or sensitization), radiotherapy, and immunotherapy, suggesting potential as biomarkers and therapeutic targets."
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "To provide a systematic overview of the current understanding of intratumoral microbiota, addressing how these microbes originate, colonize, and functionally interact with tumor cells and the immune system to influence cancer progression and treatment outcomes, while highlighting methodological challenges and future translational directions.",
        "research_scope": "The review focuses on intratumoral bacteria (and to a lesser extent fungi and viruses) within solid tumors. It covers their origins, colonization mechanisms, diversity across cancer types, roles in tumor initiation/progression/metastasis, interactions with the immune microenvironment, diagnostic/prognostic value, and therapeutic implications including immunotherapy response.",
        "work_summary": "This is a comprehensive review synthesizing current knowledge on the role of intratumoral microbiota in cancer biology. It traces the historical evolution from early observations to modern multi-omics approaches, detailing methodological advances and challenges such as low biomass and contamination. The paper systematically categorizes the mechanisms by which intratumoral bacteria drive tumorigenesis (genomic instability, epigenetic changes, oncogenic signaling), promote metastasis (EMT, cytoskeletal remodeling, pre-metastatic niche formation), and modulate the immune landscape (suppression vs. activation). Furthermore, it evaluates the clinical utility of intratumoral bacteria as biomarkers for diagnosis and prognosis, and explores emerging therapeutic strategies targeting these microbes, including engineered bacteria, probiotics, antibiotics, and bacteriophages, particularly in the context of enhancing conventional therapies like chemotherapy, radiotherapy, and immunotherapy."
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "Important for evaluating the reliability of any microbiome-ICI association claims, emphasizing the need for robust experimental design in the user's review.",
            "material": "Discussion of low biomass, contamination risks, and the need for rigorous controls (negative controls, spatial validation) in microbiome research.",
            "purpose": "Contextual background on methodological challenges"
          },
          {
            "connection_to_review": "Provides insight into potential interventions to modulate the microbiome-ICI axis, complementing the mechanistic discussion.",
            "material": "Overview of engineered bacteria, probiotics, antibiotics, and bacteriophages as adjuvants to cancer therapy, including ICIs.",
            "purpose": "Therapeutic strategies targeting microbiota"
          },
          {
            "connection_to_review": "Highlights the complexity of the tumor microecology, suggesting that focusing solely on bacteria or gut may miss important synergistic effects.",
            "material": "Brief mention of fungal-viral-bacterial interactions in the TME.",
            "purpose": "Cross-kingdom interactions"
          }
        ],
        "facet_contributions": [
          {
            "boundaries": "Focuses primarily on *intratumoral* bacteria, whereas the user's query specifies *gut* microbiome. However, the review notes connections between gut/oral commensals and intratumoral colonization (e.g., hematogenous spread of Fn), providing a bridge. Clinical evidence cited is largely from preclinical models or small human cohorts; large-scale prospective data specifically isolating gut vs. intra-tumor effects on ICI response is limited in this text.",
            "contribution": "Summarizes clinical associations between intratumoral microbial composition and ICI response in solid tumors (e.g., melanoma, NSCLC, CRC). Identifies specific taxa associated with better or worse outcomes (e.g., Bifidobacterium linked to improved anti-PD-L1 efficacy; Fn linked to resistance in MSS-CRC). Discusses the concept of 'microbiome-guided precision oncology' and potential for microbiome interventions to sensitize tumors to ICIs.",
            "facet_id": "F1",
            "possible_uses": "Can be used to contextualize the broader impact of microbiota on ICI efficacy, highlighting that local tumor ecology plays a critical role alongside systemic gut flora. Provides examples of successful microbiome-ICI combinations in preclinical settings."
          },
          {
            "boundaries": "Mechanisms described are often derived from animal models or in vitro studies. The review acknowledges that many associations are correlative and causal validation in humans is ongoing. The distinction between direct bacterial effects and indirect effects mediated by other gut-derived factors is sometimes blurred in the synthesis.",
            "contribution": "Details specific molecular mechanisms by which intratumoral bacteria modulate ICI efficacy. Mechanisms include: 1) Direct immune checkpoint regulation (Fn upregulating PD-L1 via Dps protein); 2) Metabolic modulation (Fn-derived succinate suppressing cGAS-IFN-β pathway; L. reuteri-derived I3A activating AhR to boost CD8+ T cell IFN-γ production); 3) Immune cell recruitment/polarization (recruiting MDSCs or Tregs via chemokines like CXCL1/CXCL8); 4) STING pathway activation (Bifidobacterium activating STING to convert non-responders to responders). Also describes how engineered bacteria or probiotics can reverse resistance.",
            "facet_id": "F2",
            "possible_uses": "Provides detailed mechanistic pathways (metabolic, signaling, cellular) that can be compared with gut microbiome-mediated mechanisms. Helps identify common themes (e.g., metabolic cross-talk, STING activation) across different microbial compartments."
          }
        ],
        "planning_summary": "This review provides extensive material on how intratumoral bacteria (distinct from but related to gut microbiome) modulate the efficacy of immune checkpoint inhibitors (ICIs) in solid tumors. It details specific mechanisms of immune suppression (e.g., Fn-induced PD-L1, MDSC recruitment) and immune enhancement (e.g., Bifidobacterium-STING axis), offering mechanistic insights and clinical correlations relevant to Facet F2. It also discusses therapeutic strategies targeting these microbes to overcome ICI resistance, providing context for Facet F1.",
        "scope_interpretation_cautions": [
          "The review focuses on *intratumoral* bacteria, which may differ from the *gut* microbiome specified in the user's query. While there are links (e.g., translocation), they are distinct ecological niches. Use with caution when generalizing gut-specific mechanisms to intra-tumor effects.",
          "Many mechanistic claims are based on preclinical models (mice/cell lines). Human clinical evidence is often correlative or from small cohorts. Do not overstate causal certainty for human outcomes.",
          "The review emphasizes context-dependency; the same bacterium can have opposite effects in different cancer types or immune contexts. Avoid universal statements about specific taxa without specifying the tumor type and immune status."
        ],
        "topic_handles": [
          "intratumoral bacteria",
          "immune checkpoint inhibitors (ICIs)",
          "solid tumors",
          "Fusobacterium nucleatum (Fn)",
          "Bifidobacterium",
          "Akkermansia muciniphila",
          "PD-L1 expression",
          "CD8+ T cell exhaustion",
          "myeloid-derived suppressor cells (MDSCs)",
          "STING pathway",
          "metabolic modulation (succinate, I3A)",
          "extracellular vesicles (EVs)",
          "pre-metastatic niche"
        ]
      },
