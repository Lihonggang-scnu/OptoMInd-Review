    "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1": {
      "source_handle": "P0327",
      "title": "Biomarkers of Immunotherapy Response in Patients with Non-Small-Cell Lung Cancer: Microbiota Composition, Short-Chain Fatty Acids, and Intestinal Permeability",
      "year": "2024",
      "doi": "10.3390/cancers16061144",
      "paper_id": "8b3aa2316f5ec9089bf4d5f6cefbb1c1be74ad79",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用前瞻性观察性队列设计。纳入标准：III/IV期NSCLC候选ICI治疗者；排除标准：其他组织学类型、合并肿瘤、自身免疫病、ECOG评分≥2、既往免疫治疗史、高剂量皮质类固醇使用或已知免疫缺陷。样本采集：基线粪便和血液样本。分析方法：1. 微生物组：16S rDNA V3/V4区测序，ASV分类，Shannon指数计算Alpha多样性，LEfSe进行Beta多样性及差异物种分析。2. 代谢物：GC-MS定量粪便SCFAs（乙酸、丙酸、丁酸等）。3. 通透性：HPLC测血浆瓜氨酸，化学发光法测抗瓜氨酸抗体，ELISA测Zonulin，LAL法测内毒素。4. 临床关联：RECIST标准评估肿瘤反应，记录irAEs，Kaplan-Meier分析生存期，Pearson/Spearman相关性分析整合变量。",
        "contribution_and_limits": [
          {
            "contribution": "提供了NSCLC患者在接受ICI治疗前肠道微生物群、SCFA谱和肠道通透性基线特征的详细数据，证实了该人群肠道菌群的丰富性和屏障功能的完整性。首次报告了根据ICI反应和irAE状态分组的NSCLC患者循环内毒素水平。",
            "limits": "未能确立任何预测性生物标志物。存在方法学局限性：缺乏肠道通透性测量的标准化程序和断点值；SCFA正常值尚未建立，阻碍跨研究比较；样本量有限（N=55）；患者接受的ICI药物种类多样（Durvalumab, Pembrolizumab等），可能引入异质性；未区分不同ICI药物对结果的影响。"
          }
        ],
        "key_findings": [
          {
            "conditions": "N=55 NSCLC患者，基线样本，多中心/单中心（Aragón）",
            "finding": "未检测到肠道微生物组成、SCFA丰度或肠道通透性指标与ICI治疗反应（响应者vs非响应者）或irAE发生之间的统计学显著相关性。"
          },
          {
            "conditions": "LEfSe差异分析",
            "finding": "响应者在Bacillota门（包括Clostridia和Monoglobus）中丰度较高，Hungatella在非响应者中较高；发生irAEs的患者Betaproteobacteria和Enterococcus丰度较高。但整体Alpha/Beta多样性无组间差异，且这些差异未转化为预测能力。"
          },
          {
            "conditions": "SCFA分析",
            "finding": "粪便中主要SCFA为乙酸(56%)、丙酸(19%)和丁酸(11%)，各组间分布无显著差异，且SCFA水平与细菌丰度或临床结局无关联。"
          },
          {
            "conditions": "肠道通透性指标",
            "finding": "瓜氨酸分散度高，抗瓜氨酸抗体在90%样本中不可检测，Zonulin和内毒素水平离散度低。所有通透性指标均未显示出预测价值。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "目前NSCLC患者对ICI治疗的总体响应率较低（15-20%），且缺乏可靠的预测生物标志物，同时部分患者会出现严重的免疫相关不良事件（irAEs）。既往研究提示肠道微生物可能影响ICI疗效，但具体机制和标志物尚不明确，且肠道通透性这一宿主因素常被忽视。本研究试图确定肠道微生物群、其代谢产物（SCFAs）以及肠道屏障完整性是否可作为预测ICI疗效和毒性的有效生物标志物。",
        "research_scope": "针对接受免疫检查点抑制剂（ICI）治疗的非小细胞肺癌（NSCLC）患者，研究肠道微生物群组成、短链脂肪酸（SCFAs）丰度及肠道膜通透性作为治疗反应和免疫相关不良事件（irAEs）预测生物标志物的可能性。",
        "work_summary": "本研究旨在识别NSCLC患者中预测ICI疗效和毒性的生物标志物，重点考察肠道微环境。研究招募了55名接受不同ICI方案（如Durvalumab, Pembrolizumab等）的III期或IV期NSCLC患者，在基线时收集粪便和血液样本。通过16S rDNA扩增测序分析肠道菌群组成，利用GC-MS测定粪便中的短链脂肪酸含量，并通过血浆检测瓜氨酸、抗瓜氨酸抗体、Zonulin和内毒素水平来评估肠道屏障通透性。统计分析包括描述性统计、生存分析（Kaplan-Meier）、相关性分析及LEfSe差异分析。结果显示，尽管患者肠道菌群丰富多样且功能均一，但未能发现任何肠道微生物组成、代谢产物或通透性指标与ICI治疗反应或irAE发生之间的显著相关性。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了一项针对NSCLC患者的阴性研究结果，表明在基线状态下，肠道微生物组成、短链脂肪酸和肠道通透性并不能直接预测ICI的治疗反应或毒性。这对于综述中关于“肠道微生物作为通用预测因子”的讨论具有反面证据价值，提示需考虑疾病特异性、治疗药物特异性或时间动态变化等因素。",
        "facet_contributions": [
          {
            "boundaries": "仅适用于NSCLC患者；基线静态测量；多种ICI药物混合分析；未解决因果机制。",
            "contribution": "提供了NSCLC特定亚群中肠道微生物与ICI疗效关系的实证数据：未发现显著关联。具体显示响应者中Clostridia/Monoglobus较多，非响应者中Hungatella较多，但整体预测效能缺失。",
            "facet_id": "F1",
            "possible_uses": "用于反驳或限定“肠道微生物普遍预测ICI疗效”的观点，强调在NSCLC中可能需要更复杂的模型或不同的微生物特征。"
          },
          {
            "boundaries": "仅基于基线血浆/粪便样本；未涉及干预后的动态变化；内毒素检测为首次在该人群中尝试，但结果不具预测性。",
            "contribution": "探讨了肠道屏障通透性（瓜氨酸、Zonulin、内毒素）与ICI反应的关系，结果为阴性。指出目前缺乏标准化的通透性测量方法和参考值。",
            "facet_id": "F2",
            "possible_uses": "用于综述中讨论宿主-微生物互作机制时，说明肠道屏障完整性作为单一维度的局限性，以及当前生物标志物开发的标准化困境。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "在综述的方法学部分或讨论部分，引用此例来说明当前领域在生物标志物标准化方面的不足，解释为何现有文献存在异质性。",
            "material": "论文指出SCFA正常值未建立，肠道通透性测量缺乏标准化程序，这解释了为何不同研究间结果难以比较。",
            "purpose": "背景信息与方法学局限示例"
          },
          {
