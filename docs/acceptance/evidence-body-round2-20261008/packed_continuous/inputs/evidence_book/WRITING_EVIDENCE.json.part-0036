    "record::88fdcddfb109d931e6ee0b880948bae013cc3db37a7e2c96c02e45370f5c38db": {
      "source_handle": "P0073",
      "title": "A gut-on-a-chip incorporating human faecal samples and peristalsis predicts responses to immune checkpoint inhibitors for melanoma",
      "year": "2025",
      "doi": "10.1038/s41551-024-01318-z",
      "paper_id": "1a747439d702aff9bb8fb4513e8de0c1063c237a",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "1. **模型构建**：使用软光刻技术制备PDMS微流控芯片，包含上皮通道和内皮通道，中间由胶原基质隔开。上皮侧接种Caco-2/HT-29 MTX共培养物或hiPSC来源肠类器官，内皮侧接种HMEC-1细胞。通过气动装置施加周期性变形（0.2 Hz, 10-15%应变）以模拟蠕动。2. **样本处理**：收集黑色素瘤ICI响应者（R）和非响应者（NR）的新鲜冷冻粪便，制备全粪便悬液及离心后的上清液（含可溶性因子），分别作用于成熟芯片。3. **多组学与表型分析**：进行RNA测序以鉴定差异表达基因（DEGs）和通路富集；使用免疫荧光显微镜量化紧密连接蛋白（ZO-1, E-cadherin）、增殖标记（Ki67）及凋亡标记（Caspase-3）；通过葡聚糖渗透实验评估屏障通透性；使用多重ELISA检测分泌的炎症因子（IL-6, CXCL8等）。4. **机制验证**：使用大肠杆菌LPS和沙门氏菌鞭毛蛋白进行对照实验，验证特定微生物成分的作用；比较芯片数据与公开的小鼠无菌/常规饲养模型转录组数据以验证生理相关性。",
        "contribution_and_limits": [
          {
            "contribution": "提供了一个具有蠕动功能的人源化肠-on-a-chip模型，能够区分黑色素瘤患者ICI治疗响应与非响应的微生物功能特征，并揭示了LPS和鞭毛蛋白在其中的关键作用。",
            "limits": "所给摘要未交代长期厌氧培养的稳定性数据；模型尚未整合免疫系统细胞（仅用内皮细胞代表血管界面）；样本量较小（NR n=6, R n=4等），结果需在更大队列中验证；未能完全复现体内复杂的全身免疫调节网络。"
          }
        ],
        "key_findings": [
          {
            "conditions": "芯片暴露于非响应者（NR）粪便全样或上清",
            "finding": "上皮细胞紧密连接蛋白ZO-1和β-catenin显著下调，屏障通透性增加；内皮细胞ICAM-1上调，T细胞粘附增加；转录组显示应激缓冲能力下降、细胞周期抑制及促炎通路（TNF, IL-6, NF-κB）激活。"
          },
          {
            "conditions": "芯片暴露于响应者（R）粪便全样或上清",
            "finding": "未引起显著的屏障破坏；转录组显示TLR-5信号通路激活，伴随IL-1β和IL-10水平升高；metagenomic分析显示鞭毛蛋白相关基因富集。"
          },
          {
            "conditions": "芯片暴露于大肠杆菌LPS",
            "finding": "重现了NR粪便引起的屏障破坏和炎症反应；不同来源LPS表现出结构依赖性效应。"
          },
          {
            "conditions": "联合治疗：NR粪便/LPS + R粪便上清或纯化鞭毛蛋白",
            "finding": "R粪便上清或鞭毛蛋白能显著恢复被NR粪便或LPS破坏的屏障完整性（ZO-1/E-cadherin回升），并降低炎症因子水平。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "现有小鼠模型在解剖、功能和微生物组成上与人类存在巨大差异，且传统2D/3D培养无法提供受控的机械刺激和实时多组学检测，导致难以准确解析肠道微生物群如何具体影响人类对免疫检查点抑制剂（ICI）的治疗响应。本研究旨在解决这一转化医学瓶颈，建立一个能模拟人类肠道生理环境并预测个体治疗响应的体外平台。",
        "research_scope": "人类黑色素瘤患者肠道微生物群与宿主上皮/内皮细胞的相互作用；免疫检查点抑制剂（ICI）治疗响应与非响应的预测机制。",
        "work_summary": "本研究开发了一种集成人体微血管内皮细胞和诱导多能干细胞（hiPSC）来源肠类器官的微流控“肠-on-a-chip”模型，该模型通过胶原基质分隔两个通道，并具备模拟蠕动样机械运动的能力。研究利用该模型处理来自黑色素瘤ICI响应者和非响应者的粪便样本，结合转录组学、代谢组学和显微成像分析，发现非响应者粪便中的微生物群会导致肠道上皮屏障完整性显著受损（ZO-1和β-catenin下调），并引发强烈的促炎反应（如IL-6、TNF信号激活）。相比之下，响应者粪便中的可溶性因子（富含鞭毛蛋白相关基因）能激活TLR-5信号并促进IL-1β释放，有助于维持屏障稳态。此外，研究证实非响应者粪便中脂多糖（LPS）合成基因富集，其效应可通过外源LPS处理重现，而响应者粪便提取物或纯化的鞭毛蛋白可部分逆转这种损伤。该模型成功复现了体内观察到的微生物-宿主互作特征，并能区分不同临床结局患者的微生物功能差异。"
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "方法学参考与模型局限性讨论",
            "material": "开发了集成蠕动功能的hiPSC/Caco-2肠-on-a-chip模型，并与小鼠模型转录组数据进行比对验证。",
            "purpose": "在综述的方法学部分，可作为先进体外模型替代动物实验的案例；同时指出当前模型在整合免疫系统方面的局限，引导读者关注未来需要整合免疫细胞的研究方向。"
          },
          {
            "connection_to_review": "生物标志物开发的潜力",
            "material": "识别出与临床响应相关的上皮特异性生物标志物（如ZO-1, β-catenin表达变化）和微生物因子（LPS合成基因, 鞭毛蛋白基因）。",
            "purpose": "为综述中关于“预测ICI疗效的生物标志物”部分提供具体候选分子，说明从微生物组到宿主表型的转化可能性。"
          }
        ],
        "facet_contributions": [
          {
            "boundaries": "基于黑色素瘤单病种；体外模型结果不能直接等同于体内全身疗效，但提供了机制层面的关联证据。",
            "contribution": "提供了肠道微生物群影响ICI疗效的功能性证据：非响应者微生物群导致肠道屏障破坏和促炎状态，而响应者微生物群维持屏障稳态并诱导抗炎/修复信号。",
            "facet_id": "F1",
            "possible_uses": "用于支持综述中关于微生物群组成/功能决定ICI疗效的论点；作为区分响应者与不响应者微生物特征的案例。"
          },
          {
            "boundaries": "机制主要在肠道局部上皮/内皮层面观察到；未涉及系统性免疫细胞（如T细胞）的具体调控细节，仅通过T细胞粘附实验间接提示内皮活化。",
            "contribution": "阐明了介导效应的具体分子机制：非响应者粪便中高丰度的LPS合成基因及其引发的TLR/NF-κB炎症通路和屏障损伤；响应者粪便中鞭毛蛋白相关基因激活TLR-5及IL-1β/IL-10通路，有助于缓解炎症。",
            "facet_id": "F2",
            "possible_uses": "用于详细阐述微生物-宿主互作的分子路径；解释LPS作为负面调节因子和鞭毛蛋白作为潜在正面调节因子的双重角色；为开发基于微生物成分的辅助疗法（如补充鞭毛蛋白或清除LPS）提供理论依据。"
          }
        ],
        "planning_summary": "该论文为综述提供了关于肠道微生物群如何通过物理屏障完整性和特定分子信号（LPS vs 鞭毛蛋白）调节宿主对免疫检查点抑制剂（ICI）响应的直接体外证据。它特别适用于解释“非响应者”中观察到的肠道炎症和屏障功能障碍机制，以及“响应者”中潜在的抗炎/修复机制。",
        "scope_interpretation_cautions": [
          "该研究使用的是黑色素瘤患者队列，结论外推至其他实体瘤需谨慎，尽管机制可能具有普遍性。",
          "作者声称模型“预测”响应，但这主要基于体外表型与临床状态的关联，而非前瞻性临床试验验证。",
          "LPS和鞭毛蛋白的作用是在特定浓度下验证的，体内实际浓度和时空分布可能更为复杂。",
          "响应者粪便中IL-1β升高通常与炎症相关，但此处与屏障保护相关联，提示其在特定语境下的双重作用，解读时需结合TLR-5背景。"
        ],
        "topic_handles": [
          "gut microbiome",
          "immune checkpoint inhibitors",
          "solid tumours",
          "melanoma",
          "gut barrier integrity",
          "lipopolysaccharides (LPS)",
          "flagellin",
          "TLR signaling",
          "organ-on-a-chip",
          "microbiome-host interaction"
        ]
      },
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\on_demand_promotion_local_20261007_10cny\\formal_complete_plan\\revisions\\03912c907286ec6fbd55\\writer_packets\\Ch2.json",
        "source_handle": "P0073",
