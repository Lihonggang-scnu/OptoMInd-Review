    "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338": {
      "source_handle": "P0026",
      "title": "Clinical potential of the gut microbiome in oncology: a scoping review of treatment response, toxicity and biomarker development",
      "year": "2026",
      "doi": "10.1007/s00520-026-10918-1",
      "paper_id": "0cf91befe63ec25329391e50e90d14093d3c74d7",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用范围综述方法论。使用PICO框架构建指导问题，在PubMed/MEDLINE, Web of Science, Scopus, SciELO, LILACS五个数据库进行结构化搜索。纳入标准为涉及成年癌症患者、接受系统性肿瘤治疗、进行肠道微生物组分析并明确链接到治疗反应/毒性/预后的研究。排除儿科、仅放疗/手术、纯体外实验及2015年前文献。数据提取通过标准化表格进行，涵盖研究设计、人群特征、微生物分析方法、预测模型性能及主要结果。最终通过叙事综合法（narrative synthesis）对数据进行定性汇总，按癌症类型和治疗模式分类，重点区分“定量预测模型”与“微生物特征描述”，并识别知识空白和方法学局限。",
        "contribution_and_limits": [
          {
            "contribution": "提供了2015-2025年间肠道微生物组在肿瘤治疗反应中应用的全面地图，区分了预测模型开发与微生物特征描述两类证据。",
            "limits": "作为范围综述，不进行质量评估或因果推断；未提供定量荟萃分析结果；所引用的原始研究多为小样本或回顾性，存在选择偏倚和混杂因素控制不足的风险。"
          },
          {
            "contribution": "明确了微生物组预测模型在特定情境下（如尿路上皮癌、直肠癌）超越传统临床标记物的潜力，强调了菌株水平分辨率的重要性。",
            "limits": "不同研究的测序技术、生信流程和统计方法高度异质，导致直接比较困难；多数证据仍为关联性而非因果性。"
          },
          {
            "contribution": "指出了临床转化的主要障碍：方法学标准化缺失、外部验证不足、机制不明及监管挑战。",
            "limits": "未能提供具体的标准化协议建议或成本效益分析的详细数据；对真菌、病毒等非细菌微生物的作用探讨有限。"
          }
        ],
        "key_findings": [
          {
            "conditions": "免疫检查点抑制剂（ICI）治疗，多中心队列及荟萃分析",
            "finding": "菌株水平的微生物特征比临床因素更具预测力。Gunjur等(2024)发现针对联合ICI反应的菌株特征AUC为0.73，优于临床因素的0.56；但泛癌种通用特征在不同ICI方案间外推性较差（一致方案AUC 0.65 vs 不一致方案0.51）。"
          },
          {
            "conditions": "新辅助化疗，尿路上皮癌",
            "finding": "微生物组预测模型表现优于临床变量。Bukavina等(2024)开发的随机森林模型预测完全缓解（CR）的AUC为0.88，而临床因素仅为0.50；高拟杆菌属丰度与较差反应相关。"
          },
          {
            "conditions": "同步放化疗，鼻咽癌",
            "finding": "益生菌干预可降低毒性。Xia等(2021)的II期试验显示，益生菌鸡尾酒将3-4级口腔粘膜炎发生率从47.1%降至25%，并通过调节肠道菌群失调和增强免疫反应发挥作用。"
          },
          {
            "conditions": "新辅助免疫放化疗，局部晚期直肠癌",
            "finding": "物种水平模型具有高预测准确性。Yang等(2024)开发的SPEED模型在训练集AUC为98.8%，验证集为77.8%，用于预测病理完全缓解（pCR）。"
          },
          {
            "conditions": "多种实体瘤，综述综合",
            "finding": "特定菌属与疗效/毒性关联。双歧杆菌、阿克曼氏菌、粪杆菌等通常与ICI良好反应相关；梭杆菌、拟杆菌等在部分研究中与化疗耐药或毒性增加相关。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "解决的核心问题是：肠道微生物组衍生的生物标志物和预测模型在肿瘤治疗反应实践中具有何种临床潜力？具体动机在于应对癌症治疗的异质性响应、固有毒性及耐药性挑战，寻找能实现更精准患者选择和疗法优化的新型生物标志物。",
        "research_scope": "成人癌症患者（涵盖结直肠癌、黑色素瘤、非小细胞肺癌、食管癌、尿路上皮癌等实体瘤），接受全身性肿瘤治疗（化疗、免疫检查点抑制剂ICIs、靶向治疗及联合方案）。研究范围聚焦于肠道微生物组作为生物标志物在预测治疗反应、毒性及疾病进程中的临床潜力，包括微生物特征识别和预测模型的开发/验证。",
        "work_summary": "这是一篇遵循JBI指南和PRISMA-ScR报告的范围综述（scoping review），旨在系统映射并批判性地描述当前关于肠道微生物组在肿瘤学中作为生物标志物的证据。作者检索了2015年至2025年间发表的20项相关研究，涵盖了观察性队列、临床试验和机制研究。综述重点分析了特定微生物类群如何影响免疫治疗和化疗的疗效，以及它们对治疗相关毒性的调节作用。研究发现，基于微生物组的预测模型在某些情况下优于传统临床标记物（如尿路上皮癌中AUC达0.88 vs 0.50），且特定干预（如益生菌）可减轻毒性。然而，综述也指出，由于方法学异质性、缺乏外部验证和机制理解不完整，这些模型的临床转化仍面临挑战。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为回答“肠道微生物组如何调节实体瘤ICIs疗效及其机制”提供了关键的背景框架和具体证据线索。它汇总了支持微生物组影响ICI疗效的主要菌属（如双歧杆菌、阿克曼氏菌）、展示了微生物预测模型在ICI反应预测中的性能数据（特别是菌株水平特征的优势），并讨论了FMT克服ICI耐药的临床尝试。同时，它指出了当前证据的方法学局限（异质性、缺乏外部验证），有助于在综述中平衡地呈现微生物组 biomarker 的现状与挑战。",
        "facet_contributions": [
          {
            "boundaries": "预测模型的性能数据来自特定队列，外推性受限；FMT试验样本量小（n=15）；大多数关联证据来自观察性研究，不能直接证明因果关系。",
            "contribution": "提供了肠道微生物组影响ICI疗效的具体微生物特征和预测模型性能数据。包括：1) Gunjur等(2024)的多中心研究显示菌株水平特征对联合ICI反应的预测能力（AUC 0.73）优于临床因素；2) Gazzaniga & Kasper (2025)和Gopalakrishnan等(2018)综述指出的与良好ICI反应相关的菌属（双歧杆菌、阿克曼氏菌、粪杆菌等）；3) Davar等(2021)的临床试验显示FMT可使PD-1难治性黑色素瘤患者获得客观缓解（20%）。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物组如何调节ICI疗效”中的“效应方向”和“预测价值”部分。可作为微生物组作为ICI疗效生物标志物的实证支持，展示其在不同癌症类型和ICI方案中的表现差异。"
          },
          {
            "boundaries": "该综述主要归纳其他研究的机制发现，本身未提供新的机制实验数据；许多机制仍处于假说阶段，需结合原文献进一步验证；未详细阐述所有可能的代谢途径。",
            "contribution": "提供了微生物组调节ICI疗效的可能机制线索和间接证据。包括：1) Gazzaniga & Kasper (2025)和Chrysostomou等(2023)综述提到的免疫调节机制（如激活T细胞、NK细胞、I型干扰素通路）；2) McCulloch等(2022)观察到不利微生物特征与全身炎症（NLR升高）相关；3) Davar等(2021)发现FMT诱导CD8+ T细胞活化；4) 综述指出抗生素使用可能削弱ICI疗效，暗示生态依赖性。",
            "facet_id": "F2",
            "possible_uses": "用于回答“介导效应的机制”部分。虽然该综述未深入分子细节，但它汇总了现有的免疫学和代谢学机制假设，并为后续深入探讨具体通路（如SCFA、色氨酸代谢）提供了上下文。"
          }
        ],
        "broader_review_uses": [
