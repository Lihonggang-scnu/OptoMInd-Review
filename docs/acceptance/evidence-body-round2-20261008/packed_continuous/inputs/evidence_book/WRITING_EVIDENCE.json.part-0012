      {
        "source_handle": "P0270",
        "title": "Composition of gastrointestinal microbiota in association with treatment response in individuals with metastatic castrate resistant prostate cancer progressing on enzalutamide and initiating treatment with anti-PD-1 (pembrolizumab)",
        "year": "2022",
        "doi": "10.1016/j.neo.2022.100822",
        "paper_id": "74786f8df0c7648840756833a4b4bc49ace34be6",
        "material_depth": "fulltext",
        "material_status": "resolved",
        "aliases": [],
        "study_summary_A": {
          "approach": "采用前瞻性观察性队列设计。收集23名mCRPC患者在基线及治疗期间的直肠拭子（粪便）和口腔漱口水样本。使用Ion Torrent平台进行16S rRNA基因多重高变区测序，结合DADA2去噪和QIIME2分析流程进行物种分类。使用GLM整合多区域数据以评估差异丰度。通过qPCR独立验证关键菌种（S. salivarius, A. muciniphila）。纵向分析了9名患者的全程治疗样本以评估时间效应。将结果与既往文献及Shaikh等人的“综合指数”进行比较。",
          "contribution_and_limits": [
            {
              "contribution": "提供了首个针对mCRPC患者在接受ICI治疗前/初期微生物组特征的系统描述，揭示了该人群中特有的微生物-反应关联模式（如S. salivarius的正向关联和A. muciniphila的负向关联）。",
              "limits": "样本量较小（n=23），统计效力有限；仅使用16S rRNA测序而非宏基因组，分辨率受限；未深入探讨具体的代谢机制或因果路径；结果可能受既往恩杂鲁胺治疗、饮食、地理因素等混杂因素影响；作者承认部分分类学鉴定存在不确定性（如Roseburia属）。"
            }
          ],
          "key_findings": [
            {
              "conditions": "First Timepoint cohort (n=23), 16S sequencing & qPCR",
              "finding": "整体α和β多样性在反应者与非反应者间无显著差异；个体间变异占主导（~50%）。"
            },
            {
              "conditions": "First Timepoint cohort, GLM analysis of multiple hypervariable regions",
              "finding": "Streptococcus salivarius在反应者粪便中显著富集（p=0.004），且qPCR证实该趋势；但该菌在口腔漱口水中的水平与反应无关，且口腔与粪便水平不相关。"
            },
            {
              "conditions": "First Timepoint cohort, 16S sequencing (V6-7 region) & qPCR",
              "finding": "Akkermansia muciniphila在反应者中显著降低（与黑色素瘤等其他癌症报道相反），qPCR确认了这一减少趋势。"
            },
            {
              "conditions": "Longitudinal analysis (n=9 patients across treatment cycles)",
              "finding": "帕博利珠单抗治疗未引起全局微生物组成的显著变化；个体内样本聚类紧密，时间点对变异贡献极小（<3%）。"
            },
            {
              "conditions": "Application of Shaikh et al. integrated index",
              "finding": "该综合指数未能区分本队列中的反应者与非反应者，表明不同癌症类型或治疗史可能导致微生物信号的特异性。"
            }
          ],
          "paper_kind": "empirical",
          "problem_or_question": "既往研究表明肠道微生物影响ICI疗效，但在mCRPC背景下，特别是经过雄激素受体抑制剂（如恩杂鲁胺）预处理后的患者中，微生物组特征如何预测帕博利珠单抗的治疗反应？是否存在不同于其他实体瘤（如黑色素瘤）的微生物标志物？",
          "research_scope": "转移性去势抵抗性前列腺癌（mCRPC）患者，在恩杂鲁胺治疗进展后接受抗PD-1免疫检查点抑制剂（帕博利珠单抗）治疗。样本为粪便和口腔漱口水DNA。",
          "work_summary": "本研究旨在探究肠道微生物组组成与mCRPC患者对免疫检查点抑制剂（ICI）治疗反应的关联。研究纳入了23名在恩杂鲁胺治疗下疾病进展并即将开始帕博利珠单抗治疗的mCRPC患者。通过16S rRNA基因测序（覆盖多个高变区）和定量PCR（qPCR），比较了治疗反应者（PSA下降>50%或影像学缓解）与非反应者的微生物特征。研究发现，尽管整体α和β多样性在主要队列中无显著差异，但特定菌属存在差异：反应者中粪肠球菌、拟杆菌等富集，而此前在其他癌症中被认为促进ICI疗效的黏蛋白降解菌Akkermansia muciniphila在反应者中反而减少。此外，发现口腔共生菌Streptococcus salivarius在粪便中的丰度与反应正相关，但在口腔样本中无此关联，提示其作用具有部位特异性。研究还验证了一个综合微生物指数在本队列中无效，并观察到治疗期间微生物组总体稳定。"
        },
        "review_planning_B": {
          "broader_review_uses": [
            {
              "connection_to_review": "背景与概念：既往雄激素剥夺疗法（ADT）对肠道微生物组的影响。",
              "material": "文中提到既往研究显示恩杂鲁胺等雄激素受体轴靶向治疗会增加A. muciniphila水平，这可能构成了本研究中患者基线微生物组的背景状态。",
              "purpose": "帮助解释为何本研究中A. muciniphila的表现与其他ICI研究不同，提示既往内分泌治疗可能是塑造微生物组-ICI反应关系的关键情境变量。"
            },
            {
              "connection_to_review": "实例：口腔与肠道微生物组的解耦。",
              "material": "S. salivarius在粪便中与疗效相关，但在口腔样本中无关联，且两者水平不相关。",
              "purpose": "作为实例说明非侵入性口腔采样可能无法准确代表肠道微生物状态，特别是在涉及特定口腔来源但定植于肠道的细菌时，强调采样部位选择的重要性。"
            },
            {
              "connection_to_review": "反例：通用预测模型的失效。",
              "material": "Shaikh等人的综合指数在本队列中无预测价值。",
              "purpose": "作为反例，证明并非所有癌症都对相同的微生物组合产生反应，反对过度泛化的微生物生物标志物主张。"
            }
          ],
          "facet_contributions": [
            {
              "boundaries": "仅限mCRPC人群，且处于恩杂鲁胺治疗失败后阶段；不能直接外推至初治前列腺癌或其他早期癌症。",
              "contribution": "提供了mCRPC背景下特定的微生物标志物列表：S. salivarius（正向关联）、Bacteroides thetaiotaomicron（正向关联）、Enterococcaceae（正向关联）以及Akkermansia muciniphila（负向关联）。",
              "facet_id": "F1",
              "possible_uses": "用于回答“哪些细菌与ICI疗效相关”，特别是用于对比不同实体瘤（如黑色素瘤、肺癌）中的通用标志物，论证标志物的异质性。"
