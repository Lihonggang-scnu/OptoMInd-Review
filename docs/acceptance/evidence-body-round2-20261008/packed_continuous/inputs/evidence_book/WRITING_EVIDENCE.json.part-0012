      {
        "source_handle": "P0580",
        "title": "Targeting ribosomes reprograms the tumour microenvironment and augments cancer immunotherapy",
        "year": "2025",
        "doi": "10.1038/s41416-025-03109-y",
        "paper_id": "c5e74d5eebf19335caebc97bdb8300261fcb0ee5",
        "material_depth": "",
        "material_status": "resolved",
        "aliases": [],
        "locator": {
          "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch3.json",
          "source_handle": "P0580",
          "card_path": "F:\\OptoMind-Review-2\\outputs\\progressive_review_plan\\20260924_microbiome\\run01\\level1\\supplements\\specific_metabolite_quantification\\source_units\\SU02_search_candidate_16ed5874ed\\card\\PAPER_READING_CARD.json"
        },
        "study_summary_A": {
          "approach": "1. 动物实验：在C57BL/6和BALB/c小鼠中建立MC38和CT26同系移植瘤模型，给予CX-5461灌胃治疗，设置联合抗LAG3抗体治疗组。2. 单细胞测序与分析：对治疗后的小鼠肿瘤组织进行scRNA-seq，使用NMF算法构建“核糖体状态”签名以量化单个细胞的核糖体生物合成水平，识别对核糖体抑制敏感的免疫亚群。3. 公共数据挖掘：整合多个癌症类型的scRNA-seq数据集和ICB治疗队列数据，分析核糖体状态与免疫细胞分化、预后及治疗反应的关系。4. 临床验证：利用多重免疫荧光染色和空间转录组技术，在人类结直肠癌、肝细胞癌等临床样本中验证关键细胞亚群的核糖体活性及其空间分布。5. 体外验证：通过多聚核糖体分级、蛋白质折叠检测及流式细胞术确认分子机制。",
          "contribution_and_limits": [
            {
              "contribution": "首次提供了核糖体靶向治疗重塑TME的单细胞图谱，揭示了非癌细胞（特别是特定T细胞和巨噬细胞亚群）的核糖体生物合成活性在维持免疫抑制微环境中的作用。",
              "limits": "主要基于小鼠同系移植瘤模型，尚未在更多类型的实体瘤或非上皮来源肿瘤中进行广泛验证；机制上主要依赖转录组关联，部分因果链条（如HSP70如何具体调控核糖体进而影响细胞命运）仍需更深入的功能实验确证。"
            }
          ],
          "key_findings": [
            {
              "conditions": "CX-5461处理的小鼠MC38/CT26肿瘤模型",
              "finding": "CX-5461直接激活T细胞和NK细胞，增加穿孔素和细胞因子分泌；诱导巨噬细胞从免疫抑制性（LA/Reg-TAMs）向促炎性（IFN/Inflam-TAMs）表型转变。"
            },
            {
              "conditions": "基于scRNA-seq数据的核糖体状态分析",
              "finding": "构建了包含73个元基因的核糖体状态签名，证实高核糖体活性与不良预后相关；鉴定出HSP70+ CD8+ T细胞（T_str）和MRC1+ TAMs具有极高的核糖体生物合成活性，且对CX-5461敏感。"
            },
            {
              "conditions": "ICB治疗响应患者队列",
              "finding": "在响应ICB治疗的患者中，高核糖体活性的免疫抑制性T细胞亚群（如HSP70+ CD8+ T细胞和Tregs）在治疗后显著减少，表明这些细胞是维持免疫耐受的关键。"
            },
            {
              "conditions": "CT26模型中CX-5461与抗LAG3联合治疗",
              "finding": "CX-5461诱导LAG3表达，显著增敏CT26肿瘤对抗LAG3治疗的反应，导致肿瘤显著消退和更深层的抗肿瘤免疫反应，且未引起明显的体重下降或DNA损伤副作用。"
            }
          ],
          "paper_kind": "empirical",
          "problem_or_question": "既往研究多集中于癌细胞自身的核糖体异常，而忽视了核糖体生物合成在非癌细胞（特别是免疫细胞）中的作用。目前尚不清楚阻断细胞核糖体生物合成如何影响TME中的免疫调节，以及这种干预是否能重塑免疫抑制性微环境并增强现有免疫疗法的疗效。",
          "research_scope": "免疫健全小鼠体内的结直肠癌（MC38, CT26）同系移植瘤模型；人类多种实体瘤的单细胞转录组数据（scRNA-seq）及空间转录组数据；体内临床样本。研究对象聚焦于肿瘤微环境（TME）中的非癌细胞亚群及其核糖体生物合成活性。",
          "work_summary": "本研究旨在探讨靶向核糖体生物合成的抑制剂CX-5461对肿瘤微环境（TME）的重编程作用及其增强免疫检查点阻断（ICB）疗效的机制。研究利用免疫健全小鼠模型进行CX-5461治疗，并结合单细胞RNA测序（scRNA-seq）、空间转录组学及临床样本验证，系统分析了TME中不同细胞类型的核糖体状态变化。研究发现，CX-5461不仅抑制癌细胞核糖体生成，还特异性地调节了TME中的免疫细胞：它促进T细胞和NK细胞的细胞毒性颗粒分泌，诱导巨噬细胞向促炎表型重编程，并显著减少具有高核糖体活性的HSP70+ CD8+ T细胞（应激反应T细胞）和调节性T细胞（Tregs）。此外，该药物诱导了LAG3等免疫检查点的表达，使原本对ICB不敏感的CT26肿瘤模型对抗LAG3疗法高度敏感，实现了显著的肿瘤消退。"
        },
        "review_planning_B": {
          "broader_review_uses": [
            {
              "connection_to_review": "提供宿主细胞内在代谢/翻译状态影响免疫治疗的新视角，补充微生物组之外的调节机制。",
              "material": "CX-5461诱导错折叠蛋白积累形成新抗原，增加肿瘤免疫原性；核糖体状态签名与患者生存期的负相关。",
              "purpose": "作为背景材料，说明肿瘤微环境的复杂性不仅限于微生物互作，还包括宿主细胞自身的翻译重编程和应激反应，这些因素共同决定了ICB的疗效。"
            },
            {
              "connection_to_review": "提供关于LAG3在核糖体抑制背景下被诱导表达的实例。",
              "material": "CX-5461处理后LAG3在CD8+ T细胞中高表达，且联合抗LAG3治疗显著增强疗效。",
              "purpose": "举例说明免疫检查点的动态变化及其作为联合治疗靶点的潜力，特别是在那些对常规PD-1/PD-L1抑制剂反应不佳的“冷”肿瘤中。"
            }
          ],
          "facet_contributions": [
            {
              "boundaries": "该研究未涉及肠道微生物组本身，因此不能直接回答微生物组如何调制ICB疗效的问题，仅能提供宿主细胞层面的平行机制或潜在交互作用的假设基础。",
              "contribution": "提供了核糖体生物合成活性在TME非癌细胞中异质性分布的证据，特别是高活性与免疫抑制性表型（如Tregs, MRC1+ TAMs）的正相关性。",
              "facet_id": "F1",
              "possible_uses": "可用于解释肠道微生物组或其他代谢因素如何通过影响宿主免疫细胞的翻译能力来间接调节ICB疗效的背景讨论；或作为对比案例，说明除了微生物代谢产物外，宿主细胞内在的翻译机器状态也是重要调节维度。"
            },
            {
              "boundaries": "该机制针对的是LAG3而非PD-1/PD-L1，且依赖于特定的核糖体抑制剂。需明确区分这是宿主细胞内在机制，而非微生物介导的直接效应。",
              "contribution": "阐明了靶向核糖体生物合成（CX-5461）通过清除高核糖体活性的抑制性T细胞（HSP70+ CD8+ T）和Tregs，并诱导LAG3表达，从而增敏LAG3阻断疗法的机制。",
              "facet_id": "F2",
              "possible_uses": "直接用于回答“哪些机制介导了这种效应”中的非微生物机制部分。展示了通过调节细胞内在翻译状态来改变免疫检查点表达和消除抑制性细胞的具体路径。"
            }
          ],
          "planning_summary": "该论文为综述提供了关于“非癌细胞核糖体功能在肿瘤免疫逃逸中的作用”及“代谢/翻译机器作为免疫治疗增敏靶点”的重要实证素材。其核心价值在于打破了仅关注癌细胞核糖体的局限，指出了TME中特定免疫亚群（HSP70+ CD8+ T, MRC1+ TAMs）的高核糖体活性是免疫抑制的关键特征，并证明了通过CX-5461靶向这一过程可逆转免疫抑制并增敏LAG3阻断疗法。这为解释ICB耐药机制及开发联合策略提供了新的视角。",
          "scope_interpretation_cautions": [
            "该研究主要关注核糖体生物合成抑制剂CX-5461，其机制可能与其他核糖体靶向药物不同，外推时需谨慎。",
            "发现的HSP70+ CD8+ T细胞亚群及其高核糖体活性主要在结直肠癌和小鼠模型中验证，在其他实体瘤中的普遍性有待进一步确认。",
            "LAG3的诱导和增敏效果是在CT26（微卫星稳定）模型中观察到的，不能直接推广到所有MSI-H肿瘤或所有免疫检查点组合。",
            "核糖体状态签名是基于NMF算法构建的计算指标，虽经多项验证，但仍需结合其他独立方法确认其在不同平台数据中的稳健性。"
          ],
          "topic_handles": [
            "核糖体生物合成活性作为免疫细胞功能状态的标志物",
