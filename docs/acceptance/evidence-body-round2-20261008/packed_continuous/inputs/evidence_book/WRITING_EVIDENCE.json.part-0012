            }
          ],
          "paper_kind": "empirical",
          "problem_or_question": "尽管免疫检查点阻断（ICB）疗法在某些癌症中取得显著成效，但大多数患者无响应或产生耐药性。肿瘤内在因素（如低突变负荷、局部免疫抑制）和宿主因素导致响应异质性。具体而言，肿瘤代谢环境的改变如何调节抗肿瘤免疫反应并影响ICB疗效？特别是肠道微生物群产生的代谢物是否通过特定分子机制直接作用于肿瘤细胞以克服内在耐药性？",
          "research_scope": "小鼠黑色素瘤（B16-F0, B16-GMCSF）和三阴性乳腺癌（4T1）模型，以及人类肾细胞癌（CheckMate 025队列）、黑色素瘤和实体瘤篮式试验患者队列。研究聚焦于免疫检查点阻断（ICB）治疗下的肿瘤代谢微环境与内在免疫原性。",
          "work_summary": "本研究旨在阐明肿瘤代谢状态如何影响免疫检查点阻断（ICB）的疗效。通过小鼠模型的代谢组学筛选和临床队列分析，发现嘌呤代谢物肌苷（inosine）水平与ICB敏感性正相关。机制研究表明，肌苷直接抑制肿瘤细胞内的泛素激活酶UBA6，从而增强肿瘤细胞的抗原呈递能力和对T细胞介导的细胞毒性的敏感性，进而改善抗肿瘤免疫反应。该通路在多种ICB抵抗的小鼠模型中验证了肌苷联合ICB的治疗潜力，并在人类肿瘤样本中证实了UBA6高表达与不良预后及低CD8+ T细胞浸润的相关性。"
        },
        "review_planning_B": {
          "planning_summary": "该论文提供了关于肠道微生物群衍生代谢物（肌苷）如何通过直接靶向肿瘤细胞内在机制（UBA6抑制）来增强免疫检查点抑制剂（ICB）疗效的具体证据。它填补了“微生物代谢物-肿瘤细胞内在属性-免疫响应”这一链条中的关键分子机制空白，特别强调了肿瘤细胞并非被动受体，而是通过代谢感应主动调节其免疫原性。这对于解释为何某些微生物组成有利于ICB响应，以及如何通过代谢干预克服肿瘤内在耐药性具有重要参考价值。",
          "facet_contributions": [
            {
              "boundaries": "主要基于小鼠模型和有限的临床队列；肌苷的来源不仅限于肠道微生物（也可由癌细胞分泌），需结合其他文献明确其在不同情境下的主要来源。",
              "contribution": "提供了肌苷（一种由肠道微生物群产生或受其影响的代谢物）与ICB疗效正相关的临床和体内证据。展示了肌苷水平可作为预测ICB响应的生物标志物。",
              "facet_id": "F1",
              "possible_uses": "用于综述中讨论肠道微生物群代谢产物如何作为系统性信号调节抗肿瘤免疫，特别是那些能够进入血液循环并作用于远端器官（如肿瘤）的代谢物。"
            },
            {
              "boundaries": "机制主要在黑色素瘤和乳腺癌模型中验证；UBA6在其他类型实体瘤中的作用可能不同（如MC38结肠癌模型中UBA6低表达导致肌苷无效）。",
