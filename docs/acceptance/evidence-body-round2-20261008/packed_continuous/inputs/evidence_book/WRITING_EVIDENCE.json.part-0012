        "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\17a3c5cfa0cf5f59523761562650015ee0a27a38\\e707a437cb5300dd5a158f30dec73a34\\attempt-01\\PAPER_READING_CARD.json"
