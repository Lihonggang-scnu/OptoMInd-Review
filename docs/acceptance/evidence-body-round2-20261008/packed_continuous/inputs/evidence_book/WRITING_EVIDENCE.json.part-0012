      {
        "source_handle": "P0113",
        "title": "Influence of the gut microbiota on the response to immunotherapy in hepatocellular carcinoma",
        "year": "2025",
        "doi": "10.20517/2394-5079.2025.07",
        "paper_id": "311fa59a8b5fb73c98a3ccc71ace6cff185cf5a1",
        "material_depth": "fulltext",
        "material_status": "resolved",
        "aliases": [],
        "study_summary_A": {
