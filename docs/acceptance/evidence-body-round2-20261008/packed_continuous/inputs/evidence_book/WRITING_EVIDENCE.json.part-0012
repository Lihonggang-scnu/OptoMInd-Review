      {
        "source_handle": "P0457",
        "title": "The tumor microbiome and cancer immunotherapy: A systematic review of a new frontier beyond the gut.",
        "year": "2025",
        "doi": "10.1016/j.bulcan.2025.09.006",
        "paper_id": "c9e703c8b55bc186c169f077572bc056d0e0e549",
        "material_depth": "abstract",
        "material_status": "resolved",
        "aliases": [],
        "study_summary_A": {
          "approach": "采用系统综述方法，遵循PRISMA指南。检索策略包括四个主要数据库（PubMed, Scopus, Web of Science, EMBASE），时间范围为2010年1月至2025年4月。纳入标准限定为研究非肠道微生物群（即肿瘤组织内的微生物）并评估特定免疫终点（T细胞浸润、细胞因子、PD-L1、ICI反应性）。排除标准隐含在“非肠道”和“免疫终点”的限定中。由于研究间终点异质性大，作者决定不进行定量荟萃分析，而是进行定性综合。",
          "contribution_and_limits": [
            {
              "contribution": "提供了关于肿瘤内微生物群（非肠道）在多种实体瘤中调节免疫反应和ICI疗效的系统性定性综述；归纳了三种主要的免疫调节机制；强调了效应的空间结构和肿瘤背景依赖性。",
              "limits": "仅纳入17项研究，样本量有限；由于终点异质性未进行荟萃分析，缺乏量化效应大小；所给摘要未交代具体纳入研究的详细质量评估结果、偏倚风险评估细节以及各癌症亚组的具体效应方向差异；结论部分提出的临床转化建议属于未来展望，非本综述已验证的结果。"
            }
          ],
          "key_findings": [
            {
              "conditions": "涉及黑色素瘤、胰腺癌、食管癌、胃癌、乳腺癌、肺癌和结直肠癌等多种实体瘤",
              "finding": "肿瘤内细菌能够调节免疫反应和免疫检查点抑制剂的疗效"
            },
            {
              "conditions": "跨多种癌症类型的综合分析",
              "finding": "识别出三个反复出现的机制：1) 通过抗原呈递和Th1极化激活免疫；2) 通过调节性T细胞募集和基质重塑抑制免疫；3) 通过微生物信号传导调节检查点和导致T细胞耗竭"
            },
            {
              "conditions": "所有纳入研究的综合观察",
              "finding": "这些免疫调节效应具有空间结构特征，并且高度依赖于具体的肿瘤背景（tumor-context dependent）"
            }
          ],
          "paper_kind": "review",
          "problem_or_question": "尽管肠道微生物群已知能调节全身免疫和ICI反应，但肿瘤驻留微生物群的作用仍未得到充分探索。本研究旨在回答：肿瘤内微生物群如何影响肿瘤内免疫反应和免疫治疗结果？",
          "research_scope": "肿瘤内微生物群（tumor-resident microbiota）及其对实体瘤免疫反应和免疫检查点抑制剂（ICIs）疗效的影响。涵盖黑色素瘤、胰腺癌、食管癌、胃癌、乳腺癌、肺癌和结直肠癌等实体瘤类型。",
          "work_summary": "该论文是一篇遵循PRISMA指南的系统综述，旨在评估肿瘤相关细菌对抗肿瘤免疫反应的影响。研究检索了2010年1月至2025年4月期间PubMed、Scopus、Web of Science和EMBASE数据库中的文献，纳入标准为表征非肠道微生物群并评估免疫终点（如T细胞浸润、细胞因子谱、PD-L1表达或ICI反应性）的研究。由于终点异质性，未进行荟萃分析。最终纳入17项研究，发现肿瘤内细菌通过三种主要机制调节免疫反应和ICI疗效：通过抗原呈递和Th1极化激活免疫；通过调节性T细胞募集和基质重塑抑制免疫；以及通过微生物信号传导调节检查点和导致T细胞耗竭。这些效应具有空间结构特征且依赖于肿瘤背景。结论认为肿瘤局部微生物群是肿瘤免疫微环境中的一个独特且可操作的组成部分，将其纳入免疫肿瘤学策略可能有助于生物标志物发现、患者分层和基于微生物组的疗法开发。"
        },
        "review_planning_B": {
          "broader_review_uses": [
            {
              "connection_to_review": "帮助用户全面理解微生物组在癌症免疫治疗中的作用范围，避免将讨论局限于肠道。为综述提供‘局部 vs 全身’微生物影响的理论框架。",
              "material": "区分‘肠道微生物群’与‘肿瘤驻留微生物群’的概念，强调后者是肿瘤免疫微环境的独特组成部分。",
              "purpose": "概念区分与背景扩展"
            },
            {
              "connection_to_review": "当综述讨论肠道菌群如何通过全身免疫调节影响肿瘤时，可引用此综述中的机制作为肿瘤局部可能存在的平行或交互机制，丰富对‘机制介导效应’的理解。",
              "material": "三种免疫调节机制（激活、抑制、耗竭）的描述。",
              "purpose": "机制整合参考"
            },
            {
              "connection_to_review": "可作为综述中‘局限性’或‘未来展望’部分的参考，指出当前领域在空间分辨率和功能验证方面的不足。",
              "material": "呼吁绘制空间微生物异质性图谱、验证功能机制及临床转化。",
              "purpose": "未来研究方向提示"
            }
          ],
