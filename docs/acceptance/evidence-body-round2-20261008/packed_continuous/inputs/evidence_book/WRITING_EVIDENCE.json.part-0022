    "atom::f3675d08d336269e9d5f7b86": {
      "atom_id": "atom::f3675d08d336269e9d5f7b86",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the interaction between the gut microbiome (specific taxa and metabolites) and the efficacy/toxicity of immune checkpoint inhibitors (ICIs), including PD-1, PD-L1, CTLA-4, LAG-3, TIGIT, and TIM-3 targets. It covers preclinical mechanistic studies and early-phase clinical trials across various solid tumors (melanoma, NSCLC, RCC, gastric/colorectal cancer).",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::ffb9e07e822a6a49bf255cf0c08060624a3ef35d5168408a5dea2f6c93c12c8d",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::40488f1658ce0a5b0029a52788eb7956984a90ca8f4661f30777228e309223f2",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::b864e5d6aff2b761a52deb5b4a5d6df2f6e153b1dac3ad31063d7f75aaeac576",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::aedb92ec416b9953e49754928e5e84aae6aa204d40c2305a14bc0881155c1edc",
      "multiple_values_in_field": true
    },
    "atom::1bc1f290c28d78622ffb8469": {
      "atom_id": "atom::1bc1f290c28d78622ffb8469",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This narrative review synthesizes current evidence on how the gut microbiota and their metabolic byproducts regulate ICI efficacy and immune-related adverse events (irAEs). It delineates specific microbial taxa (e.g., Bacteroides, Bifidobacterium, Akkermansia) and metabolites (SCFAs, indole derivatives, TMAO) that modulate antitumor immunity and organ protection. The paper also evaluates emerging microbiome-targeted interventions, such as fecal microbiota transplantation (FMT), next-generation probiotics with encapsulation technologies, postbiotics, and precision nutrition, highlighting the context-dependent nature of these interactions and the need for standardized, multi-omics approaches to develop precise microbial interventions.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::ffb9e07e822a6a49bf255cf0c08060624a3ef35d5168408a5dea2f6c93c12c8d",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::40488f1658ce0a5b0029a52788eb7956984a90ca8f4661f30777228e309223f2",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::b864e5d6aff2b761a52deb5b4a5d6df2f6e153b1dac3ad31063d7f75aaeac576",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::8fbf739cef7b75d2ad3e4af84afee3de52999b5a3cf0f8ccaa148d8f5181d50d",
      "multiple_values_in_field": true
    },
    "atom::487a265dc168c8a0c9af82f3": {
      "atom_id": "atom::487a265dc168c8a0c9af82f3",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review offers a structured framework for understanding how gut microbiota and metabolites modulate ICI efficacy and toxicity in solid tumors. It provides detailed mechanistic insights into specific taxa (e.g., Bacteroides, Bifidobacterium, Akkermansia) and metabolites (SCFAs, indoles, TMAO), along with an evaluation of clinical interventions like FMT and probiotics. It is particularly useful for mapping mechanistic pathways and identifying context-dependent biomarkers, while cautioning against universal generalizations due to cohort and methodological heterogeneity.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::ffb9e07e822a6a49bf255cf0c08060624a3ef35d5168408a5dea2f6c93c12c8d",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::40488f1658ce0a5b0029a52788eb7956984a90ca8f4661f30777228e309223f2",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::b864e5d6aff2b761a52deb5b4a5d6df2f6e153b1dac3ad31063d7f75aaeac576",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::7e08b510a5a699a5e3192a6aeaa53c1b439fe73619f8c40e4e2781756cbf672e",
      "multiple_values_in_field": true
    },
    "atom::e4fe0aec77d9cea7ccfbcb3b": {
      "atom_id": "atom::e4fe0aec77d9cea7ccfbcb3b",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Associations are often based on small cohorts or preclinical models. The review explicitly notes that findings are not universally reproducible and depend heavily on study methodology and cohort characteristics.",
        "contribution": "Identifies specific microbial taxa associated with ICI response across different cancer types and ICI regimens (e.g., Bacteroides for anti-CTLA-4, Faecalibacterium/Ruminococcaceae for anti-PD-1, Akkermansia abundance levels for NSCLC). Highlights that microbial roles are context-dependent and vary by tumor type and host factors.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
