    "atom::01a4eaf6f9130e6df88a4449": {
      "atom_id": "atom::01a4eaf6f9130e6df88a4449",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review emphasizes that microbial biomarkers are highly context-dependent (tumor type, ICI regimen, host genetics). Do not generalize findings from one cancer type (e.g., melanoma) to others (e.g., hepatobiliary) without considering this variability.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
