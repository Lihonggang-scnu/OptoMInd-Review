    "atom::c752d967993b9b3b7603d723": {
      "atom_id": "atom::c752d967993b9b3b7603d723",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性观察性队列设计。纳入标准：III/IV期NSCLC候选ICI治疗者；排除标准：其他组织学类型、合并肿瘤、自身免疫病、ECOG评分≥2、既往免疫治疗史、高剂量皮质类固醇使用或已知免疫缺陷。样本采集：基线粪便和血液样本。分析方法：1. 微生物组：16S rDNA V3/V4区测序，ASV分类，Shannon指数计算Alpha多样性，LEfSe进行Beta多样性及差异物种分析。2. 代谢物：GC-MS定量粪便SCFAs（乙酸、丙酸、丁酸等）。3. 通透性：HPLC测血浆瓜氨酸，化学发光法测抗瓜氨酸抗体，ELISA测Zonulin，LAL法测内毒素。4. 临床关联：RECIST标准评估肿瘤反应，记录irAEs，Kaplan-Meier分析生存期，Pearson/Spearman相关性分析整合变量。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::f199eedc9ee7a68d032852edc46551739265d135a191a9d1a43ceb3493cae7ab",
      "multiple_values_in_field": false
    },
    "atom::04c94e3ebea4e25ebe48718f": {
      "atom_id": "atom::04c94e3ebea4e25ebe48718f",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了NSCLC患者在接受ICI治疗前肠道微生物群、SCFA谱和肠道通透性基线特征的详细数据，证实了该人群肠道菌群的丰富性和屏障功能的完整性。首次报告了根据ICI反应和irAE状态分组的NSCLC患者循环内毒素水平。",
        "limits": "未能确立任何预测性生物标志物。存在方法学局限性：缺乏肠道通透性测量的标准化程序和断点值；SCFA正常值尚未建立，阻碍跨研究比较；样本量有限（N=55）；患者接受的ICI药物种类多样（Durvalumab, Pembrolizumab等），可能引入异质性；未区分不同ICI药物对结果的影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::0f0452e91434ecaa9302fa44a3a2bcf8e1e5adfdfa802e91b6e7ab9ea151dc4e",
      "multiple_values_in_field": false
    },
    "atom::a90cd6509aa34163240bad42": {
      "atom_id": "atom::a90cd6509aa34163240bad42",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "N=55 NSCLC患者，基线样本，多中心/单中心（Aragón）",
        "finding": "未检测到肠道微生物组成、SCFA丰度或肠道通透性指标与ICI治疗反应（响应者vs非响应者）或irAE发生之间的统计学显著相关性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::b99f170669c7ba398b6cc705a75297b78b1d149326db14f5246a17d2d9904dd4",
      "multiple_values_in_field": true
    },
    "atom::c7a0d85d35ad699ecb5e5663": {
      "atom_id": "atom::c7a0d85d35ad699ecb5e5663",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "LEfSe差异分析",
        "finding": "响应者在Bacillota门（包括Clostridia和Monoglobus）中丰度较高，Hungatella在非响应者中较高；发生irAEs的患者Betaproteobacteria和Enterococcus丰度较高。但整体Alpha/Beta多样性无组间差异，且这些差异未转化为预测能力。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::b99f170669c7ba398b6cc705a75297b78b1d149326db14f5246a17d2d9904dd4",
      "multiple_values_in_field": true
    },
    "atom::c76c4cadc3a86cae5e2ded13": {
      "atom_id": "atom::c76c4cadc3a86cae5e2ded13",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "SCFA分析",
        "finding": "粪便中主要SCFA为乙酸(56%)、丙酸(19%)和丁酸(11%)，各组间分布无显著差异，且SCFA水平与细菌丰度或临床结局无关联。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::b99f170669c7ba398b6cc705a75297b78b1d149326db14f5246a17d2d9904dd4",
      "multiple_values_in_field": true
    },
    "atom::4ec73ffdf15f6f13395a316a": {
      "atom_id": "atom::4ec73ffdf15f6f13395a316a",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肠道通透性指标",
        "finding": "瓜氨酸分散度高，抗瓜氨酸抗体在90%样本中不可检测，Zonulin和内毒素水平离散度低。所有通透性指标均未显示出预测价值。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
