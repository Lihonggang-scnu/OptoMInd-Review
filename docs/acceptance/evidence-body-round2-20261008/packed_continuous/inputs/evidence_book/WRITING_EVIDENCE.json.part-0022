            "0"
          ]
        }
      ],
      "variant_group": "field::d993ce92b318be8c9ee00dbdce1ba9ac0b1ff380ef05064726b883205cc4b874",
      "multiple_values_in_field": true
    },
    "atom::3fad70e7d4cee75ed5a89c85": {
      "atom_id": "atom::3fad70e7d4cee75ed5a89c85",
      "source_handle": "P0485",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于WES和WGS数据分析。",
        "finding": "肿瘤突变负荷（TMB）中位数为1.34 mut/Mb（范围0.52–14.72）。直肠和泌尿生殖道肿瘤与DNA错配修复和微卫星不稳定性相关的突变签名有关；结膜和口鼻肿瘤与紫外线暴露相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ddae59555ff66f6d76f4f5d45ea66eaa810856dd20f158371ed493cf2234506c",
          "field_path": [
