      "multiple_values_in_field": true
    },
    "atom::c233e41e0f6c2e57947aec0a": {
      "atom_id": "atom::c233e41e0f6c2e57947aec0a",
      "source_handle": "P0134",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "治疗期间，比较响应者与无响应者的微生物组变化幅度",
        "finding": "响应者表现出显著的治疗前后微生物组多样性变化（R2: 0.146, P = 0.0274），而无响应者变化较小。整体而言，治疗时间点对微生物组组成的解释力较弱（P = 0.26），个体效应较强。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7",
