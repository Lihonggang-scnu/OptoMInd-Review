    "atom::a3a5b9914305654656477c50": {
      "atom_id": "atom::a3a5b9914305654656477c50",
      "source_handle": "P0443",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅为相关性观察，未通过干预实验验证网络结构变化是否导致疗效改变。机制解释尚属推测。",
        "contribution": "提出了菌群网络结构可能与疗效相关的假设。长PFS患者表现出更密集的菌群网络和更高的节点中心性，暗示有益菌之间的协同互作可能增强抗肿瘤免疫。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
