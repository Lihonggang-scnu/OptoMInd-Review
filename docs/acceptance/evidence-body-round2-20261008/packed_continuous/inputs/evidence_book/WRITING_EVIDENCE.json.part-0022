    },
    "atom::9e353b4848cda9d7ba50ea4c": {
      "atom_id": "atom::9e353b4848cda9d7ba50ea4c",
      "source_handle": "P0415",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
