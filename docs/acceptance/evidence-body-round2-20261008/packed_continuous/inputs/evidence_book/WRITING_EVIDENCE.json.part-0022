    "atom::d177e617eb456c93aa76f645": {
      "atom_id": "atom::d177e617eb456c93aa76f645",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Provides mechanistic depth for explaining how the gut microbiome influences ICI efficacy and toxicity. Useful for discussing specific signaling pathways (STING, NOD2, AhR, NF-κB) and their role in remodeling the tumor microenvironment and protecting distal organs.",
