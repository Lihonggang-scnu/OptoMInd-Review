            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::154f521ee40e5124ee1f0bcb3a1b5d990ab602348ed5225ac4f636986913c3a9",
      "multiple_values_in_field": true
    },
    "atom::55c33235f80e8328c7a34808": {
      "atom_id": "atom::55c33235f80e8328c7a34808",
      "source_handle": "P0026",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节ICI疗效”中的“效应方向”和“预测价值”部分。可作为微生物组作为ICI疗效生物标志物的实证支持，展示其在不同癌症类型和ICI方案中的表现差异。",
      "role": "planning",
      "origins": [
