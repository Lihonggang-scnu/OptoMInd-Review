    "atom::5e3f0657dbc810fb682a25e8": {
      "atom_id": "atom::5e3f0657dbc810fb682a25e8",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To systematically characterize the complex interplay between the gut microbiome, its metabolome, and ICI outcomes (efficacy and toxicity), addressing the clinical heterogeneity in patient responses and the lack of reproducible predictive models or intervention strategies.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::ffb9e07e822a6a49bf255cf0c08060624a3ef35d5168408a5dea2f6c93c12c8d",
          "field_path": [
