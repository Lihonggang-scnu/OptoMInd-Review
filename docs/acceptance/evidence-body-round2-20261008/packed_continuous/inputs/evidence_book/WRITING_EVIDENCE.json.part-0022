    "atom::4f4f27ebf49eb4765b4072a3": {
      "atom_id": "atom::4f4f27ebf49eb4765b4072a3",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Anti-CTLA-4 therapy; Melanoma patients and mouse models",
        "finding": "CTLA-4 blockade reshapes the microbiota, favoring Bacteroides species (B. fragilis, B. thetaiotaomicron), which are critical for therapeutic efficacy via Th1 responses and dendritic cell activation."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
