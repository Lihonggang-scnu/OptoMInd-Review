            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::b99f170669c7ba398b6cc705a75297b78b1d149326db14f5246a17d2d9904dd4",
      "multiple_values_in_field": true
    },
    "atom::c7edd84f89163acdfe329e2f": {
      "atom_id": "atom::c7edd84f89163acdfe329e2f",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "empirical",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::ef68b78aaa2c52ce54152851a907242d406bda04344df4828a454f9f5ce335d0",
      "multiple_values_in_field": false
    },
    "atom::ebe73d0fbe36fc556bf60bd5": {
      "atom_id": "atom::ebe73d0fbe36fc556bf60bd5",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "目前NSCLC患者对ICI治疗的总体响应率较低（15-20%），且缺乏可靠的预测生物标志物，同时部分患者会出现严重的免疫相关不良事件（irAEs）。既往研究提示肠道微生物可能影响ICI疗效，但具体机制和标志物尚不明确，且肠道通透性这一宿主因素常被忽视。本研究试图确定肠道微生物群、其代谢产物（SCFAs）以及肠道屏障完整性是否可作为预测ICI疗效和毒性的有效生物标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::0609741e5763cf7daea25b601641813d405507090514e2e9c635a287fc2d16a5",
      "multiple_values_in_field": false
    },
    "atom::20d0bd74bfeb5c2c59eb251a": {
      "atom_id": "atom::20d0bd74bfeb5c2c59eb251a",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "针对接受免疫检查点抑制剂（ICI）治疗的非小细胞肺癌（NSCLC）患者，研究肠道微生物群组成、短链脂肪酸（SCFAs）丰度及肠道膜通透性作为治疗反应和免疫相关不良事件（irAEs）预测生物标志物的可能性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::0ed7ba5bc56bae0e2ffdb7c2d4cfef89e9455e9f76d42ec7e39fd077290aaa36",
      "multiple_values_in_field": false
    },
    "atom::1ffdc646d0901680e004cd87": {
      "atom_id": "atom::1ffdc646d0901680e004cd87",
      "source_handle": "P0327",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在识别NSCLC患者中预测ICI疗效和毒性的生物标志物，重点考察肠道微环境。研究招募了55名接受不同ICI方案（如Durvalumab, Pembrolizumab等）的III期或IV期NSCLC患者，在基线时收集粪便和血液样本。通过16S rDNA扩增测序分析肠道菌群组成，利用GC-MS测定粪便中的短链脂肪酸含量，并通过血浆检测瓜氨酸、抗瓜氨酸抗体、Zonulin和内毒素水平来评估肠道屏障通透性。统计分析包括描述性统计、生存分析（Kaplan-Meier）、相关性分析及LEfSe差异分析。结果显示，尽管患者肠道菌群丰富多样且功能均一，但未能发现任何肠道微生物组成、代谢产物或通透性指标与ICI治疗反应或irAE发生之间的显著相关性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::27c75ff1f00e2e8160aa1da52e067d6512253fc64e58625d95ee9c008a3d9222",
      "multiple_values_in_field": false
    },
    "atom::d1dc142112f35c2405952e5a": {
      "atom_id": "atom::d1dc142112f35c2405952e5a",
      "source_handle": "P0327",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了一项针对NSCLC患者的阴性研究结果，表明在基线状态下，肠道微生物组成、短链脂肪酸和肠道通透性并不能直接预测ICI的治疗反应或毒性。这对于综述中关于“肠道微生物作为通用预测因子”的讨论具有反面证据价值，提示需考虑疾病特异性、治疗药物特异性或时间动态变化等因素。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::6dde2e2f7897ed9df6921fd6b2a641f540834a0c0691e2b9846ef77062677cc2",
      "multiple_values_in_field": false
    },
    "atom::f7b52aa894524dc65e6a393e": {
      "atom_id": "atom::f7b52aa894524dc65e6a393e",
      "source_handle": "P0327",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅适用于NSCLC患者；基线静态测量；多种ICI药物混合分析；未解决因果机制。",
        "contribution": "提供了NSCLC特定亚群中肠道微生物与ICI疗效关系的实证数据：未发现显著关联。具体显示响应者中Clostridia/Monoglobus较多，非响应者中Hungatella较多，但整体预测效能缺失。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::cdbbe74aaf44dad91e0507df71e623554c73f7c1412ddc699d5c1e91b83706b3",
      "multiple_values_in_field": true
    },
    "atom::067ae487e6e089014cd3664b": {
      "atom_id": "atom::067ae487e6e089014cd3664b",
      "source_handle": "P0327",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于反驳或限定“肠道微生物普遍预测ICI疗效”的观点，强调在NSCLC中可能需要更复杂的模型或不同的微生物特征。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::f522f4c458ad51d057460781ba5e9a5d6d7f84754328b71e6151f7da5e4d8b9f",
      "multiple_values_in_field": true
    },
    "atom::b0d997db79f078889417976d": {
      "atom_id": "atom::b0d997db79f078889417976d",
      "source_handle": "P0327",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅基于基线血浆/粪便样本；未涉及干预后的动态变化；内毒素检测为首次在该人群中尝试，但结果不具预测性。",
        "contribution": "探讨了肠道屏障通透性（瓜氨酸、Zonulin、内毒素）与ICI反应的关系，结果为阴性。指出目前缺乏标准化的通透性测量方法和参考值。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::cdbbe74aaf44dad91e0507df71e623554c73f7c1412ddc699d5c1e91b83706b3",
      "multiple_values_in_field": true
    },
