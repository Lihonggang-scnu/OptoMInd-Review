    "atom::eab85e6bee9c4b2fed5a5534": {
      "atom_id": "atom::eab85e6bee9c4b2fed5a5534",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conducted a comprehensive literature search across PubMed/MEDLINE, Web of Science, and Embase up to May 1, 2026. They included original studies, RCTs, cohort studies, and preclinical investigations examining the impact of gut microbiota/metabolites on ICI efficacy or toxicities. Data extraction followed STORMS guidelines. As a narrative review, formal risk-of-bias assessment, quality grading, and statistical meta-analysis were not performed. The synthesis is organized thematically: mechanisms of ICIs, heterogeneity of microbiome-ICI interactions, microbial metabolites as mediators, clinical heterogeneity of irAEs, and microbiome-based interventions.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::ffb9e07e822a6a49bf255cf0c08060624a3ef35d5168408a5dea2f6c93c12c8d",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::40488f1658ce0a5b0029a52788eb7956984a90ca8f4661f30777228e309223f2",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::b864e5d6aff2b761a52deb5b4a5d6df2f6e153b1dac3ad31063d7f75aaeac576",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::a13c9c26bcd420313c543d747e01a81080d5049384eb726545e01242db38d78b",
      "multiple_values_in_field": true
    },
    "atom::e2c9835b96f8fc6dc09ac52b": {
      "atom_id": "atom::e2c9835b96f8fc6dc09ac52b",
      "source_handle": "P0333",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive mechanistic synthesis linking specific gut taxa and metabolites to ICI efficacy and irAE mitigation, highlighting context-dependent biomarkers rather than universal signatures.",
        "limits": "As a narrative review, it lacks formal risk-of-bias assessment, quality grading, and statistical meta-analysis. Findings are largely derived from preclinical models or small clinical cohorts with limited covariate adjustment. The review does not establish causal relationships for all proposed mechanisms due to observational data dominance."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3d8858e15482badd0b239265e80a7dda3eb3f04c865c1163fe5f70b9b43ab3eb",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
