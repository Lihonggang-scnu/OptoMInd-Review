      "multiple_values_in_field": true
    },
    "atom::35103c949497a976bb9740b8": {
      "atom_id": "atom::35103c949497a976bb9740b8",
      "source_handle": "P0443",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "观察性研究，混杂因素较多。化疗方案多样，未统一标准化。",
        "contribution": "评估了化疗预处理对肠道菌群的影响。发现化疗确实改变了菌群组成（β-多样性差异），但这种改变并未将菌群推向特定的“不良预后”表型，且化疗预处理患者中仍保留了与PFS相关的特异性菌群差异。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "4"
          ]
        }
      ],
      "variant_group": "field::6afceca2b41eb460d5fed75ae0ee855762f16cff547664af130260313b3556da",
      "multiple_values_in_field": true
    },
    "atom::ca2cea6a4d618e0da1899842": {
      "atom_id": "atom::ca2cea6a4d618e0da1899842",
      "source_handle": "P0443",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中解决“化疗是否通过破坏菌群从而削弱ICI疗效”的争议。提供证据表明化疗虽扰动菌群，但不一定完全消除微生物组对疗效的预测能力。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
          "field_path": [
