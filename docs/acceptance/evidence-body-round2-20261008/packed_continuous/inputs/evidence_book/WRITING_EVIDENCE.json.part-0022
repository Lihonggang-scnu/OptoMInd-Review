    "atom::711d27360533c41d6d2ec36c": {
      "atom_id": "atom::711d27360533c41d6d2ec36c",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用范围综述方法论。使用PICO框架构建指导问题，在PubMed/MEDLINE, Web of Science, Scopus, SciELO, LILACS五个数据库进行结构化搜索。纳入标准为涉及成年癌症患者、接受系统性肿瘤治疗、进行肠道微生物组分析并明确链接到治疗反应/毒性/预后的研究。排除儿科、仅放疗/手术、纯体外实验及2015年前文献。数据提取通过标准化表格进行，涵盖研究设计、人群特征、微生物分析方法、预测模型性能及主要结果。最终通过叙事综合法（narrative synthesis）对数据进行定性汇总，按癌症类型和治疗模式分类，重点区分“定量预测模型”与“微生物特征描述”，并识别知识空白和方法学局限。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::38e4c0074ca7ae8e0bc0f6b4de06e11083317c7a464d104701abdeb06b323a11",
      "multiple_values_in_field": false
    },
    "atom::011d8e1b72c422e144efa713": {
      "atom_id": "atom::011d8e1b72c422e144efa713",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了2015-2025年间肠道微生物组在肿瘤治疗反应中应用的全面地图，区分了预测模型开发与微生物特征描述两类证据。",
        "limits": "作为范围综述，不进行质量评估或因果推断；未提供定量荟萃分析结果；所引用的原始研究多为小样本或回顾性，存在选择偏倚和混杂因素控制不足的风险。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::6a28b8f5876aa03cfb5c855de23730eef21b6b53698af95bd91151a1bb3a7bbd",
      "multiple_values_in_field": true
    },
    "atom::47aa59edf8e80e7879afe702": {
      "atom_id": "atom::47aa59edf8e80e7879afe702",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "明确了微生物组预测模型在特定情境下（如尿路上皮癌、直肠癌）超越传统临床标记物的潜力，强调了菌株水平分辨率的重要性。",
        "limits": "不同研究的测序技术、生信流程和统计方法高度异质，导致直接比较困难；多数证据仍为关联性而非因果性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::6a28b8f5876aa03cfb5c855de23730eef21b6b53698af95bd91151a1bb3a7bbd",
      "multiple_values_in_field": true
    },
    "atom::b7ee2bfeae4e357feca73e50": {
      "atom_id": "atom::b7ee2bfeae4e357feca73e50",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "指出了临床转化的主要障碍：方法学标准化缺失、外部验证不足、机制不明及监管挑战。",
        "limits": "未能提供具体的标准化协议建议或成本效益分析的详细数据；对真菌、病毒等非细菌微生物的作用探讨有限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::6a28b8f5876aa03cfb5c855de23730eef21b6b53698af95bd91151a1bb3a7bbd",
      "multiple_values_in_field": true
    },
    "atom::83d1af535bb6a4c8baae2ee9": {
      "atom_id": "atom::83d1af535bb6a4c8baae2ee9",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "免疫检查点抑制剂（ICI）治疗，多中心队列及荟萃分析",
        "finding": "菌株水平的微生物特征比临床因素更具预测力。Gunjur等(2024)发现针对联合ICI反应的菌株特征AUC为0.73，优于临床因素的0.56；但泛癌种通用特征在不同ICI方案间外推性较差（一致方案AUC 0.65 vs 不一致方案0.51）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::2e0d5dea53a19c04d2d541be97a19d99f730b273772e496a1649be0ba7404408",
      "multiple_values_in_field": true
    },
    "atom::aa01327d182b7a35bd738a5f": {
      "atom_id": "atom::aa01327d182b7a35bd738a5f",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "新辅助化疗，尿路上皮癌",
        "finding": "微生物组预测模型表现优于临床变量。Bukavina等(2024)开发的随机森林模型预测完全缓解（CR）的AUC为0.88，而临床因素仅为0.50；高拟杆菌属丰度与较差反应相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::2e0d5dea53a19c04d2d541be97a19d99f730b273772e496a1649be0ba7404408",
      "multiple_values_in_field": true
    },
    "atom::65ce34ec16ea84186df5a999": {
      "atom_id": "atom::65ce34ec16ea84186df5a999",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "同步放化疗，鼻咽癌",
        "finding": "益生菌干预可降低毒性。Xia等(2021)的II期试验显示，益生菌鸡尾酒将3-4级口腔粘膜炎发生率从47.1%降至25%，并通过调节肠道菌群失调和增强免疫反应发挥作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::2e0d5dea53a19c04d2d541be97a19d99f730b273772e496a1649be0ba7404408",
      "multiple_values_in_field": true
    },
    "atom::fdaca457d135841bbe395399": {
      "atom_id": "atom::fdaca457d135841bbe395399",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "新辅助免疫放化疗，局部晚期直肠癌",
        "finding": "物种水平模型具有高预测准确性。Yang等(2024)开发的SPEED模型在训练集AUC为98.8%，验证集为77.8%，用于预测病理完全缓解（pCR）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        },
        {
          "record_id": "record::5faffef44afd82f262ce3f1347e9753cc220ab96fb590df4753e70d1cbaf59c9",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::2e0d5dea53a19c04d2d541be97a19d99f730b273772e496a1649be0ba7404408",
      "multiple_values_in_field": true
    },
    "atom::cb0b5abe6bd93e8ca5e5c6b5": {
      "atom_id": "atom::cb0b5abe6bd93e8ca5e5c6b5",
      "source_handle": "P0026",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "多种实体瘤，综述综合",
        "finding": "特定菌属与疗效/毒性关联。双歧杆菌、阿克曼氏菌、粪杆菌等通常与ICI良好反应相关；梭杆菌、拟杆菌等在部分研究中与化疗耐药或毒性增加相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f7716cb6058d5ce6dc7380a56a9751c240e5f089a1cf905906778e20f3972338",
          "field_path": [
