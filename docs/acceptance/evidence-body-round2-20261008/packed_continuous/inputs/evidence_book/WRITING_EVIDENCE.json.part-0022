        {
          "record_id": "record::b864e5d6aff2b761a52deb5b4a5d6df2f6e153b1dac3ad31063d7f75aaeac576",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::039b0e4d072e12bd65bd18ea1803ef67b1d121c33ee3d1dd4bfbb3fa87047c8b",
      "multiple_values_in_field": true
