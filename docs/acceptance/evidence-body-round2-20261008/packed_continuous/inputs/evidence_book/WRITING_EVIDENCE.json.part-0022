    "atom::b0b1a04089a4113806fc84ec": {
      "atom_id": "atom::b0b1a04089a4113806fc84ec",
      "source_handle": "P0415",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于JSD距离的Ward层次聚类，区分高、中、低风险组",
        "finding": "低风险组（富集F. prausnitzii等）相比高风险组（富集Bacteroides spp.）在任何随访时间点具有99%更低的进展风险（HR=0.01, p=0.002）。"
      },
      "role": "evidence",
