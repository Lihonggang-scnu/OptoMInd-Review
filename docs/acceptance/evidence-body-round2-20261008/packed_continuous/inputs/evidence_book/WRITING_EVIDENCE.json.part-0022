    "atom::4fc1b23aa9738aec8d869909": {
      "atom_id": "atom::4fc1b23aa9738aec8d869909",
      "source_handle": "P0098",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "纵向队列研究设计。收集III期黑色素瘤患者在联合ICI治疗前（基线）和治疗后第6周的配对粪便样本（n=126）和外周血PBMC样本（n=71）。使用16S rRNA基因测序分析肠道微生物组成，使用质谱流式细胞术全面 profiling 循环免疫细胞亚群。比较基线与第6周的微生物和免疫指标变化，并分析其与临床应答状态及irAEs严重程度的关联。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::abeae3f5437f046402745e3d90c12137942e031e6a48cef52cb857f87928ce97",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::6bd724179a28fdc49a9796137c61dc5af3dc79da06a51d29961b4c4029176986",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::da0f21f85aefb292e922131e9a325a641129db8a0e28454cc10d9988dc744a7b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::2db306bb103a2d9ad25bdc043e8de22313e7442971e7226cb8951813a46ff9ae",
      "multiple_values_in_field": false
    },
    "atom::ddc7133862b1e98dee7bbcc4": {
      "atom_id": "atom::ddc7133862b1e98dee7bbcc4",
      "source_handle": "P0098",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了纵向证据，表明肠道微生物组（特别是拟杆菌属和瘤胃球菌科）与ICI治疗期间的免疫细胞动态（特别是Tregs）及临床结局（应答和irAEs）存在关联。",
        "limits": "所给摘要未交代具体的统计校正方法（如多重检验校正）、微生物功能推断细节、以及是否控制了其他混杂因素（如抗生素使用、饮食等）。此外，作为会议摘要，缺乏完整的实验细节和长期随访数据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::abeae3f5437f046402745e3d90c12137942e031e6a48cef52cb857f87928ce97",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::6bd724179a28fdc49a9796137c61dc5af3dc79da06a51d29961b4c4029176986",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::da0f21f85aefb292e922131e9a325a641129db8a0e28454cc10d9988dc744a7b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::ca6aa8c0bb302416b8c15fd81e66c852600b881f543d7227e1b861e060b8b27b",
      "multiple_values_in_field": false
    },
    "atom::5ced063ef4d895bb2527ef3c": {
      "atom_id": "atom::5ced063ef4d895bb2527ef3c",
      "source_handle": "P0098",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ICI治疗前后对比",
        "finding": "治疗导致循环中CD8+效应记忆T细胞（Tem）频率增加（P=0.0096）和调节性T细胞（Tregs）频率减少（P=0.0029）。"
      },
