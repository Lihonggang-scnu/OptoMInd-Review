    "atom::43564e4cabb74c63d54ecf12": {
      "atom_id": "atom::43564e4cabb74c63d54ecf12",
      "source_handle": "P0098",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线微生物与临床结局的关联",
        "finding": "较高的基线拟杆菌属丰度与更严重的irAEs发展（P=0.0472）及第6周前更高的类固醇使用率（P=0.0345）相关。相反，较高的瘤胃球菌科（Ruminococcaceae）丰度具有保护作用，且瘤胃球菌科主导的微生物组患者中应答者比例更高。"
      },
      "role": "evidence",
      "origins": [
