    "atom::c302f1d1ebc15fb248ecf95b": {
      "atom_id": "atom::c302f1d1ebc15fb248ecf95b",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Many mechanistic insights are derived from preclinical models. Clinical translation is still in early phases (Phase I/II trials). Avoid overstating the clinical applicability of specific microbial interventions.",
      "role": "evidence",
      "origins": [
        {
