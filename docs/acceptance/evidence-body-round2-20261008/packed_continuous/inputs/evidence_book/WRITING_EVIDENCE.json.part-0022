    "atom::e375dcfa704548e4e1e2ce18": {
      "atom_id": "atom::e375dcfa704548e4e1e2ce18",
      "source_handle": "P0546",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇综述，本研究通过系统检索PubMed和Google Scholar数据库（关键词包括“gut microbiome and host immunity”等），筛选2011-2021年间发表的相关文献。内容综合分为三个主要部分：(1) 机制综述：从分子和细胞水平描述微生物-宿主免疫互作网络；(2) 临床转化综述：汇总关于FMT、益生菌、益生元及饮食干预的临床试验结果（引用Table 1列出具体试验）；(3) 批判性分析：讨论现有研究的局限性、安全性问题及未来方向。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b4fe98bf4129f2a01928c2dea54b27c42719f4459b2136cad880a3aeae5d355f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::49f12e61cfb8da920f6cf52841f75aa5905c76686779d0cee01360fc0739b84f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::3c9a522e578b7dea54fe3ca9c04e639d6d2c06e3ef62b5482f80e5c3f9514cca",
      "multiple_values_in_field": false
    },
    "atom::699ce05cd5b6d1ea0619d0b3": {
      "atom_id": "atom::699ce05cd5b6d1ea0619d0b3",
      "source_handle": "P0546",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物组影响ICI疗效的多维度机制框架（从黏膜屏障到全身免疫及TME重塑）；系统梳理了多种微生物干预策略（FMT、益生菌、益生元、饮食）的临床前及早期临床试验数据；指出了当前研究在标准化测序、供体选择及安全性方面的关键瓶颈。",
        "limits": "作为综述，其结论依赖于所引用的原始研究，未进行新的实验验证；所引用的临床试验多为早期阶段（I/II期）或小样本，疗效证据尚不充分；不同研究间因队列差异、测序方法不同导致的结果不一致性未被完全解决；对于具体菌株或代谢物的因果机制，部分仍基于动物模型或观察性关联，缺乏大规模随机对照试验的确证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b4fe98bf4129f2a01928c2dea54b27c42719f4459b2136cad880a3aeae5d355f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::49f12e61cfb8da920f6cf52841f75aa5905c76686779d0cee01360fc0739b84f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::d2209a151810285b28ddce10f94c6d7a6555596e475eab89495fdd8a4f397979",
      "multiple_values_in_field": false
    },
    "atom::598e775f94110c1118942162": {
      "atom_id": "atom::598e775f94110c1118942162",
      "source_handle": "P0546",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "机制层面",
        "finding": "肠道微生物通过PRRs识别PAMPs激活先天免疫；通过GALT组织诱导Treg/Th17分化及SIgA产生；代谢物如SCFAs可进入循环调节全身免疫及TME中的巨噬细胞/DC功能；存在抗原交叉反应机制，针对细菌抗原的T细胞可能激活抗肿瘤反应。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b4fe98bf4129f2a01928c2dea54b27c42719f4459b2136cad880a3aeae5d355f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::49f12e61cfb8da920f6cf52841f75aa5905c76686779d0cee01360fc0739b84f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::bba94dc08d36addf78b1faabe5b258b8b023383ba332fb715c35eb00f440b37d",
      "multiple_values_in_field": true
    },
    "atom::b9c08ebf69f13f06d0cf38c6": {
      "atom_id": "atom::b9c08ebf69f13f06d0cf38c6",
      "source_handle": "P0546",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "FMT干预",
        "finding": "临床前显示FMT可将非响应者微生物转移给无菌小鼠从而恢复PD-1疗效；临床试验（如NCT03353402, NCT03341143）显示FMT联合PD-1抑制剂可使部分难治性黑色素瘤患者获得客观缓解，并改变肠道及肿瘤微环境的免疫细胞浸润。但存在严重不良事件风险（如耐药菌感染、死亡）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b4fe98bf4129f2a01928c2dea54b27c42719f4459b2136cad880a3aeae5d355f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::49f12e61cfb8da920f6cf52841f75aa5905c76686779d0cee01360fc0739b84f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::bba94dc08d36addf78b1faabe5b258b8b023383ba332fb715c35eb00f440b37d",
      "multiple_values_in_field": true
    },
    "atom::6a1935c1fa786f0d5c27a8ee": {
      "atom_id": "atom::6a1935c1fa786f0d5c27a8ee",
      "source_handle": "P0546",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "益生菌/菌群制剂",
        "finding": "特定菌株（如Bifidobacterium, Lactobacillus）联合ICI治疗在某些癌症（如肾癌、NSCLC）的临床试验中显示出改善ORR/PFS的趋势；某些菌株（如Blautia obeum）与不良预后或结肠炎风险增加相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b4fe98bf4129f2a01928c2dea54b27c42719f4459b2136cad880a3aeae5d355f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::49f12e61cfb8da920f6cf52841f75aa5905c76686779d0cee01360fc0739b84f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::bba94dc08d36addf78b1faabe5b258b8b023383ba332fb715c35eb00f440b37d",
      "multiple_values_in_field": true
    },
    "atom::522c1a8223671dc609d86668": {
      "atom_id": "atom::522c1a8223671dc609d86668",
      "source_handle": "P0546",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "益生元/饮食",
        "finding": "抗性淀粉（RS）等益生元促进有益菌生长及SCFA产生，增强化疗/放疗疗效并降低炎症因子；高纤维饮食与黑色素瘤患者更好的PD-1响应率相关；嘌呤核苷肌苷（Inosine）被鉴定为改善ICI疗效的关键代谢物。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b4fe98bf4129f2a01928c2dea54b27c42719f4459b2136cad880a3aeae5d355f",
          "field_path": [
