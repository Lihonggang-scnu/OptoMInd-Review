    "atom::35567035615401ef1a5579ae": {
      "atom_id": "atom::35567035615401ef1a5579ae",
      "source_handle": "P0227",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究为会议摘要，缺乏详细的方法学和统计数据，需谨慎对待其预测模型的精确度和泛化能力。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6e7ffa85992e5ceda916922602675de3a38fa153087bcc05b233652890a41857",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::8283418c18f39455e0ceae52986063f5862a5127f866b3494bdee60a1f61472e",
      "multiple_values_in_field": true
    },
    "atom::c8c3f50ee997b9fe41ea6242": {
      "atom_id": "atom::c8c3f50ee997b9fe41ea6242",
      "source_handle": "P0227",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "‘稳定性丧失’是观察到的关联现象，摘要未证明其因果方向（即是不稳定性导致耐药，还是耐药过程中的生理变化导致微生物不稳定）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::6e7ffa85992e5ceda916922602675de3a38fa153087bcc05b233652890a41857",
          "field_path": [
