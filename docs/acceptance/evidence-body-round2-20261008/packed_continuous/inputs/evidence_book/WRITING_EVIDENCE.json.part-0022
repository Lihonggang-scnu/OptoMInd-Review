    "atom::799dc90a7500725ba934e5e4": {
      "atom_id": "atom::799dc90a7500725ba934e5e4",
      "source_handle": "P0205",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "A prospective observational cohort design was used. Clinical data for 74 patients were analyzed for associations between antibiotic/probiotic use and survival outcomes (PFS, OS, ORR) using Kaplan-Meier analysis and Cox regression. For 18 patients with complete dynamic sampling, metagenomic sequencing and untargeted metabolomics were performed. Microbial alpha/beta diversity, differential taxa abundance, and dynamic trajectory types (U-shaped vs. inverted U-shaped) were analyzed. Metabolite differences between responders and non-responders were identified via UHPLC-MS, followed by correlation analysis between specific microbial taxa and metabolites.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::428346e86e6d583a8d61c3e7afcfbc34468a8be171019d3232646d817467a9a0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::71d7f2e46faa7a2d2f739d598ec1279487df9952639d650a8ac15b8f0f12333b",
      "multiple_values_in_field": false
    },
    "atom::21b032f497e11ad82f077478": {
      "atom_id": "atom::21b032f497e11ad82f077478",
      "source_handle": "P0205",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides the first multi-omics characterization of gut microbiota and metabolites in EGFR+ NSCLC patients undergoing ICI therapy, identifying distinct microbial and metabolic signatures different from those reported in EGFR- NSCLC.",
        "limits": "Single-center study with a small sample size for omics analysis (n=18). Observational design limits causal inference. The lack of Akkermansia muciniphila as a predictor suggests population-specific or subtype-specific differences that require validation in larger cohorts."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::428346e86e6d583a8d61c3e7afcfbc34468a8be171019d3232646d817467a9a0",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::bc17f9e679533b5436e4439ad4af80c678cc072751123e6d75ecfa1a3dd7cff1",
      "multiple_values_in_field": false
    },
    "atom::f31eb3ef8495f0907f8d0857": {
      "atom_id": "atom::f31eb3ef8495f0907f8d0857",
      "source_handle": "P0205",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Advanced EGFR+ NSCLC patients treated with ICIs",
        "finding": "Antibiotic use (within 2 months before/after ICI initiation) was significantly associated with shorter progression-free survival (mPFS 4.8 vs. 6.7 months; HR 3.18) and overall survival. Probiotic use had no significant impact on PFS or OS."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::428346e86e6d583a8d61c3e7afcfbc34468a8be171019d3232646d817467a9a0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::aac53502cd0091ddb58c113f9ce6097f34c7b9208ebe03e44e4a55f7a8f05da6",
      "multiple_values_in_field": true
    },
    "atom::b00cd4addabe5f051094b7ec": {
      "atom_id": "atom::b00cd4addabe5f051094b7ec",
      "source_handle": "P0205",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Comparison of responders vs. non-responders based on metagenomic sequencing",
        "finding": "No significant difference in baseline alpha or beta diversity. Responders were enriched in Bradyrhizobium guangdongense, Plantactinospora sp., Corynebacterium stationis, and Methanococcus vannielii. Non-responders were enriched in Nocardioides sp., Candidatus thioglobus sp., Burkholderia anthina, and Brachybacterium sp. Notably, known beneficial species like Akkermansia muciniphila were not found to be predictive in this cohort."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::428346e86e6d583a8d61c3e7afcfbc34468a8be171019d3232646d817467a9a0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::aac53502cd0091ddb58c113f9ce6097f34c7b9208ebe03e44e4a55f7a8f05da6",
      "multiple_values_in_field": true
    },
    "atom::2321908271fcad576e47dcec": {
      "atom_id": "atom::2321908271fcad576e47dcec",
      "source_handle": "P0205",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Dynamic changes in gut microbiota over time (Baseline -> Response -> Progression)",
        "finding": "Two dynamic patterns were identified in the 18 longitudinally sampled patients: 'U-type' (abundance decreased at response, increased at progression, e.g., Enterococcus gallinarum) and 'Inverted U-type' (abundance increased at response, decreased at progression, e.g., Mycobacterium paragordonae)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::428346e86e6d583a8d61c3e7afcfbc34468a8be171019d3232646d817467a9a0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::aac53502cd0091ddb58c113f9ce6097f34c7b9208ebe03e44e4a55f7a8f05da6",
      "multiple_values_in_field": true
    },
    "atom::2d378659198997c365edf5df": {
      "atom_id": "atom::2d378659198997c365edf5df",
      "source_handle": "P0205",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Metabolomic profiling of responders vs. non-responders",
        "finding": "Responders showed enrichment of deoxycholic acid, glycerol, and quinolinic acid. Non-responders showed enrichment of L-citrulline. Significant correlations were observed between specific microbial taxa and these metabolites."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::428346e86e6d583a8d61c3e7afcfbc34468a8be171019d3232646d817467a9a0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::aac53502cd0091ddb58c113f9ce6097f34c7b9208ebe03e44e4a55f7a8f05da6",
      "multiple_values_in_field": true
    },
    "atom::399aa4789f191d531f10450c": {
      "atom_id": "atom::399aa4789f191d531f10450c",
      "source_handle": "P0205",
      "field_path": [
