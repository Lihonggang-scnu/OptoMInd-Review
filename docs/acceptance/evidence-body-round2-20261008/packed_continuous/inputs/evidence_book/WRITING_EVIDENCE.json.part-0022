        "possible_uses"
      ],
      "value": "用于综述中探讨“微生物组生态结构”而非单一物种在介导ICI疗效中的作用机制。提供网络生态学视角的证据。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::47e2448e8e3eccf240f83fc0904018562d3ef84b13632f88ba5b761eddc719ad",
      "multiple_values_in_field": true
    },
    "atom::dca49d80e01fef93b6041699": {
      "atom_id": "atom::dca49d80e01fef93b6041699",
      "source_handle": "P0443",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "代谢通路数据仅来自子集。F/B比率的具体生物学机制未在本研究中深入阐明。",
        "contribution": "分析了代谢通路（如氨基酸合成、发酵）与PD-L1表达的联系，以及厚壁菌/拟杆菌比率（F/B ratio）与短PFS的联系。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "3"
          ]
        }
      ],
      "variant_group": "field::6afceca2b41eb460d5fed75ae0ee855762f16cff547664af130260313b3556da",
      "multiple_values_in_field": true
    },
    "atom::63df6cfdff1322e1875aeaa1": {
      "atom_id": "atom::63df6cfdff1322e1875aeaa1",
      "source_handle": "P0443",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论微生物代谢功能如何可能影响宿主免疫微环境或肿瘤抗原呈递。F/B比率的发现可与既往炎症或代谢紊乱文献联系。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
          "field_path": [
