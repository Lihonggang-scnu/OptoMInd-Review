    "atom::31cba66826bdd392741dbc24": {
      "atom_id": "atom::31cba66826bdd392741dbc24",
      "source_handle": "P0415",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "研究设计为前瞻性观察性队列研究。收集27例黑色素瘤患者治疗前粪便样本，分别进行16S rRNA基因测序（V4区）和鸟枪法宏基因组测序。其中17例样本因RNA质量合格进一步进行宏转录组测序。统计分析方面，使用Cox比例风险模型调整协变量（年龄、性别、BMI、分期等），评估α多样性、β多样性聚类及特定分类单元/功能通路与PFS的关联。采用500次×10折交叉验证的弹性网络惩罚Cox回归筛选显著相关的特征。宏转录组部分，计算基因家族、反应和通路的相对表达量，并与宏基因组丰度进行Spearman相关性分析，以确认功能的转录活性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3778ce1ca15de297b1179ec8beedd6224fa11a42cd0c042b68ed4968b0882fff",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::ab4569226c5aa2d54ef2c9d9d4a39951d171a71086dc1040fbe8c6e19360f984",
      "multiple_values_in_field": false
    },
    "atom::ee7c7106cfc2e786d4d2e4a4": {
      "atom_id": "atom::ee7c7106cfc2e786d4d2e4a4",
      "source_handle": "P0415",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了在人类黑色素瘤患者中，肠道微生物组成、特定物种及宏基因组功能通路（含转录表达）与免疫治疗无进展生存期关联的证据；首次在同一研究中整合宏基因组与宏转录组数据以关联临床预后。",
        "limits": "样本量较小（n=27，宏转录组n=17）；未能单独分析辅助治疗与转移性患者亚组，也未能按免疫治疗类型（单药vs联合）分层分析；宏转录组分析因样本量限制统计效力不足；结果可能存在队列特异性，需更大规模研究验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3778ce1ca15de297b1179ec8beedd6224fa11a42cd0c042b68ed4968b0882fff",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::9f4591c28ec8245544f6f2aaf9ab3300986f6b2063f51b00f524edf98f832f7c",
      "multiple_values_in_field": false
    },
    "atom::24acf74201156137d9b43346": {
      "atom_id": "atom::24acf74201156137d9b43346",
      "source_handle": "P0415",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "27例黑色素瘤患者，调整协变量后",
        "finding": "较高的微生物群落丰富度（16S s-OTU数和鸟枪法子物种数）与较长的无进展生存期（PFS）显著相关（p < 0.05）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3778ce1ca15de297b1179ec8beedd6224fa11a42cd0c042b68ed4968b0882fff",
