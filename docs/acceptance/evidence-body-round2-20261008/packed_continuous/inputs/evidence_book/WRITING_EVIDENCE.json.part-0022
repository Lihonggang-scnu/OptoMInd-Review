    "atom::4cbcd1bdd69fde55c51229cf": {
      "atom_id": "atom::4cbcd1bdd69fde55c51229cf",
      "source_handle": "P0200",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "1. 纵向数据采集：对92名接受pembrolizumab治疗的晚期NSCLC患者进行串行样本采集。2. 多组学分析：对患者样本进行肠道微生物组测序、RNA-seq和WES分析。3. 对照比较：将患者微生物数据与92名健康对照进行比较，分析免疫治疗期间的微生物特征变化。4. 队列整合与验证：结合内部队列与728例公开ICI治疗队列数据，开发用于分类ICI反应的评分。5. 评分优化：基于响应者与非响应者相关微生物标记物的比率构建跨人群评分，并与TMB联合评估其分层能力。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f785f081b25b8053f6af6b58613af5861dcbbb53a0f17057ede57f2380121f1e",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::83a4e46f5df8da4f7e64b34d0ec0c0464b9bdbf0c37825bdf5a2460a7ef6b58d",
      "multiple_values_in_field": false
    },
    "atom::9234bfeff0816e566ab0c7f0": {
      "atom_id": "atom::9234bfeff0816e566ab0c7f0",
      "source_handle": "P0200",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了纵向多组学证据，明确了特定菌群（Faecalibacterium vs Lactobacillus/Escherichia）与NSCLC患者ICI疗效的关联，并揭示了微生物失调随治疗和进展的动态轨迹。",
        "limits": "所给摘要未交代具体的统计模型细节、多组学数据整合的具体算法、以及TMB联合评分在不同亚组中的具体性能指标（如AUC值）。此外，相关性不等于因果性，饮食和抗生素的影响需进一步控制混杂因素验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f785f081b25b8053f6af6b58613af5861dcbbb53a0f17057ede57f2380121f1e",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::f6fa55cbb46c3499552b60ebeb3a6b3dbb47de4df93f1ed37744ba4752849b44",
      "multiple_values_in_field": false
    },
    "atom::0f5f3ff45c44d58bc524af1f": {
      "atom_id": "atom::0f5f3ff45c44d58bc524af1f",
      "source_handle": "P0200",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在92名NSCLC患者队列中，根据RECIST标准定义的反应者（CR/PR或SD≥6个月）与非反应者对比",
        "finding": "反应者富集Faecalibacterium属，非反应者富集Lactobacillus和Escherichia属；这些菌群的丰度与膳食纤维摄入和抗生素使用存在特定关联。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f785f081b25b8053f6af6b58613af5861dcbbb53a0f17057ede57f2380121f1e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::be31f2404f1e080786014991fdc31940c3e210de630cada7f047aa4c39016dda",
      "multiple_values_in_field": true
    },
    "atom::f962de69aff3170c50d46d9f": {
      "atom_id": "atom::f962de69aff3170c50d46d9f",
      "source_handle": "P0200",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "纵向观察治疗期间及疾病进展时的微生物失调动态",
        "finding": "在治疗后，仅反应者的微生物特征与健康队列的差异性降低；而在疾病进展时，无论反应者还是非反应者，其与正常队列的差异性均增加。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f785f081b25b8053f6af6b58613af5861dcbbb53a0f17057ede57f2380121f1e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::be31f2404f1e080786014991fdc31940c3e210de630cada7f047aa4c39016dda",
      "multiple_values_in_field": true
    },
    "atom::dbab987f2615c8ecf70dc648": {
      "atom_id": "atom::dbab987f2615c8ecf70dc648",
      "source_handle": "P0200",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "利用内部队列和728例公共ICI队列数据开发的跨人群评分",
        "finding": "该评分基于响应者/非响应者相关微生物标记物比率，与反映肠道微生物健康状态的指数呈显著正相关；当与肿瘤突变负荷（TMB）结合时，提高了ICI疗效的分层准确性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f785f081b25b8053f6af6b58613af5861dcbbb53a0f17057ede57f2380121f1e",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::be31f2404f1e080786014991fdc31940c3e210de630cada7f047aa4c39016dda",
      "multiple_values_in_field": true
    },
