          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::9a5ce5fe43098dcda6b8ed283d752bf00780e8c18d1b34696c9053c5d3281288",
      "multiple_values_in_field": false
    },
    "atom::abc522398739e5d4c58fea4c": {
      "atom_id": "atom::abc522398739e5d4c58fea4c",
      "source_handle": "P0134",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "主要问题：目前缺乏有效的非侵入性生物标志物来早期识别对PD-1/PD-L1阻断疗法有反应的NSCLC患者，且基线微生物组与疗效的关系尚不明确。具体动机：尽管已知抗生素使用影响ICI疗效，但治疗过程中肠道微生物组的组成变化及其与疗效的具体关系仍不清楚。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::6580b1a75967cfe09cad22a433ab885d6a27eed993703b5b9d53cac689062262",
      "multiple_values_in_field": false
    },
    "atom::e2d15979eaa156c5f0e78cb3": {
      "atom_id": "atom::e2d15979eaa156c5f0e78cb3",
      "source_handle": "P0134",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "研究对象为接受抗PD-1免疫治疗（单药或联合化疗）的III期至IV期非小细胞肺癌（NSCLC）患者。研究情境为Roswell Park Comprehensive Cancer Center的前瞻性队列，样本量为5名患者（3名响应者，2名无响应者）。范围聚焦于治疗前及早期治疗期间粪便样本中肠道微生物组的动态变化及其与临床疗效的关系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::7e8ca2360436410d08dea2ceba5cc5bbe10321d6eaf1298f019fa2a836ad9601",
      "multiple_values_in_field": false
    },
    "atom::38d2935668ccaa759a6b6432": {
      "atom_id": "atom::38d2935668ccaa759a6b6432",
      "source_handle": "P0134",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在探索肠道微生物组在治疗过程中的动态变化是否能作为预测非小细胞肺癌患者对PD-1抑制剂反应的非侵入性生物标志物。鉴于基线微生物组特征和肿瘤组织PD-L1表达的预测价值有限，作者分析了5名患者的配对粪便样本，通过16S rRNA测序比较响应者与无响应者在治疗前后的微生物多样性及组成差异。研究发现，虽然基线α多样性在两组间无显著差异，但响应者在治疗期间的微生物多样性发生了显著改变，而无响应者则相对稳定或呈现不同的菌群演变模式。这表明治疗期间的微生物组波动可能与免疫治疗的疗效相关。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::056712c37f5aafee2025f85dda3fe018d7b69a3cc39d88fd538286695b0f5961",
      "multiple_values_in_field": false
    },
    "atom::eb0902ec8fabe4b638125f57": {
      "atom_id": "atom::eb0902ec8fabe4b638125f57",
      "source_handle": "P0134",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于“治疗期间肠道微生物组动态”而非仅“基线静态特征”的关键实证素材。它直接回应了综述中关于微生物组如何随治疗进程演变的子问题，特别是通过对比响应者与无响应者的不同演变轨迹（波动vs稳定/恶化），为理解微生物组作为动态监测生物标志物的潜力提供了具体证据。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::0362d1fcc003e76e67405ebc739fef5b8bdfdeb4f0143c08d3acc3d65e47b942",
      "multiple_values_in_field": false
    },
    "atom::60bb2b4a9aa9df9db01788b3": {
      "atom_id": "atom::60bb2b4a9aa9df9db01788b3",
      "source_handle": "P0134",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限NSCLC人群，样本量小（N=5），且混合了单药与联合化疗方案，结果的外推需谨慎。不能证明因果关系，仅为关联观察。",
        "contribution": "提供了具体的临床观察证据：在NSCLC患者中，治疗期间肠道微生物组的显著变化（波动）与抗PD-1治疗的响应正相关，而稳定的或特定菌属（如Akkermansia减少）的变化与无响应相关。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::8b0f816532bff6f344d5ca0640a754569dbc6bb1dd5a6bdc671b5d2cc0aeb81d",
      "multiple_values_in_field": true
    },
