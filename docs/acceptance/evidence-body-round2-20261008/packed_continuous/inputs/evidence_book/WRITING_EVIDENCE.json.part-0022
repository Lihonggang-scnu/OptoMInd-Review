            "0"
          ]
        }
      ],
      "variant_group": "field::cb1fa78458318185aec3d97f0297d9dd57d9d396656a4e1dca4d617367ab2e99",
      "multiple_values_in_field": true
    },
    "atom::7c08b5b30129cb6f77057f42": {
      "atom_id": "atom::7c08b5b30129cb6f77057f42",
      "source_handle": "P0227",
      "field_path": [
