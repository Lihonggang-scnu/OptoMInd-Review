    "atom::174dac331c10482c9b499eeb": {
      "atom_id": "atom::174dac331c10482c9b499eeb",
      "source_handle": "P0485",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "CD56/CD20表达与微生物组之间的直接因果联系未在摘要中证实，仅为并行观察到的现象；机制解释尚不明确，需进一步实验验证。",
        "contribution": "提示了微生物组可能与肿瘤微环境免疫状态相关联，表现为响应者中CD56和CD20表达升高。同时指出了不同原发部位MM具有不同的突变签名（如MMR缺陷 vs UV损伤），这可能间接影响免疫原性和微生物组互作。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ddae59555ff66f6d76f4f5d45ea66eaa810856dd20f158371ed493cf2234506c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::da952bcded933c88427264ef20889d2318f20200755863d7a0caa4903f392c7b",
      "multiple_values_in_field": true
    },
    "atom::72eb67235f55bae163a8ea22": {
      "atom_id": "atom::72eb67235f55bae163a8ea22",
      "source_handle": "P0485",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于探讨介导效应的潜在机制线索，即微生物组可能通过塑造局部免疫微环境（如NK细胞或B细胞浸润，由CD56/CD20指示）来影响ICI疗效。也可用于解释不同解剖部位MM对ICI反应率低的生物学基础差异。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::ddae59555ff66f6d76f4f5d45ea66eaa810856dd20f158371ed493cf2234506c",
          "field_path": [
