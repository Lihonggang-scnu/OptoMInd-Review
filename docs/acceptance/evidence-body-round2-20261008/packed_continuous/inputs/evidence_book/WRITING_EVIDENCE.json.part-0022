      "multiple_values_in_field": true
    },
    "atom::feeef6f1df4ea05728330825": {
      "atom_id": "atom::feeef6f1df4ea05728330825",
      "source_handle": "P0443",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "基于随机森林模型，可能存在过拟合风险，尽管使用了交叉验证。代谢通路分析样本量较小（n=37）。",
        "contribution": "提供了微生物组特征预测效能的量化数据。分类学特征预测PFS的AUC为0.74，代谢通路预测PD-L1的AUC为0.87。同时指出α-多样性在此场景下无预测价值。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::5e5e3399117dd84e4073c31875ff803ede933ad796c2326901f89f126369b513",
          "field_path": [
