      "multiple_values_in_field": true
    },
    "atom::f307c3fd8cec224c5044afd6": {
      "atom_id": "atom::f307c3fd8cec224c5044afd6",
      "source_handle": "P0333",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to support arguments about the heterogeneity of microbiome-ICI interactions and the lack of a universal 'good' microbiome signature. Provides specific examples of taxa to discuss in the context of patient stratification.",
      "role": "planning",
      "origins": [
        {
