    "atom::cbe5d95acd9ad45b5d33eee2": {
      "atom_id": "atom::cbe5d95acd9ad45b5d33eee2",
      "source_handle": "P0134",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "仅有一个治疗时间点样本，无法区分短期波动与长期趋势。",
      "role": "evidence",
