    },
    "atom::8be25514637782d7f88627e5": {
      "atom_id": "atom::8be25514637782d7f88627e5",
      "source_handle": "P0415",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "宏基因组与宏转录组联合分析（n=17子集）",
        "finding": "识别出与PFS相关且具有显著转录表达的宏基因组通路：风险相关通路包括L-鼠李糖降解、鸟苷核苷酸生物合成、B族维生素（泛酸、吡哆醛-5-磷酸、黄素、叶酸前体）生物合成；保护相关通路包括L-异亮氨酸生物合成。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3778ce1ca15de297b1179ec8beedd6224fa11a42cd0c042b68ed4968b0882fff",
