      "atom_id": "atom::bbd39bf7c3726542c7921837",
      "source_handle": "P0327",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论宿主-微生物互作机制时，说明肠道屏障完整性作为单一维度的局限性，以及当前生物标志物开发的标准化困境。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2a114ae43a5c751a14df5a8e270999da7ff4923334ffd580fde228b8e8bbffd1",
