abcdef78a8ded00f73a010e9bbb7074db4dad91727051",
      "multiple_values_in_field": false
    },
    "atom::273d7874853b203d758cd3d6": {
      "atom_id": "atom::273d7874853b203d758cd3d6",
      "source_handle": "P0569",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "作为背景或对比案例，说明在不同治疗阶段（新辅助vs晚期）或不同疾病进展状态下，微生物组与免疫治疗反应的关联可能存在的差异。有助于避免将晚期NSCLC的结论简单外推至所有NSCLC场景。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2c10f66e656b13b1d08f07b21f5974af1eb5f51d99874e2c3d45338c713e4ade",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "0",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::a951bf927a6db85c6be867779a7fc5b5533104f1158eae2d33b7b4b3ad9db440",
      "multiple_values_in_field": false
    },
    "atom::4e7ac253237edc51757cfa09": {
      "atom_id": "atom::4e7ac253237edc51757cfa09",
      "source_handle": "P0569",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究针对的是早期可切除NSCLC的新辅助治疗，其结论不能直接推广到晚期转移性NSCLC的一线治疗或其他实体瘤。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2c10f66e656b13b1d08f07b21f5974af1eb5f51d99874e2c3d45338c713e4ade",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::799560fde00a847415b2f36d58ede37f1334c318ac7655eb9365fc34c599f4fe",
      "multiple_values_in_field": true
    },
    "atom::b038ba0b74ad1088927cbfb0": {
      "atom_id": "atom::b038ba0b74ad1088927cbfb0",
      "source_handle": "P0569",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "基线Alpha多样性与预后的负相关（低多样性对应好预后）可能与部分晚期NSCLC研究中观察到的正相关（高多样性对应好预后）存在差异，需考虑疾病阶段、治疗强度及宿主状态的差异，不可简单视为矛盾，而应视为情境依赖的特征。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2c10f66e656b13b1d08f07b21f5974af1eb5f51d99874e2c3d45338c713e4ade",
          "field_path": [
