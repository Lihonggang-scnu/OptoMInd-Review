    "atom::3b21a9898ddc6755867ded4a": {
      "atom_id": "atom::3b21a9898ddc6755867ded4a",
      "source_handle": "P0590",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "针对FMT及其他微生物疗法",
        "finding": "FMT在黑色素瘤等实体瘤中改善免疫检查点抑制剂疗效有初步证据，但在CRC中仅限小规模无对照试验，存在安全性和生态稳定性风险；益生菌和工程菌主要处于临床前阶段；抗生素暴露与CRC风险增加相关，不建议作为预防或治疗手段。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::b027266378a52b2c51ee323b99a07f7e776a0db3b5e6d39a414202d36fdad833",
