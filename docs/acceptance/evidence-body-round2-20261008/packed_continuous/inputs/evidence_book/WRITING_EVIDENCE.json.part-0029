    "atom::6befe43108931f970e929b2e": {
      "atom_id": "atom::6befe43108931f970e929b2e",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "As a review article, this work does not present new primary experimental data but synthesizes existing literature. The authors systematically summarize findings from retrospective clinical studies, prospective cohorts, and preclinical murine models regarding the correlation between gut microbiota composition (diversity, specific taxa like Faecalibacterium, Bifidobacterium, Bacteroides) and ICPI outcomes. They integrate mechanistic insights from immunology (T-cell regulation, dendritic cell maturation) and metabolism (short-chain fatty acids, bile acids). The approach involves categorizing evidence into themes: response prediction, toxicity mediation (colitis, myocarditis), antibiotic effects, and therapeutic manipulation (FMT, probiotics, synthetic biotics), supported by tables listing relevant clinical trials.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::295c85b15c871b6a01133bc43a65ee1025b3712dbef8e9ab469e98bacfcbf67d",
      "multiple_values_in_field": false
    },
    "atom::c5f0af15908b0603befc98d6": {
      "atom_id": "atom::c5f0af15908b0603befc98d6",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive synthesis of the dual role of the gut microbiome in determining both the efficacy and toxicity of ICPIs in solid tumors. It integrates clinical associations with mechanistic hypotheses (immunological and metabolic) and maps the landscape of ongoing clinical trials for microbiome-based therapies.",
        "limits": "As a narrative review, it does not perform a systematic meta-analysis or provide quantitative pooled estimates. The mechanistic explanations are largely derived from preclinical models or correlative human studies, so causal relationships remain to be fully validated in large-scale randomized controlled trials. The review acknowledges heterogeneity in findings across different cancer types and geographic populations."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::5575a35a2c62a5d7ea8cb881f690c238b6fdbe5bb9f25e05ee573767370a15bb",
      "multiple_values_in_field": false
    },
    "atom::01f63df59d963a0044ad8942": {
      "atom_id": "atom::01f63df59d963a0044ad8942",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Solid tumor patients receiving ICPIs (anti-PD-1/PD-L1, anti-CTLA-4)",
        "finding": "Loss of microbial diversity (dysbiosis) and enrichment of certain bacteria (e.g., Faecalibacterium, Akkermansia, Bifidobacterium) are associated with improved objective response rates and survival, while depletion of these taxa or enrichment of others (e.g., Bacteroides) correlates with poor response."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::50f7723628de0236decf07fd87f03628640824178223e0a2caead101507ce984",
      "multiple_values_in_field": true
    },
    "atom::d4337ee1dd2b52b96d4bd29a": {
      "atom_id": "atom::d4337ee1dd2b52b96d4bd29a",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Patients treated with broad-spectrum antibiotics prior to or during ICPI therapy",
        "finding": "Antibiotic use is consistently associated with reduced overall survival and progression-free survival, likely due to disruption of beneficial gut microbiota; narrow-spectrum antibiotics show less clear detrimental effects."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::50f7723628de0236decf07fd87f03628640824178223e0a2caead101507ce984",
      "multiple_values_in_field": true
    },
    "atom::0cdc25ae78468f915b4f1e1c": {
      "atom_id": "atom::0cdc25ae78468f915b4f1e1c",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Development of immune-related adverse events (irAEs), particularly colitis and myocarditis",
        "finding": "Specific bacterial strains influence irAE risk; e.g., Faecalibacterium enrichment is linked to higher incidence of colitis but better tumor response, while Bacteroidetes may protect against colitis. Mechanisms involve cross-reactive T-cells primed by bacterial peptides (e.g., beta-galactosidase from Bacteroides) targeting host tissues (e.g., MYH6 in heart)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::50f7723628de0236decf07fd87f03628640824178223e0a2caead101507ce984",
      "multiple_values_in_field": true
    },
    "atom::b8a5d96c854e7ba7964eeaa9": {
      "atom_id": "atom::b8a5d96c854e7ba7964eeaa9",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Preclinical and early-phase clinical trials of microbiome modulation",
        "finding": "Interventions such as FMT, oral live biotherapeutics (e.g., EDP1503, SER-401), and synthetic biotics are being tested to restore microbiome diversity or introduce beneficial strains, showing preliminary promise in enhancing ICPI efficacy or managing refractory colitis."
      },
      "role": "evidence",
      "origins": [
        {
