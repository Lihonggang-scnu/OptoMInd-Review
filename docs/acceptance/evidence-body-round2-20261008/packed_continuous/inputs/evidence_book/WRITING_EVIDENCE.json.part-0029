      "source_handle": "P0244",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限 Part A 的前 5 对样本分析，未涉及与免疫检查点抑制剂（ICI）联合用药的实际疗效数据。",
        "contribution": "提供了 MRx0518 在实体瘤患者中诱导免疫相关基因表达变化的初步人体数据。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
