    "atom::049ede7d62eda5eb108ee766": {
      "atom_id": "atom::049ede7d62eda5eb108ee766",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a critical resource for understanding how natural polysaccharides modulate the gut microbiome to influence ICI efficacy in solid tumors. It provides detailed mechanistic insights into the bidirectional crosstalk between polysaccharide-derived metabolites (SCFAs, indole derivatives) and host immunity, along with a structured analysis of translational challenges and future technological interventions.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::7e7dab2a9433ed5f6279ad6aef986b7be376bd8505d6e53d0a17d26cca45cbae",
      "multiple_values_in_field": false
    },
    "atom::3eefb31b9abaa8d1b9d67ad1": {
      "atom_id": "atom::3eefb31b9abaa8d1b9d67ad1",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review focuses on natural polysaccharides; do not generalize findings to all prebiotics or dietary fibers without specifying the polysaccharide type.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::938d9f6db6dccb7c9af0753f9c60fd5d93540058c4da6487102c672d212d9204",
      "multiple_values_in_field": true
    },
    "atom::f2c5255f64a830040e1f35d7": {
      "atom_id": "atom::f2c5255f64a830040e1f35d7",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Clinical evidence is primarily from early-phase trials or real-world retrospective studies; avoid overstating efficacy as if confirmed by Phase III RCTs.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
