    "atom::e16271ee6436c84aa68cc464": {
      "atom_id": "atom::e16271ee6436c84aa68cc464",
      "source_handle": "P0304",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "综述详细分析了纳入研究在OS/PFS定义上的不一致性，以及FMT研究中随机化困难、样本量小、合并用药（免疫抑制剂）带来的偏倚风险。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::235e35281eb4c1f2e906be101098a861f880c661131e23e0f6ff09d6bbcc5d03",
          "field_path": [
