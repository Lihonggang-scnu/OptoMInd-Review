    "atom::a820b4e3b48d5a4789dc4f56": {
      "atom_id": "atom::a820b4e3b48d5a4789dc4f56",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To synthesize existing evidence regarding how the gut microbiome influences lung cancer pathogenesis and treatment efficacy, particularly in the context of immune checkpoint inhibitors (ICIs), and to identify potential therapeutic strategies and biomarkers derived from this interaction.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::f882409550b39784f93eb46f120cb0dc741da5889141d3448fa724e0b341ee51",
      "multiple_values_in_field": false
    },
    "atom::ff2426568d2acbf08a5a2f34": {
      "atom_id": "atom::ff2426568d2acbf08a5a2f34",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the gut-lung axis in the context of lung cancer, specifically examining non-small cell lung carcinoma (NSCLC) and small cell lung carcinoma. It covers pathogenesis, early detection biomarkers, mechanisms of immune modulation, and therapeutic interventions including immunotherapy response prediction and microbiota-targeted treatments.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::da4e96025178db2773ca52d33e98f6d6316c1da2d81e7c94a56c320240d0c4d8",
      "multiple_values_in_field": false
    },
    "atom::d82e26dfd79d7f969e7a4466": {
      "atom_id": "atom::d82e26dfd79d7f969e7a4466",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This is a narrative review synthesizing current knowledge on the role of the gut microbiome in lung cancer development, diagnosis, and treatment. It outlines the bidirectional communication between intestinal microbiota and pulmonary health via immune, neural, and metabolic pathways. The paper highlights microbial signatures predictive of disease and therapy response, discusses microbiota-targeted interventions such as probiotics and fecal microbiota transplantation (FMT), and elucidates mechanistic insights into microbial-immune crosstalk. It aims to provide a comprehensive framework for leveraging the gut microbiome in personalized lung cancer management.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::eaa2e571cc5e2ae57d3ddf23b9974f856f93c511721b1287d8547c4c4b2805c7",
      "multiple_values_in_field": false
    },
    "atom::9ff89be6d74870f143974c9a": {
      "atom_id": "atom::9ff89be6d74870f143974c9a",
      "source_handle": "P0297",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a foundational resource for understanding the gut-lung axis in lung cancer, particularly its impact on immunotherapy efficacy. It provides detailed descriptions of microbial signatures associated with ICI response, mechanistic pathways involving metabolites and immune cells, and emerging therapeutic strategies. It is highly relevant for facets concerning how the microbiome modulates ICI efficacy and the underlying mechanisms.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::47a2a8111e1ac6a65aa47a50f413f35f162dbd77eea36eaec55c8fe3901d04db",
      "multiple_values_in_field": false
    },
    "atom::9d858348408b4d384f36bfad": {
      "atom_id": "atom::9d858348408b4d384f36bfad",
      "source_handle": "P0297",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Focuses primarily on lung cancer; while it mentions other cancers briefly, the detailed evidence is lung-specific. Causal inference is limited to observational associations and preclinical models.",
        "contribution": "Details the correlation between specific gut microbiota compositions (e.g., A. muciniphila, SCFA-producing bacteria) and improved clinical outcomes in solid tumors treated with ICIs. It also notes that antibiotic use negatively impacts ICI efficacy.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::48b2033b37af48eb9944f0e3182aa396e366008bc0b2e08c7d04d7e63fba6abd",
      "multiple_values_in_field": true
    },
    "atom::3775041f312d12d055377465": {
      "atom_id": "atom::3775041f312d12d055377465",
      "source_handle": "P0297",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to support arguments about the positive or negative influence of specific microbial taxa on ICI efficacy in solid tumors. Provides examples of predictive biomarkers.",
      "role": "planning",
      "origins": [
