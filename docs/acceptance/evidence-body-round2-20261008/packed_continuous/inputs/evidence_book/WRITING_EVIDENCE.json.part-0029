    "atom::4ccc398d5ad7381abec37394": {
      "atom_id": "atom::4ccc398d5ad7381abec37394",
      "source_handle": "P0178",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用定义菌群（如SER-401）及抗生素预处理",
        "finding": "一项针对黑色素瘤的Ib期试验因入组不足未能得出效力结论，但揭示了广谱抗生素预处理可能破坏保护性免疫准备，提示“清除后添加”策略存在设计陷阱。"
      },
      "role": "evidence",
      "origins": [
