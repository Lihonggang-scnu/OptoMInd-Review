    "atom::757541f80ab481e594311373": {
      "atom_id": "atom::757541f80ab481e594311373",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Most evidence is preclinical (mouse models) or from small early-phase human trials; causal links in humans are inferred from FMT experiments and observational cohorts.",
        "contribution": "Details the role of gut microbiota in mediating ICI response, specifically highlighting how polysaccharides remodel microbial composition (enriching Akkermansia, Bifidobacterium) and metabolite profiles (increasing SCFAs like butyrate and propionate) to enhance anti-tumor immunity.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::c23aa72c1bdbd644669002afcfb2c08c264262dd2e1478e3b2f695105e1de765",
      "multiple_values_in_field": true
    },
    "atom::2aa0b1126d9231afd4fd12cf": {
      "atom_id": "atom::2aa0b1126d9231afd4fd12cf",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to explain the mechanism by which dietary or supplemental polysaccharides sensitize cold tumors to ICIs via microbiota-dependent pathways.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
