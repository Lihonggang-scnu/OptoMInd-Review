    "atom::3182795180c617396619901f": {
      "atom_id": "atom::3182795180c617396619901f",
      "source_handle": "P0125",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些机制描述来源于体外和动物模型的前体研究，而非本临床试验的直接发现。本摘要未提供本研究中实际观察到的机制关联数据。",
        "contribution": "介绍了 MRx0518 的拟议作用机制基础（基于前体研究：减少 Treg，增加 Th1/Tc1，增加肿瘤内 CD4+/CD8+ T 细胞和 NK 细胞）。列出了探索性生物标志物收集计划（血液、粪便、组织活检以评估免疫标记和微生物组）。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f63dfcb79a3ed06be7080d88b99e3f72f53931346bcc56ffcc4727bbc5001373",
          "field_path": [
