    "atom::196087d6710c5931c288f77f": {
      "atom_id": "atom::196087d6710c5931c288f77f",
      "source_handle": "P0244",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于解释肠道微生物疗法如何在人体内启动免疫反应，作为 ICI 疗效调节的背景机制之一。说明 LBP 可能通过直接激活固有或适应性免疫通路来增强抗肿瘤免疫。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
