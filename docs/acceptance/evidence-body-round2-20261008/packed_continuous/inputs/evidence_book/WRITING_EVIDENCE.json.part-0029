      ],
      "value": {
        "conditions": "抗PD-1难治性转移性黑色素瘤",
        "finding": "来自反应者的粪菌移植（FMT）提供了最强的人类概念验证，部分患者实现了临床再敏感化，并伴随供体型微生物特征和肿瘤免疫重塑。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::092a7ef81b878efa4c53c58a11ff6f9701f5421d3f37c7aa1c70cf48d8c64277",
