    "atom::c832fc4e8d623472abd78964": {
      "atom_id": "atom::c832fc4e8d623472abd78964",
      "source_handle": "P0244",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用单臂、开放标签的早期临床试验设计。纳入标准：组织学确诊的实体瘤、计划进行手术切除、初治患者。干预措施：口服 MRx0518（1x10^10 至 1x10^11 CFU），每日两次，持续至术前一天（最长28天）。数据收集：记录不良事件以评估安全性；收集治疗前（诊断性活检）和治疗后（手术标本）的配对样本，利用 NanoString Pan Cancer IO 360™ 基因表达面板进行转录组分析，同时计划进行微生物组和代谢组分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::d8ef54aa8b860890d8026c37124ea6262f2cc813a7bc5e37196274ecf0a4eaa1",
      "multiple_values_in_field": false
    },
    "atom::ee730c6fb553203920c4f1d3": {
      "atom_id": "atom::ee730c6fb553203920c4f1d3",
      "source_handle": "P0244",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了 MRx0518 在人类实体瘤患者中短期使用的安全性数据，证实了其良好的耐受性。",
        "limits": "样本量小（n=17），且仅分析了前 5 对样本的基因表达数据，缺乏统计效力来确立普遍性的免疫调节模式。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::0cc62c249eefc872ed29900b0a851e8db7b4f81e66fb4d969984f96071735f45",
      "multiple_values_in_field": true
    },
    "atom::6914591d6c7a033541c2ca5c": {
      "atom_id": "atom::6914591d6c7a033541c2ca5c",
      "source_handle": "P0244",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "初步证据表明 MRx0518 可能在体内诱导与临床前模型相似的免疫激活信号（基因表达变化）。",
        "limits": "基因表达变化的具体机制和功能后果尚未经过充分验证；未提供疗效（如肿瘤缩小）的直接证据，因为主要终点是安全性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::0cc62c249eefc872ed29900b0a851e8db7b4f81e66fb4d969984f96071735f45",
      "multiple_values_in_field": true
    },
    "atom::a662b667b1877fd96be85eae": {
      "atom_id": "atom::a662b667b1877fd96be85eae",
      "source_handle": "P0244",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "确立了在新辅助设置中使用配对活检样本评估微生物疗法对宿主免疫影响的方法学可行性。",
        "limits": "由于 COVID-19 疫情导致手术延迟，部分患者的治疗窗口可能受到影响，且后续 Part B 才包含安慰剂对照和更大规模的疗效评估。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::0cc62c249eefc872ed29900b0a851e8db7b4f81e66fb4d969984f96071735f45",
      "multiple_values_in_field": true
    },
    "atom::050ef7985358839115d23429": {
      "atom_id": "atom::050ef7985358839115d23429",
      "source_handle": "P0244",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Part A, n=17 (breast n=8, prostate n=4, uterine n=3, melanoma n=1, bladder n=1), treatment naive, solid tumours awaiting surgery",
        "finding": "MRx0518 单药治疗显示出良好的安全性和耐受性，未报告 3/4 级 CTCAE 毒性，无严重不良反应或治疗中断。所有患者均接受了手术（3例因新冠疫情延迟）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
