    "atom::ea60aed65bb9454bb5fc743c": {
      "atom_id": "atom::ea60aed65bb9454bb5fc743c",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "关于肠道微生物群的许多结论来自观察性研究或小样本试验，需谨慎推断因果关系；例如，饮食纤维的益处可能与整体健康生活方式有关，而非单一成分作用。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::385f3794ca3540e4c731b9953d8a72995b8023c7ccf2adf4fa5243e8c7009861",
      "multiple_values_in_field": true
    },
    "atom::3c4cf0377facebfc49c3301e": {
      "atom_id": "atom::3c4cf0377facebfc49c3301e",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "益生菌的效果具有高度的菌株特异性，综述中提到的矛盾结果（Spencer vs Bender）提示不能一概而论地推荐或禁止所有益生菌。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
