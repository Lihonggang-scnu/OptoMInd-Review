    "atom::94e57fc3b489cc0cf77510e9": {
      "atom_id": "atom::94e57fc3b489cc0cf77510e9",
      "source_handle": "P0143",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用回顾性分析设计，合并两项独立的I期随机临床试验数据。纳入接受nivo/ipi或cabo/nivo +/- CBM588治疗的mRCC患者。使用MetaPhlan v4进行分类学分析，计算Alpha和Beta多样性。利用Wilcoxon配对检验评估从基线到第12周临床相关微生物物种丰度的变化。计算Firmicutes/Bacteroidetes比率作为菌群失调的衡量指标，并比较SOC组与SOC/CBM组的差异。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::890fce072a8f724aaec9108f7e6fb477e88b3e6ebacc50fe6157574d9cf1fe81",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::01f48cdcbe8e48ddf45863f6f3aab07cdf202e0facdc716852152098304f0e26",
      "multiple_values_in_field": false
    },
    "atom::ab294fa19d5ef32aaf225ec4": {
      "atom_id": "atom::ab294fa19d5ef32aaf225ec4",
      "source_handle": "P0143",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了CBM588调节肠道微生物组的直接证据，特别是其能防止Eubacterium siraeum耗竭并纠正F/B比率升高，这可能与改善ICI疗效有关。",
        "limits": "仅基于两项I期试验的合并小样本（N=58）分析，缺乏长期随访和临床终点（如OS/PFS）的直接关联分析。未交代具体的统计校正方法（如多重比较校正）。所给摘要未交代微生物组变化与具体临床响应率之间的直接相关性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::890fce072a8f724aaec9108f7e6fb477e88b3e6ebacc50fe6157574d9cf1fe81",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::365acb2180554af83b75cbfa9ec75fac483fa323c9cae2d690503927d5d87a6f",
      "multiple_values_in_field": false
    },
