      ],
      "variant_group": "field::53b1922fa43638bd22a72f7ed51d353f70efdaebe099abed3fd5637d79696d20",
      "multiple_values_in_field": true
    },
    "atom::000bb7f76afc0e764242ec8f": {
      "atom_id": "atom::000bb7f76afc0e764242ec8f",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Mechanisms are often derived from in vitro or syngeneic mouse models; direct translation to human clinical outcomes is not fully validated.",
        "contribution": "Elaborates on the molecular mechanisms of polysaccharide-mediated immunomodulation, including TAM repolarization (M2 to M1), CD8+ T cell exhaustion reversal, and suppression of tumor-intrinsic escape (PD-L1 downregulation). Links these to specific structural motifs (triple helix, acetylation).",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::c23aa72c1bdbd644669002afcfb2c08c264262dd2e1478e3b2f695105e1de765",
      "multiple_values_in_field": true
    },
    "atom::47713722aa2226ca8ee8f6ed": {
      "atom_id": "atom::47713722aa2226ca8ee8f6ed",
      "source_handle": "P0152",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
