      "multiple_values_in_field": true
    },
    "atom::450256474c35f73fc1d99d21": {
      "atom_id": "atom::450256474c35f73fc1d99d21",
      "source_handle": "P0244",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制推断基于基因表达谱，而非直接的因果实验（如细胞因子测定或功能实验）。",
        "contribution": "揭示了 MRx0518 可能通过上调特定免疫基因（48个显著变化基因）来介导免疫刺激，支持其作为免疫佐剂的潜力。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
