    "atom::6daa6bf638fc0a586c155313": {
      "atom_id": "atom::6daa6bf638fc0a586c155313",
      "source_handle": "P0304",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "FMT的积极结果主要来源于小样本、单臂或开放标签研究，且部分患者在使用FMT前已接受过强效免疫抑制治疗，因此不能简单外推为FMT对所有ICI耐药患者的普适性解决方案。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::235e35281eb4c1f2e906be101098a861f880c661131e23e0f6ff09d6bbcc5d03",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::993878bef34945aca8c2211bd303d6e30e290a9e054645456c21106f2c5debd7",
      "multiple_values_in_field": true
    },
    "atom::03d903e6472f77e8ddd42f80": {
      "atom_id": "atom::03d903e6472f77e8ddd42f80",
      "source_handle": "P0304",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗生素的负面影响虽在多数研究中观察到，但存在例外（如Lalani, Balado等），这可能源于抗生素类型、给药时机或癌症类型的差异，需谨慎归因。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::235e35281eb4c1f2e906be101098a861f880c661131e23e0f6ff09d6bbcc5d03",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::993878bef34945aca8c2211bd303d6e30e290a9e054645456c21106f2c5debd7",
      "multiple_values_in_field": true
    },
    "atom::75b33df0d637c35db8e354cf": {
      "atom_id": "atom::75b33df0d637c35db8e354cf",
      "source_handle": "P0304",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "综述未进行Meta分析，因此提供的效应方向是定性的，缺乏统一的效应量估计。",
