        "source_handle": "P0593",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\level2\\external\\Nf2f13ca37a1cba78c9d1-acf4314fb7d520c6\\round_2\\supplements\\case_C2_inosine_tme\\attempt-h4sdftel\\source_units\\SU03_search_candidate_7df1939f2d\\card\\PAPER_READING_CARD.json"
