    "atom::8fa931de280fc236eee06476": {
      "atom_id": "atom::8fa931de280fc236eee06476",
      "source_handle": "P0178",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用活体生物制剂（如CBM588）联合ICI",
        "finding": "在肾细胞癌中显示出改善临床结果的探索性信号，且能显著改变粪便微生物组特征，但结果具有情境依赖性，需更多大样本验证。"
      },
      "role": "evidence",
      "origins": [
        {
