    "atom::fdcc90032eecfb78a3c379e2": {
      "atom_id": "atom::fdcc90032eecfb78a3c379e2",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "综述定义了整合肿瘤学，概述了术前康复（prehabilitation）的概念，以及除微生物群外的其他支持策略（运动、维生素D、大麻禁忌）。"
      },
      "role": "evidence",
      "origins": [
