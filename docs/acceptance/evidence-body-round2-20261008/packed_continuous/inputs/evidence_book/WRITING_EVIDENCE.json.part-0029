    "atom::bb6006227f00f1e06386e3bd": {
      "atom_id": "atom::bb6006227f00f1e06386e3bd",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "The review addresses the challenge that only a minority of cancer patients derive durable benefit from ICPIs, and many experience severe irAEs. It seeks to explain why responses vary among patients by examining the gut microbiome as a potential predictive biomarker and modulator of both therapeutic efficacy and toxicity, aiming to identify avenues for improving patient outcomes through microbiome-targeted strategies.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::0d37d7ec1200ffb22522596abacbc254f145ff25b7b0c950084fe089e08023a7",
      "multiple_values_in_field": false
    },
    "atom::00719742511ab12e73100aea": {
      "atom_id": "atom::00719742511ab12e73100aea",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the role of the gut microbiome in modulating response and toxicity to immune checkpoint inhibitors (ICPIs) in cancer patients, with specific emphasis on solid tumors (e.g., melanoma, non-small cell lung cancer, renal cell carcinoma, pancreatic adenocarcinoma). It covers clinical observations, preclinical mechanisms, and emerging therapeutic strategies involving microbiome modulation.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::dbb597b82f9eca841ac654059a06fb92c47c3477fe9f5f2257ce3364d120ca87",
      "multiple_values_in_field": false
    },
    "atom::f6b85ed0929d25a175964026": {
      "atom_id": "atom::f6b85ed0929d25a175964026",
      "source_handle": "P0358",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This article is a narrative review summarizing current evidence on how the gut microbiome influences the efficacy and safety of ICPI therapy. It discusses the association between microbial diversity/composition and treatment outcomes, outlines putative immunological and metabolic mechanisms linking gut bacteria to anti-tumor immunity and immune-related adverse events (irAEs), and highlights the impact of antibiotics and dietary factors. The review also surveys ongoing clinical trials evaluating microbiome-based interventions such as fecal microbiota transplantation (FMT) and live biotherapeutics to enhance ICPI response or mitigate toxicity.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::49e55529cdcea71057ee423aa3cb76f5981ac841b1bc19f5fac2ed376105b6ac",
      "multiple_values_in_field": false
    },
    "atom::38633b19d762773e5d9f5239": {
      "atom_id": "atom::38633b19d762773e5d9f5239",
      "source_handle": "P0358",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review serves as a foundational resource for understanding the bidirectional relationship between the gut microbiome and ICPI outcomes in solid tumors. It offers detailed descriptions of specific bacterial taxa associated with response/toxicity, plausible biological mechanisms (T-cell cross-reactivity, metabolite production), and the current state of clinical translation via microbiome modulation. It is particularly useful for establishing the context of microbiome-mediated efficacy and toxicity, identifying key candidate organisms, and outlining the rationale for interventional strategies.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::fc67ed81accbcc9cc1dcf15f19ad6b1b80ebb3eaca166ac7152912530e15226c",
      "multiple_values_in_field": false
    },
    "atom::d93757978c699f59d944785e": {
      "atom_id": "atom::d93757978c699f59d944785e",
      "source_handle": "P0358",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Associations are primarily observational or from small prospective studies; causality is not established. Findings may vary by cancer type and geography. Does not provide definitive proof of mechanism.",
        "contribution": "Summarizes clinical evidence linking specific gut microbial signatures (e.g., Faecalibacterium, Akkermansia, Bifidobacterium vs. Bacteroides) to ICPI response rates and survival outcomes in solid tumors. Details the negative impact of broad-spectrum antibiotic use on treatment efficacy.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::1a1b360d4205e4e4f948a9d649b06116be53e936e53c0c4b3a42a99d32ac8fd3",
      "multiple_values_in_field": true
    },
    "atom::a64284a09695f5cad94a0ec9": {
      "atom_id": "atom::a64284a09695f5cad94a0ec9",
      "source_handle": "P0358",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to support arguments about the predictive value of the gut microbiome for ICPI efficacy. Provides specific examples of bacterial taxa to include in discussions of microbiome-response correlations. Highlights the confounding effect of antibiotics.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::639479b9eb089d9686bbb37a13d3bd41645329380f47dd000c5dfea4064c65e4",
      "multiple_values_in_field": true
    },
    "atom::ef1a42d6b6dd05fa51875187": {
      "atom_id": "atom::ef1a42d6b6dd05fa51875187",
      "source_handle": "P0358",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Many mechanisms are derived from murine models or correlative human data. The exact pathways are described as 'putative' and 'not fully elucidated'. Direct causal links in humans require further validation. Specific peptide-crossreactivity details are based on specific transgenic models.",
        "contribution": "Details putative mechanisms including: 1) Modulation of T-regulatory cells and antigen-specific T-cell accumulation in the tumor microenvironment; 2) Production of metabolites (SCFAs, deoxycholate) influencing anti-tumor tolerogenesis; 3) Cross-reactive T-cell activation via bacterial peptides (e.g., beta-galactosidase mimicking MYH6) leading to irAEs like myocarditis; 4) Role of intraepithelial lymphocytes and dendritic cells in colitis pathogenesis.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8717538515f340cb5e7fb18598afb001cbe676cbd81d20f51c6d285eba1b1ec6",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::1a1b360d4205e4e4f948a9d649b06116be53e936e53c0c4b3a42a99d32ac8fd3",
      "multiple_values_in_field": true
    },
