    "atom::0e83796c6787bdce34f2f296": {
      "atom_id": "atom::0e83796c6787bdce34f2f296",
      "source_handle": "P0178",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节源自前临床模型（小鼠），人类证据多为间接支持（如FMT后的免疫重塑观察）。代谢物水平的因果关系在人类中尚未完全确立，需注意区分观察性关联与因果证据。",
        "contribution": "详细阐述了微生物组影响ICI疗效的生物学机制框架，包括：1）通过促进树突状细胞激活和交叉呈递来增强CD8+ T细胞反应；2）通过短链脂肪酸等代谢物调节先天免疫编程和炎症基调；3）通过维持肠道屏障完整性来减少系统性炎症和irAEs风险。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::092a7ef81b878efa4c53c58a11ff6f9701f5421d3f37c7aa1c70cf48d8c64277",
