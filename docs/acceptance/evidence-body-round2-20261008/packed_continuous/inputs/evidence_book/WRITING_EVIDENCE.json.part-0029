          ]
        }
      ],
      "variant_group": "field::5630897555fc15f2ee24fb97792c353ef84860ee45fd8144a29be61d44d8ba23",
      "multiple_values_in_field": true
    },
    "atom::d91e41044a5504a649b0790b": {
      "atom_id": "atom::d91e41044a5504a649b0790b",
      "source_handle": "P0244",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "First 5 paired samples analysed using NanoString Pan Cancer IO 360™ Gene Expression panel",
        "finding": "在 48 个基因中观察到显著的基因表达谱变化（p < 0.05），提示免疫细胞浸润增加，这与临床前模型中的观察结果一致。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::20309b87fd0e8cfe50d8893d7c9d998ed431260a8fc82510d85c2e9d4b2442f5",
          "field_path": [
