            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::5d85ac852b6d56546bd6b0c9b1a76871b359f1884f6ce6c3cfd9c114ffeb58e7",
      "multiple_values_in_field": true
    },
    "atom::baeffd11973b8117fbd94bc8": {
      "atom_id": "atom::baeffd11973b8117fbd94bc8",
      "source_handle": "P0212",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些是作者基于已有文献提出的假设，并非本荟萃分析直接验证的机制。缺乏直接的分子生物学证据（如单细胞测序、代谢组学数据）来证实这些机制在FMT患者中的实际运作路径。",
        "contribution": "提出了FMT增强ICI疗效的潜在机制假说：(1) 增加有益菌（如Akkermansia muciniphila, Bifidobacterium）；(2) 提高肠道微生物α多样性；(3) 调节肿瘤微环境（TME），促进效应T细胞浸润并抑制调节性T细胞。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
