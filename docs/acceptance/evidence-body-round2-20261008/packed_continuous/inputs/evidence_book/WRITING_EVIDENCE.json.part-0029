    "atom::b7b7e3472b4df79f76e0d24c": {
      "atom_id": "atom::b7b7e3472b4df79f76e0d24c",
      "source_handle": "P0178",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法，综合了机制研究（前临床模型与人类观察数据）和临床干预试验证据。具体路线包括：1）梳理微生物组影响ICI的药理学基础（抗原呈递、代谢物耦合、屏障完整性）；2）分类评估三类主要干预手段（FMT、LBPs、定义菌群）的代表性临床试验结果；3）讨论影响可重复性的转化因素（共用药、饮食、定植率）及安全监管问题。未进行系统检索或定量荟萃分析，而是基于现有文献进行逻辑整合与批判性评议。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::092a7ef81b878efa4c53c58a11ff6f9701f5421d3f37c7aa1c70cf48d8c64277",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::2cc8835fd55ad20a54b20c10ba976c5e8f9343db84933faa37cd822aa98f91b0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::9ff67488bf3b087646012dc838cdcce4004e84d77992adfc10e21e892d6453ae",
      "multiple_values_in_field": false
    },
    "atom::d823b853e4ac54a493eee6ef": {
      "atom_id": "atom::d823b853e4ac54a493eee6ef",
      "source_handle": "P0178",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于微生物组工程化干预ICI治疗的最新临床证据综合，特别区分了FMT、LBPs和定义菌群三种模态的优缺点及适用场景。",
        "limits": "作为迷你综述，未提供新的原始实验数据；对特定菌株或代谢物的因果机制多基于前临床模型或间接人类证据，缺乏大规模随机对照试验的确证数据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::092a7ef81b878efa4c53c58a11ff6f9701f5421d3f37c7aa1c70cf48d8c64277",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::2cc8835fd55ad20a54b20c10ba976c5e8f9343db84933faa37cd822aa98f91b0",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::8340ecf9fae2228477df6184a4f9025f6db3286b81dac3905a6d831dd278bbef",
      "multiple_values_in_field": true
    },
    "atom::cdc0eb48bfb3cc26a577a419": {
      "atom_id": "atom::cdc0eb48bfb3cc26a577a419",
      "source_handle": "P0178",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提出了将微生物组干预视为“生态药理学”而非简单附加剂的框架，强调了基线生态、共用药和功能性读出（如代谢物、定植率）的重要性。",
        "limits": "对于不同肿瘤类型间微生物组效应的异质性解释有限，主要依赖已发表的小规模试验，难以推断普适性规律。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::092a7ef81b878efa4c53c58a11ff6f9701f5421d3f37c7aa1c70cf48d8c64277",
          "field_path": [
