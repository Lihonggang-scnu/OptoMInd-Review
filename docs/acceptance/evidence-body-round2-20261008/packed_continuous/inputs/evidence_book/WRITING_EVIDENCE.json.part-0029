      "atom_id": "atom::e947d43bd1da1a68deb89a35",
      "source_handle": "P0152",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Clinical evidence",
        "finding": "Early-phase trials show promise (e.g., ORR 21.7% in refractory NSCLC with beta-glucan + envafolimab), but large-scale Phase III RCTs are absent; most strategies remain at TRL 3-5."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::65ae96ed352455727cd54f5ac6f1c8d41014f9763fa1aa38d7e8f8ed041c226c",
      "multiple_values_in_field": true
    },
    "atom::bae5619bf50fe0fc4b949c3d": {
      "atom_id": "atom::bae5619bf50fe0fc4b949c3d",
      "source_handle": "P0152",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Safety considerations",
        "finding": "Excessive intake of fermentable fibers in dysbiotic models may induce cholestatic liver cancer via SCFA accumulation, highlighting a dose-dependent safety boundary."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
