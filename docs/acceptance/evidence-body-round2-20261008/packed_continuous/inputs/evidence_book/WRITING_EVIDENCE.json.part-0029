    },
    "atom::e153a360ae719d6d23932b2e": {
      "atom_id": "atom::e153a360ae719d6d23932b2e",
      "source_handle": "P0178",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中比较不同微生物组干预策略的有效性和适用场景。可以说明为何FMT目前证据最强，而LBPs和Consortia仍处于早期阶段，并解释导致这种差异的可能原因（如生态复杂性、定植难度）。",
      "role": "planning",
      "origins": [
        {
