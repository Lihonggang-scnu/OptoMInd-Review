    "atom::de3e4327fc150f8a04e4f48a": {
      "atom_id": "atom::de3e4327fc150f8a04e4f48a",
      "source_handle": "P0230",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用单臂、开放标签的I期临床试验设计（Part A部分）。入组标准为：既往接受过至少一种ICI治疗（单药或联合），且根据RECIST 1.1标准确认疾病稳定（SD）或进展（PD），但在最后一次ICI剂量后12周内无快速临床进展。治疗方案为口服MRx0518（1×10^10至1×10^11 CFU，每日两次）联合静脉注射帕博利珠单抗（200 mg，每3周一次），最多35个周期。安全性通过监测第一周期的毒性进行评估；疗效通过每9周一次的影像学评估（RECIST 1.1）确定ORR、DCR和PFS。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::791f861f7c03887eb2ba17977c58d125ed07a70b72a642db190d011f4748db3b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::bd8ec2d4a7c52468770fbad5d604b35e4df8b87ce1a0625d76c311adc473c8df",
      "multiple_values_in_field": false
    },
    "atom::12d23d367b3aa2af5ec2341e": {
      "atom_id": "atom::12d23d367b3aa2af5ec2341e",
      "source_handle": "P0230",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了首个基于肠道微生物组的单菌株活体生物疗法MRx0518与ICI联合使用的早期临床数据，证实了该组合在难治性实体瘤中的可耐受性和初步疗效信号。",
        "limits": "样本量极小（仅12名患者），仅为I期Part A部分的数据，缺乏对照组，无法确立因果效力或普遍适用性；随访时间较短，长期生存数据未知。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::791f861f7c03887eb2ba17977c58d125ed07a70b72a642db190d011f4748db3b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::dc76a7d1e8d8ff471d03045ab2d4853d5695ec3a9bb82456ea000a97cffa0945",
      "multiple_values_in_field": false
    },
    "atom::d8c05c0b76b07e9a430e62d2": {
      "atom_id": "atom::d8c05c0b76b07e9a430e62d2",
      "source_handle": "P0230",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "mRCC (n=9) 和 mNSCLC (n=3) 患者，中位既往治疗线数为3线，83%既往接受过纳武利尤单抗治疗，83%既往最佳反应为SD。",
        "finding": "安全性方面：联合方案显示积极的 profiles，无治疗相关的严重不良事件（SAEs），无因毒性导致的药物停药，未报告irAEs增加。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::791f861f7c03887eb2ba17977c58d125ed07a70b72a642db190d011f4748db3b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::58b449f492d0b1ee21d9bd54c836e17efe9cb65d49af4f4b0f82ba288c6c76f8",
      "multiple_values_in_field": true
    },
    "atom::88dd55e8b41e1fb4a2b91e41": {
      "atom_id": "atom::88dd55e8b41e1fb4a2b91e41",
      "source_handle": "P0230",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "同一队列，数据截止日为2020年8月21日。",
        "finding": "疗效方面：2名RCC患者和1名NSCLC患者达到部分缓解（PR）；另外2名RCC患者获得持久性疾病稳定（SD，分别为6个月和13个月）。协议定义的DCR为42%。中位PFS为2.14个月。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::791f861f7c03887eb2ba17977c58d125ed07a70b72a642db190d011f4748db3b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::58b449f492d0b1ee21d9bd54c836e17efe9cb65d49af4f4b0f82ba288c6c76f8",
      "multiple_values_in_field": true
    },
