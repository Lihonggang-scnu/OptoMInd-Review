      "variant_group": "field::385f3794ca3540e4c731b9953d8a72995b8023c7ccf2adf4fa5243e8c7009861",
      "multiple_values_in_field": true
    },
    "atom::bdae353a87824de36024429d": {
      "atom_id": "atom::bdae353a87824de36024429d",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "医疗大麻的负面结果主要来自观察性研究，可能存在混杂因素（如疼痛严重程度、吸烟史），尽管综述建议谨慎，但不能视为绝对的禁忌证证据。",
      "role": "evidence",
      "origins": [
        {
