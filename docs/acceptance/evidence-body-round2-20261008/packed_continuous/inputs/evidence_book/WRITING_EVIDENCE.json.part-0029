            "broader_review_uses",
            "1"
          ]
        }
      ],
      "variant_group": "field::5ade4cc6f60943b91edff50f2019e0015abf778c0d76aabc249af8604a5b31e1",
      "multiple_values_in_field": true
    },
    "atom::c9c1089482ef34702d255656": {
