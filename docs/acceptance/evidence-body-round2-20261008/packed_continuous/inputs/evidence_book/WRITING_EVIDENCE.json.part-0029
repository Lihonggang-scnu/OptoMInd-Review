    "atom::e33d2c01d3eeb43ff349d0b1": {
      "atom_id": "atom::e33d2c01d3eeb43ff349d0b1",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述主要聚焦于成人实体瘤，特别是黑色素瘤、NSCLC、肾细胞癌和肝癌，结果可能不适用于血液肿瘤或其他罕见实体瘤。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "review_planning_B",
