    "atom::21c502ce4d9feb1abc472eb2": {
      "atom_id": "atom::21c502ce4d9feb1abc472eb2",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作者通过PubMed数据库进行了系统性文献检索（2019年1月至2025年12月），筛选出关于肠道微生物群和代谢物在癌症免疫治疗中作用的基础和转化研究。随后，文章采用叙事性综述的方法，将内容分为三个主要部分：(1) 详细解析核心代谢物（SCFAs、色氨酸代谢物、胆汁酸、肌苷）的免疫调节机制；(2) 按肿瘤类型（胃肠道与非胃肠道）总结微生物签名与ICI疗效的关联；(3) 评估FMT、益生菌、工程菌等干预策略的转化应用。文中引用了大量图表（Figure 1-3, Table 2）来整合机制网络和治疗策略。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::fc9c71838253919afd13aca2d0d2d24fa0a646ca85d8fa8f6b691bb8ff979d76",
      "multiple_values_in_field": false
    },
    "atom::4eddf4399a38d90f66a52ed4": {
      "atom_id": "atom::4eddf4399a38d90f66a52ed4",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物群-代谢物-免疫轴在多类实体瘤中的系统性机制框架，特别强调了代谢物的情境依赖性（如丁酸的双向作用）和肿瘤特异性微生物签名。",
        "limits": "作为叙事性综述，其结论基于已发表研究的综合，缺乏原始数据的定量合成（如Meta分析）。许多机制证据来自动物模型或小样本临床研究，大规模随机对照试验（RCTs）数据尚缺，且个体间微生物组异质性导致标准化治疗面临挑战。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::1e903d5f76fffb22c7a66c260729633951b8b75f89169d9623eff2e06dda9f30",
      "multiple_values_in_field": false
    },
    "atom::13d020d401659bfd819edc82": {
      "atom_id": "atom::13d020d401659bfd819edc82",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "短链脂肪酸（特别是丁酸）",
        "finding": "具有双向且依赖情境的免疫调节作用：一方面通过抑制HDAC活性、增强CD8+ T细胞毒性及TCR信号传导来增强抗肿瘤免疫；另一方面在某些情况下（如抗CTLA-4治疗中）可能抑制树突状细胞成熟，减弱T细胞激活。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::4a91eb1a6ba96ed424257d8b8ae665dc864e50b2fc7b0094dd124c9dc3f257d3",
      "multiple_values_in_field": true
    },
    "atom::556a2c02b52a8d3397800c2e": {
      "atom_id": "atom::556a2c02b52a8d3397800c2e",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "色氨酸代谢物",
        "finding": "犬尿氨酸（Kyn）通过AhR通路促进Treg分化，抑制效应T细胞，削弱免疫反应；而吲哚-3-甲醛（I3A）和ICA则通过激活AhR/IL-22轴或抑制IDO1，增强CD8+ T细胞功能并维持肠道屏障完整性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::4a91eb1a6ba96ed424257d8b8ae665dc864e50b2fc7b0094dd124c9dc3f257d3",
      "multiple_values_in_field": true
    },
    "atom::4d2f957c8117b0f1944f97f1": {
      "atom_id": "atom::4d2f957c8117b0f1944f97f1",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "胆汁酸（BAs）",
        "finding": "次级胆汁酸如isoDCA促进Treg扩增，抑制DC功能；而UDCA通过降解TGF-β抑制Treg分化，增强抗肿瘤免疫。不同胆汁酸对CD8+ T细胞命运有截然相反的影响。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::4a91eb1a6ba96ed424257d8b8ae665dc864e50b2fc7b0094dd124c9dc3f257d3",
      "multiple_values_in_field": true
    },
    "atom::bf6a692c23cd8b67e8b5e315": {
      "atom_id": "atom::bf6a692c23cd8b67e8b5e315",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肌苷（Inosine）",
        "finding": "作为关键代谢物，肌苷通过抑制UBA6增加肿瘤免疫原性，结合A2AR促进Th1细胞分化，并在葡萄糖受限的微环境中作为替代能源维持效应T细胞的存活和杀伤功能。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::4a91eb1a6ba96ed424257d8b8ae665dc864e50b2fc7b0094dd124c9dc3f257d3",
      "multiple_values_in_field": true
    },
    "atom::058f047f3f5c1d44f65875b9": {
      "atom_id": "atom::058f047f3f5c1d44f65875b9",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同肿瘤类型",
        "finding": "存在肿瘤特异性的微生物签名：例如ESCC中Streptococcus富集与良好响应相关，Fn驱动耐药；HCC中Akk和Ruminococcaceae富集者预后较好；黑色素瘤中Bifidobacterium和Ruminococcaceae与ICI疗效正相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "key_findings",
