          ]
        }
      ],
      "variant_group": "field::4a91eb1a6ba96ed424257d8b8ae665dc864e50b2fc7b0094dd124c9dc3f257d3",
      "multiple_values_in_field": true
    },
    "atom::8a99672acb9cc746b2c9a196": {
      "atom_id": "atom::8a99672acb9cc746b2c9a196",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::c4af9bc4e61811cbe3dc729c4aa9ace6c792b93766e95733e88faf1ce2b83ea9",
      "multiple_values_in_field": false
    },
    "atom::91039a283204ebc61cb46c6d": {
      "atom_id": "atom::91039a283204ebc61cb46c6d",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管免疫检查点抑制剂（ICIs）取得了显著进展，但原发性或获得性耐药限制了其临床疗效。目前对于肠道微生物群-代谢物-免疫轴影响ICI疗效的具体分子机制以及不同肿瘤类型中的特异性调控模式仍不完全清楚。本研究旨在阐明这些机制并综合现有的微生物靶向治疗策略，以改善免疫治疗结果。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::76ab8b6f6de2f4abbfe038c8d6224f29305d525c1ca3910071e922f4e8d0da06",
      "multiple_values_in_field": false
    },
    "atom::8152b340dba9d984834c3591": {
      "atom_id": "atom::8152b340dba9d984834c3591",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "该综述聚焦于肠道微生物群-代谢物-免疫轴在癌症免疫治疗中的作用，涵盖胃肠道肿瘤（如食管癌、胃癌、胰腺癌、肝癌、结直肠癌）和非胃肠道实体瘤（如黑色素瘤、肾细胞癌）。研究对象包括核心代谢物（短链脂肪酸、色氨酸代谢物、胆汁酸、肌苷）、特定微生物菌群及其与免疫检查点抑制剂（ICIs）疗效的相互作用。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::0d293855496d5c56292618c9891812e06b064eb6496cdef7df7fa126e756e080",
      "multiple_values_in_field": false
    },
    "atom::61b7f2caf7a2598674f9c9f8": {
      "atom_id": "atom::61b7f2caf7a2598674f9c9f8",
      "source_handle": "P0594",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "这是一篇叙事性综述，旨在系统梳理肠道微生物群及其代谢产物调节抗肿瘤免疫的分子机制，并综合评估针对该轴的转化治疗策略。文章首先阐述了微生物代谢物如何通过表观遗传修饰、受体结合和代谢重编程等途径重塑免疫微环境；其次，按肿瘤类型归纳了特征性微生物签名及其对ICI响应的影响；最后，讨论了粪菌移植（FMT）、益生菌补充、工程菌及其他干预手段的临床潜力与挑战。尽管采用了系统性的文献检索流程，但其性质为叙事性综述，侧重于机制解释和策略综合，而非严格的荟萃分析。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::8dcc3bbd8771d01618ab433a64a512c0246a3067d2b8d035862f5c1a10cd4441",
      "multiple_values_in_field": false
    },
    "atom::e4afe04c58d3528e5cd04d98": {
      "atom_id": "atom::e4afe04c58d3528e5cd04d98",
      "source_handle": "P0594",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物如何调节实体瘤对免疫检查点抑制剂（ICIs）的响应提供了详细的机制背景和分类素材。它特别有价值地梳理了四大类核心代谢物（SCFAs、色氨酸代谢物、胆汁酸、肌苷）的具体作用路径，并按肿瘤类型整理了特征性微生物签名。此外，它还评估了FMT、益生菌和工程菌等干预策略的现状与挑战，可直接用于回答微生物组调节ICI疗效的机制及现有干预手段的有效性。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::90fb35baef036e2d91bf2ebb3ceebe75b546fd82861db3da485052f325028250",
      "multiple_values_in_field": false
    },
    "atom::ac0f10278878595624a0d171": {
      "atom_id": "atom::ac0f10278878595624a0d171",
      "source_handle": "P0594",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些关联多基于观察性队列或动物模型，因果关系需进一步验证；且不同研究间的微生物定义和分析方法可能存在差异。",
        "contribution": "提供了不同肿瘤类型中特征性微生物签名与ICI疗效关联的分类信息。具体包括：ESCC中Streptococcus富集与CD8+ T细胞浸润相关，Fn驱动耐药；HCC中Akk和Ruminococcaceae富集预示良好响应；黑色素瘤中Bifidobacterium和Ruminococcaceae与疗效正相关；结直肠癌中Lactobacillus rhamnosus GG和Roseburia intestinalis增强敏感性，而Peptostreptococcus anaerobius促进MDSC积累导致耐药。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::26a157a3bd0c25570bd55d6dd5de2761541d84516cc833008795376a4f67abdb",
      "multiple_values_in_field": true
    },
    "atom::07311966c1735a4837e52cbf": {
      "atom_id": "atom::07311966c1735a4837e52cbf",
      "source_handle": "P0594",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于回答“哪些微生物特征预测了实体瘤患者对ICIs的响应？”这一问题，提供具体的细菌属/种及其在不同癌症背景下的作用方向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::d0a367a7b9e3cbde9107c50e130cc755d39eddfc81cafb567eb0e51332347073",
      "multiple_values_in_field": true
    },
    "atom::cffa01442576e15d938a5da1": {
      "atom_id": "atom::cffa01442576e15d938a5da1",
      "source_handle": "P0594",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制细节多源于体外实验或小鼠模型，人体内的确切浓度和效应阈值尚不明确；部分机制（如丁酸的双向作用）高度依赖肿瘤微环境的特定状态。",
        "contribution": "详细阐述了四类核心代谢物调节抗肿瘤免疫的具体分子机制。包括：(1) SCFAs（如丁酸）通过抑制HDAC、激活GPR109A/TLR5通路增强CD8+ T细胞功能，但具有情境依赖性；(2) 色氨酸代谢物中，Kyn通过AhR促进Treg，而I3A/ICA通过AhR/IDO1通路增强效应T细胞；(3) 胆汁酸中，isoDCA促进Treg，UDCA抑制Treg；(4) 肌苷通过抑制UBA6、激活A2AR/cAMP-CREB通路及作为替代能源支持T细胞代谢。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::26a157a3bd0c25570bd55d6dd5de2761541d84516cc833008795376a4f67abdb",
      "multiple_values_in_field": true
    },
    "atom::167710728ee2b1e9a06712a9": {
      "atom_id": "atom::167710728ee2b1e9a06712a9",
      "source_handle": "P0594",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "直接用于回答“微生物组调节ICI疗效的机制是什么？”这一问题，提供从受体结合、表观遗传修饰到代谢重编程的多层次机制解释。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::d0a367a7b9e3cbde9107c50e130cc755d39eddfc81cafb567eb0e51332347073",
      "multiple_values_in_field": true
    },
    "atom::a132693460907667307d07bf": {
      "atom_id": "atom::a132693460907667307d07bf",
      "source_handle": "P0594",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "大多数干预措施仍处于早期临床试验阶段，缺乏大规模RCT证据；个体化匹配和长期安全性仍是未决问题。",
        "contribution": "评估了针对微生物组的干预策略（FMT、益生菌、工程菌）在增强ICI疗效方面的转化潜力和当前局限。指出FMT在黑色素瘤和小样本研究中显示出提高ORR的潜力，但面临标准化和安全风险；益生菌（如LGG、Faecalibacterium prausnitzii）可通过产生代谢物或下调PD-L1增强疗效，但也存在负面案例；工程菌和噬菌体疗法代表了精准调控的新方向。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::82bffb4d0f097201933ac4373dcc32aa21e68b789566b0ab8396d7ce21e40ca0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::26a157a3bd0c25570bd55d6dd5de2761541d84516cc833008795376a4f67abdb",
      "multiple_values_in_field": true
    },
