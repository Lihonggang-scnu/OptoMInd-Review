    "atom::bb50d6fc7d72546d3b0b14c5": {
      "atom_id": "atom::bb50d6fc7d72546d3b0b14c5",
      "source_handle": "P0212",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "解决FMT在增强ICI疗效方面的临床证据碎片化问题，明确其有效性、安全性以及不同治疗策略（如ICI组合、供体来源、给药途径）对疗效的影响，为未来临床试验设计提供依据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        },
        {
          "record_id": "record::44b1f3bad783421ccdb817ed0122eebbbfbabb244e6146a032e01b105144b0d8",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::c458c08ee8a896abdd9e380a042587e89056516fbae58586a0e5b7435326995f",
      "multiple_values_in_field": false
    },
    "atom::e9b62844e5031ff35428cc56": {
      "atom_id": "atom::e9b62844e5031ff35428cc56",
      "source_handle": "P0212",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "针对晚期或难治性实体瘤患者，评估粪便微生物群移植（FMT）联合免疫检查点抑制剂（ICI）治疗的临床疗效与安全性。纳入的研究包括随机对照试验（RCT）、单臂干预研究和前瞻性队列研究，涵盖黑色素瘤、肾细胞癌（RCC）、微卫星稳定型结直肠癌（MSS-CRC）等多种肿瘤类型。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        },
        {
          "record_id": "record::44b1f3bad783421ccdb817ed0122eebbbfbabb244e6146a032e01b105144b0d8",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::d61c30192b26726c19e921e07c805c39c380fadf646bc16285886f56a210d337",
      "multiple_values_in_field": false
    },
    "atom::92021fb9971ea3e4766af23f": {
      "atom_id": "atom::92021fb9971ea3e4766af23f",
      "source_handle": "P0212",
      "field_path": [
