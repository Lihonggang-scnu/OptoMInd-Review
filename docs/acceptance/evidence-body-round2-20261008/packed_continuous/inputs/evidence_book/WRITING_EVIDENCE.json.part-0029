    "atom::7a7aad00488e11d4a7c07f3f": {
      "atom_id": "atom::7a7aad00488e11d4a7c07f3f",
      "source_handle": "P0152",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "How can natural polysaccharides be rationally designed and utilized to overcome primary and acquired resistance to ICIs in solid tumors, given their complex structures and variable clinical outcomes?",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::56325e6ee0ee87abfd5fca84d6f013198055f2dc0bd6d27e7246924253d70730",
      "multiple_values_in_field": false
    },
    "atom::00a97cdd8f787cbe68b388cb": {
      "atom_id": "atom::00a97cdd8f787cbe68b388cb",
      "source_handle": "P0152",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "Natural polysaccharides (from fungi, plants, marine organisms) as immune adjuvants to overcome resistance to Immune Checkpoint Inhibitors (ICIs) in solid tumors. Covers structural biology, molecular mechanisms, preclinical/clinical evidence, translational challenges, and future technological directions.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::8b15546d60486f3f9d4dcfe392a9acdbcaeccd1936ac2718320d1d3aa0a9952d",
      "multiple_values_in_field": false
    },
    "atom::0b0c136f05c57c534c85bdf1": {
      "atom_id": "atom::0b0c136f05c57c534c85bdf1",
      "source_handle": "P0152",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This review systematically analyzes the potential of natural polysaccharides to enhance the efficacy of ICIs by reversing tumor immune resistance. It dissects the structure-activity relationships (SAR) governing immunomodulation, elaborates on four core mechanisms (TAM repolarization, CD8+ T cell rejuvenation, gut microbiota remodeling, and suppression of tumor-intrinsic escape), and evaluates current clinical translation bottlenecks such as structural heterogeneity and low bioavailability. The paper positions polysaccharides within the broader landscape of combination therapies, compares them with other adjuvants, and proposes a roadmap for precision medicine using AI-driven glycomics, synthetic biology, and multi-layer biomarkers.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75c05d10f04491719965663b9549b6686953d172b9d288c7a7b94a65cd3b42da",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::868c31dc2b7f66d544d34d6bf03cd644358944e92b0eb988a51432920b035eae",
      "multiple_values_in_field": false
    },
