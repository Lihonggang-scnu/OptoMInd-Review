    "atom::0f02e6b98612c18ae9aa0912": {
      "atom_id": "atom::0f02e6b98612c18ae9aa0912",
      "source_handle": "P0006",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用回顾性分析设计，整合两项独立的I期随机临床试验数据。纳入接受nivo/ipi或cabo/nivo +/- CBM588治疗的mRCC患者。收集基线和第12周的粪便样本进行宏基因组测序（MetaPhlan v4）。主要分析方法包括：1) 比较SOC组与SOC/CBM组在基线和第12周的Alpha和Beta多样性；2) 使用Wilcoxon配对检验评估临床相关微生物物种丰度的变化；3) 计算Firmicutes/Bacteroidetes比率以衡量菌群失调程度。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ae6fc092083bad76a3be286e49684b5c3f415ec697f0b3a6f27ad3969d1723b6",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::314e62c5020af1e71541dff8be649dcb2bd55d5af2cd258335d3f2d5d22b5169",
      "multiple_values_in_field": false
    },
    "atom::e59dd59a101dcc1ad5120ae2": {
      "atom_id": "atom::e59dd59a101dcc1ad5120ae2",
      "source_handle": "P0006",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了CBM588调节肠道微生物组的直接证据，特别是其能防止Eubacterium siraeum耗竭并纠正Firmicutes/Bacteroidetes比率失衡，这为之前观察到的临床获益提供了生物学机制假设。",
        "limits": "样本量较小（N=58），且为I期试验数据的二次分析；仅报告了微生物组变化，未直接关联临床结局数据（如ORR、PFS）；未区分两种不同的ICI联合方案对微生物组影响的潜在差异；缺乏长期随访数据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ae6fc092083bad76a3be286e49684b5c3f415ec697f0b3a6f27ad3969d1723b6",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::c43672fa4c43ae2b89207885329d12f3364b36b43bf35dadef82dd49dafec92e",
      "multiple_values_in_field": false
    },
    "atom::b3a3638adfa01b7db6729e9c": {
      "atom_id": "atom::b3a3638adfa01b7db6729e9c",
      "source_handle": "P0006",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "SOC组 vs SOC/CBM组，基线 vs 第12周",
        "finding": "两组间Alpha和Beta多样性在第12周均无统计学显著差异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ae6fc092083bad76a3be286e49684b5c3f415ec697f0b3a6f27ad3969d1723b6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::efaeb192794f8530bd1f19bf05177837f446b39f56568eef8ac05ee41890c76d",
      "multiple_values_in_field": true
    },
    "atom::1fabca92c6655ca00f603409": {
      "atom_id": "atom::1fabca92c6655ca00f603409",
      "source_handle": "P0006",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "SOC组，基线 vs 第12周",
        "finding": "Alistipes senegalensis减少（LFC -0.82, P=0.004）；Eubacterium siraeum显著减少（LFC -1.75, P=0.005）；Firmicutes/Bacteroidetes比率从89.0%增加到96.4%（提示菌群失调加重）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ae6fc092083bad76a3be286e49684b5c3f415ec697f0b3a6f27ad3969d1723b6",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::efaeb192794f8530bd1f19bf05177837f446b39f56568eef8ac05ee41890c76d",
      "multiple_values_in_field": true
    },
    "atom::04e5819886921a9c0c850bcc": {
      "atom_id": "atom::04e5819886921a9c0c850bcc",
      "source_handle": "P0006",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "SOC/CBM组，基线 vs 第12周",
        "finding": "Alistipes senegalensis减少（LFC -0.36, P=0.007）；Eubacterium siraeum未发生显著减少；Firmicutes/Bacteroidetes比率从100.0%显著下降到75.7%（提示菌群失调改善）。"
      },
      "role": "evidence",
      "origins": [
