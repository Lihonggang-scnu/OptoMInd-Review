    "atom::3ee898ac21789411a52117b5": {
      "atom_id": "atom::3ee898ac21789411a52117b5",
      "source_handle": "P0212",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用PRISMA指南指导的系统综述方法。检索策略覆盖PubMed、ClinicalTrials.gov及主要肿瘤学会议摘要。纳入标准限定为接受ICI联合FMT治疗的实体瘤患者，排除仅关注免疫微环境变化或无具体数据的回顾性研究。使用Cochrane ROB 2.0和ROBINS-I工具评估偏倚风险。统计分析使用Stata 18和R语言，以ORR为主要终点，CR、PR、PFS、OS及不良事件为次要终点。对于生存数据，因多数研究未报告风险比（HR），采用加权平均中位数进行初步评估。亚组分析基于ICI策略、供体来源、给药途径和肿瘤类型进行。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::44b1f3bad783421ccdb817ed0122eebbbfbabb244e6146a032e01b105144b0d8",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::0fb524231212f00bb15dbd3ab679b03db50df32dfb78cf7f8c4cf2b0bc98aa5b",
      "multiple_values_in_field": false
    },
    "atom::119ebc43a2985e2a4447adb7": {
      "atom_id": "atom::119ebc43a2985e2a4447adb7",
      "source_handle": "P0212",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了FMT联合ICI治疗实体瘤的汇总疗效数据（ORR 43%），并量化了不同ICI策略（特别是双药联合）对疗效的显著影响。",
        "limits": "所给材料未交代具体的微生物组测序深度、特定菌株定植率的长期追踪数据，以及FMT对ICI耐药性的逆转机制的直接实验证据。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::44b1f3bad783421ccdb817ed0122eebbbfbabb244e6146a032e01b105144b0d8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::49f201b3e3880a6860b49ad935c3b649651c819679449e20d95abca006351e08",
      "multiple_values_in_field": true
    },
    "atom::fe78db4b46d3dbef7d9279bd": {
      "atom_id": "atom::fe78db4b46d3dbef7d9279bd",
      "source_handle": "P0212",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "明确了FMT联合治疗的安全性特征，指出其不显著增加严重不良事件风险，甚至可能在某些情况下降低irAEs。",
        "limits": "安全性数据主要来自短期随访，缺乏长期安全性监测，无法评估迟发性不良反应或微生物组改变的持久性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::44b1f3bad783421ccdb817ed0122eebbbfbabb244e6146a032e01b105144b0d8",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::49f201b3e3880a6860b49ad935c3b649651c819679449e20d95abca006351e08",
      "multiple_values_in_field": true
    },
    "atom::ef62572c2550368d6d7be5ad": {
      "atom_id": "atom::ef62572c2550368d6d7be5ad",
      "source_handle": "P0212",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "识别了关键的方法学异质性来源，如供体选择（ICI反应者vs健康人）和给药途径对结果的潜在影响。",
        "limits": "纳入研究多为单臂或小样本RCT，缺乏大规模多中心对照，导致效应估计可能存在选择偏倚，且无法确立因果关系。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::153738efad1ff78582447def2bcb3c312f0a586a7520f897f63871d450a16bd8",
          "field_path": [
