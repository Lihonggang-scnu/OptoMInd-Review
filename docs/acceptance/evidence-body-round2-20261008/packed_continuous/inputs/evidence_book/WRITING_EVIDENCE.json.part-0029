    "atom::4105e603a60c7ac2142dbb4c": {
      "atom_id": "atom::4105e603a60c7ac2142dbb4c",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "The authors conducted a narrative synthesis of literature from microbiology, immunology, and oncology. They organized the content into thematic sections: introduction to the gut-lung axis, alterations in microbiota composition and metabolism in lung cancer patients, microbial biomarkers for early detection, prediction of immunotherapy response, modulation of drug efficacy, microbiota-targeted therapeutic interventions, and mechanistic insights. The review integrates findings from clinical studies, animal models, and multi-omics analyses to construct a cohesive understanding of the gut-lung axis in lung cancer.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::b337cb72867c61957f99a86a8234d0898a6ebdefc9e86751f72e444e85e7cc12",
      "multiple_values_in_field": false
    },
    "atom::0920b699f4612e204bfc385c": {
      "atom_id": "atom::0920b699f4612e204bfc385c",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a comprehensive overview of the gut-lung axis in lung cancer, linking specific microbial taxa and metabolites to clinical outcomes in diagnosis and immunotherapy.",
        "limits": "As a narrative review, it does not present new primary data or perform a systematic meta-analysis. The causal relationships described are largely inferred from correlative clinical studies and preclinical models, which may vary across populations."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::024152f7c05ac94530c80c4ed8d99db89ed50eb4fa3acd0d5ebb2ebc1864ebc6",
      "multiple_values_in_field": true
    },
    "atom::f5b8b569e7ef00dbb86acdf1": {
      "atom_id": "atom::f5b8b569e7ef00dbb86acdf1",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Identifies specific microbial signatures (e.g., A. muciniphila, SCFA producers) and metabolic profiles as potential biomarkers for predicting ICI response.",
        "limits": "The generalizability of these biomarkers depends on the heterogeneity of patient cohorts and sequencing methodologies used in the cited studies, which are not standardized in this review."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::024152f7c05ac94530c80c4ed8d99db89ed50eb4fa3acd0d5ebb2ebc1864ebc6",
      "multiple_values_in_field": true
    },
    "atom::0807e5f5e9cb71aaf08bbdf2": {
      "atom_id": "atom::0807e5f5e9cb71aaf08bbdf2",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Discusses therapeutic interventions like FMT and probiotics as adjuncts to cancer therapy, highlighting their potential to overcome resistance.",
        "limits": "Clinical translation faces challenges including interindividual variability, lack of standardized protocols for FMT/probiotics, and long-term safety concerns, which are noted but not resolved."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::024152f7c05ac94530c80c4ed8d99db89ed50eb4fa3acd0d5ebb2ebc1864ebc6",
      "multiple_values_in_field": true
    },
    "atom::222b7c85cacaaec66836ff67": {
      "atom_id": "atom::222b7c85cacaaec66836ff67",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "In lung cancer patients compared to healthy controls",
        "finding": "Patients exhibit dysbiosis characterized by increased abundance of Ruminococcus, Enterobacteriaceae, Lachnospiraceae, and decreased levels of Faecalibacterium, Bifidobacterium, and Veillonella. Metabolic profiles show reduced SCFA production and increased lactate."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::f9ee738858a0322f1b25540fa08b4f85f8bce5a2d4685b13478f527efd9c6b93",
      "multiple_values_in_field": true
    },
    "atom::87afa3d0ef630783c4ccd7f5": {
      "atom_id": "atom::87afa3d0ef630783c4ccd7f5",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "For early detection of lung cancer",
        "finding": "A panel of 13 microbial biomarkers was identified with high diagnostic potential, achieving an AUC of 92.4% in discovery and 67.7% in validation cohorts using a Patient Discrimination Index (PDI)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::f9ee738858a0322f1b25540fa08b4f85f8bce5a2d4685b13478f527efd9c6b93",
      "multiple_values_in_field": true
    },
    "atom::759a8bfc798893a613e65496": {
      "atom_id": "atom::759a8bfc798893a613e65496",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Predicting response to Immune Checkpoint Inhibitors (ICIs)",
        "finding": "Baseline presence of Akkermansia muciniphila, Faecalibacterium spp., and Clostridiales correlates with improved ICI outcomes. Higher levels of acetate, propionate, and butyrate are associated with prolonged progression-free survival. A TOPOSCORE integrating species interaction groups and A. muciniphila abundance predicts individual responses."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::f9ee738858a0322f1b25540fa08b4f85f8bce5a2d4685b13478f527efd9c6b93",
      "multiple_values_in_field": true
    },
    "atom::9670e0aad2a912986441368f": {
      "atom_id": "atom::9670e0aad2a912986441368f",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Impact of antibiotics and probiotics on ICI efficacy",
        "finding": "Antibiotic use prior to ICI therapy is associated with reduced overall survival and impaired efficacy. Probiotic supplementation (e.g., Bifidobacterium, Clostridium butyricum) may enhance ICI efficacy and improve survival outcomes in NSCLC patients."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        },
        {
          "record_id": "record::7b48398ecbc866361ef2c26255b8d180c29ff697449aa1daf8d026a1fd096717",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::f9ee738858a0322f1b25540fa08b4f85f8bce5a2d4685b13478f527efd9c6b93",
      "multiple_values_in_field": true
    },
    "atom::8f84bfea0480caaf0aa351c6": {
      "atom_id": "atom::8f84bfea0480caaf0aa351c6",
      "source_handle": "P0297",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Mechanisms of action",
        "finding": "Gut microbes modulate lung immunity via metabolites (SCFAs), antigen presentation, and immune cell trafficking. Specific bacteria like A. muciniphila can translocate to tumor tissues, restructure the intratumoral ecosystem, and restore exhausted CD8+ T cells, enhancing anti-PD-1 therapy efficacy."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::55488d84dbb359a3345c319fcbc24f4458fd41cbf955ce9b98beedd9d58e160c",
          "field_path": [
