"
          ]
        }
      ],
      "variant_group": "field::e5e4127f60360a1daec17a8a8b3553694f17774551b43193ca402de4c56d8ed4",
      "multiple_values_in_field": false
    },
    "atom::bb8a877a73f48d88979a6319": {
      "atom_id": "atom::bb8a877a73f48d88979a6319",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些发现主要基于观察性研究和小型试点研究，因果关系的确立程度不一；不同癌症类型（主要是黑色素瘤、NSCLC、HCC）的结果不能直接泛化到所有实体瘤。",
        "contribution": "提供了肠道微生物群调节ICI疗效的临床证据链：包括FMT诱导缓解的案例、LBTs（如MRx0518, CBM588）增强疗效和减轻irAEs的数据、以及饮食纤维（>20g/d）与PFS延长的关联。同时指出了益生菌效果的菌株特异性和矛盾性。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::ee7719144495341dfe59ff9f3608d61bf1133b0163daeef98a1bf7fec75c1848",
      "multiple_values_in_field": true
    },
    "atom::cf58306d7c6a16a81bafc7e8": {
      "atom_id": "atom::cf58306d7c6a16a81bafc7e8",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于描述肠道微生物群作为ICI疗效关键调节因子的临床表现；列举具体的微生物干预策略及其对肿瘤反应（ORR, PFS, OS）的影响方向。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::3ce6b34dfaae7b7486bfdea00d440e2a4e16a97977657f817adf671896179cda",
      "multiple_values_in_field": true
    },
    "atom::05ca21c8bcfac14fc5240f7a": {
      "atom_id": "atom::05ca21c8bcfac14fc5240f7a",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制部分多为动物模型或体外研究推论（如L. reuteri的机制），临床人体内的确切分子通路细节在所给材料中未完全展开；压力机制主要基于动物研究和人类相关性观察，直接因果链条需结合其他文献验证。",
        "contribution": "阐述了微生物群影响ICI疗效的部分机制路径：包括短链脂肪酸（SCFAs）驱动CD4/CD8 T细胞激活、促进IFN表达；特定菌株代谢物（如I3A）促进肿瘤内CD8+ T细胞浸润；以及系统性炎症（IL-6, IL-8）作为负向调节因子。同时提到了慢性压力通过HPA轴/SNS改变肿瘤微环境（TME）的间接机制。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::ee7719144495341dfe59ff9f3608d61bf1133b0163daeef98a1bf7fec75c1848",
      "multiple_values_in_field": true
    },
    "atom::1d317ba52bd157ec4ddfc445": {
      "atom_id": "atom::1d317ba52bd157ec4ddfc445",
      "source_handle": "P0343",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释微生物群介导ICI疗效的生物学机制，特别是免疫细胞活化、细胞因子释放和肿瘤微环境重塑方面的通路。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::aee91b6d254c74392754ffb37b15df2d925f15b668fbf0ba4a08c73ef74d6c9e",
          "field_path": [
