      "multiple_values_in_field": true
    },
    "atom::d4533d783b2312ae037ecddc": {
      "atom_id": "atom::d4533d783b2312ae037ecddc",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "双歧杆菌与无获益相关的发现与既往文献矛盾，需谨慎解读，可能受肿瘤类型、治疗方案或患者群体差异影响。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
