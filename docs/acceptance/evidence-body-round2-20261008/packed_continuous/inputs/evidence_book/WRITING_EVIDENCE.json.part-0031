    "atom::66bd0c3c3ac030702af2beb7": {
      "atom_id": "atom::66bd0c3c3ac030702af2beb7",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To synthesize existing evidence on the link between gut microbiota and ICI-associated myocarditis, identify underlying molecular mechanisms, and evaluate the potential of modulating gut microbiota (e.g., via antibiotics, transplantation) as a therapeutic strategy, while addressing the balance between reducing irAEs and maintaining anti-tumor efficacy.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::4fe1acccd004e2cce4cbf3028c9ad08324c06a64ffe47ec83a6c7d41af455837",
      "multiple_values_in_field": false
    },
    "atom::340fd518cb652e91b8639951": {
      "atom_id": "atom::340fd518cb652e91b8639951",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "The review focuses on the association between gut microbiota and immune checkpoint inhibitor (ICI)-associated myocarditis, a severe immune-related adverse event (irAE). It synthesizes evidence from preclinical studies (primarily mouse models) and clinical observations to explore molecular mechanisms and potential therapeutic interventions involving microbiota modulation.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::bba62e05d1d8eb28eeb012091f23d281fe66bb287350d73e72fee9a559cf21c2",
      "multiple_values_in_field": false
    },
    "atom::fa66804474ed79ee61b6a12b": {
      "atom_id": "atom::fa66804474ed79ee61b6a12b",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This narrative review aims to elucidate the role of gut microbiota in the pathogenesis of ICI-associated myocarditis. The authors hypothesize that gut microbiota influences this condition through mechanisms such as molecular mimicry, regulation of regulatory T cells (Tregs), and systemic inflammation. The paper discusses how specific microbial alterations correlate with cardiac injury markers and reviews preclinical evidence suggesting that antibiotic depletion or modulation of gut flora can mitigate myocardial damage. However, it highlights the controversy surrounding antibiotic use due to potential negative impacts on ICI efficacy and notes that clinical validation for microbiota-targeted therapies is still pending.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::4d2e003fa33d4475325bf97effe823b9c2a7a802f6d8ff10c320d59ad567ef16",
      "multiple_values_in_field": false
    },
