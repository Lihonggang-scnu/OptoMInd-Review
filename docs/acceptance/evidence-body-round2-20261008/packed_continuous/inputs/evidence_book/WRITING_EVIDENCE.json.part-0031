      "multiple_values_in_field": true
    },
    "atom::1ab5a85cf8b4996167085cc0": {
      "atom_id": "atom::1ab5a85cf8b4996167085cc0",
      "source_handle": "P0447",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物组如何通过代谢介导调节实体瘤中对免疫检查点抑制剂（ICIs）的反应提供了详细的机制背景。它特别适用于解释微生物代谢物（如SCFAs、胆汁酸、色氨酸代谢物）如何作为关键信使，通过重塑免疫细胞（特别是T细胞和巨噬细胞）的代谢状态来影响免疫治疗疗效。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::01aa69b11b55a87a24b2b3026bd5ecb8d4e435b574dd18460a16f5ed38e994e0",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::7c20ed41d2fdc7e4ba14dd2912b01c499510f40544368fafadc0fec4e1ca6a38",
      "multiple_values_in_field": false
    },
    "atom::b36f5be8bf7e892c36691cf4": {
      "atom_id": "atom::b36f5be8bf7e892c36691cf4",
      "source_handle": "P0447",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述涵盖多种微生物代谢物，但其对ICI疗效的影响因癌症类型、代谢物种类、浓度及宿主免疫状态而异，不可一概而论。",
      "role": "evidence",
