    "atom::23a2e83f16cac9e170ef380d": {
      "atom_id": "atom::23a2e83f16cac9e170ef380d",
      "source_handle": "P0314",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "设计为单中心、前瞻性观察性队列研究。纳入标准：≥18岁转移性黑色素瘤患者，计划接受ICI治疗；排除标准：除生理替代外使用皮质类固醇者。样本收集：基线（ICI开始前10天内）、irAE发生时（CTCAE v5.0分级≥1级）、12周时采集粪便和血液样本。临床评估：每12周通过RECIST v1.1评估肿瘤反应和无进展生存期（PFS）。微生物分析：采用Illumina NovaSeq 6000进行宏基因组鸟枪法测序，使用MetaPhlAn4/HUMAnN3进行分类和谱系分析，使用ANCOM-BC2进行差异丰度分析以识别响应者/非响应者及irAE发生/未发生组间的显著差异分类群。统计显著性设定为q-value < 0.05。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ed51308a119087567f15d8b466bfe48bffa1bfeb7fa01cda43973c9a1479fb1f",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::cfa689668dd3309bc133deb31e24e2fb134fa82a8e0596a4f159f7743119b8b4",
      "multiple_values_in_field": false
    },
    "atom::cd3b02229ef600929713fd51": {
      "atom_id": "atom::cd3b02229ef600929713fd51",
      "source_handle": "P0314",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了在单中心转移性黑色素瘤队列中，基线肠道微生物组特征与ICI治疗反应及irAEs发生的具体关联数据；识别出可能与“高疗效低毒性”相关的特定微生物（如Blautia luti）；验证了Lachnospiraceae家族在ICI反应中的普遍关联性。",
        "limits": "样本量较小（n=41可评估反应，n=11发生>1级irAEs），限制了发现的普遍性和统计效力；单中心研究，人群多样性有限；观察性设计无法确立因果关系；未控制饮食等生活方式因素；基线采样窗口较宽（10天），可能引入变异；排除基线使用皮质类固醇的患者可能引入选择偏倚。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ed51308a119087567f15d8b466bfe48bffa1bfeb7fa01cda43973c9a1479fb1f",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::4bbf8279eb417456c61674bf842178960f42035217f18e6be829193f350e747a",
      "multiple_values_in_field": false
    },
    "atom::8c7b4bbbb48579d13f510dc7": {
      "atom_id": "atom::8c7b4bbbb48579d13f510dc7",
      "source_handle": "P0314",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线微生物组，转移性黑色素瘤患者（n=41可评估），ICI治疗",
        "finding": "响应者（R）中Intestinimonas butyriciproducens (q=0.002)和Longicatena caecimuris (q=0.003)富集；非响应者（NR）中Tenericutes (q=0.001)和Lachnospira sp.NSJ 43 (q=0.002)富集。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ed51308a119087567f15d8b466bfe48bffa1bfeb7fa01cda43973c9a1479fb1f",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::ff3658eabe804c066b482174c518a5bffa8f6cf13ffc8afb457e9a3ca732500a",
      "multiple_values_in_field": true
    },
    "atom::617e0a79c10627a1d064c820": {
      "atom_id": "atom::617e0a79c10627a1d064c820",
      "source_handle": "P0314",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基线微生物组，ICI治疗反应与irAEs关联",
        "finding": "Blautia luti及其他Lachnospiraceae成员与“既有反应又无irAE”的状态相关（反应q=0.02，无irAE q=0.02）。在该队列中，治疗反应与irAEs之间未观察到统计学关系（P=0.368）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ed51308a119087567f15d8b466bfe48bffa1bfeb7fa01cda43973c9a1479fb1f",
