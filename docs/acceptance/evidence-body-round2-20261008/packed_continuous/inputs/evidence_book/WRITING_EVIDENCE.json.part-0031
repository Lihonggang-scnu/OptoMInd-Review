    "atom::97749345a885cf4063ad9daf": {
      "atom_id": "atom::97749345a885cf4063ad9daf",
      "source_handle": "P0486",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "大部分干预措施处于临床前阶段，仅有少数进入早期临床试验，长期安全性和有效性数据不足。",
        "contribution": "介绍了通过干预微生物代谢组来增强ICB疗效的策略，包括使用特定益生菌株（如L. rhamnosus GG, F. prausnitzii）、益生元（膳食纤维）、代谢物补充剂（丁酸盐、肌苷）以及基因工程菌（表达SagA或抗体的工程菌）。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c00cf96a1c40711a1f547ab22b358fd426fde384d108c3eb0f8c25b68252d73a",
          "field_path": [
