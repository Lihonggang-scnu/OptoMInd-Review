    "atom::cb90c31a36f0ada7ecaece05": {
      "atom_id": "atom::cb90c31a36f0ada7ecaece05",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅在mTNBC和特定化疗方案（PLD+环磷酰胺）背景下成立；需独立队列验证；小样本限制统计效力；未明确因果机制。",
        "contribution": "提供了mTNBC患者中基线肠道微生物α多样性（Faith's PD）与ICI联合化疗疗效（PFS）的正向关联证据。具体显示高Faith's PD患者从阿替利珠单抗中获益更大（HR 0.34），而低Faith's PD患者获益不明显。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
