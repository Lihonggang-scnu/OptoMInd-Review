    "atom::561f5aef87f33e8389c0e5cc": {
      "atom_id": "atom::561f5aef87f33e8389c0e5cc",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了mTNBC这一特定实体瘤亚型中，肠道微生物组多样性与免疫检查点抑制剂疗效关联的直接临床证据。其核心价值在于揭示了Faith's PD作为预测阿替利珠单抗联合化疗获益的潜在生物标志物，并报告了与既往文献（其他癌症类型）相悖的双歧杆菌属与耐药/无获益相关的发现，有助于综述中讨论微生物组标志物的肿瘤类型特异性和情境依赖性。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::9537e36cebcab3652eb2a3a726758f0d28f99b92cd1aa2edab0b2b7f32497401",
      "multiple_values_in_field": false
    },
    "atom::d639a17047b3a76e610ff76f": {
      "atom_id": "atom::d639a17047b3a76e610ff76f",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究的结论仅限于mTNBC患者，不能直接外推到其他类型的乳腺癌或其他实体瘤。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
