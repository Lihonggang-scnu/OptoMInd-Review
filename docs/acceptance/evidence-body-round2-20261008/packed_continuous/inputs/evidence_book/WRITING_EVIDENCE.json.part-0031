    "atom::06508d0cdedf332dcb5a2e5a": {
      "atom_id": "atom::06508d0cdedf332dcb5a2e5a",
      "source_handle": "P0197",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "无菌小鼠模型",
        "finding": "仅当响应者（R）基线粪便随后跟随其对应供体粪便灌胃时，才导致α多样性和定植物种数随时间显著增加（p<0.01）；非响应者（NR）基线粪便无论是否跟随供体粪便，均未改变多样性或定植。"
      },
      "role": "evidence",
