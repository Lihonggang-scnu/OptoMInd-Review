      "multiple_values_in_field": true
    },
    "atom::0ac17c8e6efb31e00f2e8705": {
      "atom_id": "atom::0ac17c8e6efb31e00f2e8705",
      "source_handle": "P0239",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "摘要未提供具体的分子机制解释（如抗原模拟、代谢产物等），仅停留在相关性层面。需要结合其他文献补充机制细节。",
        "contribution": "提出了通过微生物组特征区分‘有效且有副作用’与‘有效且无副作用’的可能性（例如Eubacterium siraeum与无irAE响应相关）。这暗示了微生物组可能在调节疗效与毒性平衡中起中介作用。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::cc748712c94d969a09e8c3491567f225ababcd142f9fd71a5b7e17dfa24d41b0",
      "multiple_values_in_field": true
    },
    "atom::73d3bf280c61be8602a849ec": {
      "atom_id": "atom::73d3bf280c61be8602a849ec",
      "source_handle": "P0239",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于探讨综述中‘机制’部分，即微生物组不仅影响疗效，还可能调节免疫系统的特异性反应模式，从而影响毒性谱。可作为‘微生物组作为个性化治疗指导工具’的案例。",
      "role": "planning",
      "origins": [
        {
