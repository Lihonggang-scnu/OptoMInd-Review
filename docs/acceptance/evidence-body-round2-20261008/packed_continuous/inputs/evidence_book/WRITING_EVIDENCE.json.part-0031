    "atom::971b4d6832cb71174bf1acc8": {
      "atom_id": "atom::971b4d6832cb71174bf1acc8",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "前瞻性观察性队列研究。对象为俄亥俄州立大学皮肤癌诊所收治的>18岁ICI治疗黑色素瘤患者（排除基线使用皮质类固醇者）。数据收集包括：1. 临床终点：每12周通过RECIST v1.1评估客观缓解率（ORR），记录12个月无进展生存期（PFS）；通过CTCAE v5.0评估irAEs。2. 生物样本：在基线、irAE发生后2天内（医生图表审查确认）、治疗12周时收集粪便样本。3. 实验室分析：Illumina NovaSeq 6000进行宏基因组全基因组鸟枪法测序，使用HUMAnN3进行分类。4. 统计分析：使用R包glmm对微生物相对丰度与irAEs的影响进行逻辑回归建模，并校正错误发现率（FDR）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::4a083aeeaeb252e78d003b2b61c2232bff1db930c71ed6f748466af46d8c86f8",
      "multiple_values_in_field": false
    },
    "atom::c4a2c53e2690a84e1e092162": {
      "atom_id": "atom::c4a2c53e2690a84e1e092162",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了纵向微生物组数据，识别出能区分不同临床表型（响应/非响应、有/无irAE）的具体细菌和噬菌体标志物。",
        "limits": "所给摘要未交代因果机制验证结果；仅观察到关联性，作者明确指出未来分析需分配因果角色。样本量较小（n=32可评估响应），且为单中心观察性研究，外推性受限。未涵盖真菌的作用细节（仅提及无关联）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::beb569ee45340095851ac98e5aa5fa33b0e054bea67590a2567abf827eb0daff",
      "multiple_values_in_field": false
    },
    "atom::dfac6126f2e15d75dc95ae48": {
      "atom_id": "atom::dfac6126f2e15d75dc95ae48",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "总体响应 vs 非响应（基于ORR）",
        "finding": "响应者中富集Bacteroides dorei (FDR p=9.5E-07) 和 Blautia species CAG:257 (padj=0.001)；非响应者中富集 Prevotella Stercorea (padj=1.1E-07) 和一种靶向沙门氏菌的噬菌体 (padj=8.3E-09)。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::7c6e8bb2a517473e077839d3409a64aa7c7630c5f1f008aa06dcc3c29ea75783",
      "multiple_values_in_field": true
    },
    "atom::7211c1c99a88d8c48939669c": {
      "atom_id": "atom::7211c1c99a88d8c48939669c",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "有irAE的响应者 vs 无irAE的响应者",
        "finding": "有irAE的响应者富集 Bacteroides plebeius (padj=4.2E-13) 和 Bacteroides coprophilus (padj=0.0002)；无irAE的响应者富集 Eubacterium siraeum (padj=7.2E-05)。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
