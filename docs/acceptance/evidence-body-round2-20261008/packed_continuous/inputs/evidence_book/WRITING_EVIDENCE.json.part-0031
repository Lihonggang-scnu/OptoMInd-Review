            "connection_to_review"
          ]
        }
      ],
      "variant_group": "field::7382ccf55fdca80b37a17c974f96ee5509c560e44e947aada77da7e24233941e",
      "multiple_values_in_field": true
    },
    "atom::d65ecdf7115563475646c2e8": {
      "atom_id": "atom::d65ecdf7115563475646c2e8",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "提示技术局限性和未来研究方向",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "2",
            "purpose"
          ]
        }
      ],
      "variant_group": "field::341d804c88b146dac30afd5b9e84933c083d2d9b73499c77bdddb9e9ab8433ce",
      "multiple_values_in_field": true
    },
    "atom::2712cff3485eac1e16b170a0": {
      "atom_id": "atom::2712cff3485eac1e16b170a0",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "原文主要基于已发表的关联研究综述，未提供新的临床队列数据；不同研究间涉及的肿瘤类型（黑色素瘤、非小细胞肺癌等）和具体菌种可能存在差异，需结合其他论文细化至特定肿瘤类型。",
        "contribution": "提供了与实体瘤ICI疗效正相关的特定微生物群特征（主要是厚壁菌门，如Faecalibacterium prausnitzii, Ruminococcus spp.）。引用了Routy et al.和Gopalakrishnan et al.的研究，指出这些菌属丰度高的患者具有更好的无进展生存期和总体缓解率。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::bab37fe1a6d58dde1ba84478c40a464d9e4491be4dfbaa0df9ebb3e071116a79",
      "multiple_values_in_field": true
    },
    "atom::6fdb96a49421fbc96568492d": {
      "atom_id": "atom::6fdb96a49421fbc96568492d",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“哪些微生物群特征与ICI疗效相关”，作为关联证据的一部分。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::05247cd6cf0f6ddb0aff2659f2f2b4500157d77cdfbe3a69328142cac1c45354",
      "multiple_values_in_field": true
    },
    "atom::58c20f030da550080798855d": {
      "atom_id": "atom::58c20f030da550080798855d",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这些机制多为基于动物模型（如无菌小鼠FMT实验）或体外研究的推论，原文指出需要更多研究来确认其在人类患者中的确切因果链条；部分机制（如丁酸对Treg的影响）是通用的免疫调节机制，需区分其对ICI特异性的贡献。",
        "contribution": "详细阐述了微生物组调节ICI疗效的多种潜在机制：1) 代谢物介导：Faecalibacterium产生的丁酸盐促进Treg分化并支持CD8+ T细胞激活；2) 抗原呈递：某些厚壁菌促进树突状细胞成熟和MHC I类表达；3) 屏障功能：厚壁菌上调紧密连接蛋白，防止微生物易位和全身性炎症，从而避免抑制抗肿瘤免疫。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::bab37fe1a6d58dde1ba84478c40a464d9e4491be4dfbaa0df9ebb3e071116a79",
      "multiple_values_in_field": true
    },
    "atom::52474b1d03037b02b495a7e9": {
      "atom_id": "atom::52474b1d03037b02b495a7e9",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“介导效应的机制是什么”，提供具体的分子和细胞层面的解释路径。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::05247cd6cf0f6ddb0aff2659f2f2b4500157d77cdfbe3a69328142cac1c45354",
      "multiple_values_in_field": true
    },
    "atom::70318f34e313c05f56869a77": {
      "atom_id": "atom::70318f34e313c05f56869a77",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是动物模型数据，不能直接等同于人体内的疗效；且FMT本身是一种复杂的干预，其效果可能受多种菌群共同作用影响，难以归因于单一菌种。",
        "contribution": "提及通过FMT将ICI响应者的微生物群移植到无菌小鼠体内可恢复抗肿瘤免疫并增强PD-1阻断疗效，这为因果关系提供了间接支持。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::bab37fe1a6d58dde1ba84478c40a464d9e4491be4dfbaa0df9ebb3e071116a79",
      "multiple_values_in_field": true
    },
    "atom::006889a0e69a9c64bb23f6fe": {
      "atom_id": "atom::006889a0e69a9c64bb23f6fe",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "作为支持微生物组对ICI疗效具有因果影响的证据之一。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::05247cd6cf0f6ddb0aff2659f2f2b4500157d77cdfbe3a69328142cac1c45354",
      "multiple_values_in_field": true
    },
    "atom::392d0ce445b08788df645bcb": {
      "atom_id": "atom::392d0ce445b08788df645bcb",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物组如何调节实体瘤免疫检查点抑制剂（ICI）疗效提供了重要的机制背景和候选生物标志物线索。它详细列出了与ICI响应相关的特定菌属（如厚壁菌门成员）及其作用机制（代谢物、抗原呈递、屏障功能），可作为回答“微生物组如何调节ICI疗效”及“介导机制是什么”这两个子问题的核心素材。同时，它也提供了关于益生菌、FMT等在免疫调节中的通用机制，有助于构建更广泛的宿主-微生物互作背景。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::1c704a48697632da30ef24358b8d1889eaf68ff38c122ef460e8d8a7eb6cc3cf",
      "multiple_values_in_field": false
    },
    "atom::7da955f43223dcfefdd700eb": {
      "atom_id": "atom::7da955f43223dcfefdd700eb",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述涵盖多种疾病和免疫调节场景，并非专门针对某一特定实体瘤类型；在应用于“solid tumours”时，需注意原文引用的ICI研究涉及多种肿瘤（如黑色素瘤、NSCLC），需根据综述计划中的过滤器进一步筛选或合并证据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::3c7c3390861a4bbc597c3b1c823bb1f3916e61d19b2931549ae9dbf085b348f7",
      "multiple_values_in_field": true
    },
    "atom::13a1c8b21fc5dd3ad58568db": {
      "atom_id": "atom::13a1c8b21fc5dd3ad58568db",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "原文强调微生物组与ICI疗效的关联，但机制部分多基于动物模型或体外研究，需谨慎区分观察性关联与因果机制。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::3c7c3390861a4bbc597c3b1c823bb1f3916e61d19b2931549ae9dbf085b348f7",
      "multiple_values_in_field": true
    },
    "atom::28e3e490e6d92865457adba3": {
      "atom_id": "atom::28e3e490e6d92865457adba3",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "文中提到的“厚壁菌门”是一个庞大的分类群，不同物种甚至菌株的功能可能截然不同，不能简单地将所有厚壁菌视为有益菌，需关注具体物种（如Faecalibacterium）的描述。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "2"
          ]
        }
      ],
      "variant_group": "field::3c7c3390861a4bbc597c3b1c823bb1f3916e61d19b2931549ae9dbf085b348f7",
      "multiple_values_in_field": true
    },
