    "atom::5e833da17547baa4126c2d92": {
      "atom_id": "atom::5e833da17547baa4126c2d92",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "展示微生物组疗法的广泛适用性，但需注意这些应用主要针对非肿瘤性疾病，与ICI疗效的直接联系较弱，主要用于说明微生物组调节免疫的普遍潜力。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
