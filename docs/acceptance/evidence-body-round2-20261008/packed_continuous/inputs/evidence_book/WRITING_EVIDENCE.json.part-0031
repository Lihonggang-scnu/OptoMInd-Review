          ]
        }
      ],
      "variant_group": "field::7cdfff687410e22abd4177dc3e0a10450ad7d2458c581c7f44480fe7b6b48853",
      "multiple_values_in_field": true
    },
    "atom::c031ac86c1716a24065c846e": {
      "atom_id": "atom::c031ac86c1716a24065c846e",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "P. copri与irAE的关联仅在特定供体和特定治疗背景下观察到，需谨慎解读其普遍意义。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
