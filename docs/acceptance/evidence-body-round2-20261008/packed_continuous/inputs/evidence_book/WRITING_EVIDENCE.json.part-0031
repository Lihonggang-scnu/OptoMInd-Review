    "atom::67f13e25766d75aaef011aad": {
      "atom_id": "atom::67f13e25766d75aaef011aad",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Most evidence comes from retrospective analyses or small prospective cohorts; generalizability across different cancer types and ethnicities is not fully established.",
        "contribution": "Identifies specific gut microbial signatures associated with positive or negative responses to ICIs in solid tumors (e.g., melanoma, NSCLC, CRC). For instance, Akkermansia and Bifidobacterium are linked to better ICI outcomes, while certain dysbiotic states correlate with resistance.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::834a11aec8032bd299cca5f5987a2e031b2f25ea2d2f431c5cc1c4aaf0c212aa",
      "multiple_values_in_field": true
    },
    "atom::36ea51337411944dfbc9c2ef": {
      "atom_id": "atom::36ea51337411944dfbc9c2ef",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to list beneficial and detrimental microbial taxa in the context of ICI efficacy. Provides evidence for microbiome-based predictive biomarkers.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::56ea95994c67efe26f109cd4b6ecd02b62772f5f2e0b78bda4e13ffcf0d05496",
      "multiple_values_in_field": true
    },
    "atom::b9c2402b7a1c543a02101c9e": {
      "atom_id": "atom::b9c2402b7a1c543a02101c9e",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Many mechanisms are derived from mouse models or in vitro studies; direct translation to human clinical settings requires further validation. Some mechanisms (e.g., antigen mimicry) are proposed but not universally accepted as primary drivers.",
        "contribution": "Details multiple mechanisms: 1) Activation of innate immunity (DC maturation, macrophage polarization); 2) Enhancement of adaptive immunity (CD8+ T cell infiltration, memory T cell formation); 3) Metabolic modulation (SCFAs inhibiting apoptosis, TMAO inducing pyroptosis); 4) Antigen mimicry (Bifidobacterium breve expressing tumor-like antigens); 5) Modulation of the tumor microenvironment via metabolite translocation.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::834a11aec8032bd299cca5f5987a2e031b2f25ea2d2f431c5cc1c4aaf0c212aa",
      "multiple_values_in_field": true
    },
    "atom::5a56cdc0d18f27f15b152c48": {
      "atom_id": "atom::5a56cdc0d18f27f15b152c48",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Provides specific molecular and cellular pathways to explain *how* microbiota affects ICI efficacy. Useful for constructing a mechanistic model of microbiome-immunotherapy interaction.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::56ea95994c67efe26f109cd4b6ecd02b62772f5f2e0b78bda4e13ffcf0d05496",
      "multiple_values_in_field": true
    },
    "atom::e55330e12d5ca2931ba6d2bb": {
      "atom_id": "atom::e55330e12d5ca2931ba6d2bb",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Correlational nature of many findings; causality between specific dysbiotic shifts and resistance is often inferred rather than proven in humans.",
        "contribution": "Discusses how dysbiosis contributes to ICI resistance by promoting an immunosuppressive TME, reducing T cell infiltration, and increasing regulatory T cells (Tregs).",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::834a11aec8032bd299cca5f5987a2e031b2f25ea2d2f431c5cc1c4aaf0c212aa",
      "multiple_values_in_field": true
    },
    "atom::44644fdd85e435c5e6908542": {
      "atom_id": "atom::44644fdd85e435c5e6908542",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Helps explain the 'non-responder' phenotype in terms of microbial imbalance.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::56ea95994c67efe26f109cd4b6ecd02b62772f5f2e0b78bda4e13ffcf0d05496",
      "multiple_values_in_field": true
    },
    "atom::8ec25ce9c532ced3b4eb766a": {
      "atom_id": "atom::8ec25ce9c532ced3b4eb766a",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This review provides a detailed mechanistic framework for how gut microbiota modulates ICI efficacy, specifically addressing the user's facets F1 (modulation of efficacy) and F2 (mechanisms). It offers concrete examples of bacterial species (Akkermansia, Bifidobacterium, etc.) and their specific impacts on CD8+ T cells, dendritic cells, and cytokine profiles. It also covers the role of metabolites (SCFAs, TMAO) and antigen mimicry. Additionally, it provides context on dysbiosis-induced resistance and clinical strategies (FMT, probiotics) to overcome it.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::7d6efb03b212a77e00d8d33d1c0e9c50ab7626683b0576fbfb8a1d25fd6153bd",
      "multiple_values_in_field": false
    },
    "atom::8ed37c5ee9abee88edda9912": {
      "atom_id": "atom::8ed37c5ee9abee88edda9912",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review includes data from various cancer types (melanoma, lung, colorectal, liver, pancreatic), not just solid tumors exclusively, though solid tumors are heavily featured. Caution is needed when extrapolating specific bacterial effects across different tumor microenvironments.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::05f33395f67c902809eb2b898d0180622d6eb6fab6ede5ae9440f2343150cd1a",
      "multiple_values_in_field": true
    },
    "atom::ed53cc9fcf2ca6b67dacca70": {
      "atom_id": "atom::ed53cc9fcf2ca6b67dacca70",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "Many mechanistic insights are based on preclinical models (mice); human clinical data often supports correlations but less frequently proves direct causation.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::05f33395f67c902809eb2b898d0180622d6eb6fab6ede5ae9440f2343150cd1a",
      "multiple_values_in_field": true
    },
    "atom::a7450e8b7c1336b885d6c3b2": {
      "atom_id": "atom::a7450e8b7c1336b885d6c3b2",
      "source_handle": "P0409",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "The review highlights both beneficial and detrimental roles of specific bacteria depending on the context (e.g., Faecalibacterium prausnitzii as a risk factor for colitis but potentially protective in other contexts). Context-specific interpretation is required.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
