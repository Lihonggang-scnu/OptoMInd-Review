    "atom::2000b68c8c5fa0e87063243b": {
      "atom_id": "atom::2000b68c8c5fa0e87063243b",
      "source_handle": "P0409",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "In patients treated with PD-1/PD-L1 inhibitors",
        "finding": "Higher abundance of Akkermansia muciniphila and Bifidobacterium species is associated with improved response rates and survival outcomes."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::31393c5eba720b79d6c031d292ee6ddbc54f4eca734a198dd86faecd1c410689",
      "multiple_values_in_field": true
    },
    "atom::7a1c7e4d44abd8a7b9de49b8": {
      "atom_id": "atom::7a1c7e4d44abd8a7b9de49b8",
      "source_handle": "P0409",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Mechanisms of action",
        "finding": "Specific bacteria (e.g., Bifidobacterium breve) express antigens mimicking tumor antigens, enhancing T-cell mediated destruction. Microbial metabolites like short-chain fatty acids (SCFAs) and trimethylamine N-oxide (TMAO) modulate immune responses and tumor cell viability."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::31393c5eba720b79d6c031d292ee6ddbc54f4eca734a198dd86faecd1c410689",
      "multiple_values_in_field": true
    },
    "atom::47c0af981c9848116b98fcbd": {
      "atom_id": "atom::47c0af981c9848116b98fcbd",
      "source_handle": "P0409",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Dysbiosis and Cancer Progression",
        "finding": "Gut dysbiosis promotes cancer progression by inducing chronic inflammation, producing carcinogenic metabolites (e.g., secondary bile acids), compromising the intestinal barrier (leading to translocation of LPS), and creating an immunosuppressive tumor microenvironment."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::31393c5eba720b79d6c031d292ee6ddbc54f4eca734a198dd86faecd1c410689",
      "multiple_values_in_field": true
    },
    "atom::d0be8d713888750b150f6a2f": {
      "atom_id": "atom::d0be8d713888750b150f6a2f",
      "source_handle": "P0409",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Diagnostic Potential",
        "finding": "Fecal and plasma microbial signatures (e.g., Fusobacterium nucleatum, specific Clostridium species) show promise as non-invasive biomarkers for early detection and stratification of cancers like colorectal cancer (CRC) and lung cancer."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::31393c5eba720b79d6c031d292ee6ddbc54f4eca734a198dd86faecd1c410689",
      "multiple_values_in_field": true
    },
    "atom::a0802c346402a47cfaefa3c6": {
      "atom_id": "atom::a0802c346402a47cfaefa3c6",
      "source_handle": "P0409",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Therapeutic Interventions",
        "finding": "Fecal microbiota transplantation (FMT) combined with ICIs has shown potential to reverse resistance in melanoma and colorectal cancer patients. Probiotics and prebiotics may help mitigate immune-related adverse events (irAEs) while maintaining or enhancing therapeutic efficacy."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::716a224e7f6710b72ac24bd2d675e6ad1a14cdcb3c028492f8d20f6aecdd57ba",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::31393c5eba720b79d6c031d292ee6ddbc54f4eca734a198dd86faecd1c410689",
      "multiple_values_in_field": true
    },
    "atom::2ed888e434285a19e40421e8": {
      "atom_id": "atom::2ed888e434285a19e40421e8",
      "source_handle": "P0409",
