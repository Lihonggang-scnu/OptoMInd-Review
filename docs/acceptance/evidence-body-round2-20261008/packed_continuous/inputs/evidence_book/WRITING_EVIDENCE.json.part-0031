    "atom::b0222e4ea3b48614eee429f0": {
      "atom_id": "atom::b0222e4ea3b48614eee429f0",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "作为ICI联合用药安全性的案例，提醒综述在讨论干预措施时需考虑药物-药物相互作用及额外免疫刺激的风险。",
      "role": "planning",
      "origins": [
        {
