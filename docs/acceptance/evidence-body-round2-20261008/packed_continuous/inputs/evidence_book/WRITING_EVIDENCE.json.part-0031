            "0"
          ]
        }
      ],
      "variant_group": "field::0a7484296d7251984e385ff540c8acc925097c7cc9f84a54934316d095810782",
      "multiple_values_in_field": true
    },
    "atom::fffd350a435b8d51235bfa90": {
      "atom_id": "atom::fffd350a435b8d51235bfa90",
      "source_handle": "P0197",
      "field_path": [
