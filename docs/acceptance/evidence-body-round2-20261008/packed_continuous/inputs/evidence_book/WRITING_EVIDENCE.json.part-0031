    },
    "atom::1799cef0389f1d57159b5845": {
      "atom_id": "atom::1799cef0389f1d57159b5845",
      "source_handle": "P0447",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节基于体外或小鼠模型研究，其在人类TME中的确切适用性需结合具体情境判断。部分机制（如AhR在不同细胞类型中的特异性作用）仍存在争议或复杂性。",
        "contribution": "详细阐述了微生物代谢物调节免疫细胞代谢的具体分子机制。例如：SCFAs通过HDAC抑制、GPCR激活和作为代谢底物调节T细胞和巨噬细胞的糖酵解、脂肪酸氧化（FAO）和线粒体功能；色氨酸代谢物通过AhR通路调节Treg分化和巨噬细胞极化；胆汁酸通过TGR5/FXR等受体影响CD8+ T细胞的Ca2+-NFAT信号和mTOR/OXPHOS通路。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01aa69b11b55a87a24b2b3026bd5ecb8d4e435b574dd18460a16f5ed38e994e0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::2d13d80e0a00bca702de8586bba588f2991e979bb1fc0b8c4d5121af9b120179",
      "multiple_values_in_field": true
    },
