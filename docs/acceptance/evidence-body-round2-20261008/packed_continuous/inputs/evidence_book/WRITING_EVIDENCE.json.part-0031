            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::b2d45743c0893f061fb9f3d760d747946297ce2e8140ed39397a157011f83c09",
      "multiple_values_in_field": true
    },
    "atom::700e7e78430f24bee77ca7b3": {
      "atom_id": "atom::700e7e78430f24bee77ca7b3",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "机制多为相关性发现，需结合其他研究验证因果关系。P. copri与irAE的关联仅在黑色素瘤双ICI组中显著，在NSCLC单药组中未观察到，提示情境依赖性。",
        "contribution": "揭示了潜在的机制线索：1) 响应者菌群特征（多胺、胆汁酸升高）；2) 毒性机制关联（P. copri定植与irAE，特别是心肌炎，以及肠道渗漏标志物sST2升高）；3) 免疫表型差异（响应者T细胞记忆亚群 vs 未响应者耗竭标志物）。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0a7484296d7251984e385ff540c8acc925097c7cc9f84a54934316d095810782",
      "multiple_values_in_field": true
    },
    "atom::7b7d3bf0bd4845fc5b50e997": {
      "atom_id": "atom::7b7d3bf0bd4845fc5b50e997",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“哪些机制介导了这种效应”这一子问题，提供微生物-宿主互作的具体分子和细胞层面证据，特别是关于毒性发生的潜在微生物驱动因素。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::b2d45743c0893f061fb9f3d760d747946297ce2e8140ed39397a157011f83c09",
      "multiple_values_in_field": true
    },
    "atom::37c8d6d76e2dd43954cde5e3": {
      "atom_id": "atom::37c8d6d76e2dd43954cde5e3",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了FMT联合ICI治疗实体瘤的临床效果对比数据，特别是揭示了不同ICI骨架（单药vs双药）对FMT诱导毒性的调节作用。它识别出特定菌群（P. copri）与严重irAE的关联，以及响应者特有的代谢产物（多胺、胆汁酸）和免疫表型变化。这些内容可用于综述中讨论FMT的临床获益/风险平衡、毒性机制及生物标志物预测。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::68da2f31f4b9e37c5a4486b7b8699ab318f612a1b0e9b7de448b5124b576227b",
      "multiple_values_in_field": false
    },
    "atom::e9ca54e94afa8588258d4114": {
      "atom_id": "atom::e9ca54e94afa8588258d4114",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "本研究为单臂、非随机、小样本探索性研究，结论仅为假设生成性质，不能作为确证性证据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::7cdfff687410e22abd4177dc3e0a10450ad7d2458c581c7f44480fe7b6b48853",
      "multiple_values_in_field": true
    },
    "atom::2fa66b3e5838d36d7f081951": {
      "atom_id": "atom::2fa66b3e5838d36d7f081951",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "NSCLC和黑色素瘤的结果不可互换外推，不同ICI方案（单药vs双药）对毒性有显著调节作用。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
          "field_path": [
