    "atom::a8440cfbf1b4fae54edbd498": {
      "atom_id": "atom::a8440cfbf1b4fae54edbd498",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用系统性文献综述方法，按免疫细胞类型（树突状细胞、巨噬细胞、NK细胞、MDSCs、CD8+ T细胞、CD4+ T细胞亚群）和免疫过程分类，梳理不同代谢物的作用机制；随后按干预手段（益生菌/益生元、工程菌、FMT）总结临床转化进展；最后讨论双向效应、递送效率及个体异质性等挑战。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::0e38f244af0448780fb79602f5f8700cd4252b00ec08b183a1ab50be2f597c18",
      "multiple_values_in_field": false
    },
    "atom::35652f2c8dc4fbc3dafe5ae3": {
      "atom_id": "atom::35652f2c8dc4fbc3dafe5ae3",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了关于肠道微生物代谢物调节肿瘤免疫的详细机制图谱，涵盖了从分子通路到临床干预的多层次信息。",
        "limits": "作为综述，其结论依赖于所引用的原始研究，未提供新的实验数据；对代谢物浓度的精确阈值和最佳给药方案缺乏统一标准，且存在个体异质性带来的外推风险。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::ee204905ba6ac6b1209d3d51188378346a75c340a123faa129a473263ac43a9a",
      "multiple_values_in_field": false
    },
    "atom::37efb18de72638daa5c8949e": {
      "atom_id": "atom::37efb18de72638daa5c8949e",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在结直肠癌模型中，乳酸杆菌产生的吲哚-3-乳酸（ILA）通过表观遗传机制促进DCs产生IL-12，激活CD8+ T细胞。",
        "finding": "ILA增强抗肿瘤免疫，抑制肿瘤生长。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::1c94a3c6687738950d9a34154379a6b033a94bc077afe046ecaa023e3e52c44d",
      "multiple_values_in_field": true
    },
    "atom::69187a7ad756a846e99d7992": {
      "atom_id": "atom::69187a7ad756a846e99d7992",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "高浓度丁酸盐在原发性胆汁性胆管炎患者中或特定条件下。",
        "finding": "丁酸盐通过HDAC抑制和脂肪酸β氧化重编程MDSCs，增强其免疫抑制功能，具有双重作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::1c94a3c6687738950d9a34154379a6b033a94bc077afe046ecaa023e3e52c44d",
      "multiple_values_in_field": true
    },
    "atom::0c13464ecb40fee8a621dff9": {
      "atom_id": "atom::0c13464ecb40fee8a621dff9",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "在黑色素瘤和肾细胞癌临床试验中。",
        "finding": "粪菌移植（FMT）联合抗PD-1治疗可显著提高客观缓解率，伴随有益菌群富集和代谢物谱改变。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::1c94a3c6687738950d9a34154379a6b033a94bc077afe046ecaa023e3e52c44d",
      "multiple_values_in_field": true
    },
    "atom::35f8d3323b26418d7807ed59": {
      "atom_id": "atom::35f8d3323b26418d7807ed59",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "不同癌症类型及代谢物浓度下。",
        "finding": "部分代谢物如丁酸盐、多胺、琥珀酸具有情境依赖的双向功能，既可能促进也可能抑制抗肿瘤免疫。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
