        "source_handle": "P0197",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\55e5f184350846573ce6b2d40fdcbd15f2602f90\\fe6455704805c8dbacd86cc388cca0ba\\attempt-01\\PAPER_READING_CARD.json"
