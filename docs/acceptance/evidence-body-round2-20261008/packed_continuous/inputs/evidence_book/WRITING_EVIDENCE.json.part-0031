          ]
        }
      ],
      "variant_group": "field::50c930d3f57d35e9c3f13153657d6fb72b2083738c868096d853e01e41cd7cae",
      "multiple_values_in_field": false
    },
    "atom::4becc119fc69cde4c2a09e5e": {
      "atom_id": "atom::4becc119fc69cde4c2a09e5e",
      "source_handle": "P0067",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "在mTNBC患者中，肠道微生物组的组成和多样性是否与化疗联合PD-L1抑制剂治疗的临床结局（如PFS、临床获益）相关？肠道微生物组能否作为预测免疫治疗获益的生物标志物？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::ff2755c5b1b2c99cf635588fd305fa368333ff760cce534311b6264025cbbe97",
      "multiple_values_in_field": false
    },
    "atom::def8921a1025c0c8b073e954": {
      "atom_id": "atom::def8921a1025c0c8b073e954",
      "source_handle": "P0067",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "转移性三阴性乳腺癌（mTNBC）患者，参与ALICE随机对照试验，接受化疗联合阿替利珠单抗（PD-L1抑制剂）或安慰剂联合化疗治疗。研究聚焦于基线及治疗8周后的肠道微生物组特征与临床结局（无进展生存期PFS、临床获益率、免疫相关不良事件irAEs）的关联。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::a4c1e9cb90f17ef56913b5188c1399807e69774a85ac5e708e3f076f9f20ed9a",
      "multiple_values_in_field": false
    },
    "atom::61ef295f5d86d63ee578c5b2": {
      "atom_id": "atom::61ef295f5d86d63ee578c5b2",
      "source_handle": "P0067",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究利用ALICE临床试验的数据，旨在探索肠道微生物组作为mTNBC患者接受化疗联合免疫检查点抑制剂（ICI）治疗的预后和预测生物标志物的潜力。通过对70名患者中提供粪便样本者的16S rRNA基因测序数据进行分析，研究发现基线Faith's系统发育多样性（Faith's PD）较高与延长PFS显著相关，且这种关联在阿替利珠单抗联合化疗组中尤为明显，而在单纯化疗组中不显著。此外，高Faith's PD被提示为预测阿替利珠单抗获益的标志物。研究还发现基线双歧杆菌属（Bifidobacterium）过度代表与阿替利珠单抗组缺乏临床获益相关，这与既往在其他肿瘤类型中的观察结果相反。治疗期间整体α多样性显著下降。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::7b509fd53b65ac6be58a096ba05e9ad386fed4805342c1cc6e0c51f76bd01a91",
      "multiple_values_in_field": false
    },
