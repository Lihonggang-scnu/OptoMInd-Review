    "atom::71552915e32c5143e2a52c13": {
      "atom_id": "atom::71552915e32c5143e2a52c13",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "讨论了多组学技术、单细胞测序、空间转录组在解析宿主-微生物互作中的优势与局限；指出个体差异、标准化难题和长期安全性问题。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
            "2"
          ]
        }
      ],
      "variant_group": "field::fb4ba1584677f383ca9c77d7e22108c80e893616c3076937c948c0f6eecd32df",
      "multiple_values_in_field": true
    },
    "atom::0b21215ae240bc1daa5a2e74": {
      "atom_id": "atom::0b21215ae240bc1daa5a2e74",
      "source_handle": "P0460",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "提醒在解读微生物组与ICI疗效关联时，需考虑技术噪音、个体异质性和因果推断的复杂性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
