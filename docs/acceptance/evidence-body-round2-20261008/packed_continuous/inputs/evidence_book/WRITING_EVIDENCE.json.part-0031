    "atom::6d0f58a336215e112619dfb6": {
      "atom_id": "atom::6d0f58a336215e112619dfb6",
      "source_handle": "P0447",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "多数证据来自回顾性队列或动物模型，直接证明特定代谢物在人体中改善ICI疗效的因果链条仍需更多RCT支持。不同癌症类型（如黑色素瘤 vs. 肺癌）的结果可能存在差异。",
        "contribution": "提供了多种微生物代谢物（SCFAs, 胆汁酸, 色氨酸代谢物）与免疫检查点抑制剂（如PD-1/PD-L1抗体）疗效之间关联的证据。例如，产SCFA细菌丰度与黑色素瘤患者对PD-1治疗的响应正相关；Akkermansia补充剂通过色氨酸代谢物增强CAR-T细胞疗效（虽非ICI，但属免疫治疗范畴）；色氨酸代谢物被报道可增强ICI疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::01aa69b11b55a87a24b2b3026bd5ecb8d4e435b574dd18460a16f5ed38e994e0",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::2d13d80e0a00bca702de8586bba588f2991e979bb1fc0b8c4d5121af9b120179",
      "multiple_values_in_field": true
    },
    "atom::0d58166e736e4b309a87df74": {
      "atom_id": "atom::0d58166e736e4b309a87df74",
      "source_handle": "P0447",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于回答肠道微生物组如何调节实体瘤中ICI疗效的问题，提供具体的代谢物类别和临床/临床前关联证据。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::01aa69b11b55a87a24b2b3026bd5ecb8d4e435b574dd18460a16f5ed38e994e0",
