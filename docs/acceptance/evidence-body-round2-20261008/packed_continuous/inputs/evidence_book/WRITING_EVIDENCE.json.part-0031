      "multiple_values_in_field": true
    },
    "atom::d4b259f5e0f3e39b336b885a": {
      "atom_id": "atom::d4b259f5e0f3e39b336b885a",
      "source_handle": "P0604",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是心肌炎/炎症性心肌病的特定案例，而非实体瘤中微生物调节ICI疗效的直接证据。不同癌症类型和微生物群落差异巨大。",
        "contribution": "提供了肠道微生物（Bacteroides thetaiotaomicron）通过分子模拟（cross-immune response）触发心脏自身免疫反应的实例。展示了微生物抗原与宿主自身抗原（MyHC-α）的同源性如何导致T细胞交叉激活。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::eaa5eb691eb7f9a7f497a2614c94467c8f3a48d5173c7cebb8bb2c9844711381",
          "field_path": [
