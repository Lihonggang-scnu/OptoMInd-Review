            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::70a758a19a8574678c955819d18d1b56367f9e7fef727b673065122e065d057d",
      "multiple_values_in_field": true
    },
    "atom::5404078e81acf976fbd9d6d3": {
      "atom_id": "atom::5404078e81acf976fbd9d6d3",
      "source_handle": "P0486",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "作为增强ICB疗效的潜在干预手段的背景材料，展示从基础机制到临床前转化的路径。",
      "role": "planning",
      "origins": [
