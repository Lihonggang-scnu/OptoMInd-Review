    "atom::f832fed833b228edc2cc6e7c": {
      "atom_id": "atom::f832fed833b228edc2cc6e7c",
      "source_handle": "P0319",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物如何调节ICIs疗效提供了全面的机制背景和临床转化视角。它详细列出了多种代谢物（如SCFAs、胆汁酸、色氨酸衍生物）对特定免疫细胞（DCs、T细胞、巨噬细胞等）的作用路径，并总结了FMT、工程菌等干预策略的临床证据。这对于构建“微生物组-免疫检查点抑制剂”关联的综述至关重要，尤其是用于解释机制异质性和临床转化障碍。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::c183d3c43c6ebd205c205690fc966d52a77942daf7804c18e24bf731c4e7cf85",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::0e3107f67d7e3a063d777ab66ab7d1c0321896bc94acf304803cc8efe5a896e4",
      "multiple_values_in_field": false
    },
    "atom::7dd33101eb5758846b0bf44e": {
