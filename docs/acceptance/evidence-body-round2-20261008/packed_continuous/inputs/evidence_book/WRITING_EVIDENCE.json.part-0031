      "value": {
        "conditions": "免疫表型分析",
        "finding": "响应者中耗竭性T中央记忆细胞和T效应记忆细胞升高；未响应者中CD28和IL10等免疫耗竭标志物升高。"
      },
      "role": "evidence",
      "origins": [
