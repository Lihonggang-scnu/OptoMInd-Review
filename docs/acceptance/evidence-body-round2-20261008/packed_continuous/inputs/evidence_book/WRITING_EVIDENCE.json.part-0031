    "atom::4adc6bae9c80c414c72eb9d4": {
      "atom_id": "atom::4adc6bae9c80c414c72eb9d4",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅针对阿替利珠单抗组；与其他研究中双歧杆菌促进ICI响应的结论相反；需警惕相关性而非因果性；技术验证确认了测序结果的可靠性，但生物学解释尚不明确。",
        "contribution": "报告了基线双歧杆菌属（Bifidobacterium）高丰度与阿替利珠单抗组无临床获益相关，与治疗获益者基线低丰度但治疗后增加的模式。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
          "field_path": [
