            "1"
          ]
        }
      ],
      "variant_group": "field::8afa049cb6067d76828eb2c8bb6a3be3aa4556d8381d286673c9cec630156c6b",
      "multiple_values_in_field": true
    },
    "atom::a0cab142fcd1e6efe6c7ee91": {
      "atom_id": "atom::a0cab142fcd1e6efe6c7ee91",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中讨论特定菌属与ICI疗效关系的复杂性及肿瘤类型特异性。挑战“双歧杆菌总是有益”的简单假设，提示需结合治疗阶段和肿瘤背景解读。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
