            "1"
          ]
        }
      ],
      "variant_group": "field::54e8a43a26bc6167fc29ede7d1c5592e8b427e0ba052706242935573fe2357cb",
      "multiple_values_in_field": true
    },
    "atom::c0296f98b7e2af42e9717c8f": {
      "atom_id": "atom::c0296f98b7e2af42e9717c8f",
      "source_handle": "P0604",
      "field_path": [
