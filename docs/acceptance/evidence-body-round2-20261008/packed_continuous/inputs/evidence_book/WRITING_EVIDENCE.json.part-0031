    "atom::d6edb495e132edc6e98a1e27": {
      "atom_id": "atom::d6edb495e132edc6e98a1e27",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙事性综述方法，系统性地回顾和综合关于宿主-微生物群免疫轴的文献。内容组织逻辑为：1. 技术背景（多组学与成像技术）；2. 基础机制（PRRs、代谢物、细胞因子）；3. 相互作用类型（共生vs致病）；4. 疾病中的免疫改变；5. 具体干预策略的案例研究（益生菌、FMT、饮食、癌症免疫治疗）；6. 挑战与未来展望。未进行系统性检索或定量荟萃分析，而是基于已发表的研究进行定性综合。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::4286e8a16a85894c171f1d71b472ec8071feb16852d4b7b960b722d0b0c8b1ac",
      "multiple_values_in_field": false
    },
    "atom::7cc444f6087aee08377d2abe": {
      "atom_id": "atom::7cc444f6087aee08377d2abe",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了宿主-微生物群免疫轴的全面机制框架，涵盖了从分子受体到系统代谢物的多层次互作。",
        "limits": "作为综述，其结论依赖于所引用的原始研究；对于特定微生物菌株对特定肿瘤类型的因果效应，原文主要提供关联证据和机制假说，而非新的实验验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::70ee2f5af6432e8dbcfa10e6993fbca1c9a004f29c1d23564d21ee92996d4fa4",
      "multiple_values_in_field": true
    },
    "atom::8a5bf9949c84e4012d77b7b8": {
      "atom_id": "atom::8a5bf9949c84e4012d77b7b8",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "总结了微生物组影响癌症免疫检查点抑制剂（ICI）疗效的具体菌属和潜在机制（如丁酸产生、抗原呈递）。",
        "limits": "所引用的临床关联研究多为观察性或小型队列，且不同研究中涉及的菌种和肿瘤类型存在差异，原文未提供跨研究的定量整合或统一预测模型。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::70ee2f5af6432e8dbcfa10e6993fbca1c9a004f29c1d23564d21ee92996d4fa4",
      "multiple_values_in_field": true
    },
    "atom::8748eb70b75e1d58380517a3": {
      "atom_id": "atom::8748eb70b75e1d58380517a3",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "指出了当前微生物组疗法的标准化、个体化差异和长期安全性等关键挑战。",
        "limits": "对于如何解决这些挑战的具体技术方案（如标准化的供体筛选标准、AI模型的泛化能力限制）仅做概述，未提供详细的实施指南或数据支持。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "2"
          ]
        }
      ],
      "variant_group": "field::70ee2f5af6432e8dbcfa10e6993fbca1c9a004f29c1d23564d21ee92996d4fa4",
      "multiple_values_in_field": true
    },
    "atom::1b57516e4e8a6b923e539665": {
      "atom_id": "atom::1b57516e4e8a6b923e539665",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "针对癌症免疫检查点抑制剂（ICIs）疗效",
        "finding": "厚壁菌门（Firmicutes），特别是普拉梭菌（Faecalibacterium prausnitzii）和瘤胃球菌属（Ruminococcus spp.），与抗PD-1/CTLA-4治疗的改善预后相关。机制包括产生丁酸盐促进Treg分化并支持CD8+ T细胞激活，增强树突状细胞成熟及MHC I类表达，以及通过上调紧密连接蛋白维持肠道屏障完整性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::56e2396dd435c008a505a02acf3c7e4bfc88d8fa7aa1b47356dda8fc27f6a5d6",
      "multiple_values_in_field": true
    },
    "atom::c445055530384fa843cfcda9": {
      "atom_id": "atom::c445055530384fa843cfcda9",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "短链脂肪酸（SCFAs）的作用",
        "finding": "SCFAs（如丁酸盐、丙酸盐、乙酸盐）由肠道菌群发酵膳食纤维产生。丁酸盐通过抑制组蛋白去乙酰化酶（HDACs）发挥表观遗传调控作用，促进Treg分化，抑制NF-κB通路，从而减少炎症并维持上皮完整性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::56e2396dd435c008a505a02acf3c7e4bfc88d8fa7aa1b47356dda8fc27f6a5d6",
      "multiple_values_in_field": true
    },
    "atom::ece088b1b83ff85be762b032": {
      "atom_id": "atom::ece088b1b83ff85be762b032",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "粪便微生物移植（FMT）",
        "finding": "FMT在治疗复发性艰难梭菌感染中成功率高达90%。在溃疡性结肠炎和多发性硬化症中显示出恢复微生物多样性、调节免疫反应（如增加Tregs）和改善临床症状的潜力，但长期安全性和效果变异性仍是挑战。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::56e2396dd435c008a505a02acf3c7e4bfc88d8fa7aa1b47356dda8fc27f6a5d6",
      "multiple_values_in_field": true
    },
    "atom::3953e3d1981c342004b88f12": {
      "atom_id": "atom::3953e3d1981c342004b88f12",
      "source_handle": "P0460",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "模式识别受体（PRRs）介导的通讯",
        "finding": "TLRs、NLRs和CLRs识别微生物PAMPs和宿主DAMPs，启动NF-κB、MAPK等信号通路，调控促炎和抗炎细胞因子的平衡，是维持免疫稳态的核心机制。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f47f0deb762603827c8575441762368789ee2be83630a986df1d41f18590463b",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::56e2396dd435c008a505a02acf3c7e4bfc88d8fa7aa1b47356dda8fc27f6a5d6",
      "multiple_values_in_field": true
    },
