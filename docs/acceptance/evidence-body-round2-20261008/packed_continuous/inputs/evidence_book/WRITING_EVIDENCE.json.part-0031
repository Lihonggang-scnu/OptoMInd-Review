      "variant_group": "field::03d9349e46c67507c6a4fd162dbabe772bf9bfd47e2eaa39f87c2b50e0eb5553",
      "multiple_values_in_field": true
    },
    "atom::6552a2eebd1a3ff34c6222d4": {
      "atom_id": "atom::6552a2eebd1a3ff34c6222d4",
      "source_handle": "P0602",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "FMR使用的是广谱抗生素，非特异性清除，不能代表所有菌群变化的影响；未测试补充特定有益菌是否能增强疗效或进一步降低毒性。",
        "contribution": "通过FMR实验证明，清除肠道菌群可以减轻PD-1抑制剂诱导的心肌炎，同时保持抗肿瘤效果，暗示肠道菌群是ICI疗效与毒性平衡中的一个可调节因素。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::98a960a0340563f06718a990ad831efe311fe642fc23eb90abaed535c9f88a8d",
          "field_path": [
