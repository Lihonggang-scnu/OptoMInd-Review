    "atom::a1451f77c812a9294cfe73ef": {
      "atom_id": "atom::a1451f77c812a9294cfe73ef",
      "source_handle": "P0197",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "irAE与供体/菌群关联 (Melanoma)",
        "finding": "13例发生3级以上irAE的患者中，6例（46%）接受了同一供体（D5）的FMT。D5供体的菌群与其他供体显著不同（p<0.01），具有高相对丰度的Prevotella copri。P. copri定植信号与irAE发展相关。接受D5供体FMT的NSCLC患者未出现类似irAE。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
