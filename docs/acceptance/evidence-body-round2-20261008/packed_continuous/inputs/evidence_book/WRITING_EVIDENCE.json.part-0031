    "atom::4eb7c4f60ab3a585e241528a": {
      "atom_id": "atom::4eb7c4f60ab3a585e241528a",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于支持“肠道微生物组多样性影响ICI疗效”的观点，特别是在乳腺癌背景下。可用于讨论不同肿瘤类型中微生物组标志物的一致性或不一致性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::1ff7096bed120980176db78075edf7fcf027d287224195517acf89e71380206d",
