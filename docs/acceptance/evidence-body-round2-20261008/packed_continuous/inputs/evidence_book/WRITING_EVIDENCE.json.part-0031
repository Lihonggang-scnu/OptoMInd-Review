    "atom::4d412512f9bf058a6b7b8958": {
      "atom_id": "atom::4d412512f9bf058a6b7b8958",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅针对心肌炎这一特定irAE，不能直接外推至其他irAEs（如结肠炎、肺炎）或ICI抗肿瘤疗效本身。未涉及微生物组因素。",
        "contribution": "提供了ICI诱导心肌炎的具体免疫机制细节，即通过上调细胞裂解相关基因（PRF1, GNLY, GZM系列）和激活CD8+ T细胞/NK细胞通路导致心肌损伤。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::0c43fa2c387c5e0495486a4056929796aa9b8ab5dace66db005ddcfcdc228e17",
      "multiple_values_in_field": true
    },
    "atom::16776c56cc22e5f20ca6799a": {
      "atom_id": "atom::16776c56cc22e5f20ca6799a",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于解释ICI治疗中“过度免疫激活”如何转化为特定器官毒性。若综述讨论微生物组如何通过调节全身免疫稳态来影响irAEs的发生，此材料可作为“效应器机制”部分的支撑，说明免疫激活后的下游病理后果。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::e3735670b1548942327fa34ba124dc9680b99943490ccad7297babdb7dbe6369",
      "multiple_values_in_field": true
    },
    "atom::c50e3623864e913c2f721289": {
      "atom_id": "atom::c50e3623864e913c2f721289",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "无法回答微生物组如何*调节*疗效的问题。仅能说明ICI治疗后的免疫状态特征，不能建立因果关系。",
        "contribution": "提供了ICI治疗安全性维度的分子证据，表明部分患者存在强烈的细胞毒性免疫反应背景。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::0c43fa2c387c5e0495486a4056929796aa9b8ab5dace66db005ddcfcdc228e17",
      "multiple_values_in_field": true
    },
    "atom::c7347ed264c94687e6c71e05": {
      "atom_id": "atom::c7347ed264c94687e6c71e05",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "作为背景材料，说明ICI治疗不仅关乎疗效，还伴随特定的免疫病理风险。如果综述需要讨论“为什么有些患者对ICI耐受性好而另一些出现严重毒性”，此基因签名可作为宿主免疫反应强度的一个潜在生物标志物维度。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::e3735670b1548942327fa34ba124dc9680b99943490ccad7297babdb7dbe6369",
      "multiple_values_in_field": true
    },
    "atom::177cf393ca250b27c76da8f5": {
      "atom_id": "atom::177cf393ca250b27c76da8f5",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文虽未直接研究肠道微生物组，但深入探讨了ICI治疗的一个关键安全性终点——心肌炎的免疫机制。对于综述而言，它提供了ICI免疫相关不良事件（irAEs）中特定器官损伤的分子图谱，特别是揭示了细胞毒性淋巴细胞在ICI毒性中的作用。这有助于解释为何某些患者会出现严重的系统性免疫反应，从而间接关联到全身免疫状态（可能受微生物组调节）对ICI疗效和毒性的影响。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::d3abb986e9f4c9f7f82ef5ed92e6556e7703308276ec17a38c3831536ba7e796",
      "multiple_values_in_field": false
    },
    "atom::20db9c2989fe938a3caef931": {
      "atom_id": "atom::20db9c2989fe938a3caef931",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该研究为纯生物信息学分析，发现的基因关联仅为统计学相关，非因果证据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "0"
          ]
        }
      ],
      "variant_group": "field::6719de7bf73bef0109fd569d82a5d70dc6ea747b198af2a9057817db1d011bc8",
      "multiple_values_in_field": true
    },
    "atom::bccc3b377eb9dce2914deec9": {
      "atom_id": "atom::bccc3b377eb9dce2914deec9",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "结果来自公共数据集，可能存在批次效应或人群异质性，需在综述中注明其为“预测性”或“假设生成性”证据。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::8db7d226573ffbf52b992735e9c2567365fe574dd629af2c498c1be3b27c6967",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::6719de7bf73bef0109fd569d82a5d70dc6ea747b198af2a9057817db1d011bc8",
      "multiple_values_in_field": true
    },
    "atom::efe6fd10d11ffe2a62a017a1": {
      "atom_id": "atom::efe6fd10d11ffe2a62a017a1",
      "source_handle": "P0596",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "不直接涉及肠道微生物组，将其纳入综述时需明确其作为“下游效应机制”或“安全性背景”的角色，而非直接解释微生物组调节作用的中间变量。",
      "role": "evidence",
      "origins": [
