    "atom::9a22606753b19d93fc2deb50": {
      "atom_id": "atom::9a22606753b19d93fc2deb50",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "As a narrative review, the authors conducted a literature search and synthesis of both preclinical (animal models) and clinical studies. They organized the discussion around three main themes: the general influence of gut microbiota on ICI efficacy, the relationship between microbiota and irAEs (specifically myocarditis), proposed molecular mechanisms (molecular mimicry, Treg suppression, cytokine networks), and therapeutic applications (antibiotics, other drugs like PPIs/statins). The approach relies on interpreting correlations and mechanistic hypotheses from cited works rather than conducting new primary experiments.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::acf1f9ed263ef779ede4fbdba38791f226c54227ca5fadcb949905611f2f4ce9",
      "multiple_values_in_field": false
    },
    "atom::f25613981fd49fcc49b87542": {
      "atom_id": "atom::f25613981fd49fcc49b87542",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides a structured synthesis of the 'gut-heart axis' in the context of cardio-oncology, linking specific microbial taxa (Flexispira, Ruminococcaceae, Bacteroides) to ICI-associated myocarditis pathology based on available preclinical and clinical data.",
        "limits": "The review is narrative and does not present a systematic meta-analysis. Most mechanistic insights are inferred from animal models or other irAEs; direct clinical evidence for microbiota causality in myocarditis is limited. The therapeutic potential of microbiota modulation remains hypothetical and unvalidated in human trials."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::01450624e5ec3f13718838fca4bd54680e34a28ebd292c8279048c577d19e869",
      "multiple_values_in_field": true
    },
    "atom::4a2784cea5bf2f3e32cb2747": {
      "atom_id": "atom::4a2784cea5bf2f3e32cb2747",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Highlights the critical trade-off between using antibiotics to prevent myocarditis and their potential to compromise ICI anti-tumor efficacy, identifying this as a key research gap.",
        "limits": "Does not provide quantitative data on the magnitude of this trade-off across different cancer types or ICI regimens. The heterogeneity of cardiac adverse events across cancer types is noted but not analyzed."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::01450624e5ec3f13718838fca4bd54680e34a28ebd292c8279048c577d19e869",
      "multiple_values_in_field": true
    },
    "atom::100b6b061df5e1bb7d2daeba": {
      "atom_id": "atom::100b6b061df5e1bb7d2daeba",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Preclinical mouse models treated with PD-1 inhibitors",
        "finding": "Depletion of specific gut bacteria (e.g., Flexispira, Ruminococcaceae) using antibiotics reduced inflammatory cell infiltration and myocardial injury area. Conversely, these bacteria showed positive correlations with cardiac injury markers and negative correlations with cardioprotective factors."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::dfae631145781180c6a795bed0c0d0fbc5ed966609f442334ece554a2c43ebde",
      "multiple_values_in_field": true
    },
    "atom::ac618138ef56a8024c332180": {
      "atom_id": "atom::ac618138ef56a8024c332180",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Clinical observations of patients with irAEs",
        "finding": "Patients developing severe irAEs, including myocarditis, exhibited higher abundance of pathobionts and decreased relative abundance of Ruminococcaceae. Bacteroides levels dynamically changed during irAE onset and remission."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
          "field_path": [
