    },
    "atom::f14013f0ea99c78546419dcc": {
      "atom_id": "atom::f14013f0ea99c78546419dcc",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "研究未分析抗生素使用对结果的潜在混淆影响，这是一个重要的局限性。",
      "role": "evidence",
      "origins": [
        {
