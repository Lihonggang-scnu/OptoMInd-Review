            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::edc5cc3585448499dc5152c171e92ffb6ba3a9d297946553bed1fbbcdcff93ec",
      "multiple_values_in_field": false
    },
