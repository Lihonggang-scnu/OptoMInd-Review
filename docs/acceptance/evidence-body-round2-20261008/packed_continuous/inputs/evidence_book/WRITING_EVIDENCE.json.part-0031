    "atom::793bf60ef299d402e03684dc": {
      "atom_id": "atom::793bf60ef299d402e03684dc",
      "source_handle": "P0597",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇综述，本研究未进行新的实验数据采集。其综合路线为：1. 文献回顾：汇总关于HLA与心肌炎/DCM关联的候选基因研究、GWAS信号、动物模型及转基因模型证据；2. 机制整合：将观察到的遗传关联与免疫学机制（如抗原呈递、T细胞激活、分子模拟、微生物组交叉反应）相结合，构建病理生理框架；3. 批判性评估：分析现有研究在效应大小、人群多样性和临床转化方面的不足；4. 提出建议：基于上述分析，提出未来研究优先事项（如多民族队列、免疫基因组整合）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::403b70186842af42ce31ed58334f0270beb3caf28b3d3ab63299b6b3e475d62c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::8b8b9d1572f24ee070cbc5c3a37cf3a6369f3c8839ca0362ef940c8481838d61",
      "multiple_values_in_field": false
    },
    "atom::7a9996e802273453b370bbf6": {
      "atom_id": "atom::7a9996e802273453b370bbf6",
      "source_handle": "P0597",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统整合了HLA在心肌炎/DCM中的遗传关联与免疫机制，特别是强调了HLA-II类分子在打破免疫耐受和驱动自身免疫中的核心作用，以及微生物组作为潜在分子模拟源的新兴证据。",
        "limits": "所给摘要未交代具体的文献检索策略、纳入排除标准及质量评价方法；主要依赖已发表的研究结果进行叙述性综合，缺乏定量荟萃分析数据；对具体HLA等位基因与特定病毒表位的精确对应关系尚不明确。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::403b70186842af42ce31ed58334f0270beb3caf28b3d3ab63299b6b3e475d62c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::fc7fc97081cd83ed68cced569362e2d88f09c1e95c2674a005ba6821dfb3148f",
      "multiple_values_in_field": false
    },
    "atom::f6a19cf0cb52e0209022dc5c": {
      "atom_id": "atom::f6a19cf0cb52e0209022dc5c",
      "source_handle": "P0597",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定HLA等位基因存在时",
        "finding": "HLA-DR4、HLA-B27等风险等位基因与特发性DCM及心肌炎易感性增加相关；HLA-DR3可能具有保护作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::403b70186842af42ce31ed58334f0270beb3caf28b3d3ab63299b6b3e475d62c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::a4596816d1bffacfda510594bd9634d3d0adf7ffcd40720157e26a3128186339",
      "multiple_values_in_field": true
    },
    "atom::88079a6f8d092733e33eba9a": {
      "atom_id": "atom::88079a6f8d092733e33eba9a",
      "source_handle": "P0597",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "病毒感染背景下",
        "finding": "HLA多态性影响病毒清除效率；低效呈递可能导致病毒持续存在，而高效呈递可能引发旁观者损伤或分子模拟，触发针对心脏自身抗原（如肌球蛋白）的自身免疫反应。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::403b70186842af42ce31ed58334f0270beb3caf28b3d3ab63299b6b3e475d62c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::a4596816d1bffacfda510594bd9634d3d0adf7ffcd40720157e26a3128186339",
      "multiple_values_in_field": true
    },
    "atom::e7d5b8c5926100b2134ee999": {
      "atom_id": "atom::e7d5b8c5926100b2134ee999",
      "source_handle": "P0597",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "转基因小鼠模型中",
        "finding": "表达人类HLA-DQ8的转基因小鼠在无感染情况下自发产生自身免疫性心肌炎，证明特定HLA等位基因可直接降低自身免疫阈值。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::403b70186842af42ce31ed58334f0270beb3caf28b3d3ab63299b6b3e475d62c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::a4596816d1bffacfda510594bd9634d3d0adf7ffcd40720157e26a3128186339",
      "multiple_values_in_field": true
    },
    "atom::c5ad4c7bc248aa8aec498433": {
      "atom_id": "atom::c5ad4c7bc248aa8aec498433",
      "source_handle": "P0597",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "微生物组交互中",
        "finding": "肠道共生菌（如拟杆菌属）产生的肽段可能与心脏肌球蛋白表位发生分子模拟，激活自体反应性CD4+ T细胞，且抗生素干预可预防该过程。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::403b70186842af42ce31ed58334f0270beb3caf28b3d3ab63299b6b3e475d62c",
          "field_path": [
