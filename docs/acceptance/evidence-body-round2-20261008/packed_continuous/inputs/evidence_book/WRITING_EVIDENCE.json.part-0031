            "2"
          ]
        }
      ],
      "variant_group": "field::e08152760f5b54b106db704667a3a49222c73581bb34a00eccba39f6dd4f9148",
      "multiple_values_in_field": true
    },
    "atom::7375d41738b59f0adc851412": {
      "atom_id": "atom::7375d41738b59f0adc851412",
      "source_handle": "P0596",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "药物预测结果",
        "finding": "通过cMAP数据库预测，乙酰羟肟酸（acetohydroxamic acid）具有最高的连接评分，提示在ICI治疗中需对该类药物保持警惕。"
      },
      "role": "evidence",
      "origins": [
        {
