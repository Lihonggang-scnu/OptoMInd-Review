    "atom::fa97cabc8d3095eabf75e774": {
      "atom_id": "atom::fa97cabc8d3095eabf75e774",
      "source_handle": "P0197",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅限早期探索性研究，无对照组，结果可能受选择偏倚影响。不能直接推断普适性疗效。",
        "contribution": "提供了FMT联合ICI在实体瘤中的客观缓解率（ORR）数据：NSCLC中80%，黑色素瘤中75%。同时指出毒性谱系的巨大差异：NSCLC无3级以上irAE，而黑色素瘤双ICI组高达65%。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::115dd28532997e00fe01b254c577a3bbd7d9e51a34202fcecb994e8c10d15a72",
          "field_path": [
