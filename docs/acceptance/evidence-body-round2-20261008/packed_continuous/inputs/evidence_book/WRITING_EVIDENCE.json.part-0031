      "atom_id": "atom::1bc5efdd3aa6539736d4af68",
      "source_handle": "P0598",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "The review establishes myocarditis as a high-mortality (25%-50%) complication of ICIs and introduces the concept of the gut-heart axis in cardiovascular disease, extending it to cardio-oncology."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
