          ]
        }
      ],
      "variant_group": "field::7c6e8bb2a517473e077839d3409a64aa7c7630c5f1f008aa06dcc3c29ea75783",
      "multiple_values_in_field": true
    },
    "atom::b9a6a65235d29e1700adcfc1": {
      "atom_id": "atom::b9a6a65235d29e1700adcfc1",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "整体微生物组特征与毒性/响应的关联",
        "finding": "未发现真菌与响应或毒性显著相关。Bacteroides属的高丰度与irAEs显著相关，也与ICI响应一致。富含Bacteroides且缺乏Prevotella的微生物组特征与ICI响应相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
