    "atom::113e9e20f0d8f5063d9b919f": {
      "atom_id": "atom::113e9e20f0d8f5063d9b919f",
      "source_handle": "P0319",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "旨在解决肿瘤免疫治疗（特别是ICIs）响应率低、异质性大及耐药性问题，通过解析微生物-代谢物-免疫轴的复杂互作，为阐明个体差异和克服耐药提供理论框架。",
      "role": "evidence",
