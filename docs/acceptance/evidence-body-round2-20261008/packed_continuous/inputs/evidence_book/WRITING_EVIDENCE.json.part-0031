            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::dfae631145781180c6a795bed0c0d0fbc5ed966609f442334ece554a2c43ebde",
      "multiple_values_in_field": true
    },
    "atom::805f8088e2013333681d00a0": {
      "atom_id": "atom::805f8088e2013333681d00a0",
      "source_handle": "P0598",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Mechanistic hypotheses derived from preclinical and autoimmune data",
        "finding": "Proposed mechanisms include molecular mimicry where microbial epitopes cross-react with heart tissue, and dysbiosis leading to suppressed Treg function and amplified pro-inflammatory cytokine responses (e.g., CXCL9/10, TNF-α)."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ce5771d0255e802db4f7094688ef0fc074634a1308a0880d7e7de7f274e3b6aa",
