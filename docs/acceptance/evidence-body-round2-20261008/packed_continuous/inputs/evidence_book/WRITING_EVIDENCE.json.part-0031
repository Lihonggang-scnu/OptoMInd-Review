      "value": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch6.json",
        "source_handle": "P0447",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\c59738fb3db453360d9f86e97ad338176abe8eb6\\42993142a6b2e557adda307d103ec858\\attempt-01\\PAPER_READING_CARD.json"
