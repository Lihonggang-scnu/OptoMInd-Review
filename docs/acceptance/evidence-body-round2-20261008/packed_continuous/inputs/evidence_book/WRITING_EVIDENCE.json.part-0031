    "atom::d38dbbee702680001d276888": {
      "atom_id": "atom::d38dbbee702680001d276888",
      "source_handle": "P0604",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法。综合现有的动物实验研究（主要是小鼠自身免疫性心肌炎模型）、体外细胞共培养实验数据以及部分人类临床研究结果。重点梳理TN-C的表达时空特征、其与树突状细胞的相互作用机制（特别是TLR4信号通路）、对T细胞极化（Th17）的影响，并结合其他免疫机制（如分子模拟、表位扩散、肠道菌群交叉反应）进行系统性解释。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::eaa5eb691eb7f9a7f497a2614c94467c8f3a48d5173c7cebb8bb2c9844711381",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::81f7c1840b19499e137d02ec01f42f95deee919b22dc3ade3090bd2f546cf00c",
      "multiple_values_in_field": false
    },
    "atom::d877320ec8ce00aae1d70114": {
      "atom_id": "atom::d877320ec8ce00aae1d70114",
      "source_handle": "P0604",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统总结了TN-C作为局部炎症调节剂在心肌炎病理中的机制，提出了TN-C-TLR4-DCs-Th17轴的具体分子路径。",
        "limits": "所给摘要未交代具体的文献检索策略和筛选标准。主要证据来源于小鼠模型和部分体外实验，直接外推至人类的因果链条尚需更多临床干预研究验证。作者承认目前缺乏针对TN-C功能的抑制治疗尝试，且动物模型与人类疾病的差异仍是知识空白。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::eaa5eb691eb7f9a7f497a2614c94467c8f3a48d5173c7cebb8bb2c9844711381",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::b6b862178c5ca064139ce4f035946ea3119881bc957fc9a5d296794094cfd004",
      "multiple_values_in_field": false
    },
    "atom::ae47e582b3cd8ea73585d560": {
      "atom_id": "atom::ae47e582b3cd8ea73585d560",
      "source_handle": "P0604",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "小鼠自身免疫性心肌炎模型及体外实验",
        "finding": "TN-C在炎症细胞浸润和组织坏死前即可检测到，并在活动性炎症期强表达，愈合后消失。TN-C缺陷小鼠表现出较轻的心肌炎症状，且心脏中Th17细胞浸润减少。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::eaa5eb691eb7f9a7f497a2614c94467c8f3a48d5173c7cebb8bb2c9844711381",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::aa7dea21556350e12f9fd2dfae406b194ffee232aba331717f5c6131fd27f511",
      "multiple_values_in_field": true
    },
    "atom::63c6dec03dbbc08d397b1a9d": {
      "atom_id": "atom::63c6dec03dbbc08d397b1a9d",
      "source_handle": "P0604",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "体外树突状细胞（DCs）与T细胞共培养",
        "finding": "TN-C通过激活DCs上的TLR4受体，诱导DCs分泌高水平的IL-6、IL-1β和GM-CSF。这些细胞因子共同作用，促使初始CD4+ T细胞分化为Th17细胞。阻断IL-6或TLR4信号可抑制这一过程。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::eaa5eb691eb7f9a7f497a2614c94467c8f3a48d5173c7cebb8bb2c9844711381",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::aa7dea21556350e12f9fd2dfae406b194ffee232aba331717f5c6131fd27f511",
      "multiple_values_in_field": true
    },
    "atom::920d3654c76386723acc3f47": {
      "atom_id": "atom::920d3654c76386723acc3f47",
      "source_handle": "P0604",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "人类心肌炎/炎症性心肌病患者",
        "finding": "患者血清中TN-C水平升高，可作为评估疾病活动和预测预后的生物标志物，尤其在结合BNP时具有更高的预测价值。患者体内Th17相关细胞因子水平升高。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::eaa5eb691eb7f9a7f497a2614c94467c8f3a48d5173c7cebb8bb2c9844711381",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
