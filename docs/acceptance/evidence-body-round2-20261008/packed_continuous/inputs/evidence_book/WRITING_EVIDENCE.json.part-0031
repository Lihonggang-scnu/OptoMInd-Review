    "atom::a4d0ee0831533fee50e5bc04": {
      "atom_id": "atom::a4d0ee0831533fee50e5bc04",
      "source_handle": "P0067",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于讨论治疗对微生物组的扰动及其潜在后果（如可能导致耐药）。为后续研究微生物组干预时机和策略提供线索。",
      "role": "planning",
