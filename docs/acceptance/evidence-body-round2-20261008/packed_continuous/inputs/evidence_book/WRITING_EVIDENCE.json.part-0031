    "atom::6309ef681b45043aedd07e9f": {
      "atom_id": "atom::6309ef681b45043aedd07e9f",
      "source_handle": "P0486",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "主要聚焦于结直肠癌（CRC），虽然提及黑色素瘤等其他癌症作为类比，但核心机制和数据多源于CRC模型。对于其他实体瘤的直接外推需谨慎。",
        "contribution": "提供了肠道微生物代谢物影响ICB疗效的具体机制证据。具体而言，它描述了有害代谢物（如琥珀酸、次级胆汁酸）如何通过抑制效应T细胞功能和招募抑制性细胞导致ICB耐药；同时描述了有益代谢物（如丁酸盐、肌苷、IPA）如何通过表观遗传修饰和受体激活增强T细胞功能，从而提高ICB敏感性。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c00cf96a1c40711a1f547ab22b358fd426fde384d108c3eb0f8c25b68252d73a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::70a758a19a8574678c955819d18d1b56367f9e7fef727b673065122e065d057d",
      "multiple_values_in_field": true
    },
    "atom::f9c401f79c57ed5eb7c7a46d": {
      "atom_id": "atom::f9c401f79c57ed5eb7c7a46d",
      "source_handle": "P0486",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“肠道微生物组如何调节实体瘤中ICB的疗效”这一问题，提供分子层面的解释和正反两方面的案例。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::c00cf96a1c40711a1f547ab22b358fd426fde384d108c3eb0f8c25b68252d73a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::a7a42938dbd5105ec1dba39bb40e2dccfb46b63d7862470606d5c860ae178c1b",
      "multiple_values_in_field": true
    },
    "atom::b32be1f0439d45e8e744c286": {
      "atom_id": "atom::b32be1f0439d45e8e744c286",
      "source_handle": "P0486",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节基于动物模型（如Apc Min/+小鼠）或细胞系研究，其在人体内的确切效力和剂量依赖性尚未完全确立。",
        "contribution": "详细阐述了介导上述效应的具体分子机制，包括：1) 代谢物对免疫细胞受体（如AHR, GPR43, TLR5）的激活；2) 对信号通路（如cGAS-STING, NF-κB, WNT/β-catenin）的调控；3) 对表观遗传酶（HDACs, DNMTs）的影响；4) 对细胞因子和趋化因子（如CXCL3, IL-12, IFN-γ）分泌的调节。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c00cf96a1c40711a1f547ab22b358fd426fde384d108c3eb0f8c25b68252d73a",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::70a758a19a8574678c955819d18d1b56367f9e7fef727b673065122e065d057d",
      "multiple_values_in_field": true
    },
    "atom::09972558058dc513a2b6e09b": {
      "atom_id": "atom::09972558058dc513a2b6e09b",
      "source_handle": "P0486",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于回答“哪些机制介导了这种效应”，提供从代谢物到免疫细胞功能再到治疗响应的完整因果链条细节。",
      "role": "planning",
      "origins": [
