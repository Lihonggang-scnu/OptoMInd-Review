            "2"
          ]
        }
      ],
      "variant_group": "field::7c6e8bb2a517473e077839d3409a64aa7c7630c5f1f008aa06dcc3c29ea75783",
      "multiple_values_in_field": true
    },
    "atom::a5c666c5f616d2a23da568a3": {
      "atom_id": "atom::a5c666c5f616d2a23da568a3",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "empirical",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::11ae43ba7c80588e2a10e0571c777660b3da422ccddf1fbd5c7fd0451731fdd8",
      "multiple_values_in_field": false
    },
    "atom::a6b817380c5901818a136666": {
      "atom_id": "atom::a6b817380c5901818a136666",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "既往研究表明irAE的发生与治疗响应相关，但二者往往难以解耦。本研究试图解决的核心问题是：肠道微生物组是否能在不同时间点（基线、irAE发生时、12周）独立预测ICI治疗的响应或毒性？特别是能否找到能区分“有效但有副作用”与“有效且无副作用”患者的微生物特征，从而为临床管理提供潜在的生物标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::8c43a7b4558ee7fc4f049a9092fe749180cc7f6c28d3ecf810f00d3c504a338f",
      "multiple_values_in_field": false
    },
    "atom::74f9995c67b241b47c1c563d": {
      "atom_id": "atom::74f9995c67b241b47c1c563d",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "转移性黑色素瘤患者，接受免疫检查点抑制剂（ICI）治疗；研究聚焦于肠道微生物组在基线、irAE发生期间及12周时的动态变化与临床结局（响应/毒性）的关联。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::7712f7b75f807ddbf8f397172f3dd9624351ee6c6e4141fbc688e1d1ba1ca336",
      "multiple_values_in_field": false
    },
    "atom::979c21845a0e3c516f0051d0": {
      "atom_id": "atom::979c21845a0e3c516f0051d0",
      "source_handle": "P0239",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本研究旨在确定转移性黑色素瘤患者在ICI治疗过程中，肠道微生物组的组成能否预测治疗响应或免疫相关不良事件（irAEs）。研究纳入了88名患者，其中48名为转移性疾病患者，32名可评估响应。通过纵向采集粪便样本并进行宏基因组鸟枪法测序，分析特定微生物丰度与ORR、PFS及irAEs之间的关联。研究发现某些细菌和噬菌体与响应或非响应显著相关，且存在能够区分“有irAE的响应者”与“无irAE的响应者”的特异性微生物标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::9d217ad5123b937f60bcf0d8d64567abca5394e4493cb8c022cd3c18fb8e9cb1",
      "multiple_values_in_field": false
    },
    "atom::ada13f072d73f50580c634e8": {
      "atom_id": "atom::ada13f072d73f50580c634e8",
      "source_handle": "P0239",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文提供了关于肠道微生物组如何关联ICI疗效与毒性的具体实证数据，特别是揭示了可以‘解耦’响应与毒性的微生物特征（如Eubacterium vs Bacteroides亚种）。这对于综述中讨论‘微生物组作为预测生物标志物的潜力’以及‘不同微生物群落在疗效与安全性权衡中的不同作用’具有直接参考价值。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::6d44cd2c7559aff83e5babc61712c6c1b7dc8bb23ab435600847cf9107055b3b",
      "multiple_values_in_field": false
    },
    "atom::162f1683c7d1f23ac12fadad": {
      "atom_id": "atom::162f1683c7d1f23ac12fadad",
      "source_handle": "P0239",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "仅为观察性关联，不能证明因果关系。样本局限于黑色素瘤，可能不适用于所有实体瘤。",
        "contribution": "提供了具体的微生物物种水平证据，表明特定菌群（如Bacteroides, Blautia）与ICI响应正相关，而Prevotella与无响应相关。同时指出了Bacteroides丰度与irAEs的正相关性。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::cc748712c94d969a09e8c3491567f225ababcd142f9fd71a5b7e17dfa24d41b0",
      "multiple_values_in_field": true
    },
    "atom::833fb556094acf2a9fdfff8c": {
      "atom_id": "atom::833fb556094acf2a9fdfff8c",
      "source_handle": "P0239",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于支持综述中关于‘哪些微生物促进或抑制ICI疗效’的论点，以及‘微生物组特征与免疫毒性风险’的关联部分。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::752df8ff448a789477de82ce431f732fd51fece077a1a4b2f8cadb29b76a814b",
          "field_path": [
