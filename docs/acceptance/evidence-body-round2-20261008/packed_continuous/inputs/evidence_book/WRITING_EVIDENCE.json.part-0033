    "atom::984b10a4e42684438bc48144": {
      "atom_id": "atom::984b10a4e42684438bc48144",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "指出小鼠模型与人类生理的差异、抗生素使用的混杂效应、饮食和环境因素的影响、以及病毒组和真菌组的潜在作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
