    "atom::acb1f02292f978c4fafc718b": {
      "atom_id": "atom::acb1f02292f978c4fafc718b",
      "source_handle": "P0566",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "该综述主要聚焦于 NSCLC，SCLC 的证据几乎空白，结论不能直接推广到小细胞肺癌。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "review_planning_B",
