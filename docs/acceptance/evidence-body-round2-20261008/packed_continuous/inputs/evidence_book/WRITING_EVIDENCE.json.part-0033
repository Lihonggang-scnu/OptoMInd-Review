    "atom::b84ed6716d0ba04d1ca19553": {
      "atom_id": "atom::b84ed6716d0ba04d1ca19553",
      "source_handle": "P0024",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可作为机制探讨的参考案例，说明微生物如何通过代谢产物影响宿主。若综述涉及“微生物代谢产物介导免疫调节”的通用机制，此文可提供具体的代谢路径实例（尽管是在HIV背景下）。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::c34b473f98dc1a3df1e0ea42dcf2307693386d718055834549140219a91a2d79",
