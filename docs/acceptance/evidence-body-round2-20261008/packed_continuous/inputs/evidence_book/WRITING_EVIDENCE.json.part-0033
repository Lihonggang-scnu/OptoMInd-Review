      "multiple_values_in_field": true
    },
    "atom::86d5060efa71ce51a0afebd1": {
      "atom_id": "atom::86d5060efa71ce51a0afebd1",
      "source_handle": "P0059",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "提供微生物-代谢物-癌症轴的机制背景",
      "role": "planning",
