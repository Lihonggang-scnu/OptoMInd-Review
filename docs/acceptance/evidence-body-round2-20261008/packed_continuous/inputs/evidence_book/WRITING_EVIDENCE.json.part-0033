      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca394ec40bbe18e5f5985500ebf160bde94da9c1bac8b5be527d38c7351049f1",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::67cd88898eb9b89c149316823516792ee0872f990d04b36f78989635a0dbaa71",
