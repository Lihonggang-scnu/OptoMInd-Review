      "multiple_values_in_field": true
    },
    "atom::c4a4cab39ade76a97f52aa7e": {
      "atom_id": "atom::c4a4cab39ade76a97f52aa7e",
      "source_handle": "P0561",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
