            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::22e0dced0e53b5047fa7d414d4a058d99b919ff103ab726f6ccdee1dbd50a240",
      "multiple_values_in_field": true
    },
    "atom::5593e484d649346af1870002": {
      "atom_id": "atom::5593e484d649346af1870002",
      "source_handle": "P0367",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于综述中描述癌症相关菌群失调的特征，或作为微生物组影响ICI疗效的背景证据，展示疾病状态下的微生物组基线变化。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::840d8841ea6e1ad6220e22bfd4d53b13529dd74bad36c51f32776d77237925cd",
