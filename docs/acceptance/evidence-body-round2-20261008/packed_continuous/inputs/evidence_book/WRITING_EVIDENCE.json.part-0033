            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::bbc3136655b1564c41d1650064a7671b689270a17c95781184ff7e90b6f9dba4",
      "multiple_values_in_field": true
    },
    "atom::d000b902024313e63163e159": {
      "atom_id": "atom::d000b902024313e63163e159",
      "source_handle": "P0031",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "本文本身未阐明具体机制路径，仅作为问题提出的来源；其提到的机制多为一般性描述，缺乏针对固体瘤微环境的特异性解释。",
        "contribution": "提出了微生物组通过代谢产物（促进或抑制肿瘤生长）和影响免疫反应来参与疾病进程的假设性机制框架；指出了因果推断困难是当前知识瓶颈。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::685224e9339ec834861ba17ff7c28460d2405bc36e62193c07d5eecded9f75d3",
          "field_path": [
