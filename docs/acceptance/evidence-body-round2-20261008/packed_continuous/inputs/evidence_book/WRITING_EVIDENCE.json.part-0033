    "atom::3690087e9bf834aa5c74a070": {
      "atom_id": "atom::3690087e9bf834aa5c74a070",
      "source_handle": "P0375",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "文章中提到的细菌物种（如Faecalibacterium, Akkermiasia）在不同研究中的关联可能存在冲突，不能简单视为普适性标志物。",
      "role": "evidence",
      "origins": [
