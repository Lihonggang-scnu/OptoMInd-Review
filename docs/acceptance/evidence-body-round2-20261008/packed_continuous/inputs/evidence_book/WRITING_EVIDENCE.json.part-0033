    "atom::1fd06e0624ce56a056b016c7": {
      "atom_id": "atom::1fd06e0624ce56a056b016c7",
      "source_handle": "P0566",
      "field_path": [
        "review_planning_B",
        "broader_review_uses"
      ],
      "value": {
        "material": "提及 FMT-LUMINate 试验等早期阶段 FMT 干预数据，显示在 PD-L1 高表达 NSCLC 患者中取得高客观缓解率。"
      },
      "role": "evidence",
      "origins": [
