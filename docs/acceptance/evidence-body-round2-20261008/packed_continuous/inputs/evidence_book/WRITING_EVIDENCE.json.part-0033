    "atom::ed99ee349cf7e2108d0c9964": {
      "atom_id": "atom::ed99ee349cf7e2108d0c9964",
      "source_handle": "P0024",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用纵向队列设计，纳入HIV感染者和健康对照者。在基线（ART前）、治疗后6个月和治疗后12个月三个时间点收集样本。使用全基因组宏基因组测序技术获取微生物数据，结合生物信息学分析方法解析微生物群落结构（分类学组成）并推断其功能（代谢通路）。通过组间比较和时间序列分析来评估ART干预下的动态变化。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c34b473f98dc1a3df1e0ea42dcf2307693386d718055834549140219a91a2d79",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::3b82023675ae0ca5ffe207d0db897ae7d1284e020c45732718487d4677cb2766",
      "multiple_values_in_field": false
    },
    "atom::546dc499ea44116be66a96fd": {
      "atom_id": "atom::546dc499ea44116be66a96fd",
      "source_handle": "P0024",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了HIV感染者在接受ART治疗前后肠道微生物组和代谢通路变化的纵向数据，证实了ART仅能部分恢复微生物失调。",
        "limits": "所给材料未交代具体的统计显著性水平、样本量大小、HIV感染者的临床分期/CD4计数等混杂因素控制情况，也未明确说明是否建立了严格的因果关系证据链。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c34b473f98dc1a3df1e0ea42dcf2307693386d718055834549140219a91a2d79",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::f21e8017d9cdc5edb44bb08119e17f06c5676998978a4577d7272f5f590b7505",
      "multiple_values_in_field": false
    },
    "atom::3d287971f46755b7b6042a2b": {
      "atom_id": "atom::3d287971f46755b7b6042a2b",
      "source_handle": "P0024",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ART治疗前 vs HIV阴性对照",
        "finding": "HIV感染者表现出显著的肠道微生物失调，特征为促炎微生物的富集以及拟杆菌门（Bacteroidetes）比例的降低。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c34b473f98dc1a3df1e0ea42dcf2307693386d718055834549140219a91a2d79",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::a7c56e7e15e66d77aba19cdef80876438efff01f1b88606bffc948df0a145ee4",
      "multiple_values_in_field": true
    },
    "atom::6147fe50b1a75a1346e5d56b": {
      "atom_id": "atom::6147fe50b1a75a1346e5d56b",
      "source_handle": "P0024",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "ART治疗后6-12个月",
        "finding": "随着ART治疗的进行，变形菌门（Proteobacteria）的比例下降并持续至12个月；拟杆菌门比例先升后降。整体失调未完全逆转。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c34b473f98dc1a3df1e0ea42dcf2307693386d718055834549140219a91a2d79",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::a7c56e7e15e66d77aba19cdef80876438efff01f1b88606bffc948df0a145ee4",
      "multiple_values_in_field": true
    },
    "atom::d80efe1c4773c92faac2b3a1": {
      "atom_id": "atom::d80efe1c4773c92faac2b3a1",
      "source_handle": "P0024",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "代谢通路分析",
        "finding": "丙酮酸发酵至异丁醇的代谢通路改变在HIV感染者中持续存在，即使经过12个月的ART治疗仍未恢复。该机制的改变与Ruminococcus bromii物种丰度的降低呈相关性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::c34b473f98dc1a3df1e0ea42dcf2307693386d718055834549140219a91a2d79",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::a7c56e7e15e66d77aba19cdef80876438efff01f1b88606bffc948df0a145ee4",
      "multiple_values_in_field": true
    },
