    "atom::16131621d0424b348f162b60": {
      "atom_id": "atom::16131621d0424b348f162b60",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用结构化但非系统的文献检索策略，基于 PubMed/MEDLINE, Embase, Scopus (2015-2026) 及会议摘要。优先纳入肺癌相关的临床队列和随机数据，补充机制性临床前研究。通过叙述性综合方法，整合不同研究关于微生物组成、多样性、代谢功能及临床混杂因素的发现，对比肠道与口腔微生物组的预测价值，并评估现有证据的方法学局限性和转化前景。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::4e648946d695cd08346b383d6644ebf227415f702a6a454f12406050446c1971",
      "multiple_values_in_field": false
    },
    "atom::e8730e7cd201aaca9a764fdd": {
      "atom_id": "atom::e8730e7cd201aaca9a764fdd",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肺癌 ICI 治疗中肠道与口腔微生物组预测价值的对比综述，明确了肠道微生物组更强的预测一致性，并指出了口腔微生物组的情境依赖性（仅在与化疗联用时可能有效）。",
        "limits": "作为叙事性综述，未应用 PRISMA 协议或正式偏倚风险评估；证据主要来自回顾性、单中心、小样本研究，缺乏前瞻性外部验证；SCLC 数据严重缺失；大多数研究未充分调整临床混杂因素。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::151dfbaf545148e8324439bef7a0a14e74001594f2d273d3c1c40acc1763597a",
      "multiple_values_in_field": false
    },
    "atom::0ff179b525de417fc3453d26": {
      "atom_id": "atom::0ff179b525de417fc3453d26",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "NSCLC 患者，高肠道微生物 alpha 多样性",
        "finding": "与改善的 PFS 和 OS 一致相关；作者指出这是跨地理人群稳健的指标。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::7c34fcd6d5a33ae2e3d644c7008655b5017362df785371566f09e5f8648e500b",
      "multiple_values_in_field": true
    },
    "atom::915d97969810c208a1b1dfee": {
      "atom_id": "atom::915d97969810c208a1b1dfee",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "特定有益菌属富集 (Akkermansia muciniphila, Faecalibacterium prausnitzii, Bifidobacterium)",
        "finding": "与增强的 ICI 疗效相关；但 Akkermansia 的作用呈剂量依赖性，过度富集可能关联免疫抑制环境。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::7c34fcd6d5a33ae2e3d644c7008655b5017362df785371566f09e5f8648e500b",
      "multiple_values_in_field": true
    },
    "atom::6ea15ea0aa6712ed0c9eb521": {
      "atom_id": "atom::6ea15ea0aa6712ed0c9eb521",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "使用抗生素或 PPI",
        "finding": "诱导菌群失调，显著降低 PFS 和 OS；抗生素在 ICI 启动前后 30-60 天使用影响最强。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::7c34fcd6d5a33ae2e3d644c7008655b5017362df785371566f09e5f8648e500b",
      "multiple_values_in_field": true
    },
    "atom::783f657ba50dbc2d934e71b6": {
      "atom_id": "atom::783f657ba50dbc2d934e71b6",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "口腔/唾液微生物组",
        "finding": "预测价值有限且不一致；仅在局部晚期 NSCLC 接受放化疗联合免疫治疗的患者中观察到较高颊部微生物多样性与改善 PFS 的关联，而在转移性 ICI 单药治疗中无显著差异。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::7c34fcd6d5a33ae2e3d644c7008655b5017362df785371566f09e5f8648e500b",
      "multiple_values_in_field": true
    },
    "atom::6ab4403099f415c643bd0258": {
      "atom_id": "atom::6ab4403099f415c643bd0258",
      "source_handle": "P0566",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "功能性代谢标记 vs. 分类学标记",
        "finding": "功能性代谢能力（如 SCFA 产生通路）比单纯的分类学组成更可靠地预测 PFS；机器学习模型结合功能通路优于简单分类谱。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "4"
          ]
        }
      ],
      "variant_group": "field::7c34fcd6d5a33ae2e3d644c7008655b5017362df785371566f09e5f8648e500b",
      "multiple_values_in_field": true
    },
