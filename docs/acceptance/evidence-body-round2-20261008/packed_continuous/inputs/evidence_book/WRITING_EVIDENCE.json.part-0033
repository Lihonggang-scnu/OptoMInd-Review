    "atom::38095d2723cf3006b98ba9f7": {
      "atom_id": "atom::38095d2723cf3006b98ba9f7",
      "source_handle": "P0561",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "作为一篇理论性综述，本研究未进行新的实验数据采集，而是采用文献综合与逻辑推演的方法。首先回顾肿瘤新抗原的定义、免疫原性及在ICI治疗中的必要性；其次，分析当前预测ICI响应的临床标志物（如TMB、PD-L1表达）的局限性；接着，整合关于微生物组（特别是肠道菌群）影响ICI疗效的临床前和临床研究证据；最后，基于“分子模拟”概念，提出微生物肽段与肿瘤新抗原序列相似性的假设，并详细设计了两套研究方案（小鼠模型构建与人类临床队列生物信息学分析）以验证该假说。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca394ec40bbe18e5f5985500ebf160bde94da9c1bac8b5be527d38c7351049f1",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::5103ce5570c37c4a4f663db0d85a83cebf6733907e4ea82d38b47af32098ca52",
      "multiple_values_in_field": false
    },
    "atom::4aaa25b309ffca2f07cb6edb": {
      "atom_id": "atom::4aaa25b309ffca2f07cb6edb",
      "source_handle": "P0561",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "系统性地提出了“微生物肿瘤新抗原模拟”作为解释微生物组调节ICI疗效的新机制框架；提供了具体的实验设计路线图（包括动物模型构建和人类临床样本的生物信息学分析指标“肿瘤抗原相似性”TAS）。",
        "limits": "所给摘要未交代具体的原创性实验数据来直接证实该模拟机制在人类患者中的因果效应；目前主要依赖间接证据（如抗生素/益生菌干预的结果）和理论推导；净效应（促进还是抑制免疫）尚不明确，且存在个体差异和情境依赖性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca394ec40bbe18e5f5985500ebf160bde94da9c1bac8b5be527d38c7351049f1",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::805fd3b73abd2e9e6c5434efba1d1612932fa218d9b1bc05731406f364928632",
      "multiple_values_in_field": false
    },
    "atom::62ec9168dbd857721493d326": {
      "atom_id": "atom::62ec9168dbd857721493d326",
      "source_handle": "P0561",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于现有临床前模型（如无菌小鼠、抗生素处理小鼠）和部分临床观察",
        "finding": "微生物组的组成和功能状态显著影响ICI的治疗效果。例如，补充特定细菌（如双歧杆菌、拟杆菌属）可增强ICI疗效，而抗生素使用则削弱疗效。粪菌移植（FMT）从 responder 患者转移到受体可恢复疗效。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca394ec40bbe18e5f5985500ebf160bde94da9c1bac8b5be527d38c7351049f1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::03171d1040a2df8325c6165a661c69342446d95592eef3bd6dc11921f3ec3b8b",
      "multiple_values_in_field": true
    },
    "atom::2d0b9cab1bcfd2d5a6d831f7": {
      "atom_id": "atom::2d0b9cab1bcfd2d5a6d831f7",
      "source_handle": "P0561",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于免疫学和生物信息学理论推导",
        "finding": "人体微生物组拥有巨大的遗传多样性，统计上极有可能存在与人类肿瘤新抗原具有相同或高度相似氨基酸序列的微生物肽段。这些微生物来源的表位可能激活交叉反应的T细胞克隆，从而间接增强抗肿瘤免疫。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca394ec40bbe18e5f5985500ebf160bde94da9c1bac8b5be527d38c7351049f1",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::03171d1040a2df8325c6165a661c69342446d95592eef3bd6dc11921f3ec3b8b",
      "multiple_values_in_field": true
    },
    "atom::47bb8afbfa1b6138466bb146": {
      "atom_id": "atom::47bb8afbfa1b6138466bb146",
      "source_handle": "P0561",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "基于胰腺癌长期生存者的数据引用",
        "finding": "在胰腺癌长期生存者中发现了针对肿瘤新抗原的T细胞克隆，这些克隆表现出对微生物表位的预测交叉反应性，支持了分子模拟在体内实际发生的观点。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ca394ec40bbe18e5f5985500ebf160bde94da9c1bac8b5be527d38c7351049f1",
          "field_path": [
            "study_summary_A",
