      "source_handle": "P0433",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "connection_to_review"
      ],
      "value": "提供技术挑战和标准化需求的信息：微生物测序方法、生物信息学流程、FMT供体筛选、给药方案的异质性。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f2a7f6253e7390084ec754fd13b06802dc54694a51a2fd3623f8a23feb295357",
          "field_path": [
