    },
    "atom::b9f8df840eb553c32c248e70": {
      "atom_id": "atom::b9f8df840eb553c32c248e70",
      "source_handle": "P0558",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "Advanced solid tumours (lung cancer, melanoma, renal carcinoma, head and neck, urothelial cancer) treated with immune checkpoint inhibitors (ICIs) at a large tertiary cancer centre; retrospective cohort analysis.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::d666afec84db80c2e97a0953604c44a4dd1689b5bca727ac670e801385756f2a",
      "multiple_values_in_field": false
    },
    "atom::8f8d3bef8a6d1205a4fe9cb4": {
      "atom_id": "atom::8f8d3bef8a6d1205a4fe9cb4",
      "source_handle": "P0558",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "This study investigates whether the timing of ICI administration influences overall survival (OS), based on evidence of circadian dependence in the immune system. Using a large single-centre cohort of 2631 patients, the authors compared outcomes between 'early' and 'late' treatment groups, defined by whether ≥50% of cycles were administered after the median infusion time. The analysis employed Cox models with and without time-dependent variables to mitigate immortal time bias, adjusting for age, sex, ECOG status, cancer type, and treatment regimen.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::1c57e58140993f98c015980d2f3032f37cbe76204a8de47924e06af079b68bd6",
      "multiple_values_in_field": false
    },
    "atom::1237dc0b4d752de2f02409ef": {
      "atom_id": "atom::1237dc0b4d752de2f02409ef",
      "source_handle": "P0558",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "This paper offers observational data linking ICI administration timing to survival outcomes in solid tumours, specifically highlighting a potential circadian effect. It provides quantitative evidence (HRs, OS differences) that can serve as a comparative baseline or contextual factor when evaluating the gut microbiome's role in ICI efficacy, particularly regarding non-microbial factors influencing treatment response timing or variability.",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::8e0359632f404d9388062326762c2cb08f1dd95545292ae20ad37de5748c3fbc",
      "multiple_values_in_field": false
    },
    "atom::1270b9c8a5eee9f889b793cf": {
      "atom_id": "atom::1270b9c8a5eee9f889b793cf",
      "source_handle": "P0558",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "Does not address microbiome mechanisms directly. Results are associative, not causal. The lack of effect in chemo-combined regimens suggests interaction with other drug classes, which complicates direct comparison to microbiome studies that might focus on different regimen types.",
        "contribution": "Provides observational data on how non-microbial factors (administration timing) correlate with ICI efficacy in solid tumours. Specifically, it shows that earlier administration is associated with better OS in ICI-only and ICI+TKI regimens, but not in chemo-combined regimens.",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::a2f255e6b43892b03c678e9221dcaae7ee58604b670f9375945173c8001f5017",
      "multiple_values_in_field": true
    },
    "atom::c02f2157982b9420b8c10b51": {
      "atom_id": "atom::c02f2157982b9420b8c10b51",
      "source_handle": "P0558",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "Can be used to control for or discuss confounding variables related to treatment scheduling in reviews focusing on microbiome effects. It helps isolate whether observed microbiome effects are independent of temporal administration patterns.",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::e213ee16e49ee4c6004bb455e4605ec56a014b7341c02546e31539ce83f1bf29",
      "multiple_values_in_field": true
    },
    "atom::8f7c3d6374184de4f9ebc6fc": {
      "atom_id": "atom::8f7c3d6374184de4f9ebc6fc",
      "source_handle": "P0558",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "The mechanism is proposed based on general immune system circadian dependence, not specifically linked to gut microbiota in this study. It does not provide evidence for microbiome-mediated mechanisms.",
        "contribution": "Offers a mechanistic hypothesis (circadian dependence of the immune system) as an alternative or complementary explanation for ICI efficacy variation.",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::a2f255e6b43892b03c678e9221dcaae7ee58604b670f9375945173c8001f5017",
      "multiple_values_in_field": true
    },
    "atom::e123689c576915dd930eae7b": {
      "atom_id": "atom::e123689c576915dd930eae7b",
