    "atom::afcf0b683f352a74efcac3bb": {
      "atom_id": "atom::afcf0b683f352a74efcac3bb",
      "source_handle": "P0367",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该论文为综述提供了关于肠道微生物组与实体瘤免疫治疗响应关联的具体实证数据，特别是通过培养组学补充了宏基因组数据的不足。它提供了癌症患者与健康人、以及ICI响应者与无响应者之间微生物组成的详细对比，包括特定的富集物种和多样性差异。这些内容可用于支持综述中关于微生物组作为生物标志物的潜力及其组成特征的论述。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::840d8841ea6e1ad6220e22bfd4d53b13529dd74bad36c51f32776d77237925cd",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::a126940c5504b0379509a2396ac3ef01b23aafc3bb2ddd2e443ee5a3d13dd09f",
      "multiple_values_in_field": false
    },
    "atom::4b62454185d4e9a929a5285a": {
      "atom_id": "atom::4b62454185d4e9a929a5285a",
      "source_handle": "P0367",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "样本量较小（N=22），统计效力有限，校正后的p值可能不显著，需谨慎解读其统计强度。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::840d8841ea6e1ad6220e22bfd4d53b13529dd74bad36c51f32776d77237925cd",
          "field_path": [
