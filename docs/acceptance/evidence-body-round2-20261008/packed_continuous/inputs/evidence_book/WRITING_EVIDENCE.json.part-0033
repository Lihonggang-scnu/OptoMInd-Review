    "atom::a0dc85abe92182c72570f407": {
      "atom_id": "atom::a0dc85abe92182c72570f407",
      "source_handle": "P0367",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "样本量小，且健康对照组年龄较轻，可能存在年龄混杂因素。结果主要基于观察性关联，未证明因果关系。",
        "contribution": "提供了接受ICI治疗的NSCLC和黑色素瘤患者与健康志愿者之间肠道微生物组成的具体差异数据。显示癌症患者物种丰富度降低，且特定菌属（如Enterocloster, Veillonella）在癌症中富集，而有益菌（如Bifidobacterium, Bacteroides）在健康人中富集。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::840d8841ea6e1ad6220e22bfd4d53b13529dd74bad36c51f32776d77237925cd",
          "field_path": [
