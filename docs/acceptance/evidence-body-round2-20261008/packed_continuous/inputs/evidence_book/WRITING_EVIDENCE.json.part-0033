    },
    "atom::dacd43cab5aa3c45379a730c": {
      "atom_id": "atom::dacd43cab5aa3c45379a730c",
      "source_handle": "P0433",
      "field_path": [
        "review_planning_B",
        "broader_review_uses",
        "purpose"
      ],
      "value": "用于讨论部分，强调跨研究比较的困难和未来需要标准化的方向，解释为何现有证据可能存在不一致。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::f2a7f6253e7390084ec754fd13b06802dc54694a51a2fd3623f8a23feb295357",
          "field_path": [
            "review_planning_B",
            "broader_review_uses",
