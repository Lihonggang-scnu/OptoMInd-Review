    "atom::9f13e13821d3538904fef1dd": {
      "atom_id": "atom::9f13e13821d3538904fef1dd",
      "source_handle": "P0436",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用前瞻性纵向队列设计。方法包括：对新鲜肿瘤组织进行全基因组测序（WGS）、RNA测序和T细胞受体（TCR）测序；对FFPE标本进行NanoString数字空间蛋白组学（DSP）；对粪便标本及受累的黏膜和肿瘤部位（拭子）进行全基因组鸟枪法宏基因组分析和16S rRNA基因测序；对正常组织和肿瘤组织进行配对测序。同时收集参与者生活方式、患者报告结果（PROs）和饮食评估。利用新鲜组织开发患者来源的异种移植（PDX）模型和细胞系。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00d239e3c8565ecdd8015fe6e4a3374b236994367571e7c90eb742936fcea6d0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::2436a8029116ab0e92743dace0e59f4eede86880c38ccfc2dd08d6208058155d",
      "multiple_values_in_field": false
    },
    "atom::66359b9655767334b4ab4ac2": {
      "atom_id": "atom::66359b9655767334b4ab4ac2",
      "source_handle": "P0436",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了一个大规模、多维度（基因组、转录组、蛋白组、微生物组、临床表型）的前瞻性MM队列的资源框架和基线数据。",
        "limits": "当前仅为中期进展报告，缺乏最终的因果关联分析、机制验证及统计学结论。样本量相对较小（n=98），且为单中心研究，可能限制外推性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00d239e3c8565ecdd8015fe6e4a3374b236994367571e7c90eb742936fcea6d0",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::2c00c8d506467511d414862a9207b5d314566b3180d8efda4591521604995a5d",
      "multiple_values_in_field": false
    },
    "atom::3d02b5dc8e9f1f19733a1ad4": {
      "atom_id": "atom::3d02b5dc8e9f1f19733a1ad4",
      "source_handle": "P0436",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "截至2023年11月的初步队列数据（n=98）",
        "finding": "描述了人口统计学特征（中位年龄64岁，白人占85%）、原发部位分布（鼻口腔24%，泌尿生殖道30%，肛门直肠27%等）及临床体细胞突变情况（KIT 16%, NRAS 11%, BRAF 12%）。记录了样本收集进度（血液95例，粪便50例，黏膜拭子38例等）及生存随访数据（中位随访16个月，死亡率18%）。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::00d239e3c8565ecdd8015fe6e4a3374b236994367571e7c90eb742936fcea6d0",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::5c7f505d92aa04a8dc660a246f455462a01f17929d7a37b4d81b8e129aaea26e",
      "multiple_values_in_field": true
    },
    "atom::913277b102318dbaa8556fa4": {
      "atom_id": "atom::913277b102318dbaa8556fa4",
      "source_handle": "P0436",
      "field_path": [
        "study_summary_A",
        "key_findings"
