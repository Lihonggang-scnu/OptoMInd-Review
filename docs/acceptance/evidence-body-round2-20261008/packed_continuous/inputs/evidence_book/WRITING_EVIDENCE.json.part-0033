      "source_handle": "P0012",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "用于综述中探讨机制部分，特别是当缺乏直接微生物组测序证据时，如何利用临床表型（如PS状态、感染背景）来推断潜在的生物生物学路径。",
      "role": "planning",
      "origins": [
