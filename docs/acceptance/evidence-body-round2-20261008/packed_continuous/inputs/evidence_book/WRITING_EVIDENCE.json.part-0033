            "2"
          ]
        }
      ],
      "variant_group": "field::28707fd4d74b41eadcaaa002dcafe74c4ae248fcf5fff9128a1256ab2ed9019e",
      "multiple_values_in_field": true
    },
    "atom::3e99ed01c95e2c5a4011ad60": {
      "atom_id": "atom::3e99ed01c95e2c5a4011ad60",
      "source_handle": "P0566",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "抗生素和 PPI 的影响是间接证据，综述未区分其对肠道和口腔微生物组的具体独立贡献。",
      "role": "evidence",
