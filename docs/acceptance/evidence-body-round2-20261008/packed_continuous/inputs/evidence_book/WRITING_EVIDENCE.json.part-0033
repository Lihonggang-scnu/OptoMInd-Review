          ]
        }
      ],
      "variant_group": "field::cc01faa6299b5c7b11a790edcbdc51f5c6dc1580b22a3b9d86833e42953018dd",
      "multiple_values_in_field": true
    },
    "atom::7b657e933f0cabb151e5b80a": {
      "atom_id": "atom::7b657e933f0cabb151e5b80a",
