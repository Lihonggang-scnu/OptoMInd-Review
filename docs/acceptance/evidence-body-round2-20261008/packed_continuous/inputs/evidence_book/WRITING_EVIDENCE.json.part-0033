    },
    "atom::4aee8f5e401934d0c175afb0": {
      "atom_id": "atom::4aee8f5e401934d0c175afb0",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用叙述性综述方法，整合来自临床前模型（小鼠模型、类器官）和人类患者队列的研究数据。文章按主题组织：1) 微生物在癌症发生中的作用；2) 微生物调节抗癌药物（化疗、ICI）疗效的机制；3) 微生物生物标志物用于预测疗效；4) 通过干预手段（抗生素、益生菌、FMT、噬菌体、纳米技术）调控微生物群的方法；5) 当前研究的局限性与未来展望。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::97e4b988e2b5faded1c8bae086ea3bcf5a48b0e4be991da24c66b15333f92dc4",
      "multiple_values_in_field": false
    },
    "atom::95bca79832feaf98a134a7b2": {
      "atom_id": "atom::95bca79832feaf98a134a7b2",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物群调节癌症治疗（特别是ICI和化疗）机制的综合框架，包括代谢降解、免疫调节和生态变化（TIMER框架）。",
        "limits": "所给摘要未交代具体的文献检索策略和筛选标准；作为综述，其结论依赖于引用的原始研究，且许多机制主要基于小鼠模型，存在向人类外推的不确定性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::18317b74a285522a0b1555720c35ca48155d29513d4a229be4c5703c697e3ed3",
      "multiple_values_in_field": true
    },
    "atom::193438df5e5ac33fd79baef2": {
      "atom_id": "atom::193438df5e5ac33fd79baef2",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "总结了多种微生物调控策略（益生菌、FMT、噬菌体、纳米技术）的临床前和早期临床证据。",
        "limits": "指出目前缺乏大规模多中心临床试验验证微生物疗法的长期安全性和有效性；部分临床结果存在冲突（如益生菌试验），归因于个体差异和研究设计局限。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "1"
          ]
        }
      ],
      "variant_group": "field::18317b74a285522a0b1555720c35ca48155d29513d4a229be4c5703c697e3ed3",
      "multiple_values_in_field": true
    },
    "atom::e82b793a7ce02d60b98b6908": {
      "atom_id": "atom::e82b793a7ce02d60b98b6908",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "化疗药物（吉西他滨、环磷酰胺、5-FU等）",
        "finding": "特定细菌可代谢药物使其失活（如Gammaproteobacteria代谢吉西他滨导致胰腺癌耐药）；某些共生菌（如Enterococcus hirae, Barnesiella intestinihominis）通过刺激Th17细胞或γδT细胞浸润增强环磷酰胺疗效；具核梭杆菌通过TLR4/MYD88通路激活自噬促进5-FU耐药。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::2c61f0a5aa3848d654733ae13fe864bbd050d39a65065ea9cd06ddd66a5e52bd",
      "multiple_values_in_field": true
    },
    "atom::48d9aafeca596013be0f3518": {
      "atom_id": "atom::48d9aafeca596013be0f3518",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "免疫检查点抑制剂（CTLA-4, PD-1/PD-L1）",
        "finding": "Bacteroides fragilis和Bacteroides thetaiotaomicron通过诱导淋巴结Th1反应和树突状细胞成熟增强抗CTLA-4疗效；Akkermansia muciniphila富集与非小细胞肺癌和肾细胞癌中对PD-1阻断剂的响应相关；黑色素瘤患者中Faecalibacterium和Ruminococcaceae富集与生存期延长相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "1"
          ]
        }
      ],
      "variant_group": "field::2c61f0a5aa3848d654733ae13fe864bbd050d39a65065ea9cd06ddd66a5e52bd",
      "multiple_values_in_field": true
    },
    "atom::dec77698dba2619f48ff3701": {
      "atom_id": "atom::dec77698dba2619f48ff3701",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "肿瘤发生与进展",
        "finding": "幽门螺杆菌通过β-catenin信号通路促进胃癌；具核梭杆菌通过FadA粘附素结合E-cadherin激活Wnt/NF-kB通路促进结直肠癌；Peptostreptococcus anaerobius通过PI3K-Akt通路促进增殖和炎症。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "2"
          ]
        }
      ],
      "variant_group": "field::2c61f0a5aa3848d654733ae13fe864bbd050d39a65065ea9cd06ddd66a5e52bd",
      "multiple_values_in_field": true
    },
    "atom::9511e05d6896aa7fa29e9b9c": {
      "atom_id": "atom::9511e05d6896aa7fa29e9b9c",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "治疗毒性管理",
        "finding": "FMT可缓解ICI引起的结肠炎和放疗引起的肠道毒性；Lactobacillus rhamnosus GG通过释放脂磷壁酸（LTA）保护上皮干细胞免受辐射损伤。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "3"
          ]
        }
      ],
      "variant_group": "field::2c61f0a5aa3848d654733ae13fe864bbd050d39a65065ea9cd06ddd66a5e52bd",
      "multiple_values_in_field": true
    },
    "atom::599db5fe66f0c6df0c804397": {
      "atom_id": "atom::599db5fe66f0c6df0c804397",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "paper_kind"
      ],
      "value": "review",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "paper_kind"
          ]
        }
      ],
      "variant_group": "field::074c55943ed720b73c53b78ead16a0c9d86ecc42a0718c242b69e20ed6da4264",
      "multiple_values_in_field": false
    },
    "atom::bd18c6ef74b443a822a4424f": {
      "atom_id": "atom::bd18c6ef74b443a822a4424f",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管已有大量关于肠道微生物群影响癌症治疗的证据，但需要综合理解微生物与癌症治疗的具体交互机制，以便识别新的预防策略、对患者进行分层以提高治疗效果并减少并发症。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::3711e0555e089dc2febbda7029b3d8814c2fdca79457f2af678af4585f5c6d2a",
      "multiple_values_in_field": false
    },
    "atom::27c44bf3d7caa7f1d1f260de": {
      "atom_id": "atom::27c44bf3d7caa7f1d1f260de",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "research_scope"
      ],
      "value": "肠道微生物群在癌症治疗中的作用，涵盖化疗药物、免疫检查点抑制剂（ICIs）及放疗的疗效调节、肿瘤发生机制、微生物生物标志物、治疗相关毒性的管理以及通过益生菌、粪菌移植（FMT）、噬菌体和纳米技术进行微生物调控的策略。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "research_scope"
          ]
        }
      ],
      "variant_group": "field::aa91e43ed948e40429616f04913fbcba28d0d802c701d22b87de27ed681009c2",
      "multiple_values_in_field": false
    },
    "atom::3342e506c85d5bbfddf3ee03": {
      "atom_id": "atom::3342e506c85d5bbfddf3ee03",
      "source_handle": "P0229",
      "field_path": [
        "study_summary_A",
        "work_summary"
      ],
      "value": "本文是一篇综述，系统梳理了肠道微生物群与癌症治疗之间的相互作用。文章首先阐述了微生物群失调如何促进肿瘤发生（如幽门螺杆菌、具核梭杆菌等），随后重点讨论了不同细菌物种如何通过代谢药物、调节免疫反应或诱导耐药性来影响化疗和免疫治疗的疗效。此外，综述还评估了利用微生物特征作为诊断/预后标志物的潜力，探讨了通过抗生素、益生菌、FMT和新型纳米技术/噬菌体疗法调控微生物群以增强疗效或减轻毒性的策略，并指出了当前研究在因果机制验证、动物模型外推性及临床转化方面的局限性。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "study_summary_A",
            "work_summary"
          ]
        }
      ],
      "variant_group": "field::20262aa3e8b42bbfa124b77dcd851501ae81bcd643b82b053b775cd72754f06b",
      "multiple_values_in_field": false
    },
    "atom::e34b9cc7bb31799111285bd1": {
      "atom_id": "atom::e34b9cc7bb31799111285bd1",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "planning_summary"
      ],
      "value": "该综述为理解肠道微生物群如何具体影响固体肿瘤对免疫检查点抑制剂（ICI）和化疗的反应提供了详细的机制背景和潜在的生物标志物列表。它特别有助于回答“哪些细菌物种增强或削弱ICI疗效”以及“背后的免疫和代谢机制是什么”这两个子问题。同时，它提供了关于微生物调控策略（如FMT、益生菌）在改善治疗耐受性和疗效方面的现状评估，可用于讨论临床转化的挑战和前景。",
      "role": "planner_interpretation",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "review_planning_B",
            "planning_summary"
          ]
        }
      ],
      "variant_group": "field::07ad24c3f5ab1dc751047283c47d90601c4325f3aecc5ffa4055498f5b0b31c6",
      "multiple_values_in_field": false
    },
    "atom::d68f1d7be2df847cbd65c8ef": {
      "atom_id": "atom::d68f1d7be2df847cbd65c8ef",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "相关性不等于因果性；不同研究使用的测序方法（16S vs metagenomics）、样本类型（粪便vs组织）和癌症类型可能导致结果偏差；部分发现仅在小鼠模型中验证，人类数据有限。",
        "contribution": "列举了与ICI疗效正相关和负相关的特定细菌物种。例如，Bacteroides fragilis、Bacteroides thetaiotaomicron、Akkermansia muciniphila、Faecalibacterium prausnitzii、Ruminococcaceae被报道与ICI响应相关；而某些未明确命名的菌群或缺乏有益菌的状态与无响应相关。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0"
          ]
        }
      ],
      "variant_group": "field::6c2d8f81f7330295d3f4203ebee0cbc053b62393cbde78c3b2de579ee86115e4",
      "multiple_values_in_field": true
    },
    "atom::7cc8f788ea1efd09378b1550": {
      "atom_id": "atom::7cc8f788ea1efd09378b1550",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "可用于回答“哪些微生物特征预测ICI疗效”的问题，提供具体的物种列表及其在不同癌种中的表现。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "0",
            "possible_uses"
          ]
        }
      ],
      "variant_group": "field::cd8ef256a8da2ed758f3f7f378f810173cc2e37b876be059dfbf161e864c3751",
      "multiple_values_in_field": true
    },
    "atom::7de397c7634b39d8bdffe607": {
      "atom_id": "atom::7de397c7634b39d8bdffe607",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "许多机制细节（如Akkermansia的具体通路）主要基于小鼠模型或体外实验，人类体内的确切机制仍需更多验证；不同细菌的作用可能相互交织，难以孤立分析单一机制。",
        "contribution": "详细描述了微生物调节ICI疗效的机制：1) Bacteroides species诱导淋巴结Th1反应和肿瘤内树突状细胞成熟；2) Akkermansia muciniphila通过IL-12途径促进CCR9+CXCR3+CD4+ T淋巴细胞募集到肿瘤微环境；3) 微生物通过TLR4激活髓系细胞产生TNF等炎症因子，增强免疫监视；4) 微生物代谢产物（如短链脂肪酸SCFAs）可能增强CD8+ T细胞的记忆潜能。",
        "facet_id": "F2"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "1"
          ]
        }
      ],
      "variant_group": "field::6c2d8f81f7330295d3f4203ebee0cbc053b62393cbde78c3b2de579ee86115e4",
      "multiple_values_in_field": true
    },
    "atom::49e89ca32c0286cecc81b390": {
      "atom_id": "atom::49e89ca32c0286cecc81b390",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "facet_contributions",
        "possible_uses"
      ],
      "value": "直接回答“机制是什么”的问题，提供分子和细胞层面的解释路径。",
      "role": "planning",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "review_planning_B",
