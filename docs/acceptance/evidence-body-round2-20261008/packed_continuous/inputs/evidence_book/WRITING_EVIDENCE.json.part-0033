      "atom_id": "atom::1b81170d45711b784e1fc3aa",
      "source_handle": "P0012",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "研究对象为2015-2017年的患者，使用的黑色素瘤治疗方案（单药BRAF抑制剂）已过时，结果可能不适用于当前的双药联合疗法（BRAF+MEK抑制剂）。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::75e6dfc7ae3a6e8eb59675917ad6fe0c85254d3393fc36f8992b36ec4993b742",
          "field_path": [
