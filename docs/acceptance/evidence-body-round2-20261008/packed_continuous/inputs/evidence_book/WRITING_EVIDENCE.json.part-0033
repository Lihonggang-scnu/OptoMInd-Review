      "source_handle": "P0375",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "这是从饮食干预研究中推导出的方法论建议，并非直接针对ICIs试验的设计规范。",
        "contribution": "提供了关于临床试验设计的重要启示：由于个体间微生物群差异巨大，基于群体的平均结果可能掩盖亚组的显著疗效，因此需要考虑基于微生物群的 stratification。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
