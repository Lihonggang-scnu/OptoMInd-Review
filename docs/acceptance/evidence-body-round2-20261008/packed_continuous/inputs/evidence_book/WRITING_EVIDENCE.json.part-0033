      "source_handle": "P0558",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "Retrospective cohort study. Patients receiving ICIs for advanced/metastatic disease between Jan 2018 and Dec 2023 were grouped based on infusion timing relative to the median time of all treatments ('early group': <50% cycles after median time; 'late group': ≥50%). Primary endpoint was OS. Multivariable-adjusted Hazard Ratios (HRs) were estimated using standard Cox models and time-dependent Cox models to account for potential changes in group assignment over time. Sensitivity analyses were performed.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::395898f2daff8bb3b75d7e28b036b1877c2a687fcc9377263b208040e1fec654",
      "multiple_values_in_field": false
    },
    "atom::3411659c8a5c411b2e7aba87": {
      "atom_id": "atom::3411659c8a5c411b2e7aba87",
      "source_handle": "P0558",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "Provides evidence from a large sample size suggesting a benefit in OS with early ICI administration, utilizing time-dependent Cox models to reduce immortal time bias.",
        "limits": "Retrospective design limits causal inference; results may be specific to the single-centre setting; no difference found when chemotherapy is included; sensitivity analysis results varied by model type."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::e463ba85a9ccc1928090598d88524a25dc3a5cdffee4832355acc20e80fbca25",
      "multiple_values_in_field": false
    },
    "atom::86be55c0fd1c481f08135111": {
      "atom_id": "atom::86be55c0fd1c481f08135111",
      "source_handle": "P0558",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "Overall cohort (n=2631)",
        "finding": "Median OS was significantly shorter in the late group (13.1 months) compared to the early group (21.4 months). Time-dependent Cox model showed HR 1.30 (95% CI 1.16-1.44) for death in the late group."
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
