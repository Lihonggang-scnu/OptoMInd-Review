    "atom::bb9cf892c940f97762694aaf": {
      "atom_id": "atom::bb9cf892c940f97762694aaf",
      "source_handle": "P0031",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "尽管微生物组在精准医学中展现出巨大潜力，但当前面临的主要障碍是什么？如何将微生物组数据有效整合到临床决策中以实现真正的个性化预防、诊断和治疗？",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::685224e9339ec834861ba17ff7c28460d2405bc36e62193c07d5eecded9f75d3",
