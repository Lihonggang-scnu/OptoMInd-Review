    "atom::3deb489d5cb67e2529f53c32": {
      "atom_id": "atom::3deb489d5cb67e2529f53c32",
      "source_handle": "P0558",
      "field_path": [
        "study_summary_A",
        "problem_or_question"
      ],
      "value": "To determine if the time of day of ICI infusion affects treatment response and overall survival in patients with advanced solid tumours, addressing limitations of previous small-scale studies with methodological biases.",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::2f36d454510b1c8d961d57df5f92e1986e7d20fcbe85f000c83f51b96506a89c",
          "field_path": [
            "study_summary_A",
            "problem_or_question"
          ]
        }
      ],
      "variant_group": "field::cca53ffd7f3ab7649cee225d50d3ea0d007586f055e67ff1e9eb2f498d7c4284",
