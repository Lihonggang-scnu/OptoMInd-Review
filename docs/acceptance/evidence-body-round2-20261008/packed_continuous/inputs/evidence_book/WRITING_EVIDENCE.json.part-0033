          ]
        }
      ],
      "variant_group": "field::cd43e99d424e4cee5088e64258a0ebcf170e72e9ca51272b7d11729a71a85d02",
      "multiple_values_in_field": true
    },
    "atom::ac2510c5b5936aa4af9cc930": {
      "atom_id": "atom::ac2510c5b5936aa4af9cc930",
      "source_handle": "P0059",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "MVMR和中介分析，P < 0.05",
        "finding": "确认了9条显著的中介通路。例如，Gordonibacter丰度通过调节Palmitoleate (16:1n7)水平介导了15.60%的食管癌保护作用。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3aeccc2845ceecb2fe0c2c6e2aa2ddeabc0985c91b1f33123b023691a7c6a07c",
