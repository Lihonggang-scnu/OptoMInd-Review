    "atom::54460fcc9b674b16fa00b8fb": {
      "atom_id": "atom::54460fcc9b674b16fa00b8fb",
      "source_handle": "P0010",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用回顾性队列分析方法。首先从2021年《Science》发表的“饮食纤维和益生菌影响黑色素瘤免疫治疗反应”研究中提取AYA队列（N=23）。随后进行倾向评分或匹配设计，按2:1比例选取50-70岁的老年非AYA患者作为对照组。统计控制变量包括性别、BMI、种族、治疗初治状态、疾病分期（III期/IV期）、吸烟、药物及酒精使用史。利用高通量测序数据进行Alpha和Beta多样性分析，并进行差异丰度分析（Differential Analysis）以识别组间特异性微生物标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a748856a6b0d4ee03d4b7d048fc8c86ce8b8c9fe9ad12303ce07d02ba6d5bbb0",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::f4a437faaa3c771165e7987251bed105b9b5e77453a79a014146fce8a60bdc97",
      "multiple_values_in_field": false
    },
    "atom::a79c95afeb0ce7aea3853d69": {
      "atom_id": "atom::a79c95afeb0ce7aea3853d69",
      "source_handle": "P0010",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "首次系统性地描述了AYA黑色素瘤患者肠道微生物组的特征，并明确了其与老年患者的关键差异（如Bacteroides stercoris vs Ruminococcaceae/Blautia/Dorea的分布）。",
        "limits": "样本量较小（AYA仅23人）；数据来源于二手提取而非独立前瞻性收集；未直接报告微生物组特征与ICI具体临床疗效（如ORR, PFS, OS）的相关性，仅提供了基线特征描述；部分P值报告可能存在格式错误（如Blautia obeum的p值缺失或异常），需谨慎解读统计显著性。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::a748856a6b0d4ee03d4b7d048fc8c86ce8b8c9fe9ad12303ce07d02ba6d5bbb0",
          "field_path": [
            "study_summary_A",
            "contrib