      ],
      "variant_group": "field::51554d10dc85aa38c1e15453ff75e67dd0b8162f6989ba2f8dea55d974a41eda",
      "multiple_values_in_field": true
    },
    "atom::7844395ad2d0985d2f12fb18": {
      "atom_id": "atom::7844395ad2d0985d2f12fb18",
      "source_handle": "P0433",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "多数干预措施处于早期临床试验阶段，缺乏大规模III期RCT证据；FMT的定植效率和长期安全性仍是主要障碍；益生菌产品的标准化和质量控制问题突出。",
        "contribution": "总结了基于微生物群的干预策略（FMT, 益生菌, 益生元, 饮食）在增强ICI疗效方面的临床前和早期临床研究结果。例如，FMT使部分ICI耐药黑色素瘤患者获得PR/CR；特定益生菌（如L. casei + L. reuteri）在PDAC模型中增强ICI疗效。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::f2a7f6253e7390084ec754fd13b06802dc54694a51a2fd3623f8a23feb295357",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::d29841341a06580e49daf95431a71fc0167baf2bd66f219c5e2b365a726eaf4c",
      "multiple_values_in_field": true
    },
    "atom::f4d52eac1ad01cf5950a3b6b": {
      "atom_id": "atom::f4d52eac1ad01cf5950a3b6b",
      "source_handle": "P0433",
