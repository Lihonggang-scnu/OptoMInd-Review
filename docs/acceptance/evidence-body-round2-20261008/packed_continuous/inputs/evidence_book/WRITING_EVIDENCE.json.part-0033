      ],
      "variant_group": "field::cd8ef256a8da2ed758f3f7f378f810173cc2e37b876be059dfbf161e864c3751",
      "multiple_values_in_field": true
    },
    "atom::54bb4fdad7705305ec54b250": {
      "atom_id": "atom::54bb4fdad7705305ec54b250",
      "source_handle": "P0229",
      "field_path": [
        "review_planning_B",
        "facet_contributions"
      ],
      "value": {
        "boundaries": "本题目聚焦ICI，化疗机制可作为背景参考，但不直接回答ICI的特异性机制。",
        "contribution": "指出微生物群也影响化疗疗效，如Gammaproteobacteria代谢吉西他滨导致耐药，而某些细菌增强环磷酰胺疗效。这为理解广义的“抗癌治疗”提供了背景。",
        "facet_id": "F1"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::821a4b5022eeeb3a92523e6ffe1fed9e151d6b7556b5eb1b479211931ba41f6c",
          "field_path": [
            "review_planning_B",
            "facet_contributions",
            "2"
          ]
        }
      ],
      "variant_group": "field::6c2d8f81f7330295d3f4203ebee0cbc053b62393cbde78c3b2de579ee86115e4",
      "multiple_values_in_field": true
    },
    "atom::1b64e38406d1a5fb17788c55": {
      "atom_id": "atom::1b64e38406d1a5fb17788c55",
