    "atom::3e18a3ea80bd35dda72e241a": {
      "atom_id": "atom::3e18a3ea80bd35dda72e241a",
      "source_handle": "P0059",
      "field_path": [
        "study_summary_A",
        "approach"
      ],
      "value": "采用基于GWAS摘要数据的两样本双向孟德尔随机化设计。暴露变量包括肠道微生物丰度、微生物代谢通路和血浆代谢物；结局变量为8种特定癌症的风险。使用逆方差加权（IVW）作为主要分析方法，辅以MR-Egger、加权中位数和贝叶斯加权MR进行敏感性分析。通过FDR校正控制假阳性，并利用MVMR调整混杂后计算中介效应比例。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3aeccc2845ceecb2fe0c2c6e2aa2ddeabc0985c91b1f33123b023691a7c6a07c",
          "field_path": [
            "study_summary_A",
            "approach"
          ]
        }
      ],
      "variant_group": "field::f4b6fe31fd6f7a53eee96458bc00e3994637d7a8ef61672817e16306af732f95",
      "multiple_values_in_field": false
    },
    "atom::0c44cc68e693e76a84a1056e": {
      "atom_id": "atom::0c44cc68e693e76a84a1056e",
      "source_handle": "P0059",
      "field_path": [
        "study_summary_A",
        "contribution_and_limits"
      ],
      "value": {
        "contribution": "提供了肠道微生物、血浆代谢物与8种常见癌症之间的大规模因果关联证据，特别是揭示了微生物-代谢物-癌症轴的中介机制，为精准医疗提供了潜在的生物标志物和治疗靶点。",
        "limits": "1. 样本仅来自欧洲人群，限制了在其他种族中的外推性。2. 由于微生物GWAS统计效力较低，使用了较宽松的SNP阈值（P < 1e-5），尽管进行了严格筛选，但仍可能存在弱工具变量偏差和高假阳性率（部分结果FDR极高）。3. MR假设线性关系，无法捕捉非线性效应；结果反映长期累积效应，难以量化特定时间点的干预效果。4. 许多发现的中介比例较小或统计效力有限，需独立队列验证。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3aeccc2845ceecb2fe0c2c6e2aa2ddeabc0985c91b1f33123b023691a7c6a07c",
          "field_path": [
            "study_summary_A",
            "contribution_and_limits",
            "0"
          ]
        }
      ],
      "variant_group": "field::198f71316eb44e0ec52a65cec0492973960efbf3abbc762d25c918eecea2752d",
      "multiple_values_in_field": false
    },
    "atom::1cdc42d4e710b56fbd34e0ac": {
      "atom_id": "atom::1cdc42d4e710b56fbd34e0ac",
      "source_handle": "P0059",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "单向MR分析，P_IVW < 0.05且排除不一致方向或显著多效性结果",
        "finding": "识别出129种肠道微生物、57条微生物代谢通路和463种血浆代谢物与泛癌存在潜在因果关联。其中15种微生物、8条通路和58种代谢物与多种癌症相关。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3aeccc2845ceecb2fe0c2c6e2aa2ddeabc0985c91b1f33123b023691a7c6a07c",
          "field_path": [
            "study_summary_A",
            "key_findings",
            "0"
          ]
        }
      ],
      "variant_group": "field::cd43e99d424e4cee5088e64258a0ebcf170e72e9ca51272b7d11729a71a85d02",
      "multiple_values_in_field": true
    },
    "atom::53f2d8130fcc6defac99679b": {
      "atom_id": "atom::53f2d8130fcc6defac99679b",
      "source_handle": "P0059",
      "field_path": [
        "study_summary_A",
        "key_findings"
      ],
      "value": {
        "conditions": "反向MR分析，P_IVW < 0.05",
        "finding": "发现结直肠癌与Syntrophorhabdia之间存在名义上的双向因果关系；肺癌与硫酸盐还原通路、甲状腺癌与卟啉生物合成通路也存在潜在双向关系；26种血浆代谢物与癌症存在双向因果关联。"
      },
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::3aeccc2845ceecb2fe0c2c6e2aa2ddeabc0985c91b1f33123b023691a7c6a07c",
          "field_path": [
            "study_summary_A",
