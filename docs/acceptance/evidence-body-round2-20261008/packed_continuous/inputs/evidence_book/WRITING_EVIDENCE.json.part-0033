    "atom::6310df1ab85c47992b704566": {
      "atom_id": "atom::6310df1ab85c47992b704566",
      "source_handle": "P0566",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "口腔微生物组的预测价值具有高度的治疗情境依赖性（仅在联合治疗中可能有效），不能泛化为所有免疫治疗的通用标志物。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
            "review_planning_B",
            "scope_interpretation_cautions",
            "1"
          ]
        }
      ],
      "variant_group": "field::28707fd4d74b41eadcaaa002dcafe74c4ae248fcf5fff9128a1256ab2ed9019e",
      "multiple_values_in_field": true
    },
    "atom::e334203f3b602dbb33f589fa": {
      "atom_id": "atom::e334203f3b602dbb33f589fa",
      "source_handle": "P0566",
      "field_path": [
        "review_planning_B",
        "scope_interpretation_cautions"
      ],
      "value": "所引用的机制多来自其他肿瘤类型的临床前模型，在肺癌中的直接适用性需谨慎对待，作者已明确指出这一点。",
      "role": "evidence",
      "origins": [
        {
          "record_id": "record::ba084eb01ffbfae5b25958c752d626bf83f163f53f85fd981a4a64b7fc2b1191",
          "field_path": [
