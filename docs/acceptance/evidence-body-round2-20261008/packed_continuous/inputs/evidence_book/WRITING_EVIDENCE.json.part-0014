      {
        "source_handle": "P0244",
        "title": "805 Safety and emerging evidence of immune modulation of the live biotherapeutic MRx0518 in the neoadjuvant setting for patients awaiting surgical removal of solid tumours",
        "year": "2020",
        "doi": "10.1136/jitc-2020-sitc2020.0805",
        "paper_id": "6616c4ad828cc2fd463ceba12acdf8d1aad10caf",
        "material_depth": "abstract",
        "material_status": "resolved",
        "aliases": [],
        "study_summary_A": {
          "approach": "采用单臂、开放标签的早期临床试验设计。纳入标准：组织学确诊的实体瘤、计划进行手术切除、初治患者。干预措施：口服 MRx0518（1x10^10 至 1x10^11 CFU），每日两次，持续至术前一天（最长28天）。数据收集：记录不良事件以评估安全性；收集治疗前（诊断性活检）和治疗后（手术标本）的配对样本，利用 NanoString Pan Cancer IO 360™ 基因表达面板进行转录组分析，同时计划进行微生物组和代谢组分析。",
          "contribution_and_limits": [
            {
              "contribution": "提供了 MRx0518 在人类实体瘤患者中短期使用的安全性数据，证实了其良好的耐受性。",
              "limits": "样本量小（n=17），且仅分析了前 5 对样本的基因表达数据，缺乏统计效力来确立普遍性的免疫调节模式。"
            },
            {
              "contribution": "初步证据表明 MRx0518 可能在体内诱导与临床前模型相似的免疫激活信号（基因表达变化）。",
              "limits": "基因表达变化的具体机制和功能后果尚未经过充分验证；未提供疗效（如肿瘤缩小）的直接证据，因为主要终点是安全性。"
            },
            {
              "contribution": "确立了在新辅助设置中使用配对活检样本评估微生物疗法对宿主免疫影响的方法学可行性。",
              "limits": "由于 COVID-19 疫情导致手术延迟，部分患者的治疗窗口可能受到影响，且后续 Part B 才包含安慰剂对照和更大规模的疗效评估。"
            }
          ],
          "key_findings": [
            {
              "conditions": "Part A, n=17 (breast n=8, prostate n=4, uterine n=3, melanoma n=1, bladder n=1), treatment naive, solid tumours awaiting surgery",
