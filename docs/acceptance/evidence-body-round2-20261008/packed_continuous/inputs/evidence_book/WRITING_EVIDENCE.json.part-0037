    "record::1fb52b3621e1fe1f515eb59106e26772ff4abbab4d4d6339018f2e44cd8c5270": {
      "source_handle": "P0589",
      "title": "Abstract LB-317: Use ofin vivomicrodialysis to evaluate biomarker levels in the tumor and tumor free flank of freely-moving PDX mice",
      "year": "2019",
      "doi": "10.1158/1538-7445.am2019-lb-317",
      "paper_id": "CorpusId:219269178",
      "material_depth": "",
      "material_status": "resolved",
      "aliases": [],
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch3.json",
        "source_handle": "P0589",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\level2\\external\\Nf2f13ca37a1cba78c9d1-b532f13f7ac0c36c\\round_1\\supplements\\case_C2_inosine_tme\\attempt-trstv1th\\source_units\\SU03_search_candidate_6b36eb7123\\card\\PAPER_READING_CARD.json"
      },
      "study_summary_A": {
        "approach": "采用体内微透析（in vivo microdialysis）技术，结合PDX小鼠模型。具体步骤包括：1) 使用特定的人类肿瘤PDX品系；2) 监控肿瘤生长至>400 mm³后手术植入探针至肿瘤及无瘤侧；3) 灌注透析液并连续收集样本；4) 使用EIA或LC-MS/MS检测ATP、肌苷和犬尿氨酸代谢物；5) 比较肿瘤侧与对侧以及不同肿瘤类型间的生物标志物水平差异。",
        "contribution_and_limits": [
          {
            "contribution": "提供了在自由移动的PDX小鼠中使用体内微透析监测肿瘤微环境生化成分（ATP、肌苷、犬尿氨酸代谢物）的方法学验证；证明了PDX模型能反映人类肿瘤特有的微环境代谢特征。",
            "limits": "所给摘要未交代具体的统计学显著性数据、样本量大小、不同PDX品系的详细名称或病理类型、以及具体的代谢物浓度数值。仅展示了概念验证性质的发现，未提供针对免疫检查点抑制剂或肠道微生物群的具体实验数据。"
          }
        ],
        "key_findings": [
          {
            "conditions": "PDX小鼠模型，肿瘤体积>400 mm³，对比肿瘤内部与无瘤侧 flank",
            "finding": "肿瘤内部与无瘤侧的ATP及代谢物水平存在显著差异，证实这些指标在肿瘤微环境中具有特异性。"
          },
          {
            "conditions": "不同种类的PDX模型之间",
            "finding": "不同肿瘤类型的PDX模型表现出不同的生物标志物水平，揭示了各模型间代谢活动的差异。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "如何更准确地模拟人类肿瘤的生理状态以开发新型癌症疗法？特别是，如何在活体自由移动的动物模型中实时监测肿瘤微环境的生化特征，并验证PDX模型相对于传统鼠类模型的优越性。",
        "research_scope": "患者来源异种移植（PDX）小鼠模型中的实体瘤微环境；具体涉及不同人类肿瘤类型的PDX品系，通过体内微透析技术监测肿瘤内部与无瘤侧 flank 的生化差异。",
        "work_summary": "该研究旨在利用体内微透析技术评估PDX小鼠模型中肿瘤微环境的生物标志物水平，以桥接啮齿动物模型与人类肿瘤之间的差距。研究使用来自CRL DRS Freiburg的不同PDX品系，当肿瘤体积超过400 mm³时，在肿瘤和无瘤侧分别植入微透析探针，连续收集数小时的透析液样本。通过酶免疫分析（EIA）或液相色谱-串联质谱（LC-MS/MS）定量ATP、肌苷和犬尿氨酸代谢物的水平。结果显示，同一动物内肿瘤与无瘤侧的 analyte 水平存在显著差异，表明PDX肿瘤中的ATP及其代谢物具有肿瘤微环境特异性；不同PDX模型间也显示出生物标志物水平的差异，反映了不同的代谢活性。作者认为该方法可用于测试靶向疗法并随时间追踪相关生物标志物，从而更深入地了解新疗法对患者特异性肿瘤组织的影响。"
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "实体瘤微环境的复杂性及其对治疗反应的调控",
            "material": "PDX模型中肿瘤与正常组织的代谢差异，以及不同肿瘤类型间的代谢异质性。",
            "purpose": "作为背景知识，强调实体瘤微环境并非均质，其代谢状态（如能量消耗）具有肿瘤特异性和个体差异性。这在理解为何不同患者对ICI反应不同时，提供了一个非免疫细胞层面的视角（即代谢微环境的基础状态）。"
          },
          {
            "connection_to_review": "临床前模型的选择与转化价值",
            "material": "使用人类肿瘤PDX品系比传统鼠类模型更能桥接人类肿瘤生理状态。",
            "purpose": "支持综述中关于使用更贴近人类的模型（如PDX而非原位鼠瘤）来研究微生物-宿主-药物相互作用的重要性。如果后续文献使用类似模型研究微生物对ICI的影响，本文可为该模型系统的合理性提供支持。"
          }
        ],
        "facet_contributions": [
          {
            "boundaries": "本研究未涉及肠道微生物群，也未测试免疫检查点抑制剂（ICI）。它仅建立了监测代谢物的能力，未解释微生物如何通过代谢影响ICI疗效。",
            "contribution": "提供了使用PDX模型结合微透析技术监测实体瘤局部代谢变化的方法学参考。",
            "facet_id": "F1",
            "possible_uses": "在综述中讨论“如何测量或监测肿瘤微环境变化以评估治疗反应”时，可作为技术背景或对照模型的有效性证据。说明研究者可以利用此类模型来观察治疗前后的代谢改变。"
          },
          {
            "boundaries": "虽然犬尿氨酸途径与色氨酸代谢有关（而色氨酸代谢常受微生物影响），但本文未建立其与微生物或免疫调节机制的联系。仅描述了其在不同肿瘤类型中的差异性分布。",
            "contribution": "识别了ATP、肌苷和犬尿氨酸代谢物作为肿瘤微环境代谢活性的潜在指标。",
            "facet_id": "F2",
            "possible_uses": "若综述涉及“肿瘤代谢产物对免疫微环境的影响”，可引用此发现作为某些代谢物（如犬尿氨酸衍生物）在肿瘤中富集的背景信息，提示其可能参与局部免疫抑制或能量竞争，但需明确这仅是相关性描述，非因果机制证明。"
          }
        ],
        "planning_summary": "该论文主要提供了一种用于评估实体瘤微环境代谢活性的技术平台（体内微透析+PDX模型），并确认了PDX模型在保留人类肿瘤代谢特征方面的有效性。对于综述主题“肠道微生物群如何调节实体瘤中免疫检查点抑制剂的疗效”，本文的直接证据有限，但可作为背景材料，说明在评估ICI疗效时，肿瘤局部的代谢微环境（如能量消耗标志物）是一个重要的考量维度，且PDX模型是研究这种局部效应的合适工具。",
        "scope_interpretation_cautions": [
          "本文未直接研究肠道微生物群或免疫检查点抑制剂，因此不能直接回答F1和F2的核心问题。",
          "提到的“犬尿氨酸代谢物”虽与免疫调节有关，但本文未探讨其免疫学功能，仅作为代谢标志物提及。",
          "结论基于PDX模型，外推到人类患者时需考虑模型局限性（如缺乏完整的免疫系统重建，除非特别说明）。"
        ],
        "topic_handles": [
          "体内微透析 (in vivo microdialysis)",
          "患者来源异种移植 (PDX models)",
          "肿瘤微环境代谢标志物 (TME metabolic biomarkers: ATP, inosine, kynurenine metabolites)",
          "能量消耗指示物 (energy consumption indicators)"
        ]
      },
