    "record::3a30c4034486bacfda33c1c8503f14cf976f9cf371c40c9a243680a710102a9b": {
      "source_handle": "P0052",
      "title": "278 Systematic review and meta-analysis evaluating the impact of antibiotic use on clinical outcomes of non-small-cell lung cancer patients treated with immune checkpoint inhibitors",
      "year": "2021",
      "doi": "10.1136/jitc-2021-sitc2021.278",
      "paper_id": "170103897e04d5c01b21fb4ba59ce4d3710e81bf",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统综述和荟萃分析方法。文献检索来源为PubMed和主要肿瘤学会议论文集。纳入标准包括报告基于抗生素暴露的HR或Kaplan-Meier曲线（用于OS和PFS），以及ORR和PD数据的研究。统计分析计算合并的HR（OS, PFS）和OR（ORR, PD），并按抗生素暴露的时间窗口进行亚组分析以评估时序效应。",
        "contribution_and_limits": [
          {
            "contribution": "提供了截至2021年中期的最新大规模荟萃分析证据，量化了抗生素对NSCLC患者ICI治疗OS、PFS、ORR和PD的综合影响，并细化了时间窗口的效应差异。",
            "limits": "所给材料未交代具体的异质性检验结果、发表偏倚评估细节、抗生素种类/疗程的细分分析、以及纳入研究的基线特征平衡情况。机制部分仅引用文献讨论，未在本研究中提供新的实验验证。"
          }
        ],
        "key_findings": [
          {
            "conditions": "纳入35个独立队列，共12,235名NSCLC患者；比较抗生素暴露组与非暴露组。",
            "finding": "合并HR显示OS为1.63 [95% CI 1.37-1.94]，PFS为1.49 [95% CI 1.26-1.76]，表明抗生素暴露显著降低生存率。"
          },
          {
            "conditions": "针对ORR和PD的分析，分别纳入1,992名和1,272名患者。",
            "finding": "合并OR显示ORR为0.66 [95% CI 0.44-0.99]，PD为1.98 [95% CI 1.39-2.8]，表明抗生素使用者治疗反应几率降低，疾病进展几率几乎翻倍。"
          },
          {
            "conditions": "基于抗生素暴露时间窗口的亚组分析。",
            "finding": "在ICI启动前后使用抗生素显示出更明显的有害效应。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管已有研究表明肠道微生物群失调可能影响ICI疗效，且既往研究提示抗生素有害，但需要更新最新证据并更全面地评估抗生素对NSCLC患者ICI治疗的多项临床结局（包括生存、缓解和进展）的具体影响程度及时间依赖性。",
        "research_scope": "非小细胞肺癌（NSCLC）患者，接受免疫检查点抑制剂（ICIs）治疗，暴露于抗生素（ABX）与未暴露的对比。",
        "work_summary": "该研究是一项系统综述和荟萃分析，旨在更新并扩展作者此前在2020年发表的相关工作。通过检索PubMed及主要肿瘤学会议论文集，纳入截至2021年7月发表的评估抗生素使用对NSCLC患者ICI治疗临床结局影响的研究。研究综合了35个独立队列的数据，分析了总生存期（OS）、无进展生存期（PFS）、总体缓解率（ORR）和疾病进展率（PD），并根据抗生素暴露的时间窗口进行了亚组分析。结果显示，抗生素暴露显著降低患者的生存率和治疗反应率，增加疾病进展风险，特别是在ICI启动前后使用的危害更为明显。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于“抗生素使用”这一关键混杂因素或调节变量对“免疫检查点抑制剂（ICI）疗效”影响的定量证据。它证实了抗生素暴露与较差临床结局（生存、缓解、进展）之间的强关联，并提示了时间窗口的重要性。这对于解释肠道微生物群介导的ICI疗效变异具有直接的实证支持价值，可作为综述中关于“外部干预/药物相互作用”或“微生物群扰动后果”章节的核心数据源。",
        "facet_contributions": [
          {
            "boundaries": "仅限于NSCLC人群，不能直接外推至所有实体瘤或其他癌症类型，除非有证据表明效应一致。未区分不同类别抗生素的影响。",
            "contribution": "提供了抗生素暴露作为负面调节因子影响ICI疗效的大样本荟萃分析数据（HR/OR值）。具体显示了OS HR=1.63, PFS HR=1.49, ORR OR=0.66, PD OR=1.98。",
            "facet_id": "F1",
            "possible_uses": "可用于回答“肠道微生物群如何调节ICI疗效”中的反面案例或干扰因素部分：即当微生物群被抗生素破坏时，疗效显著下降。提供具体的效应量估计。"
          },
          {
            "boundaries": "本综述本身未提供新的机制实验数据，仅汇总临床结局证据并引用其他研究的机制假说。不能据此推断具体的分子通路。",
            "contribution": "虽然不直接揭示分子机制，但通过确认抗生素（导致菌群失调）与疗效降低的强关联，间接支持了“微生物群完整性对ICI疗效至关重要”的假设。文中提及的两种潜在机制（细菌分子的免疫调节作用、共生菌与肿瘤抗原的抗原模拟）为机制探讨提供了文献背景。",
            "facet_id": "F2",
            "possible_uses": "用于构建“机制”部分的逻辑链条：抗生素->菌群失调->疗效降低。引用的参考文献（如Gopalakrishnan et al., Routy et al.）可作为机制解释的直接依据。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "有助于综述讨论“优化ICI治疗策略”或“管理合并症/合并用药”的部分，强调避免不必要的抗生素使用以保护微生物群和疗效。",
            "material": "发现ICI启动前后使用抗生素危害最大。",
            "purpose": "提供临床实践中的警示信号和剂量/时机建议的背景知识。"
          },
          {
            "connection_to_review": "增强综述关于“微生物群作为生物标志物或治疗靶点”的临床相关性论证，展示其巨大的公共卫生和临床影响规模。",
            "material": "35个队列，12,235名患者的汇总分析。",
            "purpose": "作为肠道微生物群与宿主免疫互作临床意义的流行病学证据。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究仅针对非小细胞肺癌（NSCLC），在将其结论应用于其他实体瘤（如黑色素瘤、肾癌等，这些也是ICI研究热点）时需格外谨慎，尽管机制可能相似，但效应大小可能不同。",
          "抗生素是一个异质性群体，本研究未区分抗生素的种类、谱系或疗程，因此“抗生素”作为一个整体类别的效应掩盖了潜在的差异性。",
          "观察性研究的汇总存在固有的混杂偏倚风险（如抗生素使用可能与感染严重程度、一般健康状况相关），尽管荟萃分析试图控制，但不能完全确立因果关系。",
          "所给材料未提供详细的异质性统计量（如I²），需警惕纳入研究间的临床和方法学差异。"
        ],
        "topic_handles": [
          "antibiotic exposure (ABX)",
          "non-small-cell lung cancer (NSCLC)",
          "immune checkpoint inhibitors (ICIs)",
          "overall survival (OS)",
          "progression-free survival (PFS)",
          "overall response rate (ORR)",
          "time window of antibiotic administration",
          "gut microbiome dysbiosis (as underlying mechanism context)"
        ]
      },
