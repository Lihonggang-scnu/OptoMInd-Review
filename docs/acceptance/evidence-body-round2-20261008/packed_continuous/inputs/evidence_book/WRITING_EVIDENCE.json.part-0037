    "record::c74ceafaf0f44d4428d1f44c9834e5d308c0933c5efca4ee53b7106017abb26b": {
      "source_handle": "P0220",
      "title": "A Review of Gut Microbiota‐Derived Metabolites in Tumor Progression and Cancer Therapy",
      "year": "2023",
      "doi": "10.1002/advs.202207366",
      "paper_id": "5d4d1432a51cc91edfadc9f8ca60f84f5bd9c2f4",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统性文献综述方法。1. **分类梳理**：将代谢物按功能分为促进肿瘤进展和抑制肿瘤进展两类，并按信号通路（MAPK, PI3K/Akt/mTOR, NFκB, Wnt/β-catenin）和免疫调节机制进行归类。2. **对比分析**：重点对比同一代谢物在不同癌症类型、不同浓度或不同免疫微环境下的相反作用（矛盾功能）。3. **临床转化关联**：将基础机制研究与临床治疗手段（放疗、化疗、免疫治疗）相结合，分析代谢物对现有疗法疗效和副作用的影响。4. **策略总结**：归纳基于代谢物调控的新型治疗干预措施及其优缺点。",
        "contribution_and_limits": [
          {
            "contribution": "提供了肠道微生物代谢物在癌症进展和治疗中作用的全面分类框架，详细列出了涉及的关键信号通路（MAPK, PI3K/Akt, NFκB, Wnt）和免疫细胞亚群。",
            "limits": "作为综述，其结论依赖于所引用的原始研究，未提供新的实验数据验证所有机制。对于某些代谢物的矛盾功能，原文指出需进一步探究因果机制，目前多为观察性关联。"
          },
          {
            "contribution": "明确了特定代谢物（如SCFAs, LCA, Inosine, TMAO）在不同癌症类型和微环境条件下的双向调节作用，强调了情境依赖性。",
            "limits": "部分机制描述较为概括，例如TMAO的具体抗癌机制被标记为“尚未完全阐明”，且不同研究间可能存在异质性，综述未深入探讨这些差异的来源。"
          },
          {
            "contribution": "总结了基于代谢物调控的新型治疗策略（饮食、噬菌体、FMT、合成生物学等），并评估了其优势和挑战。",
            "limits": "许多新型策略（如合成生物学工程菌、噬菌体联合疗法）仍处于早期研究阶段，临床应用的可行性和安全性尚待大规模临床试验证实。"
          }
        ],
        "key_findings": [
          {
            "conditions": "生理浓度下；结肠癌",
            "finding": "短链脂肪酸（SCFAs，如丁酸盐）通过抑制组蛋白去乙酰化酶（HDAC）和激活GPCRs，抑制结肠癌进展，促进Treg分化，抑制Th17。"
          },
          {
            "conditions": "非酒精性脂肪肝相关肝细胞癌（NAFLD-HCC）；高浓度",
            "finding": "SCFAs水平显著升高时，可能超过宿主耐受阈值，通过增加Tregs比例和损害CD8+ T细胞功能，促进肿瘤进展。"
          },
          {
            "conditions": "存在外源性IFN-γ和共刺激信号",
            "finding": "肌苷（Inosine）结合T细胞表面的A2AR，促进Th1分化，增强抗肿瘤免疫。"
          },
          {
            "conditions": "缺乏外源性IFN-γ",
            "finding": "肌苷（Inosine）通过A2AR抑制Th1和Th2细胞的分化，削弱抗肿瘤免疫。"
          },
          {
            "conditions": "结直肠癌",
            "finding": "石胆酸（LCA）激活ERK1/2并诱导miR21，抑制PTEN，促进IL-8分泌，加速肿瘤进展。"
          },
          {
            "conditions": "肾母细胞瘤和乳腺癌MCF-7细胞",
            "finding": "LCA结合GPBAR1受体，诱导细胞凋亡，发挥抑癌作用。"
          },
          {
            "conditions": "接受抗PD-1/PD-L1治疗的黑色素瘤患者",
            "finding": "responders体内粪便和血浆中SCFAs浓度显著高于non-responders，提示SCFAs可能影响免疫检查点阻断疗法的疗效。"
          },
          {
            "conditions": "伊立替康治疗",
            "finding": "肠道微生物β-葡萄糖醛酸酶将无活性的SN-38G转化为有毒性的SN-38，导致严重腹泻，限制化疗疗效。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "旨在解决肠道微生物代谢物在癌症发生发展及治疗响应中扮演的复杂角色尚不明确的问题，特别是其双重/矛盾功能及具体分子机制。目的是为未来科学研究提供新思路，并探索利用代谢物改善癌症治疗的潜在策略。",
        "research_scope": "肠道微生物群衍生的代谢物（Gut microbiota-derived metabolites）在肿瘤进展（Tumor Progression）和癌症治疗（Cancer Therapy）中的作用。涵盖多种癌症类型（如结肠癌、肝癌、乳腺癌等），重点讨论代谢物对肿瘤微环境（TME）、信号通路及免疫细胞的影响，以及其在放化疗和免疫治疗中的调节作用。",
        "work_summary": "该综述系统总结了肠道微生物代谢物与癌症之间的关联。首先阐述了代谢物如何通过重塑肿瘤微环境和调节关键信号通路（如MAPK, PI3K/Akt, NFκB, Wnt）来影响肿瘤进展，既包括促癌作用也包括抑癌作用。其次，分析了代谢物如何调节化疗药物（如伊立替康、吉西他滨）的疗效和毒性，以及如何增强或削弱免疫检查点阻断疗法（ICB）的效果。文章特别指出了部分代谢物（如短链脂肪酸SCFAs、石胆酸LCA、肌苷Inosine）具有情境依赖性的矛盾功能（Paradoxical Functions）。最后，综述了基于代谢物的新型治疗策略，包括饮食干预、噬菌体疗法、粪菌移植（FMT）、合成生物学改造及益生菌/益生元应用。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物如何通过代谢物调节免疫检查点抑制剂（ICI）在实体瘤中的疗效提供了丰富的机制素材和背景信息。它详细列举了促进ICI疗效（如SCFAs、肌苷、MDP）和阻碍ICI疗效（如SCFAs在某些情况下、吲哚类代谢物）的具体代谢物及其作用路径，并讨论了克服耐药性的策略（如FMT）。此外，它还涵盖了代谢物对化疗药物代谢的影响，可作为对比或补充材料。",
        "facet_contributions": [
          {
            "boundaries": "主要基于已发表的观察性研究和部分机制研究，部分关联（如SCFAs与ICI响应的统计相关性）的详细机制仍需进一步阐明。不同癌症类型中代谢物的作用可能不同，需注意适用范围。",
            "contribution": "提供了微生物代谢物调节ICI疗效的具体实例和方向。例如，指出接受抗PD-1治疗的响应者体内SCFAs水平较高；肌苷在特定条件下增强抗CTLA-4和抗PD-1抗体疗效；Enterococcus肽聚糖产物MDP通过NOD2激活NFκB增强抗肿瘤能力；TMAO增强胰腺癌对ICB的反应。同时也提到了SCFAs可能在转移性黑色素瘤中限制抗CTLA-4抗体功能的反面证据。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物如何调节ICI疗效”这一问题，提供具体的代谢物-免疫细胞互作案例，支持微生物组对ICI响应率影响的论点。"
