    "record::145e68ca2e945fe75d99a541fecf0169072899b02f0e06814032f4c22205ce71": {
      "source_handle": "P0515",
      "title": "Gut Microbiota-Derived Metabolites in Cancer Immunotherapy: Mechanisms and Clinical Potential",
      "year": "2026",
      "doi": "10.1051/bioconf/202621401024",
      "paper_id": "e79cf5704aa32b05d4bd83b923592452b3074529",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用叙述性综述方法，系统梳理现有文献中关于肠道微生物代谢物与宿主免疫系统相互作用的研究。文章按逻辑模块组织：1) 基础免疫调节机制（先天性与适应性免疫）；2) 主要代谢物类别及其分子机制（受体结合、表观遗传修饰等）；3) 在癌症免疫治疗中的具体作用（增强ICI反应、重塑TME、克服耐药）；4) 临床应用前景与挑战。未进行系统性检索流程描述或定量荟萃分析。",
        "contribution_and_limits": [
          {
