    "record::d7cb0101bff5b55d60160d56f5ecafe52106c12cea56e111e08fc335b6f7c244": {
      "source_handle": "P0581",
      "title": "Artemin and immune checkpoint inhibitor (ICI) efficacy in metastatic colorectal cancer (mCRC): A correlative analysis of the Canadian Cancer Trials Group (CCTG) CO.26 trial.",
      "year": "2024",
      "doi": "10.1200/jco.2024.42.16_suppl.3587",
      "paper_id": "5e59b9ca9a72cc8a626d875743ecc0ce1315af76",
      "material_depth": "",
      "material_status": "resolved",
      "aliases": [],
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch3.json",
        "source_handle": "P0581",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\progressive_review_plan\\20260924_microbiome\\run01\\level1\\supplements\\specific_metabolite_quantification\\source_units\\SU03_search_candidate_8d0ff07f57\\card\\PAPER_READING_CARD.json"
      },
      "study_summary_A": {
        "approach": "采用回顾性队列设计，利用已完成的II期随机对照试验（CO.26）的生物样本库数据。将患者按基线血清Artemin中位数（1.051 ng/ml）分为高、低两组。使用Kaplan-Meier法估算生存曲线，Log-rank检验比较组间差异，Cox比例风险模型评估Artemin对PFS和OS的预后及预测价值，并计算多变量交互作用p值以评估预测效应。同时监测治疗第8周及进展时的Artemin动态变化。",
        "contribution_and_limits": [
          {
            "contribution": "提供了Artemin作为MSS mCRC患者ICI治疗潜在预测生物标志物的临床证据，特别是高基线水平可能指示从双免疫治疗中获益。",
            "limits": "研究为事后分析（post-hoc），样本量相对较小（N=161），交互作用p值（0.061）未达到传统显著性阈值，结论需谨慎解读。未直接涉及肠道微生物组机制。"
          }
        ],
        "key_findings": [
          {
            "conditions": "BSC组，基线高Artemin vs 低Artemin",
            "finding": "高Artemin组OS较短（3.17个月 vs 5.65个月），HR 1.74 (95% CI 0.94-3.25, p=0.080)，提示其为不良预后标志物，但未达到统计学显著性。"
          },
          {
            "conditions": "D+T组 vs BSC组，基线高Artemin亚群",
            "finding": "在高Artemin患者中，D+T显著改善OS（6.44个月 vs 3.17个月），HR 0.54 (95% CI 0.33-0.91, p=0.020)。"
          },
          {
            "conditions": "D+T组 vs BSC组，基线低Artemin亚群",
            "finding": "在低Artemin患者中，D+T未显示OS优势（6.64个月 vs 5.65个月），HR 0.87 (95% CI 0.53-1.43, p=0.58)。多变量交互作用p值为0.061，提示预测趋势但不确证。"
          },
          {
            "conditions": "D+T组内，疾病进展（PD）vs 疾病稳定（SD）",
            "finding": "PD患者在第8周的Artemin水平较基线显著升高（p=0.026），而SD患者无显著变化（p=0.14）。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "尽管ICI在MSI-H/dMMR结直肠癌中有效，但在更常见的MSS mCRC中疗效有限，其耐药机制尚不完全清楚。近期研究发现肿瘤微环境中的EPCs可通过分泌Artemin发挥免疫抑制作用。本研究试图验证Artemin是否作为MSS mCRC患者对ICI治疗反应性和预后的生物标志物。",
        "research_scope": "微卫星稳定型转移性结直肠癌（MSS mCRC）患者，基于加拿大癌症试验组（CCTG）CO.26 II期临床试验的回顾性相关分析。研究对象为接受度伐利尤单抗联合曲美木单抗（D+T）或最佳支持治疗（BSC）的患者血清样本。",
        "work_summary": "本研究旨在探讨肿瘤微环境中红细胞祖细胞（EPCs）分泌的神经营养因子Artemin与免疫检查点抑制剂（ICI）疗效及预后的关系。通过对CO.26试验中161名有血清样本患者的基线及治疗期间Artemin水平进行分层，分析其对无进展生存期（PFS）和总生存期（OS）的影响。结果显示，高基线Artemin是不良预后标志物，且可能预测ICI治疗的获益；治疗期间Artemin水平的升高与疾病进展相关。"
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "用于论证为什么需要寻找生物标志物来筛选适合ICI治疗的MSS患者，从而引出对肠道微生物组等预测因子的探索必要性。说明当前领域面临的挑战：单一疗法在MSS中效果不佳，需精准分层。",
            "material": "CO.26试验数据显示，在未经选择的MSS mCRC人群中，双免疫治疗的整体获益有限，且存在明显的异质性（由Artemin水平区分）。",
            "purpose": "提供MSS结直肠癌中对ICI反应不佳的临床背景和数据支撑。"
          },
          {
            "connection_to_review": "在讨论“机制”部分时，可列举多种微环境细胞类型（如MDSCs, Tregs, EPCs等）及其分泌因子，说明肿瘤微环境的多元调控网络，避免将机制单一化归因于微生物组。",
            "material": "红细胞祖细胞（EPCs）作为非典型免疫调节细胞，通过分泌Artemin影响肿瘤进程。",
            "purpose": "展示肿瘤微环境复杂性对免疫治疗的影响。"
          }
        ],
        "facet_contributions": [
          {
            "boundaries": "该机制聚焦于血液/肿瘤微环境中的神经营养因子，不涉及肠道菌群代谢产物或定植竞争。不能直接外推为微生物组的作用，但可作为解释MSS CRC异质性的另一维度。",
            "contribution": "揭示了通过神经营养因子Artemin介导的免疫抑制微环境机制。具体而言，EPCs分泌Artemin可能与ICI耐药有关，高基线Artemin预示不良预后，且治疗期间升高提示进展。",
            "facet_id": "F2",
            "possible_uses": "可用于综述中讨论“除了肠道微生物组之外，还有哪些肿瘤微环境成分或旁分泌信号通路影响ICI疗效？”的部分。作为微生物组之外的独立或竞争性机制进行阐述。"
          }
        ],
        "planning_summary": "该论文提供了MSS结直肠癌中非微生物组的免疫抑制机制（EPC-Artemin轴）的具体案例。虽然不直接回答肠道微生物组的作用，但可作为“其他宿主/肿瘤微环境因素调节ICI疗效”的重要对比素材或背景，用于讨论为何某些MSS患者对ICI无反应，以及除微生物组外的替代或协同耐药机制。",
        "scope_interpretation_cautions": [
          "该研究针对的是MSS mCRC，而非所有实体瘤或所有类型的结直肠癌。",
          "Artemin作为预测标志物的效力基于事后分析，交互作用p=0.061，属于趋势性发现，不能作为确证的临床决策依据。",
          "该论文未涉及肠道微生物组，其贡献在于提供非微生物组的耐药机制视角，切勿将其结果误读为微生物组相关。",
          "样本来自加拿大特定临床试验队列，可能存在地域或人群特异性，外推至其他人群需谨慎。"
        ],
        "topic_handles": [
          "microsatellite stable colorectal cancer (MSS mCRC)",
          "immune checkpoint inhibitors (ICI) resistance mechanisms",
          "artemin / neurotrophic factor signaling",
          "erythroid progenitor cells (EPCs) in tumor microenvironment",
          "biomarker prediction for immunotherapy response",
          "durvalumab and tremelimumab combination therapy"
        ]
      },
      "card_material": {
        "known_gaps": [
          {
            "kind": "identity",
            "reason": "source identity was not independently verified",
            "status": "provisional"
          }
        ],
        "material_scope": "fulltext"
      },
