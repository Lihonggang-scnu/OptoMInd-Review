    "record::517e4ff3db173ff08232081b68dabe7dffcd0b1479a5f6de6bd26b9645ae9638": {
      "source_handle": "P0180",
      "title": "The gut microbiome–bile acid-FXR interplay: a pivotal axis in metabolic and gastrointestinal diseases",
      "year": "2026",
      "doi": "10.1080/19490976.2026.2665890",
      "paper_id": "4ed2637cc267e69d764e877652226e827eb752a9",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统性文献回顾与综合的方法。首先概述胆汁酸的生物学特性（合成、循环、微生物修饰）；其次，深入讨论微生物修饰胆汁酸对局部和全身效应的影响，重点分析FXR和TGR5等关键信号通路；接着，基于上述机制，归纳该轴在代谢紊乱、肝病、免疫失调和癌症等疾病发病机制中的贡献；最后，讨论靶向胆汁酸信号和肠道微生物群的 emerging therapeutic strategies（包括药物、饮食、益生菌/FMT），并指出未来研究方向。",
        "contribution_and_limits": [
          {
            "contribution": "提供了胆汁酸-微生物-FXR轴的全面机制框架，整合了从基础生化到临床疾病的多个层面，特别强调了微生物衍生胆汁酸对新型受体（如RORγt, VDR）的调节作用。",
            "limits": "作为综述，其结论依赖于已发表的研究，未提供新的实验数据。部分机制（如特定微生物胆汁酸的长期安全性、组织特异性FXR调节的临床转化）仍存在争议或不确定性，需更多研究验证。"
          }
        ],
        "key_findings": [
          {
            "conditions": "微生物群存在时",
            "finding": "肠道微生物通过BSH、bai操纵子等酶系将初级胆汁酸转化为次级/三级胆汁酸（如DCA, LCA, UDCA等），显著增加胆汁酸池的结构多样性和疏水性。"
          },
          {
            "conditions": "FXR激活状态下",
            "finding": "FXR作为胆汁酸稳态的主调控因子，通过抑制CYP7A1减少胆汁酸合成，并通过FGF19/15介导肠-肝通讯调节代谢。组织特异性（肝vs肠）的FXR激活具有不同的代谢后果。"
          },
          {
            "conditions": "特定微生物胆汁酸存在时",
            "finding": "某些微生物衍生的胆汁酸（如3-oxo-LCA, isoalloLCA）可直接结合并调节非经典受体（如RORγt, NR4A1），从而调节Th17/Treg平衡和肠道免疫。"
          },
          {
            "conditions": "高脂饮食或抗生素处理后",
            "finding": "饮食和环境因素可破坏胆汁酸-微生物轴，导致次级胆汁酸减少、初级胆汁酸积累，进而促进肥胖、脂肪肝、IBD和艰难梭菌感染等疾病。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "鉴于胆汁酸在宿主-微生物相互作用中的复杂性和重要性，亟需全面梳理胆汁酸-微生物轴的分子机制，特别是其在多种疾病病理生理学中的作用，并探讨基于此轴的治疗策略。",
        "research_scope": "肠道微生物群-胆汁酸-FXR信号轴在代谢性疾病、胃肠道疾病、免疫相关疾病及癌症中的分子机制与临床转化潜力。",
        "work_summary": "本文是一篇综述，系统阐述了肠道微生物群通过酶促修饰改变胆汁酸（BAs）池组成，进而调节宿主核受体（如FXR、TGR5等）信号通路的机制。文章详细描述了初级胆汁酸的合成与肠肝循环、微生物对胆汁酸的脱共轭、去羟基化等生物转化过程，以及这些微生物衍生的胆汁酸如何作为信号分子影响葡萄糖/脂质代谢、肝脏纤维化、肠道炎症、感染防御和肿瘤发生。最后，文章评估了针对该轴的药物治疗、饮食干预和微生物疗法的治疗潜力与挑战。"
      },
      "review_planning_B": {
        "planning_summary": "该综述虽不直接涉及免疫检查点抑制剂（ICIs），但其关于肠道微生物群如何通过胆汁酸代谢产物调节宿主免疫系统（特别是T细胞分化、巨噬细胞极化和肠道屏障功能）的机制描述，为理解微生物群对实体瘤免疫治疗反应的潜在间接影响提供了重要的背景知识和机制类比。它揭示了微生物-代谢物-免疫细胞互作的一般性原则，可作为解释微生物群状态如何塑造抗肿瘤免疫微环境的理论支撑。",
        "facet_contributions": [
          {
            "boundaries": "该综述聚焦于代谢和胃肠道炎症疾病中的免疫调节，未直接研究实体瘤中的ICI疗效。其描述的免疫调节主要发生在肠道局部或全身代谢背景下，不一定直接等同于肿瘤微环境中的ICI响应机制。",
            "contribution": "提供了肠道微生物群通过胆汁酸代谢产物调节宿主适应性免疫（Th17/Treg平衡）和固有免疫（巨噬细胞、ILC3s）的详细分子机制。例如，3-oxo-LCA抑制RORγt从而抑制Th17，isoalloLCA促进Treg分化。这些机制展示了微生物代谢物如何直接塑造免疫细胞表型。",
            "facet_id": "F2",
            "possible_uses": "可用于解释肠道微生物群如何通过产生特定代谢物来调节全身性或局部免疫反应，尽管具体靶点是炎症而非ICI，但其揭示的‘微生物代谢物-免疫细胞受体’互作模式可为ICI疗效的微生物机制提供类比或补充视角。"
          },
          {
            "boundaries": "未直接关联ICI疗效。其关于微生物群影响宿主表型的论述主要集中在代谢和炎症领域，不能直接外推到ICI疗效上。",
            "contribution": "阐述了肠道微生物群组成变化（如BSH阳性菌丰度、bai操纵子携带菌）如何改变胆汁酸池，进而影响宿主生理状态（如肥胖、胰岛素抵抗、肠道炎症）。这表明微生物群的功能状态（而不仅仅是物种组成）是决定宿主表型的关键。",
            "facet_id": "F1",
            "possible_uses": "可作为背景材料，说明肠道微生物群的功能多样性及其对宿主免疫状态的深远影响，暗示微生物群的状态可能通过类似机制影响其他免疫相关疾病（包括癌症免疫治疗）的反应性。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "虽然不直接涉及ICI，但这些机制展示了微生物代谢物如何精细调节免疫细胞功能，这可能与肿瘤微环境中免疫细胞的激活或抑制有关，为理解微生物群对免疫治疗的潜在影响提供理论基础。",
            "material": "综述中关于微生物胆汁酸（如3-oxo-LCA, isoalloLCA）调节RORγt和NR4A1从而影响Th17/Treg平衡的描述，以及FXR/TGR5在巨噬细胞和ILC3s中的作用。",
            "purpose": "提供肠道微生物群调节宿主免疫系统的通用机制背景"
          },
          {
            "connection_to_review": "可作为类比，说明微生物产生的代谢物可以作为信号分子远程调节宿主生理，这与某些微生物代谢物可能影响ICI疗效的概念相似。",
            "material": "胆汁酸被描述为关键的内分泌信号分子，通过FXR、TGR5等受体调节代谢和免疫。",
            "purpose": "提供胆汁酸作为微生物-宿主信号分子的例子"
          },
          {
            "connection_to_review": "肠道屏障功能是影响全身免疫状态的重要因素，可能在一定程度上影响ICI的疗效或副作用，可作为背景知识提及。",
            "material": "综述强调肠道屏障完整性受胆汁酸和微生物群调节，屏障受损会导致炎症和免疫异常。",
            "purpose": "提供肠道屏障功能与免疫关系的背景"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述是2026年的前瞻性/综合性文章，其内容代表当前领域的最新共识和观点，但需注意其预测性和建议部分可能尚未完全得到独立验证。",
          "文中提到的许多机制基于动物模型（如小鼠），在人类中的适用性需谨慎评估，特别是不同物种间胆汁酸谱和受体功能的差异。",
          "该综述未直接研究免疫检查点抑制剂，因此其关于微生物群对ICI疗效影响的任何推论都是间接的、推测性的，不能作为直接证据。",
          "文中提到的某些微生物胆汁酸的作用可能存在情境依赖性（如剂量、受体表达水平、其他共存代谢物），不能一概而论。"
        ],
