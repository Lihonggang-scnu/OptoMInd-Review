    "record::9cc12751d782ca6db2e16bcd0267d9ee9ab3e77988bc2207c6ccb73a5897acad": {
      "source_handle": "P0186",
      "title": "Abstract 2861: Comparative genomics of gut commensal\n Lachnospiraceae\n and their associations with cancer treatment response with immune checkpoint inhibitors",
      "year": "2026",
      "doi": "10.1158/1538-7445.am2026-2861",
      "paper_id": "52fc41afc10d1874915df79a5f918e521e7ca077",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "1. 临床观察基础：引用BEWEL试验，确立BRB饮食富集毛螺菌科与增强ICI疗效的关联。 2. 体内功能验证：在C57BL/6小鼠异种移植模型（MC38细胞）中，分别单独补充三种毛螺菌科菌株（B. obeum, B. massiliensis, A. rectalis），并与IgG对照组及抗PD-1治疗组比较，评估其对ICI抗肿瘤活性的影响。 3. 比较基因组学分析：提取这三种菌株的全基因组序列，使用KEGGREST映射和clusterProfiler进行过度代表测试，以所有基因组编码的KO为背景，识别B. obeum和B. massiliensis共有但A. rectalis缺失的177个KEGG正交ologs。 4. 通路注释与机制推断：将识别出的独特KO映射到KEGG通路，重点分析与免疫代谢相关的四类通路（乙酸产生、维生素合成、细胞壁修饰、胆汁酸转化），以此推断潜在的生物学机制。",
        "contribution_and_limits": [
          {
            "contribution": "提供了具体的因果证据链：从临床饮食干预（BRB）到特定菌群富集，再到单一菌株的功能验证（B. obeum/massiliensis有效 vs A. rectalis无效），最后通过比较基因组学锁定潜在机制基因集。",
            "limits": "所给摘要未交代具体的肿瘤抑制率数据、统计学显著性水平、菌株定植效率验证细节、以及体内代谢物（如乙酸、维生素、胆汁酸）的实际浓度测量结果。机制推断主要基于基因组存在性，而非直接的代谢产物功能验证或宿主免疫细胞表型的直接检测。"
          }
        ],
        "key_findings": [
          {
            "conditions": "在小鼠异种移植模型中，单独补充B. obeum或B. massiliensis，联合抗PD-1治疗",
            "finding": "显著改善了ICI的抗肿瘤有效性"
          },
          {
            "conditions": "在小鼠异种移植模型中，单独补充A. rectalis，联合抗PD-1治疗",
            "finding": "未观察到对ICI有效性的改善"
          },
          {
            "conditions": "比较B. obeum, B. massiliensis与A. rectalis的基因组",
            "finding": "鉴定出177个仅在有效菌株（B. obeum, B. massiliensis）中存在而在无效菌株（A. rectalis）中缺失的KEGG正交ologs"
          },
          {
            "conditions": "对这177个独特KO进行KEGG通路富集分析",
            "finding": "发现四个关键通路：(1) Wood-Ljungdahl途径基因（产乙酸，T细胞能量来源）；(2) 叶酸(B9)和钴胺素(B12)合成基因（支持T细胞增殖）；(3) L-鼠李糖合成基因（细胞壁装饰，激活先天免疫）；(4) 胆汁酸转化为次级异构胆汁酸的基因（调节FXR/TGR5受体，影响Th17/Treg平衡）"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "尽管已知肠道微生物组影响ICI疗效，且BRB饮食能富集毛螺菌科并增强疗效，但具体是哪些毛螺菌科菌株起作用，以及它们通过何种分子机制介导这种疗效增强？特别是为何某些菌株有效而其他近缘菌株无效？",
        "research_scope": "研究对象为肠道共生菌毛螺菌科（Lachnospiraceae）中的特定菌株，包括 Blautia obeum、Blautia massiliensis 和 Agathobacter rectalis。情境涉及小鼠异种移植模型（MC38结肠癌细胞），干预措施包括饮食补充黑覆盆子汁（BRB）以富集微生物组，以及单独补充上述三种菌株。主要测量方式包括肿瘤生长对免疫检查点抑制剂（ICI，抗PD-1）的反应、细菌基因组比较分析（KEGG正交ologs）、通路富集分析。",
        "work_summary": "该研究旨在探究毛螺菌科成员如何影响免疫检查点抑制剂（ICI）的疗效。基于BEWELL试验中BRB饮食能富集毛螺菌科并增强小鼠ICI抗肿瘤活性的背景，作者进一步通过单菌株补充实验，比较了三种相关菌株（B. obeum, B. massiliensis, A. rectalis）对ICI疗效的影响差异。研究发现前两种菌株能改善ICI效果，而后者不能。随后，通过对这三种菌株进行全基因组比较，识别出仅在前两种有效菌株中存在而在无效菌株中缺失的177个KEGG正交ologs。通过KEGG通路分析，这些独特基因被归类为四个与免疫和ICI反应相关的代谢/信号通路：乙酰辅酶A合成（Wood-Ljungdahl途径）、T细胞增殖所需维生素（叶酸B9和钴胺素B12）合成、L-鼠李糖合成（作为微生物相关分子模式激活先天免疫），以及胆汁酸转化为次级异构胆汁酸以调节Th17/Treg平衡。结论认为，BRB响应的毛螺菌科拥有富集的代谢和免疫调节基因程序，这可能解释了其与改善ICI肿瘤反应的关联。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于肠道微生物组调节ICI疗效的具体菌株特异性证据和潜在分子机制假设。它特别有价值地展示了如何通过比较有效与无效的近缘菌株来缩小机制研究的范围，并提出了四种具体的代谢/信号通路作为候选机制。这对于回答“哪些菌群成分重要”以及“可能的作用机制是什么”这两个子问题具有直接参考价值。",
        "facet_contributions": [
          {
            "boundaries": "仅限于毛螺菌科内的三个特定菌株；未涵盖其他门类的细菌；未提供人类临床试验的直接疗效数据，仅为小鼠模型和基因组关联。",
            "contribution": "提供了毛螺菌科内部不同菌株对ICI疗效影响的差异性证据。明确指出并非所有毛螺菌科成员都能增强ICI疗效，只有特定的Blautia物种（obeum, massiliensis）有效，而Agathobacter rectalis无效。这有助于在综述中细化“有益菌群”的定义，避免将毛螺菌科视为同质化整体。",
            "facet_id": "F1",
            "possible_uses": "用于区分不同肠道菌群分类单元对ICI疗效的贡献差异，支持“菌株特异性效应”的观点。"
          },
          {
            "boundaries": "这些机制是基于基因组存在的预测（in silico），尚未在体内通过代谢物测量或基因敲除实验得到直接验证。例如，未证明乙酸确实达到了影响T细胞的浓度，也未证明L-鼠李糖确实发挥了MAMP作用。",
            "contribution": "提出了四种具体的潜在分子机制路径，基于基因组比较发现的有效菌株特有基因：(1) 乙酸生产（Wood-Ljungdahl途径）作为T细胞能量源；(2) 叶酸和钴胺素合成促进T细胞增殖；(3) L-鼠李糖合成作为MAMP激活先天免疫；(4) 胆汁酸转化调节Th17/Treg平衡。这些为理解微生物如何代谢调控宿主免疫提供了具体的生化线索。",
            "facet_id": "F2",
            "possible_uses": "用于构建微生物-宿主互作的机制框架，特别是在代谢产物（短链脂肪酸、维生素、胆汁酸）和免疫细胞功能（T细胞能量、增殖、分化）之间的联系方面。可作为后续寻找更多类似机制论文的对比基准。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "可用于综述中介绍饮食干预调节微生物组进而影响癌症治疗的实例，强调可溶性膳食纤维或植物化合物作为微生物组调节剂的潜力。",
            "material": "BEWELL试验中BRB饮食富集毛螺菌科并增强ICI疗效的背景信息。",
            "purpose": "背景与案例：展示从临床观察（BRB饮食）到机制探索的研究范式。"
          },
          {
            "connection_to_review": "支持综述中关于微生物组效应具有高度菌株特异性的论点，提醒读者在解读宏基因组数据时需注意分辨率问题。",
            "material": "同一科内不同菌株对ICI疗效的不同影响（B. obeum/massiliensis vs A. rectalis）。",
            "purpose": "概念澄清：区分“属/科水平”与“菌株水平”的微生物组效应。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究的机制结论完全基于基因组比对和通路富集分析，属于相关性或预测性证据，而非功能性验证。在综述中引用其机制部分时，应明确标注为“基因组预测的潜在机制”，而非已证实的生理机制。",
          "研究对象为小鼠模型，且使用的是异种移植模型（MC38），其结果外推到人类实体瘤患者时需考虑物种差异和模型局限性。",
          "仅涉及毛螺菌科内的三个菌株，不能代表整个肠道微生物组或毛螺菌科的全部多样性。"
