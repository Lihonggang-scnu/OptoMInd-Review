    "record::880a4cdb0c38e0b0bd47c6f056d0c5a733e6fe99e47cf724ceb83695e7fa6374": {
      "source_handle": "P0124",
      "title": "THE MICROBIOME–HOST AXIS IN CANCER THERAPY: MECHANISMS SHAPING IMMUNOTHERAPY EFFICACY AND TREATMENT TOXICITY",
      "year": "2026",
      "doi": "10.31435/ijitss.2(50).2026.5462",
      "paper_id": "364d5abc343a02132e4f3f24c0b441cb277190f2",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用叙述性机制综述的方法，结合结构化文献检索。检索范围涵盖PubMed/MEDLINE、Embase和Scopus数据库（2010年1月至2026年3月）。筛选标准侧重于具有机制见解和临床应用价值的原创研究、临床试验和高影响力综述。数据提取聚焦于分类特征、生化通路和临床结果，并使用“机制框架分析”将发现归类为系统性免疫调节、局部肿瘤微环境变化和异生物质代谢。",
        "contribution_and_limits": [
          {
            "contribution": "系统性地整合了微生物组影响癌症治疗疗效和毒性的多种机制，包括代谢物介导的免疫调节、瘤内微生物群的直接药物相互作用以及性别特异性差异。",
            "limits": "作为叙述性综述，其证据等级依赖于所选文献的代表性和作者的解释框架；未提供新的原始实验数据或严格的荟萃分析统计结果；不同人群（如东西方）的微生物基线差异可能导致普适性限制。"
          }
        ],
        "key_findings": [
          {
            "conditions": "接受免疫检查点抑制剂治疗的实体瘤患者",
            "finding": "特定的细菌组合（如Akkermansia muciniphila、Ruminococcaceae家族成员）及其产生的生物活性代谢物（肌苷、短链脂肪酸、色氨酸衍生物）是ICI成功的关键先决条件；抗生素使用与ICI疗效降低相关。"
          },
          {
            "conditions": "胰腺癌等实体瘤的微环境",
            "finding": "瘤内微生物群（主要是Gammaproteobacteria）表达胞苷脱氨酶（CDA），可将吉西他滨转化为无活性形式，导致化疗耐药；消除这些细菌可恢复药物疗效。"
          },
          {
            "conditions": "全身免疫系统调节",
            "finding": "短链脂肪酸（特别是丁酸盐）作为组蛋白去乙酰化酶抑制剂，增强T细胞适应性；肌苷通过腺苷A2A受体信号通路增强Th1分化，绕过肿瘤微环境的抑制信号。"
          },
          {
            "conditions": "异生物质代谢与毒性",
            "finding": "肠道细菌产生的β-葡萄糖醛酸酶可重新激活伊立替康，导致严重的黏膜损伤和腹泻；微生物特征可用于预测药物诱导的毒性。"
          },
          {
            "conditions": "造血干细胞移植（HSCT）后",
            "finding": "肠道微生物多样性丧失是移植相关死亡和移植物抗宿主病（GVHD）的独立风险因素；Blautia属与GVHD相关死亡率降低有关，而肠球菌属扩张加剧炎症。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "现代肿瘤学正从将肿瘤视为孤立组织块转向将其视为复杂多物种生态系统的一部分。本研究旨在解决的关键问题是：微生物组（特别是肠道和瘤内微生物群）如何调节宿主抗肿瘤免疫，并具体通过哪些机制影响当前化疗和免疫治疗方案的疗效和毒性？",
        "research_scope": "肿瘤治疗中的微生物组-宿主轴，涵盖肠道微生物群、瘤内微生物群及其对免疫检查点抑制剂（ICIs）疗效和化疗毒性的影响。研究对象包括成人及儿科实体瘤和血液恶性肿瘤患者，涉及机制模型、临床队列和代谢组学数据。",
        "work_summary": "本文是一篇叙述性机制综述，旨在全面分析微生物组-宿主轴在癌症治疗中的作用。文章综合了57篇关键文献，探讨了特定细菌群落及其生物活性代谢物（如肌苷、短链脂肪酸、色氨酸衍生物）如何作为免疫检查点抑制剂成功的先决条件。此外，还讨论了细菌酶（如胞苷脱氨酶）在局部药物降解和化疗耐药中的作用，以及新兴的“微生物性别组”在治疗反应和毒性谱中的性别特异性差异。结论强调将微生物监测纳入标准临床协议对于个性化肿瘤治疗和长期生存质量的重要性。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物群如何调节实体瘤中免疫检查点抑制剂（ICI）的疗效提供了详细的机制背景。它特别强调了特定细菌代谢物（如肌苷、SCFAs）和瘤内微生物酶（如CDA）的具体作用路径，这对于回答“微生物组如何调节ICI疗效”及其“介导机制”至关重要。同时，它也提供了关于抗生素使用、饮食干预和粪菌移植（FMT）等临床策略的背景信息。",
        "facet_contributions": [
          {
            "boundaries": "主要基于综述引用的观察性研究和临床试验结果，具体关联强度因研究而异；未提供统一的量化效应值。",
            "contribution": "提供了特定肠道菌群（如Akkermansia muciniphila, Bifidobacterium pseudolongum）与ICI疗效正相关的证据，以及抗生素使用导致疗效下降的观察结果。",
            "facet_id": "F1",
            "possible_uses": "用于支持肠道微生物群组成是影响ICI疗效的关键因素这一论点，并可作为比较不同研究中菌群特征的基准。"
          },
          {
            "boundaries": "机制描述主要来源于体外实验和小鼠模型，部分在人体中的验证程度在所给材料中未完全交代；不同代谢物之间的协同作用细节有限。",
            "contribution": "详细阐述了肌苷通过A2A受体信号通路增强Th1分化的机制，以及短链脂肪酸（丁酸盐）通过表观遗传修饰和代谢重编程增强CD8+ T细胞功能的机制。",
            "facet_id": "F2",
            "possible_uses": "直接回答“介导机制”问题，提供具体的分子通路解释，有助于区分不同代谢物的作用方式。"
          },
          {
            "boundaries": "主要针对特定类型的化疗药物和特定肿瘤类型（如胰腺癌），其普遍性在其他实体瘤中尚需更多证据支持。",
            "contribution": "揭示了瘤内微生物群（如胰腺肿瘤中的Gammaproteobacteria）通过表达胞苷脱氨酶（CDA）直接降解化疗药物（吉西他滨）从而导致耐药的机制。",
            "facet_id": "F2",
            "possible_uses": "补充了微生物组不仅通过免疫调节，还通过直接药物代谢影响治疗结果的机制视角，丰富了机制理解的维度。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供关于微生物组在癌症治疗中长期影响的背景，包括治疗后菌群失调对幸存者健康的影响。",
            "material": "讨论部分提到儿童癌症幸存者长期存在的菌群改变与代谢综合征、肥胖等并发症的风险增加有关。",
            "purpose": "用于综述中关于癌症治疗长期后果或幸存者护理的部分，强调保护微生物资本的重要性。"
          },
          {
            "connection_to_review": "提供关于性别差异在微生物组-治疗反应关系中的背景信息。",
            "material": "介绍“微生物性别组”概念，指出雌激素和雄激素可能通过影响肠道通透性和特定菌群丰度来调节治疗反应。",
            "purpose": "用于探讨个体化医疗中性别因素的作用，或作为未来研究方向建议的背景。"
          },
          {
            "connection_to_review": "提供关于临床干预策略（如FMT、益生菌、饮食调整）的现有证据和伦理考量。",
            "material": "总结了FMT克服ICI原发耐药性的临床试验结果，以及工程菌疗法的前景和风险。",
            "purpose": "用于综述中关于潜在治疗干预措施的有效性和安全性的讨论部分。"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述为叙述性综述，非系统评价或荟萃分析，因此其结论代表了作者的综合性观点而非严格的统计汇总。",
          "所引用的机制研究多来自小鼠模型或体外实验，其在人体内的直接适用性和效力可能存在差异，需谨慎外推。",
          "不同地理区域和饮食习惯导致的微生物基线差异可能影响某些菌群标志物的普适性，特别是在跨种族比较时。",
          "关于“微生物性别组”的内容较为新兴，具体机制和临床意义仍需更多研究证实，目前主要作为假设提出。"
        ],
        "topic_handles": [
          "gut microbiome modulation of ICI efficacy",
          "intratumoral microbiome and chemoresistance",
