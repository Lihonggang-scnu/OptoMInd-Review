    "record::479bb28f9e8000d9f4d9d0faddf4d6d82e7de7f98673844d2aad5ade777f7b38": {
      "source_handle": "P0586",
      "title": "Dual-function engineered bacteria remodel AML tumor microenvironment via IL-12 delivery and adenosine depletion to sustain NK cell immunity",
      "year": "2025",
      "doi": "10.1182/blood-2025-5912",
      "paper_id": "04c11cfcf5a3539fa2c39d0839134cb7fc2116bd",
      "material_depth": "",
      "material_status": "resolved",
      "aliases": [],
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch3.json",
        "source_handle": "P0586",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\level1\\external\\N76e5cbf6bca57e729afb-df9b777a93e759ce\\round_2\\supplements\\case_C2_inosine_tme\\attempt-3mh8pfko\\source_units\\SU01_search_candidate_8befa74e98\\card\\PAPER_READING_CARD.json"
      },
      "study_summary_A": {
        "approach": "采用合成生物学手段构建表面展示系统：利用优化的外膜支架和FLAG标签，在非致病性E. coli表面共展示鼠源和人源IL-12、ADA或IL-12+ADA融合蛋白。通过流式细胞术验证表达，HEK-Blue报告基因检测IL-12生物活性，LC-MS和比色法评估ADA动力学。体外采用多色流式细胞术分析NK细胞在共培养后的活化标志物（CD25, NKG2D, NKp30）、腺苷信号通路分子（A2AR, CD73, CD39, CD26）及对AML靶细胞（NOMO1, OCI-AML3）的细胞毒性。体内使用免疫健全的小鼠模型，分别接种WEHI-3 AML细胞和B16-F10黑色素瘤细胞，通过静脉注射工程菌评估抗肿瘤效果、细菌分布（CFU计数）、生存率及免疫记忆（再挑战实验）。",
        "contribution_and_limits": [
          {
            "contribution": "提出并验证了一种基于活体微生物的双功能策略，通过同时递送IL-12和降解腺苷来重塑免疫抑制性TME，克服了单一疗法的局限性（如IL-12的全身毒性或ADA仅改善代谢环境）。",
            "limits": "所给摘要未交代长期安全性数据（除短期耐受性外）、人类临床转化中的潜在免疫原性问题、以及该策略在其他类型血液肿瘤或实体瘤中的普适性验证范围。体内实验主要依赖小鼠模型，且黑色素瘤模型为瘤内注射，与AML的静脉给药路径不同，机制外推需谨慎。"
          }
        ],
        "key_findings": [
          {
            "conditions": "体外共培养，比较不同工程菌处理组",
            "finding": "共展示IL-12和ADA的工程菌在表面表达>80%，IL-12具有显著生物活性；鼠源ADA具有高酶活（Km=0.05），4小时内完全将腺苷转化为肌苷。"
          },
          {
            "conditions": "体外NK细胞活化与毒性测试，含/不含高浓度腺苷（1mM）",
            "finding": "单独IL-12展示菌显著上调NK细胞活化标志物（CD25, NKp30）并增加AML细胞毒性（≥3.4倍）；但IL-12也上调了腺苷生成代谢检查点CD73和受体A2AR，使NK细胞对腺苷更敏感。单独ADA展示菌可恢复被腺苷抑制的NK细胞功能和AML裂解。共展示IL-12和ADA的菌株在高腺苷环境下维持了完整的NK效应功能，并将AML靶向裂解率从5%提升至56%。"
          },
          {
            "conditions": "体内AML模型（WEHI-3），静脉注射不同工程菌",
            "finding": "工程菌在骨髓中表现出前所未有的肿瘤导向迁移，ADA工程菌聚集量达4x10^5 CFU，IL-12工程菌达3x10^4 CFU。IL-12+ADA组中位生存期未到达（d29时2/3存活），显著优于对照组（中位10天）及单因子组（IL-12组26天，ADA组17天）。"
          },
          {
            "conditions": "体内黑色素瘤模型（B16-F10），瘤内注射IL-12+ADA工程菌",
            "finding": "诱导肿瘤完全消退，100%生存率；再挑战实验确认了持久的抗肿瘤免疫记忆。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "如何解决AML等实体/血液肿瘤中因免疫抑制性微环境（特别是高浓度腺苷和低水平刺激性细胞因子）限制细胞免疫疗法疗效的问题？具体而言，如何在不引起全身毒性的前提下，同时提供免疫刺激信号并清除免疫抑制代谢物？",
        "research_scope": "急性髓系白血病（AML）及黑色素瘤（B16-F10模型）的肿瘤微环境（TME），研究对象为工程化非致病性大肠杆菌（E. coli K12 DH5α），重点考察其对自然杀伤细胞（NK细胞）免疫功能的调节作用。",
        "work_summary": "该研究针对AML中因免疫抑制性代谢物（如腺苷）积累和刺激性细胞因子缺乏导致的免疫治疗失效问题，开发了一种双功能工程化细菌平台。通过在大肠杆菌表面共展示IL-12细胞因子和腺苷脱氨酶（ADA），旨在实现局部细胞因子递送与代谢重编程。体外实验证实，该策略能显著增强NK细胞的活化标志物表达及针对AML细胞的细胞毒性，并在高腺苷环境下维持免疫功能。体内实验显示，静脉注射该工程菌可在骨髓中特异性聚集，显著延长AML小鼠模型的生存期，并在黑色素瘤模型中诱导完全缓解及持久的免疫记忆。"
      },
      "review_planning_B": {
        "broader_review_uses": [
          {
            "connection_to_review": "尽管不直接涉及肠道菌群，但该材料支持了“利用微生物进行癌症免疫治疗”的整体概念，可作为综述中介绍新兴微生物治疗策略时的背景知识或技术对比。",
            "material": "工程化E. coli在体内良好耐受，无显著体重下降，且在骨髓中高丰度聚集。",
            "purpose": "提供微生物疗法的技术可行性与安全性背景"
          },
          {
            "connection_to_review": "有助于理解ICI疗效受阻的潜在代谢机制，即使ICI主要作用于PD-1/PD-L1，但微环境中的腺苷积累同样构成屏障。此材料可补充综述中关于“多重免疫抑制机制”的部分。",
            "material": "腺苷通过A2AR抑制NK细胞，CD73作为上游生成酶被IL-12上调。",
            "purpose": "提供免疫抑制微环境中代谢检查点的实例"
          }
        ],
        "facet_contributions": [
          {
            "boundaries": "该机制主要在NK细胞层面验证，未涉及T细胞或其他免疫亚群在ICI背景下的具体反应；且未直接涉及肠道菌群与系统性ICI疗效的关系。",
            "contribution": "提供了具体的代谢-免疫交互机制证据：揭示了IL-12虽能激活NK细胞，但同时会诱导CD73和A2AR表达，增加细胞对腺苷的敏感性；而ADA工程菌通过清除腺苷抵消了这一副作用，从而维持NK细胞功能。这说明了单纯免疫刺激可能不足以克服代谢抑制，需要联合代谢干预。",
            "facet_id": "F2",
            "possible_uses": "可用于解释为何某些免疫治疗失败源于微环境代谢抑制，以及为何联合代谢调节剂（如ADA抑制剂或工程菌）可能增强免疫治疗效果。可作为“微环境代谢调控影响免疫细胞功能”的具体实例。"
          },
          {
            "boundaries": "本研究使用的是工程化大肠杆菌，而非天然肠道菌群；给药途径为静脉或瘤内，而非口服肠道菌群移植。因此不能直接用于回答“肠道菌群组成如何影响ICI疗效”，但可作为“微生物疗法”这一大类下的技术路线参考。",
            "contribution": "展示了活体微生物作为免疫调节平台的潜力：证明了非致病性细菌可以安全地在肿瘤部位（包括骨髓）定植并发挥功能，且能诱导持久的免疫记忆。",
            "facet_id": "F1",
            "possible_uses": "可作为综述中讨论“微生物疗法（Microbiome-based therapy）”或“活体生物药（Live Biotherapeutic Products, LBPs）”在癌症免疫治疗中的应用前景和技术挑战的对比案例。特别适用于讨论细菌载体在克服免疫抑制微环境方面的优势。"
          }
        ],
        "planning_summary": "该论文提供了一个关于“活体微生物作为免疫调节载体”的具体案例，展示了如何通过工程化细菌同时解决免疫抑制微环境中的代谢障碍（腺苷堆积）和细胞因子不足问题。虽然其直接应用场景是AML和黑色素瘤，而非肠道菌群介导的ICIs疗效，但其揭示的“细菌定植-代谢重编程-免疫细胞激活”机制链条，以及细菌在肿瘤微环境中的归巢特性，可为综述中讨论“微生物疗法作为ICI辅助手段”或“微环境代谢调控对免疫检查点阻断的影响”提供重要的机制参考和对比素材。",
        "scope_interpretation_cautions": [
          "本文研究对象为工程化细菌，非天然肠道菌群，不可直接推断肠道菌群对ICI疗效的影响。",
          "体内实验包含AML（血液肿瘤）和黑色素瘤（实体瘤），但给药方式不同（静脉vs瘤内），结果不可简单互换。",
          "作者声称的“前所未有”的骨髓归巢现象需结合原文详细方法判断是否为普遍规律或特定菌株特性。",
          "IL-12的全身毒性限制是本研究的动机之一，工程化策略旨在解决此问题，但长期安全性数据在摘要中未充分展示。"
        ],
        "topic_handles": [
          "工程化细菌载体",
          "肿瘤微环境代谢重编程",
          "腺苷脱氨酶（ADA）与腺苷信号通路",
          "IL-12局部递送",
          "NK细胞活化与功能维持",
          "细菌肿瘤归巢",
          "联合免疫治疗策略"
        ]
      },
