    "record::ec2a02729d6c1d88e1ca4fe504295babc856c1560275467c38a02f3276e5f840": {
      "source_handle": "P0413",
      "title": "Effect of Gut Microbiota-Derived Metabolites on Immune Checkpoint Inhibitor Therapy: Enemy or Friend?",
      "year": "2022",
      "doi": "10.3390/molecules27154799",
      "paper_id": "b4de79d677aec2f2b495ddebba1aaf8a77cffc38",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统性文献回顾与综合的方法。作者检索并整理了从临床前研究到临床研究的相关证据，按照代谢物的化学类别（SCFAs、肌苷、TMAO、色氨酸衍生物、胆汁酸及其他分子）进行分类叙述。对于每一类代谢物，综述了其在动物模型和临床试验中的观察结果，归纳了其作用的免疫细胞类型（如CD8+ T细胞、Treg、巨噬细胞等）及关键信号通路（如HDAC、mTOR、GPRs、AhR、NOD2等）。同时，对比分析了同一代谢物在不同治疗背景下的矛盾发现，以评估其复杂性和情境依赖性。",
        "contribution_and_limits": [
          {
            "contribution": "系统性地汇总了肠道微生物代谢物调节ICIs疗效的多维证据，特别是揭示了同一代谢物（如SCFAs）在不同ICIs靶点（PD-1 vs CTLA-4）下可能具有截然相反的免疫调节作用，强调了治疗策略的情境依赖性。",
            "limits": "作为综述，依赖于已发表研究的总结，未提供新的原始实验数据；部分机制（如肌苷的双重作用、特定代谢物的精确剂量效应）仍需更多临床验证；未能涵盖所有可能的微生物代谢物种类。"
          }
        ],
        "key_findings": [
          {
            "conditions": "接受PD-1/PD-L1阻断治疗的实体瘤患者及小鼠模型",
            "finding": "粪便中高浓度的短链脂肪酸（SCFAs，如丙酸、丁酸、戊酸）与较长的无进展生存期（PFS）及更好的治疗反应相关；SCFAs通过抑制HDAC、激活GPRs和调节mTOR通路增强CD8+ T细胞的细胞毒性和分化。"
          },
          {
            "conditions": "接受CTLA-4阻断治疗的转移性黑色素瘤患者及小鼠模型",
            "finding": "血清中高浓度的丁酸和丙酸与较差的ICIs疗效负相关；丁酸抑制记忆T细胞的积累和树突状细胞上CD80/CD86的上调，增加Treg比例，从而削弱抗CTLA-4疗效。"
          },
          {
            "conditions": "膀胱癌和小肠癌小鼠模型",
            "finding": "肠道菌群产生的肌苷（Inosine）可通过A2aR-cAMP-PKA通路促进Th1分化，增加IFN-γ+ CD4+和CD8+ T细胞浸润，增强抗CTLA-4和抗PD-L1疗效；但在缺乏外源IFN-γ时可能抑制Th1分化，且需CpG共刺激。"
          },
          {
            "conditions": "小鼠肿瘤模型及部分临床数据",
            "finding": "氧化三甲胺（TMAO）通过激活PERK介导的内质网应激和Gasdermin-E介导的细胞焦亡，增强CD8+ T细胞介导的抗肿瘤免疫，提高抗PD-1疗效；高血浆TMAO水平与较长PFS相关。"
          },
          {
            "conditions": "胰腺导管腺癌小鼠模型 vs. 结肠癌/乳腺癌模型",
            "finding": "乳酸杆菌来源的吲哚类色氨酸代谢物（如Indoles）在胰腺癌中通过激活TAMs上的A2aR抑制CD8+ T细胞释放IFN-γ，抑制免疫；而双歧杆菌产生的ILA可诱导结肠癌细胞凋亡，IPA可抑制乳腺癌生长，显示出色氨酸代谢物效应的异质性。"
          },
          {
            "conditions": "多种癌症模型",
            "finding": "次级胆汁酸代谢物3-oxoLCA和isoLCA通过抑制ROR-γt抑制Th17细胞分化；去氧胆酸（DCA）在某些情况下促进血管生成模拟。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管ICIs显著改善了癌症患者生存率，但客观缓解率仍低于30%。肠道微生物群已知能调节ICIs疗效，但其具体作用模式尚不明确。本研究旨在解决：肠道微生物代谢物如何具体调节抗肿瘤免疫？它们作为ICIs疗效增强剂或生物标志物的潜力如何？其背后的分子机制是什么？",
        "research_scope": "肠道微生物群及其衍生的代谢物（如短链脂肪酸、肌苷、TMAO、色氨酸代谢物、次级胆汁酸等）对实体瘤免疫检查点抑制剂（ICIs，包括PD-1/PD-L1和CTLA-4抗体）疗效的调节作用及潜在机制。",
        "work_summary": "本文是一篇综述，旨在梳理肠道微生物群通过其代谢产物调节抗肿瘤免疫并影响ICIs疗效的证据与机制。文章首先介绍了肿瘤微环境与免疫细胞的关系，随后分类详细讨论了短链脂肪酸（SCFAs）、肌苷、氧化三甲胺（TMAO）、色氨酸代谢物和次级胆汁酸等主要代谢物的功能、产生菌及分子机制（如HDAC抑制、GPR受体激活、AhR通路等）。文中特别指出了不同代谢物在不同癌症模型或ICIs类型中可能存在的相反效果（如丁酸盐在抗PD-1治疗中的促进作用与在抗CTLA-4治疗中的抑制作用），并探讨了基于代谢物的生物标志物预测、免疫佐剂开发及饮食干预等未来策略。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物代谢物如何作为‘敌人或朋友’调节ICIs疗效提供了详细的机制图谱和临床关联证据。其核心价值在于揭示了代谢物效应的异质性和双向性（如SCFAs的双刃剑效应），以及具体的分子通路（HDAC, GPR, AhR等）。这有助于在综述中解释为何某些微生物特征在不同研究中表现出不一致的预后价值，并为基于代谢物的联合治疗策略提供理论依据。",
