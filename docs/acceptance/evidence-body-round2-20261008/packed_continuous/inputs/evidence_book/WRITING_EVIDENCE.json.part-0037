      "material_read_from_disk": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\level2\\external\\Nf2f13ca37a1cba78c9d1-b532f13f7ac0c36c\\round_1\\supplements\\case_C2_inosine_tme\\attempt-trstv1th\\source_units\\SU03_search_candidate_6b36eb7123\\card\\PAPER_READING_CARD.json"
