    "record::3a3c6e8f18d29cdc982e82a7b806438cad30317d7263fd43d50d99324be8e7ea": {
      "source_handle": "P0564",
      "title": "Influence of Microbiome and Antibiotics on the Efficacy of Immune Checkpoint Inhibitors",
      "year": "2021",
      "doi": "10.7759/cureus.16829",
      "paper_id": "f9528bbe80ec13365f81258cf4939027d14a43a9",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用PRISMA 2020指南进行系统综述。检索策略限定于2016-2021年发表的中英文全文，纳入标准包括成人患者、至少接受一种ICI治疗、关注微生物或抗生素对ICI的影响。排除儿童、动物实验、病例报告及无法获取全文的文章。由两名独立审稿人筛选文献、提取数据并进行质量评估（使用Newcastle-Ottawa量表评估队列研究，使用定性研究清单评估综述文章）。最终纳入16篇文章进行综合叙述性总结。",
        "contribution_and_limits": [
          {
            "contribution": "综合了2016-2021年间关于微生物/抗生素与ICI疗效关联的临床证据，明确了抗生素使用的负面预测价值及特定有益菌群的标志物潜力。",
            "limits": "仅纳入英语文章；未考虑饮食、运动、年龄等混杂因素；缺乏对益生菌等其他微生物调节手段的充分评估；多为观察性研究，因果机制未完全阐明。"
          }
        ],
        "key_findings": [
          {
            "conditions": "抗生素使用与ICI疗效的关系",
            "finding": "大多数研究表明抗生素使用与较差的ICI反应率、较短的PFS和OS相关。抗生素使用时间（如ICI开始前30天或开始后6周内）显著影响疗效。广谱抗生素比窄谱抗生素对疗效的负面影响更大。但有一项研究（Kaderbhai et al.）显示抗生素对nivolumab疗效无显著影响。"
          },
          {
            "conditions": "特定微生物群与ICI疗效的关系",
            "finding": "富含Firmicutes门（特别是Faecalibacterium）、Ruminococcaceae家族的菌群与更好的ICI反应、更长的PFS和OS相关，但也可能增加结肠炎风险。富含Bacteroides属的菌群与较差的反应相关。不同ICI药物（如anti-PD-1 vs anti-CTLA-4）对应的优势菌种存在差异。"
          },
          {
            "conditions": "微生物多样性与ICI疗效",
            "finding": "高微生物多样性的患者通常对ICI反应更好，而非响应者往往表现出Proteobacteria的增加和整体多样性的降低。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "明确肠道微生物组的组成以及抗生素的使用如何具体影响免疫检查点抑制剂在癌症治疗中的有效性，并探讨基于此提高免疫治疗疗效的措施。",
        "research_scope": "2016-2021年间发表的关于肠道微生物组和抗生素对实体瘤患者免疫检查点抑制剂（ICI）疗效影响的临床研究及综述文章。",
        "work_summary": "这是一篇系统综述，旨在分析肠道微生物组和抗生素如何影响癌症患者接受免疫检查点抑制剂（ICI）治疗的疗效。研究通过检索PubMed和Science Direct数据库，筛选出16篇符合条件的文章（包括回顾性和前瞻性队列研究），并对数据进行了提取和质量评估。研究发现，富含特定微生物的肠道菌群对ICI反应不同，而抗生素的使用通常会对ICI的疗效产生负面影响，且抗生素使用时机、种类及疗程均会影响预后指标如无进展生存期（PFS）和总生存期（OS）。"
      },
      "review_planning_B": {
        "planning_summary": "该综述提供了关于肠道微生物组特征（特定菌属丰度、多样性）和抗生素暴露史作为ICI疗效生物标志物的临床证据汇总。它详细列举了不同菌属（如Faecalibacterium, Bacteroides）与ICI反应及毒性的关联，以及抗生素使用时机和类型对预后的影响，可作为解释“微生物如何调节ICI疗效”这一核心问题的关键背景素材和实证支持。",
        "facet_contributions": [
          {
            "boundaries": "主要基于回顾性和前瞻性队列研究的关联性数据，部分研究样本量较小；不同癌种间结果可能存在异质性；抗生素影响的因果关系受限于观察性设计。",
            "contribution": "提供了具体的临床观察结果：富含Faecalibacterium和Firmicutes的患者对ICI反应更好，而富含Bacteroides的患者反应较差；抗生素使用（尤其是广谱和长期）与PFS和OS缩短相关。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物组如何调节ICI疗效”，提供微生物组成和抗生素暴露作为疗效调节因子的直接临床证据。"
          },
          {
            "boundaries": "这些机制描述主要引用自被综述的研究（如Gopalakrishnan et al., Frankel et al.），本综述本身未进行新的机制实验验证；机制细节在不同研究中表述不一，需结合原文进一步确认。",
            "contribution": "提出了潜在的机制解释：有益菌群通过增强抗原呈递和改善效应T细胞功能来增强抗肿瘤免疫；有害菌群或抗生素引起的菌群失调导致抗原呈递减弱和肿瘤内淋巴/髓系浸润不足。",
            "facet_id": "F2",
            "possible_uses": "用于辅助解释“介导该效应的机制”，提供从微生物组成到免疫细胞功能再到临床结局的逻辑链条假设。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供领域背景和概念框架",
            "material": "介绍了人类微生物组的基本构成及其与免疫系统、肠道屏障、代谢功能的相互作用，以及ICI的作用机制（靶向PD-1/PD-L1, CTLA-4）。",
            "purpose": "为综述提供基础生物学背景，帮助读者理解为何肠道微生物组可能与免疫治疗产生交互作用。"
          },
          {
            "connection_to_review": "提供不良反应管理的参考",
            "material": "指出特定微生物组成（如Bacteroides丰富）与较低的ICI诱导结肠炎发生率相关，而某些有益菌群富集则与较高的结肠炎风险相关。",
            "purpose": "在讨论ICI安全性或副作用管理时，可作为微生物组影响免疫相关不良事件（irAEs）的证据之一。"
          }
        ],
        "scope_interpretation_cautions": [
          "该综述包含多种实体瘤（肺癌、黑色素瘤、肾癌、肝癌等），不同癌种的微生物特征和ICI疗效关系可能存在差异，应用时需考虑癌种特异性。",
          "抗生素的影响具有时间依赖性（使用前、中、后）和类型依赖性（广谱vs窄谱），简单概括为“抗生素有害”可能忽略具体情境。",
          "所引用的机制研究（如抗原呈递、T细胞功能）多为小样本探索性研究，其普适性需谨慎对待。",
          "综述未涵盖益生菌、粪便微生物移植（FMT）等其他微生物干预措施的效果，因此不能据此推断所有微生物调节手段的有效性。"
        ],
        "topic_handles": [
          "gut microbiome composition (Firmicutes, Bacteroides, Faecalibacterium)",
          "antibiotic exposure timing and spectrum",
          "ICI response prediction biomarkers",
          "immune-related adverse events (colitis)",
          "solid tumours (NSCLC, melanoma, RCC, HCC)"
        ]
      },
