    "record::80b33fd7b89d6836b1f0d00c8597fd6d579fb8da4ac0b2d58de541e9da29b063": {
      "source_handle": "P0033",
      "title": "Longitudinal gut microbiome changes in immune checkpoint blockade-treated advanced melanoma",
      "year": "2024",
      "doi": "10.1038/s41591-024-02803-3",
      "paper_id": "0f25b980517704cd7fa782dd9e51d16b77d00249",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用多中心前瞻性队列设计，对175例晚期黑色素瘤患者进行全基因组鸟枪法宏基因组测序（MetaPhlAn4和HuMAnN3）。使用基于Pibble模型的贝叶斯高阶交互回归模型，控制混杂因素（如年龄、性别、BMI、抗生素使用、癌症中心等），模拟PFS ≥12个月与PFS <12个月患者在四个时间点（基线+3次随访）的微生物SGBs和通路的线性轨迹斜率。通过事后对比（post hoc contrasts）比较不同临床亚组（单药vs联合治疗、有无结肠炎、有无PPI使用）中的微生物动态。构建优势比（balance/log ratio）指标，并通过交叉验证和独立队列验证其预测能力。",
        "contribution_and_limits": [
          {
            "contribution": "提供了ICB治疗期间肠道微生物组纵向变化的详细图谱，揭示了基线后微生物动态对预后的独立预测价值，并指出了单一基线分析的局限性。",
            "limits": "所给摘要未交代具体的代谢功能验证实验（如代谢组学关联的具体机制链条）；样本量对于某些亚组分析（如特定药物组合下的结肠炎亚组）较小；将复杂的微生物动态简化为线性轨迹可能忽略非线性变化；独立验证队列样本量有限且异质性大，限制了泛化性的确证强度。"
          }
        ],
        "key_findings": [
          {
            "conditions": "比较PFS ≥12个月与PFS <12个月患者",
            "finding": "99个SGBs能区分两组，其中20个仅在基线有差异，42个仅在治疗后出现差异。5个SGBs（如Agathobaculum butyriciproducens, Intestinibacter bartlettii等）在PFS ≥12组中持续高丰度，主要涉及短链脂肪酸（SCFA）合成；4个SGBs（如Ruthenibacterium lactatiformans, Prevotella copri clade A等）在PFS <12组中持续高丰度。"
          },
          {
            "conditions": "基于持续差异SGBs构建的对数比率（Balance）",
            "finding": "该平衡指数在基线和早期治疗阶段能有效区分PFS组别（AUC约0.66-0.74），并与总生存期（OS）显著相关（HR > 1.6, P < 0.05）。在部分独立验证队列中显示出可比的预测能力。"
          },
          {
            "conditions": "不同临床情境：治疗方案",
            "finding": "单药与联合治疗共享部分微生物信号，但部分SGBs（如Coprococcus eutactus）在两种方案下对PFS的预测方向相反。单药治疗中，某些拟杆菌属（Bacteroides）在PFS <12组中增加，而在联合治疗中未观察到此现象。"
          },
          {
            "conditions": "不同临床情境：ICB诱导的结肠炎",
            "finding": "未发生结肠炎的患者中丁酸产生菌（如Roseburia, Faecalibacterium prausnitzii）丰度较高或下降较少。发生结肠炎的患者中，Akkermansia muciniphila基线高但随后急剧下降。基于结肠炎相关SGBs构建的平衡指数可预测结肠炎发生（AUC ~0.72）。"
          },
          {
            "conditions": "不同临床情境：PPI使用",
            "finding": "PPI使用者与非使用者在微生物动态上存在差异，例如Streptococcus thermophilus在非使用者（PFS ≥12）中增加，而在使用者中减少。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "既往基于基线的横断面研究在识别ICB疗效相关的微生物生物标志物时存在异质性和缺乏共识。本研究试图回答：在ICB治疗过程中，肠道微生物组如何随时间动态变化？这些纵向动态是否能比基线数据更准确地预测患者的无进展生存期（PFS）和总生存期（OS），以及这些动态是否受治疗方案和副作用等临床因素的调节？",
        "research_scope": "针对接受免疫检查点阻断（ICB）治疗的晚期黑色素瘤患者，进行纵向肠道微生物组分析。研究涉及来自英国、荷兰和西班牙五个队列的175名患者，样本采集覆盖治疗前基线及治疗后12周内的三个时间点。",
        "work_summary": "该研究旨在解决既往横断面研究中微生物标志物缺乏共识的问题，通过纵向追踪ICB治疗期间肠道微生物组的动态变化，区分长期无进展生存（PFS ≥12个月）与短期生存患者的微生物特征。研究利用贝叶斯回归模型分析物种水平基因组箱（SGBs）和代谢通路的丰度轨迹，并考察不同临床情境（如治疗方案、结肠炎发生、质子泵抑制剂使用）对微生物动态的影响。研究发现，除了基线差异外，许多微生物在治疗后的丰度变化模式具有预测价值，且同一微生物在不同临床背景下可能呈现相反的动态趋势。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了ICB治疗期间肠道微生物组纵向演变的实证数据，特别强调了‘治疗后动态’相对于‘基线静态’的预测价值。它为综述提供了关于微生物群落如何响应免疫治疗的时间维度证据，以及不同临床背景（药物类型、副作用、合并用药）如何重塑这种响应的具体案例。可用于支持‘微生物组动态监测优于单次基线检测’的观点，并为解释不同研究中微生物标志物不一致的现象提供情境化解释。",
        "facet_contributions": [
          {
            "boundaries": "仅限于晚期黑色素瘤人群；结果依赖于特定的SGB定义和贝叶斯模型假设；独立验证队列规模有限，需谨慎外推至其他肿瘤类型或更大人群。",
            "contribution": "提供了175例晚期黑色素瘤患者纵向队列中，与长期无进展生存（PFS ≥12个月）相关的特定微生物SGBs及其代谢通路（主要是SCFA合成）的动态变化证据。识别出5种持续高丰度的有益菌和4种持续高丰度的潜在耐药菌。",
            "facet_id": "F1",
            "possible_uses": "用于回答“哪些微生物特征与ICB疗效相关”的子问题，特别是强调治疗过程中的动态积累效应。可作为支持SCFA产生菌在ICB疗效中作用的实证素材。"
          },
          {
            "boundaries": "这是观察性关联，不能直接证明因果关系；亚组样本量较小，统计效力受限；结论主要基于统计学上的斜率差异，而非直接的生物学机制验证。",
            "contribution": "展示了同一微生物在不同临床情境（单药vs联合治疗、有无结肠炎、PPI使用）下表现出截然不同的丰度轨迹，甚至出现相反的方向性。",
            "facet_id": "F1",
            "possible_uses": "用于解释综述中可能存在的异质性来源，说明为何不同研究或不同患者群体中观察到的微生物标志物不同。提示在评估微生物疗效时需考虑临床协变量。"
          },
          {
            "boundaries": "文章主要基于宏基因组的功能潜力预测（MetaCyc pathways），而非实测代谢物浓度；机制解释多为推测性，需结合其他实验研究确认因果链条；所给材料未提供直接的免疫细胞浸润或功能验证数据。",
            "contribution": "提出了微生物动态与宿主免疫反应（通过irAEs如结肠炎体现）及代谢产物（SCFA, polyamines, menaquinol）之间的潜在联系。例如，发现丁酸产生菌与避免结肠炎相关，多胺合成途径与PFS ≥12相关。",
            "facet_id": "F2",
            "possible_uses": "为“机制介导”子问题提供间接线索，特别是微生物代谢产物（SCFA、多胺）可能作为中介因子影响免疫治疗和副作用的假说支持。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供方法学参考和概念框架",
            "material": "使用贝叶斯高阶交互模型处理纵向 compositional data，并构建微生物平衡（balance）指标进行生存分析。",
            "purpose": "在综述的方法学部分或讨论部分，引用此类高级统计方法来处理微生物组数据的复杂性和组成性偏差，作为当前领域内严谨数据分析的代表。"
