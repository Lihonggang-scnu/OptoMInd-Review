    "record::7430a2905f12e77c8007a96c52a2f5e12d1cecdc9c24bbefdc28df0f5caa88c2": {
      "source_handle": "P0402",
      "title": "THE IMPACT OF ANTIBIOTIC THERAPY ON THE EFFECTIVENESS OF IMMUNOTHERAPY: A REVIEW OF CURRENT EVIDENCE",
      "year": "2026",
      "doi": "10.31435/ijitss.1(49).2026.4882",
      "paper_id": "affb01ce6dd2c0ea0909edc814fd8af01596e021",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [
        "P0576"
      ],
      "study_summary_A": {
        "approach": "采用叙述性综述方法。通过PubMed/MEDLINE、Embase和Web of Science数据库进行聚焦式文献检索，关键词包括“antibiotics”、“immune checkpoint inhibitors”、“PD-1/PD-L1”、“CTLA-4”、“gut microbiome”和“cancer”。纳入标准包括相关的临床前研究、回顾性和前瞻性临床队列以及高质量综述。由于研究设计、肿瘤类型和抗生素暴露定义存在显著异质性，作者未采用正式的系统评价框架，而是对发现进行叙述性综合和分析。",
        "contribution_and_limits": [
          {
            "contribution": "系统性地综合了截至2026年的临床前和临床证据，确立了抗生素暴露（特别是ICI前短期暴露）与ICI疗效降低之间的一致性关联，强调了时间窗口的重要性。",
            "limits": "主要依赖回顾性观察性数据，无法确立因果关系；存在显著的异质性（暴露定义、肿瘤类型、混杂因素）；缺乏常规微生物组 profiling 数据以直接关联微生物变化与临床结果；可能存在发表偏倚。"
          }
        ],
        "key_findings": [
          {
            "conditions": "多肿瘤类型回顾性队列及荟萃分析",
            "finding": "抗生素暴露与较差的临床结果一致相关，包括无进展生存期（PFS）、总生存期（OS）和治疗反应率（RR/ORR）降低，以及疾病进展（PD）风险增加。"
          },
          {
            "conditions": "抗生素给药时间与ICI启动的关系",
            "finding": "负面关联在ICI启动前短期内（如30天内）给予抗生素时最为明显；而ICI启动后或治疗期间的抗生素使用对生存影响的证据较弱或不一致。"
          },
          {
            "conditions": "不同肿瘤类型",
            "finding": "在黑色素瘤、非小细胞肺癌（NSCLC）和肾细胞癌（RCC）中观察到一致的负面信号；但在肝细胞癌（HCC）中，由于肝硬化、感染风险和肠-肝轴功能障碍，情况更为复杂，混杂因素更多。"
          },
          {
            "conditions": "微生物组干预研究",
            "finding": "早期转化研究和早期干预试验表明，通过粪便微生物移植（FMT）等方式调节肠道微生物群可能部分恢复对ICI的反应性，提供概念验证证据。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管免疫检查点抑制剂改变了癌症治疗格局，但仅部分患者获得持久获益。鉴于肠道微生物群在调节抗肿瘤免疫中的关键作用，抗生素通过破坏微生物稳态可能负面影响免疫治疗的有效性。本研究旨在解决：抗生素暴露如何具体影响ICI疗效？其背后的生物学机制是什么？不同肿瘤类型和时间窗口下的效应是否一致？",
        "research_scope": "该综述聚焦于实体瘤患者接受免疫检查点抑制剂（ICIs）治疗期间，抗生素暴露对治疗疗效的影响。研究对象涵盖多种实体瘤类型（如黑色素瘤、非小细胞肺癌、肾细胞癌、肝细胞癌等），情境包括临床回顾性队列、前瞻性观察研究及荟萃分析，旨在综合评估抗生素使用与ICI疗效之间的关联及其潜在机制。",
        "work_summary": "本文是一篇叙述性综述，旨在综合当前关于抗生素暴露如何影响免疫检查点抑制剂（ICIs）疗效的临床前和临床证据。文章首先回顾了肠道微生物群在调节抗肿瘤免疫反应中的关键作用，随后系统梳理了多项回顾性临床研究、肿瘤特异性验证研究以及系统性综述和荟萃分析的结果。研究发现，抗生素暴露（尤其是ICI启动前的短期暴露）与较差的临床结局（如无进展生存期缩短、总生存期降低和治疗反应率下降）一致相关。文章还讨论了这种关联在不同肿瘤类型中的表现差异、时间依赖性特征，并指出目前证据主要基于观察性数据，存在混杂因素，但支持谨慎使用抗生素以优化免疫治疗效果的临床建议。"
      },
      "review_planning_B": {
        "planning_summary": "该综述为理解肠道微生物群介导的抗生素对ICI疗效的影响提供了全面的临床证据背景和机制解释。它特别适用于回答抗生素暴露的时间依赖性、不同实体瘤类型的敏感性差异，以及从观察性关联到潜在因果机制（微生物组失调）的逻辑链条。虽然不能提供直接的因果证明，但其综合的荟萃分析和叙述性证据是构建‘微生物群-免疫-药物’相互作用综述的关键背景素材。",
        "facet_contributions": [
          {
            "boundaries": "这些是观察性关联，受混杂因素（如感染严重程度、基线健康状况）影响，不能直接证明抗生素是导致疗效降低的唯一原因。",
            "contribution": "提供了抗生素暴露与ICI疗效负相关的大规模临床证据汇总，包括多个荟萃分析的数据（如Tsikala-Vafea 2021, Wu 2021, Crespin 2023等），证实了跨肿瘤类型的一致性信号。",
            "facet_id": "F1",
            "possible_uses": "用于支持综述中关于‘抗生素暴露普遍降低ICI疗效’的观察性证据部分，特别是量化效应大小和一致性。"
          },
          {
            "boundaries": "不同研究对‘短期’的定义不一（30天、60天等），且多为回顾性数据，精确的时间阈值尚不明确。",
            "contribution": "详细分析了抗生素暴露的时间依赖性，指出ICI启动前短期暴露（<30天）的负面影响最显著，而治疗期间暴露的影响较弱或不一致。",
            "facet_id": "F1",
            "possible_uses": "用于阐述‘时机’作为关键调节变量的重要性，指导未来研究中暴露定义的标准化。"
          },
          {
            "boundaries": "人类临床数据中缺乏直接的微生物组-临床结局关联证据，机制主要外推自动物模型和小规模转化研究。",
            "contribution": "阐述了潜在的生物学机制：抗生素导致有益菌丢失、微生物多样性降低和代谢改变，进而损害树突状细胞成熟、CD8+ T细胞 priming 和肿瘤内淋巴细胞浸润，最终削弱ICI疗效。引用了关键的临床前研究（Vétizou et al., Routy et al.）。",
            "facet_id": "F2",
            "possible_uses": "用于解释‘为什么’抗生素会影响ICI疗效，提供从微生物组失调到免疫抑制的机制路径。"
          },
          {
            "boundaries": "样本量小，探索性设计，尚未成为标准护理，不能代表所有患者的可逆性。",
            "contribution": "提到了粪菌移植（FMT）等微生物组干预措施在部分患者中恢复ICI敏感性的概念验证证据。",
            "facet_id": "F2",
            "possible_uses": "作为反向证据，支持微生物组在ICI疗效中的因果角色，并提示可能的干预策略。"
          },
          {
            "boundaries": "中性结果可能源于样本量不足、暴露定义差异或未充分调整的混杂因素。",
            "contribution": "指出了特定肿瘤类型（如HCC）中混杂因素的复杂性，以及某些研究（如Kaderbhai 2017）中的中性结果。",
            "facet_id": "F1",
            "possible_uses": "用于讨论效应的异质性和情境依赖性，避免过度概括抗生素的负面影响。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "可作为综述中关于‘临床意义’或‘未来方向’部分的背景信息，强调平衡感染风险与免疫治疗获益的现实挑战。",
            "material": "综述讨论了抗生素管理（antibiotic stewardship）在ICI治疗患者中的重要性，建议谨慎使用抗生素，特别是在ICI启动前，但不主张在有明确指征时 withhold antibiotics。",
            "purpose": "提供临床实践背景和建议"
          },
          {
