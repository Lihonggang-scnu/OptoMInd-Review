    "record::79c14d42539eae37ca42ccd39104efa8087b4f6d5658b688c65c57555f6d6a2b": {
      "source_handle": "P0204",
      "title": "Characterizations of multi-kingdom gut microbiota in immune checkpoint inhibitor-treated hepatocellular carcinoma",
      "year": "2024",
      "doi": "10.1136/jitc-2023-008686",
      "paper_id": "58ddfd822378599d43b877cd0905dfe067a4375f",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用前瞻性观察性研究设计。纳入2018年11月至2022年4月期间接受ICI治疗的80例晚期HCC患者。通过宏基因组测序分析细菌群落，通过ITS2测序分析真菌群落，并通过代谢组学分析代谢产物。将患者分为持久临床获益（DCB）和非持久临床获益（NDB）两组，比较两组间微生物多样性、物种组成及代谢物的差异。利用统计建模筛选预测ICI持续获益的细菌物种模型，并识别预测生存的预后生物标志物。",
        "contribution_and_limits": [
          {
            "contribution": "首次在多组学水平描述了ICI治疗HCC患者中肠道细菌、真菌及其代谢物的状态和特征。",
            "limits": "所给摘要未交代具体的统计校正方法、样本量计算依据、外部验证情况以及潜在的混杂因素控制细节。"
          },
          {
            "contribution": "提供了基于多界微生物群的ICI疗效预测和预后评估的生物标志物候选列表。",
            "limits": "预测模型的泛化能力仅限于当前80人的单中心或特定队列，缺乏独立验证集的支持；作者声称的“首次”描述需结合领域内其他类似研究进行核实，且单一队列的结果可能存在情境依赖性。"
          }
        ],
        "key_findings": [
          {
            "conditions": "DCB组 vs NDB组",
            "finding": "细菌和代谢物在DCB与NDB组之间差异显著，而真菌的差异较小。"
          },
          {
            "conditions": "治疗前基线状态",
            "finding": "DCB组的细菌和真菌整体多样性高于NDB组；这种多样性差异在治疗6-8周后开始发生变化。"
          },
          {
            "conditions": "预测模型构建",
            "finding": "建立了包含18个细菌物种的模型，用于预测免疫治疗是否带来持续获益，曲线下面积（AUC）为75.63%。"
          },
          {
            "conditions": "预后生物标志物筛选",
            "finding": "筛选出两种细菌（Actinomyces_sp_ICM47, Senegalimassilia_anaerobia）和一种代谢物（galanthaminone）作为ICI治疗HCC患者生存的预后生物标志物。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "尽管已有研究探讨肠道细菌与ICI反应的联系，但ICI治疗HCC队列中多界（细菌、真菌）微生物组的改变及其相互作用尚不完全清楚。本研究试图填补这一知识空白，探索多界微生物群作为ICI疗效预测和预后生物标志物的潜力。",
        "research_scope": "接受免疫检查点抑制剂（ICI）治疗的晚期肝细胞癌（HCC）患者队列，涉及肠道细菌、真菌及其代谢产物的多组学分析。",
        "work_summary": "该研究旨在阐明多界肠道微生物群在ICI治疗HCC中的特征及其与临床疗效的关系。研究前瞻性纳入了80名接受ICI治疗的晚期HCC患者，利用宏基因组学、ITS2测序和代谢组学数据，对患者的肠道细菌、真菌及代谢物进行了多组学表征。研究比较了具有持久临床获益（DCB）与非持久临床获益（NDB）患者在治疗前后的微生物多样性变化，并尝试建立基于微生物特征的预测模型。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于肠道多界微生物群（细菌+真菌+代谢物）如何关联ICI在实体瘤（HCC）中疗效的具体实证数据。其核心价值在于不仅关注细菌，还引入了真菌和代谢物视角，并区分了疗效预测（DCB/NDB）和生存预后两个维度。这有助于综述理解微生物组干预或监测的多维复杂性，特别是真菌和代谢物在其中的潜在角色，以及不同微生物类群对疗效影响的异质性。",
        "facet_contributions": [
          {
            "boundaries": "结果来自HCC特定人群，外推至其他实体瘤需谨慎；预测模型未经外部验证；仅展示了关联性，未直接证明因果机制。",
            "contribution": "提供了肠道细菌和代谢物多样性及组成与ICI疗效（DCB vs NDB）关联的具体证据，显示细菌/代谢物差异显著而真菌差异较小；同时提供了基于18种细菌的预测模型（AUC=75.63%）。",
            "facet_id": "F1",
            "possible_uses": "可用于支持“肠道微生物组调节ICI疗效”的观点，特别是强调细菌和代谢物的关键作用，以及真菌可能起次要或不同作用的角色。可作为具体案例说明微生物特征如何预测临床结局。"
