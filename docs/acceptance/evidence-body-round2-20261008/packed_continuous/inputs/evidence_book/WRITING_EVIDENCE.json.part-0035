    "record::c668512a6c9823161aab5afff7281d93ea1ad5fabff37eac14b9a165f4c616d7": {
      "source_handle": "P0134",
      "title": "Fluctuations in Gut Microbiome Composition During Immune Checkpoint Inhibitor Therapy",
      "year": "2023",
      "doi": "10.14740/wjon1587",
      "paper_id": "3bb355ee930e0893c48cf56a7164df771bf2d7f5",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "研究设计为前瞻性观察性试点研究。纳入标准：确诊为IIIA-IV期NSCLC并接受pembrolizumab（抗PD-1抗体）治疗的患者。数据采集：在治疗前获取基线粪便样本，在第一周期治疗后3周内获取第二次粪便样本。分析方法：使用QIIME v1.9.1进行16S rRNA序列分析，计算Alpha多样性（Observed, Chao1, Shannon, Simpson）和Beta多样性（Bray-Curtis dissimilarity + PERMANOVA）。使用DESeq2检测属水平上的差异丰度菌种。临床评估：基于iRECIST标准在第12周判定响应状态（CR/PR vs SD/PD）。统计比较：对比响应者与非响应者在治疗前后微生物组变化的差异。",
        "contribution_and_limits": [
          {
            "contribution": "提供了小规模前瞻性数据，表明NSCLC患者在接受抗PD-1治疗期间，肠道微生物组的动态变化（而非仅基线状态）与临床响应相关。发现响应者伴随更大的微生物组多样性波动，并鉴定了特定的菌属变化模式（如响应者中Clostridium sensu stricto 1增加，无响应者中Akkermansia减少）。",
            "limits": "样本量极小（N=5），仅为试点研究，不足以得出确切的因果结论或普适性规律。仅收集了一个时间点的治疗后样本，无法描绘完整的纵向轨迹。未包含所有患者（特别是无响应者）的外周血CX3CR1+ CD8+ T细胞数据，限制了微生物组与系统性免疫反应的相关性分析。化疗可能干扰微生物组，但其独立影响在本研究中未完全剥离。"
          }
        ],
        "key_findings": [
          {
            "conditions": "基线阶段，3名响应者与2名无响应者之间",
            "finding": "肠道微生物组的整体Alpha多样性（包括Observed, Chao1, Shannon, Simpson指数）无显著差异。"
          },
          {
            "conditions": "治疗期间，比较响应者与无响应者的微生物组变化幅度",
            "finding": "响应者表现出显著的治疗前后微生物组多样性变化（R2: 0.146, P = 0.0274），而无响应者变化较小。整体而言，治疗时间点对微生物组组成的解释力较弱（P = 0.26），个体效应较强。"
          },
          {
            "conditions": "响应者（Responders）治疗后的特定菌属变化",
            "finding": "Odoribacter, Gordonibacter, Candidatus Stoquefichus, Escheria-Shigella, 和 Collinsella 的丰度显著下降；Clostridium sensu stricto 1 的丰度显著增加。"
          },
          {
            "conditions": "无响应者（Non-responders）治疗后的特定菌属变化",
            "finding": "Prevotella, Porphyromonas, Streptococcus, 和 Escheria-Shigella 的丰度显著增加；Akkermansia 的丰度显著下降。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "主要问题：目前缺乏有效的非侵入性生物标志物来早期识别对PD-1/PD-L1阻断疗法有反应的NSCLC患者，且基线微生物组与疗效的关系尚不明确。具体动机：尽管已知抗生素使用影响ICI疗效，但治疗过程中肠道微生物组的组成变化及其与疗效的具体关系仍不清楚。",
        "research_scope": "研究对象为接受抗PD-1免疫治疗（单药或联合化疗）的III期至IV期非小细胞肺癌（NSCLC）患者。研究情境为Roswell Park Comprehensive Cancer Center的前瞻性队列，样本量为5名患者（3名响应者，2名无响应者）。范围聚焦于治疗前及早期治疗期间粪便样本中肠道微生物组的动态变化及其与临床疗效的关系。",
        "work_summary": "本研究旨在探索肠道微生物组在治疗过程中的动态变化是否能作为预测非小细胞肺癌患者对PD-1抑制剂反应的非侵入性生物标志物。鉴于基线微生物组特征和肿瘤组织PD-L1表达的预测价值有限，作者分析了5名患者的配对粪便样本，通过16S rRNA测序比较响应者与无响应者在治疗前后的微生物多样性及组成差异。研究发现，虽然基线α多样性在两组间无显著差异，但响应者在治疗期间的微生物多样性发生了显著改变，而无响应者则相对稳定或呈现不同的菌群演变模式。这表明治疗期间的微生物组波动可能与免疫治疗的疗效相关。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于“治疗期间肠道微生物组动态”而非仅“基线静态特征”的关键实证素材。它直接回应了综述中关于微生物组如何随治疗进程演变的子问题，特别是通过对比响应者与无响应者的不同演变轨迹（波动vs稳定/恶化），为理解微生物组作为动态监测生物标志物的潜力提供了具体证据。",
        "facet_contributions": [
          {
            "boundaries": "仅限NSCLC人群，样本量小（N=5），且混合了单药与联合化疗方案，结果的外推需谨慎。不能证明因果关系，仅为关联观察。",
            "contribution": "提供了具体的临床观察证据：在NSCLC患者中，治疗期间肠道微生物组的显著变化（波动）与抗PD-1治疗的响应正相关，而稳定的或特定菌属（如Akkermansia减少）的变化与无响应相关。",
            "facet_id": "F1",
            "possible_uses": "可用于综述中论证“微生物组动态变化”作为预测因子的有效性，支持将治疗期间的微生物组监测纳入疗效评估体系的观点。"
          },
          {
            "boundaries": "这是相关性发现，未提供直接的机制验证（如代谢产物分析或动物模型验证）。所给材料未交代这些菌属变化的具体分子机制。",
            "contribution": "提示了潜在的机制线索：响应者中Clostridium sensu stricto 1的增加和无响应者中Akkermansia的减少可能与免疫激活或抑制有关。同时指出Escheria-Shigella在无响应者中的增加与既往