    "record::2c10f66e656b13b1d08f07b21f5974af1eb5f51d99874e2c3d45338c713e4ade": {
      "source_handle": "P0569",
      "title": "1255 Longitudinal assessment of the gut microbiome and its association with treatment response in patients with non-small cell lung cancer receiving neoadjuvant immunotherapy",
      "year": "2024",
      "doi": "10.1136/jitc-2024-sitc2024.1255",
      "paper_id": "fbbf5b7b16fb493ff4f0b84691ccb2b202d25d41",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用观察性队列设计，纳入两项前瞻性临床试验（J1772和J1414）的患者。数据收集包括：1. 基线及治疗期间连续采集的粪便样本；2. 使用16S rRNA扩增子测序进行微生物组分析；3. 记录临床结局，特别是主要病理缓解（MPR，定义为切除肿瘤标本中存活肿瘤≤10%）。分析方法包括：比较基线Alpha多样性（Simpson倒数指数）在MPR与非MPR组间的差异；利用Bootstrap分析从治疗开始至180天计算个体样本中前10种共有细菌物种的“自相似性”得分并关联结局；使用DESeq进行功能分析以识别与微生物组变化相关的代谢通路。",
        "contribution_and_limits": [
          {
            "contribution": "提供了早期NSCLC新辅助ICI治疗背景下，肠道微生物组特征（低基线多样性、高纵向稳定性、SCFA相关通路富集）与良好病理缓解（MPR）之间关联的证据。",
            "limits": "所给摘要未交代具体的统计校正方法（如多重检验校正）、混杂因素控制情况、不同ICI方案（单药vs联合vs联合放疗/化疗）对结果的潜在影响分层分析，以及样本量较小（n=23）带来的统计效力限制。"
          }
        ],
        "key_findings": [
          {
            "conditions": "早期可切除NSCLC患者，新辅助ICI治疗，基于16S rRNA测序的基线Alpha多样性测量",
            "finding": "达到MPR的患者基线Alpha多样性显著低于未达到MPR的患者（11.1 vs 19.5, p=0.02）。"
          },
          {
            "conditions": "新辅助ICI治疗期间纵向监测，基于Bootstrap分析的微生物组“自相似性”得分",
            "finding": "达到MPR的患者在治疗180天时表现出更高的微生物组自相似性（稳定性），显著高于无MPR患者（96.1% vs 92.1%, p=0.001）。"
          },
          {
            "conditions": "基于DESeq的功能分析，比较MPR与非MPR组的代谢通路丰度",
            "finding": "与短链脂肪酸（SCFA）产生相关的代谢通路在MPR患者中更为丰富。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "在早期可切除NSCLC患者中，基线肠道微生物组特征或治疗期间的纵向微生物组变化是否与对新辅助免疫检查点抑制剂的治疗反应（以MPR为代理终点）相关？",
        "research_scope": "接受新辅助免疫检查点抑制剂（ICI）治疗的早期可切除非小细胞肺癌（NSCLC）患者；涉及两项前瞻性临床试验（J1772, J1414）的队列。",
        "work_summary": "该研究旨在探讨基线肠道微生物组（GM）特征及纵向变化与NSCLC患者新辅助ICI治疗反应之间的关系。既往研究多关注晚期NSCLC，而本研究的背景是早期阶段患者的关联尚不明确。研究团队收集了患者的粪便样本进行16S rRNA扩增子测序，分析基线微生物组特征以及治疗期间的纵向变化，并将其与主要病理缓解（MPR）这一临床结局指标相关联。通过Bootstrap分析计算“自相似性”得分以评估纵向稳定性，并使用DESeq进行功能分析以阐明相关的代谢通路。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于早期NSCLC新辅助免疫治疗中肠道微生物组与疗效关联的具体实证数据。其核心价值在于揭示了不同于晚期NSCLC某些研究的基线多样性模式（此处为低多样性与好预后相关），并引入了纵向稳定性（自相似性）作为预测指标，同时指出了SCFA代谢通路的可能机制角色。这些发现可用于综述中讨论不同疾病阶段（早期vs晚期）或治疗场景（新辅助vs晚期一线）下微生物组标志物的异质性，以及微生物组动态变化而非仅基线状态的重要性。",
        "facet_contributions": [
          {
            "boundaries": "仅限早期可切除NSCLC的新辅助治疗场景；样本量较小；主要关联而非因果证明；未区分具体ICI药物组合的影响。",
            "contribution": "提供了早期NSCLC新辅助ICI治疗中，特定微生物组特征（低基线Alpha多样性、高纵向稳定性、SCFA通路富集）与较好治疗反应（MPR）正相关的证据。",
            "facet_id": "F1",
            "possible_uses": "用于支持或细化综述中关于“哪些微生物组特征预示ICI疗效”的论述，特别是针对早期/新辅助场景，可与晚期NSCLC或其他瘤种的研究结果进行对比，展示情境依赖性。"
          },
          {
            "boundaries": "仅为相关性发现，未直接验证因果关系；功能分析基于16S测序推断，分辨率有限；未深入探讨SCFA如何具体调节抗肿瘤免疫反应。",
            "contribution": "提示短链脂肪酸（SCFA）产生相关的代谢通路可能与更好的治疗反应有关，为微生物组调节免疫治疗效应的潜在机制提供了线索。",
            "facet_id": "F2",
            "possible_uses": "用于综述中讨论微生物组介导ICI疗效的潜在生物学机制部分，特别是代谢产物（如SCFA）的作用。可作为机制假设的来源之一。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供早期NSCLC新辅助免疫治疗这一特定临床情境下的微生物组数据。",
            "material": "基线Alpha多样性、纵向自相似性得分、SCFA代谢通路丰度与MPR的关联。",
            "purpose": "作为背景或对比案例，说明在不同治疗阶段（新辅助vs晚期）或不同疾病进展状态下，微生物组与免疫治疗反应的关联可能存在的差异。有助于避免将晚期NSCLC的结论简单外推至所有NSCLC场景。"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究针对的是早期可切除NSCLC的新辅助治疗，其结论不能直接推广到晚期转移性NSCLC的一线治疗或其他实体瘤。",
          "基线Alpha多样性与预后的负相关（低多样性对应好预后）可能与部分晚期NSCLC研究中观察到的正相关（高多样性对应好预后）存在差异，需考虑疾病阶段、治疗强度及宿主状态的差异，不可简单视为矛盾，而应视为情境依赖的特征。",
          "样本量较小（n=23），统计效力有限，发现的关联需在更大队列中验证。",
          "纵向稳定性指标（自相似性）的计算方法独特，其普适性和与其他稳定性指标的相关性未知。"
        ],
        "topic_handles": [
          "non-small cell lung cancer (NSCLC)",
          "neoadjuvant immunotherapy",
          "immune checkpoint inhibitors (ICIs)",
          "gut microbiome alpha diversity",
          "longitudinal microbiome stability (self-similarity)",
          "short-chain fatty acid (SCFA) production pathways",
          "major pathologic response (MPR)"
        ]
      },
