    "record::8ad5be629a298899c0672c745ae23be53e74ec8800b6aec681d6df44d89bc598": {
      "source_handle": "P0577",
      "title": "Improved survival in advanced melanoma patients treated with fecal microbiota transplantation using healthy donor stool in combination with anti-PD1: final results of the MIMic phase 1 trial",
      "year": "2025",
      "doi": "10.1136/jitc-2025-012659",
      "paper_id": "20c143d5373eab0bfea2067cf66b0e260dfeb1ef",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "Single-arm, multicenter phase I clinical trial. Patients received bowel preparation, followed by oral administration of capsules containing stool from one of three healthy male donors. Anti-PD1 therapy (nivolumab or pembrolizumab) started at least 7 days post-FMT. Outcomes were assessed using RECIST 1.1 criteria. Survival analysis used Kaplan-Meier methods. Metagenomic sequencing was performed on stool samples to analyze taxonomic composition (MetaPhlAn) and functional gene families (HUMAnN). Post hoc subgroup analyses compared responders vs. non-responders and patients with vs. without FMT-specific toxicity (FT) based on microbial and functional profiles.",
        "contribution_and_limits": [
          {
            "contribution": "Provides long-term survival data (median OS 52.8 months) for a small cohort of advanced melanoma patients treated with oral FMT plus anti-PD1, demonstrating high safety and promising efficacy signals compared to historical controls.",
            "limits": "Small sample size (N=20), single-arm design without a control group, and lack of statistical power for definitive conclusions. Results are hypothesis-generating. Patient selection bias (excluded those appropriate for combination therapy)."
          },
          {
            "contribution": "Identifies potential biomarkers for response, linking FMT-specific mild toxicity and long-term survival to specific microbial taxa (e.g., SCFA producers) and functional metabolic pathways (glycan modification, SCFA biosynthesis).",
            "limits": "Associations are derived from post hoc analyses. Causality between specific microbes/enzymes and clinical benefit is not established. The 'donor effect' could not be clearly disentangled due to the small cohort and mixed donor usage."
          }
        ],
        "key_findings": [
          {
            "conditions": "Entire cohort (N=20), median follow-up 52.8 months",
            "finding": "Median PFS was 29.6 months; median OS was 52.8 months. ORR was 65% (4 complete responses). Safety profile showed no increase in severe immune-related adverse events (irAEs); only grade 3 toxicities occurred."
          },
          {
            "conditions": "Responders (R, N=13) vs. Non-responders (NR, N=7)",
            "finding": "R patients had significantly longer mPFS (52.8 vs. 5.2 months, p=0.0016) and longer mOS (52.8 vs. 17.6 months, p=0.0628). R patients sustained donor-derived microbial similarity over time."
          },
          {
            "conditions": "Patients with FMT-specific toxicity (FT, N=8) vs. Without FT (NFT, N=12)",
            "finding": "All 8 FT patients were responders. FT patients had significantly improved mPFS (52.8 vs. 15.9 months, p=0.0364) and trend towards improved mOS (53.9 vs. 24.6 months, p=0.0610). FT was associated with enrichment of SCFA-producing taxa and glycan-modifying enzymes."
          },
          {
            "conditions": "Long-term survivors (LTS) vs. Short-term survivors (STS)",
            "finding": "LTS were enriched for commensal bacteria (Alistipes, Faecalibacterium) and enzymes involved in amino acid/SCFA biosynthesis. STS were enriched for stress-associated oxidative metabolism pathways and Hungatella hathewayi."
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "To evaluate whether modifying the gut microbiome via oral FMT from healthy donors can improve the safety, response rate, and survival outcomes of anti-PD1 therapy in patients with advanced melanoma who are naive to advanced-stage treatment, potentially overcoming primary resistance to immune checkpoint inhibitors (ICIs).",
        "research_scope": "Advanced cutaneous melanoma patients (N=20), treatment-naïve for advanced disease, receiving oral fecal microbiota transplantation (FMT) from healthy donors followed by single-agent anti-PD1 therapy. Multicenter phase I trial conducted in Canada.",
        "work_summary": "This study reports the final survival outcomes of the MIMic phase I trial, evaluating the safety and efficacy of combining oral FMT with healthy donor stool and anti-PD1 immunotherapy as first-line treatment for advanced melanoma. The trial enrolled 20 patients who received a single dose of FMT followed by nivolumab or pembrolizumab. The primary endpoint was safety, while secondary endpoints included objective response rate (ORR), progression-free survival (PFS), and overall survival (OS). The study found that the combination was safe, with an ORR of 65%. Median PFS was 29.6 months and median OS was 52.8 months, figures reported as higher than historical randomized controlled trials (RCTs) and real-world data. Post hoc analyses linked clinical responses to specific microbial engraftment patterns and functional metabolic pathways, suggesting that successful microbiome modulation may enhance ICI efficacy."
      },
      "review_planning_B": {
        "planning_summary": "This paper provides empirical evidence from a Phase I trial that oral FMT from healthy donors combined with anti-PD1 is safe and associated with improved survival in advanced melanoma. It offers specific mechanistic hypotheses linking clinical response to microbial engraftment success, characterized by the enrichment of short-chain fatty acid (SCFA)-producing bacteria and specific metabolic pathways. The study highlights FMT-specific toxicity as a potential marker of successful microbial integration and immune priming.",
        "facet_contributions": [
          {
            "boundaries": "Results are from a single-arm, small-sample Phase I trial. Cannot establish causal superiority over standard care due to lack of concurrent control arm. Patient population was restricted to those unsuitable for combination immunotherapy.",
            "contribution": "Reports clinical efficacy outcomes (ORR 65%, mPFS 29.6 mo, mOS 52.8 mo) for FMT+anti-PD1 in advanced melanoma, showing improvements over historical RCT benchmarks for anti-PD1 alone.",
            "facet_id": "F1",
            "possible_uses": "Can be used to illustrate the potential magnitude of benefit from microbiome manipulation in solid tumors, specifically melanoma. Provides baseline survival metrics for comparison with other microbiome interventions."
          },
          {
            "boundaries": "Mechanisms are inferred from correlative post hoc analyses. The role of FMT-specific toxicity as a proxy for engraftment success is observational. Functional profiling relies on metagenomic prediction, which may not reflect actual protein activity or host interaction.",
            "contribution": "Links clinical response to specific microbial features: Responders and long-term survivors show enrichment of SCFA-producing taxa (Blautia, Roseburia, Faecalibacterium) and enzymes for glycan modification/amino acid biosynthesis. Non-responders/short-term survivors show enrichment of oxidative/stress pathways and Hungatella hathewayi.",
            "facet_id": "F2",
            "possible_uses": "Provides mechanistic insights into how microbiome composition might mediate ICI efficacy. Suggests that successful engraftment of metabolically fit, SCFA-producing communities enhances immune response. Identifies functional metabolic signatures (vs. just taxonomy) associated with outcome."
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "Helps categorize different microbiome intervention modalities in the review.",
            "material": "Comparison of oral capsule-based FMT (this study) vs. invasive colonoscopic FMT (referenced in intro). This study supports the feasibility and safety of oral delivery for systemic immune modulation.",
            "purpose": "Contextual background on FMT delivery methods"
          },
          {
            "connection_to_review": "Addresses the safety facet of microbiome interventions, countering concerns about increased autoimmune toxicity when combining FMT with ICIs.",
            "material": "No increase in severe irAEs; FMT-specific toxicities were mild (Grade 1-2 GI).",
            "purpose": "Safety profile of microbiome manipulation"
          },
          {
            "connection_to_review": "Useful for discussing the quality of evidence in the field and the need for larger, randomized Phase II/III trials (like the mentioned ME.17 trial).",
            "material": "Acknowledges small sample size, lack of control arm, and hypothesis-generating nature of results.",
            "purpose": "Limitations of current evidence"
          }
        ],
        "scope_interpretation_cautions": [
          "The study population is limited to advanced cutaneous melanoma patients ineligible for combination immunotherapy; results may not generalize to other solid tumors or earlier-stage disease.",
          "Survival comparisons with historical RCTs are noted by authors but are confounded by patient selection biases and temporal changes in care; do not treat as definitive proof of superiority.",
          "Microbial associations are correlational; causality between specific taxa/pathways and ICI response is not proven within this study design."
        ],
        "topic_handles": [
          "oral fecal microbiota transplantation (FMT) in solid tumors",
