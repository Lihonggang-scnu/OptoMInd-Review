    "record::1bb80f168552ffb9a6448494df1485fd1e32c886ba6c242a17b324b2dd9e89a7": {
      "source_handle": "P0545",
      "title": "A Clinical Outcome of the Anti-PD-1 Therapy of Melanoma in Polish Patients Is Mediated by Population-Specific Gut Microbiome Composition",
      "year": "2022",
      "doi": "10.3390/cancers14215369",
      "paper_id": "f31246cd559d1a06b99a32b0ee47bb1ce0265772",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用前瞻性队列研究设计。纳入标准：组织学确诊的不可切除III期或IV期皮肤黑色素瘤患者，接受抗PD-1单药治疗（纳武利尤单抗或帕博利珠单抗）。对照组为患者的直系亲属（健康人）。主要终点：根据RECIST v.1.1标准评估的治疗反应（完全缓解CR、部分缓解PR定义为响应者；疾病稳定SD、进展PD定义为非响应者）。数据采集：治疗前通过问卷收集社会人口学、临床、生活方式和饮食变量；采集基线粪便样本。实验室分析：使用DNeasy PowerSoil Pro提取DNA，扩增16S rRNA基因V3-V4区进行Illumina MiSeq测序，使用DADA2流程生成ASVs并基于SILVA数据库进行分类；对部分样本进行宏基因组鸟枪法测序以重建MAGs。统计分析：比较各组间的菌群多样性（Alpha/Beta）、相对丰度及临床特征差异，使用Kruskal-Wallis检验、Fisher精确检验及limma线性模型识别差异物种。",
        "contribution_and_limits": [
          {
            "contribution": "提供了波兰这一特定欧洲人群背景下，肠道微生物组特征与抗PD-1治疗反应的关联证据，指出了与该人群饮食模式（如高植物摄入）相关的潜在有益菌属（P. copri, B. uniformis）。",
            "limits": "样本量较小（尤其是对照组仅10人，且年龄显著小于患者组）；观察性研究设计无法确立因果关系；饮食数据依赖自我报告问卷，可能存在回忆偏倚；未直接测量微生物代谢产物机制；不同研究间关于特定菌属（如Faecalibacterium）作用的矛盾结果提示人群异质性，限制了单一生物标志物的普适性。"
          }
        ],
        "key_findings": [
          {
            "conditions": "波兰黑色素瘤患者队列，基线状态",
            "finding": "响应者（n=25）的拟杆菌门/厚壁菌门比值显著高于非响应者（n=32），且响应者的细菌物种丰富度（Richness）显著低于非响应者。"
          },
          {
            "conditions": "波兰黑色素瘤患者队列，基线状态",
            "finding": "响应者肠道中普雷沃氏菌（Prevotella copri）和均匀拟杆菌（Bacteroides uniformis）的丰度显著升高；非响应者中普拉梭菌（Faecalibacterium prausnitzii）、肠脱硫弧菌（Desulfovibrio intestinalis）及部分未分类厚壁菌显著富集。"
          },
          {
            "conditions": "波兰黑色素瘤患者队列，基线饮食调查",
            "finding": "高植物性食物（水果和蔬菜总和）摄入与响应概率增加2.9倍相关；低乳制品摄入（每日≤1份）与响应概率增加2.0倍相关。"
          },
          {
            "conditions": "波兰黑色素瘤患者队列，基线状态",
            "finding": "响应者的粪便钙卫蛋白水平（炎症标志物）中位数低于非响应者，但组间差异无统计学意义。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "在波兰人群中，基线肠道微生物组的组成以及饮食等外在因素是否与黑色素瘤患者对抗PD-1治疗的临床反应（响应 vs. 非响应）相关？是否存在人群特异性的微生物标志物？",
        "research_scope": "波兰人群中的转移性黑色素瘤患者（接受抗PD-1治疗）及健康对照，聚焦基线肠道微生物组组成、饮食模式与免疫检查点抑制剂（ICI）疗效的关联。",
        "work_summary": "本研究旨在探讨波兰裔黑色素瘤患者对抗PD-1治疗的反应与其基线肠道微生物组及外在修饰因素（如饮食）之间的关联。研究招募了64名接受抗PD-1治疗的患者和10名健康对照，通过问卷调查收集人口统计学、生活方式和饮食数据，并在治疗前采集粪便样本进行16S rRNA基因测序（metataxonomics）及部分宏基因组鸟枪法测序。结果显示，响应者（R）与非响应者（NR）在肠道菌群结构上存在显著差异：响应者的拟杆菌门/厚壁菌门（Bacteroidota/Firmicutes）比值较高，物种丰富度较低；响应者肠道中普雷沃氏菌（Prevotella copri）和均匀拟杆菌（Bacteroides uniformis）丰度较高，而非响应者则富集普拉梭菌（Faecalibacterium prausnitzii）、肠脱硫弧菌（Desulfovibrio intestinalis）及部分未分类厚壁菌。此外，高植物摄入和低乳制品摄入与更好的治疗反应相关。该研究强调了肠道微生物组和饮食对ICI疗效的影响具有人群特异性。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于肠道微生物组影响免疫检查点抑制剂（ICI）疗效的人群特异性证据。其核心价值在于揭示了在波兰人群中，特定的微生物组合（P. copri, B. uniformis）和饮食模式（高植物、低乳制品）与治疗响应正相关，这与部分其他队列（如Chaput et al.发现Faecalibacterium有益）的结果形成对比，有助于综述讨论“微生物标志物的人群依赖性”和“饮食-微生物-免疫”交互作用。",
        "facet_contributions": [
          {
            "boundaries": "仅限波兰人群，不能直接外推至其他种族或地理区域；观察性关联，非因果证明。",
            "contribution": "提供了波兰人群中与抗PD-1治疗响应正相关的特定微生物类群（P. copri, B. uniformis）和负相关类群（F. prausnitzii, D. intestinalis）的具体数据。",
            "facet_id": "F1",
            "possible_uses": "用于支持综述中关于“不同人群中存在不同的微生物预测标志物”的论点，或作为特定菌属在治疗响应中作用的实例。"
          },
          {
            "boundaries": "基于自我报告问卷，缺乏对具体营养成分或代谢产物的直接测量；混杂因素（如整体生活方式）未完全控制。",
            "contribution": "提供了饮食模式（高植物摄入、低乳制品摄入）与ICI治疗响应相关的流行病学证据。",
            "facet_id": "F1",
            "possible_uses": "用于综述中讨论饮食干预或自然饮食状态如何可能通过调节微生物组来影响免疫治疗效果的背景信息。"
          },
          {
            "boundaries": "钙卫蛋白差异无统计学意义；未直接测定免疫细胞浸润或细胞因子水平；机制链条不完整。",
            "contribution": "探讨了肠道菌群组成与宿主肠道炎症状态（通过粪便钙卫蛋白衡量）的潜在联系，尽管统计上不显著，但趋势显示响应者炎症水平较低。",
            "facet_id": "F2",
            "possible_uses": "用于讨论肠道局部免疫环境（如炎症水平）可能与全身抗肿瘤免疫反应相关的假设，作为机制探讨的背景素材。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供关于肠道微生物组与ICI疗效关联中“人群特异性”的重要案例。",
            "material": "作者指出与其他队列（如中国NSCLC患者中P. copri有益，或某些黑色素瘤队列中Faecalibacterium有益）结果的矛盾，强调单一物种不能作为跨人群的通用生物标志物。",
            "purpose": "用于综述中论证微生物标志物开发的复杂性，支持需要结合人群背景、饮食和生活习惯进行个性化分析的结论。"
