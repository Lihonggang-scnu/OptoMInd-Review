    "record::84e209b9eec7124e6f168abb4b10fea9132aaedfb8cf5a5c166fdf5e71d064f7": {
      "source_handle": "P0298",
      "title": "Gut microbial signatures and immunotherapy outcomes in NSCLC and melanoma: a systematic review and meta-analysis",
      "year": "2026",
      "doi": "10.1186/s12885-026-15763-3",
      "paper_id": "82318ae05cff1667b2348961675db67dee4d8360",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统综述和荟萃分析方法。文献检索涵盖PubMed, Embase, Web of Science, Scopus。纳入标准为成人NSCLC或黑色素瘤患者，接受ICI治疗，有基线肠道微生物组数据（16S rRNA或宏基因组测序），并报告OS, PFS, ORR或irAEs。数据提取后，对α多样性、特定菌属丰度、抗生素使用等暴露因素进行荟萃分析，使用DerSimonian and Laird随机效应模型合并HR和OR。进行亚组分析（癌症类型、测序方法）。使用NOS评估研究质量，使用GRADE评估证据确定性。",
        "contribution_and_limits": [
          {
            "contribution": "提供了关于肠道微生物组特征（多样性、特定菌属）与NSCLC和黑色素瘤患者ICI疗效及安全性之间关联的综合定量证据。确认了高多样性、Akkermansia、Faecalibacterium的有益关联以及抗生素使用的有害关联。区分了不同ICI类型（抗CTLA-4 vs. 抗PD-1）在irAEs方面的不同微生物关联。",
            "limits": "纳入的研究均为观察性研究，无法确立因果关系。证据确定性被评定为“中等”，主要因研究设计的观察性质和部分结果的不一致性。由于原始数据不可用，无法进行个体参与者数据（IPD）分析，限制了更精细的混杂因素调整。术语上只能界定为“预后”关联，难以严格区分“预测”价值。对于抗PD-1/PD-L1治疗相关的irAEs，因数据异质性过大，未能进行荟萃分析。"
          }
        ],
        "key_findings": [
          {
            "conditions": "基线高肠道微生物α多样性 vs. 低多样性",
            "finding": "显著改善OS (pooled HR 0.52, 95% CI 0.41–0.66) 和 PFS (pooled HR 0.58, 95% CI 0.47–0.71)。在NSCLC和黑色素瘤亚组中均稳健，且不受测序方法（16S vs. 宏基因组）影响。"
          },
          {
            "conditions": "基线存在 Akkermansia",
            "finding": "显著增加客观缓解率 (ORR) (pooled OR 2.15, 95% CI 1.38–3.35)。"
          },
          {
            "conditions": "基线高丰度 Faecalibacterium",
            "finding": "显著改善无进展生存期 (PFS) (pooled HR 0.68, 95% CI 0.54–0.85)。"
          },
          {
            "conditions": "ICI治疗前1-2个月内使用抗生素",
            "finding": "显著恶化总生存期 (OS) (pooled HR 1.72, 95% CI 1.34–2.21)。"
          },
          {
            "conditions": "黑色素瘤患者接受抗CTLA-4治疗，基线高丰度 Bacteroidetes",
            "finding": "显著降低严重（≥3级）结肠炎风险 (pooled OR 0.34, 95% CI 0.18–0.64)。"
          },
          {
            "conditions": "黑色素瘤患者接受抗CTLA-4治疗，基线高丰度 Bacteroides intestinalis",
            "finding": "一项研究提示与严重毒性风险增加相关（未纳入荟萃分析）。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管已有证据表明肠道微生物组影响ICI疗效，但现有证据碎片化且存在不一致。本研究旨在定量综合基线肠道微生物组特征（多样性和特定菌属）与NSCLC和黑色素瘤患者ICI临床结局（生存、响应、不良反应）之间的关联，并评估证据质量，以明确其作为预后生物标志物的潜力。",
        "research_scope": "非小细胞肺癌（NSCLC）和黑色素瘤患者；接受免疫检查点抑制剂（ICIs，包括抗PD-1/PD-L1或抗CTLA-4治疗）；基线肠道微生物组特征与临床结局（OS, PFS, ORR, irAEs）的关联。",
        "work_summary": "本研究是一项系统综述和荟萃分析，旨在综合评估基线肠道微生物组特征与非小细胞肺癌和黑色素瘤患者免疫检查点抑制剂（ICI）疗效及安全性之间的预后关联。研究遵循PRISMA指南，检索了截至2025年4月的多项数据库，纳入26项涉及1,542名患者的观察性研究。通过随机效应模型汇总了风险比（HR）和比值比（OR），并使用GRADE框架评估证据质量。结果显示，高肠道微生物α多样性与改善的总生存期和无进展生存期显著相关；特定菌属（如Akkermansia、Faecalibacterium）的存在与更好的客观缓解率或无进展生存期相关；近期抗生素使用与较差的生存结果相关；而在接受抗CTLA-4治疗的黑色素瘤患者中，拟杆菌门的高丰度与严重结肠炎风险降低相关。整体证据确定性为中等。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述F1（微生物组如何调节ICI疗效）提供了关键的定量综合证据，证实了肠道微生物组特征（多样性、特定菌属）与NSCLC和黑色素瘤患者ICI临床结局（生存、响应）的显著预后关联，并指出了抗生素使用的负面影响。同时，它为F2（机制）提供了部分支持性背景，讨论了特定菌属（如Akkermansia, Faecalibacterium）可能的免疫调节功能（T细胞招募、短链脂肪酸产生），但主要贡献在于表型关联而非机制验证。",
        "facet_contributions": [
          {
            "boundaries": "仅证明预后关联，不证明因果调节。证据等级为中等。主要针对NSCLC和黑色素瘤，外推至其他实体瘤需谨慎。对于irAEs，仅针对抗CTLA-4诱导的结肠炎有定量证据，其他irAEs证据不足。",
            "contribution": "提供了肠道微生物组特征（高α多样性、Akkermansia存在、Faecalibacterium高丰度）与ICI疗效（OS, PFS, ORR）改善之间的定量关联证据（HR/OR值）。提供了抗生素使用与疗效下降关联的证据。提供了特定微生物特征（Bacteroidetes高丰度）与特定irAEs（抗CTLA-4诱导的结肠炎）风险降低的关联证据。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物组如何调节ICI疗效”中的“关联性”部分。可作为支持“某些微生物特征与更好疗效相关”这一观点的核心证据。可用于对比不同癌症类型（NSCLC vs. 黑色素瘤）或不同ICI药物（抗CTLA-4 vs. 抗PD-1）下微生物组影响的异同。"
          },
          {
            "boundaries": "这些是作者基于现有文献提出的机制假说，并非本荟萃分析直接验证的机制。本综述本身不提供新的机制实验数据。机制解释具有推测性，需结合其他基础研究论文进行验证。",
            "contribution": "在讨论部分提出了可能的机制解释：Akkermansia可能通过增强肿瘤微环境中CD4+和CD8+ T细胞的招募和激活来增强PD-1阻断疗效；Faecalibacterium作为丁酸盐的主要生产者，可能通过支持肠道屏障完整性和抗炎特性发挥作用；抗生素的有害影响可能与耗竭这些有益细菌有关。还提到了功能趋同的概念（如短链脂肪酸、次级胆汁酸代谢）。",
            "facet_id": "F2",
            "possible_uses": "用于回答“哪些机制介导了这种效应”时，提供作者提出的假设性机制和文献支持的潜在通路。可用于引出“从分类学向功能分析转变”的讨论。"
          }
        ],
        "broader_review_uses": [
