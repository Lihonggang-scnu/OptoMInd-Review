    "record::09453c46fe36046e2b9f48ff6256228cf0dc85f082eb8d8faf50756318235919": {
      "source_handle": "P0364",
      "title": "Functional convergence amid taxonomic variability in gut microbiome–immune checkpoint inhibitor research: a bibliometric and mechanistic synthesis",
      "year": "2026",
      "doi": "10.3389/fimmu.2026.1883259",
      "paper_id": "9dd62eb058feb9dbd44c28e9c8d004181dd8d19d",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用混合方法：首先进行文献计量学映射，包括关键词共现网络、引用共现分析、主题演化分析和战略主题图，以描绘科学产出、智力结构和主题演变；其次，检索ClinicalTrials.gov评估干预性临床试验的活动；最后，进行定性的跨队列功能综合，选取具有明确响应者/非响应者定义的代表性临床研究（Level 4）和临床前研究（Level 2），比较其微生物特征、代谢通路和免疫机制，构建概念框架。",
        "contribution_and_limits": [
          {
            "contribution": "提供了将文献计量学结构与跨队列功能解释相结合的综合视角，解释了分类学不一致背后的功能趋同可能性，并为基于功能的生物标志物开发提供了理论依据。",
            "limits": "所给摘要未交代具体的统计检验细节；定性综合依赖于单作者筛选，可能存在选择偏差；未能提供合并效应量；依赖单一数据库（WoSCC）和英语文献，可能存在语言和数据库偏差；因果推断仍受限于观察性研究和混杂因素。"
          }
        ],
        "key_findings": [
          {
            "conditions": "2013-2025年文献计量学与临床试验数据",
            "finding": "研究产出呈指数增长，2018年标志性人类队列研究后出现转化激增，临床试验启动在2021年达到峰值。主题从早期的机制探索和特定药物关注转向以FMT、微生物代谢物和多组学为核心的临床干预导向。"
          },
          {
            "conditions": "跨队列代表性临床及临床前研究（n=8）",
            "finding": "响应者相关的微生物群表现出支持代谢和免疫有利的特征，如短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏；而非响应者则显示失调和免疫抑制特征。尽管具体菌种不同，但免疫通路呈现功能趋同。"
          },
          {
            "conditions": "概念框架综合",
            "finding": "提出了一个统一框架，将宿主因素、微生物组成、代谢物信号和免疫反应联系起来，表明微生物-ICI相互作用由功能趋同通路驱动，而非单一菌种。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "针对微生物群-ICI研究中分类学发现缺乏可重复性且结果不一致的问题，探讨这种不一致是否源于底层的功能趋同机制，并梳理该领域的研究演变、转化趋势及当前面临的挑战。",
        "research_scope": "肠道微生物群与免疫检查点抑制剂（ICIs）在实体瘤治疗中的相互作用研究，时间跨度为2013年至2025年。",
        "work_summary": "该综述旨在解决肠道微生物群与ICI疗效关联研究中存在的分类学不一致性问题。作者通过整合Web of Science核心合集的文献计量学分析（2,195篇文献）和ClinicalTrials.gov的临床试验数据，结合对代表性临床及临床前研究的定性跨队列功能综合，探讨了微生物-ICI相互作用是否在共享免疫通路层面存在功能趋同。研究发现，尽管不同队列中响应相关的细菌物种差异显著，但功能上均指向短链脂肪酸产生、树突状细胞激活和CD8+ T细胞致敏等免疫调节通路。文章提出，分类学的变异可能反映了功能冗余而非生物学矛盾，并建议向基于功能的生物标志物和干预策略转变。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于微生物群-ICI领域从分类学描述向功能机制和临床干预转型的关键背景证据。它特别适用于解释为何不同研究中微生物标志物不一致，并提出“功能趋同”作为整合这些不一致发现的理论框架。此外，它提供了该领域临床试验活动的时间线数据和主要干预策略（如FMT）的现状，有助于评估该领域的成熟度和转化瓶颈。",
        "facet_contributions": [
          {
            "boundaries": "仅基于定性综合，未提供定量效应估计；主要涵盖黑色素瘤、NSCLC等实体瘤，但未详细区分所有亚型的具体差异。",
            "contribution": "提供了微生物群影响ICI疗效的临床证据图谱，指出响应者相关菌群虽物种各异，但均富集于免疫调节共生菌。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物群如何调节实体瘤中ICI的疗效”，特别是解释不同研究中微生物标志物不一致的现象，支持微生物群作为疗效调节因子的观点。"
          },
          {
            "boundaries": "机制解释主要基于文献回顾和概念框架，部分机制（如inosine的作用）主要来自临床前模型，其在人体中的确切贡献尚需更多验证；因果关系受限于观察性研究的混杂因素。",
            "contribution": "详细阐述了微生物-ICI相互作用的潜在机制，包括短链脂肪酸产生、树突状细胞成熟、Th1极化和CD8+ T细胞激活等通路。",
            "facet_id": "F2",
            "possible_uses": "用于回答“哪些机制介导了这种效应”，提供具体的分子和细胞机制路径，支持微生物代谢物和免疫细胞互作在ICI疗效中的核心作用。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "提供领域发展脉络和转化现状的背景信息。",
            "material": "文献计量学显示的主题演变（从机制到干预）、临床试验活动的时间线（2018-2021激增）、主要干预策略（FMT为主，益生菌为辅）。",
            "purpose": "用于综述的背景部分，展示该领域从基础关联研究向临床转化研究的快速过渡，以及当前面临的标准化和监管挑战。"
          },
          {
            "connection_to_review": "提供关于因果推断局限性和混杂因素的讨论素材。",
            "material": "文章讨论了抗生素、PPI、皮质类固醇、饮食、肿瘤类型等混杂因素对微生物群和ICI疗效的影响，以及反向因果的可能性。",
            "purpose": "用于综述的方法学或讨论部分，强调在解读微生物群-ICI关联时需要考虑的复杂背景和因果推断的挑战。"
          }
        ],
        "scope_interpretation_cautions": [
          "该论文的“功能趋同”结论是基于定性综合提出的假设生成性模型，并非经过严格统计验证的普适规律，需谨慎引用。",
          "引用的机制证据多来自临床前模型或早期临床队列，其在广泛人群中的适用性和因果效力尚未完全确立。",
          "文献计量学反映的是学术关注度，不完全等同于临床疗效或生物学真实性。"
        ],
        "topic_handles": [
          "gut microbiome",
