    "record::b9a2d82cfd023eb143b5db0a395843bf28bf931639c4e4db58eaa85e0beb7a06": {
      "source_handle": "P0360",
      "title": "Adverse Effect of the Duration of Antibiotic Use Prior to Immune Checkpoint Inhibitors on the Overall Survival of Patients with Recurrent Gynecologic Malignancies",
      "year": "2023",
      "doi": "10.3390/cancers15245745",
      "paper_id": "9cfb62b17064ed5abe1c447f8fa2f46e716b6c0d",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "Retrospective observational study design. Data were collected from electronic medical records of 215 patients treated with single-agent anti-PD-1 therapy. Patients were stratified based on antibiotic use within 60 days prior to ICI initiation. Univariate and multivariate Cox proportional hazards models were used to assess associations between baseline characteristics (including antibiotic duration, BMI, ECOG status, chemotherapy-free interval, MMR/MSI status, PD-L1 expression) and Overall Survival. Disease Control Rate was assessed using iRECIST criteria at 8–10 weeks.",
        "contribution_and_limits": [
          {
            "contribution": "Provides clinical evidence linking prolonged antibiotic use (>14 days) prior to ICI therapy with reduced Overall Survival in recurrent gynecologic cancers, suggesting it as a potential negative prognostic marker.",
            "limits": "The cutoff of 14 days is arbitrary and may be confounded by infection severity. The study lacks direct gut microbiome data (stool sampling was not performed). Small sample size limits subgroup analyses by cancer type (e.g., insufficient endometrial cancer cases). Retrospective design introduces heterogeneity in biomarker testing (PD-L1, MSI/MMR status incomplete for many patients)."
          }
        ],
        "key_findings": [
          {
            "conditions": "Multivariate analysis of 215 patients with recurrent gynecologic cancers.",
            "finding": "Prior antibiotic use for a cumulative duration of ≥14 days was independently associated with worse Overall Survival (HR 2.286, 95% CI 1.210–4.318; p = 0.011)."
          },
          {
            "conditions": "Comparison of Disease Control Rate (DCR) at 8–10 weeks between groups.",
            "finding": "No significant difference in DCR was observed between patients who received antibiotics (23.4%) and those who did not (33.3%, p = 0.130), nor was DCR significantly affected by antibiotic duration (<14 vs ≥14 days)."
          },
          {
            "conditions": "Univariate analysis of prognostic factors.",
            "finding": "Poor ECOG performance status (≥2), chemotherapy-free interval <6 months, and dMMR/MSI-H status were significantly associated with OS in univariate analysis, but only ECOG and chemotherapy-free interval remained significant in multivariate analysis alongside long-term antibiotic use."
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "To evaluate whether prior antibiotic use affects the efficacy of ICIs (measured by DCR and OS) in patients with recurrent gynecologic malignancies, and to identify independent prognostic factors for survival in this population.",
        "research_scope": "Recurrent gynecologic malignancies (ovarian, cervical, endometrial) treated with anti-PD-1 monotherapy (pembrolizumab or nivolumab) at two academic centers in Korea.",
        "work_summary": "This retrospective cohort study evaluated the association between prior antibiotic use and oncological outcomes in patients with recurrent gynecologic cancers receiving immune checkpoint inhibitors (ICIs). The study analyzed clinical data from 215 patients to determine if antibiotic exposure within 60 days before ICI initiation affected disease control rate (DCR) and overall survival (OS). It identified a cumulative antibiotic duration of >14 days as an independent predictor of poor OS, while noting that DCR was not significantly altered by antibiotic use. The authors attribute these findings to potential gut microbiota dysbiosis induced by prolonged antibiotic therapy."
      },
      "review_planning_B": {
        "planning_summary": "This paper provides real-world clinical evidence supporting the hypothesis that antibiotic-induced gut dysbiosis negatively impacts ICI efficacy, specifically manifesting as reduced Overall Survival rather than immediate lack of disease control. It offers specific data on the threshold of antibiotic duration (>14 days) associated with adverse outcomes in gynecologic cancers, serving as a concrete example of the 'antibiotic-microbiome-ICI' interaction axis.",
        "facet_contributions": [
          {
            "boundaries": "Limited to gynecologic cancers; does not prove causality via microbiome measurement; effect size is observational.",
            "contribution": "Provides empirical clinical data showing that prior antibiotic use (specifically ≥14 days) is associated with reduced Overall Survival in solid tumors (gynecologic cancers), supporting the modulatory role of the microbiome environment on ICI efficacy.",
            "facet_id": "F1",
            "possible_uses": "Can be used to illustrate the clinical impact of antibiotic exposure on ICI outcomes, specifically highlighting the distinction between short-term response metrics (DCR) and long-term survival benefits."
          },
          {
            "boundaries": "Mechanism is inferred/hypothesized by authors; no direct microbial sequencing data is presented in this study to confirm dysbiosis in this specific cohort.",
            "contribution": "Discusses the proposed mechanism of gut dysbiosis caused by broad-spectrum antibiotics (particularly cephalosporins) affecting ICI activity, referencing the recovery time of microbiota (6 weeks to 6 months).",
            "facet_id": "F2",
            "possible_uses": "Serves as a theoretical bridge explaining *why* antibiotics might reduce ICI efficacy, linking clinical observation to biological plausibility via microbiome disruption."
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "Contextualizes the clinical relevance of microbiome modulation in standard-of-care settings.",
            "material": "Discussion of FMT, probiotics, and diet as potential interventions to reverse antibiotic-induced dysbiosis and improve ICI response.",
            "purpose": "Provides background on potential therapeutic strategies (microbiome restoration) mentioned in the literature surrounding antibiotic-ICI interactions."
          },
          {
            "connection_to_review": "Highlights limitations in current biomarker assessment.",
            "material": "Note that dMMR/MSI-H status was not an independent prognostic factor in multivariate analysis due to small sample size and heterogeneous testing rates across tumor types.",
            "purpose": "Illustrates the complexity of confounding factors when evaluating microbiome-related effects against established genomic biomarkers in retrospective cohorts."
          }
        ],
        "scope_interpretation_cautions": [
          "The association between antibiotics and OS is observational; confounding by indication (severity of infection requiring longer antibiotics) cannot be fully excluded.",
          "The study does not measure gut microbiota directly; conclusions about dysbiosis are mechanistic hypotheses based on external literature.",
          "Results are specific to anti-PD-1 monotherapy in gynecologic cancers and may not generalize to combination therapies or other solid tumor types without verification."
        ],
        "topic_handles": [
          "Antibiotic duration threshold (>14 days)",
          "Gut microbiota dysbiosis mechanism (proposed)",
          "Overall Survival vs Disease Control Rate dissociation",
          "Recurrent gynecologic malignancies context",
          "Anti-PD-1 monotherapy setting"
        ]
      },
      "locator": {
        "writer_packet": "F:\\OptoMind-Review-2\\outputs\\body_full_staged_acceptance_20261004_40cny\\planning\\writer_packets\\Ch1.json",
        "source_handle": "P0360",
        "card_path": "F:\\OptoMind-Review-2\\outputs\\paper_cards\\20260922_microbiome_batch\\reading\\cards\\9cfb62b17064ed5abe1c447f8fa2f46e716b6c0d\\1402488d208c28b13f15590fe58d50e3\\attempt-01\\PAPER_READING_CARD.json"
      },
