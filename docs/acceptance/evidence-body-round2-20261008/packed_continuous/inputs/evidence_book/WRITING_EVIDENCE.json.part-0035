    "record::0d987b52a5da357bdfb14830a31f442c9d69610b3d34b67a50e9213dcf477f30": {
      "source_handle": "P0266",
      "title": "Antibiotics impair immune checkpoint inhibitor effectiveness in Hispanic patients with non‐small cell lung cancer (AB‐CLICaP)",
      "year": "2020",
      "doi": "10.1111/1759-7714.13573",
      "paper_id": "70ba511d3bb0697cd93e53d4880c68ce77471bde",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用回顾性队列设计，收集2013年6月至2018年1月间来自四个拉美国家转诊癌症中心的140名成年NSCLC患者数据。根据抗生素使用情况及时间关系将患者分为三组：(1) No-ATB（治疗前及治疗中均未使用抗生素）；(2) Pre-ICI ATB（首次ICI剂量前30天内使用抗生素）；(3) ICI-ATB（ICI治疗期间同步使用抗生素）。主要终点为总生存期（OS），次要终点为无进展生存期（PFS）和治疗反应率。使用Kaplan-Meier法估算生存曲线，并通过Cox回归模型调整潜在混杂因素（如性别、年龄、ECOG评分、ICI类型等）。",
        "contribution_and_limits": [
          {
            "contribution": "首次在拉丁美洲人群中证实抗生素暴露与ICI治疗NSCLC患者OS缩短之间的关联，补充了全球范围内关于微生物群-免疫治疗相互作用的地域多样性证据。",
            "limits": "回顾性设计存在固有偏倚；样本量较小，特别是抗生素暴露组仅32人，可能限制了对PFS细微差异的检测能力；未直接测量患者微生物群组成，仅以抗生素使用作为间接指标；不同抗生素种类、给药途径和疗程异质性大，难以完全控制为混杂因素。"
          }
        ],
        "key_findings": [
          {
            "conditions": "在140名NSCLC患者中，32名（23%）接受了抗生素治疗（14名为Pre-ICI ATB，18名为ICI-ATB），108名为No-ATB。",
            "finding": "No-ATB组的 median OS 为 40.6个月，而 Pre-ICI ATB 组为 20.3个月，ICI-ATB 组为 24.7个月。抗生素暴露与OS显著缩短相关。"
          },
          {
            "conditions": "比较不同抗生素暴露组与无暴露组。",
            "finding": "Pre-ICI ATB 与 ICI-ATB 组之间的OS无显著差异（P=0.4）。"
          },
          {
            "conditions": "评估PFS和反应率。",
            "finding": "各组间PFS（No-ATB: 2.7个月 vs Pre-ICI: 1.9个月 vs ICI-ATB: 1.9个月）和总体反应率（No-ATB: 26.9% vs ATB组: 25.9%）均无统计学显著差异。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "既往研究表明肠道微生物群调节免疫介导的肿瘤细胞破坏，且微生物群改变与ICI疗效降低有关。抗生素作为改变肠道菌群多样性的干预措施，是否会影响ICI的治疗效果？特别是在此前未在拉美人群中验证过这一关联的背景下，抗生素暴露是否与ICI治疗的生存获益受损相关？",
        "research_scope": "拉丁美洲（墨西哥、哥伦比亚、哥斯达黎加、秘鲁）晚期或非手术非小细胞肺癌（NSCLC）患者，接受免疫检查点抑制剂（ICI）治疗。",
        "work_summary": "本研究是一项多中心跨国回顾性队列研究，旨在评估抗生素治疗（ATB）对接受ICI治疗的拉美裔NSCLC患者临床结局的影响。研究将患者分为三组：无抗生素暴露组、ICI前30天内使用抗生素组以及ICI期间同步使用抗生素组。结果显示，抗生素暴露与总生存期（OS）显著缩短相关，但在无进展生存期（PFS）和客观缓解率上未观察到显著差异。该研究为抗生素通过破坏肠道微生物群进而影响ICI疗效的假说提供了拉美人群的临床证据。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了来自拉丁美洲特定人群的实证数据，支持“抗生素暴露损害ICI疗效”这一假设，但仅限于总生存期（OS），未涉及无进展生存期（PFS）或客观缓解率。它可作为解释地域特异性微生物环境如何影响免疫治疗结果的案例，并提示抗生素选择策略的重要性。",
        "facet_contributions": [
          {
            "boundaries": "仅限NSCLC患者；仅关注OS显著性；未提供机制层面的直接证据（如微生物测序）；样本量小，置信区间宽。",
            "contribution": "提供了拉丁美洲NSCLC患者中抗生素暴露与ICI疗效关系的临床观察数据。发现抗生素暴露显著降低OS，但不影响PFS或反应率。这有助于解释在不同地理/人口背景下，微生物群扰动对免疫治疗最终生存结果的影响程度可能不同于其他效应指标。",
            "facet_id": "F1",
            "possible_uses": "用于综述中讨论抗生素对ICI疗效影响的异质性，特别是当其他研究（如Derosa等）报告PFS也受影响时，本研究的阴性结果可作为对比，提示研究规模、人群特征或统计效能的差异。"
          },
          {
            "boundaries": "机制部分是基于文献综述而非本研究原始数据；本研究本身未进行微生物分析；连接点是相关性而非因果证明。",
            "contribution": "虽然未直接阐明机制，但讨论了广谱抗生素（如β-内酰胺类、喹诺酮类）对特定有益菌属（如双歧杆菌、拟杆菌属）的已知破坏作用，并引用文献将这些细菌与IFN-γ水平、树突状细胞成熟和CD8+ T细胞激活联系起来。这为抗生素通过微生物群介导影响ICI疗效提供了理论背景和支持性证据链。",
            "facet_id": "F2",
            "possible_uses": "用于综述中构建“抗生素-微生物群-免疫系统-ICI疗效”的理论框架部分，说明作者提出的潜在生物学通路。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "地域代表性",
            "material": "研究对象为拉丁美洲（墨西哥、哥伦比亚、哥斯达黎加、秘鲁）患者，这些地区的环境细菌暴露和饮食习惯可能与欧美或亚洲人群不同。",
            "purpose": "用于综述中强调微生物群组成具有地域差异性，因此抗生素对ICI疗效的影响可能存在人群特异性。提醒读者在推广结论时需考虑地域背景。"
          },
          {
            "connection_to_review": "临床实践启示",
            "material": "建议临床医生在ICI治疗患者中限制广谱抗生素的使用，优先考虑对微生物群干扰较小的药物（如硝基呋喃妥因、多西环素）。",
            "purpose": "用于综述中总结现有证据对临床决策的指导意义，特别是在资源有限或感染风险高的情况下，权衡抗感染治疗与免疫治疗获益的策略。"
          }
        ],
        "scope_interpretation_cautions": [
          "本研究为回顾性观察研究，不能确立因果关系，仅显示关联。",
          "抗生素暴露组的样本量较小（n=32），可能导致统计效能不足，未能检测到PFS的显著差异。",
          "未直接测量微生物群，抗生素使用仅为间接代理变量，无法区分具体菌株变化。",
          "不同抗生素类型、剂量和疗程的异质性未被充分调整，可能引入混杂。",
          "结果主要反映OS，PFS和反应率的阴性结果需谨慎解读，不代表抗生素完全不影响疾病控制。"
        ],
        "topic_handles": [
          "Antibiotic exposure timing (pre-ICI vs concomitant)",
          "Overall survival (OS) impact",
          "Non-small cell lung cancer (NSCLC)",
          "Latin American population context",
          "Microbiome disruption surrogate marker"
        ]
      },
      "locator": {
