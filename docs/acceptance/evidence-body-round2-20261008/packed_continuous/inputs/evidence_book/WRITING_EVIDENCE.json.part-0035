    "record::cd95be7cc3e52cf32fafe3e0a5b6b3eb9ebf4342af217f433bc23ac17b54343c": {
      "source_handle": "P0236",
      "title": "Systemic antibiotic exposure and outcomes of immune checkpoint inhibitors in non–small cell lung cancer.",
      "year": "2026",
      "doi": "10.1200/jco.2026.44.16_suppl.e20602",
      "paper_id": "62379160afa6c14c9a9ae85a0684ccec8ed9c07e",
      "material_depth": "abstract",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "采用系统综述和荟萃分析方法。按照PRISMA 2020指南进行文献检索（PubMed, Scopus, EMBASE），纳入2018-2025年发表的研究。纳入标准包括：评估实体瘤患者ICI治疗期间ABT暴露与时间事件结局关联的研究，且明确定义了ABT暴露窗口。统计分析主要使用随机效应模型。预先指定的敏感性分析专注于NSCLC亚组，因其样本量最大且方法学同质性最高。",
        "contribution_and_limits": [
          {
            "contribution": "提供了截至2025年关于全身性抗生素暴露影响实体瘤ICI疗效的最新系统综述和荟萃分析数据，特别强调了NSCLC亚组中PFS受损的稳健证据。",
            "limits": "所给摘要未交代具体的抗生素种类、给药时机细节、微生物群具体组成变化机制、以及不同ICI药物类型的分层分析结果。结论基于观察性研究的汇总，因果推断受限。"
          }
        ],
        "key_findings": [
          {
            "conditions": "所有纳入的实体瘤患者（N=52,489）",
            "finding": "ABT暴露与较差的总生存期（OS）相关（随机效应HR 1.16, 95% CI 1.03–1.29），以及数值上较差的无进展生存期（PFS）（随机效应HR 1.11, 95% CI 0.95–1.27）。"
          },
          {
            "conditions": "NSCLC亚组敏感性分析（N=45,896）",
            "finding": "OS方面观察到中度异质性（I² = 51%），合并固定效应HR为1.05 (95% CI 0.996–1.11)，显示ABT暴露倾向于导致生存率下降的趋势。PFS方面无异质性（I² = 0%），ABT暴露与疾病进展风险显著增加相关（HR 1.16, 95% CI 1.02–1.30），固定效应和随机效应估计值一致。"
          }
        ],
        "paper_kind": "review",
        "problem_or_question": "尽管免疫检查点抑制剂改变了实体瘤的管理，但只有部分患者能获得持久获益。鉴于肠道微生物群是抗肿瘤免疫的关键调节者，且全身性抗生素治疗会破坏微生物稳态，观察性研究显示抗生素可能损害ICI疗效，但结果异质性大。本研究旨在通过更新的综合分析，特别是针对肿瘤特异性分析，来澄清这种关联。",
        "research_scope": "实体瘤患者接受免疫检查点抑制剂（ICI）治疗期间，全身性抗生素暴露（ABT）与时间事件结局（总生存期OS、无进展生存期PFS）的关联；特别聚焦于非小细胞肺癌（NSCLC）亚组。",
        "work_summary": "该研究旨在综合现有证据，评估在实体瘤免疫治疗背景下，全身性抗生素使用对疗效的影响。作者遵循PRISMA 2020指南进行了系统综述和荟萃分析，检索了2018年至2025年间PubMed、Scopus和EMBASE数据库中的相关研究。主要发现表明，整体而言，抗生素暴露与较差的总生存期相关，且在非小细胞肺癌亚组中，抗生素暴露与显著增加的疾病进展风险（无进展生存期缩短）一致。这支持了微生物群介导的免疫治疗疗效受损假说。"
      },
      "review_planning_B": {
        "planning_summary": "该论文提供了关于全身性抗生素暴露如何负面影响免疫检查点抑制剂（ICI）疗效的大规模荟萃分析证据，特别是在非小细胞肺癌（NSCLC）中。它为“微生物群介导的ICI疗效受损”这一假设提供了强有力的流行病学支持，并指出了抗生素管理在ICI治疗中的重要性。对于综述而言，它是解释临床观察到的疗效差异的重要背景材料，也是连接微生物群理论与临床预后结果的桥梁。",
        "facet_contributions": [
          {
            "boundaries": "仅展示了抗生素暴露与临床预后的关联，未直接测量或分析微生物群的具体变化。不能直接说明是哪种微生物或机制导致了这种效果。",
            "contribution": "提供了大规模荟萃分析数据，证实全身性抗生素暴露与实体瘤（特别是NSCLC）患者ICI治疗后的较差生存结局（OS和PFS）相关。具体数据显示NSCLC患者中PFS风险显著增加（HR 1.16）。",
            "facet_id": "F1",
            "possible_uses": "用于回答“肠道微生物群如何调节实体瘤中免疫检查点抑制剂的疗效”这一问题，提供临床层面的负面调节证据。可作为抗生素干扰ICI疗效的临床后果的具体量化指标。"
          },
          {
            "boundaries": "本身不提供具体的分子或细胞机制细节（如特定菌群、代谢物、免疫细胞通路）。其机制主张是基于观察性关联的推论，需结合其他提供机制详情的研究。",
            "contribution": "提出了“微生物群介导的免疫治疗疗效受损”作为潜在机制的解释框架，并呼吁未来研究整合微生物谱分析和标准化的抗生素暴露定义。",
            "facet_id": "F2",
            "possible_uses": "为机制探讨提供理论背景和方向指引。虽然未提供直接的分子机制数据，但其结论强化了微生物群在ICI疗效中的核心地位，有助于构建从微生物扰动到临床结局的逻辑链条。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "强调研究肠道微生物群对ICI疗效影响的临床紧迫性和现实意义，即优化抗生素使用可能是提高ICI疗效的策略之一。",
            "material": "指出尽管ICI改变了实体瘤管理，但仅部分患者获益，且抗生素使用常见且可能有害。",
            "purpose": "背景与临床相关性"
          },
          {
            "connection_to_review": "为综述提供当前关于抗生素-ICI相互作用的高质量证据水平参考，表明这是一个已被广泛观察且具有统计学意义的现象，而非个别案例。",
            "material": "汇总了15项研究、超过5万名患者的数据，显示了抗生素暴露与不良预后之间的一致性趋势，尤其是在NSCLC中。",
            "purpose": "领域现状与证据等级"
          }
        ],
        "scope_interpretation_cautions": [
          "该研究为系统综述和荟萃分析，其结论依赖于纳入的观察性研究的质量和设计。",
          "关联不等于因果；抗生素暴露可能与患者整体健康状况、感染严重程度等其他混杂因素有关，尽管研究试图控制这些变量，但残余混杂仍可能存在。",
          "NSCLC亚组的分析是预先指定的敏感性分析，其结果可能不适用于所有实体瘤类型或其他ICI药物组合。",
          "所给摘要未提供具体的抗生素类别、疗程、给药时间与ICI开始时间的关系等细节，这些细节对理解机制和影响程度至关重要。"
        ],
        "topic_handles": [
          "Systemic antibiotic exposure (ABT)",
          "Immune checkpoint inhibitors (ICIs)",
          "Non-small cell lung cancer (NSCLC)",
          "Overall survival (OS)",
          "Progression-free survival (PFS)",
          "Gut microbiota disruption",
          "Microbiome-mediated impairment of immunotherapy efficacy"
        ]
      },
