    "record::3cdad2d48d4bf97ae9b840521b9daee5693ee31da53ab53a98c9725795cc021b": {
      "source_handle": "P0393",
      "title": "Multi-Kingdom Gut Microbiome Interaction Characteristics Predict Immune Checkpoint Inhibitor Efficacy Across Pan-Cancer Cohorts",
      "year": "2025",
      "doi": "10.3390/microorganisms13112595",
      "paper_id": "a9e58de949ced186b4882146c14b79b306ae9ef5",
      "material_depth": "fulltext",
      "material_status": "resolved",
      "aliases": [],
      "study_summary_A": {
        "approach": "1. 数据收集与预处理：从NCBI数据库获取10个队列的宏基因组原始数据，进行质控、宿主DNA去除、标准化测序深度（rarefaction至915,968 reads）及物种丰度估算（Kraken2/Bracken）。2. 多界聚类分析：对各微生物域的相对丰数据进行Hellinger转换，计算Bray-Curtis距离矩阵并转换为相似性矩阵，赋予权重后使用WSNF算法进行样本聚类，通过轮廓系数确定最佳聚类数（分为C1和C2两个亚型）。3. 多样性与临床关联分析：使用Shannon和Observed species指数评估Alpha多样性，PCoA和PERMANOVA评估Beta多样性；结合Kaplan-Meier生存分析和卡方检验分析亚型与治疗反应（Responder/Non-Responder）、无进展生存期（PFS）及总生存期（OS）的关系。4. 差异物种鉴定与建模：在训练集（70%样本）中使用DESeq2进行跨亚型差异分析，设定阈值筛选显著差异属，构建包含32个属的多界诊断模型。5. 机器学习验证：在独立测试集（30%样本）中应用随机森林和支持向量机算法，比较多界模型与单界模型的分类性能（ROC曲线/AUC）。6. 共现网络分析：使用FastSpar工具计算SparCC相关性，构建微生物共现网络，分析节点连接度和核心菌属。",
        "contribution_and_limits": [
          {
            "contribution": "提供了首个基于大规模多队列整合的多界微生物组（细菌+真菌+古菌+病毒）ICI疗效预测模型，证实多界联合特征比单一细菌特征具有更高的预测精度。",
            "limits": "所给摘要未交代具体的外部验证队列细节（仅提及内部70/30划分）；未提供因果机制的实验验证，仅为观察性关联；不同癌症类型和治疗方案（如抗PD-1 vs 联合疗法）的异质性处理情况未详细展开。"
          },
          {
            "contribution": "揭示了高微生物多样性和稳定网络结构与良好ICI预后之间的关联，提出了“多界生态稳定性”作为疗效预测的新视角。",
            "limits": "所给摘要未交代网络分析是否控制了混杂因素（如抗生素使用、饮食等）；具体微生物介导免疫调节的分子机制仍属于推测，需后续实验验证。"
          },
          {
            "contribution": "识别了跨界的潜在生物标志物组合（如Bacteroides与Kluyveromyces的组合），为个性化微生态干预提供了候选靶点。",
            "limits": "所给摘要未交代这些标志物在不同种族、地理区域人群中的普适性验证结果；部分低丰度微生物界（如病毒、古菌）的信号可能受测序深度和技术偏差影响。"
          }
        ],
        "key_findings": [
          {
            "conditions": "基于WSNF聚类的两个亚型（C1 vs C2），涉及965例多癌种ICI治疗患者",
            "finding": "C2亚型表现出显著更高的Alpha多样性（Shannon和Observed species指数）和更复杂的Beta多样性结构；C2亚型中响应者比例更高，且总体生存期（OS）和无进展生存期（PFS > 6个月）显著优于C1亚型。"
          },
          {
            "conditions": "多界微生物组成差异分析",
            "finding": "C2亚型富集有益菌属，如细菌界的Bacteroides、Parabacteroides，真菌界的Kluyveromyces；C1亚型富集潜在有害菌属，如Malassezia。古菌和病毒界也显示出显著的亚型特异性分布。"
          },
          {
            "conditions": "机器学习模型预测效能比较",
            "finding": "由32个多界微生物属组成的诊断模型在区分ICI疗效方面表现出优于单一细菌、真菌、古菌或病毒模型的预测准确性（更高的AUC值）。"
          },
          {
            "conditions": "微生物共现网络分析",
            "finding": "C2亚型的微生物共现网络更为密集和稳健，强正相关连接（|ρ| > 0.5）的数量显著多于C1亚型；拟杆菌属（Bacteroides）在C2中为核心枢纽菌属，而Komagataella在C1中更具中心性。"
          }
        ],
        "paper_kind": "empirical",
        "problem_or_question": "既往关于肠道微生物组与ICI疗效的研究主要局限于细菌领域，忽略了真菌、古菌和病毒等其他微生物界的作用。本研究试图解决以下问题：1. 多界微生物组的整体特征是否存在特定的分型模式？2. 这些多界微生物特征是否能比单一细菌特征更准确地预测ICI治疗的疗效？3. 不同微生物界之间的相互作用网络如何影响治疗效果？",
        "research_scope": "该研究针对接受免疫检查点抑制剂（ICI）治疗的多种实体瘤患者，研究对象为肠道多界微生物组（包括细菌、真菌、古菌和病毒）。数据来源于全球7个国家的10个队列，共1712名患者的粪便宏基因组测序数据。最终纳入分析的有效样本为965例，涵盖黑色素瘤、非小细胞肺癌、胃肠道肿瘤和肾细胞癌等。",
        "work_summary": "本研究旨在评估多界微生物组及其相互作用对ICI治疗疗效的预测价值。作者整合了来自多个队列的大规模宏基因组数据，利用加权相似性网络融合（WSNF）方法将四种微生物域的数据整合并进行聚类，识别出两种患者亚型（C1和C2）。研究发现，C2亚型具有更高的微生物多样性、更稳定的共现网络结构，且与更好的ICI治疗反应和预后显著相关。通过差异分析和机器学习模型，作者筛选出包含32个属的多界微生物特征组合，其预测ICI疗效的准确性优于单一界别的模型。此外，研究还揭示了特定有益菌属（如拟杆菌属、克鲁维酵母属）和潜在有害菌属（如马拉色菌属）在不同亚型中的分布差异及其与免疫调节机制的关联。"
      },
      "review_planning_B": {
        "planning_summary": "该论文为综述提供了关于“多界微生物组（Multi-Kingdom Microbiome）”在ICI疗效预测中价值的实证素材。它超越了传统的单一细菌视角，通过整合细菌、真菌、古菌和病毒数据，证明了多界联合特征能提升预测精度，并强调了微生物网络稳定性和多样性的重要性。这对于综述中讨论“超越细菌的微生物组作用”、“多界互作机制”以及“复杂生态特征作为生物标志物”的子问题具有直接参考价值。",
        "facet_contributions": [
          {
            "boundaries": "该结论基于回顾性队列数据的观察性关联，不能直接推断因果关系；不同癌症类型和治疗方案的混合可能引入异质性，需谨慎外推至特定单一癌种或特定药物类别。",
            "contribution": "提供了多界微生物组特征（特别是高多样性和特定属的组合）与ICI疗效正相关的实证证据。指出C2亚型（高多样性、富含Bacteroides/Kluyveromyces）与更好的治疗反应和生存率相关，而C1亚型（低多样性、富含Malassezia）与较差预后相关。",
            "facet_id": "F1",
            "possible_uses": "用于支持综述中关于“肠道微生物组特征如何影响ICI疗效”的论述，特别是强调多界微生物而非单一细菌的重要性。可作为“微生物多样性/网络稳定性促进疗效”这一观点的具体案例。"
          },
          {
            "boundaries": "所给材料未提供直接的机制实验数据（如动物模型或体外细胞实验），所有机制解释均为基于文献的推测和关联分析，属于理论假说层面，需注明其为作者的解释而非已验证的因果链条。",
            "contribution": "提出了多界微生物通过维持肠道生态稳定性和产生免疫调节代谢物（如短链脂肪酸）来增强抗肿瘤免疫的潜在机制假设。讨论了Bacteroides fragilis诱导树突状细胞成熟和Th1细胞浸润，以及Malassezia激活补体级联反应导致免疫抑制的可能路径。",
            "facet_id": "F2",
            "possible_uses": "用于综述中探讨“微生物介导ICI疗效的机制”部分，提供多界微生物互作影响宿主免疫的微环境背景。可与其他研究共同构建“微生物-免疫-肿瘤”轴的理论框架。"
          }
        ],
        "broader_review_uses": [
          {
            "connection_to_review": "方法论参考",
            "material": "使用了WSNF方法整合多界宏基因组数据，并通过机器学习（随机森林/SVM）构建预测模型。",
            "purpose": "在综述的方法学部分或讨论中，可作为处理多组学或多界微生物数据整合策略的一个实例，展示如何利用高级统计学习方法挖掘复杂微生物组数据的预测潜力。"
          },
          {
            "connection_to_review": "临床干预启示",
            "material": "讨论了抗生素使用对微生物多样性的负面影响，以及粪菌移植（FMT）、益生菌（Clostridium butyricum）和益生元（inulin-type fructans）在改善ICI疗效中的潜在应用。",
            "purpose": "为综述中关于“基于微生物组的临床干预策略”提供背景支持和现有证据汇总，说明当前从观察性研究向干预性转化研究的趋势。"
          }
        ],
        "scope_interpretation_cautions": [
