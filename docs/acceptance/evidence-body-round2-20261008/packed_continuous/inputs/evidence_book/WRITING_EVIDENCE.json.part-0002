              "broader_review_uses": [
                {
                  "connection_to_review": "提供CRC免疫微环境的整体背景，特别是TLS（三级淋巴结构）和免疫沙漠表型的形成机制。",
                  "material": "文章第一部分关于CRC免疫微环境组成及空间分布的描述。",
