            "year": "2025",
            "doi": "10.1556/030.2025.02719",
            "paper_id": "d01d7681c26311e53a792fec4a5c6d8c608be0d6",
            "material_depth": "abstract",
            "material_status": "resolved",
            "aliases": [],
            "study_summary_A": {
              "approach": "采用系统综述和荟萃分析方法。首先进行系统性文献检索，筛选评估基线肠道微生物群、FMT、益生菌/益生元干预或抗生素暴露的研究。随后使用随机效应模型汇总估计总生存期（OS）和无进展生存期（PFS）的风险比（HR），以及缓解率和irAEs的比值比（OR）。",
              "contribution_and_limits": [
                {
                  "contribution": "提供了关于肠道微生物群关键特征（特定菌属、多样性、抗生素影响、FMT效果）与ICIs疗效及安全性之间关联的定量综合证据。",
                  "limits": "所给摘要未交代异质性分析结果、发表偏倚评估细节、具体癌症类型的亚组分析结果、irAEs的具体统计数值（仅提及关联性）、以及纳入研究的原始数据质量评估标准。"
                }
              ],
              "key_findings": [
                {
                  "conditions": "特定细菌属富集（Akkermansia muciniphila, Bifidobacterium longum, Faecalibacterium prausnitzii）",
                  "finding": "与改善的总生存期（HR 0.62, 95% CI 0.51-0.76）和无进展生存期（HR 0.69, 95% CI 0.55-0.83）显著相关。"
                },
                {
                  "conditions": "在ICI治疗前或期间暴露于抗生素",
                  "finding": "与较差的总生存期相关（HR 1.84, 95% CI 1.45-2.34）。"
                },
                {
                  "conditions": "接受来自反应者的FMT",
                  "finding": "表现出更高的客观缓解率（OR 2.91, 95% CI 1.48-5.73）。"
                },
                {
                  "conditions": "比较响应者与无响应者",
                  "finding": "响应者的微生物多样性指数 consistently higher（持续更高）。"
                }
              ],
              "paper_kind": "review",
              "problem_or_question": "尽管临床前和临床研究提示特定细菌类群可能影响ICIs的疗效和irAEs，但这些关联的幅度和一致性尚不明确。本研究旨在量化肠道微生物群组成及其调控对ICIs治疗疗效和毒性谱的具体影响。",
              "research_scope": "癌症患者（特别是接受免疫检查点抑制剂治疗的患者）的肠道微生物群组成、干预措施及其与疗效和不良事件的关系。涵盖的研究类型包括观察性研究（基线菌群、抗生素暴露）、干预性研究（FMT、益生菌/益生元）。",
              "work_summary": "该论文是一篇系统综述和荟萃分析，旨在评估肠道微生物群对免疫检查点抑制剂（ICIs）疗效及免疫相关不良事件（irAEs）的影响。作者通过系统检索PubMed、Embase、Web of Science和Cochrane Library数据库（截至2025年3月），纳入了38项涉及5,642名患者的研究。研究重点分析了特定细菌属（如Akkermansia muciniphila、Bifidobacterium longum、Faecalibacterium prausnitzii）的富集、抗生素使用、供体反应者粪便微生物移植（FMT）以及微生物多样性指数与总生存期（OS）、无进展生存期（PFS）、客观缓解率（ORR）及irAEs之间的关联。结果显示，有益菌富集与改善生存预后显著相关，而抗生素暴露则与较差的生存结果相关，FMT从反应者来源可显著提高缓解率。"
            },
            "review_planning_B": {
              "planning_summary": "该综述提供了肠道微生物群作为ICIs疗效生物标志物和干预靶点的宏观定量证据。其核心价值在于汇总了特定有益菌、抗生素负面影响及FMT正面效果的效应量，为解释“微生物群如何调节疗效”提供了流行病学层面的支持，并指出了潜在的干预方向。",
