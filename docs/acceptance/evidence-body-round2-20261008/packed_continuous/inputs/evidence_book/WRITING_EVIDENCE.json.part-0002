          {
            "source_handle": "P0200",
            "title": "Integrative stratification of response to immunotherapy using host and microbial signatures in patients with advanced non-small cell lung cancer",
            "year": "2026",
            "doi": "10.1186/s13073-026-01736-5",
            "paper_id": "57133de914bfeefa962dacc91943374147c07fff",
            "material_depth": "abstract",
            "material_status": "resolved",
            "aliases": [],
            "study_summary_A": {
              "approach": "1. 纵向数据采集：对92名接受pembrolizumab治疗的晚期NSCLC患者进行串行样本采集。2. 多组学分析：对患者样本进行肠道微生物组测序、RNA-seq和WES分析。3. 对照比较：将患者微生物数据与92名健康对照进行比较，分析免疫治疗期间的微生物特征变化。4. 队列整合与验证：结合内部队列与728例公开ICI治疗队列数据，开发用于分类ICI反应的评分。5. 评分优化：基于响应者与非响应者相关微生物标记物的比率构建跨人群评分，并与TMB联合评估其分层能力。",
              "contribution_and_limits": [
                {
                  "contribution": "提供了纵向多组学证据，明确了特定菌群（Faecalibacterium vs Lactobacillus/Escherichia）与NSCLC患者ICI疗效的关联，并揭示了微生物失调随治疗和进展的动态轨迹。",
                  "limits": "所给摘要未交代具体的统计模型细节、多组学数据整合的具体算法、以及TMB联合评分在不同亚组中的具体性能指标（如AUC值）。此外，相关性不等于因果性，饮食和抗生素的影响需进一步控制混杂因素验证。"
                }
              ],
              "key_findings": [
                {
                  "conditions": "在92名NSCLC患者队列中，根据RECIST标准定义的反应者（CR/PR或SD≥6个月）与非反应者对比",
                  "finding": "反应者富集Faecalibacterium属，非反应者富集Lactobacillus和Escherichia属；这些菌群的丰度与膳食纤维摄入和抗生素使用存在特定关联。"
                },
                {
                  "conditions": "纵向观察治疗期间及疾病进展时的微生物失调动态",
                  "finding": "在治疗后，仅反应者的微生物特征与健康队列的差异性降低；而在疾病进展时，无论反应者还是非反应者，其与正常队列的差异性均增加。"
                },
                {
                  "conditions": "利用内部队列和728例公共ICI队列数据开发的跨人群评分",
                  "finding": "该评分基于响应者/非响应者相关微生物标记物比率，与反映肠道微生物健康状态的指数呈显著正相关；当与肿瘤突变负荷（TMB）结合时，提高了ICI疗效的分层准确性。"
                }
              ],
              "paper_kind": "empirical",
              "problem_or_question": "尽管已知肠道微生物组与ICI反应有关，但缺乏纵向多组学研究来明确具体因素及其动态变化机制。本研究旨在识别导致治疗反应差异的具体微生物和宿主因素，并开发一种能够跨人群验证的疗效预测评分。",
              "research_scope": "研究对象为接受帕博利珠单抗（pembrolizumab）治疗的晚期非小细胞肺癌（NSCLC）患者。研究情境包括内部队列（92名患者，进行纵向多组学分析）、健康对照队列（92人）以及外部公共ICI治疗队列（728人）。范围涵盖肠道微生物组、宿主转录组（RNA-seq）和全外显子组测序（WES），旨在识别影响免疫检查点抑制剂（ICI）疗效的因素。",
              "work_summary": "该研究针对肠道微生物组与ICI疗效关联中纵向多组学数据不足的现状，对92例晚期NSCLC患者进行了纵向采样和多组学分析。通过比较患者与健康人的微生物特征，并利用内部队列及728例公共数据开发并验证了一个分类评分系统。研究发现特定菌群丰度与治疗反应相关，观察到治疗过程中微生物失调的动态变化，并提出了一个结合肿瘤突变负荷（TMB）的跨人群评分以改善疗效分层。"
            },
            "review_planning_B": {
              "planning_summary": "该论文提供了关于肠道微生物组如何作为独立且互补的轴解释ICI疗效的具体实证素材。其核心价值在于纵向动态视角（治疗前后及进展期）和跨人群验证的微生物评分体系，可直接用于综述中关于“微生物标志物预测疗效”及“微生物-宿主互作动态变化”的章节。",
              "facet_contributions": [
                {
                  "boundaries": "结论基于NSCLC患者队列，虽结合了公共ICI数据，但主要发现仍局限于肺癌语境下的微生物特征；评分的有效性依赖于特定的标记物选择和健康状态指数。",
                  "contribution": "提供了具体的微生物分类群（Faecalibacterium, Lactobacillus, Escherichia）与ICI疗效（CR/PR/SD vs PD）的关联证据，并开发了基于这些标记物比率的跨人群评分。",
                  "facet_id": "F1",
                  "possible_uses": "可用于回答“哪些微生物特征与ICI疗效相关”的问题，支持综述中关于特定菌群作为疗效生物标志物的论述。"
                },
                {
                  "boundaries": "摘要未提供具体的分子机制（如代谢产物、免疫细胞浸润等），仅描述了表型层面的动态变化和统计学关联；无法直接解释因果机制，仅能作为机制研究的背景或假设生成依据。",
                  "contribution": "揭示了微生物失调的动态变化模式：反应者治疗后向健康状态回归，而进展期所有患者均出现恶化。同时指出微生物特征与TMB具有互补性。",
                  "facet_id": "F2",
                  "possible_uses": "可用于阐述“微生物组介导疗效的可能机制或伴随现象”，特别是微生物生态系统的稳定性与治疗效果的关系，以及微生物与宿主基因组特征（TMB）的协同作用。"
                }
