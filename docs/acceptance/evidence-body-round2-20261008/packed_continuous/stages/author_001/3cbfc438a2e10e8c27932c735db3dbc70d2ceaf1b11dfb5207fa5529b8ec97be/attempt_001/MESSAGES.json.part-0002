aliases\":[],\"title\":\"Functional convergence amid taxonomic variability in gut microbiome–immune checkpoint inhibitor research: a bibliometric and mechanistic synthesis\",\"doi\":\"10.3389/fimmu.2026.1883259\",\"paper_id\":\"9dd62eb058feb9dbd44c28e9c8d004181dd8d19d\"},\"P0437\":{\"source_handle\":\"P0437\",\"source_id\":\"source::P0437\",\"aliases\":[],\"title\":\"Gene-level gut microbiome signatures as predictive biomarkers for response to immune checkpoint inhibitors across multiple cancer types\",\"doi\":\"10.1080/19490976.2026.2662690\",\"paper_id\":\"bfb5efeaf486304583ce74567d60f84cf138a0ae\"},\"P0511\":{\"source_handle\":\"P0511\",\"source_id\":\"source::P0511\",\"aliases\":[],\"title\":\"Meta-analysis of the gut microbiota in predicting response to cancer immunotherapy in metastatic melanoma\",\"doi\":\"10.1172/jci.insight.140940\",\"paper_id\":\"e533262a6b45c7d00cff83bd889cdc367c85f377\"},\"P0015\":{\"source_handle\":\"P0015\",\"source_id\":\"source::P0015\",\"aliases\":[],\"title\":\"A gut microbial signature for combination immune checkpoint blockade across cancer types\",\"doi\":\"10.1038/s41591-024-02823-z\",\"paper_id\":\"08a484e3c782bc9552d2df812bad2ec86f231edc\"},\"P0081\":{\"source_handle\":\"P0081\",\"source_id\":\"source::P0081\",\"aliases\":[],\"title\":\"Unraveling gut microbiome interferences in cancer immunotherapy: a meta-analysis of diverse drug effects\",\"doi\":\"10.1186/s12885-025-15094-9\",\"paper_id\":\"1d2792ae1850f48accaf1c111b2d92b6b2ebc6c0\"},\"P0402\":{\"source_handle\":\"P0402\",\"source_id\":\"source::P0402\",\"aliases\":[\"P0576\"],\"title\":\"THE IMPACT OF ANTIBIOTIC THERAPY ON THE EFFECTIVENESS OF IMMUNOTHERAPY: A REVIEW OF CURRENT EVIDENCE\",\"doi\":\"10.31435/ijitss.1(49).2026.4882\",\"paper_id\":\"affb01ce6dd2c0ea0909edc814fd8af01596e021\"},\"P0123\":{\"source_handle\":\"P0123\",\"source_id\":\"source::P0123\",\"aliases\":[],\"title\":\"Non-Small Cell Lung Cancer Patients Treated with Anti-PD1 Immunotherapy Show Distinct 