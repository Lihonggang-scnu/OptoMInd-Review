31b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::07ae42b41e4955681f2cc681\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"体外T细胞培养 + TCR/CD28刺激\",\n          \"finding\": \"DAT直接增强TCR刺激下的CD8+ T细胞活化（IFNγ+和CD25+表达增加）及CD4+ T细胞向Th1分化（T-bet+）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a093daeeb0d505493c0b4dd2\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"体外DC培养 + LPS刺激\",\n          \"finding\": \"DAT仅在存在LPS（TLR4配体）共刺激时，才能促进DC表面共刺激分子CD80/CD86的表达成熟。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fc1e295c2ab5cc778e7db888\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"口服DAT干预7天\",\n          \"finding\": \"改变肠道菌群组成，降低α多样性，增加拟杆菌目（Bacteroidales）和伯克霍尔德菌目（Burkholderiales）的相对丰度，减少梭菌纲（Clostridia）丰度。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e27f805573a80b8a3f3788e3\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::52c892c3b6cd018eb8a2f462\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管肠道微生物群影响ICI疗效，但其具体分子机制尚不明确，且临床常因抗生素使用导致菌群失调从而降低免疫治疗效果。本研究试图确定特定的细菌代谢物DAT是否能作为一种可调控的手段，通过调节IFN-I信号来克服ICI治疗的个体差异和耐药性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::556ff9367c28f081086ed707\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"C57Bl/6j小鼠及Ifnar1-/-基因缺陷小鼠；恶性黑色素瘤（B16.OVA）和胰腺腺癌（Panc02）模型；肠道微生物群与宿主免疫系统的相互作用。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::646fbc28c59fc6ce0b38677d\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究旨在探讨细菌代谢物脱氨酪氨酸（DAT）作为I型干扰素（IFN-I）调节剂，能否增强实体瘤对免疫检查点抑制剂（ICI，如抗CTLA-4或抗PD-1）的治疗反应。研究通过口服补充DAT，在多种小鼠肿瘤模型中评估其抗肿瘤效果，并利用广谱抗生素诱导菌群失调模型模拟临床耐药情境，同时利用IFN-I信号缺失小鼠解析其分子机制。研究发现DAT能协同ICI增强T细胞活化，且该效应依赖于宿主IFN-I信号通路，并能部分逆转抗生素引起的治疗抵抗。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6838df479a72b9114a197ac7\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"引言部分引用了多项关于抗生素使用、菌群失调与ICI抵抗相关的临床研究及基础研究发现。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::423b87cb6e2ccf6e584bed2c\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"结果显示DAT不加重ICI诱导的结肠炎，反而可能减轻亚临床肠道炎症。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d09b8a9594eb1b512fbd4ae9\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制主要基于小鼠模型；体外DC成熟需要LPS共刺激，体内具体触发条件尚不完全清楚。\",\n          \"contribution\": \"揭示了DAT增强ICI疗效的分子机制依赖于宿主IFN-I信号通路（通过Ifnar1-/-小鼠验证），并展示了DAT在体外直接促进T细胞活化和DC成熟（需共刺激）的能力。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::970a4082112ed9c38f16ae1b\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"DAT并未恢复菌群多样性，仅改善了功能输出；效果不如在正常菌群小鼠中显著。\",\n          \"contribution\": \"证明了在广谱抗生素诱导的肠道菌群严重失调（模拟临床常见耐药情境）下，外源性补充DAT仍能部分恢复ICI（抗CTLA-4）的抗肿瘤疗效。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::59f2b3186a5ea5b50d9a0a4c\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"作者明确指出菌群变化的因果贡献尚不明确，可能是伴随现象。\",\n          \"contribution\": \"观察到DAT补充改变了肠道菌群结构（增加拟杆菌目等），并提示这种改变可能与有益反应相关，但未确立因果关系。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cc0d0b328bb17e240f824a5d\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"DAT的作用高度依赖于宿主IFN-I信号，若综述涉及其他信号通路（如AhR），需注意区分。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d18001bbef37cba34d6c9141\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"DAT在抗生素处理组的效果是“部分恢复”，而非完全逆转，不可夸大其作为菌群替代疗法的普适性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ce5a00e0b7ce348354618096\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"体外实验中DAT对DC的作用需要LPS共刺激，这暗示体内可能存在复杂的微生物-宿主互作背景，不能简单推断为DAT直接激活DC。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8c7f74cd0dd993cb2eacbc7d\",\n        \"source_handle\": \"P0195\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f4dd731b745b7c3e483c2547\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::020e47b4a6107b83e3368e3b\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7981205e813fc34e82ebdf2c\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8d63cceec4e933723074cf7e\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"研究设计分为三个主要部分：1. 生物信息学整合分析：收集5个公开ICB治疗研究的宏基因组数据，使用MMUPHin进行批次校正和功能通路定量，比较物种水平与通路水平的变异性，并计算基于健康参考群体的“功能性菌群失调”评分以评估其与临床响应的相关性。2. 纵向队列验证与关联分析：在独立的MMR-d/MSI-H前瞻性队列中，采集基线、治疗中和进展期的粪便样本进行宏基因组和代谢组测序，结合肿瘤转录组数据，分析特定代谢通路（MEP、核黄素合成）的动态变化及其与肿瘤浸润免疫细胞（Vδ2 T细胞、MAIT细胞）丰度的关联。3. 体外机制验证：收集能产生或不能产生HMBPP/5-OP-RU的细菌上清液，与PBMC及患者来源肿瘤类器官（PDTO）共培养，通过流式细胞术检测T细胞活化标志物（CD25, CD137）、细胞因子分泌（IFNγ, TNFα）及杀伤活性，并使用阻断抗体验证受体依赖性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d8452cd5677d3a95c634274f\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提出了以代谢通路而非物种为核心的微生物组分析框架，证明了功能谱的稳定性优于物种组成，为解决跨研究不一致性问题提供了新视角。\",\n          \"limits\": \"宏基因组数据仅反映功能潜力（基因存在与否），未直接测量基因表达或实际代谢物浓度（尽管结合了代谢组数据，但HMBPP因稳定性低难以直接检测，主要依赖间接证据）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::af8a28b5add7a55c9ec1c731\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"揭示了MEP通路-Vδ2 T细胞轴和核黄素合成通路-MAIT细胞轴作为微生物组调节ICB疗效的具体免疫机制，特别是强调了人类特有T细胞亚群的作用。\",\n          \"limits\": \"体外类器官实验虽使用了患者来源组织，但仍属于简化模型，未能完全模拟体内复杂的微环境及全身系统性免疫网络；不同肿瘤类型（如结直肠癌与非胃肠道肿瘤）的微生物背景差异可能影响通路的普遍适用性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8192f3205093c480c99dd82a\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"建立了功能性菌群失调评分作为预测ICB疗效的生物标志物，并验证了其在纵向监测中的动态变化价值。\",\n          \"limits\": \"功能性菌群失调评分的计算依赖于健康参考群体，对于非健康或非典型状态的解读可能存在偏差；因果关系的最终确立仍需临床试验干预验证。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::da46d716c70c6bd2a11c3e81\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"跨癌种ICB治疗患者队列（Microbe-ICB）\",\n          \"finding\": \"微生物代谢通路的功能谱比物种组成在个体间更保守；高程度的功能性菌群失调与非响应显著相关，且在非响应者治疗期间失调程度加剧。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::56b7494e3ac63fd5336cede7\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"MMR-d/MSI-H前瞻性纵向队列\",\n          \"finding\": \"MEP通路丰度在响应者中更高，并与较低的功能性菌群失调相关；核黄素合成通路在非响应者中随时间上调。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9edc6a56f4559f6669964526\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"PDTO与PBMC共培养体系\",\n          \"finding\": \"产HMBPP细菌的上清液通过BTN3A1/2/3受体特异性激活Vδ2 T细胞，增强其对肿瘤类器官的杀伤作用；核黄素前体5-OP-RU诱导MAIT细胞增殖并抑制CD4+ T细胞的增殖与活化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f605c5022d6c7fd992a64555\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"MMR-d/MSI-H队列生存分析\",\n          \"finding\": \"在高肿瘤内MAIT细胞丰度的患者中，高肠道核黄素水平与较差的无进展生存期（PFS）和总生存期（OS）显著相关。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8331764f7987194d4c701584\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::53ffe05b16b243d809bd1e7a\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"既往针对特定细菌物种与ICB疗效关联的研究结果缺乏一致性，且微生物组调节免疫的具体分子机制尚不清楚。本研究试图回答：是否可以通过更稳定的微生物代谢功能通路来预测ICB疗效？具体的代谢通路如何通过特定的免疫细胞亚群（如Vδ2 T细胞和MAIT细胞）影响抗肿瘤免疫反应？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c7739e35c44d1fdc5775445a\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"研究对象为接受免疫检查点阻断（ICB）治疗的实体瘤患者，涵盖黑色素瘤、肾细胞癌、非小细胞肺癌以及错配修复缺陷/微卫星高度不稳定（MMR-d/MSI-H）的晚期癌症。情境包括多中心公共队列整合分析与前瞻性独立验证队列（DRUP），重点考察肠道微生物组功能与抗肿瘤免疫反应及临床疗效之间的关联。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0998f4d3e9d8319917d7810f\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该研究旨在解决既往微生物组研究中物种组成不一致且机制不明的局限，转而关注微生物组的代谢功能输出对ICB疗效的指导作用。作者首先构建并整合了包含781个样本的多癌种ICB治疗患者宏基因组数据集（Microbe-ICB），证实相较于物种水平，代谢通路水平的功能谱在个体间更为保守和稳定。随后，通过计算“功能性菌群失调”评分，发现非响应者表现出更高的菌群功能失调，且这种失调在治疗期间进一步加剧。利用基因集富集分析（GSEA）和纵向队列验证，研究识别出两条关键代谢通路：促进ICB响应的甲基赤藓糖醇4-磷酸（MEP）通路，其产物HMBPP可激活Vδ2 T细胞介导的抗肿瘤活性；以及与耐药相关的核黄素合成通路，其产物5-OP-RU诱导MAIT细胞介导的免疫抑制。这些发现通过患者来源肿瘤类器官（PDTO）与免疫细胞的共培养实验得到了机制层面的验证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cb639fa62f35997738dca3da\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Microbe-ICB数据集构建流程、MMUPHin批次校正方法、DRUP队列的纵向采样设计。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::40ce62c2d6facb92a508b0b9\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"高核黄素+高MAIT细胞患者的较差生存结局（HR=0.103 for OS）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::64d3412604bbb378fa4ee2c5\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"讨论部分关于MEP通路激活剂（如双膦酸盐）的比较，以及对人源化模型必要性的论述。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::eff2c324f099469aba355172\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"该结论基于宏基因组推断的功能潜力，需结合代谢组数据佐证；不同肿瘤类型的基线失调程度存在差异（如结直肠癌较高）。\",\n          \"contribution\": \"提供了微生物组功能谱（代谢通路）比物种组成更稳定且更能预测ICB疗效的证据。指出功能性菌群失调程度与非响应正相关，且在治疗过程中恶化。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0e92dfc24b958435823b4b8a\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制验证主要在体外PDTO模型中进行，体内因果关系需结合临床队列中的相关性数据（如MAIT细胞丰度与核黄素水平的生存分析）谨慎外推。\",\n          \"contribution\": \"详细阐述了MEP通路产生HMBPP，通过BTN3A1/2/3受体激活Vδ2 T细胞，进而增强其对肿瘤细胞的杀伤作用这一促炎/抗肿瘤机制。同时阐述了核黄素合成产生5-OP-RU，激活MAIT细胞并抑制CD4+ T细胞增殖这一抗炎/抑制机制。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9acff39a4b1c1a9f04af1ee5\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"MEP通路和核黄素合成通路的发现主要基于MMR-d/MSI-H队列的验证，虽然Microbe-ICB包含多种癌种，但在推广至所有实体瘤时需考虑肿瘤特异性的免疫微环境差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::334d1ac0a37066e3f64b8cc6\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"HMBPP的直接检测受限于其化学不稳定性，因此Vδ2 T细胞的激活机制主要基于细菌上清液实验和受体阻断实验，属于间接证据链。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1c3b4a69891ab96af2e858b2\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"MAIT细胞的抑制作用是在体外共培养中观察到的，临床队列中仅观察到其与核黄素水平及不良预后的相关性，直接的因果抑制效应在体内尚未完全排除其他混杂因素。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::76b7187225f0ef809966b3b7\",\n        \"source_handle\": \"P0444\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"pdf\",\n              \"reason\": \"full-page text extracted; page positions retained\",\n              \"status\": \"fitz\"\n            },\n            {\n              \"kind\": \"fitz\",\n              \"reason\": \"layout, table relations, formulas, figure pixels, and scanned text may be lost\",\n              \"status\": \"known_gap\"\n            },\n            {\n              \"kind\": \"xml_text_cleanup\",\n              \"reason\": \"removed 85 XML 1.0 forbidden characters from derived PDF text; original PDF and page positions retained\",\n              \"status\": \"normalized\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::623b881452a1bbc406a2e4b5\",\n          \"snapshot::a6fc0ba0bd562126f2100785\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ae973353d2034b0bcf3ade2c\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f3e90e423eb47f61619944e1\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::08f23a1df0b5315a8d339b75\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"1. **模型构建**：使用软光刻技术制备PDMS微流控芯片，包含上皮通道和内皮通道，中间由胶原基质隔开。上皮侧接种Caco-2/HT-29 MTX共培养物或hiPSC来源肠类器官，内皮侧接种HMEC-1细胞。通过气动装置施加周期性变形（0.2 Hz, 10-15%应变）以模拟蠕动。2. **样本处理**：收集黑色素瘤ICI响应者（R）和非响应者（NR）的新鲜冷冻粪便，制备全粪便悬液及离心后的上清液（含可溶性因子），分别作用于成熟芯片。3. **多组学与表型分析**：进行RNA测序以鉴定差异表达基因（DEGs）和通路富集；使用免疫荧光显微镜量化紧密连接蛋白（ZO-1, E-cadherin）、增殖标记（Ki67）及凋亡标记（Caspase-3）；通过葡聚糖渗透实验评估屏障通透性；使用多重ELISA检测分泌的炎症因子（IL-6, CXCL8等）。4. **机制验证**：使用大肠杆菌LPS和沙门氏菌鞭毛蛋白进行对照实验，验证特定微生物成分的作用；比较芯片数据与公开的小鼠无菌/常规饲养模型转录组数据以验证生理相关性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5278894a90356b78cc42a7ff\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了一个具有蠕动功能的人源化肠-on-a-chip模型，能够区分黑色素瘤患者ICI治疗响应与非响应的微生物功能特征，并揭示了LPS和鞭毛蛋白在其中的关键作用。\",\n          \"limits\": \"所给摘要未交代长期厌氧培养的稳定性数据；模型尚未整合免疫系统细胞（仅用内皮细胞代表血管界面）；样本量较小（NR n=6, R n=4等），结果需在更大队列中验证；未能完全复现体内复杂的全身免疫调节网络。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8618cf2ef9f8bc59c30802d7\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"芯片暴露于非响应者（NR）粪便全样或上清\",\n          \"finding\": \"上皮细胞紧密连接蛋白ZO-1和β-catenin显著下调，屏障通透性增加；内皮细胞ICAM-1上调，T细胞粘附增加；转录组显示应激缓冲能力下降、细胞周期抑制及促炎通路（TNF, IL-6, NF-κB）激活。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ce7e4b4ee45d99bf6a37319d\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"芯片暴露于响应者（R）粪便全样或上清\",\n          \"finding\": \"未引起显著的屏障破坏；转录组显示TLR-5信号通路激活，伴随IL-1β和IL-10水平升高；metagenomic分析显示鞭毛蛋白相关基因富集。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6991b58ceea386b8806828b9\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"芯片暴露于大肠杆菌LPS\",\n          \"finding\": \"重现了NR粪便引起的屏障破坏和炎症反应；不同来源LPS表现出结构依赖性效应。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1c66f25ccc55a68d0bdd5ead\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"联合治疗：NR粪便/LPS + R粪便上清或纯化鞭毛蛋白\",\n          \"finding\": \"R粪便上清或鞭毛蛋白能显著恢复被NR粪便或LPS破坏的屏障完整性（ZO-1/E-cadherin回升），并降低炎症因子水平。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1490e8eca8533a692aecd1ae\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ab4bed1f13396d1c62024f70\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"现有小鼠模型在解剖、功能和微生物组成上与人类存在巨大差异，且传统2D/3D培养无法提供受控的机械刺激和实时多组学检测，导致难以准确解析肠道微生物群如何具体影响人类对免疫检查点抑制剂（ICI）的治疗响应。本研究旨在解决这一转化医学瓶颈，建立一个能模拟人类肠道生理环境并预测个体治疗响应的体外平台。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7442dab618d6a8de26be7bda\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"人类黑色素瘤患者肠道微生物群与宿主上皮/内皮细胞的相互作用；免疫检查点抑制剂（ICI）治疗响应与非响应的预测机制。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7b006583e2f2389476439eee\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究开发了一种集成人体微血管内皮细胞和诱导多能干细胞（hiPSC）来源肠类器官的微流控“肠-on-a-chip”模型，该模型通过胶原基质分隔两个通道，并具备模拟蠕动样机械运动的能力。研究利用该模型处理来自黑色素瘤ICI响应者和非响应者的粪便样本，结合转录组学、代谢组学和显微成像分析，发现非响应者粪便中的微生物群会导致肠道上皮屏障完整性显著受损（ZO-1和β-catenin下调），并引发强烈的促炎反应（如IL-6、TNF信号激活）。相比之下，响应者粪便中的可溶性因子（富含鞭毛蛋白相关基因）能激活TLR-5信号并促进IL-1β释放，有助于维持屏障稳态。此外，研究证实非响应者粪便中脂多糖（LPS）合成基因富集，其效应可通过外源LPS处理重现，而响应者粪便提取物或纯化的鞭毛蛋白可部分逆转这种损伤。该模型成功复现了体内观察到的微生物-宿主互作特征，并能区分不同临床结局患者的微生物功能差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5425229f80fc2befab4ca65d\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"开发了集成蠕动功能的hiPSC/Caco-2肠-on-a-chip模型，并与小鼠模型转录组数据进行比对验证。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c50109fea10e7f9b5b38344a\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"识别出与临床响应相关的上皮特异性生物标志物（如ZO-1, β-catenin表达变化）和微生物因子（LPS合成基因, 鞭毛蛋白基因）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::07b5fe4d46eaebab11fea98f\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"基于黑色素瘤单病种；体外模型结果不能直接等同于体内全身疗效，但提供了机制层面的关联证据。\",\n          \"contribution\": \"提供了肠道微生物群影响ICI疗效的功能性证据：非响应者微生物群导致肠道屏障破坏和促炎状态，而响应者微生物群维持屏障稳态并诱导抗炎/修复信号。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::802c1f884941ed0c8457b5de\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制主要在肠道局部上皮/内皮层面观察到；未涉及系统性免疫细胞（如T细胞）的具体调控细节，仅通过T细胞粘附实验间接提示内皮活化。\",\n          \"contribution\": \"阐明了介导效应的具体分子机制：非响应者粪便中高丰度的LPS合成基因及其引发的TLR/NF-κB炎症通路和屏障损伤；响应者粪便中鞭毛蛋白相关基因激活TLR-5及IL-1β/IL-10通路，有助于缓解炎症。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b30b00ce79159478516d4ce2\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究使用的是黑色素瘤患者队列，结论外推至其他实体瘤需谨慎，尽管机制可能具有普遍性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::643c6ec357b9497fd0ce6256\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者声称模型“预测”响应，但这主要基于体外表型与临床状态的关联，而非前瞻性临床试验验证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::306388750b6d8f8f1589045a\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"LPS和鞭毛蛋白的作用是在特定浓度下验证的，体内实际浓度和时空分布可能更为复杂。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::822ff3f0efd06bcfa346d79e\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"响应者粪便中IL-1β升高通常与炎症相关，但此处与屏障保护相关联，提示其在特定语境下的双重作用，解读时需结合TLR-5背景。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::70962dec6d690325893cccf3\",\n        \"source_handle\": \"P0073\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::88fdcddfb109d931e6ee0b88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2620179246640ac636d56bd9\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b79fd70d6332212f4813f1df\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::14e691e33244b8717f4d127f\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"The research design involves three main components: 1) Clinical Cohort Analysis: Retrospective and prospective analysis of three independent cohorts (melanoma and NSCLC) to assess the association between irAE grades and survival outcomes, correcting for immortal time bias. 2) Microbiome Profiling: Shotgun metagenomics and high-throughput culturomics were performed on fecal samples from patients at baseline and at the onset of ir-colitis to characterize taxonomic shifts and isolate viable bacteria. 3) Functional Validation: Fecal microbiota transplantation (FMT) from ir-colitis patients into antibiotic-treated mice to assess effects on tumor growth and inflammation. Specific isolates (P. bifermentans, C. paraputrificum, P. sordellii) were tested in vitro (Caco-2 co-culture for barrier integrity and cytokine expression) and in vivo (oral gavage in DSS colitis and MCA-205 tumor models) to determine direct effects. Cell-free supernatants and heat-killed bacteria were also tested to distinguish live-bacteria-dependent effects from metabolite-mediated effects.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7338e32444ea409cd35d5626\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides empirical evidence linking specific gut bacteria (P. bifermentans) to both irAE pathogenesis and enhanced ICI efficacy through distinct mechanisms (barrier disruption vs. metabolite secretion).\",\n          \"limits\": \"The exact nature of the active < 3 kDa metabolite and its precise immune mechanism remain unidentified. The study relies on a limited number of matched longitudinal samples and mouse models that may not fully recapitulate human ir-colitis complexity.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ad228a9a09cf1bde833cd70d\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Three independent cohorts of melanoma and NSCLC patients treated with ICI\",\n          \"finding\": \"Grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f0f8a256e3b6de3f1f5a7dfd\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Baseline stool samples from melanoma patients analyzed via shotgun metagenomics\",\n          \"finding\": \"Patients developing grade ≥ 2 irAEs exhibited lower alpha diversity and enrichment of pro-inflammatory taxa including Ruminococcus gnavus and Streptococcus vestibularis compared to those without irAEs.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::69d42911848667bdf02843e3\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Stool samples from patients with ir-colitis analyzed via culturomics\",\n          \"finding\": \"Paraclostridium bifermentans was isolated and found to be enriched in patients with acute ir-colitis compared to baseline or non-ir-colitis controls.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4d3393b35296f0c4133f8239\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In vivo mouse models receiving FMT from ir-colitis patients\",\n          \"finding\": \"FMT induced surrogate markers of intestinal inflammation (increased Lcn-2 and LPS) and enhanced the anti-tumor efficacy of dual anti-PD-1/CTLA-4 therapy.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e7e6394717aa4609a837b993\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In vitro Caco-2 monolayer co-culture with P. bifermentans\",\n          \"finding\": \"Live P. bifermentans disrupted epithelial barrier integrity (reduced ZO-1 and Occludin signals) and increased pro-inflammatory cytokines (TNF-α and IL-1β); this effect was not observed with cell-free supernatant.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bd05dd22bf395b6bb6a493e0\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In vivo murine tumor model with oral gavage of P. bifermentans derivatives\",\n          \"finding\": \"Oral administration of P. bifermentans enhanced anti-tumor response to dual ICI; this beneficial effect was retained by cell-free supernatant filtered to < 3 kDa, indicating mediation by a small-molecule metabolite rather than live bacteria.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::894d9adbbc30a71c986943d3\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::de73fe9ade530a582fbcc4a4\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"The study aims to resolve the mechanism underlying the observed correlation between irAEs and improved ICI efficacy. Specifically, it seeks to determine if specific gut microbial signatures predict irAEs and efficacy, and to identify causal bacterial agents that might drive both inflammation and anti-tumor responses.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::70fc3918076487e962a70529\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"The study focuses on patients with advanced melanoma and non-small cell lung cancer (NSCLC) treated with immune checkpoint inhibitors (ICI). It investigates the relationship between gut microbiome composition, the development of immune-related adverse events (irAEs), and clinical outcomes (overall survival and progression-free survival). The research combines clinical cohort analysis with shotgun metagenomics and culturomics to identify specific bacterial taxa and their functional roles.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ae76f027dd241b7100eeee0\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This study addresses the paradoxical link between immune-related adverse events (irAEs) and improved efficacy in ICI therapy by dissecting the role of the gut microbiome. Using three independent cohorts totaling 589 patients with melanoma or NSCLC, the authors first validated that grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias. They then employed a combined approach of shotgun metagenomics and culturomics on fecal samples collected at baseline and during ir-colitis onset. Metagenomic analysis revealed that patients developing irAEs had lower alpha diversity and enrichment of pro-inflammatory taxa such as Ruminococcus gnavus and Streptococcus vestibularis. Culturomics identified Paraclostridium bifermentans as enriched in patients with acute ir-colitis. Functional validation in mice demonstrated that fecal microbiota transplantation from an ir-colitis patient induced subclinical colitis markers and enhanced anti-tumor activity of dual ICI. Specifically, P. bifermentans was shown to disrupt epithelial barrier integrity in vitro and exacerbate colitis in vivo via live bacteria interaction, while its anti-tumor benefit was mediated by a secreted low-molecular-weight metabolite (< 3 kDa). These findings provide a mechanistic link suggesting that specific pro-inflammatory bacteria can simultaneously drive toxicity and enhance therapeutic efficacy.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3aba09de1928023c017e60a8\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Comparison of metagenomics and culturomics results showing that culturomics recovers live, low-abundance bacteria (like P. bifermentans) missed or less characterized by sequencing alone.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::68b54a3451f1ab3d7966a2e1\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Discussion of immortal time bias in analyzing irAE-survival associations and the correction applied in this study.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e80331c46c052c7581ada8d5\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"The association is observational; causality is inferred through subsequent mechanistic studies but not proven in the clinical cohort alone. Results may vary by cancer type and geography.\",\n          \"contribution\": \"Validates the clinical association between irAEs and improved ICI outcomes across multiple solid tumor cohorts (melanoma and NSCLC), confirming that higher-grade irAEs correlate with longer OS and PFS. Identifies specific microbial signatures (e.g., S. vestibularis, H. porci) associated with both irAE and response states.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f5b77f6f89c89b517fbf6126\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"The mechanism is derived from mouse models and in vitro assays; the exact metabolite identity is unknown. The effect of live bacteria on barrier integrity is distinct from the metabolite's effect on tumor response, highlighting complex, context-dependent interactions.\",\n          \"contribution\": \"Demonstrates a specific mechanism where Paraclostridium bifermentans enhances ICI efficacy via a secreted low-molecular-weight metabolite (< 3 kDa), while simultaneously causing ir-colitis through live-bacteria-induced epithelial barrier disruption. Shows that FMT from ir-colitis patients transfers both inflammatory potential and enhanced ICI response.\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9964b8d843b952c18995daf5\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The study identifies P. bifermentans as a key player, but the exact metabolite responsible for the anti-tumor effect is not characterized; do not overstate the specificity of the molecular mechanism.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1482d971688f8c6a45f4eb09\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Mouse models used (MCA-205, DSS) have limitations in fully recapitulating human ir-colitis; results should be framed as preclinical evidence supporting human observations.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c16c42850044684ec971f685\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The 'dual role' of P. bifermentans involves two different mechanisms (live bacteria for toxicity, metabolite for efficacy); ensure this distinction is clear when citing.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cafb8802dcc1f5812d97e5ec\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Clinical associations are based on retrospective/prospective cohorts with potential confounders; causality is established primarily through animal models, not clinical intervention.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6bf40b4009f92b8ad4a0426c\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-7974b6c4dd5220685baa\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-95bd9a77b14edf06222c\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5c752c0f8036d5742e42\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-a7194a689f46f19f0fc9\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5f82ba52a99d38e52a55\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementaryFiles_fetch_body_too_large\",\n              \"status\": \"missing\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c45acdd0c823a32e17dc0501\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c7fd3e5ec5421a4851a7d812\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::988c6329a74ed0e48433dd73\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用临床前黑色素瘤小鼠模型（C57BL/6J, B16-F10）。主要方法包括：1. 细菌培养与16S rRNA测序分析不同组织（MLN, TDLN, 脾脏, 肿瘤）中的微生物组成和丰度随时间的变化；2. 利用流式细胞术检测DC表面活化标志物及CD8+ T细胞的功能表型；3. 使用基因工程小鼠（CD11c-DTR敲除DC，LTA KO缺乏次级淋巴器官，Ccr7-/-）验证DC和CCR7在细菌转移中的作用；4. 手术切除特定淋巴器官评估其对ICT疗效的影响；5. 组织化学染色观察MLN的结构重塑；6. 抗生素预处理或益生菌回补实验验证因果关系。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ed95b626d58de048e18a282\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"揭示了ICT诱导肠道细菌向次级淋巴器官转移的新机制，明确了DC和MLN在这一过程中的核心作用，解释了肠道微生物如何影响肠外肿瘤免疫。\",\n          \"limits\": \"研究仅在黑色素瘤小鼠模型中进行，结果是否适用于其他实体瘤类型尚不明确；联合ICT方案可能比单药治疗引起更显著的副作用和微生物变化，单一药物的效果未单独评估。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dcfe5e5c896a59037ad17c70\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"接受ICT治疗的黑色素瘤小鼠\",\n          \"finding\": \"ICT显著诱导特定肠道细菌（如Enterococcus faecalis, Lactobacillus johnsonii）从肠道转移至MLN、TDLN和肿瘤中，且这种转移不依赖于全身肠道屏障通透性的增加。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e4dcc352c756761b8a61df27\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"DC耗竭或CCR7缺失小鼠\",\n          \"finding\": \"DC的缺失或CCR7信号通路的阻断显著抑制了ICT诱导的细菌向MLN和TDLN的转移，表明DC介导的细菌转运是CCR7依赖性的。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2b772fa4e6379ea2c64e160c\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"MLN切除术\",\n          \"finding\": \"切除MLN导致TDLN和肿瘤中的细菌负荷降低，并显著减弱ICT诱导的CD8+ T细胞活化和抗肿瘤疗效，证明MLN在介导肠外免疫反应中的关键枢纽作用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7c8f04eb550557ff4eec973f\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"ICT治疗组 vs 对照组\",\n          \"finding\": \"ICT诱导MLN发生结构重塑，表现为高内皮微静脉（HEV）扩张和淋巴管生成增加，这可能促进了细菌从MLN向远端组织的扩散。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0026c979f4115c02558912ab\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"抗生素预处理\",\n          \"finding\": \"抗生素清除肠道菌群后，细菌转移减少，DC活化及多能性CD8+ T细胞反应降低，ICT疗效显著减弱；而补充具有转移能力的特定菌株（E. faecalis, E. coli）可部分恢复疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c9157c61680949278a6f46a6\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c1405734ac3fa39d7e68fa0e\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管已知肠道微生物群影响癌症免疫治疗反应，但其促进肠外抗肿瘤免疫的具体机制尚不清楚。特别是肠道细菌如何到达远端肿瘤部位并发挥作用，以及ICT在此过程中扮演的角色。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::658f0d3bcb535876bc8666e1\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"本研究以B16-F10皮下黑色素瘤小鼠模型为对象，研究免疫检查点阻断疗法（ICT，联合抗PD-1和抗CTLA-4抗体）对肠道微生物群向次级淋巴器官及肿瘤转移的影响及其介导的抗肿瘤免疫机制。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::43cf72be18d2f4c656a12284\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该研究旨在阐明肠道微生物如何促进远端（肠外）肿瘤的免疫治疗反应。作者发现ICT治疗会诱导特定的内源性肠道细菌转移到肠系膜淋巴结（MLN）、肿瘤引流淋巴结（TDLN）和肿瘤组织中。机制上，ICT通过诱导肠道炎症激活树突状细胞（DCs），DCs依赖CCR7将细菌转运至MLN；同时ICT引起MLN重塑（淋巴管生成和高内皮微静脉扩张），这有助于细菌突破“黏膜防火墙”扩散至远端组织。这些转移的细菌（如粪肠球菌、约氏乳杆菌等）进一步激活DC并促进效应CD8+ T细胞的产生，从而增强ICT疗效。抗生素处理可阻断这一过程并削弱ICT效果。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9c4028d7b43409e6bbc020c4\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"论文讨论了分子模拟、代谢产物等其他机制，并将本研究的转移机制置于更广泛的微生物-免疫互作背景下。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f592b8502fe014b1c0ed734b\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"论文提到人类黑色素瘤肿瘤中也检测到类似的转移菌种（Enterococcaceae, Lactobacillaceae）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::342e020bce877352054c67be\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限于黑色素瘤模型；未涉及其他免疫检查点抑制剂（如LAG-3）或不同给药途径的效果。\",\n          \"contribution\": \"详细阐述了肠道细菌通过DC摄取并迁移至MLN，进而通过MLN重塑扩散至TDLN和肿瘤的机制路径。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b5dd6e8c5547a883130fa0bf\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅针对联合抗PD-1/CTLA-4治疗；未区分单药治疗的差异。\",\n          \"contribution\": \"证明了肠道细菌的存在和转移是ICT疗效的必要条件（通过抗生素耗竭实验证实），且特定转移菌种（如E. faecalis）的回补可恢复疗效。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::211d66f0682eaee4a689e3ec\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究基于小鼠黑色素瘤模型，不能直接外推至所有实体瘤或人类患者。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e04025bfbdfc8958302a88ee\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"使用的ICT为联合疗法（Anti-PD-1 + Anti-CTLA-4），其引发的免疫反应强度和微生物变化可能与单药治疗不同。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::30034f5131ab894e586d236e\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"细菌转移的发现依赖于特定的检测手段（培养和测序），不同检测方法可能揭示不同的菌群动态。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c645fffb6b0b5f9e42c6d11e\",\n        \"source_handle\": \"P0166\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-4dcc7c19ae5301df5638\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-d48cd64bd12b302ad2ba\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-76a4a344a1a9861e53c5\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-127581c4c944b94d4ce9\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-2fe067d7e5a8cb6b9923\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-888f684088266d233e12\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"missing\": [\n                \"nihms-1887590-f0001.jpg\",\n                \"nihms-1887590-f0001.gif\",\n                \"nihms-1887590-f0002.jpg\",\n                \"nihms-1887590-f0002.gif\",\n                \"nihms-1887590-f0003.jpg\",\n                \"nihms-1887590-f0003.gif\",\n                \"nihms-1887590-f0004.jpg\",\n                \"nihms-1887590-f0004.gif\",\n                \"nihms-1887590-f0005.jpg\",\n                \"nihms-1887590-f0005.gif\",\n                \"nihms-1887590-f0006.jpg\",\n                \"nihms-1887590-f0006.gif\",\n                \"NIHMS1887590-supplement-data_file_S1.xlsx\",\n                \"NIHMS1887590-supplement-reproducibility_checklist.docx\",\n                \"NIHMS1887590-supplement-main_supplementary_materials.pdf\",\n                \"NIHMS1887590-supplement-data_file_S1.xlsx\",\n                \"NIHMS1887590-supplement-reproducibility_checklist.docx\",\n                \"NIHMS1887590-supplement-main_supplementary_materials.pdf\"\n              ],\n              \"reason\": \"graphic_members_unmatched\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementary_bundle_had_no_safe_matching_images\",\n              \"status\": \"unparsed\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7183fab48388d36a56b62d98\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3ff94cba055cd39ce0ba970b\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3f174df26d5b3ded3ad79b66\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b942783511a888c80cb58426\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用叙事性综述方法，系统梳理关于肠道微生物组与PDAC免疫反应关系的现有文献。分析路线包括：1) 阐述肠道微生物组与宿主免疫系统的一般关系；2) 总结肠道微生物组对PDAC全身适应性免疫（如T细胞亚群、细胞因子）的影响；3) 探讨肠道微生物组如何通过细菌易位影响肿瘤内微生物组，进而调节肿瘤微环境中的免疫细胞浸润（特别是T细胞和巨噬细胞）；4) 评估肠道微生物组对PDAC免疫检查点抑制剂和化疗疗效的影响；5) 讨论未来研究方向，包括人体研究的必要性及干预策略（如FMT、益生菌）。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2bde1d5fb767edcd42ee38b1\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"综合阐述了肠道微生物组通过全身（Th17/IL-17轴）和局部（肿瘤内微生物组、巨噬细胞极化、PRR信号）双重途径调节PDAC免疫微环境的机制框架。\",\n          \"limits\": \"主要证据来源于动物模型和小鼠实验，人体临床数据相对有限，尤其是关于具体菌株与免疫治疗响应的人体直接关联证据尚不充分。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::43e003d059c2f3f1c354e64f\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"指出了肠道微生物组可能通过代谢产物（如短链脂肪酸、吲哚-3-乙酸）和细菌易位影响PDAC进展和治疗反应的具体路径。\",\n          \"limits\": \"许多机制细节（如特定细菌-宿主互作的分子靶点）仍基于假设或初步研究，尚未在大规模人体队列中得到验证。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f9986f4f0121ee6312149847\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提出了针对肠道微生物组的干预策略（如FMT、下一代益生菌、酶替代疗法）作为增强PDAC免疫治疗和化疗疗效的潜在方向。\",\n          \"limits\": \"这些干预策略在PDAC患者中的安全性和有效性仍需前瞻性临床试验证实，且存在个体差异和标准化难题。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2e91e7d8fb9075046c27d99a\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"小鼠模型中抗生素清除肠道菌群\",\n          \"finding\": \"减缓PDAC肿瘤生长，增加肿瘤内CD8+ T细胞浸润，减少髓源性抑制细胞（MDSCs），提高Th1:Th2比值，降低Th17细胞比例。该效应依赖于T细胞和IL-17的存在。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9c7ee4bbafa9c614f78986bf\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"PDAC小鼠模型的粪便移植实验\",\n          \"finding\": \"将PDAC易感小鼠（KPC）的粪便移植给无菌或抗生素处理的小鼠，可加速肿瘤生长并减少T细胞浸润；而野生型小鼠的粪便则无此加速作用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b3f7e3489be626c86f9a7292\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"体外及体内巨噬细胞实验\",\n          \"finding\": \"暴露于PDAC患者/小鼠肠道菌群的巨噬细胞表现出抑制T细胞活化的能力，并通过TLR信号通路诱导免疫耐受。清除肠道菌群后，肿瘤相关巨噬细胞（TAMs）向促炎的M1样表型转化，增强T细胞激活。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b4dc3f1932b309e2ae162e49\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"人类黑色素瘤患者及小鼠模型\",\n          \"finding\": \"对抗PD-1免疫治疗有反应的患者的肠道微生物组具有更高的Alpha多样性，且富集Bifidobacterium longum、Akkermansia muciniphila等特定菌种。FMT从 responder 到小鼠模型可轻微增强抗PD-1疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dca2d7aaf2f41b9840aa72d0\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"PDAC小鼠模型联合治疗\",\n          \"finding\": \"抗生素预处理联合抗PD-1治疗显示出协同抗肿瘤效果，上调CXCR3和LFA1表达，而单独使用抗PD-1无效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::680c382c9ed585bea43b0110\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8b5862cb9d925c92bff35c90\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"PDAC表现出严重的局部和全身免疫抑制，导致其难以治疗且预后差。目前缺乏对肠道微生物组如何介导这种免疫逃逸机制的全面理解。本研究试图梳理现有文献，明确肠道微生物组在PDAC免疫调节中的具体作用路径及其对临床治疗的潜在意义。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bcbdac122f2782fca98cdfe8\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"胰腺导管腺癌（PDAC）患者及小鼠模型中的肠道微生物组、肿瘤微环境免疫浸润及全身免疫反应。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9b48ec5722048d029d69dd91\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇综述，旨在阐明肠道微生物组如何调节胰腺导管腺癌（PDAC）的局部和全身免疫反应。文章指出PDAC具有强烈的免疫抑制特性，而肠道微生物组作为最大的免疫器官，通过影响外周血免疫细胞群和肿瘤内微生物组成，进而改变肿瘤微环境中的免疫浸润。研究重点在于揭示这一过程中的具体机制，包括Th17/IL-17通路、巨噬细胞极化、模式识别受体（PRRs）信号传导以及细菌易位等，并探讨了这些机制对PDAC化疗和免疫治疗疗效的影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ef29520b3947ee99c760c52e\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"PDAC的侵袭性、免疫逃逸特性及其对预后的影响。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d4807aa9b8e011ed21610846\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"细菌易位的潜在途径（门静脉循环、肠系膜淋巴结、胆道系统）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ce6c189ad4ac746335a57779\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"诊断和治疗过程中可能改变肠道微生物组的临床因素。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a3c7dac3cc503addf493e45b\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"PDAC部分的直接证据多来自小鼠模型（抗生素+ICI协同），人体数据较少。黑色素瘤的数据不能直接外推至PDAC，但提供了潜在的菌种参考。\",\n          \"contribution\": \"提供了肠道微生物组影响PDAC对免疫治疗（特别是抗PD-1）疗效的证据。指出PDAC本身对单药ICI反应不佳，但抗生素清除肠道菌群或与ICI联用可增强疗效。同时引用了黑色素瘤中特定菌种（如Akkermansia, Bifidobacterium）与ICI响应相关的阳性结果，提示PDAC中可能存在类似机制。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f1117f6e4fabd83614ff0aff\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制研究主要基于小鼠模型和体外细胞实验。人体中具体的细菌-巨噬细胞互作细节尚不明确。\",\n          \"contribution\": \"详细描述了介导微生物组影响免疫反应的三大机制：1) 全身性：通过Th17/IL-17轴调节外周免疫细胞；2) 局部性：通过细菌易位形成肿瘤内微生物组，激活PRRs（如TLR9），诱导巨噬细胞（TAMs）向免疫抑制表型转化，从而抑制T细胞活化；3) 代谢性：通过SCFAs等代谢产物调节炎症。特别强调了巨噬细胞在其中的核心枢纽作用。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b62ea299f8c1fd9a09aeaa76\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要针对化疗，与ICIs的直接联系较弱，但有助于全面理解微生物组在治疗反应中的作用。\",\n          \"contribution\": \"揭示了肠道微生物组对化疗药物（如吉西他滨）代谢的影响，指出肿瘤内驻留细菌可将吉西他滨失活，而抗生素预处理可提高化疗敏感性。这提供了微生物组影响治疗反应的非免疫机制补充。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::346601a66f244afe0eeca05b\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"本文主要聚焦于PDAC，虽然引用了黑色素瘤等其他癌症的数据来佐证微生物组对ICI疗效的普遍影响，但在应用于其他实体瘤时需保持谨慎，因为不同肿瘤的免疫微环境和微生物定植情况差异巨大。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e00c473049f21132b7c06f8e\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中大量机制证据来自小鼠模型（如KPC小鼠、抗生素处理小鼠），人体内的实际效应大小、特异性菌种及安全性可能与动物模型存在显著差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4de30df2b2a3d5a90bd35e7e\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者提出的‘靶向肠道微生物组’作为治疗策略目前仍处于理论探索和早期试验阶段，尚未成为标准临床实践，阅读时应区分‘潜在机会’与‘既定事实’。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7431736349c8d49269936edc\",\n        \"source_handle\": \"P0084\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d7781dfd33d8f7ba8a885511\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4e34a21752156539be21ce58\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c207d277c75220094cef6dfc\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c9cdcdb71ae9c7c5000cccd6\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"The authors conducted a narrative literature review. They systematically summarized existing preclinical and clinical studies regarding the composition of the gut microbiome in GIC patients versus healthy controls. The review categorizes findings by cancer type (GC, CRC, PDAC) and then by treatment modality (chemotherapy, immunotherapy, radiotherapy). It integrates mechanistic insights from molecular biology (e.g., signaling pathways like PI3K/Akt, STAT3) with clinical observations of treatment response variability. No new primary data or systematic meta-analysis was performed; rather, the work involves synthesizing and interpreting previously published evidence.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::439514af95b700a324aee891\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a comprehensive synthesis of the dual role of gut microbiota in GIC carcinogenesis and treatment modulation, linking specific bacterial species to molecular mechanisms and clinical outcomes across multiple cancer types.\",\n          \"limits\": \"As a narrative review, it does not present original experimental data or a quantitative meta-analysis. The causal relationships described are largely based on correlational clinical studies and preclinical models, which may not fully translate to human clinical settings. Individual variability in microbiome composition is acknowledged but not quantitatively modeled.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dd9d46eef1457d823484fea9\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Gastric Cancer (GC)\",\n          \"finding\": \"Helicobacter pylori infection drives GC via chronic inflammation and virulence factors (CagA, VacA) activating pathways like PI3K/Akt, MAPK, and JAK/STAT. Non-H. pylori bacteria also contribute via N-nitroso compound production.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b8f05ea3fcb52197a3e32bc1\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Colorectal Cancer (CRC)\",\n          \"finding\": \"Dysbiosis characterized by reduced diversity and increased pathogenic taxa (Fusobacterium nucleatum, Bacteroides fragilis). BFT toxin promotes carcinogenesis via E-cadherin degradation and β-catenin signaling. F. nucleatum is linked to chemoresistance and metastasis.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::09592f9c99d9ad7bef1f1d80\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Pancreatic Cancer (PDAC)\",\n          \"finding\": \"PDAC patients exhibit distinct dysbiosis with decreased probiotics and increased pathogens. Intracellular persistence of Porphyromonas gingivalis in hypoxic TME is associated with malignant cell proliferation.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f6bf3a91ddc6787dbe5c5022\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Chemotherapy Response\",\n          \"finding\": \"Microbiota influences drug pharmacokinetics and toxicity. Specific bacteria can induce resistance (e.g., Gammaproteobacteria inducing gemcitabine resistance) or enhance efficacy (e.g., Barnesiella intestinihominis enhancing cyclophosphamide effects via T-cell infiltration).\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3628d13b5b0db4f2a7fb882c\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Immunotherapy Response\",\n          \"finding\": \"Gut microbiota composition affects the efficacy of immune checkpoint inhibitors (ICIs). Certain microbial profiles are associated with favorable responses to ICIs, while dysbiosis correlates with reduced efficacy. Microbial metabolites (SCFAs, bile acids) regulate immune cell function.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e7d3777c39640e847d000cad\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Radiotherapy Response\",\n          \"finding\": \"Specific probiotics (Lactobacillus, Bifidobacterium) can mitigate radiation-induced tissue injury and enhance antitumor immune responses, potentially allowing for lower radiation doses.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e8b13b8d2820151e69cdb610\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::21103ce9a86249968effcb06\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"To understand the role of the gut microbiota in the development of gastrointestinal cancers and its impact on the efficacy and resistance to various anticancer treatments (chemotherapy, immunotherapy, radiotherapy), aiming to identify potential strategies for improving therapeutic outcomes.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d21b90b6662007537c6df126\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"Gastrointestinal cancers (GICs), specifically gastric cancer (GC), colorectal cancer (CRC), and pancreatic ductal adenocarcinoma (PDAC). The scope includes the role of gut microbiota in carcinogenesis, treatment response, and resistance mechanisms across chemotherapy, immunotherapy, and radiotherapy.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::daea7a40660431fd50b17c88\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This review article examines the complex interactions between the human gastrointestinal microbiota and the efficacy of anti-cancer treatments for GICs. It synthesizes current knowledge on how specific microbial communities and their metabolites influence tumor initiation, progression, and therapeutic outcomes. The paper details molecular mechanisms by which bacteria like Helicobacter pylori, Bacteroides fragilis, and Fusobacterium nucleatum drive oncogenesis through inflammation and signaling pathways. Furthermore, it discusses how the microbiome modulates the effectiveness of chemotherapy, immunotherapy (particularly immune checkpoint inhibitors), and radiotherapy, highlighting both beneficial and detrimental effects on drug metabolism, immune activation, and toxicity. The authors conclude that understanding these interactions is crucial for developing personalized microbiome-targeted therapies to overcome treatment resistance.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f870e3daf299b5ff4e4cf50a\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Overview of incidence, mortality, and standard therapies (surgery, chemo, radiation) for GC, CRC, and PDAC.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::83c1399ef7f9791d13fa625b\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Discussion on irinotecan-induced mucositis, gemcitabine resistance via Gammaproteobacteria, and cyclophosphamide enhancement via Barnesiella.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6017023c2582b17268c6853b\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Mentions of using prebiotics, probiotics, and fecal microbiota transplantation (FMT) to modulate microbiota and improve treatment outcomes.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::032bf1216bdcd21e30041ecf\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Does not provide specific statistical effect sizes or hazard ratios for ICI response based on microbiome status. The association is described qualitatively. Specific bacterial strains linked to *positive* ICI response are mentioned generally (e.g., Bifidobacterium, Lactobacillus for radiotherapy, but less specific for ICIs compared to other reviews), though it notes 'specific communities' are beneficial.\",\n          \"contribution\": \"Identifies that specific gut microbial communities are associated with favorable responses to ICIs, while dysbiosis correlates with reduced efficacy. Mentions that microbiota influences systemic inflammation and immune cell function, which determines ICI success.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::24038f680de80afec539f625\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Many mechanistic details are derived from preclinical models (mouse models, organoids) or specific bacterial infections (H. pylori, B. fragilis) rather than direct ICI intervention studies in humans. The link between these specific inflammatory mechanisms and ICI resistance is implied but not always explicitly tested in the same cohort.\",\n          \"contribution\": \"Details mechanisms by which microbiota modulates immunity: 1) Production of microbial byproducts (SCFAs, bile acids) regulating immune cells. 2) Training of immune cells and fostering diverse T-cells. 3) Specific examples like Barnesiella intestinihominis enhancing T-cell infiltration for chemotherapy. 4) Fusobacterium nucleatum inhibiting NK cell responses and recruiting MDSCs for immune evasion. 5) H. pylori and B. fragilis mechanisms involving cytokine release (IL-17, TNF-a) and signaling pathways (NF-kB, STAT3) that create an immunosuppressive or pro-inflammatory environment.\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fe0fe2da86f5f5dc42931ae1\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review focuses primarily on Gastrointestinal Cancers (GC, CRC, PDAC). While it mentions ICIs are used in melanoma and renal cell carcinoma, the specific microbiome data provided is largely contextualized within GI oncology or general preclinical models. Caution should be taken when extrapolating specific GI microbiome findings to non-GI solid tumors without verifying cross-tumor applicability.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::19c20d06cae659d317987aca\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Mechanistic descriptions often rely on bacterial virulence factors (e.g., CagA, BFT) driving inflammation/carcinogenesis. These are specific to certain infections (H. pylori, ETBF) and may not represent the general mechanism of all microbiome-ICI interactions, which might be more dependent on commensal metabolic outputs.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9849449b61645e678a341cca\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review acknowledges individual variability in microbiome composition as a major limitation. Findings are presented as associations or potential mechanisms rather than definitive causal proofs for all patient populations.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::554bef05284423ddc062a9df\",\n        \"source_handle\": \"P0438\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::592aefafd208990b34ed0f86\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::32a478593e4a0082818b7463\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ab0406251785cafcbec83ddd\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::74f02513ce09cbd1bf0cd4f1\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"本文采用叙述性综述的方法，依据“减少免疫反应的病因因素”对现有数据进行分类和整合。具体路线为：首先根据作用对象将耐药机制划分为肿瘤特性、肿瘤微环境和患者特征三大组别；其次，在每一组别下详细列举具体的分子机制、细胞类型或生理状态（如TMB、MHC-I表达、Treg/MDSC/TAM比例、肠道菌群失调等）；最后，结合近期临床研究结果，归纳基于上述机制的联合治疗策略（如PD-1/CTLA-4联用、联合VEGF抑制剂等），并引用相关临床试验数据（如CheckMate系列研究）来支持策略的有效性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::874d2421ed154db1dc71b4bb\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了一个基于病因学因素（肿瘤、微环境、患者）的免疫检查点抑制剂耐药机制结构化框架；汇总了多种联合治疗策略及其背后的生物学 rationale，并引用了多项关键III期临床试验结果作为证据支持。\",\n          \"limits\": \"作为一篇叙述性综述，其结论依赖于对已有文献的综合而非新的原始实验数据；对于特定机制在不同肿瘤类型中的异质性讨论可能不够深入；部分联合治疗的长期生存数据和安全性细节未全面展开；未提供系统性的文献检索流程和质量评估标准。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::36938fe1c53e43555bf5da93\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"肿瘤特性维度\",\n          \"finding\": \"低肿瘤突变负荷（TMB）和新抗原丢失是主要耐药原因；MHC-I类分子及β2-微球蛋白表达下降导致抗原呈递障碍；IFN-γ、MAPK、Wnt/β-catenin等信号通路异常及表观遗传修饰（如DNA甲基化、EZH2活性）可抑制免疫反应。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6aa951ea2957c3e8511a2840\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"肿瘤微环境维度\",\n          \"finding\": \"“冷”肿瘤表型缺乏T细胞浸润；Tregs、MDSCs和M2型TAMs通过分泌抑制性细胞因子（TGF-β, IL-10）抑制效应T细胞；VEGF和TGF-β促进血管生成及免疫抑制；代谢重编程（乳酸、氨基酸代谢）及缺氧环境进一步削弱CD8+ T细胞功能。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::76f140dec5c5945869d5d1d4\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"患者特征维度\",\n          \"finding\": \"肠道菌群组成影响免疫激活水平；性别及激素（如雌激素）调节TME中的免疫细胞分布和PD-L1表达；HLA-I基因型变异影响新抗原识别效率。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ac5ab8636ce51ccc5050865c\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"克服耐药策略\",\n          \"finding\": \"联合PD-1/PD-L1与CTLA-4抑制剂（如纳武利尤单抗+伊匹木单抗）在多类实体瘤中显示优于单药或化疗的生存获益；联合抗血管生成药物（VEGF抑制剂）可改善TME灌注和T细胞浸润；联合化疗、靶向治疗（BRAF/MEK抑制剂）、表观遗传药物及PARP抑制剂可通过不同机制逆转免疫抑制状态。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::afd9d3a90c940409f6f4b6f6\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dd206aa6892465c9dd85596a\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管免疫检查点抑制剂在临床 oncology 中显示出高效性，但部分患者存在原发性或获得性耐药，导致治疗效果不可预测。目前耐药的确切机制尚未完全阐明，因此需要系统性地整理现有理论，明确不同病因因素如何降低免疫反应，并识别主要的克服耐药途径。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::827d48f984f3c7fc72776233\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"医学肿瘤学中的免疫检查点抑制剂（ICIs）治疗，重点探讨原发性及获得性耐药机制及其克服策略。研究对象涵盖实体瘤（如黑色素瘤、非小细胞肺癌、肾细胞癌等），涉及肿瘤内在属性、肿瘤微环境（TME）及患者个体特征三个维度的生物学机制。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2119508ca2beba167052b30e\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该综述旨在系统梳理并归纳导致免疫检查点抑制剂疗效不佳的生物学机制，并基于这些机制提出克服耐药的临床治疗策略。作者将耐药机制分为三类：与肿瘤特性相关的机制（如低肿瘤突变负荷、新抗原丢失或呈递改变、信号通路异常及表观遗传修饰）、与肿瘤微环境相关的机制（包括免疫细胞亚群、基质细胞、细胞因子、代谢背景及缺氧状态），以及与患者特征相关的机制（肠道菌群、性别/激素、HLA-I基因型）。在此基础上，文章总结了联合用药策略，包括双免疫检查点抑制、联合抗血管生成药物、化疗、靶向治疗、表观遗传调节剂、PARP抑制剂及TGF-β抑制剂等，以增强抗肿瘤免疫反应。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7dd36fa054a07750f8da05a6\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"综述开头及结尾对ICI疗效现状、耐药普遍性及综合治疗必要性的概述。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a8636d655e101ea640788bd4\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"文中关于TIM-3, LAG-3, TIGIT, VISTA的作用机制及联合PD-1阻断剂的临床前和临床数据。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::937fa136e3bd71f711d32b1a\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"关于TME中代谢物（乳酸、精氨酸、色氨酸代谢酶）及缺氧如何抑制CD8+ T细胞活化和增殖的段落。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4639ae6e7b962bd6cc4916a3\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要侧重于菌群对整体免疫状态的宏观影响，未深入探讨特定菌种与特定ICI药物之间的精确分子互作机制。\",\n          \"contribution\": \"提供了肠道菌群作为免疫反应调节器的具体论述，指出健康菌群可增加效应T细胞水平、上调MHC-II并激活树突状细胞，而菌群失调可能导致治疗抵抗。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5bc5ad830818239b3eb7d189\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制描述较为广泛，涵盖了多种肿瘤类型，未针对某一特定机制在所有实体瘤中的普遍性或特异性进行定量比较；部分机制间的因果关系多为相关性描述。\",\n          \"contribution\": \"详细列出了介导效应的多重机制路径，包括：1) 肿瘤内在机制（TMB、抗原呈递、信号通路）；2) 微环境机制（抑制性细胞积累、细胞因子风暴、代谢抑制、缺氧）；3) 宿主机制（HLA限制、激素调节）。同时指出了克服这些机制的具体药物组合策略。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9eda1486a04b2f09ff269b77\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述涵盖多种实体瘤，不同肿瘤类型的耐药机制和微生物组构成可能存在显著差异，应用时需考虑肿瘤特异性和情境依赖性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6d51902e6ac45ce0b92dc477\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中引用的临床试验数据多为总体人群结果，未专门分层分析肠道菌群状态对疗效的影响，因此不能直接推断菌群与特定ICI疗效的因果强度。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::37a939282a533a5c7440a5ab\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"关于宿主因素（如性别、HLA）的描述较为概括，需结合其他研究确认其在特定人群中的具体贡献度。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3dd0bebaa6867406b678bd2d\",\n        \"source_handle\": \"P0362\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"html\",\n              \"reason\": \"html_not_scholarly_body\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"pdf\",\n              \"reason\": \"full-page text extracted; page positions retained\",\n              \"status\": \"fitz\"\n            },\n            {\n              \"kind\": \"fitz\",\n              \"reason\": \"layout, table relations, formulas, figure pixels, and scanned text may be lost\",\n              \"status\": \"known_gap\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::575a54bd02e5808098914b0e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0eb61fe9830b1063300638cd\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e36852e039a578ad56dc1947\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bfaa65a3320dc440ddff00ad\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"The authors conducted a narrative synthesis of existing literature. They categorized findings into potential benefits (positive clinical responses in melanoma, CRC, etc.) and failures (e.g., SER-401 trial). Mechanisms were analyzed through host physiology alterations (microbiota diversity/composition, metabolites like SCFAs and bile acids, TME immune cell infiltration, signaling pathways). Optimization strategies were derived from donor screening criteria, functional vs. composition-based selection, and monitoring methods. Future perspectives were outlined based on identified gaps in current knowledge.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::95ea94d27b2d7b2268bfea91\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a structured overview of the heterogeneous clinical outcomes of FMT-ICI combination therapy across different cancer types.\",\n          \"limits\": \"As a narrative review, it does not present new primary data or perform a systematic quantitative meta-analysis; conclusions are based on synthesized observations from cited studies.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::450a76879e9b6be3204aedb4\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Elucidates complex, multi-level mechanisms linking gut microbiota to ICI response, highlighting both beneficial and detrimental pathways.\",\n          \"limits\": \"Many mechanistic insights are derived from preclinical models or small clinical cohorts; causal relationships in humans require further validation.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9b598e37442cf0b01ffd531d\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Identifies critical variables (donor selection, recipient status, protocol details) that contribute to outcome variability.\",\n          \"limits\": \"Standardized protocols for donor selection and FMT administration are not yet established, limiting direct clinical translation recommendations.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::11c4feb5b5ae93fe26823491\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In responders to anti-PD-1 therapy (e.g., melanoma, MSS-mCRC)\",\n          \"finding\": \"FMT increases gut microbial diversity and enriches beneficial taxa (e.g., Bifidobacterium, Faecalibacterium), leading to enhanced CD8+ T cell infiltration, reduced immunosuppressive cells (Tregs, MDSCs), and improved clinical outcomes.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::77f7f442b2ee33b41d52bb77\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In non-responders or specific trials (e.g., NCT03817125 with SER-401)\",\n          \"finding\": \"FMT or defined bacterial formulations may fail to improve or even worsen outcomes, potentially due to the expansion of immunosuppressive cells, activation of resistance pathways, or introduction of harmful metabolites/bacteria.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2c7718994e5ccb908e7d025e\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Mechanistic level\",\n          \"finding\": \"FMT modulates ICI efficacy via multiple pathways: altering microbiota composition/diversity, producing metabolites (SCFAs can be both beneficial and immunosuppressive; bile acids like DCA can promote tumor growth), reshaping the TME (increasing effector T cells, decreasing suppressive myeloid cells), and modulating signaling pathways (TLR, Wnt/β-catenin).\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cd8d7b2aff300bc3e39abfe6\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2f7f34d1e2f3b372fe06493a\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"To address the inconsistency in clinical outcomes when combining FMT with ICIs, elucidate the underlying mechanisms of this interaction, identify key factors influencing efficacy, and provide a framework for optimizing FMT strategies to enhance immunotherapy response.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::307ba8b829e2c5c2fed7647d\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"The review focuses on the integration of fecal microbiota transplantation (FMT) with immune checkpoint inhibitors (ICIs) for cancer treatment. It covers clinical evidence from various solid tumors (melanoma, colorectal cancer, etc.), preclinical mechanistic studies, and optimization strategies for FMT protocols.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1bdd4c29ead36b61ef77d66e\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This is a comprehensive narrative review that critically examines the controversial effects of combining FMT with ICIs. It synthesizes evidence from clinical trials and preclinical studies to explain why FMT sometimes enhances ICI efficacy while other times shows no benefit or adverse effects. The paper outlines mechanisms involving gut microbiota modulation, metabolite profiles, and tumor microenvironment changes, and discusses factors influencing outcomes such as donor selection, recipient characteristics, and administration protocols. It concludes by proposing future research directions including large-scale trials, multi-omics integration, and alternative microbiome-based therapies.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5013ece2973d969d51eb7c45\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Evidence is drawn from various trial phases and tumor types; generalizations across all solid tumors should be cautious due to varying baseline microbiomes and tumor immunogenicity.\",\n          \"contribution\": \"Summarizes clinical evidence showing that FMT can enhance ICI efficacy in specific solid tumors (melanoma, MSS-mCRC) by correlating with increased microbial diversity and beneficial taxa enrichment. Also reports cases where FMT failed or showed adverse effects.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::07684cdaa7711484a96a6e52\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Some mechanisms are primarily supported by preclinical mouse models; human validation is ongoing. The dual role of certain metabolites (e.g., SCFAs) means effects are context-dependent.\",\n          \"contribution\": \"Details specific mechanisms: 1) Modulation of gut microbiota diversity/composition affecting T cell function. 2) Metabolite-mediated effects (SCFAs enhancing CD8+ T cells but also promoting Tregs; bile acids promoting tumor growth). 3) TME remodeling (increased CD8+ T cells, decreased Tregs/MDSCs). 4) Signaling pathway modulation (TLR, Wnt/β-catenin).\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2226fca183a362e244126599\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Comparison of FMT with other microbiome interventions (prebiotics, postbiotics, defined consortia) and discussion of alternatives like SER-401 and MET4.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::21da90be60b5d73d7b8ff795\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Discussion on regulatory frameworks, donor screening standards, and long-term safety assessments.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dd15735166da05292e878072\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review covers multiple cancer types, not exclusively solid tumors; ensure relevance to the user's focus on solid tumors is maintained.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9bcc0d92e9bead3c890478c5\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Mechanistic claims often rely on preclinical data; distinguish between observed associations in humans and proposed mechanisms from animal models.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::31c84a6ae14740360e96957e\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The term 'controversial' reflects mixed results; avoid interpreting negative results as definitive proof of inefficacy without considering confounding factors (donor, protocol, patient status).\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b24a190d28e263126fc08053\",\n        \"source_handle\": \"P0573\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7370217b0d1083d4f465a9fd\",\n          \"snapshot::b8f4ede79d64928928c3569c\",\n          \"snapshot::d1590c0e09f64bdeb0f7b69b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b4ed5145d05c05df30b00f09\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f807fe07bfdaa7666e1c8895\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a9ef548424611edfbcf54ff5\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"As a narrative review, this paper does not employ a systematic search protocol described in the text. Instead, it synthesizes findings from a broad range of sources including: 1) Historical timeline analysis of key advancements; 2) Summary of clinical trial data (Tables 1-5) linking specific microbial taxa to ICI/ACT outcomes; 3) Mechanistic discussion based on preclinical models (mouse studies) and human cohort analyses regarding immune cell activation, metabolite pathways (SCFAs, bile acids, etc.), and intratumoral interactions; 4) Evaluation of intervention strategies (antibiotics, FMT, probiotics, diet, engineered microbes) by summarizing results from ongoing and completed clinical trials.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5837ed0c8dbe3897ba6b01b8\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a structured synthesis of clinical and preclinical evidence linking specific gut microbial taxa to ICI and ACT outcomes across multiple cancer types. It categorizes mechanisms into innate/adaptive immunity modulation, metabolite effects, and intratumoral interactions. It also catalogs numerous ongoing clinical trials for FMT, probiotics, and dietary interventions.\",\n          \"limits\": \"As a narrative review, it lacks a systematic methodology for study selection, potentially introducing selection bias. Many findings are derived from small-scale clinical studies or animal models, limiting generalizability. The field faces significant heterogeneity in sequencing methods, sample handling, and lack of standardized protocols, making cross-study comparisons difficult. Causal relationships between specific microbes and clinical outcomes are often correlational rather than proven causal.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::681a92e8d7b7987be2bcbba3\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"ICI therapy (anti-PD-1/PD-L1/CTLA-4)\",\n          \"finding\": \"Specific gut microbial compositions correlate with ICI response. Beneficial taxa include Bifidobacterium, Akkermansia muciniphila, Ruminococcaceae, and Faecalibacterium prausnitzii, which are associated with improved survival and tumor regression in melanoma, NSCLC, and RCC. Conversely, antibiotic use generally reduces ICI efficacy.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3d86d0a6bec0c10f55a857ee\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"ACT therapy (CAR-T, TCR-T)\",\n          \"finding\": \"Gut microbiota influences ACT efficacy and toxicity. Certain microbes (e.g., Ruminococcus, Bacteroides) are linked to CAR-T efficacy, while others may predict neurotoxicity or cytokine release syndrome (CRS). Microbial metabolites like SCFAs can enhance CD8+ T cell cytotoxicity.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::731c4e19c2e491a533d19ed9\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Mechanisms of Immune Modulation\",\n          \"finding\": \"Microbiota modulate immunity via direct interaction with dendritic cells and macrophages (PRR activation), metabolite signaling (SCFAs, bile acids, tryptophan metabolites influencing T cell differentiation), and molecular mimicry (cross-reactive T cells). Intratumoral microbiota can remodel the TME, promoting TLS formation or inducing immunosuppression.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::385abb08948f6bfd5a895cdb\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Intervention Strategies\",\n          \"finding\": \"FMT from ICI responders can overcome resistance in refractory melanoma patients. Probiotics (e.g., Clostridium butyricum CBM588) and dietary interventions (high-fiber, ketogenic) show promise in enhancing ICI response and reducing toxicity, though clinical evidence is still emerging.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1022c7a0d677eea8339a07e5\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b948719cef3c84a90bacafe2\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"Despite the success of immunotherapies like ICIs and ACTs, patient responses vary widely due to primary or acquired resistance and adverse events. This review aims to elucidate the role of the gut microbiota in shaping these outcomes, identify potential biomarkers for predicting response, and explore microbiota-based strategies to enhance efficacy and mitigate toxicity.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0b5c58557176e76454e9789e\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"The review focuses on the gut microbiota and its influence on cancer immunotherapy, specifically immune checkpoint inhibitors (ICIs) and adoptive cell therapies (ACTs). It covers clinical correlations, preclinical mechanisms, intratumoral microbiota, and intervention strategies across various solid tumors and hematologic malignancies.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::00e315febc4d75be2605fe4d\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This paper provides a comprehensive overview of how the gut microbiome modulates the efficacy and toxicity of cancer immunotherapies. It traces the historical evolution from early animal studies to recent clinical trials, detailing specific microbial signatures associated with response or resistance to ICIs and ACTs. The authors synthesize mechanistic insights involving innate and adaptive immune modulation, metabolite production, and tumor microenvironment remodeling. Furthermore, it evaluates therapeutic interventions such as fecal microbiota transplantation (FMT), probiotics, dietary modifications, and engineered bacteria, while highlighting challenges in standardization and clinical translation.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f0893cf07f418f00505a67b3\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Associations are largely correlative from retrospective or small prospective cohorts. Specificity varies by cancer type and ICI agent. Lack of standardized detection methods limits direct comparison. Does not establish causality.\",\n          \"contribution\": \"Identifies specific gut microbial taxa associated with ICI response or resistance in solid tumors. For example, Akkermansia muciniphila, Bifidobacterium, and Ruminococcaceae are linked to better outcomes in melanoma and NSCLC, while certain Proteobacteria or high abundance of Bacteroides intestinalis may correlate with resistance or toxicity. It also notes that beneficial taxa vary by ICI type (anti-PD-1 vs. anti-CTLA-4) and cancer type.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9acac8e7a085b376f6d5fa09\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Many mechanisms are primarily demonstrated in mouse models (preclinical). Human validation is often indirect or observational. Some mechanisms (e.g., molecular mimicry) are proposed but require further confirmation in humans. Effects can be bidirectional (promoting or suppressing immunity depending on context).\",\n          \"contribution\": \"Details mechanisms by which gut microbiota modulate ICI efficacy: 1) Direct immune modulation via PRR activation (TLR/NLR) leading to DC maturation and T-cell activation; 2) Metabolite-mediated regulation (SCFAs inhibiting HDAC, bile acids affecting Th17/Treg balance, tryptophan metabolites via AhR); 3) Molecular mimicry where bacterial antigens cross-react with tumor antigens; 4) Remodeling of the tumor microenvironment (TME) through intratumoral bacteria or systemic metabolites influencing tertiary lymphoid structures (TLS).\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a099308176c365e60e6c9707\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Historical perspective section tracing discoveries from 2007 to 2025, highlighting the shift from correlation to mechanistic understanding and clinical trials.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::330df5057e74b7364a8ff13e\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Sections on FMT, probiotics, antibiotics, diet, and engineered microbes, including tables of clinical trials.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b6025fb0bea4f9c424e4a773\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Section on 'Challenges and future directions' discussing technical variability, donor effects in FMT, host genetics, and lack of standardization.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::89f397ff3a02c8a970e8f7bb\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review covers both gut and intratumoral microbiota; ensure distinction is maintained when applying findings to 'gut microbiome' specific facets.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0d39e28531ff4eba8773e916\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Findings on specific bacterial taxa are highly dependent on the cancer type (e.g., melanoma vs. NSCLC) and the specific ICI agent (anti-PD-1 vs. anti-CTLA-4); avoid over-generalizing across all solid tumors.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b893f3c804b4e30fff3fd0e6\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Many mechanistic insights are derived from murine models; caution is needed when extrapolating to human physiology without explicit human validation mentioned in the text.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f4b86b110a79614d126a2863\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Clinical trial data cited are often from early-phase (I/II) or small cohorts; results should not be interpreted as definitive proof of efficacy for interventions like FMT or probiotics.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::02d1348f18e02c25ac2296c2\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::89b8f947d85f7362a3c254e0\",\n          \"snapshot::448ef91485221af0125a17af\",\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a08b4d948542bbf6392b23a5\",\n        \"source_handle\": \"P0146\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::aab188251adff198144a1cd5\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2d4090a0a9a69e7b82fa72da\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::61d22ff9d5992d0ca77a2697\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::20fd16b3f23123515d2ab1cc\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"The authors conducted a systematic review following PRISMA guidelines. They searched PubMed and Cochrane databases for peer-reviewed articles published between December 2015 and December 2024. Inclusion criteria covered randomized/non-randomized clinical trials in humans and animal models investigating the association between microbiome and TNBC treatment response. Data extraction focused on study design, population, interventions, and key findings. Risk of bias was assessed using ROBINS-I, ROB 2, and SYRCLE tools depending on study type. The results were narratively synthesized by grouping studies into human clinical/translational cohorts and murine/preclinical mechanistic models.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8f171e01ed287c390ec491ca\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a comprehensive narrative synthesis of both clinical and preclinical evidence linking microbiome features (diversity, specific taxa, metabolites) to TNBC treatment outcomes (pCR, PFS, OS).\",\n          \"limits\": \"Narrative synthesis only; no meta-analysis performed. Included studies vary widely in design, sample size, and sequencing methods. Many clinical studies have small sample sizes or are retrospective. Causal mechanisms are largely inferred from preclinical data or correlative clinical observations.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::72245b24bdfc15d044586d3d\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Neoadjuvant Chemotherapy (NACT) in early-stage TNBC\",\n          \"finding\": \"Higher baseline gut microbiome alpha-diversity (Shannon index) is significantly associated with achieving pCR (Vernaci et al., 2023). Specific taxa like Bacteroides eggerthii were enriched in responders.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::304c47cb87333d1dc062c6e4\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Chemoimmunotherapy (Atezolizumab + Chemo) in metastatic TNBC\",\n          \"finding\": \"High baseline Faith's phylogenetic diversity (PD) predicts prolonged progression-free survival (PFS), particularly in the atezolizumab arm (ALICE trial). Bifidobacterium enrichment was associated with lack of clinical benefit in this specific context.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6db66cc17b20c3908b19f74b\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Antimicrobial exposure during/after diagnosis\",\n          \"finding\": \"Cumulative antimicrobial exposure is associated with decreased overall survival (OS) and breast cancer-specific survival (BCS), independent of stage and ANC. This effect persists for up to 3 years post-diagnosis.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a9d3317ffe930c9f61ed4b00\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Intratumoral Microbiota Load\",\n          \"finding\": \"Higher intratumoral bacterial burden correlates with pCR to neoadjuvant chemoimmunotherapy. High load is associated with increased FOLR2+ macrophages and decreased SPP1+ (immunosuppressive) macrophages.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6e14c2b8fa20304048c48080\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Preclinical Models (Murine)\",\n          \"finding\": \"Gut microbiota depletion (antibiotics/germ-free) attenuates doxorubicin efficacy and CD8+ T cell infiltration; fecal microbiota transplantation (FMT) restores response. Engineered E. coli producing methioninase reduces tumor growth via methionine depletion. Microbial metabolite TMAO promotes anti-PD-1 efficacy via GSDME-mediated pyroptosis.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::359f788dd049bca472959d3e\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4c9f0a7f34e9c68afee2de13\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"Does the microbiome influence pathological response and clinical outcomes in TNBC patients undergoing standard systemic therapies (chemotherapy and immunotherapy)?\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::511e006a092c44a9c419d77c\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"Triple-negative breast cancer (TNBC); gut and tumor-associated microbiome; neoadjuvant chemotherapy (NACT) and immune checkpoint blockade (ICB).\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a0a4c7233ac1d8bc06c65120\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This systematic review synthesizes evidence from 14 studies (clinical trials, observational cohorts, and preclinical models) to evaluate the role of the microbiome in TNBC therapeutic response. It specifically investigates whether baseline microbiome composition and diversity predict pathological complete response (pCR) or survival outcomes under NACT and ICB regimens. The review highlights that higher microbial diversity and specific commensal taxa are associated with enhanced antitumor immunity and better treatment efficacy, while antibiotic-induced dysbiosis correlates with poorer outcomes. It also discusses potential mechanisms involving immune cell infiltration, macrophage polarization, and microbial metabolites.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::642caa8ee29d86ce26dbb5ae\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"TNBC lacks ER/PR/HER2 targets, relying on chemo and increasingly ICB. pCR is a key prognostic marker. Antibiotic use is common and linked to poor outcomes.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0e24f009d6feeb68363b932c\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Antimicrobial exposure is associated with decreased OS/BCS, potentially mediated by lymphopenia and loss of beneficial taxa.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e6dd32bf5adfccfafd70bce7\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Figure 6 and discussion suggest Chemo alone may destroy diversity, while Chemo+ICB preserves/restores it, allowing beneficial bacteria to reinforce efficacy.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::95484221107528a95136a64f\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"These are observational/correlational findings in humans. The ALICE trial analysis is exploratory. Sample sizes are modest. Does not prove causality for all taxa mentioned.\",\n          \"contribution\": \"Identifies clinical associations between microbiome features and ICB/Chemo efficacy. Specifically, it reports that high baseline Faith's PD predicts PFS benefit from Atezolizumab+Chemo but not Chemo alone. It also notes that intratumoral microbiota load predicts pCR to NACI.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3e9f231228531d8f8721dc30\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Mechanisms are primarily derived from murine models or in vitro systems. Translational relevance to humans needs careful framing (e.g., TMAO mechanism validated in mice, correlated in small human cohort). Antibiotic depletion models may not fully replicate human dysbiosis.\",\n          \"contribution\": \"Details mechanistic pathways from preclinical studies: 1) TMAO promotes anti-PD-1 efficacy via GSDME-mediated pyroptosis and CD8+ T cell activation. 2) Gut microbiota depletion reduces Doxorubicin efficacy by impairing CD8+ T cell infiltration and IFN-gamma signaling. 3) Engineered E. coli reduces tumor growth via methionine depletion. 4) Quercetin enhances Cyclophosphamide efficacy via SCFA production and immune modulation.\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ad46602408c995988ee87e8a\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review includes both gut and intratumoral microbiome data; ensure distinction when applying findings to specific anatomical sites.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a5ae9796ea0328296e6cb150\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Many clinical findings are from small cohorts or retrospective analyses; avoid overstating generalizability.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9b5c6dc3cdfb4fee6c511be8\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Preclinical mechanisms (e.g., TMAO, methionine depletion) are robust in mice but human validation is often limited or correlative.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b30dd6261ea8656401646806\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Taxon-specific effects (e.g., Bifidobacterium being beneficial in melanoma but associated with non-response in this TNBC ICB trial) highlight context-dependency.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f74f2ddebd5f321126247304\",\n        \"source_handle\": \"P0057\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-a96686bee2f7be7a8dd8\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-724817b1ad2fa81c8182\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-ba354d40740f64366cbf\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-403bce67afb0fdb07c1f\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-8c71e871c7aa5482d545\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-f85da31c482f020fe5f7\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"missing\"\n            },\n            {\n              \"asset_id\": \"asset-a7a6e9bd3a48b1fef12e\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-12c6cac6a4bef2539d08\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-02faf8b9fedd6313c05e\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-970b424322e405f5652d\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-f4e5574773433f48fdb6\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-2fbf9fdf4b39e967b994\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-f9da8f3ea073b672e0db\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5c16b29821e421056954\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::be960d4dd42c49b7fc35ff7b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8e8145e70a7d1810760361df\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::98e4d7145d8aa32053893296\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::46d68237e826a20ae646f40e\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用系统综述方法。1. 检索策略：基于PRISMA指南，在PubMed、WoS、Scopus进行文献检索，不限语言，截止日期为2025年1月。2. 纳入标准：成人mRCC患者，接受微生物组干预（抗生素、益生菌、前体、饮食、FMT）并与标准护理对比，报告ORR、PFS、OS或irAEs等临床终点。排除非比较研究、混合肿瘤类型未分层、儿科、临床前及非原创出版物。3. 质量评估：观察性研究使用纽卡斯尔-渥太华量表（NOS），RCT使用Cochrane RoB 2工具。4. 数据综合：定性综合各研究的干预措施、微生物组变化及临床结果，按干预类型（抗生素负面影响、益生菌/FMT潜在正面影响）分类叙述。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bb6258bf28f71234e7b1005d\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"首次系统汇总mRCC领域关于微生物组干预的临床证据，明确了抗生素对ICI疗效的负面关联，以及益生菌/FMT在靶向治疗和免疫治疗中的潜在增效作用。\",\n          \"limits\": \"所给材料未交代具体的荟萃分析统计结果（如合并效应量），主要依赖定性综合。证据基础薄弱：包含3项回顾性研究（存在混杂偏倚风险）和3项小样本RCT/摘要（统计效能不足，其中一项仅为会议摘要）。微生物组检测方法异质性高，缺乏标准化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6a3d928b5a7bb7e7256aa430\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"mRCC患者接受ICI治疗，围治疗期（ICI开始前8周至开始后4周或30天内）使用广谱抗生素\",\n          \"finding\": \"抗生素暴露导致肠道菌群失调，显著降低ORR（12.9%-34.8% vs 更高比例），缩短PFS（HR 1.96-3.10）和OS（HR 3.5），增加疾病进展风险。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9dd8c9da2bda33ccfed831a4\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"mRCC患者接受VEGF-TKI治疗期间补充含动物双歧杆菌的酸奶\",\n          \"finding\": \"益生菌实现100%定植，富集Akkermansia muciniphila和Barnesiella intestinihominis等有益菌属，观察到PFS延长的趋势，但未达到统计学显著差异（小样本n=20）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4f13d094ffea1dd368bb1748\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"mRCC患者接受pembrolizumab + axitinib治疗，接受来自长期ICI反应者的FMT\",\n          \"finding\": \"FMT组1年PFS显著高于对照组（66.7% vs 35.0%, p=0.036），ORR提高（54% vs 28%），且未增加≥3级不良事件（基于Phase II RCT摘要，n=50）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a6c7883bc90d2043e3b56081\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"mRCC患者接受cabozantinib + nivolumab治疗，补充CBM588益生菌\",\n          \"finding\": \"益生菌组ORR显著高于对照组（74% vs 20%），6个月PFS改善（84% vs 60%），伴随Ruminococcaceae富集和维生素K2合成通路增加，但双歧杆菌丰度本身无显著变化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::501f38d3cca7db07bd78d991\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ced0c1c26f04b05aed3ae8ef\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管ICIs和VEGF-TKIs改变了mRCC的治疗格局，但原发性耐药仍频繁发生。肠道微生物组被认为是影响全身治疗疗效的关键决定因素，但目前缺乏针对mRCC这一特定瘤种的系统性临床证据汇总。本研究旨在回答：在mRCC患者中，通过抗生素、益生菌、饮食或FMT调节肠道微生物组，如何影响ICIs和VEGF-TKIs的临床疗效？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0e7aba6b220c2a791e43fff0\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"转移性肾细胞癌（mRCC）成年患者，接受免疫检查点抑制剂（ICIs）或血管内皮生长因子-酪氨酸激酶抑制剂（VEGF-TKIs）全身治疗。重点考察抗生素暴露、益生菌补充、饮食干预及粪便微生物群移植（FMT）对肠道微生物组的调节及其与临床结局的关系。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::642fafab4bece23f70645f6d\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"这是一篇系统综述，旨在评估肠道微生物组调节对mRCC患者全身治疗疗效影响的临床证据。研究遵循PRISMA指南，检索了截至2025年1月的PubMed、Web of Science和Scopus数据库。共纳入6项研究（总N=4738），包括3项回顾性队列研究和3项前瞻性随机对照试验（含一项仅摘要的II期RCT）。研究发现，围ICI治疗期的抗生素使用显著降低客观缓解率（ORR）、无进展生存期（PFS）和总生存期（OS）；而益生菌（如动物双歧杆菌）在VEGF-TKI治疗中可实现定植并富集有益菌属；来自ICI反应者的FMT联合pembrolizumab + axitinib显示出改善PFS和ORR的趋势。文章指出当前证据受限于回顾性设计、小样本和方法学异质性，呼吁开展标准化、生物标志物驱动的前瞻性RCT。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6865e04b586a5c3add0ebc0b\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"mRCC患者基线特征、治疗背景（VEGF-TKI与ICI联用趋势）、抗生素使用的临床普遍性及其对免疫治疗的干扰。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1e9d144e90536397445ae3cb\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"各类干预措施的定义、实施时机（如ICI开始前/后窗口期）、安全性数据（FMT无增加≥3级毒性）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5af0683da0e8542be49997c0\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"对现有研究局限性的总结：回顾性设计、小样本、方法学异质性、未控制的混杂因素（PPI、类固醇、饮食）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ba7a468e5cc9bd8f1d98e49\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"证据主要来自mRCC，外推至其他实体瘤需谨慎；抗生素效应的证据多为回顾性，存在混杂；益生菌/FMT的证据来自小样本或摘要，尚需大规模验证。\",\n          \"contribution\": \"提供了肠道微生物组状态（特别是抗生素暴露导致的失调）与ICI疗效之间的强临床关联证据。具体显示围ICI期的抗生素使用显著降低ORR、PFS和OS。同时提供了FMT和益生菌在mRCC中改善PFS和ORR的初步临床试验数据。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::34eae2b42189c49679e5f36c\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制部分大量引用临床前模型（小鼠FMT恢复敏感性），临床直接证据有限；不同研究中富集的菌属和通路不一致（如CBM588未改变双歧杆菌丰度但改善了疗效），提示机制复杂性。\",\n          \"contribution\": \"提供了微生物组介导ICI疗效的部分机制线索。提及共生菌（如A. muciniphila, B. fragilis）通过树突状细胞激活和CD8+ T细胞浸润增强ICI疗效；抗生素通过耗竭SCFA产生菌、促进病原生物扩张导致耐受性免疫微环境。还提到益生菌可能通过维生素K2合成通路和富集Ruminococcaceae发挥免疫调节作用。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4bcc98caeb15f7e1bb6dd797\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述聚焦于mRCC，虽然机制具有普适性潜力，但临床结果不能直接外推至所有实体瘤。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f83a4407259ef2d37b3555fb\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"抗生素对ICI疗效的负面影响证据主要来自回顾性队列，可能存在未测量的混杂因素（如感染严重程度本身影响预后）。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2a012c725b412df699f0d322\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"益生菌和FMT的正面效果来自小样本RCT或会议摘要，统计效力不足，不能作为确证性证据，仅提示信号。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7b1d00f8fcd8ab1638f045a9\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中提到的机制（如Akkermansia的作用）多基于临床前模型或临床相关性，临床因果证据尚不充分。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9cf23d9e0fcaca0878be814b\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"不同研究中使用的益生菌菌株、FMT供体筛选标准、测序分析方法差异巨大，直接比较需谨慎。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::788b9a81bbab3067c4100631\",\n        \"source_handle\": \"P0090\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8b10bf15f5c5bded90fc2550\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e3b3dd4d6f52b2559a63f16c\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bceb19bfc18db7561f082b39\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::259058b364bbe03c71fdc32a\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用系统性文献综述方法。作者检索并综合了多项临床研究（涉及16S rRNA测序和宏基因组测序）的结果，对比分析响应者与无响应者的微生物组成差异。同时，整合了基础研究的机制发现，重点分析微生物代谢物（SCFAs、胆汁酸等）与宿主免疫系统（TLR信号、cGAS/STING通路等）的交互作用。此外，还结合了肿瘤异质性（病因、基因、代谢）背景，讨论微生物组在不同亚型HCC中的特异性表现。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0cb4e4ad111e1b49747ed92f\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"系统总结了HCC患者中区分ICI响应者与无响应者的具体微生物分类学特征和功能通路，提供了潜在的预测生物标志物列表。\",\n          \"limits\": \"所给摘要未交代具体的文献检索数据库、时间范围及纳入排除标准，无法评估综述的全面性和偏倚风险。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b00dcdd9eb00a66a74612344\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"构建了“微生物-代谢物-免疫”在HCC免疫治疗中的机制框架，特别是强调了胆汁酸和SCFAs的作用。\",\n          \"limits\": \"机制部分主要基于转述的基础研究和少量临床关联数据，许多因果链条（如特定菌株直接导致特定代谢物变化进而改善预后）在人类HCC中尚未完全确证，存在动物模型外推的不确定性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5c3f99e6a4485b196a616344\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"识别了肿瘤异质性（病因、基因、代谢）对微生物组-免疫互作的影响，提示个性化微生物干预的必要性。\",\n          \"limits\": \"对于不同异质性亚型的具体干预策略缺乏直接的临床证据支持，多为理论推导或基于其他癌症类型的类比。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cfea509b7c87fc208f5c569c\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"指出了当前研究的方法学局限（如测序方法、分析流程不一致）和未来方向（多组学、标准化）。\",\n          \"limits\": \"作为综述，其结论依赖于已发表研究的质量，未能提供新的原始数据或独立验证队列。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::851db4dec05ec03b53c55a5d\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"ICI单药治疗（如Nivolumab, Camrelizumab）\",\n          \"finding\": \"响应者通常表现出更高的微生物多样性（Shannon指数）和特定菌属富集，如Akkermansia muciniphila、Ruminococcaceae、Citrobacter freundii；无响应者则富集Proteobacteria、Escherichia coli、Dialister pneumosintes及Prevotella。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3928c283a8e4280e54c54f41\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"ICI联合TKI治疗\",\n          \"finding\": \"组合疗法显示出优于单药的临床结果，微生物特征显示Lachnospiraceae、Ruminococcus、Faecalibacterium等有益菌在响应者中富集，而Bacteroides、Veillonella等在部分研究中与无响应相关。不同研究间存在显著的菌群标识差异，可能与方法学变异有关。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e041d2a6f54b96184e595f54\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"微生物干预措施\",\n          \"finding\": \"抗生素暴露通常与ICIs疗效降低和不良事件增加相关，但个别研究显示短期窗口期内的特定抗生素可能增强疗效。益生菌（如Probio-M9/Lactobacillus rhamnosus）在临床试验中提高了ORR。FMT在早期试验中显示出激活CD4+/CD8+ T细胞和抑制肿瘤生长的潜力，但安全性和标准化仍是主要障碍。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::7cecf289760510f7dd19eb85\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::277be6ab0272039613e4b0f7\",\n        \"source_handle\": \"P0113\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n       