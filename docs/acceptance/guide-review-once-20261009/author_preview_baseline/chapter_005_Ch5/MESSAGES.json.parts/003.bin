d_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Author disclosures indicate potential conflicts of interest related to industry partnerships, which should be noted when evaluating the objectivity of the review's conclusions.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8717538515f340cb5e7fb185\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::57450d6462c2bcc145f62fda\",\n        \"source_handle\": \"P0358\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::8717538515f340cb5e7fb185\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7a272db2dd9eea5f67a5bae8\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::de54677b13188b0e9af90db9\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ba11e860995b5b93ccba646a\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用叙事性文献回顾方法。检索PubMed索引的英文出版物（1946-2026年）、主要肿瘤学指南、关键II/III期临床试验、荟萃分析及机制研究。检索词涵盖NSCLC、ICI、TME、耐药及相关分子靶点。对临床证据按试验阶段、人群相关性、终点成熟度及监管意义进行加权；对临床前和假设生成性研究主要用于支持机制概念。通过分类归纳TME组成、分子通路、物理化学抑制因素及系统性因素，构建耐药机制框架，并据此评估不同组合疗法的临床转化潜力。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d0d6e3f09a1c7ce3c1adb314\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了NSCLC中TME介导耐药的整合性框架，强调从孤立因素转向相互连接的生物学过程视角；明确了不同联合疗法（免疫-免疫、免疫-抗血管、免疫-放化疗、免疫-靶向）的临床证据层级和适用情境。\",\n          \"limits\": \"作为叙事性综述，其结论依赖于作者对纳入文献的选择和解释；未提供新的原始实验数据；部分机制（如微生物组干预）仅基于初步研究，缺乏大规模临床验证；特定生物标志物（如ctDNA阈值）尚待标准化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c58638947e26fda363bc96b7\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"TME细胞成分异质性\",\n          \"finding\": \"巨噬细胞并非简单的M1/M2二元模型，而是存在激活状态的连续谱系；MDSCs亚型特异性功能不同（单核型通过ARG1/iNOS抑制，多形核型通过ROS抑制）；CAF和ECM重塑通过增加间质硬度促进免疫排斥。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::868f6863791b248bb2f885d2\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"内在肿瘤机制\",\n          \"finding\": \"STK11缺失抑制I型干扰素信号，KEAP1缺失激活抗氧化程序，两者共同导致低PD-L1表达和低CD8+ T细胞浸润；EGFR/ALK驱动突变通常伴随低TMB和不活跃的免疫微环境。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8374ecf9788b5088e7803fbf\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"联合治疗证据等级\",\n          \"finding\": \"纳武利尤单抗+伊匹木单抗在CheckMate 227中显示疗效（受PD-L1/TMB影响）；阿替利珠单抗+贝伐珠单抗+化疗在IMpower150中证实对转移性非鳞状NSCLC有效，包括肝转移和EGFR突变TKI失败后人群；LAG-3/TIM-3抑制剂在NSCLC中的临床采纳仍需成熟试验确认。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::55ac707849e577034afb0fb0\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"生物标志物应用\",\n          \"finding\": \"PD-L1检测存在空间异质性和平台间不完全互换性；高TMB预测价值受测序平台和肿瘤纯度影响；空间转录组学可区分免疫表型；液体活检（ctDNA/exosome）需前瞻性验证阈值。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d15f8dadaa9a51de5fbf09e7\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4a3358fa0ff1afdc9ee48a53\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"解决NSCLC中ICI原发性和获得性耐药限制长期临床获益的问题；阐明TME各组分如何协同导致不同免疫表型，并厘清当前联合治疗策略的证据等级与局限性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::16c76a5912d11aab9f5c31be\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"非小细胞肺癌（NSCLC）患者中，肿瘤微环境（TME）介导的免疫检查点抑制剂（ICI）耐药机制、联合治疗策略及生物标志物框架。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f8fa25779ca4c2210b5be95b\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇叙事性综述，旨在将TME介导的ICI耐药视为一个相互连接的生物学过程，而非孤立因素的集合。文章系统梳理了免疫抑制细胞群、基质重塑、血管功能障碍、缺氧、代谢重编程以及抗原呈递缺陷和致癌驱动信号如何协同作用，形成免疫沙漠、免疫排斥或耗竭性炎症表型。在此基础上，综述评估了针对这些机制的联合治疗策略，区分了III期支持的临床标准与早期探索性方法，并提出了整合PD-L1、TMB、干扰素γ特征、空间组学、ctDNA等指标的操作化生物标志物框架，以指导NSCLC的精准免疫治疗。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fd45b37845cc9232f8771c98\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"介绍了NSCLC中ICI耐药的多维度机制，包括内在肿瘤基因改变、局部TME抑制和系统性因素。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::159d56d3ae0242026c9cb9ba\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"讨论了PD-L1、TMB、空间组学和液体活检等生物标志物的现状、局限性和整合需求。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ca50e4620e570197a4e95208\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"区分了III期支持的联合疗法（如双免疫、免疫+抗血管）与早期探索性疗法（如微生物组调节、IDO抑制）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::21e41420c3204126923b02a4\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限NSCLC人群；关联多为观察性，因果机制未详述；Fusobacterium的作用在其他癌种更明确，此处仅为对比提示。\",\n          \"contribution\": \"提供了NSCLC队列中与ICI疗效相关的特定肠道微生物菌群信息：Akkermansia muciniphila、Bifidobacterium spp. 和 Ruminococcus 被报道有助于促进有利的免疫微环境；而 Fusobacterium 的关联在结直肠癌中更强，在NSCLC中需谨慎外推。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5ce76ef1bd40abb575afd9d6\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制描述较为概括，未深入具体的微生物-宿主分子互作细节；主要基于综述转述的其他研究结果；强调需要前瞻性验证。\",\n          \"contribution\": \"阐述了系统性因素（包括微生物组、营养状态、全身炎症）如何作为TME介导耐药的一部分影响ICI疗效。指出微生物组特征可能通过塑造有利的免疫微环境来增强ICI反应，但同时也强调了这种关联需要NSCLC特异性数据集的支持，且目前微生物组干预（如FMT、益生菌）仍属探索性阶段，缺乏标准化评估和安全监测。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bfe4688b4889c6c75d385bf2\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述聚焦于NSCLC，其关于微生物组的发现不能直接外推到所有实体瘤或其他癌症类型，尽管文中提到了结直肠癌的对比。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::75bfe2b13ac9586076893b8d\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中提到的微生物组与ICI疗效的关联主要基于观察性研究和初步数据，因果关系尚未完全确立，干预效果也未经验证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::eaf685d0ccc478e538526402\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"综述本身是叙事性的，其结论依赖于作者对文献的选择和综合，可能存在选择偏倚。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b39a3d326158b7528cc18724\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"对于Fusobacterium等菌种，文中明确指出其在NSCLC中的作用不如在结直肠癌中明确，需谨慎解读。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9b0b35da32a29f6efe86ccd3\",\n        \"source_handle\": \"P0474\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2ebf71c6aa2b1657b267b130\",\n          \"snapshot::153461ac1a5cb9b5a31c3121\",\n          \"snapshot::e83de03b33da0c831779d170\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0199db0a6b296991ed95d91b\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1903d13a7df8887be754a784\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::21c502ce4d9feb1abc472eb2\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"作者通过PubMed数据库进行了系统性文献检索（2019年1月至2025年12月），筛选出关于肠道微生物群和代谢物在癌症免疫治疗中作用的基础和转化研究。随后，文章采用叙事性综述的方法，将内容分为三个主要部分：(1) 详细解析核心代谢物（SCFAs、色氨酸代谢物、胆汁酸、肌苷）的免疫调节机制；(2) 按肿瘤类型（胃肠道与非胃肠道）总结微生物签名与ICI疗效的关联；(3) 评估FMT、益生菌、工程菌等干预策略的转化应用。文中引用了大量图表（Figure 1-3, Table 2）来整合机制网络和治疗策略。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4eddf4399a38d90f66a52ed4\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了肠道微生物群-代谢物-免疫轴在多类实体瘤中的系统性机制框架，特别强调了代谢物的情境依赖性（如丁酸的双向作用）和肿瘤特异性微生物签名。\",\n          \"limits\": \"作为叙事性综述，其结论基于已发表研究的综合，缺乏原始数据的定量合成（如Meta分析）。许多机制证据来自动物模型或小样本临床研究，大规模随机对照试验（RCTs）数据尚缺，且个体间微生物组异质性导致标准化治疗面临挑战。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::13d020d401659bfd819edc82\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"短链脂肪酸（特别是丁酸）\",\n          \"finding\": \"具有双向且依赖情境的免疫调节作用：一方面通过抑制HDAC活性、增强CD8+ T细胞毒性及TCR信号传导来增强抗肿瘤免疫；另一方面在某些情况下（如抗CTLA-4治疗中）可能抑制树突状细胞成熟，减弱T细胞激活。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::556a2c02b52a8d3397800c2e\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"色氨酸代谢物\",\n          \"finding\": \"犬尿氨酸（Kyn）通过AhR通路促进Treg分化，抑制效应T细胞，削弱免疫反应；而吲哚-3-甲醛（I3A）和ICA则通过激活AhR/IL-22轴或抑制IDO1，增强CD8+ T细胞功能并维持肠道屏障完整性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4d2f957c8117b0f1944f97f1\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"胆汁酸（BAs）\",\n          \"finding\": \"次级胆汁酸如isoDCA促进Treg扩增，抑制DC功能；而UDCA通过降解TGF-β抑制Treg分化，增强抗肿瘤免疫。不同胆汁酸对CD8+ T细胞命运有截然相反的影响。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bf6a692c23cd8b67e8b5e315\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"肌苷（Inosine）\",\n          \"finding\": \"作为关键代谢物，肌苷通过抑制UBA6增加肿瘤免疫原性，结合A2AR促进Th1细胞分化，并在葡萄糖受限的微环境中作为替代能源维持效应T细胞的存活和杀伤功能。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::058f047f3f5c1d44f65875b9\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"不同肿瘤类型\",\n          \"finding\": \"存在肿瘤特异性的微生物签名：例如ESCC中Streptococcus富集与良好响应相关，Fn驱动耐药；HCC中Akk和Ruminococcaceae富集者预后较好；黑色素瘤中Bifidobacterium和Ruminococcaceae与ICI疗效正相关。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8a99672acb9cc746b2c9a196\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::91039a283204ebc61cb46c6d\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管免疫检查点抑制剂（ICIs）取得了显著进展，但原发性或获得性耐药限制了其临床疗效。目前对于肠道微生物群-代谢物-免疫轴影响ICI疗效的具体分子机制以及不同肿瘤类型中的特异性调控模式仍不完全清楚。本研究旨在阐明这些机制并综合现有的微生物靶向治疗策略，以改善免疫治疗结果。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8152b340dba9d984834c3591\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"该综述聚焦于肠道微生物群-代谢物-免疫轴在癌症免疫治疗中的作用，涵盖胃肠道肿瘤（如食管癌、胃癌、胰腺癌、肝癌、结直肠癌）和非胃肠道实体瘤（如黑色素瘤、肾细胞癌）。研究对象包括核心代谢物（短链脂肪酸、色氨酸代谢物、胆汁酸、肌苷）、特定微生物菌群及其与免疫检查点抑制剂（ICIs）疗效的相互作用。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::61b7f2caf7a2598674f9c9f8\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"这是一篇叙事性综述，旨在系统梳理肠道微生物群及其代谢产物调节抗肿瘤免疫的分子机制，并综合评估针对该轴的转化治疗策略。文章首先阐述了微生物代谢物如何通过表观遗传修饰、受体结合和代谢重编程等途径重塑免疫微环境；其次，按肿瘤类型归纳了特征性微生物签名及其对ICI响应的影响；最后，讨论了粪菌移植（FMT）、益生菌补充、工程菌及其他干预手段的临床潜力与挑战。尽管采用了系统性的文献检索流程，但其性质为叙事性综述，侧重于机制解释和策略综合，而非严格的荟萃分析。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ac0f10278878595624a0d171\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"这些关联多基于观察性队列或动物模型，因果关系需进一步验证；且不同研究间的微生物定义和分析方法可能存在差异。\",\n          \"contribution\": \"提供了不同肿瘤类型中特征性微生物签名与ICI疗效关联的分类信息。具体包括：ESCC中Streptococcus富集与CD8+ T细胞浸润相关，Fn驱动耐药；HCC中Akk和Ruminococcaceae富集预示良好响应；黑色素瘤中Bifidobacterium和Ruminococcaceae与疗效正相关；结直肠癌中Lactobacillus rhamnosus GG和Roseburia intestinalis增强敏感性，而Peptostreptococcus anaerobius促进MDSC积累导致耐药。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cffa01442576e15d938a5da1\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制细节多源于体外实验或小鼠模型，人体内的确切浓度和效应阈值尚不明确；部分机制（如丁酸的双向作用）高度依赖肿瘤微环境的特定状态。\",\n          \"contribution\": \"详细阐述了四类核心代谢物调节抗肿瘤免疫的具体分子机制。包括：(1) SCFAs（如丁酸）通过抑制HDAC、激活GPR109A/TLR5通路增强CD8+ T细胞功能，但具有情境依赖性；(2) 色氨酸代谢物中，Kyn通过AhR促进Treg，而I3A/ICA通过AhR/IDO1通路增强效应T细胞；(3) 胆汁酸中，isoDCA促进Treg，UDCA抑制Treg；(4) 肌苷通过抑制UBA6、激活A2AR/cAMP-CREB通路及作为替代能源支持T细胞代谢。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a132693460907667307d07bf\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"大多数干预措施仍处于早期临床试验阶段，缺乏大规模RCT证据；个体化匹配和长期安全性仍是未决问题。\",\n          \"contribution\": \"评估了针对微生物组的干预策略（FMT、益生菌、工程菌）在增强ICI疗效方面的转化潜力和当前局限。指出FMT在黑色素瘤和小样本研究中显示出提高ORR的潜力，但面临标准化和安全风险；益生菌（如LGG、Faecalibacterium prausnitzii）可通过产生代谢物或下调PD-L1增强疗效，但也存在负面案例；工程菌和噬菌体疗法代表了精准调控的新方向。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::68177944a4dda1ac58b105ef\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"综述引言及机制部分对轴的整体描述，包括代谢物跨肠壁转运、受体结合及表观遗传调控的一般原理。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::832221f445633253af129f0a\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"讨论部分关于“Translational challenges and future directions”的内容。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::17c35972997100ed380495a6\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述为叙事性综述，非系统评价或Meta分析，其结论代表作者对现有文献的综合解读，而非统计汇总结果。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cf39d36dbfa7ab60609a95cd\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"许多机制证据来自动物模型（如无菌小鼠、人源化小鼠），直接外推到人类临床需谨慎。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::01087a6efb8a2e39da727c5b\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"微生物签名的识别依赖于特定的测序技术和分析方法，不同研究间可能存在批次效应或定义差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ce6ec42420753ee3437352d2\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"代谢物的作用具有高度的情境依赖性（如丁酸的双向作用），不能简单概括为单一的促进或抑制效应。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2bb36f7fcdf84db78fa48a12\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"supplement_material\"\n        ],\n        \"value\": {\n          \"auxiliary_material\": [\n            \"综述提供了“肠道微生物群 - 代谢物 - 免疫轴”的整体概念框架，解释了代谢物如何作为分子信使从肠腔易位至体循环并调节全身及局部抗肿瘤免疫。\",\n            \"文中还总结了其他核心代谢物（如短链脂肪酸、色氨酸代谢物、胆汁酸）调节免疫的具体机制及在不同肿瘤类型（如食管癌、胃癌、肝癌、结直肠癌、黑色素瘤、肾细胞癌）中的微生物特征签名，为理解肌苷在整体代谢网络中的位置提供了背景。\",\n            \"讨论了针对微生物组的干预策略（如 FMT、益生菌、工程菌）在增强 ICI 疗效方面的转化潜力和当前面临的标准化、安全性及监管挑战。\"\n          ],\n          \"evidence\": [],\n          \"gap_id\": \"case_C2_inosine_tme\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\level2\\\\external\\\\Nf2f13ca37a1cba78c9d1-acf4314fb7d520c6\\\\round_3\\\\supplements\\\\case_C2_inosine_tme\\\\attempt-gam_e3ai\\\\source_units\\\\SU02_search_candidate_7089b09315\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"该综述未提供人体肿瘤微环境（TME）内肌苷的绝对生理浓度数值（如μM 或 ng/mL），也未报告人体临床队列中肌苷水平与 ICI 疗效（如 OS、PFS、ORR）的具体统计学关联数据。文中关于肌苷浓度的描述主要引用了小鼠模型的血浆代谢组分析或体外实验背景，缺乏针对接受 ICI 治疗的人类患者肿瘤组织或间质液的实测浓度数据。\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": [\n            \"该综述详细阐述了肌苷（inosine）作为肠道微生物代谢物调节抗肿瘤免疫的三大分子机制：(1) 特异性抑制肿瘤细胞内的泛素样修饰激活酶 6（UBA6）活性，提高肿瘤免疫原性；(2) 结合 T 淋巴细胞上的腺苷 A2A 受体，激活 cAMP-CREB 信号级联，促进 Th1 细胞分化及肿瘤浸润；(3) 在葡萄糖受限的肿瘤微环境（TME）中作为替代能源底物维持效应 T 细胞的生存和细胞毒性功能。\",\n            \"文中指出肌苷由特定肠道菌群（如假长双歧杆菌 Bifidobacterium pseudolongum、约氏乳杆菌 Lactobacillus johnsonii 等）合成，并在免疫检查点阻断（ICB）治疗破坏肠道屏障完整性后易位至体循环，从而激活抗肿瘤 T 细胞。\",\n            \"综述提及了临床转化潜力，指出在存在肌苷代谢缺陷的实体瘤中，外源性肌苷补充可能恢复免疫细胞代谢适应性，从而增强 ICI 疗效，这为理解肌苷浓度与疗效的关系提供了理论框架。\"\n          ]\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::797da90ccaff14b0fe6ff1dc\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"supplement_materials\"\n        ],\n        \"value\": [\n          {\n            \"auxiliary_material\": [\n              \"综述提供了“肠道微生物群 - 代谢物 - 免疫轴”的整体概念框架，解释了代谢物如何作为分子信使从肠腔易位至体循环并调节全身及局部抗肿瘤免疫。\",\n              \"文中还总结了其他核心代谢物（如短链脂肪酸、色氨酸代谢物、胆汁酸）调节免疫的具体机制及在不同肿瘤类型（如食管癌、胃癌、肝癌、结直肠癌、黑色素瘤、肾细胞癌）中的微生物特征签名，为理解肌苷在整体代谢网络中的位置提供了背景。\",\n              \"讨论了针对微生物组的干预策略（如 FMT、益生菌、工程菌）在增强 ICI 疗效方面的转化潜力和当前面临的标准化、安全性及监管挑战。\"\n            ],\n            \"evidence\": [],\n            \"gap_id\": \"case_C2_inosine_tme\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\level2\\\\external\\\\Nf2f13ca37a1cba78c9d1-acf4314fb7d520c6\\\\round_3\\\\supplements\\\\case_C2_inosine_tme\\\\attempt-gam_e3ai\\\\source_units\\\\SU02_search_candidate_7089b09315\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"该综述未提供人体肿瘤微环境（TME）内肌苷的绝对生理浓度数值（如μM 或 ng/mL），也未报告人体临床队列中肌苷水平与 ICI 疗效（如 OS、PFS、ORR）的具体统计学关联数据。文中关于肌苷浓度的描述主要引用了小鼠模型的血浆代谢组分析或体外实验背景，缺乏针对接受 ICI 治疗的人类患者肿瘤组织或间质液的实测浓度数据。\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": [\n              \"该综述详细阐述了肌苷（inosine）作为肠道微生物代谢物调节抗肿瘤免疫的三大分子机制：(1) 特异性抑制肿瘤细胞内的泛素样修饰激活酶 6（UBA6）活性，提高肿瘤免疫原性；(2) 结合 T 淋巴细胞上的腺苷 A2A 受体，激活 cAMP-CREB 信号级联，促进 Th1 细胞分化及肿瘤浸润；(3) 在葡萄糖受限的肿瘤微环境（TME）中作为替代能源底物维持效应 T 细胞的生存和细胞毒性功能。\",\n              \"文中指出肌苷由特定肠道菌群（如假长双歧杆菌 Bifidobacterium pseudolongum、约氏乳杆菌 Lactobacillus johnsonii 等）合成，并在免疫检查点阻断（ICB）治疗破坏肠道屏障完整性后易位至体循环，从而激活抗肿瘤 T 细胞。\",\n              \"综述提及了临床转化潜力，指出在存在肌苷代谢缺陷的实体瘤中，外源性肌苷补充可能恢复免疫细胞代谢适应性，从而增强 ICI 疗效，这为理解肌苷浓度与疗效的关系提供了理论框架。\"\n            ]\n          }\n        ],\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0f7368223bdbf2801e243e0b\",\n        \"source_handle\": \"P0594\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::82bffb4d0f097201933ac437\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::20b7c9407887887b4c1955c1\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"structured_partial\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d407e9afd4edab967034fec5\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0f02e6b98612c18ae9aa0912\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用回顾性分析设计，整合两项独立的I期随机临床试验数据。纳入接受nivo/ipi或cabo/nivo +/- CBM588治疗的mRCC患者。收集基线和第12周的粪便样本进行宏基因组测序（MetaPhlan v4）。主要分析方法包括：1) 比较SOC组与SOC/CBM组在基线和第12周的Alpha和Beta多样性；2) 使用Wilcoxon配对检验评估临床相关微生物物种丰度的变化；3) 计算Firmicutes/Bacteroidetes比率以衡量菌群失调程度。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e59dd59a101dcc1ad5120ae2\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了CBM588调节肠道微生物组的直接证据，特别是其能防止Eubacterium siraeum耗竭并纠正Firmicutes/Bacteroidetes比率失衡，这为之前观察到的临床获益提供了生物学机制假设。\",\n          \"limits\": \"样本量较小（N=58），且为I期试验数据的二次分析；仅报告了微生物组变化，未直接关联临床结局数据（如ORR、PFS）；未区分两种不同的ICI联合方案对微生物组影响的潜在差异；缺乏长期随访数据。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b3a3638adfa01b7db6729e9c\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"SOC组 vs SOC/CBM组，基线 vs 第12周\",\n          \"finding\": \"两组间Alpha和Beta多样性在第12周均无统计学显著差异。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1fabca92c6655ca00f603409\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"SOC组，基线 vs 第12周\",\n          \"finding\": \"Alistipes senegalensis减少（LFC -0.82, P=0.004）；Eubacterium siraeum显著减少（LFC -1.75, P=0.005）；Firmicutes/Bacteroidetes比率从89.0%增加到96.4%（提示菌群失调加重）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::04e5819886921a9c0c850bcc\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"SOC/CBM组，基线 vs 第12周\",\n          \"finding\": \"Alistipes senegalensis减少（LFC -0.36, P=0.007）；Eubacterium siraeum未发生显著减少；Firmicutes/Bacteroidetes比率从100.0%显著下降到75.7%（提示菌群失调改善）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cb42b8b8bbb293987a68d708\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4d9086cad83959bd751a5143\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"在mRCC患者中，添加CBM588到一线ICI联合治疗方案中，如何影响肠道微生物组的组成和菌群失调状态？其是否通过调节微生物组来介导临床获益？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a35910d01fdeeda24d7f32b7\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"转移性肾细胞癌（mRCC）患者，接受一线免疫检查点抑制剂（ICI）联合治疗（纳武利尤单抗/伊匹木单抗或卡博替尼/纳武利尤单抗），部分患者联合使用活体生物疗法CBM588。样本来自两项I期临床试验的合并队列，共58名患者。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::258b37d2499172ba1cff0c79\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究旨在探讨活体生物疗法CBM588对接受一线ICI联合治疗的mRCC患者肠道微生物组组成及菌群失调的影响。研究团队合并了两项I期随机临床试验的数据，对比了标准治疗（SOC）组与SOC联合CBM588组在基线和第12周时的肠道微生物多样性及组成变化。结果显示，CBM588显著改善了菌群失调指标，并防止了与ICI疗效相关的特定菌种耗竭，为CBM588增强临床疗效提供了潜在的微生物机制解释。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b5e043583ccc1fe222739c3e\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限mRCC人群；仅涉及CBM588这一种干预手段；未提供临床终点与微生物变化的直接相关性统计，仅作为机制推测的基础。\",\n          \"contribution\": \"提供了CBM588干预下mRCC患者肠道微生物组的具体变化图谱。显示CBM588能逆转ICI治疗常见的菌群失调趋势（降低F/B比率），并维持Eubacterium siraeum水平。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3e2e9022343dde30c2c59134\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"这是基于观察到的微生物变化的“合理机制推测”，而非经过功能验证的因果证据。需结合其他研究确认E. siraeum在ICI疗效中的具体功能角色。\",\n          \"contribution\": \"提出了CBM588通过防止有益菌（E. siraeum）耗竭和纠正菌群失调来介导临床获益的潜在机制路径。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ba9383b3b5e904f75192b855\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"CBM588作为一种基于丁酸梭菌的活体生物疗法，在mRCC ICI治疗中的应用背景。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b804adfbf51285c1c31a6f4b\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"使用MetaPhlan v4进行分类学分析，以及使用F/B比率作为菌群失调指标的实践。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::97e7c7edd83bd6527d2faa0a\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究为I期试验数据的汇总分析，样本量有限，结果可能受选择偏倚影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c7b3c7922923705e274e4c3c\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"发现的微生物变化是观察性关联，不能直接推断为导致临床获益的唯一或主要原因。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6d36c9ac49a58ab6342c847a\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"未区分nivo/ipi和cabo/nivo两种方案对微生物组的不同影响，可能存在混杂因素。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4918986773f2c4c113ef4aeb\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者声称的“机制”是基于微生物组变化的推论，需警惕将相关性误读为因果性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1be8973fcdd65f0d70e4a179\",\n        \"source_handle\": \"P0006\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"structured source contained metadata or abstract without a research body\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"html\",\n              \"reason\": \"html_challenge_or_login\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"html\",\n              \"reason\": \"html_challenge_or_login\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"html\",\n              \"known_losses\": [\n                \"headings/tables/math/image pixels are not preserved by this plain HTML projection\"\n              ],\n              \"reason\": \"body converted to structured material; headings/tables/math/image pixels may be lost\",\n              \"status\": \"derived\"\n            }\n          ],\n          \"material_scope\": \"structured_partial\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ae6fc092083bad76a3be286e\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4c55b9ec1ec7d88603525d32\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"abstract\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5b4a031bb38fe09efcf8c017\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::94e57fc3b489cc0cf77510e9\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用回顾性分析设计，合并两项独立的I期随机临床试验数据。纳入接受nivo/ipi或cabo/nivo +/- CBM588治疗的mRCC患者。使用MetaPhlan v4进行分类学分析，计算Alpha和Beta多样性。利用Wilcoxon配对检验评估从基线到第12周临床相关微生物物种丰度的变化。计算Firmicutes/Bacteroidetes比率作为菌群失调的衡量指标，并比较SOC组与SOC/CBM组的差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ab294fa19d5ef32aaf225ec4\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了CBM588调节肠道微生物组的直接证据，特别是其能防止Eubacterium siraeum耗竭并纠正F/B比率升高，这可能与改善ICI疗效有关。\",\n          \"limits\": \"仅基于两项I期试验的合并小样本（N=58）分析，缺乏长期随访和临床终点（如OS/PFS）的直接关联分析。未交代具体的统计校正方法（如多重比较校正）。所给摘要未交代微生物组变化与具体临床响应率之间的直接相关性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e0ec617ba1358cc1537f956c\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"SOC组 vs SOC/CBM组，基线 vs 第12周\",\n          \"finding\": \"两组间Alpha和Beta多样性在基线与第12周之间无统计学显著差异。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0bcd6ee9235948b878cabb1d\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Alistipes senegalensis丰度变化\",\n          \"finding\": \"在SOC组和SOC/CBM组中均显著下降（SOC: LFC -0.82, P=0.004; SOC/CBM: LFC -0.36, P=0.007）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0a59e48ba3392ee02df080ba\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Eubacterium siraeum丰度变化\",\n          \"finding\": \"仅在SOC组中显著下降（LFC -1.75, P=0.005），而在SOC/CBM组中未观察到显著下降。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e560305c8a691f0fbab646ed\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Firmicutes/Bacteroidetes比率变化\",\n          \"finding\": \"SOC组从89.0%增加至96.4%；SOC/CBM组从100.0%显著下降至75.7%。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8f61ef01720e7a9580955c6d\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0cc71cf5ee6821ea9fb384e8\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"在mRCC患者中，补充CBM588如何影响肠道微生物组的组成和菌群失调状态？其是否通过调节微生物组来增强ICI治疗的潜在疗效？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a95d397296501b878a36122b\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"转移性肾细胞癌（mRCC）患者，接受一线免疫检查点抑制剂（ICI）联合治疗（纳武利尤单抗/伊匹木单抗或卡博替尼/纳武利尤单抗），并补充活体生物制剂CBM588。研究基于两项I期临床试验的合并队列。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3d53d8d244ac5dadc9c8db42\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究旨在探讨活体生物制剂CBM588对接受一线ICI联合治疗的mRCC患者肠道微生物组组成及菌群失调的影响。通过整合两项随机I期临床试验的数据，比较标准治疗（SOC）与SOC联合CBM588两组患者在基线和第12周的肠道微生物多样性、物种丰度变化以及Firmicutes/Bacteroidetes比率的变化。结果显示，CBM588显著纠正了菌群失调指标，并防止了与ICI反应相关的特定菌种耗竭，为CBM588改善临床结局提供了潜在的微生物机制解释。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::56c7a21a7e043192307dcd02\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限mRCC人群；仅涉及CBM588一种制剂；样本量较小（N=58）；主要关注微生物组变化而非直接的临床疗效关联。\",\n          \"contribution\": \"提供了益生菌（CBM588）调节肠道微生物组以可能增强ICI疗效的具体案例。数据显示CBM588能阻止有益菌（E. siraeum）的耗竭，并改善菌群失调指标（F/B比率）。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e112410630a7f26d1436ed76\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制仅为作者提出的“合理推测”（plausible mechanism），需结合其他文献验证E. siraeum在ICI反应中的具体生物学功能。F/B比率作为单一指标的局限性需注意。\",\n          \"contribution\": \"提出了一个潜在的机制路径：通过维持Eubacterium siraeum等关键菌种的丰度和纠正F/B比率失衡，CBM588可能介导了对ICI治疗的更好反应。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a16deb1dc752dca76ce15dc5\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"CBM588作为一种基于梭菌的活体生物制剂，在mRCC ICI治疗中的应用背景。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::618cb7487f6d9c41a8e420de\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"使用Firmicutes/Bacteroidetes比率作为肠道菌群失调（dysbiosis）的衡量指标。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e95988c8996b35e4279714c3\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究仅分析了微生物组组成的变化，未直接报告临床疗效（如客观缓解率、无进展生存期）与微生物组变化的相关性，因此不能直接推断临床获益是由这些微生物变化介导的，只能说是提供了机制上的合理性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b33eb01193cd43e23b95260c\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"样本量较小且来自两项I期试验的合并，可能存在选择偏倚或统计效力不足。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7e2209dfb8403e22d1a38190\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"F/B比率的变化方向在不同研究中可能有不同解读，需结合具体上下文。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::af35102db01eb2fc25e37a92\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"所给摘要未交代是否进行了多重比较校正，P值结果需谨慎解读。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::77c5586d6a6da541552def5e\",\n        \"source_handle\": \"P0143\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"no complete research body was indexed\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"only abstract or non-title snippets were available\",\n              \"status\": \"partial\"\n            }\n          ],\n          \"material_scope\": \"abstract_only\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::890fce072a8f724aaec9108f\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::08ad0f10b9a6304213fa3965\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"abstract\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::34d5ad06a0f4dbf0cd215280\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::33421e58bdd46bb513cd9861\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用分阶段的 I/II 期临床试验设计。Part A 为已完成的安全性评估阶段，纳入 12 名经 Safety Review Committee 审核的患者。Part B 为扩展招募阶段，针对 RCC、NSCLC 或膀胱癌患者。入组标准严格定义为 ICIs 耐药：即初始对 PD-1 通路靶向治疗有反应，但在最后一次给药后 12 周内出现由两次间隔至少 4 周的影像学扫描确认的疾病进展，且无快速临床进展。治疗方案为每日两次口服 MRx0518（1×10^10 至 1×10^11 CFU）联合每三周一次静脉注射 pembrolizumab（200 mg）。主要终点为第一周期治疗期间的毒性监测（安全性），次要终点包括客观缓解率（ORR）、缓解持续时间（DOR）、疾病控制率（DCR）和无进展生存期（PFS）。探索性终点涉及生物标志物、微生物组影响、总生存期（OS）以及与 PD-L1 CPS/TPS 的相关性。样本采集包括血液、粪便、尿液及可选的组织活检。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7ba7d70347450f2d6caa42c1\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了 MRx0518 在 ICIs 耐药实体瘤患者中与 pembrolizumab 联合使用的早期临床开发框架和部分安全性结论（Part A 完成并通过审查）。明确了此类难治性人群的定义标准和试验设计细节。\",\n          \"limits\": \"所给摘要未交代任何具体的疗效数据、安全性不良事件详情或机制探索结果。Part B 仍在招募中，因此缺乏完整的临床结局证据。无法从当前材料中得出关于该疗法有效性的结论。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::857a3aff9040d0ca5274fd8f\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Part A: 12 名 mRCC 和 mNSCLC 患者，联合使用 MRx0518 与 pembrolizumab\",\n          \"finding\": \"所给摘要未交代具体的安全性数据结果、疗效数据（ORR, DCR, PFS 等）或生物标志物分析结果。仅陈述 Safety Review Committee 判定 Proceed to Part B 是适当的。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1f6fc071497e765cf0bf7f37\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1fddd054cd361aa8965f6785\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"既往研究表明 MRx0518 具有免疫刺激作用，但在对免疫检查点抑制剂产生耐药性的实体瘤患者中，将其与 pembrolizumab 联合使用的安全性和潜在临床益处尚不明确。本研究试图解决如何逆转或克服 ICIs 耐药的问题。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dc4609987a117e2afc41874f\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"针对对免疫检查点抑制剂（ICIs）耐药的实体瘤患者，评估新型口服活体生物制剂 MRx0518（一种源自人肠道微生物群的 Enterococcus 属细菌）与 pembrolizumab 联合治疗的临床安全性及初步疗效。研究队列包括转移性肾细胞癌（mRCC）、非小细胞肺癌（mNSCLC）和膀胱癌患者。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::74fdb746ae398fcc75225601\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该论文报告了一项 I/II 期临床试验的进展摘要。研究分为两部分：Part A 已完成，评估了 12 名 mRCC 和 mNSCLC 患者的联合治疗安全性；Part B 正在招募中，计划在每个适应症中额外招募最多 30 名患者。MRx0518 被选为开发候选药物是因为其体外和体内研究显示具有强效免疫刺激活性，能抑制肿瘤生长并调节 T 细胞分化。本研究旨在验证在 ICIs 耐药背景下，该联合疗法是否安全并能提供临床获益。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2806d2e7ae81fa8671642ad8\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"由于缺乏疗效结果，不能证明 MRx0518 确实改善了耐药患者的预后。仅能说明这是一种正在进行的探索性策略。\",\n          \"contribution\": \"提供了针对 ICIs 耐药实体瘤患者的具体临床干预方案（MRx0518 + pembrolizumab）。定义了“耐药”的临床操作标准（初始响应后进展，影像学确认，时间窗口限制）。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3182795180c617396619901f\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"这些机制描述来源于体外和动物模型的前体研究，而非本临床试验的直接发现。本摘要未提供本研究中实际观察到的机制关联数据。\",\n          \"contribution\": \"介绍了 MRx0518 的拟议作用机制基础（基于前体研究：减少 Treg，增加 Th1/Tc1，增加肿瘤内 CD4+/CD8+ T 细胞和 NK 细胞）。列出了探索性生物标志物收集计划（血液、粪便、组织活检以评估免疫标记和微生物组）。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fae60c3135d79d2ec0ad8022\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"对 ICIs 耐药的具体定义：初始 PD-1 靶向治疗有益，但随后出现影像学确认的进展，且在末次给药后 12 周内发生，无快速临床恶化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fdb1e41109948840959d1af2\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"MRx0518 作为一种单菌株口服活体生物制剂，已进入 I/II 期临床试验，并与 pembrolizumab 联用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::123238ea93afd3b66e33d152\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该论文仅为临床试验摘要，未包含 Part A 的具体安全性数据或 Part B 的任何疗效数据。所有关于“有效性”或“安全性结论”的推断均不可基于此材料。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::716270a739dcf95bd2590cd6\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中提到的免疫调节机制（Treg/Th1/Tc1 变化等）是基于前体研究（in vitro/in vivo models）的描述，并非本临床试验的实际结果。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9bf8d3adffc219b7809a76e9\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"研究对象限定为对 ICIs 耐药的实体瘤患者，结果外推至初治患者或其他癌症类型需谨慎。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::609824f052eda0bd59878be5\",\n        \"source_handle\": \"P0125\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"no complete research body was indexed\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"only abstract or non-title snippets were available\",\n              \"status\": \"partial\"\n            }\n          ],\n          \"material_scope\": \"abstract_only\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::f63dfcb79a3ed06be7080d88\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ae4ff46b42d0693e6d3e87c2\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"abstract\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::31bcd1d7c5eddf4c0e908bd4\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::de3e4327fc150f8a04e4f48a\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用单臂、开放标签的I期临床试验设计（Part A部分）。入组标准为：既往接受过至少一种ICI治疗（单药或联合），且根据RECIST 1.1标准确认疾病稳定（SD）或进展（PD），但在最后一次ICI剂量后12周内无快速临床进展。治疗方案为口服MRx0518（1×10^10至1×10^11 CFU，每日两次）联合静脉注射帕博利珠单抗（200 mg，每3周一次），最多35个周期。安全性通过监测第一周期的毒性进行评估；疗效通过每9周一次的影像学评估（RECIST 1.1）确定ORR、DCR和PFS。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::12d23d367b3aa2af5ec2341e\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了首个基于肠道微生物组的单菌株活体生物疗法MRx0518与ICI联合使用的早期临床数据，证实了该组合在难治性实体瘤中的可耐受性和初步疗效信号。\",\n          \"limits\": \"样本量极小（仅12名患者），仅为I期Part A部分的数据，缺乏对照组，无法确立因果效力或普遍适用性；随访时间较短，长期生存数据未知。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d8c05c0b76b07e9a430e62d2\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"mRCC (n=9) 和 mNSCLC (n=3) 患者，中位既往治疗线数为3线，83%既往接受过纳武利尤单抗治疗，83%既往最佳反应为SD。\",\n          \"finding\": \"安全性方面：联合方案显示积极的 profiles，无治疗相关的严重不良事件（SAEs），无因毒性导致的药物停药，未报告irAEs增加。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::88dd55e8b41e1fb4a2b91e41\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"同一队列，数据截止日为2020年8月21日。\",\n          \"finding\": \"疗效方面：2名RCC患者和1名NSCLC患者达到部分缓解（PR）；另外2名RCC患者获得持久性疾病稳定（SD，分别为6个月和13个月）。协议定义的DCR为42%。中位PFS为2.14个月。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b06a57529aac98a77c03379a\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::58164c8a42c60670eb2be979\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"评估源自肠道微生物组的单菌株活体生物疗法MRx0518与免疫检查点抑制剂帕博利珠单抗联合使用，在对ICI难治性实体瘤患者中的安全性和初步疗效；验证其作为“首次概念证明”（proof of concept）的潜力。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3ee06848cac0ca5b43471cc4\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"该研究针对对免疫检查点抑制剂（ICIs）难治性的实体瘤患者，具体包括转移性肾细胞癌（mRCC）和转移性非小细胞肺癌（mNSCLC）。研究对象为重度预处理的晚期癌症患者。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b8755d691cbde8613902fde8\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究是一项在临床开发阶段的活体生物疗法MRx0518与帕博利珠单抗（pembrolizumab）联合治疗实体瘤的I期临床试验摘要。MRx0518是一种源自人类肠道微生物组的单菌株活体生物疗法。研究旨在评估该联合方案的安全性及初步疗效信号。试验招募了既往接受过ICI治疗但疾病稳定或进展的患者，给予MRx0518胶囊与帕博利珠单抗联合治疗。主要终点为安全性，次要终点包括客观缓解率（ORR）、缓解持续时间（DOR）、疾病控制率（DCR）和无进展生存期（PFS）。结果显示联合方案耐受性良好，无治疗相关严重不良事件，并观察到初步的抗肿瘤活性信号。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2eb07e4515a6f6274042df72\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限I期小规模队列，未区分不同肿瘤类型的细微差异，且未提供长期生存数据。\",\n          \"contribution\": \"提供了具体的临床案例证据：在ICI难治性实体瘤患者中，使用源自肠道微生物组的MRx0518联合帕博利珠单抗，实现了42%的疾病控制率和部分缓解，表明微生物疗法可能恢复或增强ICI的疗效。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2a9da280b3a65057ec42b10c\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制描述主要基于临床前小鼠模型和体外观察，临床样本中的具体分子通路验证程度在摘要中未详细展开。\",\n          \"contribution\": \"提供了潜在的机制线索：摘要指出MRx0518通过激活肿瘤TLR5（与细菌鞭毛蛋白有关），诱导NFκB、细胞因子反应以及IFNγ+ CD4+和CD8+ T细胞的浸润，同时减少Tregs。这解释了微生物如何通过先天免疫受体激活适应性免疫反应。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cfe2ac8596053eb7b05cf92c\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"MRx0518的开发背景、靶点（TLR5）、以及其在难治性患者中的初步表现。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e5335bbb9e25a40d0f12e67b\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"MRx0518的单菌株特性及其特定的免疫调节作用（增加CD4+/CD8+ T细胞，减少Tregs）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2db21538e2237482eea7e051\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究仅为I期部分数据，样本量极小（n=12），结果具有高度不确定性，不能推广到所有实体瘤或所有ICI类型。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3a29df783d5f62b48b8745dd\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"机制描述主要基于临床前数据，临床层面的机制验证有限。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3febee417218564a2917e173\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者声称的“首次概念证明”需结合后续更大规模的II期试验结果来评估其实际意义。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6ad237fc5e6520b4e44cd335\",\n        \"source_handle\": \"P0230\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"no complete research body was indexed\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"only abstract or non-title snippets were available\",\n              \"status\": \"partial\"\n            }\n          ],\n          \"material_scope\": \"abstract_only\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::791f861f7c03887eb2ba1797\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e36b8ae8a47bfa189578b077\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"abstract\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1abb1f499d4b18e3ba0b2445\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c832fc4e8d623472abd78964\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用单臂、开放标签的早期临床试验设计。纳入标准：组织学确诊的实体瘤、计划进行手术切除、初治患者。干预措施：口服 MRx0518（1x10^10 至 1x10^11 CFU），每日两次，持续至术前一天（最长28天）。数据收集：记录不良事件以评估安全性；收集治疗前（诊断性活检）和治疗后（手术标本）的配对样本，利用 NanoString Pan Cancer IO 360™ 基因表达面板进行转录组分析，同时计划进行微生物组和代谢组分析。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ee730c6fb553203920c4f1d3\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了 MRx0518 在人类实体瘤患者中短期使用的安全性数据，证实了其良好的耐受性。\",\n          \"limits\": \"样本量小（n=17），且仅分析了前 5 对样本的基因表达数据，缺乏统计效力来确立普遍性的免疫调节模式。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6914591d6c7a033541c2ca5c\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"初步证据表明 MRx0518 可能在体内诱导与临床前模型相似的免疫激活信号（基因表达变化）。\",\n          \"limits\": \"基因表达变化的具体机制和功能后果尚未经过充分验证；未提供疗效（如肿瘤缩小）的直接证据，因为主要终点是安全性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a662b667b1877fd96be85eae\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"确立了在新辅助设置中使用配对活检样本评估微生物疗法对宿主免疫影响的方法学可行性。\",\n          \"limits\": \"由于 COVID-19 疫情导致手术延迟，部分患者的治疗窗口可能受到影响，且后续 Part B 才包含安慰剂对照和更大规模的疗效评估。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::050ef7985358839115d23429\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Part A, n=17 (breast n=8, prostate n=4, uterine n=3, melanoma n=1, bladder n=1), treatment naive, solid tumours awaiting surgery\",\n          \"finding\": \"MRx0518 单药治疗显示出良好的安全性和耐受性，未报告 3/4 级 CTCAE 毒性，无严重不良反应或治疗中断。所有患者均接受了手术（3例因新冠疫情延迟）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d91e41044a5504a649b0790b\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"First 5 paired samples analysed using NanoString Pan Cancer IO 360™ Gene Expression panel\",\n          \"finding\": \"在 48 个基因中观察到显著的基因表达谱变化（p < 0.05），提示免疫细胞浸润增加，这与临床前模型中的观察结果一致。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c4430d5dc91f31190a4aac67\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7a24fec7a0be7048481d6e85\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"评估 MRx0518 作为单药治疗在实体瘤患者中的安全性和耐受性；探索其是否能在人体内重现临床前观察到的免疫刺激效应，并识别潜在的疗效生物标志物。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2ed91443e7efcd18fea2478a\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"接受手术切除治疗的初治实体瘤患者（包括乳腺癌、前列腺癌、子宫内膜癌、黑色素瘤和膀胱癌），在术前新辅助阶段口服活体生物制剂 MRx0518。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c2cadd7907d1344788012875\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该研究是一项针对新型肠道微生物来源口服活体生物制剂 MRx0518 的早期临床试验，旨在评估其在实体瘤患者中的安全性和耐受性，并探索其对免疫微环境的潜在调节作用。MRx0518 源自粪肠球菌，临床前研究显示其能诱导 NK 细胞及 CD8+、CD4+ T 细胞的肿瘤浸润。本研究招募了 17 名初治患者，每日两次服用胶囊，直至术前一天。主要终点为安全性，次要探索性终点包括通过 NanoString 基因表达面板分析配对活检样本中的基因表达变化、微生物组分析及代谢标志物检测。结果显示药物耐受性良好，且初步基因分析显示部分患者存在显著的免疫相关基因表达改变。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::76a06f54ec53518c2fd3f0d8\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限 Part A 的前 5 对样本分析，未涉及与免疫检查点抑制剂（ICI）联合用药的实际疗效数据。\",\n          \"contribution\": \"提供了 MRx0518 在实体瘤患者中诱导免疫相关基因表达变化的初步人体数据。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::450256474c35f73fc1d99d21\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制推断基于基因表达谱，而非直接的因果实验（如细胞因子测定或功能实验）。\",\n          \"contribution\": \"揭示了 MRx0518 可能通过上调特定免疫基因（48个显著变化基因）来介导免疫刺激，支持其作为免疫佐剂的潜力。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dfe1ba291db24589843418c2\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"MRx0518 的临床前有效性数据（小鼠模型中的肿瘤生长减少和免疫细胞浸润）及其在人体中的安全性概况。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::02c73f928a808336678dd89e\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"本研究仅评估 MRx0518 单药的安全性，而提及正在进行的与其他疗法（如 ICI）的组合试验。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dd97f6a487160acdff3ecad1\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究未直接测试 MRx0518 与免疫检查点抑制剂（ICI）的联合疗效，因此不能直接回答 F1 中关于“调节 ICI 疗效”的核心问题，只能提供潜在的机制基础。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::60476a33589b69030f041294\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"基因表达变化的样本量极小（n=5），结果具有探索性，不应被视为确证的生物学标志物。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ff1c3e9435300c89bc14e0e3\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"COVID-19 导致的延误可能引入了混杂因素，尽管主要结论基于安全性，但需注意治疗依从性或时长的潜在变异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::24455e3eb4ee44719fa5d1b3\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者声称的“免疫细胞浸润增加”是基于基因表达数据的推断，需结合其他独立验证数据（如流式细胞术或免疫组化）才能确证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1b72dfac1acebcb739cc06f8\",\n        \"source_handle\": \"P0244\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"no complete research body was indexed\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"local source was absent or unreadable\",\n              \"status\": \"partial\"\n            }\n          ],\n          \"material_scope\": \"abstract_only\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::20309b87fd0e8cfe50d8893d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b674221023c1dbcd1a299114\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c2620bcc444fc1598dd43ce6\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0f036c918cd390f5edcdaebe\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用还原论视角，从生态水平的菌群相关性分析转向分子水平的机制解析。具体路线包括：1) 梳理建立相关性的大规模测序研究和动物模型实验；2) 验证相关性并识别宿主表型（如CD8+ T细胞浸润）；3) 深入探讨具体的分子机制，分为T细胞刺激、髓系细胞刺激和分子模拟三个子主题；4) 评估基于分子机制的工程化益生菌应用前景。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e6663c1509a79bf070ff83d5\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"系统性地从分类学相关性过渡到分子机制，详细列举了多种微生物代谢物和蛋白质如何通过特定受体（GPCRs, A2AR, STING, NOD2, TLR5）和信号通路影响宿主免疫系统。\",\n          \"limits\": \"所给摘要未交代具体的文献检索策略和纳入排除标准；主要依赖已发表的小鼠模型和少量临床数据，缺乏大规模前瞻性干预试验的直接证据；对于非细菌类微生物（真菌、古菌）及抑制性微生物的关注不足。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::efc4edd784b59555aab5bd43\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"小鼠模型及患者队列中的相关性研究\",\n          \"finding\": \"特定细菌属（如双歧杆菌、拟杆菌、阿克曼氏菌、普拉梭菌）的存在与ICB疗效正相关，但不同研究间结果存在异质性，且相关性不等于因果性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::39351d21f351bf132aaa24af\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"粪菌移植（FMT）和单菌定植实验\",\n          \"finding\": \"来自响应者的FMT可重现抗肿瘤效应，增加肿瘤内CD8+ T细胞浸润；特定菌株（如A. muciniphila, Bifidobacterium spp.）的单菌定植足以增强ICB疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2a2ad8f127a3e2f7fb383b60\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"短链脂肪酸（SCFAs）的作用\",\n          \"finding\": \"SCFAs（如丁酸盐）对ICB的影响具有双重性：通常促进Treg和效应T细胞分化，但在某些情况下（如抗CTLA-4治疗）可能产生负面影响。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4abe48e8e01b0acc7b17e16a\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"肌苷（Inosine）通路\",\n          \"finding\": \"B. pseudolongum等产生的肌苷通过结合T细胞上的A2AR受体，协同TLR9激动剂增强抗CTLA-4疗效，但单独使用不足以完全重现表型。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::44f2d548690b4b10bf73e2c7\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Akkermansia muciniphila与STING通路\",\n          \"finding\": \"A. muciniphila产生cdAMP，激活STING信号，诱导I型干扰素产生，招募NK细胞和树突状细胞，从而增强抗肿瘤免疫。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e7fda87890cf100670bbed03\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Enterococcus sagA蛋白与NOD2通路\",\n          \"finding\": \"肠球菌表达的SagA蛋白降解肽聚糖产生muropeptides，激活宿主NOD2受体，促进炎症环境和CD8+ T细胞浸润。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4a33dc878424e5c612918cf2\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"分子模拟机制\",\n          \"finding\": \"E. hirae中的噬菌体尾长测量蛋白（TMP）含有与宿主PSMB4蛋白相似的表位，引发交叉反应性CD8+ T细胞，增强抗PD-1疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::41b69dd74275e596257e7f30\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ecae2ad21b9875306feb272\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管已知特定微生物群与ICB疗效相关，但确切的分子机制尚不清楚，这限制了将微生物作为精准医疗手段加以利用的能力。本文试图回答：哪些具体的微生物分子特征（蛋白质、酶、代谢物）介导了这种调节作用？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::68dac395c061b642520773c2\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"人类微生物群（特别是肠道菌群）与癌症免疫治疗中免疫检查点阻断（ICB，如抗PD-1/PD-L1和抗CTLA-4抗体）疗效之间的关系。研究范围涵盖从宏观的菌群组成相关性到微观的分子机制（代谢物、蛋白质、抗原模拟），以及基于这些机制的工程化益生菌策略。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c8095064895dfad406e569df\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇综述，旨在总结宿主-微生物相互作用在检查点抑制剂免疫治疗背景下的分子理解进展。文章首先回顾了通过小鼠模型和患者队列建立的菌群与ICB疗效之间的相关性，指出仅凭分类学关联难以确定因果关系。随后，重点阐述了具体的微生物分子机制，包括短链脂肪酸（SCFAs）、肌苷（inosine）、环二腺苷酸（cdAMP）、肽聚糖片段（muropeptides）和鞭毛蛋白（flagellin）如何分别通过T细胞刺激、髓系细胞激活或分子模拟来增强抗肿瘤免疫。最后，讨论了利用这些分子特征设计下一代工程化益生菌以改善治疗反应的潜力，并指出了当前研究在真菌/古菌、抑制性微生物及远端器官微生物方面的局限。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::599e6bf17709ba8cfbd90929\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"这些机制大多基于小鼠模型或体外实验，部分已在早期临床试验中探索（如MRx0518），但尚未成为标准治疗指南；不同菌株间存在显著差异，不能简单外推至所有同种细菌。\",\n          \"contribution\": \"提供了肠道微生物群影响ICB疗效的具体生物学途径和关键分子中介。例如，明确了A. muciniphila通过cdAMP-STING轴、肠球菌通过SagA-NOD2轴、以及双歧杆菌通过肌苷-A2AR轴增强抗肿瘤免疫的具体机制。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2a57617739887231108e77d5\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制的复杂性在于多种微生物可能通过相同或不同的路径产生相似效果（冗余性），且单一代谢物往往不足以完全重现体内复杂的生态效应（如肌苷需配合TLR9激动剂）。\",\n          \"contribution\": \"详细描述了介导效应的具体分子机制，包括代谢物（SCFAs, inosine, cdAMP）、蛋白质（SagA, flagellin）和抗原模拟（TMP）。解释了这些分子如何被宿主受体识别并触发下游信号级联反应（如I型干扰素产生、Th1分化、CD8+ T细胞浸润）。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4eb4f4671e999f3795550859\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"综述指出目前大多数研究集中在细菌，而忽略了真菌、古菌以及具有免疫抑制作用的负相关微生物；同时提到了远端器官（如肿瘤内部）微生物群的潜在作用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::07f07877dcebdfd835240f4c\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"对比了生态方法（FMT、饮食调整、定义菌群）与还原论方法（小分子、工程化益生菌）的优缺点。指出前者面临标准化和个体差异挑战，后者更具精准性但开发难度大。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3730e786b8b2831b6d7fa00a\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中提到的许多机制（如cdAMP, SagA）主要在小鼠模型中验证，其在人体内的确切效力和安全性仍需更多临床数据支持。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e90d9bb4a7244676654bef0a\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者强调“还原论”方法的优势，但这并不意味着生态方法无效，两者应被视为互补而非对立。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3abfe02af60077a50b3004b3\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"不同菌株甚至同一物种的不同菌株之间可能存在巨大的功能差异（如Bifidobacterium bifidum的不同菌株对PD-1阻断的影响不同），因此在引用具体机制时需严格限定菌株来源。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0d593217581a78566b8d13de\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"SCFAs（特别是丁酸盐）对ICB的影响具有情境依赖性（如对CTLA-4可能有负面作用），不能一概而论地认为其总是有益。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::54d4ead502cd94815f6b6dba\",\n        \"source_handle\": \"P0251\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-b5c2e925a4132b88eff6\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-7f937d5566b4c12030ce\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::a711d661f19a142c0c3e45ea\",\n          \"snapshot::6c9adb8dafbf57ee773f2f09\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ea94ae88d96da7375e03d569\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bb807576934b684cfc560ae0\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7199bd6117295d60e2e20818\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"1. 临床队列：选取MET4-IO试验中接受MET4+ICI联合治疗的患者（n=23有配对样本），分为MET4组、ICI对照组、高/低IgG反应者亚组及定植成功/失败亚组。 2. 抗体检测：使用CFSE标记MET4细菌，与不同稀释度的患者血浆孵育，通过流式细胞术检测IgA和IgG的结合强度（MFI）和频率，计算响应指数（RI）。 3. 菌群分析：对治疗前后粪便进行宏基因组测序，分析整体菌群多样性及MET4特定菌株的相对丰度变化；对经流式分选的IgG结合/未结合细菌组分进行16S rRNA测序，鉴定被抗体结合的特定菌种。 4. 免疫表型分析：利用质谱流式细胞术（CyTOF）对PBMCs进行多参数分析，比较不同IgG反应组别在治疗前后免疫细胞亚群（如B细胞、CD4+ T细胞、单核细胞等）的频率变化。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::88c3d7422c083be143d6c7c7\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"证实了口服细菌联合体MET4能在人体中诱导特异性的全身性IgG免疫反应，且该反应与特定有益菌的丰度增加及免疫细胞亚群的重塑相关。\",\n          \"limits\": \"1. 早期阶段试验，样本量小（仅23例配对分析），统计效力不足，无法得出关于临床疗效（如生存期、肿瘤缩小）的结论。 2. 存在多种肿瘤类型混杂因素。 3. 抗体检测方法在处理复杂微生物群落时可能存在保留率偏差（Type II error风险），导致某些菌种的抗体反应被低估。 4. 未能直接证明诱导的抗体具有抗肿瘤功能，仅作为系统性免疫激活的标志物。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8a9048b4f7faa99ae05b0687\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"MET4治疗组 vs ICI对照组\",\n          \"finding\": \"MET4治疗显著提高了循环抗MET4 IgG的反应强度和频率，而IgA无显著变化；总血浆IgG浓度在各组间无差异。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ac8729af8b35f74e846875eb\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"高IgG反应者（RI>3, n=5）vs 其他组\",\n          \"finding\": \"高IgG反应者表现出更高的肠道菌群Shannon多样性增加，且特定MET4菌株（如C. aerofaciens, B. adolescentis）的相对丰度增加更显著。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::085f047b2dfff42aa898e3c2\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"IgG结合组分分析\",\n          \"finding\": \"尽管C. aerofaciens等菌在粪便中丰度增加并与高IgG相关，但它们并未在IgG结合的细菌组分中富集；相反，Acidaminococcus在IgG结合组分中显著富集，尽管其整体定植效果有限。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::017b5e3aa522884b5f3d2b79\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"外周血免疫亚群变化\",\n          \"finding\": \"高IgG反应者在MET4治疗后显示出循环B细胞和FoxP3+ CD4+ T细胞的显著增加，以及CD14+和CD16+单核细胞的减少；这些变化在治疗前不存在。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ad2edab2bba30c1a1111dafc\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d6aa4c7c10f6272b2fbe4e28\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"1. MET4细菌联合体能否在接受ICI治疗的实体瘤患者中诱导特异性的循环抗体反应？2. 这种抗体反应是否与肠道内MET4菌株的定植（engraftment）或特定菌属丰度的变化相关？3. 特异性抗体反应是否与外周血中免疫细胞亚群（如B细胞、T细胞、单核细胞）的分布变化有关联？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::baffeb683c983156110161c3\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"针对晚期实体瘤患者，研究在免疫检查点抑制剂（ICI）治疗背景下，口服细菌联合体MET4对系统性免疫反应的影响。研究对象为MET4-IO临床试验队列B中的30名ICI初治患者，分析样本包括治疗前后的血浆、外周血单个核细胞（PBMCs）和粪便。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f6c73b08080a9cd312b52c64\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究旨在评估新型微生物疗法MET4是否能诱导特异性的全身性体液免疫反应，并探索其与肠道菌群定植及循环免疫亚群变化的关联。研究利用抗微生物抗体流式细胞术检测血浆中针对MET4的IgG/IgA反应，结合宏基因组测序分析粪便菌群变化，并通过质谱流式细胞术评估PBMCs中免疫细胞亚群的动态变化。结果显示，MET4治疗显著提高了部分患者的抗MET4 IgG水平，高IgG反应者与特定有益菌（如Collinsella aerofaciens）丰度增加及B细胞、调节性T细胞增多相关，但IgG主要结合的对象并非这些定植成功的菌种，提示可能存在异源免疫刺激机制。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::95758ded15cecd4e3d7edfe7\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅针对MET4这一特定联合体，且为早期安全性/定植试验，非疗效确证性试验。\",\n          \"contribution\": \"提供了细菌联合体干预后，宿主产生特异性循环抗体的量化数据（RI指数、MFI变化），并展示了高反应者与特定菌群（C. aerofaciens等）丰度增加的关联。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::469f4cbdeb5bc3ad719bb7a4\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制为相关性观察，非因果验证；体外结合实验不能完全代表体内功能；质谱流式面板有限，未涵盖所有免疫亚群。\",\n          \"contribution\": \"通过IgG结合分选和16S测序，发现抗体主要结合Acidaminococcus而非丰度增加的C. aerofaciens，提出“定植菌作为佐剂激发针对其他菌或自身成分的异源抗体反应”的机制假说。同时记录了高IgG反应者外周B细胞和FoxP3+ T细胞增加、单核细胞减少的免疫重塑现象。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3e1080a999c057765ab89992\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"介绍了抗微生物抗体流式细胞术的具体操作流程（CFSE标记、血浆稀释、二级抗体染色）及质谱流式在免疫亚群分析中的应用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::04daf3518eaf2243919fef62\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"讨论了“adjuvant taxa”（佐剂样菌）概念，即某些菌通过模式识别受体激活APC，进而引发广泛的系统性免疫反应，甚至包括针对其他菌的抗体。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::28d75a84749b754609b5e997\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究为早期相位（Phase I/II）试验，主要终点是安全性和定植，而非客观缓解率（ORR）或总生存期（OS）。因此，任何关于“MET4提高ICI疗效”的推论均缺乏直接临床结局数据支持，仅能推断其具备免疫激活潜力。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a102ea7c99ecf5904b039720\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"抗体反应的高变异性（仅5人显示高反应）提示个体差异极大，外推至一般人群时需考虑宿主基线免疫状态的影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d77f50d5341d6ed41b9423ff\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"IgG结合分选实验中提到的“保留率偏差”意味着未被检测到的菌种可能同样具有免疫原性，解读“谁激发了抗体”时需保持谨慎，避免绝对化结论。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::917c178d07989db3d53e4bdd\",\n        \"source_handle\": \"P0122\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-4dcc7c19ae5301df5638\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5c752c0f8036d5742e42\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5f82ba52a99d38e52a55\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5bcddf895da96806b16c\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementaryFiles_fetch_transport_TimeoutError\",\n              \"status\": \"missing\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::73efa1be4be250cf312dbe78\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::32afad53dcf43f0b6c9b72e0\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0bfb82785a3c48347dccebf7\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::df7c1c8cdb1b19415f16bd7c\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用叙事性综述方法，梳理已发表的临床试验数据（包括已完成和正在进行的研究）。作者按干预类型（益生菌、菌群组合、FMT）分类整理证据，对比各试验的设计、患者人群、疗效指标（ORR, mPFS）及不良事件。同时，结合讨论部分，分析导致临床结果不一致的原因（如物种特异性、定植能力、抗生素预处理的影响），并评估当前监管框架和研究方法论（如小鼠模型的局限性）对转化研究的制约。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ad144ff01b7112fa74c4f766\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了关于微生物疗法作为ICI辅助治疗的全景式临床证据汇总，特别是区分了益生菌、菌群组合和FMT在不同实体瘤中的表现差异。\",\n          \"limits\": \"作为综述，未提供新的原始实验数据；对机制的解释主要基于作者对现有文献的综合推断，具体分子通路尚不明确；所引用的临床试验多为小样本或早期阶段，统计效力有限。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::18fce5dbd3407432b774c9dd\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"指出了当前领域面临的非科学障碍，如监管标准不适用于复杂微生物产品、患者招募困难及抗生素预处理策略的潜在风险。\",\n          \"limits\": \"这些观点属于领域内的共识性讨论，并非该综述独有的实证发现；对于如何解决这些系统性问题，仅提出了方向性建议（如AI建模、标准化供体筛选），未提供具体解决方案。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e026da3395f4a6e48096eefc\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"使用单一或少数菌株益生菌（如CBM588）联合ICI\",\n          \"finding\": \"在某些特定癌种（如转移性肾细胞癌）中显示出较高的ORR提升（58%-74% vs 对照20%），但在其他癌种（如微卫星稳定型结直肠癌）中效果不佳或无效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7ffe37d5b7bd2ed2749dc96b\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"使用多菌株微生物菌群组合（如MET4, SER-401, VE800）\",\n          \"finding\": \"结果高度异质。MET4在部分队列中显示潜在获益，但受限于招募失败；SER-401因早期终止且初步数据显示疗效不优于安慰剂而终止；VE800整体ORR极低（1.9%），仅在黑色素瘤亚组中观察到一定益处。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e58ae790bec32ee11a9df4c4\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"使用粪便微生物移植（FMT）联合ICI\",\n          \"finding\": \"在多种难治性实体瘤（黑色素瘤、NSCLC、MSI-H癌症等）中显示出一致的积极信号，ORR普遍较高（20%-77%），且安全性总体可控，提示其可能具有广谱抗肿瘤活性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1cdfbbb48f5f9c98936fc044\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"机制研究与模型转化\",\n          \"finding\": \"目前缺乏明确的单一因果细菌物种；机制涉及T细胞浸润、代谢物（如短链脂肪酸）产生及免疫基因集变化。小鼠模型与人类微生物组差异巨大，限制了直接外推。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e9de08819bb3b4ed6078f1fe\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2827d99d3dcf98657562d9b2\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管ICI疗法改变了部分实体瘤的治疗格局，但其对“冷”肿瘤或无响应患者的效果有限。本研究旨在解决如何安全有效地将微生物疗法作为ICI的辅助手段，以扩大受益人群并克服耐药性问题。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::897420d152a1f4691a65b58e\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"固体肿瘤患者中，肠道微生物群作为免疫检查点抑制剂（ICI）辅助治疗的临床前与临床研究现状。涵盖益生菌、微生物菌群组合及粪便微生物移植（FMT）三种主要干预手段。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::10082b6cc311135dbfe6dcf1\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇综述，旨在评估通过调节肠道微生物群来增强固体肿瘤免疫治疗疗效的潜力。文章系统回顾了基于单菌株/有限混合物的益生菌（如CBM588、EDP1503）、多菌株微生物菌群组合（如MET4、SER-401、VE800）以及全环境粪便微生物移植（FMT）在联合ICI治疗中的临床试验结果。研究重点分析了不同干预策略在客观缓解率（ORR）、无进展生存期（mPFS）及安全性方面的表现，并探讨了从动物模型到人体转化的挑战、监管障碍、患者招募困难以及现有机制理解的局限性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3a7be2d0ab0883257f020f7a\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"这些数据来自小样本早期临床试验，存在选择偏倚和统计效力不足的问题。不能据此断定某种特定菌株在所有情况下均有效或无效。\",\n          \"contribution\": \"提供了三类微生物干预策略在多种实体瘤中与ICI联用的临床疗效对比数据。具体而言，指出FMT在多种难治性肿瘤中表现出较一致的ORR提升（20-77%），而益生菌和菌群组合的效果则呈现高度的癌种特异性和菌株依赖性（如CBM588在mRCC有效但在MSS CRC无效，VE800整体无效）。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e7a08fe8d3267d2e0ff0d6a1\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"机制描述多为相关性观察或基于动物模型的推测，文中明确承认“大部分未知”。不能将这些关联视为已证实的因果机制。\",\n          \"contribution\": \"讨论了微生物调节ICI疗效的可能机制线索，包括T细胞浸润增加、抗原呈递细胞（APCs）积累、IL-8产生髓系细胞减少以及短链脂肪酸（SCFAs）等代谢物的作用。同时指出目前缺乏单一因果物种的证据，倾向于网络效应和功能冗余。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6150bc781f7918a9915bfded\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"介绍了ICI的作用原理（PD-1/PD-L1, CTLA-4抑制，T细胞增殖）及其在“冷”肿瘤中的局限性。定义了“热”与“冷”肿瘤的概念，并引入肠道微生物群作为潜在的共治疗手段。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bf5d9ab2e65ee7a5c7b0216a\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"批评了传统还原论方法（寻找单一因果基因/蛋白）在微生物研究中的失效，提出需要机器学习/AI模型来处理微生物组的复杂性，并指出小鼠模型与人类微生物组的差异是转化研究的瓶颈。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c024714554d6bd9bfa71d6cf\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"详细描述了微生物疗法在临床试验中面临的监管难题（难以标准化复现的产品）、患者招募困难以及抗生素预处理带来的潜在危害（如SER-401试验中的负面结果）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cb21724cdddb728c61b9904e\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述主要关注细菌疗法，虽提及真菌、古菌和病毒，但未深入展开，阅读时需限定在细菌层面。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b5bf19d3d412ec4c9e5076d1\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"所有临床数据均为早期阶段（Phase I/II）或小样本研究，结果存在较大不确定性，不可将其视为确证性证据。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3da6b2c628061aac471cc4ce\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者强调FMT效果较好，但这可能源于FMT引入了更多样的菌群而非特定成分，需谨慎归因。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::aff3ce7e2f53b8c83f7866ec\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中提到的“抗生素预处理”在SER-401试验中被证明可能有害，这一反面案例对于设计微生物干预方案具有重要警示意义。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c1253fcac84e6039a9d7c2a0\",\n        \"source_handle\": \"P0387\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::2982acd184049ed5bf73367d\",\n          \"snapshot::b108064ede6712f9e766ace8\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1b77b4bb509e05a0fbc26248\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7c746f64a2e9e1ee9376c1bf\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::009b8c762617bca488678bdf\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"As a narrative review, the authors systematically summarize and categorize existing literature rather than conducting a new systematic meta-analysis. The approach involves: (1) reviewing preclinical mouse models to establish causal links between specific bacteria and ICI response; (2) analyzing human observational cohort studies to identify associations between microbiota composition (taxa and diversity) and clinical outcomes (response vs. non-response); (3) synthesizing proposed biological mechanisms (T-cell activation, mimicry, metabolites); and (4) evaluating early-phase clinical trial data for microbiome interventions (FMT, consortia, diet). The review explicitly compares findings across different studies to highlight inconsistencies in biomarker discovery and emphasizes the need for standardized methodologies.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::45cafb54dc0b22611aed0da9\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a comprehensive synthesis of preclinical and clinical evidence linking the gut microbiome to ICI efficacy and toxicity, categorizing mechanisms into three distinct themes.\",\n          \"limits\": \"As a narrative review, it does not perform a quantitative meta-analysis; it highlights the lack of consensus in human biomarker studies rather than resolving it.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d12797a4caef170c2b7834bb\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Critically evaluates the limitations of current human studies, including small sample sizes, geographic biases, and analytical pipeline differences, advocating for standardized large-scale datasets.\",\n          \"limits\": \"Does not provide definitive answers on which specific microbial signatures are universally predictive across all solid tumor types.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9a0404a5b8c8e5b2a74dec45\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Summarizes early-phase clinical trial data for various microbiome interventions (FMT, consortia, diet), offering a landscape of current therapeutic developments.\",\n          \"limits\": \"Most clinical trial data reported are from early-phase (I/II) studies with small sample sizes; long-term efficacy and safety profiles are not yet established.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b4bed6075da6fb337a1b29ef\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Preclinical mouse models\",\n          \"finding\": \"Specific commensals (e.g., Bifidobacterium spp., Akkermansia muciniphila, Bacteroides fragilis) enhance anti-PD-1 or anti-CTLA-4 efficacy via dendritic cell activation, STING pathway signaling, and modulation of T-cell subsets.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9c9912d42b9680ae59616b6d\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Human observational studies (Melanoma, NSCLC, RCC)\",\n          \"finding\": \"Responders to ICIs often show higher abundance of specific taxa (e.g., Faecalibacterium, Ruminococcaceae, A. muciniphila), but there is no consensus on a universal predictive signature due to cohort-specific variations, geographic differences, and methodological heterogeneity.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::db8e6cda2084f9d7f422abcc\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Antibiotic use during ICI therapy\",\n          \"finding\": \"Broad-spectrum antibiotic use is consistently associated with reduced progression-free survival and overall survival in ICI-treated patients, likely due to depletion of beneficial microbes.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::90e8fc2f9e0b82ab3be5b470\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Mechanistic pathways\",\n          \"finding\": \"Three primary mechanisms are identified: (1) direct stimulation of antitumor T-cells; (2) molecular mimicry between bacterial and tumor antigens; (3) production of immunomodulatory metabolites like short-chain fatty acids (SCFAs), secondary bile acids, and inosine.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7616bc1463f0ae6cf17cc69a\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Immune-related adverse events (irAEs)\",\n          \"finding\": \"Specific microbiota profiles are linked to irAEs, particularly colitis. For example, certain Firmicutes are associated with anti-CTLA-4 colitis, and Streptococcus abundance correlates with arthritis and poor prognosis.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1443271fa1da60a509c70ae2\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Clinical trials of FMT\",\n          \"finding\": \"FMT from responders to PD-1 refractory melanoma patients can restore sensitivity to PD-1 inhibitors, with some patients achieving objective responses, though engraftment stability varies.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::36650677a8cc9186fdd6e51b\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2c322d10b5ee066c7278d227\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"The review addresses the question of how the gut microbiome impacts the efficacy and toxicity of cancer immunotherapies, aiming to consolidate preclinical and clinical evidence to understand the rationale for microbiome-targeted therapies and identify gaps in current knowledge regarding predictive biomarkers and mechanistic pathways.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ebd7242a0ff0d64e461f0432\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"The review focuses on the role of the gut microbiome in modulating responses to immune checkpoint inhibitors (ICIs) targeting PD-1/PD-L1 and CTLA-4 in patients with advanced solid tumors (melanoma, NSCLC, RCC, GI cancers). It covers preclinical evidence from mouse models, observational human data linking microbiota composition to clinical outcomes and adverse events, potential biological mechanisms, and early-phase clinical trials of microbiome-based interventions.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cc2c2c28c1caba96afb475d0\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This review synthesizes current knowledge on how the gut microbiome influences cancer immunotherapy. It begins by summarizing preclinical studies demonstrating that specific commensal bacteria enhance ICI efficacy through T-cell stimulation and metabolite production. It then reviews human observational studies, highlighting the inconsistent identification of predictive microbial signatures across different cohorts and cancer types, while noting the negative impact of broad-spectrum antibiotics. The paper outlines three main mechanistic themes: direct T-cell stimulation, molecular mimicry, and immunomodulatory metabolites (e.g., SCFAs, bile acids, inosine). It also discusses the microbiome's role in immune-related adverse events (irAEs), particularly colitis. Finally, it evaluates emerging therapeutic strategies, including fecal microbiota transplantation (FMT), defined bacterial consortia, probiotics, and dietary interventions, based on results from early-phase clinical trials.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e13747845e98cdad4946f3fe\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"The association is correlational in humans; causality is primarily established in mouse models. Predictive signatures are not consistent across all studies or cancer types.\",\n          \"contribution\": \"Provides evidence that specific gut bacteria (e.g., Bifidobacterium, Akkermansia, Faecalibacterium) are associated with improved response to PD-1/CTLA-4 inhibitors in melanoma, NSCLC, and RCC. It details how broad-spectrum antibiotics negatively impact ICI efficacy.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dd2cd58c619336074abe9073\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Many mechanisms are derived from preclinical mouse models; human validation is ongoing. The relative contribution of each mechanism in humans is not fully quantified.\",\n          \"contribution\": \"Outlines three mechanistic categories: (1) Direct T-cell stimulation (e.g., via DC activation or TLR signaling); (2) Molecular mimicry (cross-reactive T-cells); (3) Metabolite production (SCFAs, bile acids, inosine) influencing the tumor microenvironment and systemic immunity.\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::70d726c889969cd08f8f7c50\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Links are largely observational; causal relationships for non-colitis irAEs are less established.\",\n          \"contribution\": \"Discusses the role of the microbiome in irAEs, specifically colitis and arthritis, linking specific taxa (e.g., Firmicutes, Streptococcus) to these toxicities.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::60cc01cd7a6971e06ac2562f\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Data are from small, early-phase trials; long-term durability and optimal donor selection criteria are not yet resolved.\",\n          \"contribution\": \"Reports early clinical trial results for FMT and defined consortia (e.g., CBM588, SER-401) showing potential to restore ICI sensitivity in refractory patients.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4289eb606de8ce121a145709\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Discussion of cohort-specific microbial signatures, geographic effects (enterotypes), and methodological heterogeneity (sequencing pipelines, response definitions).\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::80c703ff4721ceb9517b1e60\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Details on high-fiber diets, ketogenic diets, and fasting-mimicking diets affecting microbiota composition and ICI outcomes.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4bc8badb56ceb9668c0d36b8\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Table 2 listing various trials (FMT, consortia, probiotics, prebiotics) with their phases, indications, and products.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1ce8fe5bdd1c0d404d911837\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review covers multiple solid tumor types (melanoma, NSCLC, RCC, GI cancers); findings may not be generalizable to hematologic malignancies or other cancer types not discussed.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::14c17ad9e4bf0d56c7a4595b\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Human data are primarily observational associations; causal claims should be attributed to preclinical models unless supported by interventional trial data.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a6aa372fb235e79e846179ea\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Biomarker findings are inconsistent across studies; do not present any single taxon as a definitive universal predictor without noting the cohort-specific nature of the evidence.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0a9592c21283fd2c275d56d4\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Clinical trial results are from early phases; avoid overstating efficacy or safety based on small sample sizes.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::28906915f0b362e419938664\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c96dcd391e3ff6d5952be10a\",\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::922e43319a447a37576a6465\",\n        \"source_handle\": \"P0261\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eb5aa52fd3ffd49fe0ad1176\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::05c869a01ed92554d02725a3\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4e2333ff838fdd806b55bdd7\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6d2370498917430fe1ce20f1\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"The authors conduct a narrative review synthesizing literature from structural biology, immunology, oncology, and biomanufacturing. They organize the content by: 1) Structural determinants of bioactivity; 2) Four mechanistic axes of ICI sensitization; 3) Clinical and preclinical evidence; 4) Translational bottlenecks (heterogeneity, PK/PD, trial design); 5) Future strategies (AI, synthetic biology, nanodelivery). They compare polysaccharides with mainstream immunostimulants and contextualize findings within Technology Readiness Levels (TRLs).\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a6b20904a951e3029bf63694\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a comprehensive framework linking polysaccharide structure (ESAR) to immune function and ICI synergy, categorizing mechanisms into four distinct axes.\",\n          \"limits\": \"As a review, it synthesizes existing data rather than generating new experimental evidence; clinical validation is limited to early-phase/small-sample studies.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2bc8fd0b296c3aa429b0f019\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Identifies specific translational bottlenecks (structural heterogeneity, low bioavailability) and proposes advanced technical solutions (AI glycomics, synthetic biology, nanodelivery).\",\n          \"limits\": \"Proposed solutions like Industry 6.0 integration and AI models are largely theoretical or in early development stages; practical implementation details are not yet established.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3c0aa376fdfa2017167426d6\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Contextualizes polysaccharides against other adjuvants (CpG, STING agonists, FMT) and defines their niche in terms of safety and tolerability.\",\n          \"limits\": \"Direct head-to-head comparative clinical data between polysaccharides and these other agents are sparse; comparisons are often based on separate study contexts.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::28653169b560c809e93eab96\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Fungal beta-glucans\",\n          \"finding\": \"Intact triple-helix conformation is essential for Dectin-1 binding and immune activation; extraction-induced disruption abolishes activity.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d7dad710dbd3bef9cd89ec24\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Plant/Marine polysaccharides\",\n          \"finding\": \"C-2/C-3 acetylation or sulfation degree are key determinants of TLR4/MyD88 signaling intensity and ROS scavenging.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9ed22b067d4d6149e1368f28\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Gut microbiota modulation\",\n          \"finding\": \"Polysaccharides act as prebiotics to enrich beneficial taxa (e.g., Akkermansia, Bifidobacterium) and increase SCFA production, which synergizes with anti-PD-1 therapy; effects are microbiota-dependent.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e947d43bd1da1a68deb89a35\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Clinical evidence\",\n          \"finding\": \"Early-phase trials show promise (e.g., ORR 21.7% in refractory NSCLC with beta-glucan + envafolimab), but large-scale Phase III RCTs are absent; most strategies remain at TRL 3-5.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bae5619bf50fe0fc4b949c3d\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Safety considerations\",\n          \"finding\": \"Excessive intake of fermentable fibers in dysbiotic models may induce cholestatic liver cancer via SCFA accumulation, highlighting a dose-dependent safety boundary.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::24fec8d8f2c82155a45e835c\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7a7aad00488e11d4a7c07f3f\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"How can natural polysaccharides be rationally designed and utilized to overcome primary and acquired resistance to ICIs in solid tumors, given their complex structures and variable clinical outcomes?\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::00a97cdd8f787cbe68b388cb\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"Natural polysaccharides (from fungi, plants, marine organisms) as immune adjuvants to overcome resistance to Immune Checkpoint Inhibitors (ICIs) in solid tumors. Covers structural biology, molecular mechanisms, preclinical/clinical evidence, translational challenges, and future technological directions.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0b0c136f05c57c534c85bdf1\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This review systematically analyzes the potential of natural polysaccharides to enhance the efficacy of ICIs by reversing tumor immune resistance. It dissects the structure-activity relationships (SAR) governing immunomodulation, elaborates on four core mechanisms (TAM repolarization, CD8+ T cell rejuvenation, gut microbiota remodeling, and suppression of tumor-intrinsic escape), and evaluates current clinical translation bottlenecks such as structural heterogeneity and low bioavailability. The paper positions polysaccharides within the broader landscape of combination therapies, compares them with other adjuvants, and proposes a roadmap for precision medicine using AI-driven glycomics, synthetic biology, and multi-layer biomarkers.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ee7e3572d67dbf2f67526363\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Introduction sections detailing primary/acquired resistance rates, limitations of CAR-T and kinase inhibitors, and the need for novel adjuvants.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::17a10ba46be35c4952913371\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Section 5.1 comparing polysaccharides with dual checkpoint blockade, TIM-3 targeting, and oncolytic viruses in terms of efficacy and safety profiles.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fb8e4e0564c5b23f7abc6821\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Sections 6.3-6.6 discussing AI-driven QSAR, graph neural networks, synthetic biology, and large-scale N-glycomics.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::757541f80ab481e594311373\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Most evidence is preclinical (mouse models) or from small early-phase human trials; causal links in humans are inferred from FMT experiments and observational cohorts.\",\n          \"contribution\": \"Details the role of gut microbiota in mediating ICI response, specifically highlighting how polysaccharides remodel microbial composition (enriching Akkermansia, Bifidobacterium) and metabolite profiles (increasing SCFAs like butyrate and propionate) to enhance anti-tumor immunity.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::000bb7f76afc0e764242ec8f\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Mechanisms are often derived from in vitro or syngeneic mouse models; direct translation to human clinical outcomes is not fully validated.\",\n          \"contribution\": \"Elaborates on the molecular mechanisms of polysaccharide-mediated immunomodulation, including TAM repolarization (M2 to M1), CD8+ T cell exhaustion reversal, and suppression of tumor-intrinsic escape (PD-L1 downregulation). Links these to specific structural motifs (triple helix, acetylation).\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d2525176a96ae5b3ac60e2bc\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"Based on specific dysbiotic mouse models; human relevance requires further validation.\",\n          \"contribution\": \"Discusses the safety boundaries and risks associated with polysaccharide/fiber supplementation, noting that excessive fermentation in dysbiotic guts may lead to adverse outcomes like cholestatic liver cancer.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3eefb31b9abaa8d1b9d67ad1\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review focuses on natural polysaccharides; do not generalize findings to all prebiotics or dietary fibers without specifying the polysaccharide type.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f2c5255f64a830040e1f35d7\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Clinical evidence is primarily from early-phase trials or real-world retrospective studies; avoid overstating efficacy as if confirmed by Phase III RCTs.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8e35d942ffc4974b5cd35989\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Mechanistic claims are largely supported by preclinical models; distinguish between observed associations in mice and validated causal mechanisms in humans.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::20a0ba2e568287fb9bf43378\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Safety warnings (e.g., liver cancer risk) are based on specific dysbiotic conditions; do not assume universal toxicity.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::90e1b843a34aa7ed7dd51615\",\n        \"source_handle\": \"P0152\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-edcd953058d1d5fa5081\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-847338f921b68453cb16\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementaryFiles_fetch_transport_TimeoutError\",\n              \"status\": \"missing\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::75c05d10f04491719965663b\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a5c92501d12e494997ee0cc3\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3d2faddc32ac2b1e893da40c\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b37713eabcf85e9c66591d0b\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"本文是一篇综述（Review）。作者通过梳理现有文献，系统阐述了肠道微生物组与宿主免疫系统之间的相互作用机制，重点分析了特定微生物物种、代谢产物（如短链脂肪酸）以及菌群失调对抗PD-1免疫治疗疗效的影响。文章进一步归纳了基于微生物组的干预策略，包括粪便微生物群移植（FMT）、饮食干预和益生菌使用，并讨论了其在黑色素瘤治疗中的潜力与挑战。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::76dfb64da820177736fc01a2\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"综合了肠道微生物组影响抗PD-1疗法疗效的多种机制，包括T细胞激活、代谢物调节及免疫检查点表达调控；汇总了FMT、饮食和益生菌等干预策略的临床前及早期临床研究证据；明确了特定菌种（如Akkermansia muciniphila, Bifidobacterium）和菌群多样性作为预测生物标志物的潜在价值。\",\n          \"limits\": \"作为综述，其结论依赖于所引用的原始研究，未提供新的实验数据或独立验证；对于不同干预策略的有效性和安全性比较缺乏直接的头对头证据；部分机制（如具体菌株与免疫细胞的精确分子通路）仍基于动物模型或小型临床试验，外推至所有实体瘤存在不确定性；摘要未交代具体的文献检索策略、纳入排除标准及质量评估方法。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::24a88f39680af325af37ed0e\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"在黑色素瘤患者中，接受抗PD-1治疗且肠道菌群中含有特定有益菌（如Akkermansia muciniphila, Bifidobacterium）或具有高多样性的个体。\",\n          \"finding\": \"这些患者表现出更好的治疗反应和生存获益，机制涉及增强CD8+ T细胞活化、增加肿瘤浸润及促进Th1/Th17分化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ee2882a0c098df37543578fe\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"肠道菌群失调（Dysbiosis），表现为有益菌减少、有害菌增多或多样性降低。\",\n          \"finding\": \"与抗PD-1治疗耐药相关，机制包括调节性T细胞（Tregs）扩增、髓源性抑制细胞（MDSCs）作用增强以及效应T细胞向肿瘤微环境的浸润减少。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fd1bd67acdf7b29fc150364f\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"使用粪便微生物群移植（FMT）将健康供体菌群转移至对免疫治疗耐药的黑色素瘤患者。\",\n          \"finding\": \"Davari等人（2021）的研究显示，FMT可恢复有利的免疫环境，增强T细胞活化，使部分先前耐药的患者重新获得对PD-1阻断的反应。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bff9fb7c91d662c3d780bc09\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"摄入富含纤维的饮食以支持短链脂肪酸（SCFAs）产生菌的生长。\",\n          \"finding\": \"SCFAs（如丁酸、丙酸、乙酸）可通过抑制组蛋白去乙酰化酶（HDACs）和促进抗炎信号通路，增强抗肿瘤免疫反应，改善抗PD-1疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a623e8c61ed512d650536c49\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8ab14efc6b30694f0585ce00\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管抗PD-1免疫疗法显著改善了黑色素瘤患者的生存率，但疗效存在高度异质性。本研究旨在探讨肠道微生物组如何调节这种疗效差异，阐明其背后的免疫学机制，并评估通过调节微生物组（如FMT、饮食、益生菌）来增强免疫治疗效果的潜在策略。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8628c3209fc51cc52f581364\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"研究对象为黑色素瘤患者的肠道微生物组及其与抗PD-1免疫治疗的相互作用。情境涵盖从基础免疫机制（T细胞激活、代谢物作用）到临床干预策略（FMT、饮食、益生菌）的多个层面。范围主要聚焦于黑色素瘤，但也提及对其他癌症的潜在启示。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::683021d8eb786f400362468b\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本综述旨在解决抗PD-1免疫疗法在黑色素瘤治疗中疗效变异性大的问题。文章首先介绍了肠道微生物组在维持免疫稳态和启动抗肿瘤免疫中的核心作用，详细阐述了微生物通过直接接触（如GALT中的抗原呈递）和间接代谢产物（如SCFAs）调节宿主免疫系统的机制。随后，文章总结了与良好治疗反应相关的微生物特征（如高多样性、特定菌属丰度）以及与耐药相关的菌群失调状态。最后，综述评估了三种主要的微生物组干预策略：FMT在逆转耐药方面的初步成功、高纤维饮食对SCFA产生的促进作用，以及益生菌使用的潜在益处与安全风险。文章指出，理解并操纵微生物组有望实现更个性化的癌症免疫治疗，但仍需更多临床研究来优化方案并确保安全性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a8323f303ecbdef63bd0e6a2\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要基于黑色素瘤数据，其他实体瘤的直接证据较少；机制多为相关性或动物模型推断，临床因果链条尚不完全清晰；FMT等证据来自小规模研究。\",\n          \"contribution\": \"提供了肠道微生物组通过调节T细胞活化和肿瘤微环境来影响抗PD-1疗效的详细机制图谱，包括特定菌种、代谢物和免疫细胞亚群之间的相互作用。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::569a8cdab6e82079b6483367\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要关注黑色素瘤；未提供大规模多中心试验结果；不同干预策略的直接比较缺失。\",\n          \"contribution\": \"总结了目前可用的微生物组干预策略（FMT、饮食、益生菌）在增强ICIs疗效方面的临床前和早期临床证据，并指出了各自的潜在风险和局限性。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::94575848cf3b0acc35c832ba\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"微生物组与免疫系统相互作用的总体描述，包括GALT的作用、T细胞亚群的分化（Th1, Th17, Tregs）以及SCFAs的免疫调节功能。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a954f5e86e5a0341d1cc7048\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"列举了与良好预后相关的特定菌种和代谢物，以及菌群失调导致的负面后果。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c7c67d13abcc3ba3a71d2af4\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::657f67cade4ded2dd0f4a324\",\n        \"source_handle\": \"P0250\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"详细介绍了FMT在耐药患者中的应用案例、饮食干预的机制及益生菌的安全顾虑。\"\n        },\n        \"role\": \"evidenc