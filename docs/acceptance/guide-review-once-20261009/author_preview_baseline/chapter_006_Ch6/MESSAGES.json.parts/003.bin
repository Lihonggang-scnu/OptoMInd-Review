atom_id\": \"atom::1f6436d467e7e0b57e2f07b2\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e1cc78c58c16c3bbdbbf2ee2\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::00a19ae4aaf57c17faf6d44e\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用系统性文献综合路线。首先梳理肠道微生物组调节局部及全身免疫的基础生物学机制（受体信号通路、表观遗传调控）。其次，分类汇总临床前研究（主要是小鼠模型），分析特定菌株对树突状细胞、T细胞极化及肿瘤微环境的影响。再次，系统检索并归纳人类临床研究数据，包括回顾性队列、前瞻性观察研究及I/II期临床试验，按癌种（肺癌、肾癌、黑色素瘤等）和治疗类型进行分层分析。最后，结合专家观点与现有文献缺口，提出整合多组学、体外功能 assay 及标准化临床试验的未来研究框架。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::71d806cb03a92d98e2986d9d\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了益生菌增强ICI疗效的多层次机制全景图，连接了微生物代谢物、免疫细胞亚群及肿瘤微环境重塑。\",\n          \"limits\": \"机制部分主要基于小鼠模型，其外推至人类的适用性受限；人类数据多为观察性，存在选择偏倚和混杂因素。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9d832b25167ebcddca09a6b4\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"系统整理了截至2025年的临床前及早期临床证据，揭示了不同癌种和益生菌类型的响应差异。\",\n          \"limits\": \"临床数据异质性高，难以得出统一的疗效结论；缺乏长期安全性和长期定植效果的数据。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::33a9645f6cef26721b0123d6\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"明确了当前领域的关键瓶颈（标准化缺失、监管障碍、因果推断困难），并为未来研究设计了方法论框架。\",\n          \"limits\": \"作为综述，未提供新的原始实验数据；提出的未来方向需后续实证研究验证。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::302a80f9ec357636e98d3b23\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"临床前小鼠模型（黑色素瘤、结直肠癌等）\",\n          \"finding\": \"特定益生菌（如双歧杆菌、乳酸杆菌、Clostridium butyricum、Akkermansia muciniphila）可通过激活树突状细胞、促进MHC-I抗原呈递、调节细胞因子谱（增加IFN-γ, TNF-α）、诱导巨噬细胞向M1型极化以及产生SCFAs等代谢物，增强CD8+ T细胞浸润和活性，从而协同ICI发挥抗肿瘤作用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0ff7bc74c4a0e8a80d1f6f4d\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"人类回顾性及前瞻性观察研究（非小细胞肺癌、转移性肾细胞癌、黑色素瘤）\",\n          \"finding\": \"多项研究显示，使用益生菌（尤其是Clostridium butyricum MIYAIRI 588或多种混合菌株）与改善无进展生存期（PFS）和总生存期（OS）相关。例如，在一项NSCLC回顾性研究中，益生菌使用者中位PFS显著延长；在mRCC的前瞻性研究中，CBM588联合nivolumab/ipilimumab显示出更高的客观缓解率（ORR）和PFS。然而，部分商业益生菌补充剂在非标准化使用时可能无效甚至有害。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3126473c4fbc3a92dfe180c6\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"免疫相关不良事件（irAEs）管理\",\n          \"finding\": \"某些益生菌株（如Bifidobacterium spp., Lactobacillus spp.）在动物模型中可减轻ICI诱导的结肠炎。在人类观察性研究中，较高的有益菌丰度或与irAEs风险降低相关，但临床数据不一致，部分研究显示益生菌使用并未增加irAEs发生率，而在联合化疗时可能增加特定毒性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::30453997df29189781838b94\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"方法学与标准化现状\",\n          \"finding\": \"大多数临床证据来自回顾性研究，缺乏随机对照试验（RCT）。使用的益生菌制剂高度异质化（单株vs多株，商业补充剂vs定义明确的菌株），且受饮食、抗生素使用、种族等混杂因素影响严重。目前尚无法确定最佳菌株、剂量及给药方案。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::717397c1cb049347f7f2933f\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8c94036e7aec735063a13814\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管肠道微生物组已知能调节ICI疗效，但基于微生物组的干预措施（特别是益生菌）在临床实施中面临挑战。本研究旨在解决：1）益生菌如何通过具体免疫机制增强ICI疗效？2）目前关于益生菌在人类癌症患者中应用的临床证据质量如何？3）该领域存在哪些主要障碍（如标准化、安全性、混杂因素），需要何种研究设计来克服？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7182dbc1a8c2edca834f2177\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"聚焦于肠道微生物组（gut microbiome）与癌症免疫治疗，特别是免疫检查点抑制剂（ICIs）之间的相互作用。研究对象包括益生菌（probiotics）、益生元、后生元及粪便微生物移植等微生物靶向策略，涵盖从基础机制到临床前模型及早期临床试验的证据。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2e70d09ab215c701a9eb32bc\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇综述，旨在批判性评估益生菌作为癌症免疫治疗辅助手段的现有证据。文章首先概述了肠道微生物组通过代谢物（如短链脂肪酸、色氨酸衍生物、胆汁酸）和分子模式调节宿主免疫系统的机制，进而阐述这些机制如何影响ICI疗效。随后，重点讨论了特定益生菌菌株在临床前小鼠模型中增强抗肿瘤免疫反应的潜力，并汇总了来自回顾性队列、前瞻性观察研究及早期临床试验的人类数据，探讨益生菌对ICI疗效及免疫相关不良事件（irAEs）的影响。最后，文章指出了当前研究的局限性，如菌株标准化缺失、混杂因素干扰及因果关系的未确定性，并提出了整合纵向多组学、体外共培养及类器官模型等未来研究方向，以推动益生菌从膳食补充剂向经过验证的临床辅助疗法转化。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ebf057532e81f91a3c1deb34\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"所有临床数据均为回顾性或早期前瞻性观察研究，存在显著的混杂因素（如基线微生物组成、饮食、合并用药）。不能直接证明因果关系，仅能提供关联证据。样本量和随访时间有限，长期疗效未知。\",\n          \"contribution\": \"提供了益生菌在多种实体瘤（NSCLC, mRCC, 黑色素瘤）中与ICI联用的临床观察结果，包括PFS、OS和ORR的变化趋势。特别指出了Clostridium butyricum MIYAIRI 588在肺癌和肾癌中的积极信号，以及商业混合益生菌在某些情况下的无效性。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2151952a4c6ff4b033e7e506\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"大部分机制细节源自小鼠模型（germ-free mice, gnotobiotic models）。人类体内确切的因果链条尚未完全确立，许多通路在人体中的确切贡献度和主导性尚不明确。不同菌株的作用机制可能存在显著差异，综述中的机制概括可能掩盖菌株特异性。\",\n          \"contribution\": \"详细描述了益生菌调节免疫的具体分子和细胞机制：1）通过SCFAs激活GPCRs并抑制HDAC，促进Treg分化或增强CD8+ T细胞功能；2）通过AhR通路调节色氨酸代谢；3）通过STING通路激活DC和巨噬细胞，促进M1极化；4）通过分子模拟（molecular mimicry）交叉激活T细胞。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4e3e5363e3b1e6060c91a4ba\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"临床数据矛盾且不充分。动物模型结果不能直接外推至人类。缺乏大规模RCT数据支持益生菌对irAEs的确切保护作用。\",\n          \"contribution\": \"分析了益生菌对ICI诱导的免疫相关不良事件（irAEs）的双向影响，指出某些菌株可能减轻结肠炎，而其他情况下可能增加毒性或无显著影响。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bd22fb14494e0354503b38df\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"介绍了肠道微生物组作为“第二基因组”的概念，及其通过GALT、代谢物和MAMPs调节全身免疫的基础理论。定义了益生菌、益生元、后生元和FMT的区别。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6830f3216aaff9dac057e352\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"强调了当前临床研究中益生菌制剂的非标准化、商业产品的标签准确性问题、以及饮食/抗生素/种族等混杂因素的复杂性。提出了整合纵向多组学、ex vivo assays和gut-on-a-chip模型的必要性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::114f3b3942444b88c43854a5\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"引用Spencer等人的研究，显示非标准化的商业益生菌补充剂在小鼠模型和人类队列中可能损害ICI反应，减少IFN-γ阳性T细胞。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::960d60a84711ed898ae3e67f\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述主要关注肠道微生物组，虽然提及皮肤、肺等其他部位微生物，但核心证据集中在肠道。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d798c8e48d06d32471513b4a\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"临床数据主要来自回顾性研究和早期试点试验，缺乏大型III期RCT结果，因此任何关于疗效的结论都带有强烈的观察性关联性质，而非确证性因果证据。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::61e55c65ca40d7a2eecea481\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"机制描述多基于小鼠模型，直接应用于人类需谨慎，因为人鼠微生物组和免疫系统存在差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::31ab31711e6241723cdfa314\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中提到的“益生菌”涵盖从商业混合补充剂到定义明确的单一菌株（如CBM588），两者在成分、质量控制和潜在效果上截然不同，比较时需严格区分。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c16be694b7f8f95168cc4cea\",\n        \"source_handle\": \"P0357\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-d48cd64bd12b302ad2ba\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-76a4a344a1a9861e53c5\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-95bd9a77b14edf06222c\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementaryFiles_fetch_transport_TimeoutError\",\n              \"status\": \"missing\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::1e84d153ee9b84bcfe58dd94\",\n          \"snapshot::6e75af540e1165fa53a1929a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c3f7025f5aaf7b16f46e7943\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b1a5341367d4fe3983fade90\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6324c354c13d7e2ed705c1c9\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"作为一篇综述，本文通过系统梳理免疫学、分子病理学和放射组学的多学科证据，构建了一个整合性的“骨骼肌-肌动蛋白-肠道损伤-修复”调控网络。具体路线包括：1. 描述直肠癌TME的组成及其在免疫治疗下的动态重塑；2. 详细分析ICI诱导肠道损伤的核心机制（T细胞毒性、炎症风暴、菌群失调、血管/代谢紊乱、基质纤维化）；3. 引入骨骼肌作为非肿瘤因素，解析关键肌动蛋白（IL-6, IL-15, Irisin）的信号通路及其双向调节作用；4. 总结多模态影像技术在量化监测黏膜、血管和纤维化病变中的应用；5. 提出基于肌动蛋白稳态恢复的分层修复与管理方案。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2d5162d6cd233004604796a7\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"构建了以肌动蛋白为核心的“骨骼肌-肠道”交互调控网络，将全身性肌肉状态与局部肠道免疫毒性联系起来，超越了以往仅关注局部肠道损伤的视角。\",\n          \"limits\": \"主要基于现有文献的理论综合和机制推演，缺乏大规模前瞻性临床队列数据验证肌动蛋白作为预测生物标志物的特异性截断值和多中心标准化协议。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b2d7496150d88e8dc1579990\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了从分子机制到多模态影像表型再到分层干预策略的完整转化链条，为临床精准干预提供了系统性框架。\",\n          \"limits\": \"许多提出的干预策略（如肌动蛋白靶向药物、特定运动营养方案）仍处于临床前研究或早期临床试验阶段，尚未成为标准护理流程。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ae370a00b74f470391e6b856\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"在dMMR/MSI-H直肠癌TME中\",\n          \"finding\": \"ICI通过阻断PD-1/PD-L1和CTLA-4通路解除免疫抑制，但过度激活的CD8+ T细胞会错误识别肠上皮细胞抗原，导致黏膜溃疡和穿孔。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dc967120324ff4312b8260e3\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"骨骼肌健康状态良好时\",\n          \"finding\": \"分泌保护性肌动蛋白IL-15和Irisin，分别通过JAK/STAT5和CSF-1/STAT3通路增强抗肿瘤免疫并抑制M2型巨噬细胞极化，从而保护肠黏膜屏障。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::68f1f7fb0220bd4f57d34afe\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"存在肌肉萎缩（Sarcopenia）时\",\n          \"finding\": \"病理性高浓度IL-6持续激活NF-κB和JAK/STAT3通路，引发炎症风暴并促进成纤维细胞活化，加剧肠道炎症和纤维化，形成“肌肉萎缩-肠道损伤”恶性循环。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::796aaea2ba6098e425ca1a27\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"应用多模态影像技术时\",\n          \"finding\": \"NBI可早期发现黏膜糜烂和隐窝破坏；EUS-SWE可定量评估组织弹性以区分炎症水肿与不可逆纤维化；PET-CT可通过SUV值量化免疫细胞浸润和代谢活性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::32dbc1f152adbfb434a35f5a\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::36524ce30e3a3dcf0584c6dc\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管ICI对dMMR/MSI-H直肠癌疗效显著，但过度激活的免疫系统会导致严重的ICI相关结直肠损伤（ICI-CRI），且现有研究往往孤立地关注肠道免疫毒性或肌肉萎缩。本研究旨在阐明ICI-CRI的复杂病理机制，特别是骨骼肌-肌动蛋白轴在其中的核心调控作用，并整合影像学评估与分层修复策略，以解决免疫治疗中疗效与毒性平衡的临床难题。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2c5af816b476608df7b0cace\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"直肠癌（Rectal Cancer）免疫治疗，特别是针对dMMR/MSI-H亚型的免疫检查点抑制剂（ICIs）治疗；聚焦于ICI相关的结直肠损伤（ICI-CRI）及其与骨骼肌健康、肌动蛋白分泌的关联。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::29fbcbaf11332588955333ca\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该综述系统阐述了直肠癌肿瘤微环境（TME）的特征及免疫治疗引起的动态重塑，重点探讨了ICI诱导的结直肠损伤（ICI-CRI）的多重病理机制，包括CD8+ T细胞介导的细胞毒性、炎症因子风暴、肠道菌群失调导致的内毒素易位、微血管低灌注和基质纤维化。文章创新性地提出了“骨骼肌-肌动蛋白-肠道损伤”调控轴，指出骨骼肌分泌的肌动蛋白（IL-6, IL-15, Irisin）在调节抗肿瘤免疫与维持肠道稳态之间起核心作用：IL-15和Irisin具有保护作用，而过度分泌的IL-6则加剧炎症。此外，综述还介绍了结合多模态影像（如NBI结肠镜、EUS-SWE、PET-CT）和放射组学的定量监测方法，以及包括阶梯式免疫抑制、微生态重建、代谢支持和肌肉靶向运动/营养在内的分层修复策略，旨在为个性化直肠癌免疫治疗提供理论参考，以最大化疗效并减少胃肠道毒性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4b2107dd86fc8bcb2305e4ff\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"未直接提供菌群改变ICI抗肿瘤疗效的直接因果证据，而是侧重于其在毒性放大中的作用。\",\n          \"contribution\": \"提供了肠道菌群失调（如Akkermansia muciniphila减少，致病菌增殖）导致LPS易位并激活TLR4/NF-κB通路的机制描述，解释了菌群变化如何加剧ICI引起的全身和局部炎症。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::164e8028853a939519cae127\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要关注肌动蛋白介导的机制，未深入探讨菌群代谢产物（如短链脂肪酸）对肌动蛋白分泌的直接调控细节，需结合其他文献完善菌群-肌肉互作机制。\",\n          \"contribution\": \"详细阐述了肌动蛋白（IL-6, IL-15, Irisin）信号通路如何调节免疫细胞功能（CD8+ T细胞、NK细胞、Tregs、巨噬细胞）和肠道屏障完整性，揭示了肌肉-肠道轴在介导ICI效应中的分子机制。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::adcbb36487e510b419a3f23e\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"综述中关于直肠癌TME异质性（热肿瘤vs冷肿瘤）与免疫治疗响应关系的描述，以及骨骼肌作为全身免疫调节器官的概念。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::224903bcc9290c238b45be18\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"提到的肌肉萎缩患者更易发生严重ICI-Colitis，以及通过运动/营养改善肌动蛋白谱后可减轻损伤的案例。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cf32a97997422d3a95a713de\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"多模态影像（NBI, EUS-SWE, PET-CT）在评估ICI相关肠道损伤严重程度和纤维化阶段的临床应用价值。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f3c7290bcf33b550b4efd818\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述主要聚焦于直肠癌，特别是dMMR/MSI-H亚型，其结论外推至其他实体瘤或MSS型结直肠癌时需考虑TME异质性差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::906b28d3abb5c3b0d77174ec\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"肌动蛋白的作用多为机制推演和小型研究支持，尚缺乏大规模随机对照试验证实肌动蛋白靶向治疗的普适性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1793f9e7fa6bcfbb48823768\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"影像学生物标志物的标准化和外部验证仍在进行中，不同中心的阈值可能存在差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e66db4425b281195b80a0cf6\",\n        \"source_handle\": \"P0217\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-d48cd64bd12b302ad2ba\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-1174ae9904050ba25888\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-cf2fc9e893310420ac34\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-2ff301984ba9cb234942\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-46db1207a4d1cf0f573f\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementaryFiles_fetch_transport_TimeoutError\",\n              \"status\": \"missing\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51f89be549975819db34d833\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2620179246640ac636d56bd9\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b79fd70d6332212f4813f1df\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::14e691e33244b8717f4d127f\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"The research design involves three main components: 1) Clinical Cohort Analysis: Retrospective and prospective analysis of three independent cohorts (melanoma and NSCLC) to assess the association between irAE grades and survival outcomes, correcting for immortal time bias. 2) Microbiome Profiling: Shotgun metagenomics and high-throughput culturomics were performed on fecal samples from patients at baseline and at the onset of ir-colitis to characterize taxonomic shifts and isolate viable bacteria. 3) Functional Validation: Fecal microbiota transplantation (FMT) from ir-colitis patients into antibiotic-treated mice to assess effects on tumor growth and inflammation. Specific isolates (P. bifermentans, C. paraputrificum, P. sordellii) were tested in vitro (Caco-2 co-culture for barrier integrity and cytokine expression) and in vivo (oral gavage in DSS colitis and MCA-205 tumor models) to determine direct effects. Cell-free supernatants and heat-killed bacteria were also tested to distinguish live-bacteria-dependent effects from metabolite-mediated effects.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7338e32444ea409cd35d5626\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides empirical evidence linking specific gut bacteria (P. bifermentans) to both irAE pathogenesis and enhanced ICI efficacy through distinct mechanisms (barrier disruption vs. metabolite secretion).\",\n          \"limits\": \"The exact nature of the active < 3 kDa metabolite and its precise immune mechanism remain unidentified. The study relies on a limited number of matched longitudinal samples and mouse models that may not fully recapitulate human ir-colitis complexity.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ad228a9a09cf1bde833cd70d\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Three independent cohorts of melanoma and NSCLC patients treated with ICI\",\n          \"finding\": \"Grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f0f8a256e3b6de3f1f5a7dfd\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Baseline stool samples from melanoma patients analyzed via shotgun metagenomics\",\n          \"finding\": \"Patients developing grade ≥ 2 irAEs exhibited lower alpha diversity and enrichment of pro-inflammatory taxa including Ruminococcus gnavus and Streptococcus vestibularis compared to those without irAEs.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::69d42911848667bdf02843e3\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Stool samples from patients with ir-colitis analyzed via culturomics\",\n          \"finding\": \"Paraclostridium bifermentans was isolated and found to be enriched in patients with acute ir-colitis compared to baseline or non-ir-colitis controls.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4d3393b35296f0c4133f8239\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In vivo mouse models receiving FMT from ir-colitis patients\",\n          \"finding\": \"FMT induced surrogate markers of intestinal inflammation (increased Lcn-2 and LPS) and enhanced the anti-tumor efficacy of dual anti-PD-1/CTLA-4 therapy.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e7e6394717aa4609a837b993\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In vitro Caco-2 monolayer co-culture with P. bifermentans\",\n          \"finding\": \"Live P. bifermentans disrupted epithelial barrier integrity (reduced ZO-1 and Occludin signals) and increased pro-inflammatory cytokines (TNF-α and IL-1β); this effect was not observed with cell-free supernatant.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bd05dd22bf395b6bb6a493e0\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"In vivo murine tumor model with oral gavage of P. bifermentans derivatives\",\n          \"finding\": \"Oral administration of P. bifermentans enhanced anti-tumor response to dual ICI; this beneficial effect was retained by cell-free supernatant filtered to < 3 kDa, indicating mediation by a small-molecule metabolite rather than live bacteria.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::894d9adbbc30a71c986943d3\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::de73fe9ade530a582fbcc4a4\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"The study aims to resolve the mechanism underlying the observed correlation between irAEs and improved ICI efficacy. Specifically, it seeks to determine if specific gut microbial signatures predict irAEs and efficacy, and to identify causal bacterial agents that might drive both inflammation and anti-tumor responses.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::70fc3918076487e962a70529\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"The study focuses on patients with advanced melanoma and non-small cell lung cancer (NSCLC) treated with immune checkpoint inhibitors (ICI). It investigates the relationship between gut microbiome composition, the development of immune-related adverse events (irAEs), and clinical outcomes (overall survival and progression-free survival). The research combines clinical cohort analysis with shotgun metagenomics and culturomics to identify specific bacterial taxa and their functional roles.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ae76f027dd241b7100eeee0\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This study addresses the paradoxical link between immune-related adverse events (irAEs) and improved efficacy in ICI therapy by dissecting the role of the gut microbiome. Using three independent cohorts totaling 589 patients with melanoma or NSCLC, the authors first validated that grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias. They then employed a combined approach of shotgun metagenomics and culturomics on fecal samples collected at baseline and during ir-colitis onset. Metagenomic analysis revealed that patients developing irAEs had lower alpha diversity and enrichment of pro-inflammatory taxa such as Ruminococcus gnavus and Streptococcus vestibularis. Culturomics identified Paraclostridium bifermentans as enriched in patients with acute ir-colitis. Functional validation in mice demonstrated that fecal microbiota transplantation from an ir-colitis patient induced subclinical colitis markers and enhanced anti-tumor activity of dual ICI. Specifically, P. bifermentans was shown to disrupt epithelial barrier integrity in vitro and exacerbate colitis in vivo via live bacteria interaction, while its anti-tumor benefit was mediated by a secreted low-molecular-weight metabolite (< 3 kDa). These findings provide a mechanistic link suggesting that specific pro-inflammatory bacteria can simultaneously drive toxicity and enhance therapeutic efficacy.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3aba09de1928023c017e60a8\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Comparison of metagenomics and culturomics results showing that culturomics recovers live, low-abundance bacteria (like P. bifermentans) missed or less characterized by sequencing alone.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::68b54a3451f1ab3d7966a2e1\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Discussion of immortal time bias in analyzing irAE-survival associations and the correction applied in this study.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e80331c46c052c7581ada8d5\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"The association is observational; causality is inferred through subsequent mechanistic studies but not proven in the clinical cohort alone. Results may vary by cancer type and geography.\",\n          \"contribution\": \"Validates the clinical association between irAEs and improved ICI outcomes across multiple solid tumor cohorts (melanoma and NSCLC), confirming that higher-grade irAEs correlate with longer OS and PFS. Identifies specific microbial signatures (e.g., S. vestibularis, H. porci) associated with both irAE and response states.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f5b77f6f89c89b517fbf6126\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"The mechanism is derived from mouse models and in vitro assays; the exact metabolite identity is unknown. The effect of live bacteria on barrier integrity is distinct from the metabolite's effect on tumor response, highlighting complex, context-dependent interactions.\",\n          \"contribution\": \"Demonstrates a specific mechanism where Paraclostridium bifermentans enhances ICI efficacy via a secreted low-molecular-weight metabolite (< 3 kDa), while simultaneously causing ir-colitis through live-bacteria-induced epithelial barrier disruption. Shows that FMT from ir-colitis patients transfers both inflammatory potential and enhanced ICI response.\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9964b8d843b952c18995daf5\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The study identifies P. bifermentans as a key player, but the exact metabolite responsible for the anti-tumor effect is not characterized; do not overstate the specificity of the molecular mechanism.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1482d971688f8c6a45f4eb09\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Mouse models used (MCA-205, DSS) have limitations in fully recapitulating human ir-colitis; results should be framed as preclinical evidence supporting human observations.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c16c42850044684ec971f685\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The 'dual role' of P. bifermentans involves two different mechanisms (live bacteria for toxicity, metabolite for efficacy); ensure this distinction is clear when citing.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cafb8802dcc1f5812d97e5ec\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Clinical associations are based on retrospective/prospective cohorts with potential confounders; causality is established primarily through animal models, not clinical intervention.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6bf40b4009f92b8ad4a0426c\",\n        \"source_handle\": \"P0284\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"asset_id\": \"asset-7974b6c4dd5220685baa\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-95bd9a77b14edf06222c\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5c752c0f8036d5742e42\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-a7194a689f46f19f0fc9\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"asset_id\": \"asset-5f82ba52a99d38e52a55\",\n              \"kind\": \"asset\",\n              \"reason\": \"caption_or_locator_without_readable_image\",\n              \"status\": \"caption_only\"\n            },\n            {\n              \"kind\": \"assets\",\n              \"reason\": \"supplementaryFiles_fetch_body_too_large\",\n              \"status\": \"missing\"\n            }\n          ],\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::c66fbeaa280c108e014af7cc\",\n          \"snapshot::384337303cf1d585cd3ac32a\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4592207a67511b3fef7ce24a\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b76c4adfad47d59dd2f7f125\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6e63b53d0ba24e85b6ba1c2e\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"作为一篇综述，本文采用主题综合路线：1. 背景引入：阐述CIT的临床现状、耐药性及代谢组学在理解肿瘤-免疫互作中的价值。2. 微生物调控机制：综述微生物群对免疫过程的影响，比较益生菌干预的争议性结果（如小鼠模型 vs 人类数据）。3. 关键代谢物分析：分章节深入讨论SCFA（乙酸、丙酸、丁酸等）的作用机制（HDAC抑制、GPCR激活）、对T细胞分化/记忆的影响，以及色氨酸-犬尿氨酸通路的免疫抑制机制。4. 临床证据汇总：整合来自不同癌症类型（黑色素瘤、NSCLC等）的患者队列研究，列举特定代谢物水平与无进展生存期（PFS）或总生存期（OS）的相关性。5. 转化与挑战：讨论直接补充代谢物的可行性、纳米递送策略的前景，以及IDO抑制剂临床试验失败的原因分析。6. 展望：提出将代谢组学纳入临床实践以监测疗效和不良事件的建议。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5cb634b8325cfd02a65a8a73\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"系统梳理了肠道微生物代谢物（SCFA、色氨酸代谢物）在CIT疗效中的双重作用（促进效应T细胞 vs 诱导耐受/抑制），提供了从分子机制到临床生物标志物的全景视图。\",\n          \"limits\": \"所给摘要未交代具体的文献检索策略、纳入排除标准及质量评价方法，属于叙述性综述而非系统性综述。部分结论基于小规模临床研究或动物模型，外推至人类需谨慎。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8abb75f525dd23cd11bc2152\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"指出了IDO抑制剂临床试验失败的潜在原因（剂量、患者选择、缺乏代谢物监测），为未来试验设计提供反思。\",\n          \"limits\": \"对于SCFA直接补充在肿瘤患者中的安全性及有效性，目前仅停留在理论推测和小规模自身免疫病数据支持阶段，缺乏大规模肿瘤临床试验证据。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ff180dbefd6306f9f063d425\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"黑色素瘤和肾癌患者接受CIT治疗\",\n          \"finding\": \"基线至第4周犬尿氨酸/色氨酸（Kyn/Trp）比率增加超过50%的患者，其总生存期显著低于比率降低的患者（黑色素瘤中位OS 15.7个月 vs >38个月；肾癌中16.7个月 vs 31.3个月）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::472b9e06c54aa635de7e36dc\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"非小细胞肺癌（NSCLC）患者接受二线Nivolumab治疗\",\n          \"finding\": \"粪便中丙酸、丁酸、赖氨酸和烟酸的升高水平与超过12个月的无进展生存期（PFS）相关。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::325542a47112ac639ab70471\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"黑色素瘤患者接受CIT治疗\",\n          \"finding\": \"响应者血浆中乳酸水平显著高于非响应者，而丙酮酸水平较低，提示响应者T细胞向糖酵解模式发生代谢重编程；而非响应者血清中丙酮酸和丙氨酸水平较高。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4f421cf3b56d28545ad0ddd8\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"小鼠黑色素瘤模型\",\n          \"finding\": \"补充商业益生菌（如长双歧杆菌、鼠李糖乳杆菌）反而导致肿瘤增大，伴随浸润性IFN-γ产生CD8+ T细胞频率降低；而罗伊氏乳杆菌（L. reuteri）通过释放吲哚-3-甲醛（I3A）激活AhR受体，增强了抗肿瘤免疫。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f5cc992ca1f801835d1ca7de\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"自身免疫性疾病（如多发性硬化症、类风湿关节炎）\",\n          \"finding\": \"SCFA（如丙酸）补充可增加调节性T细胞（Tregs）数量和功能，表明其在免疫调节方面的潜力，但在肿瘤学中尚未系统应用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7c0e2107b5b03c47befa9327\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e5b4ce3810bfd1ebf3668070\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管CIT是实体瘤治疗的常规手段，但存在显著的耐药性和进展问题，且缺乏可靠的预测性生物标志物。本研究旨在理解肿瘤-药物-免疫系统相互作用中的动态事件，特别是通过代谢组学视角，探索如何利用微生物衍生的代谢物来增强免疫反应、克服耐药性，并识别潜在的预测性生物标志物。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b644c59cb5947b8ca365930c\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"免疫检查点抑制剂（CIT）治疗下的实体瘤患者；聚焦于肠道微生物群及其代谢产物（特别是短链脂肪酸SCFA和色氨酸代谢物）对免疫系统及肿瘤微环境（TME）的影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d3110b273e34a9383ac3de88\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"这是一篇2025年发表的综述文章，旨在探讨免疫代谢在优化CIT疗效中的作用。文章首先指出CIT面临耐药性和生物标志物缺乏的挑战，随后系统回顾了肠道微生物衍生的代谢物如何调节免疫反应。重点讨论了短链脂肪酸（SCFA）通过表观遗传和代谢重编程增强CD8+ T细胞功能及记忆形成，以及色氨酸分解代谢（IDO1/Kynurenine通路）作为原发性CIT失败预测因子的角色。此外，文章还分析了葡萄糖、氨基酸和脂质等其他代谢特征与CIT预后的关联，并评估了直接补充代谢物或靶向递送策略的潜力，同时指出了当前临床转化的局限性和未来方向。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7153f06a14631bf9868707e4\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"样本量较小（如Botticelli et al. n=11, Nomura et al. n=52），且不同研究间代谢物测量部位（粪便vs血浆）和癌症类型不同，结果可能存在异质性。不能直接推断因果关系，仅为观察性关联。\",\n          \"contribution\": \"提供了肠道微生物代谢物影响CIT疗效的具体临床关联证据。例如，粪便SCFA水平与NSCLC患者PFS的正相关性，以及色氨酸代谢异常与黑色素瘤/肾癌患者OS的负相关性。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::45f344091216d4c71eef5c6a\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"许多机制细节源自小鼠模型（如germ-free mice, adoptive transfer），需注明物种差异限制。作者提到的“代谢重编程”多为假设性解释，需结合其他实验验证。\",\n          \"contribution\": \"详细阐述了微生物代谢物调节免疫细胞的分子机制。包括：1) SCFA通过抑制HDAC和激活GPCRs（如GPR43, GPR41）促进CD8+ T细胞效应功能和记忆形成；2) 色氨酸分解通过IDO1途径产生犬尿氨酸，抑制T细胞增殖并诱导Treg分化；3) 代谢重编程（如糖酵解增强）对T细胞功能的重要性。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9a856efced7c50c546f85e0c\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要依据是小鼠预临床数据，人类数据有限且多为自我报告或小型观察性研究。不能据此推荐或反对通用的益生菌使用。\",\n          \"contribution\": \"提供了关于益生菌干预效果的矛盾证据。指出某些商业益生菌在小鼠模型中损害抗肿瘤免疫，而特定菌株（L. reuteri）可能有益，强调了菌株特异性和情境依赖性。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6dbc35e5cf5535a7ebc5da63\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"综述提到血清代谢组学（LC-MS, GC-MS）可捕捉全身代谢改变，而单细胞/空间代谢组学可解析TME内的异质性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6b2af9ea78a9935c166d18ba\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"ECHO-301/Keynote 252试验显示Epacadostat联合Pembrolizumab无显著获益，原因可能包括剂量不足、缺乏患者分层（基于IDO表达或代谢物水平）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2d34be80767bef25aff627b6\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"升高的Kyn/Trp比率与更高的irAEs风险相关；脂质代谢改变可区分结肠炎或肝炎患者。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a4976b183bc0da1823b2cb1f\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该综述为叙述性综述，非系统性综述，其结论代表作者对现有文献的综合解读，而非经过严格统计合并的证据等级。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::301c565beaa0d2a05578fee4\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中引用的多项临床研究样本量较小，且多为回顾性或横断面研究，因果推断能力有限。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3406fd57edb20293d70fa2d4\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"动物模型（尤其是无菌小鼠）的结果不能直接外推到人类，需注意种属间免疫系统和微生物组的差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3ad20de80a3b89756f8f17e5\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"关于SCFA补充剂的讨论主要基于自身免疫病数据和理论推导，在肿瘤患者中的安全性和有效性尚未经过大规模随机对照试验证实。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f8e3583a651a78554481cd0f\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"IDO抑制剂临床试验的失败并不意味着IDO通路不重要，而是提示当前治疗策略或试验设计的局限性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::cbf74d700e02472eb82c54b6\",\n        \"source_handle\": \"P0472\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ca0cd8cf75bc9b1aa650c230\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8e55a8c9d389564d56630951\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::69b79394d0726b95b6065fa9\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1788373d25e3a170db3bb0aa\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"1. 队列设计：两项前瞻性非随机队列（宏基因组n=54，代谢组n=49），基于疗效（PFI≥1年）和irAE严重程度（≥2级）将患者分为获益组、严重irAE组和耐药组。采用地标分析（Landmark analysis）以1年为界评估irAE，减少 immortal time bias。2. 多组学分析：宏基因组测序鉴定物种丰度、共现网络、功能通路（如SCFA合成基因）；代谢组GC-MS定量SCFA。3. 分子模拟分析：将微生物序列与自身免疫疾病抗原库及肺癌抗原/抗癌肽数据库比对，识别交叉反应表位。4. 菌株水平分析：使用StrainPhlAn分析大肠杆菌和普拉梭菌的SGBs变异及系统发育信号。5. 外部验证：在McCulloch（黑色素瘤ICI）、Routy（NSCLC ICI）等公共数据集上验证SCFA预测值和抗原模拟结果。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::27dd931bd58169567e4a4506\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"首次提供实证证据支持微生物组通过分子模拟驱动irAEs（自身免疫抗原模拟）和ICI疗效（肿瘤抗原模拟）的假设。揭示了长期获益者特有的紧凑微生物网络和丁酸高产能力。明确了菌株水平变异（而非仅物种丰度）对临床表型的决定性作用。\",\n          \"limits\": \"样本量较小（宏基因组n=54，代谢组n=49），可能限制统计效力。抗原模拟分析依赖于公共数据库中的已知表位，可能遗漏未表征的关键表位。菌株分析仅针对丰度较高的少数物种。所有样本为基线采集，无法反映治疗过程中的动态变化。外部验证队列的治疗方案和肿瘤类型不完全一致（如黑色素瘤vs肺癌）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::48c7437a9bc25839f3746846\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"对比获益组与耐药组（宏基因组预测+代谢组验证）\",\n          \"finding\": \"获益组富集丙酸（P=0.01）和丁酸/异丁酸（P=0.12/0.02）。乙酸、丙酸、丁酸水平越高，PFS越长，肿瘤进展风险越低（HR<1, P<0.05）。丁酸生产主要受乙酰辅酶A途径介导。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a4e6d4ef4b3160f0c43baaa5\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"对比irAE组与非irAE组\",\n          \"finding\": \"irAE患者微生物中与系统性红斑狼疮（SLE）、皮肤/结缔组织自身免疫病相关的抗原表位对齐数量更多，特别是在免疫性结肠炎患者中SLE相关表位显著富集（P=0.04）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f2e549ea2a38a11164f7f0ca\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"对比高疗效组与低疗效组\",\n          \"finding\": \"高疗效组微生物中与肺癌相关的抗原和抗癌肽（ACP）表位对齐数量更多（P=0.07/0.06），并在Routy队列中得到部分验证（P=0.02）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7cfa37c4ed6bd29db16e931a\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"特定物种（大肠杆菌、普拉梭菌）\",\n          \"finding\": \"菌株水平变异与临床表型强相关。例如，普拉梭菌SGB15342在获益组中富集，而SGB15323/332_group倾向出现在严重irAE组。不同组间存在高突变率，表明菌株特异性决定功能。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bd986072923c2c8b143e0469\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f1aa6ce49462b4fc36bf4e98\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管已知肠道微生物组影响ICI的初始疗效和irAEs，但其对长期生存获益的具体影响及底层机制（如代谢物、分子模拟、菌株变异）尚不清楚。特别是区分长期获益者与耐药者或仅发生irAE者的微生物特征差异。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8723f2c5d07d798f6a11ec0f\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"中国北京协和医院晚期非小细胞肺癌（NSCLC）患者，接受抗PD-1/PD-L1免疫检查点抑制剂（ICI）治疗。研究聚焦于基线肠道微生物组与代谢组特征对长期疗效（无进展生存期PFI≥1年）及免疫相关不良事件（irAEs）的影响。样本分为长期获益组、严重irAE组和耐药组，并通过外部公共队列（McCulloch, Routy等）进行验证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6739f5f8fdd552af3ccd0592\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究旨在阐明肠道微生物组如何影响肺癌患者ICI治疗的长期结局及其潜在机制。通过前瞻性收集基线粪便样本进行宏基因组和代谢组测序，结合临床随访数据，分析微生物组成、短链脂肪酸（SCFA）水平、分子模拟现象及菌株变异与临床表型的关系。研究发现，长期获益患者拥有更紧凑的微生物网络和高产丁酸/丙酸的能力；irAE患者的微生物中存在与自身免疫抗原相似的表位；响应患者的微生物中富含与肺癌抗原相似的表位；且特定物种（如大肠杆菌和普拉梭菌）的菌株水平变异与临床表型显著相关。这些发现为“智能”粪菌移植提供了理论依据。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1853254a590326de7a98b136\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"数据主要来自肺癌患者，虽在黑色素瘤队列中验证了丙酸/丁酸趋势，但需注意肿瘤类型的异质性。关联性强，但因果链条需结合其他干预研究理解。\",\n          \"contribution\": \"提供了SCFAs（乙酸、丙酸、丁酸）作为预测ICI长期疗效的生物标志物的实证数据。具体指出丁酸生产依赖乙酰辅酶A途径，且高水平SCFA与延长PFS和降低进展风险相关。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9d439e44dd010530a60fd704\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"分子模拟的证据基于序列同源性比对，属于相关性/预测性证据，尚未通过体内实验直接证明T细胞交叉反应。抗原数据库可能存在偏差。菌株分析仅限于少数物种。\",\n          \"contribution\": \"提出了并初步验证了“分子模拟”机制：1) 微生物抗原模拟宿主自身免疫抗原导致irAEs（特别是SLE相关表位在结肠炎患者中富集）；2) 微生物抗原模拟肿瘤抗原增强ICI疗效。同时强调了菌株特异性（如大肠杆菌毒力基因簇）在决定irAE或耐药中的作用。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f9084d13af5236dab61bb354\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Co-occurrence networks showing compactness in benefit group; enrichment of butyrate producers like F. prausnitzii, Blautia.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::12d03fe22e6c6021e4b4f5e8\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Discussion section proposing 'smart' FMT based on strain dynamics and antigen mimicry profiles.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fdc428f23c1a35942c603cdd\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究的分子模拟结论是基于生物信息学预测（序列比对），并非直接的免疫学功能验证（如T细胞克隆追踪），在综述中应表述为“提示”或“初步证据”，而非确证机制。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a15aad3974479b8ec5c7e50f\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"菌株水平的发现仅适用于大肠杆菌和普拉梭菌等丰度较高的物种，不能推广到所有微生物。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d73df87bb79df88cf488a874\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"外部验证队列（McCulloch, Routy）在肿瘤类型和治疗方案上与主队列存在差异，解读时需考虑肿瘤微环境异质性的影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9d5f0d5e9220739bab7fe6fd\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"irAE分析采用了地标分析以校正时间偏倚，这是该方法学上的优势，但在比较不同研究时需注意终点定义的一致性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dba1ca498c98136c62e2487b\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"supplement_materials\"\n        ],\n        \"value\": [\n          {\n            \"auxiliary_material\": \"The study employed landmark analysis to minimize immortal time bias in irAE assessment and validated efficacy-related metabolite findings in external cohorts (Routy, McCulloch). The discussion proposes a 'smart' fecal microbiota transplantation concept based on strain dynamics and antigen mimicry profiles. The study design was a non-randomized, unblinded, prospective cohort with median follow-up of 1167 days.\",\n            \"evidence\": [],\n            \"gap_id\": \"Ch6_gap_5\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N4452dfb25f491e9335fe-5a6b848383c152a3\\\\round_2\\\\supplements\\\\Ch6_gap_5\\\\attempt-u2gi65cq\\\\source_units\\\\SU01_search_candidate_4e312d3d88\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"The specific request for large-scale microbiome association studies focused on non-colitis irAEs (such as myocarditis or neurotoxicity) is not fulfilled by this material. While this study includes some non-colitis irAE cases (e.g., cardiovascular, muscle) within a composite 'severe irAE' group, the total sample size (n=13 for severe irAE) is small, and there is no dedicated large-scale analysis for specific non-colitis subtypes. The authors' own admission of limited sample size confirms the ongoing evidence gap regarding statistical power for specific irAE subtypes.\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": \"This study investigated gut microbiome and metabolome associations with long-term ICI outcomes and immune-related adverse events (irAEs) in a prospective cohort of lung cancer patients (metagenome n=54, metabolome n=49). The authors grouped patients into benefit, severe irAE, and resistance categories. The severe irAE group (n=13 in metagenome cohort) included various irAE types such as cardiovascular toxicity (2 cases), muscle toxicity (1 case), endocrine, skin, and gastrointestinal toxicities, rather than focusing exclusively on colitis. Mechanistically, the authors reported that microbiota sequences from irAE patients aligned with autoimmune antigenic epitopes (molecular mimicry), particularly noting SLE-related epitopes enriched in colitis patients, and that beneficial outcomes correlated with higher short-chain fatty acids (SCFAs) like butyrate and propionate. Strain-level variations in Escherichia coli and Faecalibacterium prausnitzii were also associated with clinical phenotypes. The authors explicitly stated in the limitations that the sample size was relatively small due to strict quality control and long-term follow-up requirements.\"\n          }\n        ],\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::41eac1d693544443b3b7f8f8\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::51342908369a3d1c46566ac3\",\n          \"snapshot::59aab1e2a170fac4e9fc15c6\",\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a51e25fe21f9f078bc3908f8\",\n        \"source_handle\": \"P0462\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::0e9c11fd9439a46e9f2334bc\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a206618928461fac1bccda86\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::55e8883400f09867671b14c1\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::593dd584fb31d25664549f76\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"作为一篇Perspective文章，本研究未进行新的实验，而是基于对Blake等人原始实证研究的解读、现有文献（如ICB治疗中微生物的作用）的综合分析以及临床转化视角的评议。文章通过对比不同免疫疗法（ICB vs IAA）中微生物作用的异同，构建关于微生物介导毒性的理论框架，并讨论未来研究方向。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9d4e88c5861adeacfba25b2b\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了肠道微生物群介导免疫激动剂抗体（IAA）特异性毒性的机制解释（MyD88依赖性炎症通路），区分了不同IAA靶点（CD40 vs CD137）下的效应细胞差异（巨噬细胞/中性粒细胞 vs CD8+ T细胞）。\",\n          \"limits\": \"所给材料为评论性综述，未提供新的原始数据；未深入探讨具体致病菌株或代谢物；未解决抗生素治疗可能削弱整体免疫疗效的两难困境。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::63ab8a170400cc8b52e2a04f\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"在抗CD40免疫激动剂抗体（IAA）治疗背景下\",\n          \"finding\": \"肠道微生物群的存在导致MyD88依赖性的巨噬细胞激活，进而产生TNFα、IL-6和IFN-I等炎症因子，引起急性肝损伤（巨噬细胞和中性粒细胞依赖）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ba8c40c966a55ac69fa5c46\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"在抗CD137免疫激动剂抗体（IAA）治疗背景下\",\n          \"finding\": \"毒性同样收敛于宿主MyD88被肠道微生物激活，但导致的是CD8+ T细胞依赖的肝损伤和IFNγ驱动的系统性炎症。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::94d67c6b60c901743600ca1d\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"无菌小鼠或经抗生素处理的小鼠模型\",\n          \"finding\": \"IAA治疗相关的毒性显著降低，且未观察到抗肿瘤免疫力的有害影响。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4198643ca5be7b342caa6236\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"perspective\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f26edbe5015e9f0921d1d9cb\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"尽管已知肠道微生物影响癌症治疗反应，但其介导免疫激动剂抗体（IAA）毒性的具体机制尚不清楚，且如何平衡疗效与毒性仍是一个关键挑战。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fbd72622ace5bb68d2208e8a\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"癌症免疫治疗中的肠道微生物群，特别是针对免疫激动剂抗体（IAA）的毒性机制；涉及临床前模型（小鼠）与人类临床观察的联系。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::432c07c02c59977b879fe092\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇评论性文章（Perspective），主要评述了Blake等人近期在《Cell Reports Medicine》发表的研究成果。该研究通过临床前模型发现，肠道微生物群通过MyD88依赖性途径激活宿主免疫系统，导致在使用抗CD40和抗CD137等免疫激动剂抗体（IAA）治疗时引发严重的系统性炎症和肝毒性。作者指出，虽然抗生素清除菌群可减轻毒性，但也会损害其他免疫疗法的效果，因此强调需要更精细地靶向微生物-宿主互作的具体分子机制，而非简单使用广谱抗生素。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::91578d82f6254e6e4980051e\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要针对免疫激动剂抗体（IAA）的毒性机制，而非直接解释免疫检查点抑制剂（ICB）的疗效增强机制；机制细节基于临床前小鼠模型，需警惕外推到人体的复杂性。\",\n          \"contribution\": \"详细阐述了肠道微生物通过MyD88通路介导IAA毒性的具体机制：在抗CD40治疗中，微生物激活巨噬细胞产生TNFα/IL-6/IFN-I导致肝损伤；在抗CD137治疗中，激活导致CD8+ T细胞依赖的IFNγ炎症。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::60c245848565553f2f3e83d1\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"主要关联毒性而非直接提升疗效的机制；未提供具体的预测性菌株列表。\",\n          \"contribution\": \"指出肠道微生物多样性与特定菌群组成是预测免疫治疗反应和毒性的潜在生物标志物；提示微生物群落作为一个整体（consortium）发挥作用，而非单一物种。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f5846f438b9593af16963b6b\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"文中提到“microbiome depletion using broad-spectrum antibiotics... significantly worsens clinical outcomes”以及未来需识别“specific, druggable proteins”。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::542895e293716593a2d566b0\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"文中对比了Figure 1中灰色箭头（ICB的STING机制）和红色箭头（IAA的MyD88机制）。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::81a29a1875006bbddf313f11\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"本文重点在于解释IAA的毒性机制，而非直接证明其对ICB疗效的增强机制，需注意区分这两种不同的临床结局。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::24416fef43446153d7d0a0d3\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"所有机制证据均来自临床前小鼠模型（无菌鼠、抗生素处理鼠），直接外推至人类患者需谨慎，人类微生物组的复杂性和个体差异未被充分涵盖。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::08ff82200c729eacf8d1b850\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文章明确指出未进行具体致病菌株的深度表征，因此不能将其作为确定特定风险菌种的依据。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::daea9a934bc79b30b3aea6c1\",\n        \"source_handle\": \"P0126\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::d77a8c0088cfe726193fbc3d\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::27c32f0cbdf6aaf9019107c6\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"abstract\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4dd8dc1dc0429cdd4fb80643\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::81e1c5626dc89331329fdfef\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用小鼠模型进行体内实验。具体设计包括：1. 构建心肌细胞限制性抗原表达的小鼠模型，以模拟心脏自身免疫情境；2. 应用不同的免疫检查点阻断策略（单独αPD-1、单独αCTLA-4、联合αCTLA-4+αPD-1），观察对CD8 T细胞扩增、心肌炎症及心律失常的影响；3. 通过遗传学手段（基因敲除CD8 T细胞来源的TNF）或药理学手段（阻断TNFR2）验证特定信号通路在心肌损伤中的作用；4. 评估干预措施对心脏毒性和抗肿瘤疗效的双重影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e962b12cc27bd595176c8762\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"揭示了ICI心肌炎的一个非细胞毒性依赖机制：即CD8 T细胞来源的TNF通过TNFR2信号轴驱动炎症和心律失常，而非传统的穿孔素/颗粒酶途径。\",\n          \"limits\": \"所给摘要未交代该机制在人类患者中的直接验证情况；未提供具体的临床数据或不同肿瘤类型间的比较；未详细阐述TNF阻断剂的具体类型或给药方案是否已在临床前完全优化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3831ae27277fe4952a56af75\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"联合使用αCTLA-4和αPD-1阻断\",\n          \"finding\": \"特异性诱导抗原特异性CD8 T细胞的强烈扩增、心肌炎症和致死性心律失常。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::15686099d8908c840b0782e6\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"单独使用αPD-1阻断\",\n          \"finding\": \"允许初始自身反应性CD8 T细胞的致敏和效应分化。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9aa52ba7c24a9513afdb33b6\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"同时抑制CTLA-4\",\n          \"finding\": \"在PD-1阻断基础上，显著放大心脏病理损伤。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7c90b549ce2ddff0d0a64474\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"心肌损伤机制分析\",\n          \"finding\": \"损伤独立于穿孔素介导的细胞毒性，但关键依赖于T细胞来源的TNF，该TNF促进髓系细胞招募、细胞因子产生和心律失常。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2695e8d8f452ddee02e24874\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"基因敲除CD8 T细胞来源的TNF或阻断TNFR2\",\n          \"finding\": \"成功预防了心脏毒性，同时保留了抗肿瘤疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3b1dbb4dc5e9240fc44f5bc6\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b47a52095995e6cdd12dc8d1\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"免疫检查点抑制剂（ICIs）虽能改善癌症生存率，但常引发致命的免疫相关不良事件，特别是暴发性心肌炎，且目前缺乏有效疗法。本研究试图解决的关键问题是：ICIs究竟通过何种具体免疫机制驱动心脏自身免疫和心肌损伤？\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::375670dffbb10dcb97c630f1\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"免疫检查点抑制剂（ICIs）诱导的致命性心肌炎机制；研究对象为小鼠模型，通过心肌细胞限制性抗原表达模拟心脏自身免疫反应。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::90fa68dcb73e696281128b29\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本研究旨在阐明ICIs引发致死性心肌炎的分子机制。研究团队开发了一种小鼠模型，利用心肌细胞限制性抗原表达来定义ICIs如何驱动心脏自身免疫。研究发现，联合使用抗CTLA-4和抗PD-1抗体可特异性诱导抗原特异性CD8 T细胞的强烈扩增、心肌炎症和致死性心律失常。其中，PD-1阻断单独允许初始自身反应性CD8 T细胞的致敏和效应分化，而同时抑制CTLA-4则放大了心脏病理损伤。出乎意料的是，心肌损伤不依赖于穿孔素介导的细胞毒性，而是关键性地依赖于T细胞来源的TNF，后者促进了髓系细胞招募、细胞因子产生和心律失常发生。基因敲除CD8 T细胞来源的TNF或阻断TNFR2可预防心脏毒性，同时保留抗肿瘤疗效。这些发现确立了一个由TNF-TNFR2驱动的炎症级联反应作为ICI心肌炎的核心机制，并提出了将心脏毒性与免疫治疗益处解耦的策略。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6ec05039403b1e9e43316a69\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"该研究基于小鼠模型，其机制在人体中的普适性尚需确认。此外，该研究聚焦于心脏毒性，未涉及肠道菌群，因此不能直接回答菌群如何调节ICI疗效的问题，只能作为ICI全身免疫效应的一个侧面案例。\",\n          \"contribution\": \"提供了ICI诱导心脏毒性的具体分子机制细节：CD8 T细胞来源的TNF通过TNFR2信号促进髓系细胞招募和炎症，导致心律失常。这一机制独立于穿孔素介导的直接杀伤。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2524b8280e063efe94c2a411\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"ICI可导致暴发性心肌炎，其机制涉及CD8 T细胞活化和TNF信号通路。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a17f82f767433f2f8669c5e9\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"心肌损伤可由TNF介导的炎症驱动，而非仅由细胞毒性T细胞的直接杀伤引起。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0649fd2cf2b24636e15937e2\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究结果来自小鼠模型，不能直接外推至人类患者的临床疗效或安全性预测。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e288f8e5544a91be2eaaa961\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"研究聚焦于心脏毒性机制，未涉及肠道菌群，因此不能直接用于回答菌群如何调节ICI疗效的问题，仅能提供机制层面的旁证或背景。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a9b0af20662549bd10035d57\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者声称TNF阻断可保留抗肿瘤疗效，但这仅在特定小鼠模型中观察到，实际临床应用中需警惕TNF阻断对肿瘤微环境的潜在负面影响。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0683d8680fc0be8cf6953633\",\n        \"source_handle\": \"P0149\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"known_gaps\": [\n            {\n              \"kind\": \"identity\",\n              \"reason\": \"source identity was not independently verified\",\n              \"status\": \"input_attributed\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"no complete research body was indexed\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"html\",\n              \"reason\": \"html_not_scholarly_body\",\n              \"status\": \"partial\"\n            },\n            {\n              \"kind\": \"coverage\",\n              \"reason\": \"only abstract or non-title snippets were available\",\n              \"status\": \"partial\"\n            }\n          ],\n          \"material_scope\": \"abstract_only\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::458437782a562f994cbafc81\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::908b08fe177a0263d4b6c01a\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0795fe4760e84d1c7f439b36\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::793bf60ef299d402e03684dc\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"作为一篇综述，本研究未进行新的实验数据采集。其综合路线为：1. 文献回顾：汇总关于HLA与心肌炎/DCM关联的候选基因研究、GWAS信号、动物模型及转基因模型证据；2. 机制整合：将观察到的遗传关联与免疫学机制（如抗原呈递、T细胞激活、分子模拟、微生物组交叉反应）相结合，构建病理生理框架；3. 批判性评估：分析现有研究在效应大小、人群多样性和临床转化方面的不足；4. 提出建议：基于上述分析，提出未来研究优先事项（如多民族队列、免疫基因组整合）。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7a9996e802273453b370bbf6\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"系统整合了HLA在心肌炎/DCM中的遗传关联与免疫机制，特别是强调了HLA-II类分子在打破免疫耐受和驱动自身免疫中的核心作用，以及微生物组作为潜在分子模拟源的新兴证据。\",\n          \"limits\": \"所给摘要未交代具体的文献检索策略、纳入排除标准及质量评价方法；主要依赖已发表的研究结果进行叙述性综合，缺乏定量荟萃分析数据；对具体HLA等位基因与特定病毒表位的精确对应关系尚不明确。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f6a19cf0cb52e0209022dc5c\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"特定HLA等位基因存在时\",\n          \"finding\": \"HLA-DR4、HLA-B27等风险等位基因与特发性DCM及心肌炎易感性增加相关；HLA-DR3可能具有保护作用。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::88079a6f8d092733e33eba9a\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"病毒感染背景下\",\n          \"finding\": \"HLA多态性影响病毒清除效率；低效呈递可能导致病毒持续存在，而高效呈递可能引发旁观者损伤或分子模拟，触发针对心脏自身抗原（如肌球蛋白）的自身免疫反应。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e7d5b8c5926100b2134ee999\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"转基因小鼠模型中\",\n          \"finding\": \"表达人类HLA-DQ8的转基因小鼠在无感染情况下自发产生自身免疫性心肌炎，证明特定HLA等位基因可直接降低自身免疫阈值。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c5ad4c7bc248aa8aec498433\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"微生物组交互中\",\n          \"finding\": \"肠道共生菌（如拟杆菌属）产生的肽段可能与心脏肌球蛋白表位发生分子模拟，激活自体反应性CD4+ T细胞，且抗生素干预可预防该过程。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1a8dd8b1d40ce69592898531\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::79eed18f2d0fc11322a56381\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"明确HLA多态性如何决定心肌炎患者是清除病毒自愈，还是发展为持续性自身免疫损伤进而导致DCM；识别当前研究中的知识空白以指导临床转化。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c8074a4e4ec33b1d79d1156f\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"心肌炎（Myocarditis）和扩张型心肌病（DCM）；人类白细胞抗原（HLA）系统多态性；适应性免疫、分子模拟、自身免疫机制。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b2cb4b4df74b55977a1a9e10\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇综述，旨在阐明HLA多态性在心肌炎进展、抵抗及结局中的作用。文章梳理了HLA通过抗原呈递影响适应性免疫的机制，包括HLA-I类分子介导的抗病毒反应和HLA-II类分子驱动的自身免疫过程。重点讨论了分子模拟、病毒持续感染、微生物组相互作用等机制如何导致从急性炎症向慢性自身免疫性DCM的转变。同时，文章评估了现有遗传关联研究的局限性（如样本量小、人群单一），并提出了未来研究方向，包括多民族基因组研究、病毒表位映射及基于HLA分层的临床试验。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::bcee5c45aeaa1785a0003ea4\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"研究对象为心脏组织而非肿瘤组织；机制侧重于感染后自身免疫，而非肿瘤抗原识别。不能直接外推至ICI疗效预测。\",\n          \"contribution\": \"提供了HLA限制性抗原呈递导致特异性T细胞激活的详细机制，包括HLA-I/II类分子在病毒清除与自身免疫启动中的不同角色。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d0ac2ec8e3533214f7adbefd\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"直接因果链条是“微生物-心脏自身免疫”，而非“微生物-ICI疗效”。需明确这是跨体系的借鉴，而非直接回答ICI相关问题。\",\n          \"contribution\": \"详细阐述了微生物组来源的肽段如何通过分子模拟激活自体反应性T细胞，并指出抗生素干预可阻断这一过程。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ca0869648ee1c7d4fe289d9c\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"HLA多态性影响胸腺阴性选择，导致自体反应性T细胞克隆逃逸；这些克隆在遇到抗原后被激活，释放穿孔素/颗粒酶或激活巨噬细胞，导致组织损伤。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::59057ef96980db153895c987\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"病毒或微生物肽段与宿主自身蛋白结构相似，导致交叉反应性T细胞或抗体产生。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e633699bbf118589ce784c9e\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"本文是综述而非原始研究，其结论基于对已有文献的综合，需注意引用文献的质量和一致性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3c45e88fa8096d539ff7a1a4\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"HLA与心肌炎的关联多为中等效应值，且存在显著的人群异质性，不能简单推广到所有人群或疾病类型。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9753a02459dec942e5cf4d38\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"微生物组与自身免疫的联系主要在动物模型和部分人类研究中证实，其在ICI疗效中的具体作用仍需独立验证，不可混淆两者。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2f8d8673d83054261202a687\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"supplement_material\"\n        ],\n        \"value\": {\n          \"auxiliary_material\": \"文中总结了 HLA 类 I 和类 II 分子在心肌炎中的不同功能（类 I 呈递病毒肽给 CD8+ T 细胞，类 II 呈递外源肽给 CD4+ T 细胞），并列出了与心肌炎或扩张型心肌病（DCM）相关的具体 HLA 等位基因（如 HLA-DR4, HLA-B27, HLA-DR15 等）。此外，文章提出了心肌炎的三相模型（触发、免疫反应、慢性炎症），并指出 HLA 多态性影响胸腺阴性选择和 T 细胞克隆扩增，这些背景信息有助于构建宿主遗传与环境互作的整体病理生理图景。\",\n          \"evidence\": [],\n          \"gap_id\": \"Ch6_gap_4\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N64e929a3f9de2888bd6a-5a6b848383c152a3\\\\round_1\\\\supplements\\\\Ch6_gap_4\\\\attempt-adnnjw8w\\\\source_units\\\\SU03_search_candidate_caa7d3faf8\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"本材料未提及 Prevotella spp. 具体诱导心肌炎的分子机制，也未涉及 FMT-LUMINate 研究或其后续跟进研究。文中关于微生物组诱导心肌炎的实证例子主要集中在拟杆菌属（Bacteroides）而非 Prevotella 属。关于具体的下游信号通路、特定的 Prevotella 抗原或代谢物、以及其激活的特定 T 细胞亚群（除了一般性的 CD4+ T 细胞外）的细节，在本综述中均未解析。因此，针对 Gap 中询问的 Prevotella 特异性机制及 FMT-LUMINate 后续研究证据，本材料无法直接提供。\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"本综述提供了微生物组诱导自身免疫性心肌炎的通用机制框架，特别是“分子模拟”（molecular mimicry）概念。作者引用了 Gil-Cruz 等人的研究，指出共生细菌（如拟杆菌属 Bacteroides）可产生与心脏肌球蛋白表位结构相似的肽段模拟物，在肠道内激活自体反应性 CD4+ T 细胞，进而导致心肌炎。该材料详细描述了 HLA 限制性抗原呈递（HLA 类分子向 CD4+ T 细胞呈递外源性肽段）在打破免疫耐受中的核心作用，以及微生物抗原如何通过交叉反应激活针对心脏自身抗原的免疫应答。这为理解肠道菌群（包括潜在的 Prevotella spp.）如何通过抗原模拟激活特定 T 细胞亚群提供了理论模型和机制参考。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a185e7e743b999f7bb64970e\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"supplement_materials\"\n        ],\n        \"value\": [\n          {\n            \"auxiliary_material\": \"文中总结了 HLA 类 I 和类 II 分子在心肌炎中的不同功能（类 I 呈递病毒肽给 CD8+ T 细胞，类 II 呈递外源肽给 CD4+ T 细胞），并列出了与心肌炎或扩张型心肌病（DCM）相关的具体 HLA 等位基因（如 HLA-DR4, HLA-B27, HLA-DR15 等）。此外，文章提出了心肌炎的三相模型（触发、免疫反应、慢性炎症），并指出 HLA 多态性影响胸腺阴性选择和 T 细胞克隆扩增，这些背景信息有助于构建宿主遗传与环境互作的整体病理生理图景。\",\n            \"evidence\": [],\n            \"gap_id\": \"Ch6_gap_4\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N64e929a3f9de2888bd6a-5a6b848383c152a3\\\\round_1\\\\supplements\\\\Ch6_gap_4\\\\attempt-adnnjw8w\\\\source_units\\\\SU03_search_candidate_caa7d3faf8\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"本材料未提及 Prevotella spp. 具体诱导心肌炎的分子机制，也未涉及 FMT-LUMINate 研究或其后续跟进研究。文中关于微生物组诱导心肌炎的实证例子主要集中在拟杆菌属（Bacteroides）而非 Prevotella 属。关于具体的下游信号通路、特定的 Prevotella 抗原或代谢物、以及其激活的特定 T 细胞亚群（除了一般性的 CD4+ T 细胞外）的细节，在本综述中均未解析。因此，针对 Gap 中询问的 Prevotella 特异性机制及 FMT-LUMINate 后续研究证据，本材料无法直接提供。\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": \"本综述提供了微生物组诱导自身免疫性心肌炎的通用机制框架，特别是“分子模拟”（molecular mimicry）概念。作者引用了 Gil-Cruz 等人的研究，指出共生细菌（如拟杆菌属 Bacteroides）可产生与心脏肌球蛋白表位结构相似的肽段模拟物，在肠道内激活自体反应性 CD4+ T 细胞，进而导致心肌炎。该材料详细描述了 HLA 限制性抗原呈递（HLA 类分子向 CD4+ T 细胞呈递外源性肽段）在打破免疫耐受中的核心作用，以及微生物抗原如何通过交叉反应激活针对心脏自身抗原的免疫应答。这为理解肠道菌群（包括潜在的 Prevotella spp.）如何通过抗原模拟激活特定 T 细胞亚群提供了理论模型和机制参考。\"\n          },\n          {\n            \"auxiliary_material\": \"文中提供了 HLA I 类和 II 类分子在心肌炎中的功能对比，包括抗原呈递对象（CD8+ vs CD4+ T 细胞）、表达细胞类型及在自身免疫中的具体角色。还涉及病毒持续感染与自身免疫的复杂关系，以及抗肌球蛋白自身抗体与β1-肾上腺素能受体的交叉反应机制。这些内容虽不直接针对 Prevotella，但构成了心肌炎免疫病理的基础背景。\",\n            \"evidence\": [],\n            \"gap_id\": \"Ch6_gap_4\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N64e929a3f9de2888bd6a-5a6b848383c152a3\\\\round_2\\\\supplements\\\\Ch6_gap_4\\\\attempt-x8duln8o\\\\source_units\\\\SU01_search_candidate_caa7d3faf8\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"该材料未提及 Prevotella spp. 的具体分子机制，也未涉及 FMT-LUMINate 研究或其后续分析。文中引用的微生物组相关证据主要集中在拟杆菌属（Bacteroides）与心脏肌球蛋白的分子模拟，而非 Prevotella 特有的抗原或代谢物。关于 Prevotella 激活特定 T 细胞亚群的具体下游信号通路（如特定受体、转录因子或代谢途径）在此文中完全缺失。\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": \"该综述阐述了微生物组通过分子模拟（molecular mimicry）诱导自身免疫性心肌炎的通用机制。文中指出，共生细菌（引用 Gil-Cruz 等人的研究，具体为拟杆菌属 Bacteroides species）可产生与心脏肌球蛋白表位结构相似的肽段模拟物，在肠道内启动自体反应性 CD4+ T 细胞，进而导致心肌炎。该研究还提到抗生素治疗可阻断这一过程，证实了微生物组衍生抗原模拟在疾病启动中的因果作用。此外，文中详细描述了 HLA 限制性抗原呈递如何决定特定 T 细胞亚群（CD4+ 或 CD8+）的激活，以及下游的细胞因子放大和免疫细胞浸润机制，为理解微生物 - 宿主互作提供了理论框架。\"\n          }\n        ],\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ec91086ed0f491f8a58227e2\",\n        \"source_handle\": \"P0597\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::403b70186842af42ce31ed58\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e827e82a1cdb2bfcba5171a4\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0f6a18a27a1f9bdafa653bdf\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::aa09a6b97ddb3f9105b9ae11\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用动物实验设计：1. 建立B16-F10黑色素瘤小鼠模型；2. 分组处理：对照组（IgG）、PD-1抑制剂组（Anti）、肠道菌群清除组（FMR，使用广谱抗生素鸡尾酒）；3. 评估指标：心脏病理（H&E, IHC）、血清心肌损伤标志物（CK-MB, cTn-I）、心脏免疫细胞亚群（流式细胞术检测CD4+, CD8+, Tregs, Th17等）、心脏Treg相关基因表达（qPCR检测CD25, FOXP3, IL-10, TGF-β）、血清细胞因子（ELISA检测IL-10, IL-17）；4. 肠道菌群分析：粪便16S rRNA测序，进行Alpha/Beta多样性分析及LEfSe差异物种鉴定；5. 相关性分析：Spearman分析肠道菌群与心肌炎表型参数的相关性；6. 干预验证：通过FMR观察对心肌炎及免疫平衡的逆转效果。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f73657d4b17d08cc978702bd\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"提供了PD-1抑制剂诱导心肌炎的一个潜在机制模型，即肠道菌群失调可能通过抑制心脏局部Treg的功能和数量来加剧心肌炎症。\",\n          \"limits\": \"研究仅在小鼠黑色素瘤模型中进行，结论外推到人类患者需谨慎；样本量较小（每组n=6）；缺乏针对特定细菌菌株的因果验证实验（如粪菌移植或单菌定植）；FMR组缺少单独的抗生素对照以排除抗生素本身对心肌的影响；16S测序无法精确到种水平，限制了具体致病菌的识别。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7f6fd31e62f985b5d53fe923\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"黑色素瘤小鼠接受PD-1抑制剂治疗\",\n          \"finding\": \"PD-1抑制剂诱导了显著的心脏炎症（CD4+, CD8+ T细胞和巨噬细胞浸润增加），血清心肌损伤标志物升高；心脏内Treg比例下降，Th17/Treg比值升高；心脏组织中Treg相关基因（CD25, FOXP3, IL-10, TGF-β）转录水平下调；肠道菌群组成发生显著改变（Beta多样性差异），特定菌属（如Rikenellaceae, Ruminococcaceae, Flexispira等）丰度增加，且这些菌属与心肌损伤指标呈正相关，与保护性因子呈负相关。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::49f942189d93f91542d51d20\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"在PD-1抑制剂治疗基础上进行肠道菌群清除（FMR）\",\n          \"finding\": \"FMR显著减轻了心肌损伤面积和炎症细胞浸润，降低了血清心肌损伤标志物；恢复了心脏内Treg的比例和Th17/Treg比值的平衡；上调了Treg相关基因的表达和血清IL-10水平；清除了与心肌炎表型相关的特定肠道菌群，表明肠道菌群的缺失缓解了PD-1抑制剂引起的心脏毒性，且不影响抗肿瘤疗效。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0f415aa6f7a78f4146535ff9\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"empirical\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e748e3dac3ab2dbfcc0539a8\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"PD-1抑制剂诱导的心肌炎的具体发病机制尚不清楚，尤其是肠道菌群是否参与以及其如何通过影响免疫细胞（如Treg）来介导心脏毒性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c2eb51bc6982e0585c40454a\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"本研究以携带B16-F10黑色素瘤的小鼠为模型，研究PD-1抑制剂（Anti-PD1）诱导的心肌炎（irAEs的一种）。研究对象包括小鼠心脏组织、血清及粪便样本。情境涉及肿瘤免疫治疗背景下的免疫相关不良事件机制探索。范围限定在小鼠体内实验，未涉及人类临床数据直接验证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::80adee1c8926e7478ffad7f5\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"该研究旨在阐明PD-1抑制剂导致心肌炎的潜在机制，特别是肠道菌群与调节性T细胞（Treg）之间的关联。研究人员构建了黑色素瘤小鼠模型，给予PD-1抑制剂诱导心肌炎，并通过16S rRNA测序分析肠道菌群变化，流式细胞术和qPCR检测心脏免疫细胞及基因表达。研究发现PD-1抑制剂导致心脏内Treg数量减少和功能基因下调，同时改变肠道菌群组成。通过抗生素清除肠道菌群（FMR），发现可显著减轻心肌损伤并恢复Treg功能，提示肠道菌群在PD-1抑制剂诱导的心肌炎中起关键作用。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7f4672cf172ce3226a15c08c\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅限于小鼠模型中的观察和推断，尚未在人体中验证该特定通路；机制细节基于基因表达和相关性，非直接的因果链条证明（如未展示特定代谢物的作用）。\",\n          \"contribution\": \"详细描述了PD-1抑制剂通过改变肠道菌群组成，进而抑制心脏局部Treg数量和功能（下调FOXP3, IL-10, TGF-β等基因），打破Th17/Treg平衡，导致心肌炎症的具体分子和细胞机制。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6552a2eebd1a3ff34c6222d4\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"FMR使用的是广谱抗生素，非特异性清除，不能代表所有菌群变化的影响；未测试补充特定有益菌是否能增强疗效或进一步降低毒性。\",\n          \"contribution\": \"通过FMR实验证明，清除肠道菌群可以减轻PD-1抑制剂诱导的心肌炎，同时保持抗肿瘤效果，暗示肠道菌群是ICI疗效与毒性平衡中的一个可调节因素。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d737339e5962d85a101793a2\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"PD-1抑制剂在黑色素瘤小鼠中诱导心肌炎的组织病理学特征（纤维坏死、炎症细胞浸润）及血清标志物变化\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b216d453cf24f6db586431eb\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"文中引用的关于肠道菌群失调与心血管及自身免疫疾病关联的既往研究\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7e5ce8ffebf8757f56be95c5\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"富集的菌属（如Ruminococcaceae, Flexispira）与其他炎症性疾病（IBD, 败血症等）的已知关联\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dc03f795b3de5d893b7ecb68\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"该研究结果来自小鼠模型，不能直接等同于人类患者的生理反应。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::a4e13a48122f43a1ba23366d\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"肠道菌群的变化与心肌炎表型的相关性不等于因果关系，尽管FMR实验提供了支持性证据，但缺乏对单一菌群或代谢物的直接因果验证。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4ee8773f2c8d84caa1a2c4db\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"FMR实验中使用的抗生素鸡尾酒可能对宿主有其他非特异性影响，需考虑抗生素本身对心脏或免疫系统的可能作用。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::30f869241f6095bbdf4f1149\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"16S rRNA测序分辨率有限，无法确定具体的致病菌株，因此不能将结论精确到特定菌种。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::e6119f67c0f49c7eec20e55f\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"supplement_material\"\n        ],\n        \"value\": {\n          \"auxiliary_material\": \"The introduction and discussion cite general background on the association between gut dysbiosis and cardiovascular or autoimmune diseases, and the role of Tregs in maintaining immune homeostasis. The methods detail the 16S rRNA sequencing protocol and the antibiotic cocktail used for microbiota depletion, which may inform future experimental designs. The study also notes limitations such as the small number of experimental animals and the resolution limits of 16S sequencing.\",\n          \"evidence\": [],\n          \"gap_id\": \"Ch6_gap_5\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N4452dfb25f491e9335fe-5a6b848383c152a3\\\\round_2\\\\supplements\\\\Ch6_gap_5\\\\attempt-u2gi65cq\\\\source_units\\\\SU02_search_candidate_65a7baa93c\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"The gap question specifically requests 'large-scale microbiome association studies' (implying human clinical cohorts) to verify issues of small sample size or insufficient evidence in non-colitis irAEs. This supplied material is a small-scale preclinical animal study (n=6 per group), not a large-scale human association study. Therefore, it does not provide the human epidemiological evidence required to resolve the gap regarding clinical sample sizes. The study itself acknowledges its limited sample size as a constraint, which ironically aligns with the concern raised in the gap question rather than resolving it.\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"This study provides preclinical mechanistic evidence linking gut microbiota to PD-1 inhibitor-associated myocarditis, a non-colitis irAE. The authors established a melanoma mouse model (n=6 per group) showing that PD-1 inhibition induced myocarditis, reduced cardiac regulatory T cells (Tregs), and altered gut microbiota composition. Specific taxa (e.g., Ruminococcaceae, Flexispira) were correlated with cardiac injury markers (CK-MB, cTn-I) and Treg-related gene expression (FOXP3, IL-10). Fecal microbiota removal (antibiotic treatment) attenuated myocarditis and restored Treg levels without compromising antitumor efficacy in this model. These findings support the biological plausibility of a microbiome-immune axis in non-colitis irAEs.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::36adbf1abd02f94fd7fd075a\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"supplement_materials\"\n        ],\n        \"value\": [\n          {\n            \"auxiliary_material\": \"The introduction and discussion cite general background on the association between gut dysbiosis and cardiovascular or autoimmune diseases, and the role of Tregs in maintaining immune homeostasis. The methods detail the 16S rRNA sequencing protocol and the antibiotic cocktail used for microbiota depletion, which may inform future experimental designs. The study also notes limitations such as the small number of experimental animals and the resolution limits of 16S sequencing.\",\n            \"evidence\": [],\n            \"gap_id\": \"Ch6_gap_5\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N4452dfb25f491e9335fe-5a6b848383c152a3\\\\round_2\\\\supplements\\\\Ch6_gap_5\\\\attempt-u2gi65cq\\\\source_units\\\\SU02_search_candidate_65a7baa93c\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"The gap question specifically requests 'large-scale microbiome association studies' (implying human clinical cohorts) to verify issues of small sample size or insufficient evidence in non-colitis irAEs. This supplied material is a small-scale preclinical animal study (n=6 per group), not a large-scale human association study. Therefore, it does not provide the human epidemiological evidence required to resolve the gap regarding clinical sample sizes. The study itself acknowledges its limited sample size as a constraint, which ironically aligns with the concern raised in the gap question rather than resolving it.\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": \"This study provides preclinical mechanistic evidence linking gut microbiota to PD-1 inhibitor-associated myocarditis, a non-colitis irAE. The authors established a melanoma mouse model (n=6 per group) showing that PD-1 inhibition induced myocarditis, reduced cardiac regulatory T cells (Tregs), and altered gut microbiota composition. Specific taxa (e.g., Ruminococcaceae, Flexispira) were correlated with cardiac injury markers (CK-MB, cTn-I) and Treg-related gene expression (FOXP3, IL-10). Fecal microbiota removal (antibiotic treatment) attenuated myocarditis and restored Treg levels without compromising antitumor efficacy in this model. These findings support the biological plausibility of a microbiome-immune axis in non-colitis irAEs.\"\n          },\n          {\n            \"auxiliary_material\": \"作者明确指出该研究受限于实验动物数量有限（n=6），结论需更大样本量研究进一步确认；且 16S rRNA 测序无法精确到菌种水平，缺乏单一菌群或代谢物的直接因果验证。此外，文中引用了肠道菌群失调与心血管及自身免疫疾病关联的既往背景，为综述提供理论依据。\",\n            \"evidence\": [],\n            \"gap_id\": \"Ch6_gap_5\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N4452dfb25f491e9335fe-5a6b848383c152a3\\\\round_3\\\\supplements\\\\Ch6_gap_5\\\\attempt-hpbnytrx\\\\source_units\\\\SU03_search_candidate_65a7baa93c\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"该材料为动物实验且样本量小，无法提供针对人类非结肠炎 irAEs（如心肌炎、神经毒性）的大规模微生物组关联数据。 gap 中要求的‘大规模’临床证据以验证先前研究样本量不足的问题仍未得到解决，人类队列中的菌群特征与毒性关联尚缺乏统计效力足够的验证。\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": \"该研究在黑色素瘤小鼠模型中（每组 n=6）证实了 PD-1 抑制剂治疗会改变肠道菌群组成（如 Ruminococcaceae、Flexispira 等富集），并与心肌炎严重程度及心脏调节性 T 细胞（Treg）减少显著相关。研究通过粪便微生物清除实验（FMR）表明，抗生素干预可减轻 PD-1 抑制剂诱导的心肌炎，同时保持抗肿瘤效果，提示肠道菌群通过调节 Treg 功能参与非结肠炎 irAE（心肌炎）的发病机制。\"\n          }\n        ],\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8071a8e64681d16f4652d3f1\",\n        \"source_handle\": \"P0602\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::98a960a0340563f06718a990\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::0a23af0b63e18942fe134843\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"fulltext\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::6e31587ee2f750a06f61ed94\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d38dbbee702680001d276888\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"采用叙述性综述方法。综合现有的动物实验研究（主要是小鼠自身免疫性心肌炎模型）、体外细胞共培养实验数据以及部分人类临床研究结果。重点梳理TN-C的表达时空特征、其与树突状细胞的相互作用机制（特别是TLR4信号通路）、对T细胞极化（Th17）的影响，并结合其他免疫机制（如分子模拟、表位扩散、肠道菌群交叉反应）进行系统性解释。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d877320ec8ce00aae1d70114\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"系统总结了TN-C作为局部炎症调节剂在心肌炎病理中的机制，提出了TN-C-TLR4-DCs-Th17轴的具体分子路径。\",\n          \"limits\": \"所给摘要未交代具体的文献检索策略和筛选标准。主要证据来源于小鼠模型和部分体外实验，直接外推至人类的因果链条尚需更多临床干预研究验证。作者承认目前缺乏针对TN-C功能的抑制治疗尝试，且动物模型与人类疾病的差异仍是知识空白。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ae47e582b3cd8ea73585d560\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"小鼠自身免疫性心肌炎模型及体外实验\",\n          \"finding\": \"TN-C在炎症细胞浸润和组织坏死前即可检测到，并在活动性炎症期强表达，愈合后消失。TN-C缺陷小鼠表现出较轻的心肌炎症状，且心脏中Th17细胞浸润减少。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::63c6dec03dbbc08d397b1a9d\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"体外树突状细胞（DCs）与T细胞共培养\",\n          \"finding\": \"TN-C通过激活DCs上的TLR4受体，诱导DCs分泌高水平的IL-6、IL-1β和GM-CSF。这些细胞因子共同作用，促使初始CD4+ T细胞分化为Th17细胞。阻断IL-6或TLR4信号可抑制这一过程。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::920d3654c76386723acc3f47\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"人类心肌炎/炎症性心肌病患者\",\n          \"finding\": \"患者血清中TN-C水平升高，可作为评估疾病活动和预测预后的生物标志物，尤其在结合BNP时具有更高的预测价值。患者体内Th17相关细胞因子水平升高。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::dc7f3663d96cf3cda7ff8355\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::032de05398f456f491750002\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"阐明TN-C在心肌炎发病机制中的具体免疫调节功能，特别是其如何桥接先天免疫与适应性免疫反应，以及其在疾病诊断和治疗中的潜在价值。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::37830cd3b19e48b57170b0aa\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"心肌炎（Myocarditis）和炎症性心肌病（Inflammatory Cardiomyopathy）的病理机制，重点聚焦于细胞外基质糖蛋白Tenascin-C (TN-C) 在其中的免疫调节作用。涉及小鼠自身免疫性心肌炎模型、人类临床观察及相关的免疫学机制（如树突状细胞、T细胞亚群）。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1d784781d7f6e781f9dffeb2\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"本文是一篇综述文章，旨在探讨Tenascin-C (TN-C) 在心肌炎向炎症性心肌病进展中的免疫调节角色。文章首先回顾了心肌炎的触发因素（包括病毒、免疫检查点抑制剂等）及其向自身免疫反应的转化过程，特别强调了心脏自身抗原（如MyHC-α）和肠道微生物（如Bacteroides thetaiotaomicron）在打破免疫耐受中的作用。核心部分详细阐述了TN-C作为一种损伤相关分子模式（DAMP），在组织损伤后由成纤维细胞等产生，通过激活树突状细胞（DCs）上的TLR4受体，促进IL-6、IL-1β和GM-CSF等细胞因子的释放，进而诱导初始CD4+ T细胞向致病性的Th17细胞分化。这一过程连接了先天免疫与适应性免疫，导致心肌组织的自身免疫性损伤。文章最后指出TN-C可能作为生物标志物和治疗靶点的潜力，并承认目前关于动物模型与人类疾病差异的知识缺口。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1bfe1c4bd8e93fec9a0d4cb9\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"仅解释了ICIs引发心肌炎的免疫学基础（耐受丧失），未涉及实体瘤疗效。机制细节（如TN-C的作用）主要在心肌炎语境下，需谨慎类比到其他器官毒性。\",\n          \"contribution\": \"提供了免疫检查点抑制剂可能导致心肌炎的一个潜在机制视角：即通过破坏免疫耐受，使得原本被控制的自身反应性T细胞（如抗MyHC-α T细胞）在组织损伤背景下被激活。文中提到免疫检查点分子（CTLA-4, PD-1/PD-L1）维持外周耐受，其缺失可导致心肌炎。这有助于解释ICIs为何会引发自身免疫样反应。\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d4b259f5e0f3e39b336b885a\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"这是心肌炎/炎症性心肌病的特定案例，而非实体瘤中微生物调节ICI疗效的直接证据。不同癌症类型和微生物群落差异巨大。\",\n          \"contribution\": \"提供了肠道微生物（Bacteroides thetaiotaomicron）通过分子模拟（cross-immune response）触发心脏自身免疫反应的实例。展示了微生物抗原与宿主自身抗原（MyHC-α）的同源性如何导致T细胞交叉激活。\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7c1d5e83fd3cbb355512c0ee\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"文章详细描述了中枢耐受（胸腺阴性选择）和外周耐受（免疫检查点、Treg）的机制，以及MyHC-α因未在胸腺表达而逃逸选择的特殊性。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::157ad94e69545aa732568980\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"TN-C作为ECM成分，在组织损伤时释放并作为DAMP激活TLR4，进而驱动炎症。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d39737aa74b8180654d7d4f8\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"TN-C联合BNP预测心肌事件的价值。\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::215fc0a53cd384c65647af36\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"本文是综述而非原始研究，其提出的TN-C机制主要基于小鼠模型和体外实验，直接应用于人类实体瘤ICI疗效的解释存在物种和疾病模型的差异风险。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::5fb9ba24eb45813c20f60177\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"文中关于肠道菌群的描述仅限于心肌炎中的交叉反应，不能直接推断该菌株在其他癌症类型中对ICI疗效的影响方向（促进或抑制）。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c5449a2141fe4b2771f18779\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"不要将TN-C在心肌炎中的促炎作用简单等同于其在所有炎症环境中的作用；在某些慢性炎症或纤维化背景下，ECM成分的作用可能复杂多变。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b42249dc742e718bbcb4786e\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"作者声称TN-C是“关键”调节剂，但这基于有限的实验发现，需谨慎对待其普遍性。\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3bd6bb2bbbc66d70dcfe4490\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"supplement_material\"\n        ],\n        \"value\": {\n          \"auxiliary_material\": \"General triggers of myocarditis including viruses (CVB3, SARS-CoV-2) and immune checkpoint inhibitors; description of central and peripheral immune tolerance mechanisms; TN-C as a biomarker for disease activity and prognosis.\",\n          \"evidence\": [],\n          \"gap_id\": \"Ch6_gap_4\",\n          \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N64e929a3f9de2888bd6a-5a6b848383c152a3\\\\round_3\\\\supplements\\\\Ch6_gap_4\\\\attempt-nf1aflvz\\\\source_units\\\\SU01_search_candidate_ec192008c0\\\\FULFILLMENT_JUDGMENT.json\",\n          \"limitations\": [],\n          \"material_ready\": true,\n          \"material_usefulness\": \"supporting\",\n          \"outline_action_recovered_by_policy\": false,\n          \"remaining_gap\": \"The supplied text does not mention *Prevotella spp.*, the FMT-LUMINate study, or any specific antigens, metabolites, or downstream signaling pathways associated with *Prevotella*-induced myocarditis. The specific molecular mechanism requested in the gap question remains unidentified in this material.\",\n          \"remaining_gap_recovered_by_policy\": false,\n          \"status\": \"unmet\",\n          \"useful_material\": \"This study provides a mechanistic framework for how gut microbiota can trigger autoimmune myocarditis, specifically citing *Bacteroides thetaiotaomicron* where bacterial beta-galactosidase shares sequence homology with cardiac MyHC-α, inducing Th17 polarization. It also details a downstream signaling pathway in myocarditis involving Tenascin-C (TN-C) activating dendritic cells via TLR4 to produce IL-6, IL-1β, and GM-CSF, driving Th17 differentiation.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::b6178b0b87bd19c32a857037\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"supplement_materials\"\n        ],\n        \"value\": [\n          {\n            \"auxiliary_material\": \"General triggers of myocarditis including viruses (CVB3, SARS-CoV-2) and immune checkpoint inhibitors; description of central and peripheral immune tolerance mechanisms; TN-C as a biomarker for disease activity and prognosis.\",\n            \"evidence\": [],\n            \"gap_id\": \"Ch6_gap_4\",\n            \"judgment_path\": \"F:\\\\OptoMind-Review-2\\\\outputs\\\\body_full_staged_acceptance_20261004_40cny\\\\planning\\\\chapters\\\\external\\\\N64e929a3f9de2888bd6a-5a6b848383c152a3\\\\round_3\\\\supplements\\\\Ch6_gap_4\\\\attempt-nf1aflvz\\\\source_units\\\\SU01_search_candidate_ec192008c0\\\\FULFILLMENT_JUDGMENT.json\",\n            \"limitations\": [],\n            \"material_ready\": true,\n            \"material_usefulness\": \"supporting\",\n            \"outline_action_recovered_by_policy\": false,\n            \"remaining_gap\": \"The supplied text does not mention *Prevotella spp.*, the FMT-LUMINate study, or any specific antigens, metabolites, or downstream signaling pathways associated with *Prevotella*-induced myocarditis. The specific molecular mechanism requested in the gap question remains unidentified in this material.\",\n            \"remaining_gap_recovered_by_policy\": false,\n            \"status\": \"unmet\",\n            \"useful_material\": \"This study provides a mechanistic framework for how gut microbiota can trigger autoimmune myocarditis, specifically citing *Bacteroides thetaiotaomicron* where bacterial beta-galactosidase shares sequence homology with cardiac MyHC-α, inducing Th17 polarization. It also details a downstream signaling pathway in myocarditis involving Tenascin-C (TN-C) activating dendritic cells via TLR4 to produce IL-6, IL-1β, and GM-CSF, driving Th17 differentiation.\"\n          }\n        ],\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fae35bfda7669113b58cc0aa\",\n        \"source_handle\": \"P0604\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::eaa5eb691eb7f9a7f497a261\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::56674bed076a10a859598a71\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"material_depth\"\n        ],\n        \"value\": \"\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::512b360cce2032140ebe1f09\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"material_status\"\n        ],\n        \"value\": \"resolved\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9a22606753b19d93fc2deb50\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"approach\"\n        ],\n        \"value\": \"As a narrative review, the authors conducted a literature search and synthesis of both preclinical (animal models) and clinical studies. They organized the discussion around three main themes: the general influence of gut microbiota on ICI efficacy, the relationship between microbiota and irAEs (specifically myocarditis), proposed molecular mechanisms (molecular mimicry, Treg suppression, cytokine networks), and therapeutic applications (antibiotics, other drugs like PPIs/statins). The approach relies on interpreting correlations and mechanistic hypotheses from cited works rather than conducting new primary experiments.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::f25613981fd49fcc49b87542\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Provides a structured synthesis of the 'gut-heart axis' in the context of cardio-oncology, linking specific microbial taxa (Flexispira, Ruminococcaceae, Bacteroides) to ICI-associated myocarditis pathology based on available preclinical and clinical data.\",\n          \"limits\": \"The review is narrative and does not present a systematic meta-analysis. Most mechanistic insights are inferred from animal models or other irAEs; direct clinical evidence for microbiota causality in myocarditis is limited. The therapeutic potential of microbiota modulation remains hypothetical and unvalidated in human trials.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::4a2784cea5bf2f3e32cb2747\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"contribution_and_limits\"\n        ],\n        \"value\": {\n          \"contribution\": \"Highlights the critical trade-off between using antibiotics to prevent myocarditis and their potential to compromise ICI anti-tumor efficacy, identifying this as a key research gap.\",\n          \"limits\": \"Does not provide quantitative data on the magnitude of this trade-off across different cancer types or ICI regimens. The heterogeneity of cardiac adverse events across cancer types is noted but not analyzed.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::100b6b061df5e1bb7d2daeba\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Preclinical mouse models treated with PD-1 inhibitors\",\n          \"finding\": \"Depletion of specific gut bacteria (e.g., Flexispira, Ruminococcaceae) using antibiotics reduced inflammatory cell infiltration and myocardial injury area. Conversely, these bacteria showed positive correlations with cardiac injury markers and negative correlations with cardioprotective factors.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::ac618138ef56a8024c332180\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Clinical observations of patients with irAEs\",\n          \"finding\": \"Patients developing severe irAEs, including myocarditis, exhibited higher abundance of pathobionts and decreased relative abundance of Ruminococcaceae. Bacteroides levels dynamically changed during irAE onset and remission.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::805f8088e2013333681d00a0\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"key_findings\"\n        ],\n        \"value\": {\n          \"conditions\": \"Mechanistic hypotheses derived from preclinical and autoimmune data\",\n          \"finding\": \"Proposed mechanisms include molecular mimicry where microbial epitopes cross-react with heart tissue, and dysbiosis leading to suppressed Treg function and amplified pro-inflammatory cytokine responses (e.g., CXCL9/10, TNF-α).\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::8c75664927d82127ac795f10\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"paper_kind\"\n        ],\n        \"value\": \"review\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::66bd0c3c3ac030702af2beb7\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"problem_or_question\"\n        ],\n        \"value\": \"To synthesize existing evidence on the link between gut microbiota and ICI-associated myocarditis, identify underlying molecular mechanisms, and evaluate the potential of modulating gut microbiota (e.g., via antibiotics, transplantation) as a therapeutic strategy, while addressing the balance between reducing irAEs and maintaining anti-tumor efficacy.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::340fd518cb652e91b8639951\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"research_scope\"\n        ],\n        \"value\": \"The review focuses on the association between gut microbiota and immune checkpoint inhibitor (ICI)-associated myocarditis, a severe immune-related adverse event (irAE). It synthesizes evidence from preclinical studies (primarily mouse models) and clinical observations to explore molecular mechanisms and potential therapeutic interventions involving microbiota modulation.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::fa66804474ed79ee61b6a12b\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"study_summary_A\",\n          \"work_summary\"\n        ],\n        \"value\": \"This narrative review aims to elucidate the role of gut microbiota in the pathogenesis of ICI-associated myocarditis. The authors hypothesize that gut microbiota influences this condition through mechanisms such as molecular mimicry, regulation of regulatory T cells (Tregs), and systemic inflammation. The paper discusses how specific microbial alterations correlate with cardiac injury markers and reviews preclinical evidence suggesting that antibiotic depletion or modulation of gut flora can mitigate myocardial damage. However, it highlights the controversy surrounding antibiotic use due to potential negative impacts on ICI efficacy and notes that clinical validation for microbiota-targeted therapies is still pending.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::1bc5efdd3aa6539736d4af68\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"The review establishes myocarditis as a high-mortality (25%-50%) complication of ICIs and introduces the concept of the gut-heart axis in cardiovascular disease, extending it to cardio-oncology.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::281dd7fbe74ba7a82a0507d2\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Associations between pathobiont abundance, decreased Ruminococcaceae, and dynamic changes in Bacteroides with irAE onset/remission.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::3487ea8969aa0e0e421429c2\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"broader_review_uses\"\n        ],\n        \"value\": {\n          \"material\": \"Long-term PPI use reduces diversity and may increase irAE risk; statins may mitigate inflammation.\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::63181ed1d5e412e782ade90c\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"These mechanisms are largely inferred from preclinical studies or other irAEs (colitis, dermatitis) and are explicitly stated as requiring further validation in myocarditis. The causal chain is not yet established in humans.\",\n          \"contribution\": \"Provides detailed mechanistic hypotheses for how gut microbiota might mediate immune-related adverse events, specifically focusing on molecular mimicry (cross-reactivity between microbial epitopes and cardiac tissues) and the suppression of Tregs by dysbiosis. It also outlines cytokine pathways (CXCL9/10, TNF-α) recruited by microbiota-derived signals.\",\n          \"facet_id\": \"F2\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::741a102037a570cf1822c524\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"facet_contributions\"\n        ],\n        \"value\": {\n          \"boundaries\": \"The review does not provide specific data on how microbiota modulation affects tumor response rates in solid tumors; its focus is on the adverse event aspect. The claim about antibiotic compromising efficacy is supported by retrospective studies cited, but the review itself does not generate new efficacy data.\",\n          \"contribution\": \"Discusses the dual role of gut microbiota in influencing ICI outcomes: enhancing anti-tumor immunity (via CD8+ T cell expansion) while simultaneously increasing the risk of irAEs. It notes that antibiotic use to mitigate irAEs may compromise ICI efficacy.\",\n          \"facet_id\": \"F1\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::2c5610619573e7cca590564c\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The paper is a narrative review, not a systematic review or empirical study; findings represent synthesized interpretations rather than primary data.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::9bdf5a11c188dff9149e485d\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Mechanisms described (e.g., molecular mimicry, Treg suppression) are largely derived from preclinical models or extrapolated from other irAEs; direct causal evidence in human ICI-myocarditis is lacking.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::7def4ce6d01d28e521abb86d\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"Therapeutic suggestions (antibiotics, transplantation) are presented as future possibilities based on preclinical success; clinical application is explicitly stated as distant and controversial.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::d67218b9052c0db3fb7408f9\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"review_planning_B\",\n          \"scope_interpretation_cautions\"\n        ],\n        \"value\": \"The review focuses on toxicity (myocarditis) rather than efficacy; do not infer conclusions about tumor response modulation from this text without caution.\",\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      },\n      {\n        \"atom_id\": \"atom::c1ada2a687395496316a5157\",\n        \"source_handle\": \"P0598\",\n        \"field_path\": [\n          \"card_material\"\n        ],\n        \"value\": {\n          \"material_scope\": \"fulltext\"\n        },\n        \"role\": \"evidence\",\n        \"snapshot_ids\": [\n          \"snapshot::ce5771d0255e802db4f70946\"\n        ]\n      }\n    ],\n    \"source_identities\": {\n      \"P0017\": {\n        \"source_handle\": \"P0017\",\n        \"source_id\": \"source::P0017\",\n        \"aliases\": [],\n        \"title\": \"DOP47 Gut microbiome contributes to the development of immune checkpoint inhibitor-related colitis\",\n        \"doi\": \"10.1093/ecco-jcc/jjac190.0087\",\n        \"paper_id\": \"08d60ce7ff453c5ae2b4c3a47581b79e02b2b5a0\"\n      },\n      \"P0600\": {\n        \"source_handle\": \"P0600\",\n        \"source_id\": \"source::P0600\",\n        \"aliases\": [],\n        \"title\": \"Gut microbiota composition in patients with advanced malignancies experiencing immune-related adverse events\",\n        \"doi\": \"10.3389/fimmu.2023.1109281\",\n        \"paper_id\": \"CorpusId:257062954\"\n      },\n      \"P0011\": {\n        \"source_handle\": \"P0011\",\n        \"source_id\": \"source::P0011\",\n        \"aliases\": [],\n        \"title\": \"Correlation of the gut microbiome and immune-related adverse events in gastrointestinal cancer patients treated with immune checkpoint inhibitors\",\n        \"doi\": \"10.3389/fcimb.2023.1099063\",\n        \"paper_id\": \"042544f408b07e2d51c57f40f4df614d0c0960a7\"\n      },\n      \"P0308\": {\n        \"source_handle\": \"P0308\",\n        \"source_id\": \"source::P0308\",\n        \"aliases\": [],\n        \"title\": \"Gut microbiome for predicting immune checkpoint blockade-associated adverse events\",\n        \"doi\": \"10.1186/s13073-024-01285-9\",\n        \"paper_id\": \"8524fbf4592e1ca625332b35344ad1a5d37aad93\"\n      },\n      \"P0312\": {\n        \"source_handle\": \"P0312\",\n        \"source_id\": \"source::P0312\",\n        \"aliases\": [],\n        \"title\": \"Biomarkers for immune-related adverse events in cancer patients treated with immune checkpoint inhibitors\",\n        \"doi\": \"10.1093/jjco/hyad184\",\n        \"paper_id\": \"85e23d9e543859acdb7e57cd5