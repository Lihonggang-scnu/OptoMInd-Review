ated\":1791544202,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-5d6abef9-77c0-9905-a8f8-4b997e43e0d0\"}\n\ndata: {\"choices\":[],\"object\":\"chat.completion.chunk\",\"usage\":{\"prompt_tokens\":268593,\"completion_tokens\":11160,\"total_tokens\":279753,\"completion_tokens_details\":{\"reasoning_tokens\":8192,\"text_tokens\":11160},\"prompt_tokens_details\":{\"text_tokens\":268593}},\"created\":1791544202,\"system_fingerprint\":null,\"model\":\"qwen3.5-plus\",\"id\":\"chatcmpl-5d6abef9-77c0-9905-a8f8-4b997e43e0d0\"}\n\ndata: [DONE]\n\n",
