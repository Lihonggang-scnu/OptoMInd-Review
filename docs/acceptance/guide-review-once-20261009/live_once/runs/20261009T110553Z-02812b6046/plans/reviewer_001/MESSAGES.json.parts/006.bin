      \"study_summary_A\",\n                \"research_scope\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::4ae76f027dd241b7100eeee0\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"work_summary\"\n          ],\n          \"value\": \"This study addresses the paradoxical link between immune-related adverse events (irAEs) and improved efficacy in ICI therapy by dissecting the role of the gut microbiome. Using three independent cohorts totaling 589 patients with melanoma or NSCLC, the authors first validated that grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias. They then employed a combined approach of shotgun metagenomics and culturomics on fecal samples collected at baseline and during ir-colitis onset. Metagenomic analysis revealed that patients developing irAEs had lower alpha diversity and enrichment of pro-inflammatory taxa such as Ruminococcus gnavus and Streptococcus vestibularis. Culturomics identified Paraclostridium bifermentans as enriched in patients with acute ir-colitis. Functional validation in mice demonstrated that fecal microbiota transplantation from an ir-colitis patient induced subclinical colitis markers and enhanced anti-tumor activity of dual ICI. Specifically, P. bifermentans was shown to disrupt epithelial barrier integrity in vitro and exacerbate colitis in vivo via live bacteria interaction, while its anti-tumor benefit was mediated by a secreted low-molecular-weight metabolite (< 3 kDa). These findings provide a mechanistic link suggesting that specific pro-inflammatory bacteria can simultaneously drive toxicity and enhance therapeutic efficacy.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"work_summary\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"work_summary\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::3aba09de1928023c017e60a8\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"broader_review_uses\"\n          ],\n          \"value\": {\n            \"material\": \"Comparison of metagenomics and culturomics results showing that culturomics recovers live, low-abundance bacteria (like P. bifermentans) missed or less characterized by sequencing alone.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"0\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::68b54a3451f1ab3d7966a2e1\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"broader_review_uses\"\n          ],\n          \"value\": {\n            \"material\": \"Discussion of immortal time bias in analyzing irAE-survival associations and the correction applied in this study.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"1\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::e80331c46c052c7581ada8d5\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"facet_contributions\"\n          ],\n          \"value\": {\n            \"boundaries\": \"The association is observational; causality is inferred through subsequent mechanistic studies but not proven in the clinical cohort alone. Results may vary by cancer type and geography.\",\n            \"contribution\": \"Validates the clinical association between irAEs and improved ICI outcomes across multiple solid tumor cohorts (melanoma and NSCLC), confirming that higher-grade irAEs correlate with longer OS and PFS. Identifies specific microbial signatures (e.g., S. vestibularis, H. porci) associated with both irAE and response states.\",\n            \"facet_id\": \"F1\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"facet_contributions\",\n                \"0\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"facet_contributions\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::f5b77f6f89c89b517fbf6126\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"facet_contributions\"\n          ],\n          \"value\": {\n            \"boundaries\": \"The mechanism is derived from mouse models and in vitro assays; the exact metabolite identity is unknown. The effect of live bacteria on barrier integrity is distinct from the metabolite's effect on tumor response, highlighting complex, context-dependent interactions.\",\n            \"contribution\": \"Demonstrates a specific mechanism where Paraclostridium bifermentans enhances ICI efficacy via a secreted low-molecular-weight metabolite (< 3 kDa), while simultaneously causing ir-colitis through live-bacteria-induced epithelial barrier disruption. Shows that FMT from ir-colitis patients transfers both inflammatory potential and enhanced ICI response.\",\n            \"facet_id\": \"F2\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"facet_contributions\",\n                \"1\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"facet_contributions\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::9964b8d843b952c18995daf5\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"The study identifies P. bifermentans as a key player, but the exact metabolite responsible for the anti-tumor effect is not characterized; do not overstate the specificity of the molecular mechanism.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"0\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::1482d971688f8c6a45f4eb09\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"Mouse models used (MCA-205, DSS) have limitations in fully recapitulating human ir-colitis; results should be framed as preclinical evidence supporting human observations.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"1\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::c16c42850044684ec971f685\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"The 'dual role' of P. bifermentans involves two different mechanisms (live bacteria for toxicity, metabolite for efficacy); ensure this distinction is clear when citing.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"2\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"2\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::cafb8802dcc1f5812d97e5ec\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"Clinical associations are based on retrospective/prospective cohorts with potential confounders; causality is established primarily through animal models, not clinical intervention.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"3\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"3\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::6bf40b4009f92b8ad4a0426c\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"card_material\"\n          ],\n          \"value\": {\n            \"known_gaps\": [\n              {\n                \"asset_id\": \"asset-7974b6c4dd5220685baa\",\n                \"kind\": \"asset\",\n                \"reason\": \"caption_or_locator_without_readable_image\",\n                \"status\": \"caption_only\"\n              },\n              {\n                \"asset_id\": \"asset-95bd9a77b14edf06222c\",\n                \"kind\": \"asset\",\n                \"reason\": \"caption_or_locator_without_readable_image\",\n                \"status\": \"caption_only\"\n              },\n              {\n                \"asset_id\": \"asset-5c752c0f8036d5742e42\",\n                \"kind\": \"asset\",\n                \"reason\": \"caption_or_locator_without_readable_image\",\n                \"status\": \"caption_only\"\n              },\n              {\n                \"asset_id\": \"asset-a7194a689f46f19f0fc9\",\n                \"kind\": \"asset\",\n                \"reason\": \"caption_or_locator_without_readable_image\",\n                \"status\": \"caption_only\"\n              },\n              {\n                \"asset_id\": \"asset-5f82ba52a99d38e52a55\",\n                \"kind\": \"asset\",\n                \"reason\": \"caption_or_locator_without_readable_image\",\n                \"status\": \"caption_only\"\n              },\n              {\n                \"kind\": \"assets\",\n                \"reason\": \"supplementaryFiles_fetch_body_too_large\",\n                \"status\": \"missing\"\n              }\n            ],\n            \"material_scope\": \"fulltext\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"card_material\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"card_material\"\n              ]\n            }\n          ]\n        }\n      ],\n      \"scientific_records\": [\n        {\n          \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n          \"source_handle\": \"P0284\",\n          \"atom_ids\": [\n            \"atom::2620179246640ac636d56bd9\",\n            \"atom::b79fd70d6332212f4813f1df\",\n            \"atom::14e691e33244b8717f4d127f\",\n            \"atom::7338e32444ea409cd35d5626\",\n            \"atom::ad228a9a09cf1bde833cd70d\",\n            \"atom::f0f8a256e3b6de3f1f5a7dfd\",\n            \"atom::69d42911848667bdf02843e3\",\n            \"atom::4d3393b35296f0c4133f8239\",\n            \"atom::e7e6394717aa4609a837b993\",\n            \"atom::bd05dd22bf395b6bb6a493e0\",\n            \"atom::894d9adbbc30a71c986943d3\",\n            \"atom::de73fe9ade530a582fbcc4a4\",\n            \"atom::70fc3918076487e962a70529\",\n            \"atom::4ae76f027dd241b7100eeee0\",\n            \"atom::3aba09de1928023c017e60a8\",\n            \"atom::68b54a3451f1ab3d7966a2e1\",\n            \"atom::e80331c46c052c7581ada8d5\",\n            \"atom::f5b77f6f89c89b517fbf6126\",\n            \"atom::9964b8d843b952c18995daf5\",\n            \"atom::1482d971688f8c6a45f4eb09\",\n        