          {
            "unit_id": "U2_外部干扰与宿主背景",
            "focus": "外部药物暴露（抗生素、PPIs）及联合治疗方案构成关键混杂/修饰变量，其影响具有明确的时间窗口特异性和剂量依赖性，需在关联分析中严格校正。",
            "paragraph_tasks": [
              {
                "paragraph_id": "U2_外部干扰与宿主背景_P01",
                "point": "量化抗生素/PPIs 暴露的效应量与时间窗特异性",
                "development": "汇总 Meta 分析数据，指出抗生素使用与 OS 恶化（HR=1.61）、PFS 缩短（HR=1.43）及 ORR 降低（RR=0.58）显著相关；亚组分析证实负面关联在 ICI 治疗前后 [-45, 45] 天窗口内最强（β=0.2192, p=0.008），同期 PPIs 暴露亦导致 OS 恶化（HR≈1.31）。",
                "source_uses": [
                  {
                    "source_handle": "P0081",
                    "role": "主论据",
                    "use": "汇总 Meta 分析数据，指出抗生素使用与 OS 恶化、PFS 缩短及 ORR 降低显著相关"
                  },
                  {
                    "source_handle": "P0402",
                    "role": "主论据",
                    "use": "系统综述明确 ICI 启动前 30 天内的抗生素暴露是预后恶化的核心风险窗口，量化时间窗特异性"
                  },
                  {
                    "source_handle": "P0123",
                    "role": "例证",
                    "use": "量化抗酸药（PPIs）使用导致链球菌增加及短 PFS 的关联，并对比化疗预处理对微生物组的持久影响"
                  },
                  {
                    "source_handle": "P0236",
                    "role": "主论据",
                    "use": "提供超 5 万名实体瘤患者的系统综述与荟萃分析数据，量化全身性抗生素暴露导致 PFS 和 OS 显著缩短的效应量"
                  },
                  {
                    "source_handle": "P0266",
                    "role": "例证",
                    "use": "聚焦拉丁美洲 NSCLC 人群，证实抗生素暴露显著降低 OS 但未影响 PFS，提示地域/人群特征可能扰动微生物 - 疗效轴"
                  },
                  {
                    "source_handle": "P0275",
                    "role": "比较",
                    "use": "针对 HCC 人群的 Meta 分析显示抗生素使用未显著恶化 ICI 疗效，提出肝硬化基线免疫抑制状态可能缓冲抗生素扰动"
                  },
                  {
                    "source_handle": "P0289",
                    "role": "例证",
                    "use": "揭示质子泵抑制剂 (PPI) 使用者粪便中口腔细菌比例显著升高，且该特征在 PPI 亚组中与更差 PFS 趋势强相关"
                  },
                  {
                    "source_handle": "P0339",
                    "role": "主论据",
                    "use": "提供大样本荟萃分析数据，量化 PPI 使用与 ICI 生存结局恶化的关联，并细化使用时窗的效应差异"
                  },
                  {
                    "source_handle": "P0360",
                    "role": "例证",
                    "use": "提供妇科肿瘤真实世界数据，明确抗生素使用时长（≥14 天）与 OS 显著缩短的独立关联"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
                  "U2_外部干扰与宿主背景_P01"
                ],
                "source_brief_details": [
                  {
                    "paragraph_id": "U2_外部干扰与宿主背景_P01",
                    "unit_id": "U2_外部干扰与宿主背景",
                    "ordinal": 1,
                    "point": "量化抗生素/PPIs 暴露的效应量与时间窗特异性",
                    "development": "汇总 Meta 分析数据，指出抗生素使用与 OS 恶化（HR=1.61）、PFS 缩短（HR=1.43）及 ORR 降低（RR=0.58）显著相关；亚组分析证实负面关联在 ICI 治疗前后 [-45, 45] 天窗口内最强（β=0.2192, p=0.008），同期 PPIs 暴露亦导致 OS 恶化（HR≈1.31）。",
                    "source_handles": [
                      "P0081",
                      "P0402"
                    ],
                    "finding_conditions": "抗生素暴露与 OS 恶化（HR=1.61, 95% CI 1.44-1.81）、PFS 缩短（HR=1.43, 95% CI 1.27-1.60）及 ORR 降低（RR=0.58, 95% CI 0.51-0.66）显著相关；在 ICI 治疗前后 [-45, 45] 天窗口内使用抗生素，OS 恶化风险最高（β=0.2192, p=0.008）（P0081, P0402）。"
                  }
                ]
              },
              {
                "paragraph_id": "U2_外部干扰与宿主背景_P02",
                "point": "讨论联合方案对微生物效应的修饰与反转",
                "development": "对比 NIC 与 PC 组，指出 Fusicatenibacter 和 Butyricicoccus 高丰度仅在 NIC 组中与更好 OS 相关（HR 分别为 0.56 和 0.52），而 Prevotellaceae NK3B31 高丰度在 NIC 组中与更高死亡风险相关（HR=2.33），说明联合方案可反转或放大微生物效应方向。",
                "source_uses": [
                  {
                    "source_handle": "P0585",
                    "role": "主论据",
                    "use": "对比 NIC 与 PC 组，指出特定菌高丰度仅在 NIC 组中与更好 OS 相关，说明联合方案可反转或放大微生物效应方向"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
                  "U2_外部干扰与宿主背景_P02"
