            ],
            "table_tasks": [],
            "owner_unit_context": {
              "evidence_conditions": "",
              "synthesis": "",
              "transition": "",
              "argument_relations": "本单元承接 Ch2_U01 的先天识别/DC 启动，转向屏障与髓系层面的系统重塑，并为 Ch2_U04 的肿瘤类型特异性与模型差异提供机制基础；不重复 Ch5 的干预试验评价，也不深入 Ch3 的代谢物浓度/剂量问题。",
              "supporting_studies": [
                {
                  "source_handle": "P0073",
                  "paper_id": "1a747439d702aff9bb8fb4513e8de0c1063c237a",
                  "contribution": "提供人源肠芯片中响应者/非响应者粪便对屏障完整性、炎症通路和微生物分子（LPS/鞭毛蛋白）差异的功能证据。",
                  "conditions": "黑色素瘤患者粪便；肠芯片；LPS 与鞭毛蛋白对照。",
                  "limits": "体外模型未整合完整免疫系统；样本量小；不能直接等同体内全身疗效。"
                },
                {
                  "source_handle": "P0166",
                  "paper_id": "48ff8778babb3307819f8c65b752079c1045f3a6",
                  "contribution": "提供 ICT 诱导肠道细菌经 DC/CCR7 向 MLN、TDLN 和肿瘤转移，并增强肠外抗肿瘤免疫的因果路径。",
                  "conditions": "B16-F10 小鼠；联合抗 PD-1/CTLA-4；DC 耗竭、CCR7 缺失、MLN 切除、抗生素与菌株回补。",
                  "limits": "仅限黑色素瘤小鼠模型；联合 ICT 与单药可能不同；检测方法影响可见菌群。"
                },
