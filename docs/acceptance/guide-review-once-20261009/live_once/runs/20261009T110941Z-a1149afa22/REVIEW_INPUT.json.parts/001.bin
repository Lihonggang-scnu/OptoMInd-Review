            ]
          },
          {
            "unit_id": "Ch2_U03",
            "focus": "屏障完整性、细菌易位与髓系重编程构成连续而条件依赖的机制链",
            "paragraph_tasks": [
              {
                "paragraph_id": "Ch2_U03_P01",
                "point": "肠道屏障完整性是微生物信号能否转化为全身免疫事件的条件闸门。",
                "development": "用肠芯片证据说明非响应者粪便/LPS 可破坏 ZO-1/β-catenin 并激活 TNF/IL-6/NF-κB，而响应者粪便中鞭毛蛋白/TLR-5 相关信号与屏障维持相关；再引入 P. bifermentans 活菌破坏上皮屏障并诱导炎症、但其无细胞小分子组分保留抗肿瘤增效的双重结构，强调屏障损伤与疗效增强并非同一机制的必然结果。",
                "source_uses": [
                  {
                    "source_handle": "P0073",
                    "role": "主论据",
                    "use": "提供人源肠芯片中响应者/非响应者粪便对屏障完整性、炎症通路和微生物分子（LPS/鞭毛蛋白）差异的功能证据。"
                  },
                  {
                    "source_handle": "P0284",
                    "role": "例证",
                    "use": "提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
                  "Ch2_U03_P01"
                ],
                "source_brief_details": [
                  {
                    "paragraph_id": "Ch2_U03_P01",
                    "unit_id": "Ch2_U03",
                    "ordinal": 1,
                    "point": "肠道屏障完整性是微生物信号能否转化为全身免疫事件的条件闸门。",
                    "development": "用肠芯片证据说明非响应者粪便/LPS 可破坏 ZO-1/β-catenin 并激活 TNF/IL-6/NF-κB，而响应者粪便中鞭毛蛋白/TLR-5 相关信号与屏障维持相关；再引入 P. bifermentans 活菌破坏上皮屏障并诱导炎症、但其无细胞小分子组分保留抗肿瘤增效的双重结构，强调屏障损伤与疗效增强并非同一机制的必然结果。",
                    "source_handles": [
                      "P0073",
                      "P0284"
                    ]
                  }
                ]
              },
              {
                "paragraph_id": "Ch2_U03_P02",
                "point": "细菌易位可以是治疗诱导的主动免疫转运过程，而非单纯被动漏肠。",
                "development": "以 P0166 为核心，说明联合 ICT 诱导特定肠道细菌经 DC 摄取并以 CCR7 依赖方式进入 MLN、TDLN 和肿瘤，MLN 切除会削弱远端抗肿瘤免疫；结合 PDAC 综述中细菌经门静脉/淋巴/胆道等路径进入肿瘤或次级淋巴器官并激活局部 PRR 的描述，以及消化道肿瘤中 Fn 等病原菌局部免疫抑制的案例，建立“屏障—转运—局部免疫”的解剖链条。",
                "source_uses": [
                  {
                    "source_handle": "P0166",
                    "role": "主论据",
                    "use": "提供 ICT 诱导肠道细菌经 DC/CCR7 向 MLN、TDLN 和肿瘤转移，并增强肠外抗肿瘤免疫的因果路径。"
                  },
                  {
                    "source_handle": "P0084",
                    "role": "背景",
                    "use": "提供 PDAC 中肠道菌群/细菌易位通过 PRR 和巨噬细胞/TAM 重编程形成局部免疫抑制的综述性机制框架。"
                  },
                  {
                    "source_handle": "P0438",
                    "role": "例证",
                    "use": "提供消化道肿瘤中 Fn 抑制 NK/招募 MDSC、Barnesiella 增强 T 细胞浸润等局部微生物调控案例。"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
                  "Ch2_U03_P02"
                ],
                "source_brief_details": [
                  {
                    "paragraph_id": "Ch2_U03_P02",
                    "unit_id": "Ch2_U03",
                    "ordinal": 2,
                    "point": "细菌易位可以是治疗诱导的主动免疫转运过程，而非单纯被动漏肠。",
                    "development": "以 P0166 为核心，说明联合 ICT 诱导特定肠道细菌经 DC 摄取并以 CCR7 依赖方式进入 MLN、TDLN 和肿瘤，MLN 切除会削弱远端抗肿瘤免疫；结合 PDAC 综述中细菌经门静脉/淋巴/胆道等路径进入肿瘤或次级淋巴器官并激活局部 PRR 的描述，以及消化道肿瘤中 Fn 等病原菌局部免疫抑制的案例，建立“屏障—转运—局部免疫”的解剖链条。",
                    "source_handles": [
                      "P0166",
                      "P0084",
                      "P0438"
                    ]
                  }
                ]
              },
              {
                "paragraph_id": "Ch2_U03_P03",
                "point": "易位微生物的免疫后果主要由髓系细胞重编程决定。",
                "development": "说明易位细菌或屏障来源信号可通过 TLR/PRR 改变 TAM、MDSC 和巨噬细胞表型：在 PDAC 背景中促进免疫抑制性 TAM 并限制 T 细胞活化，抗生素清除后可恢复促炎表型与抗 PD-1 反应；同时用广谱 ICI 耐药综述补充 MDSC、M2 样 TAM、TGF-β/IL-10、缺氧和乳酸积累等共同构成免疫抑制网络；再用 FMT 综述指出微生物干预可能增加效应 T 细胞或减少抑制性髓系细胞，但失败案例同样存在。",
                "source_uses": [
                  {
                    "source_handle": "P0084",
                    "role": "主论据",
                    "use": "提供肠道菌群或肿瘤内易位细菌可通过 PRR 诱导巨噬细胞/TAM 向免疫抑制表型转化的综述框架。"
                  },
                  {
                    "source_handle": "P0362",
                    "role": "背景",
                    "use": "提供 ICI 耐药中 MDSC、TAM、Treg、缺氧、乳酸和氨基酸代谢等免疫抑制网络的背景框架。"
                  },
                  {
                    "source_handle": "P0438",
                    "role": "例证",
                    "use": "补充易位后髓系/NK 语境，如 Fn 抑制 NK/招募 MDSC。"
                  },
                  {
                    "source_handle": "P0573",
                    "role": "局限",
                    "use": "提供 FMT 联合 ICI 的机制异质性综述：可增加效应 T 细胞、减少 Treg/MDSC，也可能失败或引入不利代谢/菌群。"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
                  "Ch2_U03_P03"
                ],
                "source_brief_details": [
                  {
                    "paragraph_id": "Ch2_U03_P03",
                    "unit_id": "Ch2_U03",
                    "ordinal": 3,
                    "point": "易位微生物的免疫后果主要由髓系细胞重编程决定。",
                    "development": "说明易位细菌或屏障来源信号可通过 TLR/PRR 改变 TAM、MDSC 和巨噬细胞表型：在 PDAC 背景中促进免疫抑制性 TAM 并限制 T 细胞活化，抗生素清除后可恢复促炎表型与抗 PD-1 反应；同时用广谱 ICI 耐药综述补充 MDSC、M2 样 TAM、TGF-β/IL-10、缺氧和乳酸积累等共同构成免疫抑制网络；再用 FMT 综述指出微生物干预可能增加效应 T 细胞或减少抑制性髓系细胞，但失败案例同样存在。",
                    "source_handles": [
                      "P0084",
                      "P0362",
                      "P0438",
                      "P0573"
                    ]
                  }
                ]
              },
              {
                "paragraph_id": "Ch2_U03_P04",
                "point": "人类证据显示微生物屏障/易位相关重塑具有疗效与毒性的情境依赖，但不能直接外推小鼠因果。",
                "development": "用 FMT-LUMINate 说明人类响应者以有害菌丢失、色氨酸代谢产物下降和 CD8+ T 细胞增加为特征，而 Prevotella 富集供体仅在双 ICI 背景下与严重毒性相关；结合 P. bifermentans 的活菌炎症/小分子增效双重机制与 FMT 综述中的异质性结果，强调同一微生物状态可能同时关联疗效与毒性，且依赖 ICI 方案、宿主基线与肿瘤类型。此处不展开代谢物浓度与剂量问题，留给 Ch3。",
                "source_uses": [
                  {
                    "source_handle": "P0583",
                    "role": "主论据",
                    "use": "提供人类 FMT 联合 ICI 中基线有害菌清除、代谢产物下降、CD8+ T 细胞增加及方案依赖毒性信号的核心临床证据。"
                  },
                  {
                    "source_handle": "P0284",
                    "role": "例证",
                    "use": "提供同一菌种 P. bifermentans 通过活菌破坏屏障/促炎、而小分子组分增强双 ICI 疗效的双重机制案例。"
                  },
                  {
                    "source_handle": "P0573",
                    "role": "背景",
                    "use": "提供 FMT 联合 ICI 的机制异质性综述，支持情境依赖观点。"
                  },
                  {
                    "source_handle": "P0333",
                    "role": "背景",
                    "use": "提供微生物 - 代谢物 - 免疫轴的情境依赖综述框架，提示不同癌种、方案和宿主背景下同一微生物特征可能产生不同效应。"
                  },
                  {
                    "source_handle": "P0584",
