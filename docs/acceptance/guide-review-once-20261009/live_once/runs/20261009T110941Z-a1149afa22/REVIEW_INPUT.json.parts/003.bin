    {
      "source_handle": "P0421",
      "identity": {
        "source_handle": "P0421",
        "source_id": "source::P0421",
        "aliases": [],
        "title": "The impact of sarcopenia on the efficacy and safety of immune checkpoint inhibitors in patients with solid tumours",
        "doi": "10.1080/0284186x.2021.1978540",
        "paper_id": "b7d5f0bd4b9b2ff5ccb0fca4182d84c2111a7fdf",
        "year": "2021",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在探讨低肌肉量是否影响实体瘤患者接受ICIs治疗的临床结局和安全性。研究回顾性分析了2013年至2017年间接受ICIs治疗的患者队列，通过CT影像评估L3骨骼肌指数以定义低肌肉量。主要发现显示，在整体队列中，低肌肉量与PFS无显著关联；但在亚组分析中，肺癌患者的低肌肉量反而与较长的PFS相关。此外，低肌肉量并未增加发生免疫相关严重毒性的风险。研究结论认为，低肌肉量并非ICIs疗效或安全性的负面预测因子，提示即使存在肌肉减少症，患者仍可受益于ICIs治疗，但需注意营养支持和体能状态管理。"
        }
      ],
      "chapter_ids": [
        "Ch1"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch1",
          "unit_id": "U2_外部干扰与宿主背景"
        }
      ],
