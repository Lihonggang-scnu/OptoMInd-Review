    {
      "source_handle": "P0146",
      "identity": {
        "source_handle": "P0146",
        "source_id": "source::P0146",
        "aliases": [],
        "title": "Gut microbiota shapes cancer immunotherapy responses",
        "doi": "10.1038/s41522-025-00786-8",
        "paper_id": "4171288ecca93c6bca3eee61295418d704bb00fd",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This paper provides a comprehensive overview of how the gut microbiome modulates the efficacy and toxicity of cancer immunotherapies. It traces the historical evolution from early animal studies to recent clinical trials, detailing specific microbial signatures associated with response or resistance to ICIs and ACTs. The authors synthesize mechanistic insights involving innate and adaptive immune modulation, metabolite production, and tumor microenvironment remodeling. Furthermore, it evaluates therapeutic interventions such as fecal microbiota transplantation (FMT), probiotics, dietary modifications, and engineered bacteria, while highlighting challenges in standardization and clinical translation."
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch2",
        "Ch6"
      ],
