  "source_catalog": [
    {
      "source_handle": "P0096",
      "identity": {
        "source_handle": "P0096",
        "source_id": "source::P0096",
        "aliases": [],
        "title": "The Gut Microbiome from a Biomarker to a Novel Therapeutic Strategy for Immunotherapy Response in Patients with Lung Cancer",
        "doi": "10.3390/curroncol30110681",
        "paper_id": "261e0a3618ae7acf6e831646379929eff88857d5",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇综述，系统梳理了肠道和肺部微生物组作为预测生物标志物及辅助治疗策略在NSCLC免疫治疗中的应用现状。文章首先回顾了抗生素（ATB）和质子泵抑制剂（PPI）等合并用药对微生物组的破坏作用及其对ICI疗效的负面影响；其次，总结了多项临床研究中确定的与ICI响应相关的特定细菌特征（如Akkermansia muciniphila、Faecalibacterium等）；最后，评估了通过粪便微生物移植（FMT）、益生菌、益生元、饮食干预及噬菌体疗法等调节微生物组的潜在治疗手段及其临床试验进展。"
        }
      ],
