          "chapter_id": "Ch1",
          "unit_id": "U2_外部干扰与宿主背景"
        },
        {
          "chapter_id": "Ch4",
          "unit_id": "Ch4_U01"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0548",
      "identity": {
        "source_handle": "P0548",
        "source_id": "source::P0548",
        "aliases": [],
        "title": "The Effect of the Gut Microbiota on Systemic and Anti-Tumor Immunity and Response to Systemic Therapy against Cancer",
        "doi": "10.3390/cancers14153563",
        "paper_id": "f381ac20e0012cee8a359a479037e3d12ee6e878",
        "year": "2022",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该综述旨在系统梳理肠道微生物群如何通过调节全身性和抗肿瘤免疫反应，进而影响癌症进展及对系统性治疗（尤其是免疫检查点抑制剂）的响应。文章首先阐述了肠道微生物在维持免疫稳态、促进T细胞分化（如Tregs, Th1, Th17）中的基础作用；随后探讨了微生物-肿瘤-免疫轴的双向关系，包括促癌和抗癌机制；重点分析了特定菌种及其代谢物对先天性和适应性抗肿瘤免疫的影响；最后汇总了临床前和临床研究证据，讨论微生物组成多样性、特定菌株丰度以及抗生素使用对ICIs疗效和毒性的影响，并提出了基于微生物组的个性化治疗策略前景。"
        }
      ],
