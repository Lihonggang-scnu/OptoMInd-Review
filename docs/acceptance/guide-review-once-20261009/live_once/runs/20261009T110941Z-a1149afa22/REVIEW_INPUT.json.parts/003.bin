    },
    {
      "source_handle": "P0227",
      "identity": {
        "source_handle": "P0227",
        "source_id": "source::P0227",
        "aliases": [],
        "title": "Abstract 6469: Longitudinal loss of microbiome stability is associated with poor response to immune checkpoint inhibitors in lung cancer and melanoma",
        "doi": "10.1158/1538-7445.am2026-6469",
        "paper_id": "5e9212b7607472bd4faf0f6e2385c37552c9821c",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在解决ICI治疗中多数患者最终出现疾病进展且缺乏有效生物标志物的问题，特别是针对肠道微生物群纵向动力学理解不足的现状。研究团队通过纵向监测NSCLC患者的肠道微生物特征，发现对ICI反应不佳的患者在治疗初期表现出个体内微生物稳定性的丧失，这一现象独立于抗生素暴露之外。研究进一步利用递归特征消除结合随机森林分类器识别出与疾病进展相关的特定微生物物种，并构建了一个基于治疗前粪便样本的指数，该指数在独立的肺癌队列中验证了其对临床结果的预测能力。结论指出微生物不稳定性可能是ICI原发耐药性的早期指标。"
        }
      ],
      "chapter_ids": [
        "Ch1"
      ],
