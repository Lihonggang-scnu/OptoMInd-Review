    {
      "source_handle": "P0585",
      "identity": {
        "source_handle": "P0585",
        "source_id": "source::P0585",
        "aliases": [],
        "title": "Gut Microbiota in Advanced Non-small-cell Lung Cancer Receiving Chemo-immunotherapy: An Ancillary Biomarker Study from the Phase III trial JCOG2007 (NIPPON).",
        "doi": "10.1016/j.jtho.2025.02.026",
        "paper_id": "8016df1aa5a8160b7ccd412fa6851a6a508e2731",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在探索肠道微生物群作为晚期NSCLC化疗-免疫治疗疗效和安全性生物标志物的潜力。研究利用JCOG2007试验中270名有基线粪便样本患者的16S rDNA测序数据，分析了微生物多样性及特定菌属丰度与总生存期（OS）及严重不良事件（AEs）之间的关联。结果显示，微生物结构随生存时间延长而变化，特定产丁酸菌属富集于长生存患者，且与较低的严重AE风险相关；此外，不同治疗方案下微生物对预后的影响存在差异。"
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch4",
        "Ch5"
      ],
