    },
    {
      "source_handle": "P0583",
      "identity": {
        "source_handle": "P0583",
        "source_id": "source::P0583",
        "aliases": [],
        "title": "Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial",
        "doi": "10.1038/s41591-025-04186-5",
        "paper_id": "071823eff68d7dbea395490dd4643170131b5f6a",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "这是一项多中心、开放标签的II期临床试验（FMT-LUMINate），旨在评估单次口服胶囊FMT在启动ICI治疗前对原发性耐药患者的影响。研究纳入20名NSCLC患者和20名黑色素瘤患者。主要终点为NSCLC队列的客观缓解率（ORR）。结果显示，NSCLC队列ORR为80%，超过预设阈值；黑色素瘤队列ORR为75%。安全性方面，NSCLC组无3级及以上不良事件，而黑色素瘤组出现较早发的严重免疫相关不良反应（irAEs），特别是心肌炎，且与特定供体菌群有关。机制研究发现，响应者并非通过获得特定的供体菌株定植获益，而是通过显著清除基线存在的有害细菌物种（如Enterocloster和Clostridium属），从而降低色氨酸代谢途径活性并改善全身免疫微环境。"
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch2",
        "Ch4",
        "Ch5",
        "Ch6"
