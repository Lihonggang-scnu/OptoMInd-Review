    },
    {
      "source_handle": "P0333",
      "identity": {
        "source_handle": "P0333",
        "source_id": "source::P0333",
        "aliases": [
          "P0584"
        ],
        "title": "Navigating the gut–metabolite–immune axis: enhancing efficacy and mitigating toxicity of immune checkpoint inhibitors",
        "doi": "10.3389/fimmu.2026.1803970",
        "paper_id": "8e25ec1d06aea0a73a479436c268bc6fab267259",
        "equivalent_source_handles": [
          "P0333",
          "P0584"
        ],
        "identity_reconciliation": "explicit_alias_with_matching_stable_identity",
        "identity_metadata_variants": {
          "paper_id": [
            "CorpusId:290154100"
          ]
        },
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This narrative review synthesizes current evidence on how the gut microbiota and their metabolic byproducts regulate ICI efficacy and immune-related adverse events (irAEs). It delineates specific microbial taxa (e.g., Bacteroides, Bifidobacterium, Akkermansia) and metabolites (SCFAs, indole derivatives, TMAO) that modulate antitumor immunity and organ protection. The paper also evaluates emerging microbiome-targeted interventions, such as fecal microbiota transplantation (FMT), next-generation probiotics with encapsulation technologies, postbiotics, and precision nutrition, highlighting the context-dependent nature of these interactions and the need for standardized, multi-omics approaches to develop precise microbial interventions."
        },
        {
          "field": "study_summary_A.work_summary",
          "value": "This narrative review synthesizes current evidence on how the gut microbiota and microbe-derived metabolites regulate the efficacy and immune-related adverse events (irAEs) of ICIs. It highlights specific taxa like Bacteroides, Bifidobacterium, and Akkermansia muciniphila that potentiate therapeutic responses via pathways such as cGAS-STING and NOD2. The review also details how microbial metabolites protect organs like the heart and colon from inflammation while enhancing anti-tumor immunity. It evaluates emerging interventions like FMT and next-generation probiotics, noting that while preclinical and Phase I trials show feasibility, substantial hurdles remain regarding cohort heterogeneity, methodological standardization, and the need for large-scale longitudinal studies to establish reproducible predictive models."
        }
      ],
      "chapter_ids": [
        "Ch2",
        "Ch5",
        "Ch1",
        "Ch3",
