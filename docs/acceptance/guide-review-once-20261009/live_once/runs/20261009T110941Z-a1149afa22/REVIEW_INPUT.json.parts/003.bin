          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        },
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0309",
      "identity": {
        "source_handle": "P0309",
        "source_id": "source::P0309",
        "aliases": [],
        "title": "Immunomodulation by the Commensal Microbiome During Immune-Targeted Interventions: Focus on Cancer Immune Checkpoint Inhibitor Therapy and Vaccination",
        "doi": "10.3389/fimmu.2021.643255",
        "paper_id": "8552db34c533ee32ec30305e104babc5da9914ae",
        "year": "2021",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This is a narrative review that synthesizes existing clinical and preclinical literature to elucidate the reciprocal interactions between the microbiome, the immune system, and the outcomes of immune interventions. The authors juxtapose studies from ICI therapy and vaccination to identify common microbial and immune elements. They discuss clinical associations between specific microbial signatures (e.g., Faecalibacterium prausnitzii, Akkermansia muciniphilia) and treatment response, as well as preclinical mechanistic insights involving microbial metabolites (short-chain fatty acids, inosine), microbe-associated molecular patterns (MAMPs), and inflammatory cytokines. The review also addresses the impact of antibiotics, probiotics, prebiotics, and fecal microbiota transplants (FMT) on intervention outcomes, highlighting the potential for microbiome-based strategies to improve therapeutic efficacy."
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0028",
      "identity": {
        "source_handle": "P0028",
        "source_id": "source::P0028",
        "aliases": [],
        "title": "Bidirectional regulation of the gut microbiome-immune axis in the immune microenvironment of colorectal cancer and targeted interventions",
        "doi": "10.4251/wjgo.v17.i10.109503",
        "paper_id": "0d36b62772e0930cc8aead7edc85535b5b389e25",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇综述，旨在系统阐述结直肠癌中肠道微生物组与免疫系统的双向调节机制及其临床转化潜力。文章首先描述了CRC免疫微环境的组成特征，随后深入探讨了微生物通过模式识别受体（如TLR4、NLRP3）、代谢物（如短链脂肪酸SCFAs、次级胆汁酸）和抗原呈递影响免疫反应的分子机制；同时分析了免疫系统如何通过IgA、细胞因子（IL-17, IL-22）及PD-1通路反向调控微生物群落。此外，综述评估了微生物异质性对化疗和免疫检查点抑制剂疗效的影响，并讨论了工程菌、粪菌移植（FMT）及联合免疫治疗等靶向干预策略的现状与挑战。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0114",
      "identity": {
        "source_handle": "P0114",
        "source_id": "source::P0114",
        "aliases": [],
        "title": "Abstract 6686: The mechanism of gut microbiome-mediated immune activation on the clinical efficacy of PD-1 blocking treatment in solid tumors",
        "doi": "10.1158/1538-7445.am2024-6686",
        "paper_id": "3138b2ba3413f9ffc9b5e0000b6c0310cb34cd84",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该论文旨在阐明肠道微生物群介导的免疫激活在PD-1阻断治疗临床疗效中的具体机制。尽管已知肠道菌群与免疫检查点阻断疗法的抗肿瘤疗效相关，但其详细机制尚不明确。作者通过动物模型实验发现，这种源自响应者粪便的新型Ruminococcaceae菌株能够有效刺激并成熟CD103+树突状细胞（DCs），促进其从肠道迁移至肿瘤微环境和肿瘤引流淋巴结。这些被激活的CD103+ DCs随后延长与抗原特异性CD8+ T细胞的接触，诱导多种肿瘤抗原特异性CD8+ T细胞的激活，并增强其PD-1表达。此外，该菌株还能通过NFATc1核转位增强T细胞激活信号。在动物模型中，将该菌株与PD-1阻断联合使用，甚至能显著抑制肿瘤生长，包括在非响应者患者的粪便移植背景下也显示出增效作用。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0132",
      "identity": {
        "source_handle": "P0132",
        "source_id": "source::P0132",
        "aliases": [],
        "title": "Human Microbiome and Its Medical Applications",
        "doi": "10.3389/fmolb.2021.703585",
        "paper_id": "3ae3c79b877e85a192dae9804adf84211ceedab7",
        "year": "2022",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该综述旨在总结共生微生物组在特定疾病中的作用机制及工程菌在疾病预防、检测和治疗的最新进展。文章首先回顾了微生物组通过代谢产物（如SCFA、胆汁酸、TMAO）和炎症调节影响宿主代谢的机制，随后探讨了微生物组在肿瘤发生、转移及治疗反应（特别是免疫检查点抑制剂ICIs和化疗）中的双向作用，最后阐述了微生物组通过定植抗力抵抗病原体感染的机制。在此基础上，文章系统梳理了从非靶向干预（抗生素、饮食、FMT、益生菌）到靶向干预（工程菌作为传感器、治疗剂或诊断工具）的策略演变，并指出了工程菌临床转化面临的挑战。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0242",
      "identity": {
        "source_handle": "P0242",
        "source_id": "source::P0242",
        "aliases": [],
        "title": "Targeting PD-L2/RGMb overcomes microbiome-related immunotherapy resistance",
        "doi": "10.1038/s41586-023-06026-3",
        "paper_id": "657c221351daa09b93f85f8beef5195760d2acbb",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在揭示肠道微生物群如何调节抗肿瘤免疫反应，特别是针对PD-1/PD-L1抑制剂治疗无响应的情况。研究通过对比不同微生物状态下的免疫反应，发现微生物群通过下调树突状细胞（DCs）上的PD-L2表达来促进抗肿瘤免疫。进一步研究发现，PD-L2不仅结合PD-1，还结合排斥性导向分子b（RGMb）。在缺乏有益菌的模型中，PD-L2和RGMb的高表达抑制了CD8+ T细胞的活性。通过联合阻断PD-L2/RGMb通路或特异性敲除T细胞中的RGMb，可以克服由微生物缺失引起的对PD-1/PD-L1治疗的耐药性。研究还鉴定出特定细菌物种（如Coprobacillus cateniformis）能够诱导这种PD-L2下调，并验证了该机制在人源粪便移植模型中的潜在转化价值。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0535",
      "identity": {
        "source_handle": "P0535",
        "source_id": "source::P0535",
        "aliases": [],
        "title": "Intratumoral Microbiota in Tumor: Current Understandings and Future Perspectives",
        "doi": "10.1002/mco2.70825",
        "paper_id": "eea4059be35526f75d745cc8d16db8ec33658f69",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This is a comprehensive review synthesizing current knowledge on the role of intratumoral microbiota in cancer biology. It traces the historical evolution from early observations to modern multi-omics approaches, detailing methodological advances and challenges such as low biomass and contamination. The paper systematically categorizes the mechanisms by which intratumoral bacteria drive tumorigenesis (genomic instability, epigenetic changes, oncogenic signaling), promote metastasis (EMT, cytoskeletal remodeling, pre-metastatic niche formation), and modulate the immune landscape (suppression vs. activation). Furthermore, it evaluates the clinical utility of intratumoral bacteria as biomarkers for diagnosis and prognosis, and explores emerging therapeutic strategies targeting these microbes, including engineered bacteria, probiotics, antibiotics, and bacteriophages, particularly in the context of enhancing conventional therapies like chemotherapy, radiotherapy, and immunotherapy."
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U01"
        },
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        },
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0388",
      "identity": {
        "source_handle": "P0388",
        "source_id": "source::P0388",
        "aliases": [],
        "title": "Microbiota-induced T cell plasticity enables immune-mediated tumour control",
        "doi": "10.1038/s41586-025-09913-z",
        "paper_id": "a85afdff22ae96afa7e975dddb2b63ea9aa9cd29",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在阐明肠道微生物群如何通过分子模拟机制增强免疫检查点阻断（ICB）的抗肿瘤疗效。研究构建了合成新抗原模拟模型，将SFB的一个免疫显性CD4+ T细胞表位（SFB-3340）引入肿瘤细胞。结果显示，仅在SFB定植的小鼠中，抗PD-1治疗能有效抑制表达该抗原的肿瘤生长。通过单细胞测序、谱系追踪和条件性消融实验，研究发现SFB诱导的肠道固有层T_H17细胞迁移至远端肿瘤，在ICB作用下发生表型可塑性，转化为产生IFN-γ和TNF的T_H1-like效应细胞（ex-T_H17）。这些细胞通过重塑肿瘤微环境，促进CD8+细胞毒性T淋巴细胞的招募和活化，从而协同实现肿瘤控制。相比之下，诱导调节性T细胞程序的另一种细菌（H. hepaticus）未能增强ICB疗效。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        },
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0560",
      "identity": {
        "source_handle": "P0560",
        "source_id": "source::P0560",
        "aliases": [],
        "title": "Gut Microbiota and Tumor Immune Escape: A New Perspective for Improving Tumor Immunotherapy",
        "doi": "10.3390/cancers14215317",
        "paper_id": "f826b922c5585799af4e6bc30d1735d189bcc5e1",
        "year": "2022",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇综述，系统阐述了肠道微生物群如何通过影响肿瘤微环境（TME）中的免疫细胞分化、功能及炎症反应来介导肿瘤免疫逃逸。文章详细讨论了微生物群通过Th17/IL-17轴、肿瘤相关巨噬细胞（TAMs）、髓源性抑制细胞（MDSCs）等途径促进肿瘤进展的机制。此外，综述还评估了肠道微生物群组成如何决定患者对免疫检查点抑制剂（如PD-1/PD-L1和CTLA-4阻断剂）及CAR-T疗法的响应差异，并探讨了通过粪菌移植（FMT）、益生菌、抗生素调控等手段优化微生物群以改善免疫治疗效果的潜力。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0085",
      "identity": {
        "source_handle": "P0085",
        "source_id": "source::P0085",
        "aliases": [],
        "title": "Pre‐existing heterologous T‐cell immunity and neoantigen immunogenicity",
        "doi": "10.1002/cti2.1111",
        "paper_id": "1fc390ce78756996bf505f1fc9c3e6405ff665ba",
        "year": "2020",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇综述，旨在探讨宿主既往接触的微生物如何通过分子模拟（molecular mimicry）产生异源记忆T细胞，进而影响肿瘤新抗原的免疫原性。文章首先指出传统基于HLA结合预测的新抗原算法存在局限性，且新抗原的实际免疫原性受个体T细胞库影响。随后，文章阐述了T细胞受体（TCR）的交叉反应性特征，即TCR不仅能识别特定抗原，还能识别具有相似三维结构或关键残基的其他肽段。在此基础上，文章提出核心假设：宿主因感染病毒、细菌或接触肠道共生菌而产生的预存异源记忆T细胞，能够通过交叉反应增强对新抗原的识别和应答。文章引用了胰腺癌等实体瘤研究中发现的T细胞交叉反应证据，并讨论了不同微生物种类（如促炎与耐受性菌群）可能带来的不同免疫调节后果。最后，作者建议在未来的新抗原预测算法中纳入微生物暴露史和序列同源性信息，以优化个性化癌症免疫治疗的效果。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0269",
      "identity": {
        "source_handle": "P0269",
        "source_id": "source::P0269",
        "aliases": [],
        "title": "'Know thyself' – host factors influencing cancer response to immune checkpoint inhibitors",
        "doi": "10.1002/path.5907",
        "paper_id": "7297b72d6d45a0bb256e7e59cf9e282416f77bc7",
        "year": "2022",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This review article synthesizes emerging evidence regarding non-tumour-centric host factors that may serve as predictive biomarkers for ICI efficacy. The authors argue that current FDA-approved biomarkers are limited by their reliance on tumour tissue and poor generalizability across cancer types. Consequently, they explore alternative host-based predictors, including peripheral blood immune markers (e.g., neutrophil-to-lymphocyte ratio, eosinophils, TCR repertoire), germline genetics (e.g., HLA alleles, Fc-gamma receptor polymorphisms), phenotypic traits (e.g., obesity, cholesterol, gender), exogenous factors (e.g., medications like corticosteroids or antibiotics, diet), and specifically the gut microbiota. The paper highlights the potential modifiability of several factors, suggesting avenues for co-therapies to enhance ICI therapeutic index."
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        },
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0154",
      "identity": {
        "source_handle": "P0154",
        "source_id": "source::P0154",
        "aliases": [],
        "title": "Symbiotic bacteria-mediated imbalance and repair of immune homeostasis: exploring novel mechanisms of microbiome-host interactions in atopic dermatitis",
        "doi": "10.3389/fimmu.2025.1649857",
        "paper_id": "443d395fc74f8084d7e8e04c6f91a23b5e25f08d",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇综述，系统分析了皮肤共生菌与宿主免疫系统在特应性皮炎（AD）稳态维持与失衡中的作用。文章首先阐述了皮肤微生物群的空间分布及其组成变化，指出金黄色葡萄球菌（S. aureus）的富集和共生菌（如表皮葡萄球菌 S. epidermidis）的减少是AD皮损的特征。接着，详细探讨了共生菌通过代谢产物（如短链脂肪酸SCFAs、色氨酸代谢物）、抗菌肽分泌及受体信号通路（如TLR2、AHR）调节Th1/Th2/Th17免疫平衡的机制。文章进一步描述了“菌群失调-免疫激活-屏障破坏”的恶性循环，并评估了基于益生菌、益生元、噬菌体及粪菌移植等靶向微生物组的新型治疗策略的临床潜力与传统疗法的局限性。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0195",
      "identity": {
        "source_handle": "P0195",
        "source_id": "source::P0195",
        "aliases": [],
        "title": "The microbial metabolite desaminotyrosine enhances T-cell priming and cancer immunotherapy with immune checkpoint inhibitors",
        "doi": "10.1016/j.ebiom.2023.104834",
        "paper_id": "556c1f84751da3bea2bca5a9336429ad72962add",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在探讨细菌代谢物脱氨酪氨酸（DAT）作为I型干扰素（IFN-I）调节剂，能否增强实体瘤对免疫检查点抑制剂（ICI，如抗CTLA-4或抗PD-1）的治疗反应。研究通过口服补充DAT，在多种小鼠肿瘤模型中评估其抗肿瘤效果，并利用广谱抗生素诱导菌群失调模型模拟临床耐药情境，同时利用IFN-I信号缺失小鼠解析其分子机制。研究发现DAT能协同ICI增强T细胞活化，且该效应依赖于宿主IFN-I信号通路，并能部分逆转抗生素引起的治疗抵抗。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0444",
      "identity": {
        "source_handle": "P0444",
        "source_id": "source::P0444",
        "aliases": [],
        "title": "Microbial metabolic pathways guide response to immune checkpoint blockade therapy.",
        "doi": "10.1158/2159-8290.cd-24-1669",
        "paper_id": "c426f22c38d341a24524f67fd75537f6ef60aaf0",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在解决既往微生物组研究中物种组成不一致且机制不明的局限，转而关注微生物组的代谢功能输出对ICB疗效的指导作用。作者首先构建并整合了包含781个样本的多癌种ICB治疗患者宏基因组数据集（Microbe-ICB），证实相较于物种水平，代谢通路水平的功能谱在个体间更为保守和稳定。随后，通过计算“功能性菌群失调”评分，发现非响应者表现出更高的菌群功能失调，且这种失调在治疗期间进一步加剧。利用基因集富集分析（GSEA）和纵向队列验证，研究识别出两条关键代谢通路：促进ICB响应的甲基赤藓糖醇4-磷酸（MEP）通路，其产物HMBPP可激活Vδ2 T细胞介导的抗肿瘤活性；以及与耐药相关的核黄素合成通路，其产物5-OP-RU诱导MAIT细胞介导的免疫抑制。这些发现通过患者来源肿瘤类器官（PDTO）与免疫细胞的共培养实验得到了机制层面的验证。"
        }
      ],
      "chapter_ids": [
        "Ch2",
        "Ch3"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U02"
        },
        {
          "chapter_id": "Ch3",
          "unit_id": "U3_4"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0073",
      "identity": {
        "source_handle": "P0073",
        "source_id": "source::P0073",
        "aliases": [],
        "title": "A gut-on-a-chip incorporating human faecal samples and peristalsis predicts responses to immune checkpoint inhibitors for melanoma",
        "doi": "10.1038/s41551-024-01318-z",
        "paper_id": "1a747439d702aff9bb8fb4513e8de0c1063c237a",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究开发了一种集成人体微血管内皮细胞和诱导多能干细胞（hiPSC）来源肠类器官的微流控“肠-on-a-chip”模型，该模型通过胶原基质分隔两个通道，并具备模拟蠕动样机械运动的能力。研究利用该模型处理来自黑色素瘤ICI响应者和非响应者的粪便样本，结合转录组学、代谢组学和显微成像分析，发现非响应者粪便中的微生物群会导致肠道上皮屏障完整性显著受损（ZO-1和β-catenin下调），并引发强烈的促炎反应（如IL-6、TNF信号激活）。相比之下，响应者粪便中的可溶性因子（富含鞭毛蛋白相关基因）能激活TLR-5信号并促进IL-1β释放，有助于维持屏障稳态。此外，研究证实非响应者粪便中脂多糖（LPS）合成基因富集，其效应可通过外源LPS处理重现，而响应者粪便提取物或纯化的鞭毛蛋白可部分逆转这种损伤。该模型成功复现了体内观察到的微生物-宿主互作特征，并能区分不同临床结局患者的微生物功能差异。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U03"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0284",
      "identity": {
        "source_handle": "P0284",
        "source_id": "source::P0284",
        "aliases": [],
        "title": "Metagenomics and culturomics reveal the dual role of the gut microbiome in the development of immune-related toxicities and the efficacy of immune checkpoint inhibitors in cancer",
        "doi": "10.1186/s40168-026-02419-4",
        "paper_id": "7cdc8a62c7a781f0b9a88abe52934ab9b889134d",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This study addresses the paradoxical link between immune-related adverse events (irAEs) and improved efficacy in ICI therapy by dissecting the role of the gut microbiome. Using three independent cohorts totaling 589 patients with melanoma or NSCLC, the authors first validated that grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias. They then employed a combined approach of shotgun metagenomics and culturomics on fecal samples collected at baseline and during ir-colitis onset. Metagenomic analysis revealed that patients developing irAEs had lower alpha diversity and enrichment of pro-inflammatory taxa such as Ruminococcus gnavus and Streptococcus vestibularis. Culturomics identified Paraclostridium bifermentans as enriched in patients with acute ir-colitis. Functional validation in mice demonstrated that fecal microbiota transplantation from an ir-colitis patient induced subclinical colitis markers and enhanced anti-tumor activity of dual ICI. Specifically, P. bifermentans was shown to disrupt epithelial barrier integrity in vitro and exacerbate colitis in vivo via live bacteria interaction, while its anti-tumor benefit was mediated by a secreted low-molecular-weight metabolite (< 3 kDa). These findings provide a mechanistic link suggesting that specific pro-inflammatory bacteria can simultaneously drive toxicity and enhance therapeutic efficacy."
        }
      ],
      "chapter_ids": [
        "Ch2",
        "Ch6"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U03"
        },
        {
          "chapter_id": "Ch6",
          "unit_id": "Ch6_U4"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0166",
      "identity": {
        "source_handle": "P0166",
        "source_id": "source::P0166",
        "aliases": [],
        "title": "Immune checkpoint blockade induces gut microbiota translocation that augments extraintestinal anti-tumor immunity",
        "doi": "10.1126/sciimmunol.abo2003",
        "paper_id": "48ff8778babb3307819f8c65b752079c1045f3a6",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在阐明肠道微生物如何促进远端（肠外）肿瘤的免疫治疗反应。作者发现ICT治疗会诱导特定的内源性肠道细菌转移到肠系膜淋巴结（MLN）、肿瘤引流淋巴结（TDLN）和肿瘤组织中。机制上，ICT通过诱导肠道炎症激活树突状细胞（DCs），DCs依赖CCR7将细菌转运至MLN；同时ICT引起MLN重塑（淋巴管生成和高内皮微静脉扩张），这有助于细菌突破“黏膜防火墙”扩散至远端组织。这些转移的细菌（如粪肠球菌、约氏乳杆菌等）进一步激活DC并促进效应CD8+ T细胞的产生，从而增强ICT疗效。抗生素处理可阻断这一过程并削弱ICT效果。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U03"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0084",
      "identity": {
        "source_handle": "P0084",
        "source_id": "source::P0084",
        "aliases": [],
        "title": "Involvement of the Gut Microbiome in the Local and Systemic Immune Response to Pancreatic Ductal Adenocarcinoma",
        "doi": "10.3390/cancers16050996",
        "paper_id": "1e9bcb85e156528e8eb9e781e4d4845dc4149ed6",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇综述，旨在阐明肠道微生物组如何调节胰腺导管腺癌（PDAC）的局部和全身免疫反应。文章指出PDAC具有强烈的免疫抑制特性，而肠道微生物组作为最大的免疫器官，通过影响外周血免疫细胞群和肿瘤内微生物组成，进而改变肿瘤微环境中的免疫浸润。研究重点在于揭示这一过程中的具体机制，包括Th17/IL-17通路、巨噬细胞极化、模式识别受体（PRRs）信号传导以及细菌易位等，并探讨了这些机制对PDAC化疗和免疫治疗疗效的影响。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U03"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0438",
      "identity": {
        "source_handle": "P0438",
        "source_id": "source::P0438",
        "aliases": [],
        "title": "Gastrointestinal cancer resistance to treatment: the role of microbiota",
        "doi": "10.1186/s13027-024-00605-3",
        "paper_id": "c01d091d25a86879909c5dbeacff09210ff73402",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This review article examines the complex interactions between the human gastrointestinal microbiota and the efficacy of anti-cancer treatments for GICs. It synthesizes current knowledge on how specific microbial communities and their metabolites influence tumor initiation, progression, and therapeutic outcomes. The paper details molecular mechanisms by which bacteria like Helicobacter pylori, Bacteroides fragilis, and Fusobacterium nucleatum drive oncogenesis through inflammation and signaling pathways. Furthermore, it discusses how the microbiome modulates the effectiveness of chemotherapy, immunotherapy (particularly immune checkpoint inhibitors), and radiotherapy, highlighting both beneficial and detrimental effects on drug metabolism, immune activation, and toxicity. The authors conclude that understanding these interactions is crucial for developing personalized microbiome-targeted therapies to overcome treatment resistance."
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U03"
        },
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0362",
      "identity": {
        "source_handle": "P0362",
        "source_id": "source::P0362",
        "aliases": [],
        "title": "Biological mechanisms of resistance to immune checkpoint inhibitors and overcoming this resistance: Challenges in medical oncology",
        "doi": "10.15421/022412",
        "paper_id": "9d35f21e0312f02012226526155eabf2efc7472f",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该综述旨在系统梳理并归纳导致免疫检查点抑制剂疗效不佳的生物学机制，并基于这些机制提出克服耐药的临床治疗策略。作者将耐药机制分为三类：与肿瘤特性相关的机制（如低肿瘤突变负荷、新抗原丢失或呈递改变、信号通路异常及表观遗传修饰）、与肿瘤微环境相关的机制（包括免疫细胞亚群、基质细胞、细胞因子、代谢背景及缺氧状态），以及与患者特征相关的机制（肠道菌群、性别/激素、HLA-I基因型）。在此基础上，文章总结了联合用药策略，包括双免疫检查点抑制、联合抗血管生成药物、化疗、靶向治疗、表观遗传调节剂、PARP抑制剂及TGF-β抑制剂等，以增强抗肿瘤免疫反应。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U03"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0057",
      "identity": {
        "source_handle": "P0057",
        "source_id": "source::P0057",
        "aliases": [],
        "title": "Microbiome and Response to Therapy in Triple Negative Breast Cancer: A Systematic Review",
        "doi": "10.32604/or.2026.074215",
        "paper_id": "17a3c5cfa0cf5f59523761562650015ee0a27a38",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This systematic review synthesizes evidence from 14 studies (clinical trials, observational cohorts, and preclinical models) to evaluate the role of the microbiome in TNBC therapeutic response. It specifically investigates whether baseline microbiome composition and diversity predict pathological complete response (pCR) or survival outcomes under NACT and ICB regimens. The review highlights that higher microbial diversity and specific commensal taxa are associated with enhanced antitumor immunity and better treatment efficacy, while antibiotic-induced dysbiosis correlates with poorer outcomes. It also discusses potential mechanisms involving immune cell infiltration, macrophage polarization, and microbial metabolites."
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0090",
      "identity": {
        "source_handle": "P0090",
        "source_id": "source::P0090",
        "aliases": [],
        "title": "Gut microbiome impact on systemic therapy outcomes in metastatic renal cell carcinoma: a systematic review",
        "doi": "10.1007/s00345-026-06386-1",
        "paper_id": "2253f6b8b722c18cd3ea17b12f5a944ac838b73c",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "这是一篇系统综述，旨在评估肠道微生物组调节对mRCC患者全身治疗疗效影响的临床证据。研究遵循PRISMA指南，检索了截至2025年1月的PubMed、Web of Science和Scopus数据库。共纳入6项研究（总N=4738），包括3项回顾性队列研究和3项前瞻性随机对照试验（含一项仅摘要的II期RCT）。研究发现，围ICI治疗期的抗生素使用显著降低客观缓解率（ORR）、无进展生存期（PFS）和总生存期（OS）；而益生菌（如动物双歧杆菌）在VEGF-TKI治疗中可实现定植并富集有益菌属；来自ICI反应者的FMT联合pembrolizumab + axitinib显示出改善PFS和ORR的趋势。文章指出当前证据受限于回顾性设计、小样本和方法学异质性，呼吁开展标准化、生物标志物驱动的前瞻性RCT。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0113",
      "identity": {
        "source_handle": "P0113",
        "source_id": "source::P0113",
        "aliases": [],
        "title": "Influence of the gut microbiota on the response to immunotherapy in hepatocellular carcinoma",
        "doi": "10.20517/2394-5079.2025.07",
        "paper_id": "311fa59a8b5fb73c98a3ccc71ace6cff185cf5a1",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本文是一篇关于肠道微生物组如何影响肝细胞癌（HCC）对免疫检查点抑制剂（ICIs）疗效的系统综述。文章首先梳理了不同治疗方案（单药、TKI单药、ICI联合TKI）下，响应者与无响应者之间特定的肠道微生物特征差异，指出如Akkermansia muciniphila、Ruminococcaceae等菌属与良好预后相关，而Bacteroides等则常与耐药相关。其次，文章评估了基于微生物组的干预策略，包括抗生素使用、益生菌补充、益生元摄入和粪便微生物群移植（FMT），并讨论了其临床潜力与挑战。机制部分详细阐述了微生物通过调节肿瘤微环境（TME）中的免疫细胞（如CD8+ T细胞、NK细胞、Tregs）以及产生关键代谢物（如短链脂肪酸SCFAs、次级胆汁酸、MAMPs）来增强抗肿瘤免疫反应的路径。最后，文章探讨了HCC病因异质性（病毒性 vs. 代谢性/NASH）、肿瘤遗传及代谢异质性与微生物组的相互作用，并指出了多组学整合、标准化临床试验及伦理物流挑战等未来方向。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
        {
          "chapter_id": "Ch2",
          "unit_id": "Ch2_U04"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0352",
      "identity": {
        "source_handle": "P0352",
        "source_id": "source::P0352",
        "aliases": [],
        "title": "Lower respiratory tract microbiome dysbiosis impairs clinical responses to immune checkpoint blockade in advanced non‐small‐cell lung cancer",
        "doi": "10.1002/ctm2.70170",
        "paper_id": "99e3a3f190fb24b09b9be22b5300e85bd8a34e43",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "This study investigates the role of the lower respiratory tract microbiome in predicting clinical responses to immune checkpoint blockade (ICB) in advanced NSCLC. Using a retrospective single-center cohort of 26 patients, the authors performed 16S rRNA sequencing and untargeted metabolomics on BALF samples, alongside cytokine/chemokine assays and multiplex immunohistochemistry on tissue biopsies. The research aims to identif