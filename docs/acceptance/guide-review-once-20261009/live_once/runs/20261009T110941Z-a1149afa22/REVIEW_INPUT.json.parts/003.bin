    {
      "source_handle": "P0569",
      "identity": {
        "source_handle": "P0569",
        "source_id": "source::P0569",
        "aliases": [],
        "title": "1255 Longitudinal assessment of the gut microbiome and its association with treatment response in patients with non-small cell lung cancer receiving neoadjuvant immunotherapy",
        "doi": "10.1136/jitc-2024-sitc2024.1255",
        "paper_id": "fbbf5b7b16fb493ff4f0b84691ccb2b202d25d41",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在探讨基线肠道微生物组（GM）特征及纵向变化与NSCLC患者新辅助ICI治疗反应之间的关系。既往研究多关注晚期NSCLC，而本研究的背景是早期阶段患者的关联尚不明确。研究团队收集了患者的粪便样本进行16S rRNA扩增子测序，分析基线微生物组特征以及治疗期间的纵向变化，并将其与主要病理缓解（MPR）这一临床结局指标相关联。通过Bootstrap分析计算“自相似性”得分以评估纵向稳定性，并使用DESeq进行功能分析以阐明相关的代谢通路。"
        }
      ],
      "chapter_ids": [
        "Ch1"
      ],
