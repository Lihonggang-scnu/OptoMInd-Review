          {
            "unit_id": "Ch7_U02",
            "focus": "现有证据高度依赖观察性关联，抗生素使用、饮食结构、宿主遗传及肿瘤类型等混杂因素严重干扰因果链条的构建，且孟德尔随机化等方法在工具变量强度与人群代表性上存在固有缺陷。",
            "paragraph_tasks": [
              {
                "paragraph_id": "Ch7_U02_P01",
                "point": "界定观察性关联的因果倒置风险",
                "development": "强调多数发现源于横断面或回顾性队列，解释为何“有益菌富集”可能是疗效良好的结果而非原因。",
                "source_uses": [
                  {
                    "source_handle": "P0031",
                    "role": "主论据",
                    "use": "提供宏观背景与机制概览，指出肠道微生物组与 ICI 疗效关联的因果性不明及异质性大的局限性。"
                  },
                  {
                    "source_handle": "P0433",
                    "role": "主论据",
                    "use": "整合多个关键临床队列和基础研究的发现，指出许多机制证据来自小鼠模型，直接外推到人类需谨慎。"
                  },
                  {
                    "source_handle": "P0561",
                    "role": "发展",
                    "use": "提出“分子模拟”假说及量化方法（TAS），解释观察性关联背后的潜在因果机制，同时指出其验证局限性与 HLA LOH 等负面调节因素。"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
                  "Ch7_U02_P01"
                ],
                "source_brief_details": [
                  {
                    "paragraph_id": "Ch7_U02_P01",
                    "unit_id": "Ch7_U02",
                    "ordinal": 1,
                    "point": "界定观察性关联的因果倒置风险",
                    "development": "强调多数发现源于横断面或回顾性队列，解释为何“有益菌富集”可能是疗效良好的结果而非原因。",
                    "source_handles": [
                      "P0031",
                      "P0433"
                    ]
                  }
                ]
              },
              {
                "paragraph_id": "Ch7_U02_P02",
                "point": "评估药物与生活方式暴露的混杂干扰",
                "development": "列举抗生素、PPI及饮食对微生物组的广泛重塑作用，指出其可能掩盖或模拟微生物-ICI的真实关联。",
                "source_uses": [
                  {
                    "source_handle": "P0012",
                    "role": "例证",
                    "use": "提供抗生素干扰抗肿瘤治疗疗效的具体反面案例，提示肠道菌群失调可能通过多种机制影响药物疗效。"
                  },
                  {
                    "source_handle": "P0171",
                    "role": "主论据",
                    "use": "系统列出被报道与疗效相关或无关的具体微生物分类群，分析临床前与临床数据不一致性的方法学局限。"
                  },
                  {
                    "source_handle": "P0375",
                    "role": "发展",
                    "use": "提出“抗性/易感”微生物群概念框架，指出饮食模式与合并用药的交互作用会重塑菌群功能，警示观察性关联中未控暴露的混杂风险。"
                  },
                  {
                    "source_handle": "P0558",
                    "role": "例证",
                    "use": "提供 ICI 给药时间与生存结局的观察性数据，作为非微生物因素（时间生物学）干扰疗效的对照证据，警示混杂控制的复杂性。"
                  }
                ],
                "carried_over": true,
                "point_changed_from_brief": false,
                "source_briefs": [
