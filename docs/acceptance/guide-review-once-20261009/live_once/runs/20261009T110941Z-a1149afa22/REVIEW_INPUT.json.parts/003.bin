    {
      "source_handle": "P0134",
      "identity": {
        "source_handle": "P0134",
        "source_id": "source::P0134",
        "aliases": [],
        "title": "Fluctuations in Gut Microbiome Composition During Immune Checkpoint Inhibitor Therapy",
        "doi": "10.14740/wjon1587",
        "paper_id": "3bb355ee930e0893c48cf56a7164df771bf2d7f5",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在探索肠道微生物组在治疗过程中的动态变化是否能作为预测非小细胞肺癌患者对PD-1抑制剂反应的非侵入性生物标志物。鉴于基线微生物组特征和肿瘤组织PD-L1表达的预测价值有限，作者分析了5名患者的配对粪便样本，通过16S rRNA测序比较响应者与无响应者在治疗前后的微生物多样性及组成差异。研究发现，虽然基线α多样性在两组间无显著差异，但响应者在治疗期间的微生物多样性发生了显著改变，而无响应者则相对稳定或呈现不同的菌群演变模式。这表明治疗期间的微生物组波动可能与免疫治疗的疗效相关。"
        }
      ],
      "chapter_ids": [
        "Ch1"
      ],
