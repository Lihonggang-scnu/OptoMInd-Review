    },
    {
      "source_handle": "P0015",
      "identity": {
        "source_handle": "P0015",
        "source_id": "source::P0015",
        "aliases": [],
        "title": "A gut microbial signature for combination immune checkpoint blockade across cancer types",
        "doi": "10.1038/s41591-024-02823-z",
        "paper_id": "08a484e3c782bc9552d2df812bad2ec86f231edc",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在解决既往基于物种水平的微生物标志物在跨队列中可重复性差的问题，提出菌株水平分辨率可能更精准地捕捉与免疫检查点阻断（ICB）反应相关的微生物特征。作者利用CA209-538临床试验的106名罕见实体瘤患者的基线粪便样本进行深度鸟枪法宏基因组测序，构建了一个包含1,397个菌株基因组的自定义参考数据库。通过监督机器学习模型，发现菌株水平的微生物丰度比物种水平或临床因素更能预测CICB的治疗反应和12个月无进展生存期。进一步通过对六个外部独立研究的荟萃分析，证实了该菌株响应签名在不同癌症类型和国家间具有泛癌种有效性，但其预测能力严格依赖于训练集和测试集使用相同的ICB治疗方案（CICB或抗PD-1单药），表明微生物-宿主关系具有治疗方案的特异性而非肿瘤类型的特异性。"
        }
      ],
      "chapter_ids": [
        "Ch1"
      ],
