    {
      "source_handle": "P0298",
      "identity": {
        "source_handle": "P0298",
        "source_id": "source::P0298",
        "aliases": [],
        "title": "Gut microbial signatures and immunotherapy outcomes in NSCLC and melanoma: a systematic review and meta-analysis",
        "doi": "10.1186/s12885-026-15763-3",
        "paper_id": "82318ae05cff1667b2348961675db67dee4d8360",
        "year": "2026",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究是一项系统综述和荟萃分析，旨在综合评估基线肠道微生物组特征与非小细胞肺癌和黑色素瘤患者免疫检查点抑制剂（ICI）疗效及安全性之间的预后关联。研究遵循PRISMA指南，检索了截至2025年4月的多项数据库，纳入26项涉及1,542名患者的观察性研究。通过随机效应模型汇总了风险比（HR）和比值比（OR），并使用GRADE框架评估证据质量。结果显示，高肠道微生物α多样性与改善的总生存期和无进展生存期显著相关；特定菌属（如Akkermansia、Faecalibacterium）的存在与更好的客观缓解率或无进展生存期相关；近期抗生素使用与较差的生存结果相关；而在接受抗CTLA-4治疗的黑色素瘤患者中，拟杆菌门的高丰度与严重结肠炎风险降低相关。整体证据确定性为中等。"
        }
      ],
