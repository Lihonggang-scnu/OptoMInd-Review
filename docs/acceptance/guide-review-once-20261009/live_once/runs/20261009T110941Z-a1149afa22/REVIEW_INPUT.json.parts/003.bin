    },
    {
      "source_handle": "P0517",
      "identity": {
        "source_handle": "P0517",
        "source_id": "source::P0517",
        "aliases": [],
        "title": "The effects of antibiotics on the efficacy of immune checkpoint inhibitors in patients with non-small-cell lung cancer differ based on PD-L1 expression.",
        "doi": "10.1016/j.ejca.2021.02.040",
        "paper_id": "e8fb88935a5c5757dc683f56d1ff0c0f356b20ae",
        "year": "2021",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在探讨抗生素使用对NSCLC患者ICI疗效的影响，并特别关注这种影响是否因肿瘤PD-L1表达水平的不同而存在差异。研究回顾性分析了9家医疗机构在2015年12月至2018年5月期间收治的531名接受ICI单药治疗的NSCLC患者数据。通过Kaplan-Meier法和Cox比例风险模型，比较了在使用ICI前后两个月内使用抗生素与未使用抗生素患者的无进展生存期（PFS）和总生存期（OS）。结果显示，整体人群中抗生素使用显著缩短OS，但不影响PFS；进一步分析发现，这种负面影响主要集中在PD-L1高表达（≥50%）的患者亚组中，而在低表达（<50%）亚组中未见显著影响。"
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch4"
      ],
