    {
      "source_handle": "P0443",
      "identity": {
        "source_handle": "P0443",
        "source_id": "source::P0443",
        "aliases": [],
        "title": "Non-small cell lung cancer patients treated with Anti-PD1 immunotherapy show distinct microbial signatures and metabolic pathways according to progression-free survival and PD-L1 status",
        "doi": "10.1080/2162402x.2023.2204746",
        "paper_id": "c39938e0fe05e9c9d70243715a4b8f8524d956a9",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在探索肠道微生物组作为预测NSCLC患者抗PD-1免疫治疗疗效的新型生物标志物的潜力。作者利用鸟枪法宏基因组测序技术，对发现队列和验证队列患者的肠道菌群进行深度分析。研究首先比较了不同临床分组间的α-多样性和β-多样性差异，随后通过单变量和多变量统计模型（Lasso回归、Cox比例风险回归）筛选与PFS相关的特异性细菌分类群和代谢通路。最后，采用随机森林机器学习算法评估分类学特征和代谢通路在预测PFS和PD-L1表达中的效能。研究确认了特定菌属/种与PFS的关联，并揭示了微生物群落网络结构在治疗反应者与非反应者间的差异。"
        }
      ],
