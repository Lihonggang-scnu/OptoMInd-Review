        "source_id": "source::P0204",
        "aliases": [],
        "title": "Characterizations of multi-kingdom gut microbiota in immune checkpoint inhibitor-treated hepatocellular carcinoma",
        "doi": "10.1136/jitc-2023-008686",
        "paper_id": "58ddfd822378599d43b877cd0905dfe067a4375f",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在阐明多界肠道微生物群在ICI治疗HCC中的特征及其与临床疗效的关系。研究前瞻性纳入了80名接受ICI治疗的晚期HCC患者，利用宏基因组学、ITS2测序和代谢组学数据，对患者的肠道细菌、真菌及代谢物进行了多组学表征。研究比较了具有持久临床获益（DCB）与非持久临床获益（NDB）患者在治疗前后的微生物多样性变化，并尝试建立基于微生物特征的预测模型。"
        }
      ],
