          "chapter_id": "Ch1",
          "unit_id": "U4_证据阶梯与转化边界"
        },
        {
          "chapter_id": "Ch6",
          "unit_id": "Ch6_U1"
        }
      ],
      "review_source_handles": []
    },
    {
      "source_handle": "P0080",
      "identity": {
        "source_handle": "P0080",
        "source_id": "source::P0080",
        "aliases": [],
        "title": "Gut microbiota-derived hexa-acylated lipopolysaccharides enhance cancer immunotherapy responses",
        "doi": "10.1038/s41564-025-01930-y",
        "paper_id": "1c98ea21fbac0226e1f0c817968ad885448151f3",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在解决肠道微生物群组成与免疫检查点抑制剂（ICI）疗效之间关联不一致的问题，提出从物种分类转向功能代谢物结构的视角。作者通过分析112名黑色素瘤患者的基线粪便宏基因组数据，发现编码六酰化LPS的基因（lpxM）在临床响应者中富集，而总LPS合成基因在非响应者中更高。在小鼠模型中，通过抗生素选择性耗竭产生六酰化LPS的细菌或使用TLR4拮抗剂，证实了这种特定的LPS结构对于抗PD-1介导的抗肿瘤免疫是必需的；相反，口服补充六酰化LPS增强了抗PD-1疗效，而五酰化LPS无此效果甚至具有抑制作用。研究揭示了LPS酰化状态作为预测生物标志物和潜在治疗增强剂的潜力。"
        }
      ],
      "chapter_ids": [
        "Ch2"
      ],
      "unit_links": [
