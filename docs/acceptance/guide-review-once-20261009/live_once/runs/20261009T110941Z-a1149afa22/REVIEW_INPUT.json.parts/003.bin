    {
      "source_handle": "P0098",
      "identity": {
        "source_handle": "P0098",
        "source_id": "source::P0098",
        "aliases": [],
        "title": "Abstract 3463: Longitudinal microbiome-immune dynamics in melanoma patients treated with immune checkpoint inhibitor immunotherapy",
        "doi": "10.1158/1538-7445.am2023-3463",
        "paper_id": "2709ffca937655fdff12c871b14cb93ee1830d79",
        "year": "2023",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该研究旨在阐明肠道微生物组与免疫系统在ICI治疗中的纵向动态关系及其对疗效和免疫相关不良事件（irAEs）的影响。通过对126名患者的基线和第6周粪便样本进行16S rRNA基因测序，并对71名患者的外周血单个核细胞（PBMCs）进行质谱流式细胞术分析，研究发现ICI治疗导致循环中CD8+效应记忆T细胞增加和调节性T细胞（Tregs）减少。Tregs的减少主要见于应答者，但在发生严重irAEs的患者中也观察到显著缺乏。基线拟杆菌属（Bacteroides）丰度与Tregs减少程度及严重irAEs风险正相关，而瘤胃球菌科（Ruminococcaceae）高丰度则具有保护作用并关联更好的应答。结论指出肠道微生物组可能通过影响免疫平衡的“临界点”来塑造ICI的治疗结果。"
        }
      ],
      "chapter_ids": [
