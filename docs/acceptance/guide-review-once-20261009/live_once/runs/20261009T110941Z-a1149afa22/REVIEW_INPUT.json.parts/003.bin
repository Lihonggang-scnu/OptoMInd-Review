    },
    {
      "source_handle": "P0462",
      "identity": {
        "source_handle": "P0462",
        "source_id": "source::P0462",
        "aliases": [],
        "title": "Gut microbiome metabolites, molecular mimicry, and species-level variation drive long-term efficacy and adverse event outcomes in lung cancer survivors",
        "doi": "10.1016/j.ebiom.2024.105427",
        "paper_id": "cc2b555e2b10a62d0141cb12ab5cefa6e47d570c",
        "year": "2024",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在阐明肠道微生物组如何影响肺癌患者ICI治疗的长期结局及其潜在机制。通过前瞻性收集基线粪便样本进行宏基因组和代谢组测序，结合临床随访数据，分析微生物组成、短链脂肪酸（SCFA）水平、分子模拟现象及菌株变异与临床表型的关系。研究发现，长期获益患者拥有更紧凑的微生物网络和高产丁酸/丙酸的能力；irAE患者的微生物中存在与自身免疫抗原相似的表位；响应患者的微生物中富含与肺癌抗原相似的表位；且特定物种（如大肠杆菌和普拉梭菌）的菌株水平变异与临床表型显著相关。这些发现为“智能”粪菌移植提供了理论依据。"
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch2",
        "Ch6"
      ],
