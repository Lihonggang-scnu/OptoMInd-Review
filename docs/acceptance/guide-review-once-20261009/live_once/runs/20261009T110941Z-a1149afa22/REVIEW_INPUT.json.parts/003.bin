    {
      "source_handle": "P0273",
      "identity": {
        "source_handle": "P0273",
        "source_id": "source::P0273",
        "aliases": [],
        "title": "The Gut Microbiome and Cancer Immunotherapy: Can We Use the Gut Microbiome as a Predictive Biomarker for Clinical Response in Cancer Immunotherapy?",
        "doi": "10.3390/cancers13194824",
        "paper_id": "759b176490dcac135bff0b645dc106c3df8f4059",
        "year": "2021",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "review"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "该综述旨在评估肠道微生物组对癌症患者免疫检查点抑制剂（ICIs）临床结局及相关不良事件（AEs）的影响。作者检索了截至2021年3月的PubMed、Medline和ScienceDirect数据库，筛选出10项涉及成年人的临床研究。研究综合分析了基线微生物组的多样性（α/β多样性）和组成成分与ICIs疗效（无进展生存期PFS、总生存期OS）及胃肠道毒性（如结肠炎）之间的关联，并探讨了粪菌移植（FMT）在难治性患者中的潜在调节作用。"
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch4",
        "Ch5"
