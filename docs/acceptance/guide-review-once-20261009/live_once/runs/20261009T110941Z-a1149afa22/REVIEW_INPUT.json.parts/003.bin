    {
      "source_handle": "P0270",
      "identity": {
        "source_handle": "P0270",
        "source_id": "source::P0270",
        "aliases": [],
        "title": "Composition of gastrointestinal microbiota in association with treatment response in individuals with metastatic castrate resistant prostate cancer progressing on enzalutamide and initiating treatment with anti-PD-1 (pembrolizumab)",
        "doi": "10.1016/j.neo.2022.100822",
        "paper_id": "74786f8df0c7648840756833a4b4bc49ace34be6",
        "year": "2022",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在探究肠道微生物组组成与mCRPC患者对免疫检查点抑制剂（ICI）治疗反应的关联。研究纳入了23名在恩杂鲁胺治疗下疾病进展并即将开始帕博利珠单抗治疗的mCRPC患者。通过16S rRNA基因测序（覆盖多个高变区）和定量PCR（qPCR），比较了治疗反应者（PSA下降>50%或影像学缓解）与非反应者的微生物特征。研究发现，尽管整体α和β多样性在主要队列中无显著差异，但特定菌属存在差异：反应者中粪肠球菌、拟杆菌等富集，而此前在其他癌症中被认为促进ICI疗效的黏蛋白降解菌Akkermansia muciniphila在反应者中反而减少。此外，发现口腔共生菌Streptococcus salivarius在粪便中的丰度与反应正相关，但在口腔样本中无此关联，提示其作用具有部位特异性。研究还验证了一个综合微生物指数在本队列中无效，并观察到治疗期间微生物组总体稳定。"
        }
      ],
      "chapter_ids": [
        "Ch1",
        "Ch2"
      ],
