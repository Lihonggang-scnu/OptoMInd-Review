    {
      "source_handle": "P0393",
      "identity": {
        "source_handle": "P0393",
        "source_id": "source::P0393",
        "aliases": [],
        "title": "Multi-Kingdom Gut Microbiome Interaction Characteristics Predict Immune Checkpoint Inhibitor Efficacy Across Pan-Cancer Cohorts",
        "doi": "10.3390/microorganisms13112595",
        "paper_id": "a9e58de949ced186b4882146c14b79b306ae9ef5",
        "year": "2025",
        "canonical_paper_id": null
      },
      "source_types": [
        {
          "field": "study_summary_A.paper_kind",
          "value": "empirical"
        }
      ],
      "content_clues": [
        {
          "field": "study_summary_A.work_summary",
          "value": "本研究旨在评估多界微生物组及其相互作用对ICI治疗疗效的预测价值。作者整合了来自多个队列的大规模宏基因组数据，利用加权相似性网络融合（WSNF）方法将四种微生物域的数据整合并进行聚类，识别出两种患者亚型（C1和C2）。研究发现，C2亚型具有更高的微生物多样性、更稳定的共现网络结构，且与更好的ICI治疗反应和预后显著相关。通过差异分析和机器学习模型，作者筛选出包含32个属的多界微生物特征组合，其预测ICI疗效的准确性优于单一界别的模型。此外，研究还揭示了特定有益菌属（如拟杆菌属、克鲁维酵母属）和潜在有害菌属（如马拉色菌属）在不同亚型中的分布差异及其与免疫调节机制的关联。"
        }
      ],
      "chapter_ids": [
        "Ch1"
      ],
