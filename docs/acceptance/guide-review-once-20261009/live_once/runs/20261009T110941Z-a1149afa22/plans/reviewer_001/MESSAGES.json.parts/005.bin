76af1bde6e00dba83aa\",\n            \"atom::b30b08eb075f61505bc09741\",\n            \"atom::d89ef3a629b3edc8f1d5680d\",\n            \"atom::f9f47d7274d6ce123558914d\",\n            \"atom::13b75fe0affb6edd8981d33b\",\n            \"atom::59223824372c97eeae14a917\",\n            \"atom::4f486a10e036032c79861cfc\",\n            \"atom::c5b36a5dbcaf7631b8b07425\",\n            \"atom::4a9ba68194211f72c5ff2998\",\n            \"atom::309f1460bfa5781083656af4\",\n            \"atom::732cd6b3522e68e0af8deae5\",\n            \"atom::82ddeb3927993c2d17aa2d61\",\n            \"atom::29799ff01275a5961dfa4b1f\",\n            \"atom::cc0bd417229ac67f8358b8ee\",\n            \"atom::ce5af135f0f54a3f33ded5af\",\n            \"atom::911473103290b79cdeaaf990\",\n            \"atom::d608d3703ed2d823c7784427\",\n            \"atom::1c11e7ad8dda921d2c87e471\",\n            \"atom::9a50fe6e4b2c8671f940ffb9\",\n            \"atom::78212dc609fe90c3f037d637\",\n            \"atom::125505f32ce06e79d94ca2a2\",\n            \"atom::c058dc0771a54f0d89db5a07\",\n            \"atom::50e3812052714d3b820c4e72\",\n            \"atom::93b0bc69434a90089e6079fe\",\n            \"atom::533541e5da218bf180bf8879\"\n          ]\n        },\n        {\n          \"record_id\": \"record::4f1fac3cb1126bd412aa5f23d6fa9f53374fe76c4899ab6c911fa5ffaed6b231\",\n          \"source_handle\": \"P0593\",\n          \"atom_ids\": [\n            \"atom::f268dc5a31e6509082426a96\",\n            \"atom::915832e3eeeb6c7bf46b4dc7\",\n            \"atom::0c9458faeedb93aae1481ce2\",\n            \"atom::894b59684f5f72f52dd6cd62\",\n            \"atom::8ef0876af1bde6e00dba83aa\",\n            \"atom::b30b08eb075f61505bc09741\",\n            \"atom::d89ef3a629b3edc8f1d5680d\",\n            \"atom::f9f47d7274d6ce123558914d\",\n            \"atom::13b75fe0affb6edd8981d33b\",\n            \"atom::59223824372c97eeae14a917\",\n            \"atom::4f486a10e036032c79861cfc\",\n            \"atom::c5b36a5dbcaf7631b8b07425\",\n            \"atom::4a9ba68194211f72c5ff2998\",\n            \"atom::309f1460bfa5781083656af4\",\n            \"atom::732cd6b3522e68e0af8deae5\",\n            \"atom::82ddeb3927993c2d17aa2d61\",\n            \"atom::29799ff01275a5961dfa4b1f\",\n            \"atom::cc0bd417229ac67f8358b8ee\",\n            \"atom::ce5af135f0f54a3f33ded5af\",\n            \"atom::911473103290b79cdeaaf990\",\n            \"atom::d608d3703ed2d823c7784427\",\n            \"atom::1c11e7ad8dda921d2c87e471\",\n            \"atom::9a50fe6e4b2c8671f940ffb9\",\n            \"atom::78212dc609fe90c3f037d637\",\n            \"atom::125505f32ce06e79d94ca2a2\",\n            \"atom::c058dc0771a54f0d89db5a07\",\n            \"atom::50e3812052714d3b820c4e72\",\n            \"atom::93b0bc69434a90089e6079fe\",\n            \"atom::533541e5da218bf180bf8879\"\n          ]\n        }\n      ],\n      \"review_source_handles\": [],\n      \"packet_sha256\": \"69dffd91b9928e7cd8c156956b46941c5f2f6d91015a8f94d43aeaa29618eaec\",\n      \"need_ids\": [\n        \"N1\"\n      ],\n      \"questions\": [\n        \"Inspect original guide against linked intact evidence.\"\n      ],\n      \"reread_reasons\": [\n        null\n      ]\n    },\n    {\n      \"packet_kind\": \"source\",\n      \"source_handle\": \"P0090\",\n      \"source_identity\": {\n        \"source_handle\": \"P0090\",\n        \"source_id\": \"source::P0090\",\n        \"aliases\": [],\n        \"title\": \"Gut microbiome impact on systemic therapy outcomes in metastatic renal cell carcinoma: a systematic review\",\n        \"doi\": \"10.1007/s00345-026-06386-1\",\n        \"paper_id\": \"2253f6b8b722c18cd3ea17b12f5a944ac838b73c\",\n        \"year\": \"2026\",\n        \"canonical_paper_id\": null\n      },\n      \"evidence_atoms\": [\n        {\n          \"atom_id\": \"atom::8e8145e70a7d1810760361df\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"material_depth\"\n          ],\n          \"value\": \"fulltext\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"material_depth\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::98e4d7145d8aa32053893296\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"material_status\"\n          ],\n          \"value\": \"resolved\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"material_status\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::46d68237e826a20ae646f40e\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"approach\"\n          ],\n          \"value\": \"采用系统综述方法。1. 检索策略：基于PRISMA指南，在PubMed、WoS、Scopus进行文献检索，不限语言，截止日期为2025年1月。2. 纳入标准：成人mRCC患者，接受微生物组干预（抗生素、益生菌、前体、饮食、FMT）并与标准护理对比，报告ORR、PFS、OS或irAEs等临床终点。排除非比较研究、混合肿瘤类型未分层、儿科、临床前及非原创出版物。3. 质量评估：观察性研究使用纽卡斯尔-渥太华量表（NOS），RCT使用Cochrane RoB 2工具。4. 数据综合：定性综合各研究的干预措施、微生物组变化及临床结果，按干预类型（抗生素负面影响、益生菌/FMT潜在正面影响）分类叙述。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"approach\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::bb6258bf28f71234e7b1005d\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"contribution_and_limits\"\n          ],\n          \"value\": {\n            \"contribution\": \"首次系统汇总mRCC领域关于微生物组干预的临床证据，明确了抗生素对ICI疗效的负面关联，以及益生菌/FMT在靶向治疗和免疫治疗中的潜在增效作用。\",\n            \"limits\": \"所给材料未交代具体的荟萃分析统计结果（如合并效应量），主要依赖定性综合。证据基础薄弱：包含3项回顾性研究（存在混杂偏倚风险）和3项小样本RCT/摘要（统计效能不足，其中一项仅为会议摘要）。微生物组检测方法异质性高，缺乏标准化。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"contribution_and_limits\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::6a3d928b5a7bb7e7256aa430\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"mRCC患者接受ICI治疗，围治疗期（ICI开始前8周至开始后4周或30天内）使用广谱抗生素\",\n            \"finding\": \"抗生素暴露导致肠道菌群失调，显著降低ORR（12.9%-34.8% vs 更高比例），缩短PFS（HR 1.96-3.10）和OS（HR 3.5），增加疾病进展风险。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::9dd8c9da2bda33ccfed831a4\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"mRCC患者接受VEGF-TKI治疗期间补充含动物双歧杆菌的酸奶\",\n            \"finding\": \"益生菌实现100%定植，富集Akkermansia muciniphila和Barnesiella intestinihominis等有益菌属，观察到PFS延长的趋势，但未达到统计学显著差异（小样本n=20）。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::4f13d094ffea1dd368bb1748\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"mRCC患者接受pembrolizumab + axitinib治疗，接受来自长期ICI反应者的FMT\",\n            \"finding\": \"FMT组1年PFS显著高于对照组（66.7% vs 35.0%, p=0.036），ORR提高（54% vs 28%），且未增加≥3级不良事件（基于Phase II RCT摘要，n=50）。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"2\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::a6c7883bc90d2043e3b56081\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"mRCC患者接受cabozantinib + nivolumab治疗，补充CBM588益生菌\",\n            \"finding\": \"益生菌组ORR显著高于对照组（74% vs 20%），6个月PFS改善（84% vs 60%），伴随Ruminococcaceae富集和维生素K2合成通路增加，但双歧杆菌丰度本身无显著变化。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"3\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::501f38d3cca7db07bd78d991\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"paper_kind\"\n          ],\n          \"value\": \"review\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"paper_kind\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::ced0c1c26f04b05aed3ae8ef\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"problem_or_question\"\n          ],\n          \"value\": \"尽管ICIs和VEGF-TKIs改变了mRCC的治疗格局，但原发性耐药仍频繁发生。肠道微生物组被认为是影响全身治疗疗效的关键决定因素，但目前缺乏针对mRCC这一特定瘤种的系统性临床证据汇总。本研究旨在回答：在mRCC患者中，通过抗生素、益生菌、饮食或FMT调节肠道微生物组，如何影响ICIs和VEGF-TKIs的临床疗效？\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"problem_or_question\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::0e7aba6b220c2a791e43fff0\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"research_scope\"\n          ],\n          \"value\": \"转移性肾细胞癌（mRCC）成年患者，接受免疫检查点抑制剂（ICIs）或血管内皮生长因子-酪氨酸激酶抑制剂（VEGF-TKIs）全身治疗。重点考察抗生素暴露、益生菌补充、饮食干预及粪便微生物群移植（FMT）对肠道微生物组的调节及其与临床结局的关系。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"research_scope\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::642fafab4bece23f70645f6d\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"work_summary\"\n          ],\n          \"value\": \"这是一篇系统综述，旨在评估肠道微生物组调节对mRCC患者全身治疗疗效影响的临床证据。研究遵循PRISMA指南，检索了截至2025年1月的PubMed、Web of Science和Scopus数据库。共纳入6项研究（总N=4738），包括3项回顾性队列研究和3项前瞻性随机对照试验（含一项仅摘要的II期RCT）。研究发现，围ICI治疗期的抗生素使用显著降低客观缓解率（ORR）、无进展生存期（PFS）和总生存期（OS）；而益生菌（如动物双歧杆菌）在VEGF-TKI治疗中可实现定植并富集有益菌属；来自ICI反应者的FMT联合pembrolizumab + axitinib显示出改善PFS和ORR的趋势。文章指出当前证据受限于回顾性设计、小样本和方法学异质性，呼吁开展标准化、生物标志物驱动的前瞻性RCT。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"work_summary\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::6865e04b586a5c3add0ebc0b\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"broader_review_uses\"\n          ],\n          \"value\": {\n            \"material\": \"mRCC患者基线特征、治疗背景（VEGF-TKI与ICI联用趋势）、抗生素使用的临床普遍性及其对免疫治疗的干扰。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::1e9d144e90536397445ae3cb\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"broader_review_uses\"\n          ],\n          \"value\": {\n            \"material\": \"各类干预措施的定义、实施时机（如ICI开始前/后窗口期）、安全性数据（FMT无增加≥3级毒性）。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::5af0683da0e8542be49997c0\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"broader_review_uses\"\n          ],\n          \"value\": {\n            \"material\": \"对现有研究局限性的总结：回顾性设计、小样本、方法学异质性、未控制的混杂因素（PPI、类固醇、饮食）。\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"broader_review_uses\",\n                \"2\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::4ba7a468e5cc9bd8f1d98e49\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"facet_contributions\"\n          ],\n          \"value\": {\n            \"boundaries\": \"证据主要来自mRCC，外推至其他实体瘤需谨慎；抗生素效应的证据多为回顾性，存在混杂；益生菌/FMT的证据来自小样本或摘要，尚需大规模验证。\",\n            \"contribution\": \"提供了肠道微生物组状态（特别是抗生素暴露导致的失调）与ICI疗效之间的强临床关联证据。具体显示围ICI期的抗生素使用显著降低ORR、PFS和OS。同时提供了FMT和益生菌在mRCC中改善PFS和ORR的初步临床试验数据。\",\n            \"facet_id\": \"F1\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"facet_contributions\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::34eae2b42189c49679e5f36c\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"facet_contributions\"\n          ],\n          \"value\": {\n            \"boundaries\": \"机制部分大量引用临床前模型（小鼠FMT恢复敏感性），临床直接证据有限；不同研究中富集的菌属和通路不一致（如CBM588未改变双歧杆菌丰度但改善了疗效），提示机制复杂性。\",\n            \"contribution\": \"提供了微生物组介导ICI疗效的部分机制线索。提及共生菌（如A. muciniphila, B. fragilis）通过树突状细胞激活和CD8+ T细胞浸润增强ICI疗效；抗生素通过耗竭SCFA产生菌、促进病原生物扩张导致耐受性免疫微环境。还提到益生菌可能通过维生素K2合成通路和富集Ruminococcaceae发挥免疫调节作用。\",\n            \"facet_id\": \"F2\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"facet_contributions\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::4bcc98caeb15f7e1bb6dd797\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"该综述聚焦于mRCC，虽然机制具有普适性潜力，但临床结果不能直接外推至所有实体瘤。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::f83a4407259ef2d37b3555fb\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"抗生素对ICI疗效的负面影响证据主要来自回顾性队列，可能存在未测量的混杂因素（如感染严重程度本身影响预后）。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::2a012c725b412df699f0d322\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"益生菌和FMT的正面效果来自小样本RCT或会议摘要，统计效力不足，不能作为确证性证据，仅提示信号。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"2\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::7b1d00f8fcd8ab1638f045a9\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"文中提到的机制（如Akkermansia的作用）多基于临床前模型或临床相关性，临床因果证据尚不充分。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"3\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::9cf23d9e0fcaca0878be814b\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"review_planning_B\",\n            \"scope_interpretation_cautions\"\n          ],\n          \"value\": \"不同研究中使用的益生菌菌株、FMT供体筛选标准、测序分析方法差异巨大，直接比较需谨慎。\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"review_planning_B\",\n                \"scope_interpretation_cautions\",\n                \"4\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::788b9a81bbab3067c4100631\",\n          \"source_handle\": \"P0090\",\n          \"field_path\": [\n            \"card_material\"\n          ],\n          \"value\": {\n            \"material_scope\": \"fulltext\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n              \"field_path\": [\n                \"card_material\"\n              ]\n            }\n          ]\n        }\n      ],\n      \"scientific_records\": [\n        {\n          \"record_id\": \"record::8b10bf15f5c5bded90fc255019d5ae523cc5976d124d8655cb8ab8283fc86e8b\",\n          \"source_handle\": \"P0090\",\n          \"atom_ids\": [\n            \"atom::8e8145e70a7d1810760361df\",\n            \"atom::98e4d7145d8aa32053893296\",\n            \"atom::46d68237e826a20ae646f40e\",\n            \"atom::bb6258bf28f71234e7b1005d\",\n            \"atom::6a3d928b5a7bb7e7256aa430\",\n            \"atom::9dd8c9da2bda33ccfed831a4\",\n            \"atom::4f13d094ffea1dd368bb1748\",\n            \"atom::a6c7883bc90d2043e3b56081\",\n            \"atom::501f38d3cca7db07bd78d991\",\n            \"atom::ced0c1c26f04b05aed3ae8ef\",\n            \"atom::0e7aba6b220c2a791e43fff0\",\n            \"atom::642fafab4bece23f70645f6d\",\n            \"atom::6865e04b586a5c3add0ebc0b\",\n            \"atom::1e9d144e90536397445ae3cb\",\n            \"atom::5af0683da0e8542be49997c0\",\n            \"atom::4ba7a468e5cc9bd8f1d98e49\",\n            \"atom::34eae2b42189c49679e5f36c\",\n            \"atom::4bcc98caeb15f7e1bb6dd797\",\n            \"atom::f83a4407259ef2d37b3555fb\",\n            \"atom::2a012c725b412df699f0d322\",\n            \"atom::7b1d00f8fcd8ab1638f045a9\",\n            \"atom::9cf23d9e0fcaca0878be814b\",\n            \"atom::788b9a81bbab3067c4100631\"\n          ]\n        }\n      ],\n      \"review_source_handles\": [],\n      \"packet_sha256\": \"61b6da7d1e3b9c17c49f8872fbbe5a28d36eb87df77caceb68fcf6cd93ac763a\",\n      \"need_ids\": [\n        \"N1\"\n      ],\n      \"questions\": [\n        \"Inspect original guide against linked intact evidence.\"\n      ],\n      \"reread_reasons\": [\n        null\n      ]\n    },\n    {\n      \"packet_kind\": \"source\",\n      \"source_handle\": \"P0284\",\n      \"source_identity\": {\n        \"source_handle\": \"P0284\",\n        \"source_id\": \"source::P0284\",\n        \"aliases\": [],\n        \"title\": \"Metagenomics and culturomics reveal the dual role of the gut microbiome in the development of immune-related toxicities and the efficacy of immune checkpoint inhibitors in cancer\",\n        \"doi\": \"10.1186/s40168-026-02419-4\",\n        \"paper_id\": \"7cdc8a62c7a781f0b9a88abe52934ab9b889134d\",\n        \"year\": \"2026\",\n        \"canonical_paper_id\": null\n      },\n      \"evidence_atoms\": [\n        {\n          \"atom_id\": \"atom::2620179246640ac636d56bd9\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"material_depth\"\n          ],\n          \"value\": \"fulltext\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"material_depth\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"material_depth\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::b79fd70d6332212f4813f1df\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"material_status\"\n          ],\n          \"value\": \"resolved\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"material_status\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"material_status\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::14e691e33244b8717f4d127f\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"approach\"\n          ],\n          \"value\": \"The research design involves three main components: 1) Clinical Cohort Analysis: Retrospective and prospective analysis of three independent cohorts (melanoma and NSCLC) to assess the association between irAE grades and survival outcomes, correcting for immortal time bias. 2) Microbiome Profiling: Shotgun metagenomics and high-throughput culturomics were performed on fecal samples from patients at baseline and at the onset of ir-colitis to characterize taxonomic shifts and isolate viable bacteria. 3) Functional Validation: Fecal microbiota transplantation (FMT) from ir-colitis patients into antibiotic-treated mice to assess effects on tumor growth and inflammation. Specific isolates (P. bifermentans, C. paraputrificum, P. sordellii) were tested in vitro (Caco-2 co-culture for barrier integrity and cytokine expression) and in vivo (oral gavage in DSS colitis and MCA-205 tumor models) to determine direct effects. Cell-free supernatants and heat-killed bacteria were also tested to distinguish live-bacteria-dependent effects from metabolite-mediated effects.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"approach\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"approach\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::7338e32444ea409cd35d5626\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"contribution_and_limits\"\n          ],\n          \"value\": {\n            \"contribution\": \"Provides empirical evidence linking specific gut bacteria (P. bifermentans) to both irAE pathogenesis and enhanced ICI efficacy through distinct mechanisms (barrier disruption vs. metabolite secretion).\",\n            \"limits\": \"The exact nature of the active < 3 kDa metabolite and its precise immune mechanism remain unidentified. The study relies on a limited number of matched longitudinal samples and mouse models that may not fully recapitulate human ir-colitis complexity.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"contribution_and_limits\",\n                \"0\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"contribution_and_limits\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::ad228a9a09cf1bde833cd70d\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"Three independent cohorts of melanoma and NSCLC patients treated with ICI\",\n            \"finding\": \"Grade ≥ 2 irAEs are associated with significantly longer overall survival and progression-free survival, even after adjusting for immortal time bias.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"0\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"0\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::f0f8a256e3b6de3f1f5a7dfd\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"Baseline stool samples from melanoma patients analyzed via shotgun metagenomics\",\n            \"finding\": \"Patients developing grade ≥ 2 irAEs exhibited lower alpha diversity and enrichment of pro-inflammatory taxa including Ruminococcus gnavus and Streptococcus vestibularis compared to those without irAEs.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"1\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"1\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::69d42911848667bdf02843e3\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"Stool samples from patients with ir-colitis analyzed via culturomics\",\n            \"finding\": \"Paraclostridium bifermentans was isolated and found to be enriched in patients with acute ir-colitis compared to baseline or non-ir-colitis controls.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"2\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"2\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::4d3393b35296f0c4133f8239\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"In vivo mouse models receiving FMT from ir-colitis patients\",\n            \"finding\": \"FMT induced surrogate markers of intestinal inflammation (increased Lcn-2 and LPS) and enhanced the anti-tumor efficacy of dual anti-PD-1/CTLA-4 therapy.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"3\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"3\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::e7e6394717aa4609a837b993\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"In vitro Caco-2 monolayer co-culture with P. bifermentans\",\n            \"finding\": \"Live P. bifermentans disrupted epithelial barrier integrity (reduced ZO-1 and Occludin signals) and increased pro-inflammatory cytokines (TNF-α and IL-1β); this effect was not observed with cell-free supernatant.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"4\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"4\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::bd05dd22bf395b6bb6a493e0\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"key_findings\"\n          ],\n          \"value\": {\n            \"conditions\": \"In vivo murine tumor model with oral gavage of P. bifermentans derivatives\",\n            \"finding\": \"Oral administration of P. bifermentans enhanced anti-tumor response to dual ICI; this beneficial effect was retained by cell-free supernatant filtered to < 3 kDa, indicating mediation by a small-molecule metabolite rather than live bacteria.\"\n          },\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"5\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"key_findings\",\n                \"5\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::894d9adbbc30a71c986943d3\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"paper_kind\"\n          ],\n          \"value\": \"empirical\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"paper_kind\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"paper_kind\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::de73fe9ade530a582fbcc4a4\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"problem_or_question\"\n          ],\n          \"value\": \"The study aims to resolve the mechanism underlying the observed correlation between irAEs and improved ICI efficacy. Specifically, it seeks to determine if specific gut microbial signatures predict irAEs and efficacy, and to identify causal bacterial agents that might drive both inflammation and anti-tumor responses.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"problem_or_question\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"problem_or_question\"\n              ]\n            }\n          ]\n        },\n        {\n          \"atom_id\": \"atom::70fc3918076487e962a70529\",\n          \"source_handle\": \"P0284\",\n          \"field_path\": [\n            \"study_summary_A\",\n            \"research_scope\"\n          ],\n          \"value\": \"The study focuses on patients with advanced melanoma and non-small cell lung cancer (NSCLC) treated with immune checkpoint inhibitors (ICI). It investigates the relationship between gut microbiome composition, the development of immune-related adverse events (irAEs), and clinical outcomes (overall survival and progression-free survival). The research combines clinical cohort analysis with shotgun metagenomics and culturomics to identify specific bacterial taxa and their functional roles.\",\n          \"role\": \"evidence\",\n          \"origins\": [\n            {\n              \"record_id\": \"record::c66fbeaa280c108e014af7cc09f0b2e5689f094a55d8a7f2b398b693ae815e7a\",\n              \"field_path\": [\n                \"study_summary_A\",\n                \"research_scope\"\n              ]\n            },\n            {\n              \"record_id\": \"record::384337303cf1d585cd3ac32afaeb624f5aebb4f4c45b3d47c5eee039228c9cc0\",\n              \"field_path\": [\n          