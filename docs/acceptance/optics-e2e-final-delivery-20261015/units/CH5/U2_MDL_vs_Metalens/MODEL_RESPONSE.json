        },
        {
          "paragraph_id": "U2_MDL_vs_Metalens_P03",
          "point": "制造工艺约束决定技术路线适用性。",
          "development": "对比指出，超透镜的高深宽比与纳米级特征导致电子束光刻耗时、拼接困难；MDL 的低纵横比 (<5:1) 支持卷对卷压印或步进光刻大面积复制。红外波段聚合物 MDL(10μm 厚) 实验证明轻量化潜力，硅基模拟效率可提至>71%。研究对象为长波红外 (LWIR) 成像系统，设置条件为聚合物/硅材料与商用传感器集成。聚合物吸收致效率损失 (~25%)；硅基高效方案未实物验证；大规模良率数据缺失。",
          "source_uses": [
            {
              "source_handle": "P0224",
              "role": "例证",
              "use": "提供长波红外波段聚合物 MDL 的轻量化潜力与效率数据。"
            },
            {
              "source_handle": "P0192",
              "role": "背景",
              "use": "论述大面积器件的物理约束与半导体光刻工艺制造基准，支撑制造可行性分析。"
            },
            {
              "source_handle": "P0083",
              "role": "背景",
              "use": "报告亚 20nm 纳米结构复制的工艺极限数据，说明制造精度对光学性能上限的基础限制，支撑工艺约束决定技术路线适用性的论述。"
            }
          ],
