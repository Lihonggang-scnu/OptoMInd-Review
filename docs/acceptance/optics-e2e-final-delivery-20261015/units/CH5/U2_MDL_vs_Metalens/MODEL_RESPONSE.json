    "duty_parameters": {
      "unit_focus": "在宽带消色差成像中，MDL 凭借标量逆优化与低纵横比结构，在效率、制造可行性及成本上综合优于亚波长超透镜。仿真与实验数据表明，MDL 可在高 NA 宽带下维持>70% 效率，且特征尺寸远大于超透镜，规避了纳米制造的严苛公差。",
      "paragraph_tasks": [
        {
          "paragraph_id": "U2_MDL_vs_Metalens_P01",
          "point": "仿真条件下的效率与带宽对比基准。",
          "development": "FDTD 仿真显示，匹配焦距/NA/波长的 MDL 在窄带 (NA=0.97) 效率>87%，宽带 (NA=0.81) 效率>70%，均优于同期代表性金属透镜。MDL 使用聚合物 (S1813)，特征宽度微米级；金属透镜需高折射率材料且特征<100nm。研究对象为平板光学成像系统，设置条件为非偏振输入与匹配光学规格。效率比较基于选定文献案例与理想仿真，非统一实验数据集；基底厚度主导系统总厚度的论点削弱了超透镜超薄优势的实际意义。",
          "source_uses": [
            {
              "source_handle": "P0187",
              "role": "主论据",
              "use": "提供 MDL 与金属透镜在仿真条件下的效率与带宽对比基准，论证 MDL 的制造与性能优势。"
            }
          ],
          "carried_over": true,
