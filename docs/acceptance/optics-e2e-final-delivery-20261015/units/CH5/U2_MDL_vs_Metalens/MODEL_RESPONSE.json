        },
        {
          "paragraph_id": "U2_MDL_vs_Metalens_P02",
          "point": "实验验证的宽带衍射透镜性能与工艺优势。",
          "development": "灰度光刻制备的连续可见光超消色差圆柱透镜 (NA=0.013) 实测平均效率~25%，对偏振不敏感且高度误差容忍度高 (~100nm)。大口径 MDL(NA=0.3, 直径>3mm) 实现 0.45-1.0μm 宽带消色差，特征尺寸~0.25μm，远低于超透镜要求。研究对象为可见光波段平面透镜，设置条件为正性光刻胶/玻璃基底。低 NA 下效率受限；高 NA(0.9) 结果仅为仿真；效率定义依赖特定孔径积分区域。",
          "source_uses": [
            {
              "source_handle": "P0225",
              "role": "例证",
              "use": "提供灰度光刻制备的连续可见光超消色差圆柱透镜的实测效率与工艺容差数据。"
            },
            {
              "source_handle": "P0237",
              "role": "例证",
              "use": "展示大口径 MDL 实现宽带消色差及特征尺寸优势的实验证据。"
            },
            {
              "source_handle": "P0086",
              "role": "例证",
              "use": "展示双串联平面衍射透镜实现全彩视频成像的实验证据，作为传统衍射方案在低成本相机架构中工程落地的对比基线。"
            }
          ],
          "carried_over": true,
          "point_changed_from_brief": false,
          "source_briefs": [
            "U2_MDL_vs_Metalens_P02"
          ],
          "source_brief_details": [
            {
              "paragraph_id": "U2_MDL_vs_Metalens_P02",
              "unit_id": "U2_MDL_vs_Metalens",
              "ordinal": 2,
              "point": "实验验证的宽带衍射透镜性能与工艺优势。",
              "development": "灰度光刻制备的连续可见光超消色差圆柱透镜 (NA=0.013) 实测平均效率~25%，对偏振不敏感且高度误差容忍度高 (~100nm)。大口径 MDL(NA=0.3, 直径>3mm) 实现 0.45-1.0μm 宽带消色差，特征尺寸~0.25μm，远低于超透镜要求。研究对象为可见光波段平面透镜，设置条件为正性光刻胶/玻璃基底。低 NA 下效率受限；高 NA(0.9) 结果仅为仿真；效率定义依赖特定孔径积分区域。",
              "source_handles": [
                "P0225",
