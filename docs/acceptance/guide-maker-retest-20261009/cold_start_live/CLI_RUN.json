  "complete": true,
  "guide": {
    "schema_version": "optomind.guided_body_guide.v1",
    "manuscript_guide": "全篇写作需严格遵循‘观察性关联≠因果机制≠临床干预’的证据分级原则。Ch1 确立临床关联的‘存在但异质’基调，Ch2-Ch3 解析生物学合理性但明确模型局限，Ch4 量化外部干扰，Ch5-Ch6 评估干预获益与风险，Ch7 回归方法学标准化。对于跨章复用材料（如 FMT-LUMINate 试验 P0583、抗生素 Meta 分析 P0081），须指定主述章节：P0583 的试验设计与主要疗效终点在 Ch5 详述，Ch1 仅提‘概念验证存在’，Ch2/Ch3/Ch6 分别引用其免疫、代谢、毒性子数据；P0081 的效应量在 Ch4 详述，Ch1 仅作为混杂因素提及。避免在各章重复同一来源的完整结论，后章引用时应侧重‘新增维度’（如 Ch6 引用 Ch5 已述试验时，聚焦毒性而非疗效）。全篇语气需保持批判性，特别是在人类 TME 代谢物浓度缺失（Ch3）、非结肠炎 irAEs 样本量不足（Ch6）及 III 期 RCT 空白（Ch5/Ch7）处，不得用动物数据填补人类证据缺口。",
    "chapters": [
      {
        "chapter_id": "Ch1",
        "title": "实体瘤中肠道微生物组与 ICI 疗效的临床关联证据",
        "writing_arrangement": "本章按‘关联确立→异质性解析→干扰因素→动态演变→证据阶梯’逻辑推进。首节（U1）先展示黑色素瘤/NSCLC 中的阳性信号，随即用跨队列荟萃分析（P0478）否定‘通用标志物’假设，避免读者产生过度期望。次节（U2）将抗生素/PPI 定义为关键修饰变量，引用 Meta 分析量化效应，但注明指示偏倚风险，为 Ch4 深入讨论留接口。第三节（U3）强调纵向采样优于基线，引用 FMT-LUMINate 的‘有害菌清除’现象作为动态证据，但不展开干预细节（留待 Ch5）。末节（U4）总结证据阶梯，明确 Phase III 空白，用表格对比主要干预试验（FMT vs 益生菌），自然过渡至 Ch2 的机制解析。",
        "required_content": [
          "必须包含表格 U4_证据阶梯与转化边界_T01，对比 FMT-LUMINate、MITRIC、MIMic 等试验的设计、人群及疗效结果。",
          "在 U1_跨癌种关联图谱_P02 中，必须引用 P0478 的 PERMANOVA 数据说明‘队列’是最大变异来源。",
          "在 U4_证据阶梯与转化边界_P03 中，必须明确声明‘目前缺乏 Phase III RCT 证据’，不得模糊表述。"
        ]
      },
      {
        "chapter_id": "Ch2",
        "title": "微生物调节 ICI 疗效的免疫学机制",
        "writing_arrangement": "本章按‘先天识别→适应性启动→屏障/髓系重塑→肿瘤特异性’链条组织。每节须严格区分‘动物因果’与‘人类关联’：例如 U01 中 LPS 酰化状态（P0080）在小鼠是因果，在人类是宏基因组关联，不得混同。U02 重点阐述分子模拟假说，但注明人类 T 细胞交叉反应证据多为体外或预测。U03 将屏障完整性定义为‘条件闸门’，引用肠芯片（P0073）与细菌易位（P0166）数据，强调易位是主动转运而非被动漏肠。末节（U04）对比不同癌种机制差异（如黑色素瘤重 T 细胞，NSCLC 重代谢），并列表总结，为 Ch3 代谢物专论铺垫。",
        "required_content": [
          "在 Ch2_U01_P01 中，必须对比六酰化与五酰化 LPS 的不同免疫效应，并标注人类证据仅为关联。",
          "在 Ch2_U04 中，必须包含表格 Ch2_U04_T01，比较不同肿瘤类型的机制特征与证据等级。",
          "全章不得将小鼠敲除实验结论直接外推为人类临床机制，每段机制描述后需附加‘人类验证状态’说明。"
        ]
      },
      {
        "chapter_id": "Ch3",
        "title": "微生物代谢物的中介作用与分子机制",
        "writing_arrangement": "本章按代谢物类别（SCFAs→肌苷→胆汁酸/色氨酸→功能整合）分节。每节遵循‘分子靶点→免疫效应→临床证据→浓度局限’结构。重点突出‘情境依赖性’：如 U3_1 中 SCFAs 在 PD-1 与 CTLA-4 背景下的双向作用。U3_2 肌苷部分须强调‘肿瘤微环境（TME）浓度数据缺失’这一关键缺口，引用 P0582 说明仅有血浆数据。U3_5 专门讨论方法学局限，指出血浆/粪便浓度不能代表 TME 暴露，呼吁空间代谢组学，为 Ch7 方法学讨论埋点。",
        "required_content": [
          "在 U3_2_P04 中，必须明确标注‘人体 TME 内肌苷绝对浓度数据缺失’，不得用体外有效浓度替代。",
          "在 U3_1_P03 中，必须区分 SCFAs 在抗 PD-1 与抗 CTLA-4 治疗中的不同效应方向。",
          "在 U3_5 中，必须提出‘局部浓度 - 受体占有率 - 临床结局’的定量映射缺失问题。"
        ]
      },
      {
        "chapter_id": "Ch4",
        "title": "外部因素对微生物 - 免疫轴的干扰",
        "writing_arrangement": "本章按‘药物暴露（抗生素/PPI）→饮食/生活方式’顺序。U01 抗生素部分须严格按时间窗口（ICI 前后 30-90 天）分层，引用 P0575 区分术前/术后暴露风险，并讨论 HCC 等特定癌种的阴性结果（P0275）以展示异质性。U02 PPI 部分强调‘口腔细菌易位’机制，并对比 H2B 的安全性差异。U03 饮食部分区分‘高纤维/特定营养素’与‘商业益生菌’，引用 P0390 指出非标准化益生菌的潜在风险。全章结论需回归‘微生物组可塑性与脆弱性’，为 Ch5 主动干预提供现实背景。",
        "required_content": [
          "在 Ch4_U01_P01 中，必须引用 P0575 数据界定 ICI 启动前后 30-90 天为高危窗口。",
          "在 Ch4_U02_P03 中，必须对比 PPI 与 H2B 的毒性信号差异，提供临床用药建议。",
          "在 Ch4_U03_P02 中，必须引用 P0390 指出非标准化益生菌补充可能导致抗 PD-1 反应受损。"
        ]
      },
      {
        "chapter_id": "Ch5",
        "title": "微生物干预策略的临床转化现状",
        "writing_arrangement": "本章是干预证据的核心，按‘初治人群增效（FMT-LUMINate/MIMic）→难治人群逆转（MITRIC）→定义菌株（LBP/益生菌）→安全性→证据缺口’推进。U01 重点报告初治队列 ORR 信号，但注明单臂设计局限。U02 对比 MITRIC 阴性结果，解析‘定植短暂’与‘髓系微环境固化’原因。U03 评估 LBP 标准化优势但承认疗效信号多为探索性。U04 专门讨论毒性（如 Prevotella 相关心肌炎），强调 ICI 方案（单药 vs 双药）的交互作用。U05 总结缺乏 III 期 RCT，提出标准化路径。",
        "required_content": [
          "在 Ch5_U01_P01 中，必须报告 FMT-LUMINate 与 MIMic 试验的具体 ORR 与生存数据。",
          "在 Ch5_U04_P01 中，必须对比 NSCLC 单药与黑色素瘤双药背景下的毒性发生率差异。",
          "在 Ch5_U05_P01 中，必须确认‘尚无已完成的大型随机对照 III 期临床试验’，不得模糊表述。"
        ]
      },
      {
        "chapter_id": "Ch6",
        "title": "微生物组与免疫治疗毒性的关联",
        "writing_arrangement": "本章按‘特定毒性关联（结肠炎 vs 非结肠炎）→疗效 - 毒性耦合/解耦→干预安全性→分子机制’组织。U01 强调结肠炎证据最强，非结肠炎（心肌炎等）受限于样本量。U02 讨论‘双刃剑’效应（如 Akkermansia 既增效又增毒），并引入‘无毒性响应’的解耦路径。U03 复用 Ch5 干预试验数据，但聚焦供体特征（Cluster B/Prevotella）与毒性关联。U04 解析屏障受损、代谢物及分子模拟机制。全章需明确‘非结肠炎 irAEs 证据不足’的边界。",
        "required_content": [
          "必须包含表格 Ch6_U3_T01，比较 FMT 供体聚类特征与 ICI 方案交互下的毒性风险。",
          "在 Ch6_U1_P03 中，必须指出非结肠炎 irAEs（如心肌炎）的微生物组证据受限于样本量。",
          "在 Ch6_U2_P01 中，必须引用 P0260 说明 Akkermansia 与 OS 正相关但增加 irAEs 风险的观察性关联。"
        ]
      },
      {
        "chapter_id": "Ch7",
        "title": "方法学挑战与未来研究方向",
        "writing_arrangement": "本章按‘技术变异→因果推断局限→证据等级缺口→未来范式’推进。U01 详述测序平台与生信流程导致的跨队列不可复现，引用标准化重分析案例（P0354）。U02 讨论观察性研究的混杂偏倚及动物模型外推风险。U03 盘点 III 期 RCT 缺席及特定人群（老年/儿科）数据匮乏。U04 提出功能导向（代谢通路/基因水平）、AI 整合及类器官模型等未来方向。结尾需呼应 Ch1 的证据阶梯，强调从‘描述性关联’向‘精准临床转化’跨越的必要性。",
        "required_content": [
          "在 Ch7_U01_P03 中，必须引用 P0354 说明控制方法学变量后信号可重复性提升。",
          "在 Ch7_U03_P01 中，必须汇总 I/II 期概念验证结果并明确指出缺乏大型 RCT 支持。",
          "在 Ch7_U04_P01 中，必须论证功能导向与基因水平分析优于单纯分类学分析的方法学必然性。"
        ]
      }
    ]
  },
