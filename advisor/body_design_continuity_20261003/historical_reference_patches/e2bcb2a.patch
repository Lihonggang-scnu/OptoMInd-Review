+def _reuse_cached_owner_revision(
+    cached: Mapping[str, Any],
+    revision_payload: Mapping[str, Any],
+) -> dict[str, Any] | None:
+    """Reclassify a same-input owner cache before deciding to call again."""
+
+    if cached.get("cache_inputs") != revision_payload:
+        return None
+    response = cached.get("response")
+    if isinstance(response, Mapping):
+        owner_status, updated_plan, unit_id_remap, structural_errors = _classify_owner_response(
+            revision_payload.get("chapter_plan") or {},
+            response,
+            revision_payload.get("source_materials") or [],
+            candidate_materials=revision_payload.get("candidate_materials") or [],
+        )
+        if owner_status in {"updated", "no_change"}:
+            repaired = dict(cached)
+            repaired.update({
+                "status": "complete",
+                "owner_status": owner_status,
+                "updated_plan": updated_plan,
+                "unit_id_remap": unit_id_remap,
+                "structural_errors": structural_errors,
+            })
+            return repaired
+        return None
+    if cached.get("status") == "complete" and cached.get("owner_status") in {"updated", "no_change"}:
+        return dict(cached)
+    return None
+
