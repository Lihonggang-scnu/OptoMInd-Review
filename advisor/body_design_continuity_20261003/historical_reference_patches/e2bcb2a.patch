+    @classmethod
+    def _promote_owner_candidate_materials(
+        cls,
+        chapters: Sequence[Mapping[str, Any]],
+        improvement: Mapping[str, Any],
+    ) -> list[dict[str, Any]]:
+        """Carry adopted candidate material into the writer-facing packet."""
+
+        accepted: dict[str, Mapping[str, Any]] = {}
+        for item in improvement.get("chapter_updates") or ():
+            if not isinstance(item, Mapping) or item.get("_complete_chapter_revision") is not True:
+                continue
+            chapter_id = _text(item.get("chapter_id"))
+            plan = cls._improvement_plan(item)
+            if chapter_id and isinstance(plan, Mapping):
+                accepted[chapter_id] = plan
+        if not accepted:
+            return [dict(row) for row in chapters]
+
+        material_keys = (
+            "study_summary_A", "review_planning_B", "deep_read_material",
+            "local_passages", "supplement_gap_material", "supplement_gap_materials",
+            "supplement_material", "supplement_materials", "tool_supplement_materials",
+        )
+        output: list[dict[str, Any]] = []
+        for raw in chapters:
+            packet = dict(raw)
+            chapter = _copy_json_value(packet.get("chapter")) if isinstance(packet.get("chapter"), Mapping) else {}
+            chapter_id = _text(chapter.get("chapter_id"))
+            plan = accepted.get(chapter_id)
+            if plan is None:
+                output.append(packet)
+                continue
+            handles, paper_ids = _source_keys_in_value(plan)
+            candidates = [
+                item for item in (packet.get("candidate_materials") or ())
+                if isinstance(item, Mapping)
+                and _text(item.get("source_handle"))
+                and any(item.get(key) not in (None, "", [], {}) for key in material_keys)
+            ]
+            additions = []
+            for item in candidates:
+                handle = _text(item.get("source_handle"))
+                paper_id = _text(item.get("paper_id"))
+                if handle in handles or paper_id in paper_ids:
+                    additions.append(dict(item))
+            if additions:
+                existing = [
+                    dict(item) for item in (packet.get("source_materials") or ())
+                    if isinstance(item, Mapping)
+                ]
+                existing_handles = {
+                    _text(item.get("source_handle")) for item in existing if _text(item.get("source_handle"))
+                }
+                for item in additions:
+                    handle = _text(item.get("source_handle"))
+                    if handle not in existing_handles:
+                        existing.append(item)
+                        existing_handles.add(handle)
+                    chapter.setdefault("source_handles", []).append(handle)
+                    paper_id = _text(item.get("paper_id"))
+                    if paper_id:
+                        chapter.setdefault("source_ids", []).append(paper_id)
+                    identity_map = dict(packet.get("source_identity_map") or {})
+                    identity_map[handle] = {
+                        key: item.get(key) for key in ("source_handle", "paper_id", "title", "doi", "year")
+                    }
+                    packet["source_identity_map"] = identity_map
+                packet["source_materials"] = existing
+                chapter["source_handles"] = list(dict.fromkeys(
+                    _text(value) for value in (chapter.get("source_handles") or ()) if _text(value)
+                ))
+                chapter["source_ids"] = list(dict.fromkeys(
+                    _text(value) for value in (chapter.get("source_ids") or ()) if _text(value)
+                ))
+                packet["chapter"] = chapter
+            output.append(packet)
+        return output
+
     @classmethod
     def _apply_improvements(cls, chapters: Sequence[Mapping[str, Any]], improvement: Mapping[str, Any]) -> list[dict[str, Any]]:
         """Apply only concrete whole-plan edits targeted to a known chapter."""
