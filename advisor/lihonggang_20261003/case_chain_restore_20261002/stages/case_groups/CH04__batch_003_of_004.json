          "source_handle": "P0402"
        },
        {
          "contribution": "提供大样本真实世界多药联用数据，量化基线与围治疗期合并用药对ICI客观缓解率及生存的独立负面预测价值。",
          "source_handle": "P0489"
        },
        {
          "contribution": "通过ICI与TKI双队列对比，细化口服给药途径与治疗即刻暴露对mRCC生存期的差异化影响，排除单纯疾病严重度偏倚。",
          "source_handle": "P0418"
        }
      ],
      "unit_key": "CH04:2"
    },
    {
      "studies": [
        {
          "contribution": "构建多界微生物组（细菌/真菌/古菌/病毒）共现网络模型，证明生态稳定性与特定属组合优于单一分类学特征预测ICI疗效。",
          "source_handle": "P0393"
        },
        {
          "contribution": "提出功能性菌群失调评分，以MEP与核黄素合成通路动态变化替代静态物种阈值，解释跨癌种响应异质性的代谢基础。",
          "source_handle": "P0444"
        },
        {
          "contribution": "识别19种可重复分类标志物与140个功能基因组，提出“有益功能分散在不同菌种”假说，为从分类学向功能导向转型提供依据。",
          "source_handle": "P0496"
        }
      ],
      "unit_key": "CH04:3"
    },
