          "source_handle": "P0419"
        },
        {
          "contribution": "证实PD-L1高表达是抗生素削弱ICI疗效的关键修饰因子，阐明宿主生物标志物状态决定微生物扰动敏感性的交互机制。",
          "source_handle": "P0517"
        }
      ],
      "unit_key": "CH04:1"
