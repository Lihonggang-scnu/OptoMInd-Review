{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "提供早期NSCLC新辅助治疗中低基线多样性与高纵向稳定性预示良好病理缓解的证据，论证疾病阶段和治疗场景（新辅助vs晚期）对微生物组标志物预测效力的关键调节作用。",
          "source_handle": "P0569"
        },
        {
          "proposed_use": "基于III期RCT附属研究数据，展示特定产丁酸菌属在化疗-免疫联合方案中的预后价值及方案特异性效应，论证治疗方案分层是解释微生物组异质性的核心维度。",
          "source_handle": "P0585"
        }
      ],
      "unit_key": "CH04:1"
    },
    {
      "studies": [
        {
          "proposed_use": "提供ICI给药时间（昼夜节律）与生存结局相关的观察性证据，提示非微生物生理节律变量作为潜在混杂因素或效应修饰因子的重要性，需在设计中加以控制。",
          "source_handle": "P0558"
        },
        {
          "proposed_use": "综述抗生素暴露时间窗（特别是ICI启动前30天）对疗效的负面影响，并指出不同肿瘤类型（如HCC vs 黑色素瘤）中效应的异质性，强化暴露窗口特异性的临床证据基础。",
          "source_handle": "P0576"
        }
      ],
      "unit_key": "CH04:2"
    },
    {
      "studies": [
        {
          "proposed_use": "阐述拟杆菌等菌属在不同癌种和ICI靶点下的双重角色（如CTLA-4有益而PD-1有害），论证单一物种丰度难以捕捉生态拓扑结构，支持从分类学向功能网络分析的范式转变。",
          "source_handle": "P0560"
        },
        {
          "proposed_use": "系统梳理SCFAs、色氨酸及胆汁酸代谢物通过特定受体（AhR, GPRs）调节免疫细胞表型的分子机制，为多维失调定义提供具体的代谢功能通路支撑。",
          "source_handle": "P0588"
        }
      ],
      "unit_key": "CH04:3"
    },
    {
      "studies": [
        {
          "proposed_use": "综述微生物代谢物调节ICI疗效与毒性的机制及干预挑战，强调缺乏标准化大型RCT验证的现状，支持建立ONCOBIOME等标准化倡议和方法学规范的必要性。",
          "source_handle": "P0584"
        },
        {
          "proposed_use": "分析宿主色氨酸代谢轴（IDO1/TDO2/AHR）介导的免疫抑制机制及临床试验失败教训，提供评估微生物代谢物研究的重要参照系，提示未来需采用严格的定量和分层策略。",
          "source_handle": "P0587"
        }
      ],
      "unit_key": "CH04:4"
    }
  ],
