{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "提供mCRPC队列中既往恩杂鲁胺治疗重塑基线菌群并改变Akkermansia预测方向的证据，论证治疗史对微生物标志物特异性的修饰作用。",
          "source_handle": "P0270"
        },
        {
          "proposed_use": "提供HCC队列中抗生素暴露未显著恶化ICI疗效的阴性结果，挑战“广谱抗生素普遍有害”的普适假设，提示宿主基础疾病可修饰互作效应。",
          "source_handle": "P0275"
        },
        {
          "proposed_use": "展示肝硬化背景下基线α/β多样性与ICI疗效无关联的实证，反驳“高多样性总预示获益”的观点，强调病理状态可能掩盖常规标志物信号。",
          "source_handle": "P0301"
        },
        {
          "proposed_use": "提供下呼吸道微生物组独立于肠道调节NSCLC疗效的证据，补充局部微环境代谢物招募CD8+ T细胞的机制视角，拓宽非肠道部位的作用维度。",
          "source_handle": "P0352"
        }
      ],
      "unit_key": "CH04:1"
    },
    {
      "studies": [
        {
          "proposed_use": "基于TriNetX超大规模真实世界数据证实PPI使用与NSCLC患者ICI治疗后5年生存率显著下降相关，补充药代/药效学外的临床终点信号。",
          "source_handle": "P0246"
        },
        {
          "proposed_use": "提供III/IV期黑色素瘤队列中近期抗生素暴露导致OS显著缩短及严重结肠炎风险升高的量化证据，强化长期暴露破坏微生态稳态的临床表型关联。",
          "source_handle": "P0310"
        },
        {
          "proposed_use": "通过荟萃分析确认仅在ICI前长期使用PPI才导致疗效受损，引入“使用时窗”作为关键调节变量，解释研究间异质性并支持时间累积失调假说。",
          "source_handle": "P0339"
        },
        {
          "proposed_use": "在妇科恶性肿瘤队列中量化抗生素使用时长（≥14天）与ICI总生存期缩短的关联，细化暴露窗口特异性，区分短期反应与长期生存获益的差异。",
          "source_handle": "P0360"
        }
      ],
      "unit_key": "CH04:2"
    },
    {
      "studies": [
        {
          "proposed_use": "提供纵向稳定性丧失作为ICI耐药性早期指标的证据，展示从静态丰度向动态群落波动分析的范式转变，支持机器学习提取时序特征的方法论价值。",
          "source_handle": "P0227"
        },
        {
          "proposed_use": "通过标准化重分析证实α-多样性并非稳定预测因子，开发优于文献汇编指数的复合指数，为多维失调定义提供方法学支撑。",
          "source_handle": "P0290"
        },
        {
          "proposed_use": "提出以SCFA为代表的微生物代谢组替代分类学特征作为预测因子的理论框架，揭示不同免疫检查点类型下代谢物效应的矛盾情境依赖性。",
          "source_handle": "P0326"
        },
        {
          "proposed_use": "构建“功能趋同”概念框架，解释跨队列分类学不一致但免疫通路相似的底层逻辑，推动生物标志物开发从物种列表向功能网络分析转型。",
          "source_handle": "P0364"
        }
      ],
      "unit_key": "CH04:3"
    },
    {
      "studies": [
        {
          "proposed_use": "提出整合多平台异构数据的“het set”分析框架，系统评估样本采集、测序技术及生物信息管道差异，为建立标准化监测协议提供方法论参考。",
          "source_handle": "P0264"
        },
        {
          "proposed_use": "阐述AI技术（NLP、LLM、ML）在处理iDDIs高维复杂性、时序建模与因果推断中的应用现状，探讨联邦学习在保护隐私下的标准化数据整合角色。",
          "source_handle": "P0286"
        },
        {
          "proposed_use": "将微生物组纳入“癌症暗物质”多组学整合概念，概述宏基因组、代谢组与AI融合解析TME复杂互作的技术路径，指明超越单一物种分析的未来方向。",
          "source_handle": "P0323"
        },
        {
          "proposed_use": "采用目标试验模拟（target trial emulation）与逆概率加权设计，展示如何缓解回顾性观察中的残余混杂与选择偏倚，为确立药物-微生物互作因果链提供严谨流行病学范例。",
          "source_handle": "P0340"
        }
      ],
      "unit_key": "CH04:4"
    }
  ],
