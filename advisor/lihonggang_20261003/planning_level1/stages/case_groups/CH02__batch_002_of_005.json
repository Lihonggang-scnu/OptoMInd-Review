{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "系统梳理SCFAs、石胆酸、肌苷等代谢物的矛盾功能，强调浓度依赖性与微环境上下文（如缺氧、营养竞争）对最终表型的决定性影响，为剂量阈值挑战提供综合框架。",
          "source_handle": "P0220"
        },
        {
          "proposed_use": "揭示细菌代谢物DAT通过宿主IFN-I信号通路协同ICI增强T细胞活化的具体路径，并展示其在抗生素诱导菌群失调模型中部分恢复疗效的因果证据，补充代谢补救策略。",
          "source_handle": "P0195"
        }
      ],
      "unit_key": "CH02:1"
    },
    {
      "studies": [
        {
          "proposed_use": "详述微生物衍生胆汁酸（3-oxo-LCA、isoalloLCA）通过抑制RORγt或促进NR4A1精细调节Th17/Treg平衡的分子机制，以及FXR/TGR5在巨噬细胞和ILC3s中的作用，类比其在肿瘤微环境中的潜在调控逻辑。",
          "source_handle": "P0180"
        },
        {
          "proposed_use": "聚焦HCC背景下的“肠-肝轴”，阐述菌群失调导致LPS易位引发慢性炎症及次级胆汁酸通过mTOR促进肿瘤发生的病理路径，补充特定器官微环境中胆汁酸超越屏障调控的直接抑制效应。",
          "source_handle": "P0216"
        }
      ],
      "unit_key": "CH02:2"
    },
    {
      "studies": [
        {
          "proposed_use": "证明肠道细菌外膜囊泡（OMVs）可作为抗原载体，通过分子模拟机制诱导交叉反应性CD8+ T细胞从肠道迁移至肿瘤部位，即使无活菌定植也能触发免疫监视，区分于代谢物介导机制。",
          "source_handle": "P0190"
        },
        {
          "proposed_use": "深入解析cdAMP-STING轴、SagA-NOD2轴及肌苷-A2AR轴的具体分子细节，对比生态方法（FMT）与还原论方法（工程菌、小分子）的优劣，为未来精准微生物疗法开发指明转化方向。",
          "source_handle": "P0251"
        }
      ],
      "unit_key": "CH02:3"
    }
  ],
