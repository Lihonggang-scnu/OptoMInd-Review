{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "补充化疗联合方案对微生物组-疗效关联的掩盖效应，论证治疗方案分层是解释标志物不一致的关键混杂维度。",
          "source_handle": "P0053"
        },
        {
          "proposed_use": "提供俄罗斯西北部队列的SIBA复合指数证据，说明地域饮食背景导致单一菌种普适性失效，需开发人群特异性预测模型。",
          "source_handle": "P0104"
        },
        {
          "proposed_use": "展示EGFR突变NSCLC亚型中特异性响应菌群（如Bradyrhizobium）与野生型的差异，论证分子分型对微生物组异质性的调节作用。",
          "source_handle": "P0205"
        }
      ],
      "unit_key": "CH04:1"
    },
    {
      "studies": [
        {
          "proposed_use": "在转移性尿路上皮癌真实世界队列中量化抗生素、PPI及二甲双胍在ICI前后60天时间窗内的差异化生存影响，细化暴露窗口特异性。",
          "source_handle": "P0035"
        },
        {
          "proposed_use": "提供抗生素使用时长（>10天 vs ≤10天）与OS显著缩短的剂量-反应证据，强化长期暴露破坏微生态稳态的临床表型关联。",
          "source_handle": "P0061"
        },
        {
          "proposed_use": "基于TriNetX超大规模真实世界数据，证实伴随PPI使用与多种实体瘤ICI治疗后死亡率及ICU入院率升高的强相关性，补充药代/药效学外的临床终点信号。",
          "source_handle": "P0185"
        }
      ],
      "unit_key": "CH04:2"
    },
    {
      "studies": [
        {
          "proposed_use": "引入宏基因组解析的“安娜·卡列尼娜原则”与对数比率生物标志物，论证生态系统稳定性优于单一分类群丰度，为多维失调定义提供理论支撑。",
          "source_handle": "P0002"
        },
        {
          "proposed_use": "通过SHAP可解释机器学习证明MetaCyc功能通路特征比分类学特征更能预测NSCLC患者ICI响应，支持从物种列表向代谢功能网络分析的范式转变。",
          "source_handle": "P0097"
        },
        {
          "proposed_use": "揭示肠型特异性（E1/E2）下Collinsella与Bacteroides等标志物的情境依赖性分布，说明群落拓扑结构决定单一物种预测效力的生物学逻辑。",
          "source_handle": "P0170"
        }
      ],
      "unit_key": "CH04:3"
    },
    {
      "studies": [
        {
          "proposed_use": "采用双向孟德尔随机化与中介分析框架，利用遗传工具变量克服观察性研究的反向因果与残留混杂，为微生物-癌症轴提供因果推断的方法学范例。",
          "source_handle": "P0059"
        },
        {
          "proposed_use": "综述AI驱动的多组学整合策略，阐述机器学习如何融合微生物组、转录组与影像组学构建复合预测模型，并讨论联邦学习与隐私保护在标准化中的角色。",
          "source_handle": "P0050"
        },
        {
          "proposed_use": "作为前瞻性多中心转化研究方案示例，展示爱尔兰队列如何通过标准化粪便采样时间点与16S测序流程探索GM多样性与新辅助pCR的关联，填补高质量纵向数据缺口。",
          "source_handle": "P0045"
        }
      ],
      "unit_key": "CH04:4"
    }
