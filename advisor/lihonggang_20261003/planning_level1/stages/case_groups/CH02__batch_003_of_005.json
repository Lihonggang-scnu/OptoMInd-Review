{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "系统梳理肌苷、SCFAs、色氨酸衍生物等代谢物通过表观遗传修饰与受体信号（mTOR, AhR）直接重编程CD8+ T细胞及巨噬细胞功能的分子细节，为代谢介导机制提供分类框架。",
          "source_handle": "P0282"
        },
        {
          "proposed_use": "对比不同免疫检查点类型下SCFA效应的矛盾结果，强调浓度依赖性与微环境上下文对最终表型的决定性影响，解释剂量阈值挑战。",
          "source_handle": "P0326"
        },
        {
          "proposed_use": "构建“微生物来源-介质-宿主受体-TME组分”的统一分析框架，阐明代谢物如何远程或局部编程免疫微环境，支撑代谢物效应的异质性讨论。",
          "source_handle": "P0391"
        }
      ],
      "unit_key": "CH02:1"
    },
    {
      "studies": [
        {
          "proposed_use": "详述慢性肝病背景下肠-肝轴失调如何通过LPS易位与胆汁酸代谢紊乱诱导肝脏免疫抑制微环境，补充特定器官微环境中胆汁酸超越屏障调控的直接抑制效应。",
          "source_handle": "P0293"
        },
        {
          "proposed_use": "聚焦HCC语境，阐述次级胆汁酸谱偏移如何通过FXR/TGR5信号通路重塑肿瘤微环境并干扰ICI疗效，提供肠-肝轴特异性机制背景。",
          "source_handle": "P0356"
        },
        {
          "proposed_use": "解析次级胆汁酸（如DCA, LCA）通过激活FXR/TGR5受体抑制CD8+ T细胞浸润与功能的分子路径，类比其在实体瘤中解除肠道驻留限制后的全身性免疫抑制逻辑。",
          "source_handle": "P0391"
        }
      ],
      "unit_key": "CH02:2"
    },
    {
      "studies": [
        {
          "proposed_use": "揭示SFB诱导的肠道Th17细胞迁移至肿瘤并转化为效应样细胞的因果机制，结合抗PD-1治疗模型说明分子模拟假说下的T细胞可塑性与交叉反应扩增路径。",
          "source_handle": "P0388"
        },
        {
          "proposed_use": "区分肿瘤内微生物与肠道菌群的空间差异，列举局部代谢物（乳酸、精氨酸、TMAO）直接调节免疫细胞功能的具体实例，补充非肠道来源的代谢调控视角。",
          "source_handle": "P0332"
        },
        {
          "proposed_use": "综合微生物组与TME的互作网络，阐述细菌成分激活DCs、促进CD8+ T细胞浸润及调节抑制性细胞（MDSCs/Tregs）的多层次机制，打破单一通路局限。",
          "source_handle": "P0384"
        }
      ],
      "unit_key": "CH02:3"
    },
    {
      "studies": [
        {
          "proposed_use": "提出“功能趋同”理论框架，解释为何不同研究中微生物分类学标志物不一致但功能通路相似，支持从分类学向功能/代谢分析转变的方法学立场。",
          "source_handle": "P0364"
        },
        {
          "proposed_use": "展示多界微生物组（细菌、真菌、古菌、病毒）整合特征在跨癌种队列中预测ICI疗效的机器学习模型，论证超越单一细菌视角的生态拓扑评分价值。",
          "source_handle": "P0393"
        },
        {
          "proposed_use": "批判性评估当前微生物组生物标志物的临床就绪度，指出技术异质性、缺乏前瞻性验证及地理差异等关键局限，明确标准化宏基因组协议与纵向采样的必要性。",
          "source_handle": "P0363"
        }
      ],
      "unit_key": "CH02:4"
    }
  ],
