{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "阐释肌苷-UBA6轴解除泛素化抑制并上调MHC-I的分子细节，结合CheckMate 025队列确立临床相关性，并以MC38模型说明UBA6丰度作为预测因子的边界条件。",
          "source_handle": "P0582"
        },
        {
          "proposed_use": "对比丁酸盐HDAC抑制的双向效应与IPA/ICA竞争性拮抗Kyn-AHR轴的分子细节，强调浓度依赖性与微环境上下文（缺氧、营养竞争）对最终表型的决定性影响。",
          "source_handle": "P0584"
        },
        {
          "proposed_use": "综合代谢物效应的异质性与剂量阈值挑战，提出基于受体亲和力与表观遗传酶活性的转化评估框架，解释为何同一代谢物在不同ICI靶点或癌种中产生相反结果。",
          "source_handle": "P0075"
        }
      ],
      "unit_key": "CH02:1"
    },
    {
      "studies": [
        {
          "proposed_use": "详细阐述Enterocloster增殖如何改变胆汁酸转化，导致回肠内皮MAdCAM-1表达下调，解除α4β7+FoxP3+ Tr17细胞的肠道驻留限制，并引用小鼠与人类队列确认sMAdCAM-1的预后价值。",
          "source_handle": "P0574"
        },
        {
          "proposed_use": "对比Parasutterella等核心菌群的定植效果，说明其如何通过消耗特定碳源或产生代谢产物调节胆汁酸合成酶（Cyp7a1）与转运体表达，从而维持适宜的胆汁酸浓度梯度与屏障完整性。",
          "source_handle": "P0576"
        },
        {
          "proposed_use": "补充肝细胞癌模型证据，说明高浓度结合型胆汁酸（TCDCA）与次级胆汁酸（LCA）如何通过诱导氧化应激和内质网应激直接耗竭CD8+ T细胞功能，揭示胆汁酸在特定器官微环境中超越屏障调控的直接抑制效应。",
          "source_handle": "P0581"
        }
      ],
      "unit_key": "CH02:2"
    },
    {
      "studies": [
        {
          "proposed_use": "解析LPS、肽聚糖及OMVs如何通过TLR4、NOD2等PRRs招募并激活DCs，促进MHC-II上调与IL-12释放，强调共生菌来源的修饰化PAMPs在避免过度炎症的同时提供有效共刺激的优势。",
          "source_handle": "P0564"
        },
        {
          "proposed_use": "阐述微生物肽段与肿瘤新抗原序列相似性的统计学基础，引用胰腺癌队列中T细胞克隆对微生物表位的交叉反应证据，说明如何利用生物信息学工具量化模拟程度及其在预测ICI响应中的潜力。",
          "source_handle": "P0561"
        },
        {
          "proposed_use": "以肌苷-UBA6通路为例，说明代谢物如何直接作用于肿瘤细胞内泛素化machinery，解除对MHC-I组装与抗原加工复合物的抑制，论证代谢重编程与抗原可视化的协同性，打破“代谢vs免疫”的二元对立。",
          "source_handle": "P0582"
        }
      ],
      "unit_key": "CH02:3"
    },
    {
      "studies": [
        {
          "proposed_use": "以CheckMate 025肌苷研究为例，说明中位数分层分析的实用性与绝对浓度缺失的缺陷，讨论抗生素、PPIs、饮食及肿瘤异质性如何掩盖真实的菌群-疗效信号，强调多变量调整与纵向采样的必要性。",
          "source_handle": "P0582"
        },
        {
          "proposed_use": "对比无菌鼠/人源化鼠模型在确立UBA6抑制或sMAdCAM-1轴因果链中的不可替代性，同时指出小鼠昼夜节律、胆汁酸池大小及肠道解剖结构与人类的差异，警示直接外推的风险。",
          "source_handle": "P0574"
        },
        {
          "proposed_use": "总结TOPOSCORE等生态拓扑评分在定义功能性失调方面的进展，呼吁采用LC-MS/MS绝对定量、稳定同位素示踪及空间转录组学解析TME内代谢物梯度，强调国际合作在建立标准化宏基因组协议及前瞻性验证平台中的核心作用。",
          "source_handle": "P0584"
        }
      ],
      "unit_key": "CH02:4"
    }
  ],
