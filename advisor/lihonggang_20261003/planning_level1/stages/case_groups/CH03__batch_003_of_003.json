          "source_handle": "P0553"
        },
        {
          "proposed_use": "提供特定共生菌（P. melanogenica）通过增加丁酸盐抑制Th17轴从而解耦疗效与毒性的前临床因果证据，细化细菌表面分子调控机制。",
          "source_handle": "P0554"
        }
      ],
