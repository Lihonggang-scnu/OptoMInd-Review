        {
          "proposed_use": "提供单菌株活体生物药（MRx0518）联合帕博利珠单抗在难治性实体瘤中的早期临床安全性与疾病控制率数据，补充除FMT外的微生物干预临床转化实例。",
          "source_handle": "P0230"
        },
        {
          "proposed_use": "通过荟萃分析量化FMT联合ICI的总体缓解率（43%），并揭示抗PD-1/CTLA-4双药方案中疗效显著提升（ORR 60%），支撑癌种/方案依赖性分析。",
          "source_handle": "P0212"
        },
        {
          "proposed_use": "提供高纤维饮食干预改善ICI治疗反应的定量证据（OR=5.79），丰富非药物类微生物调节策略的临床效果对比维度。",
          "source_handle": "P0156"
        }
      ],
      "unit_key": "CH03:1"
    },
    {
      "studies": [
        {
          "proposed_use": "揭示单一代谢物脱氨基酪氨酸（DAT）通过宿主IFN-I信号通路增强T细胞活化并部分逆转抗生素诱导的菌群失调耐药，补充代谢物介导机制的因果证据。",
          "source_handle": "P0195"
        },
        {
          "proposed_use": "阐明天然多酚Castalagin特异性结合并富集Ruminococcus、改变胆汁酸代谢及促进CD8+ T细胞浸润的分子路径，展示益生元干预克服原发耐药的机制链条。",
          "source_handle": "P0201"
        },
        {
          "proposed_use": "提供肠道菌群通过下调树突状细胞PD-L2表达、解除RGMb介导的免疫抑制从而克服耐药的前临床因果证据，细化细菌表面分子调控机制。",
          "source_handle": "P0242"
        }
      ],
      "unit_key": "CH03:2"
    },
    {
      "studies": [
        {
          "proposed_use": "提供FMT联合ICI治疗的汇总不良事件发生率（3-4级AE达37%），并指出双药组毒性风险更高，为评估干预安全性信号提供量化基线。",
          "source_handle": "P0212"
        },
        {
          "proposed_use": "梳理特定菌群特征（如厚壁菌门、链球菌属）与结肠炎等irAEs发生的关联证据，扩展对微生物组介导免疫相关毒性的谱系认知。",
          "source_handle": "P0261"
        }
      ],
      "unit_key": "CH03:3"
    },
    {
      "studies": [
        {
          "proposed_use": "总结FMT相关的耐药菌血症等安全事件及供体筛查要求，提出基于生态药理学框架的标准化与监管挑战，支撑未来研究议程规划。",
          "source_handle": "P0178"
        },
        {
