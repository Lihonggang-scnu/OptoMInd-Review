{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "提供NSCLC与黑色素瘤队列的定量荟萃分析数据，量化α多样性、Akkermansia及Faecalibacterium对OS/PFS的合并效应量，支撑跨癌种关联矩阵的构建。",
          "source_handle": "P0298"
        },
        {
          "proposed_use": "揭示微生物标志物具有肠型特异性（如E2肠型中Collinsella与响应相关），解释单一物种在不同研究中表现不一致的群落背景依赖性机制。",
          "source_handle": "P0170"
        },
        {
          "proposed_use": "基于TCGA多组学数据计算特定菌群组合定义的亚型与T细胞炎症基因表达谱（GEP）及TIDE评分的关联，补充微生物塑造免疫抑制微环境的计算生物学证据。",
          "source_handle": "P0232"
        }
      ],
      "unit_key": "CH01:1"
    },
    {
      "studies": [
        {
          "proposed_use": "提供纵向队列证据，证实治疗初期微生物稳定性丧失独立于抗生素暴露与ICI耐药相关，并展示基于机器学习筛选进展相关物种指数的预测能力。",
          "source_handle": "P0227"
        },
        {
          "proposed_use": "展示晚期NSCLC患者纵向多组学轨迹，明确响应者治疗后微生物特征向健康状态回归而进展者恶化的动态分化模式，支撑纵向稳定性假说。",
          "source_handle": "P0200"
        },
        {
          "proposed_use": "提供mCRPC患者ICI治疗期间微生物组高度稳定的纵向数据，挑战跨癌种通用动态模型，提示既往内分泌治疗史可能重塑菌群-疗效关系的时间依赖性。",
          "source_handle": "P0270"
        }
      ],
      "unit_key": "CH01:2"
    },
    {
      "studies": [
        {
          "proposed_use": "系统梳理不同研究间测序技术（16S vs 宏基因组）、样本采集时间及“响应者”定义标准的不一致性，为评估生物标志物临床转化的方法学瓶颈提供实证依据。",
          "source_handle": "P0295"
        },
        {
          "proposed_use": "指出机器学习模型在跨队列验证时性能显著下降，强调肝病病因（NAFLD vs HBV）导致的基线微生物谱差异是重要混杂因素，支撑宿主病理背景限制泛化的论点。",
          "source_handle": "P0164"
        },
        {
          "proposed_use": "对比黑色素瘤与头颈癌中唾液/粪便采样结果的差异，结合TIME分类系统说明单一微生物指标在复杂肿瘤微环境中的预测盲区，论证多模态整合的必要性。",
          "source_handle": "P0265"
        }
      ],
      "unit_key": "CH01:3"
    }
  ],
