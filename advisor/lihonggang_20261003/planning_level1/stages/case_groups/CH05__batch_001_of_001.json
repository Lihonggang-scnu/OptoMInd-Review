          "proposed_use": "补充ICI疗效与微生物组关联的临床证据，特别是抗生素使用对预后的负面影响及FMT概念验证，支撑RCT检索现状评估。",
          "source_handle": "P0469"
        },
        {
          "proposed_use": "提供益生菌、菌群组合与FMT三类干预策略的对比数据，论证从广谱生态调节向精准定义菌群转变的必要性。",
          "source_handle": "P0387"
        }
      ],
      "unit_key": "CH05:1"
    },
    {
      "studies": [
        {
          "proposed_use": "详述SCFAs、色氨酸代谢物及胆汁酸通过HDAC抑制和受体信号调控PD-1/PD-L1的具体分子机制，深化肌苷-UBA6轴之外的机制图谱。",
          "source_handle": "P0518"
        },
        {
          "proposed_use": "提供肿瘤新抗原模拟（Molecular Mimicry）作为非代谢途径的机制假说，并建议量化方法（TAS），丰富人体机制验证路径。",
          "source_handle": "P0561"
        }
      ],
      "unit_key": "CH05:2"
    },
    {
      "studies": [
        {
          "proposed_use": "列举SYNB1891等进入临床阶段的活细菌疗法，展示基因编辑减毒及纳米载体递送等工程化策略，支持“有害菌清除”及合成生物学方向。",
          "source_handle": "P0494"
        },
        {
          "proposed_use": "通过培养组学与宏基因组测序的互补性分析，识别响应者富集的Bacteroides与非响应者富集的Enterocloster，为定义菌群提供具体物种对照。",
          "source_handle": "P0367"
        }
      ],
      "unit_key": "CH05:3"
    },
    {
      "studies": [
        {
          "proposed_use": "提供泛素化修饰（UPS）调控PD-1/PD-L1稳定性的分子机制，以及AI在预测ICI响应中的具体案例，补充多维生物标志物框架。",
          "source_handle": "P0520"
        },
        {
          "proposed_use": "提出“时间性免疫抑制盾”（TIS）框架，阐述昼夜节律紊乱通过微生物代谢物（如TCA）影响ICI疗效，引入时间维度作为计算模型的新变量。",
          "source_handle": "P0459"
        }
      ],
      "unit_key": "CH05:4"
    },
    {
      "studies": [
        {
          "proposed_use": "提供分子模拟驱动irAEs（自身免疫抗原模拟）的实证证据，警示特定菌株动力学下的毒性风险，支持安全性管理与监管框架讨论。",
          "source_handle": "P0462"
        },
        {
          "proposed_use": "提供系统级调节器概念框架，强调神经-免疫-内分泌轴线共享通路，倡导建立“微生物意识”癌症生物学范式以指导安全性终点设计。",
          "source_handle": "P0509"
        }
      ],
      "unit_key": "CH05:5"
    }
