      "studies": [
        {
          "proposed_use": "提供晚期黑色素瘤队列中短链脂肪酸（SCFA）产生菌（如F. prausnitzii）丰度与ICI原发/获得性耐药亚型及irAEs发生情况的纵向关联数据，检验“清除有害菌优于供体定植”假说在特定代谢功能菌群中的适用边界。",
          "source_handle": "P0428"
        },
        {
          "proposed_use": "提供肺癌幸存者队列中微生物代谢物（SCFAs）、分子模拟表位匹配度及菌株水平变异驱动长期无进展生存期（PFI≥1年）与irAEs结局的多组学证据，支持纵向动态演变中生态位重塑与抗原交叉反应的机制验证。",
          "source_handle": "P0462"
        }
      ],
      "unit_key": "CH01:2"
    },
    {
      "studies": [
        {
          "proposed_use": "提供mRCC真实世界队列中抗生素暴露途径（口服vs静脉）与时变效应分析数据，量化治疗启动后不同时间窗对rwOS/rwPFS的差异化影响，并对比TKI组结果以排除单纯疾病严重度偏倚，支撑时序依赖性论证。",
          "source_handle": "P0418"
        },
        {
          "proposed_use": "提供基因水平微生物丰度结合生物先验知识（BioP-VAE模型）在联合免疫检查点阻断（CICB）与单药治疗背景下的跨癌种预测性能对比，揭示治疗方案异质性对微生物标志物泛化的调节作用，评估临床转化瓶颈。",
          "source_handle": "P0437"
        }
      ],
