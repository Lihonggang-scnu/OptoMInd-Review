{
  "additions": [
    {
      "studies": [
        {
          "proposed_use": "提供HCC队列中抗生素暴露未显著恶化ICI疗效的阴性结果，挑战“广谱抗生素普遍有害”的普适假设，提示宿主基础疾病可修饰互作效应。",
          "source_handle": "P0275"
        },
        {
          "proposed_use": "展示肝硬化背景下基线α/β多样性与ICI疗效无关联的实证，反驳“高多样性总预示获益”的观点，强调病理状态可能掩盖常规标志物信号。",
          "source_handle": "P0301"
        },
        {
          "proposed_use": "提供下呼吸道微生物组独立于肠道调节NSCLC疗效的证据，补充局部微环境代谢物招募CD8+ T细胞的机制视角，拓宽非肠道部位的作用维度。",
          "source_handle": "P0352"
        }
      ],
      "unit_key": "CH04:1"
    },
    {
      "studies": [
        {
          "proposed_use": "通过荟萃分析确认仅在ICI前长期使用PPI才导致疗效受损，引入“使用时窗”作为关键调节变量，解释研究间异质性并支持时间累积失调假说。",
          "source_handle": "P0339"
        },
        {
          "proposed_use": "提供抗生素使用时长（>10天 vs ≤10天）与OS显著缩短的剂量-反应证据，强化长期暴露破坏微生态稳态的临床表型关联。",
          "source_handle": "P0061"
        }
      ],
      "unit_key": "CH04:2"
    },
    {
      "studies": [
        {
          "proposed_use": "通过SHAP可解释机器学习证明MetaCyc功能通路特征比分类学特征更能预测NSCLC患者ICI响应，支持从物种列表向代谢功能网络分析的范式转变。",
          "source_handle": "P0097"
        },
        {
          "proposed_use": "揭示肠型特异性（E1/E2）下Collinsella与Bacteroides等标志物的情境依赖性分布，说明群落拓扑结构决定单一物种预测效力的生物学逻辑。",
          "source_handle": "P0170"
        },
        {
          "proposed_use": "构建“功能趋同”概念框架，解释跨队列分类学不一致但免疫通路相似的底层逻辑，推动生物标志物开发从物种列表向功能网络分析转型。",
          "source_handle": "P0364"
        }
      ],
      "unit_key": "CH04:3"
    },
    {
      "studies": [
        {
          "proposed_use": "采用双向孟德尔随机化与中介分析框架，利用遗传工具变量克服观察性研究的反向因果与残留混杂，为微生物-癌症轴提供因果推断的方法学范例。",
          "source_handle": "P0059"
        },
        {
          "proposed_use": "提出整合多平台异构数据的“het set”分析框架，系统评估样本采集、测序技术及生物信息管道差异，为建立标准化监测协议提供方法论参考。",
          "source_handle": "P0264"
        },
        {
          "proposed_use": "采用目标试验模拟（target trial emulation）与逆概率加权设计，展示如何缓解回顾性观察中的残余混杂与选择偏倚，为确立药物-微生物互作因果链提供严谨流行病学范例。",
          "source_handle": "P0340"
        }
      ],
      "unit_key": "CH04:4"
    }
  ],
