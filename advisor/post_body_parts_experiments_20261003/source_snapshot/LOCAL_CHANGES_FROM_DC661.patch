+    none_calls = []
+
+    def capture_none(stage, messages):
+        none_calls.append(stage)
+        none_hashes[stage] = serial.messages_sha256(messages)
+        return fixture()[stage]
+
+    none = serial.run_serial_parts(draft_path=draft, research_question="q", chapter_roles=[],
+        out_dir=tmp_path / "none", provider=capture_none, prior_parts_mode="none")
+    assert none["status"] == "generated", none
+    assert none_calls == list(serial.STAGE_ORDER)
+    assert none_hashes["conception"] == full_hashes["conception"]
+    assert none_hashes["conclusion"] == full_hashes["conclusion"]
+    assert none_hashes["introduction"] != full_hashes["introduction"]
+    assert none_hashes["abstract"] != full_hashes["abstract"]
+
+    replay = serial.run_serial_parts(draft_path=draft, research_question="q", chapter_roles=[],
+        out_dir=tmp_path / "changed_mode", recordings=records, prior_parts_mode="none")
+    assert replay["status"] == "pending", replay
+    assert replay["generated"] == ["conception", "conclusion"]
+    assert replay["provider_calls"] == 0
+    assert "recording_binding_mismatch:serial_parts:introduction" in str(replay["failures"])
+
+
 def test_language_explicit_and_invalid_language_fails_before_provider(tmp_path):
     messages = serial.build_stage_messages("conception", body_text=BODY, research_question="q", language="en-US")
     assert "Write all manuscript parts and plan prose in English" in messages[0]["content"]
