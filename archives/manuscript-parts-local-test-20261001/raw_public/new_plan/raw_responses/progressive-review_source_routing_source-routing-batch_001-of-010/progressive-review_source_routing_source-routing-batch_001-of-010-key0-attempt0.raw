{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0001\",\n      \"paper_title\": \"Mapping the knowledge landscape: a bibliometric analysis of gut microbiota in cancer immunotherapy with implications for clinical translation.\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"作为文献计量学分析，该文不提供具体疗效数据，但揭示了领域研究热点从基础探索向结直肠癌、MSI 状态及 T 细胞微环境等临床转化议题的演变。可用于综述讨论部分，论证当前证据多集中于特定癌种和观察性关联，指出标准化临床转化路径的缺失及未来需关注的高频关键词方向。\"\n    },\n    {\n      \"source_handle\": \"P0002\",\n      \"paper_title\": \"Ecological and Functional Stratification of the Stool Microbiome Predicts Response to Immune Checkpoint Inhibitors across Cancer Types\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提出跨癌种的生态分层视角，指出响应者特征为本土高丰度菌群及稳定生态系统，而非单一菌种；功能上富集碳水化合物代谢。可用于综述论证从“寻找最佳菌株”转向“生态稳定性”和“功能代谢谱”的预测范式，并作为代谢机制（如短链脂肪酸前体）的假设来源。\"\n    },\n    {\n      \"source_handle\": \"P0003\",\n      \"paper_title\": \"Abstract PD11-05: PD11-05 Gut microbiome signatures correlate with overall survival among patients receiving eribulin with or without pembrolizumab for hormone receptor-positive metastatic breast cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"提供 HR+ 转移性乳腺癌亚组中微生物多样性及特定菌属（如 Odoribacter）与 ICI 联合治疗生存获益相关的观察性证据。关键发现是这种关联仅在含 ICI 组显著，支持微生物组调节 ICI 疗效的情境依赖性。可用于综述展示乳腺癌领域的具体临床关联及潜在代谢介导线索。\"\n    },\n    {\n      \"source_handle\": \"P0004\",\n      \"paper_title\": \"Roles of microbiota in pancreatic cancer development and treatment\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"详述胰腺癌中微生物耗竭逆转 ICI 耐药的临床前机制（CD8+ T 细胞激活、MDSC 减少）及代谢物（如 3-IAA）作用。同时指出 PDAC 对 ICI 天然耐药及 FMT 试验现状。可用于综述阐述免疫重塑机制、对比不同实体瘤反应差异，并讨论 FMT 在难治性肿瘤中的转化潜力与挑战。\"\n    },\n    {\n      \"source_handle\": \"P0005\",\n      \"paper_title\": \"Microbiomes and immune checkpoint mechanisms in cancer progression: A structured narrative review\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"梳理有益菌（Akkermansia, Bifidobacterium）与 ICI 疗效的关联及 SCFA 介导的 T 细胞调节假说，同时明确分子机制尚不清晰。可用于综述构建免疫检查点信号通路与微生物互作的概念框架，并作为界定当前知识边界、强调需区分相关性因果性的背景素材。\"\n    },\n    {\n      \"source_handle\": \"P0006\",\n      \"paper_title\": \"77 Impact of CBM588 on gut microbiome composition and dysbiosis in patients receiving frontline immune checkpoint inhibitor (ICI) combinations for metastatic renal cell carcinoma (mRCC)\",\n      \"chapter_ids\": [\n        \"CH04\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"报告 mRCC 患者中益生菌 CBM588 干预可逆转 ICI 导致的菌群失调（纠正 F/B 比，保护 E. siraeum）。虽无直接临床终点关联，但提供了特定干预下微生物组重塑的具体图谱。可用于综述讨论益生菌作为辅助策略的可行性及特定菌种在维持菌群稳态中的潜在作用。\"\n    },\n    {\n      \"source_handle\": \"P0007\",\n      \"paper_title\": \"Effects of concomitant gut-microbiome altering medications on immune checkpoint inhibitors therapy: A retrospective study.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供回顾性证据，显示抗生素、PPIs 和类固醇在 ICI 早期使用与生存期缩短显著相关（RR 1.53-2.18），且存在剂量累积效应。可用于综述论证药物诱导的微生物群扰动对临床结局的负面影响，强调抗生素管理的重要性，并提示不同药物类别对疗效与毒性影响的异质性。\"\n    },\n    {\n      \"source_handle\": \"P0008\",\n      \"paper_title\": \"The Influence of the Gut Microbiome in Paediatric Cancer Origin and Treatment\",\n      \"chapter_ids\": [\n        \"CH05\",\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"综述儿科肿瘤中微生物组证据的稀缺性，指出多数机制推导自成人研究。强调儿科人群因治疗复杂、样本少导致的证据等级低，并警示益生菌在免疫抑制儿童中的安全风险。可用于综述讨论年龄特异性差异、外推成人结论的局限性及未来儿科研究的设计挑战。\"\n    },\n    {\n      \"source_handle\": \"P0009\",\n      \"paper_title\": \"Abstract 2219: Clinical response to immune checkpoint inhibitors in melanoma is associated with distinct gut bacterial species that promote anti-tumor immunity by different mechanisms\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"识别 9 种与黑色素瘤 ICI 响应相关的细菌，并区分两种机制：依赖 DC-IL-12 轴的免疫激活与不依赖 IL-12 的代谢物直接作用。提及多菌株制剂 MB097 的临床开发。可用于综述详细阐述微生物介导免疫激活的异质性机制，并作为从基础发现向联合生物制剂转化的案例。\"\n    },\n    {\n      \"source_handle\": \"P0010\",\n      \"paper_title\": \"Analyzing the gut microbiome in adolescent and young adult patients with melanoma receiving immune checkpoint blockade.\",\n      \"chapter_ids\": [\n        \"CH05\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"描述青少年及年轻成人（AYA）黑色素瘤患者基线菌群与老年患者的差异（如 Bacteroides stercoris 富集），提示年龄/发育阶段塑造菌群结构。虽未直接关联疗效，但为解释不同年龄段 ICI 反应异质性提供背景变量。可用于综述强调宿主因素对菌群的影响及分层分析的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0011\",\n      \"paper_title\": \"Correlation of the gut microbiome and immune-related adverse events in gastrointestinal cancer patients treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"聚焦胃肠道癌症，发现特定菌属（如 R. callidus）富集与较低重症 irAEs 风险相关，而尿素循环通路在无毒性患者中富集。指出不同癌种 irAEs 的微生物特征截然不同。可用于综述论证微生物组对安全性的调节作用具有肿瘤类型特异性，并探讨氨基酸代谢介导免疫耐受的可能机制。\"\n    },\n    {\n      \"source_handle\": \"P0012\",\n      \"paper_title\": \"Antibiotic use reduces efficacy of tyrosine kinase inhibitors in patients with advanced melanoma and non-small-cell lung cancer\",\n      \"chapter_ids\": [\n        \"CH05\",\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"提供抗生素在非免疫治疗（TKI）背景下同样降低生存率的反面案例，提示抗生素负面影响可能不仅限于免疫调节，还涉及炎症或药代动力学。可用于综述讨论抗生素作为混杂因素的普遍性，警示在归因微生物机制时需排除感染本身及药物相互作用的干扰。\"\n    },\n    {\n      \"source_handle\": \"P0013\",\n      \"paper_title\": \"Expanding horizons of cancer immunotherapy: hopes and hurdles\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"汇总黑色素瘤等实体瘤中与 ICI 响应相关的菌群特征（Bacteroides, Bifidobacterium）及推测机制（CD8+ T 细胞激活、cGAS/STING 通路）。作为叙事综述，提供候选微生物列表和免疫调节假说。可用于综述背景部分快速定位关键菌属和主流机制假设，但需注明其非系统性证据性质。\"\n    },\n    {\n      \"source_handle\": \"P0014\",\n      \"paper_title\": \"Gut microbiome influences efficacy of PD-1–based immunotherapy against epithelial tumors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"提供关键实证：Akkermansia muciniphila 丰度与肺癌/肾癌患者 PD-1 疗效正相关，且小鼠实验证实补充该菌可恢复疗效。可用于综述确立特定菌种与 ICI 疗效的因果联系雏形，支持 FMT 或益生菌干预的理论基础，并作为上皮肿瘤中微生物调节作用的经典证据。\"\n    },\n    {\n      \"source_handle\": \"P0015\",\n      \"paper_title\": \"A gut microbial signature for combination immune checkpoint blockade across cancer types\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"证明菌株水平特征比物种水平更能预测联合 ICI 疗效（AUC 0.73），且预测模型具有治疗方案特异性（联合 vs 单药不可互换）。发现丁酸合成基因簇与响应相关。可用于综述强调高分辨率分析的重要性，警示跨方案外推的风险，并提供功能基因组学作为机制线索的价值。\"\n    },\n    {\n      \"source_handle\": \"P0016\",\n      \"paper_title\": \"Immune Checkpoint Inhibitors and Opioids in Patients with Solid Tumours: Is Their Association Safe? A Systematic Literature Review\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统综述显示阿片类药物使用与实体瘤患者 ICI 疗效下降（OS/PFS 缩短）相关，推测机制涉及肠道稳态破坏。可用于综述讨论非抗生素类药物对微生物组及 ICI 疗效的潜在干扰，强调在评估微生物影响时需控制疼痛管理等伴随用药的混杂因素。\"\n    },\n    {\n      \"source_handle\": \"P0017\",\n      \"paper_title\": \"DOP47 Gut microbiome contributes to the development of immune checkpoint inhibitor-related colitis\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"通过 FMT 实验初步证实特定菌群（产丁酸菌缺失、肠球菌富集）可直接诱导小鼠结肠炎，提供因果证据。可用于综述阐述微生物组介导 irAEs（特别是结肠炎）的机制，区分疗效与毒性的不同菌群特征，并支持代谢产物（丁酸）在维持肠道屏障中的关键作用。\"\n    },\n    {\n      \"source_handle\": \"P0018\",\n      \"paper_title\": \"Prostate Cancer at the Microbial Crossroads: Illuminating a New Frontier in Precision Medicine\",\n      \"chapter_ids\": [\n        \"CH05\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"指出前列腺癌中微生物组与 ICI 疗效关联证据稀缺，主要依赖其他实体瘤外推。详述 SCFA、雄激素代谢等潜在机制。可用于综述界定低免疫原性肿瘤的研究空白，讨论将高免疫原性肿瘤结论外推至前列腺癌的风险，并列举该癌种特有的代谢调节路径。\"\n    },\n    {\n      \"source_handle\": \"P0019\",\n      \"paper_title\": \"Exploring the impact of non-small cell lung cancer tumor microbiome on the efficacy of chemotherapy and immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"在同一 NSCLC 队列中发现肿瘤内微生物群与 ICI 疗效相关，而基线肠道微生物群无差异。提示不同解剖部位微生物群预测价值的空间异质性。可用于综述讨论肠道菌群作为通用标志物的局限性，强调肿瘤微环境局部菌群的重要性及小样本研究的探索性质。\"\n    },\n    {\n      \"source_handle\": \"P0020\",\n      \"paper_title\": \"The gut–brain axis in depression, anxiety, and schizophrenia: a scoping review of mechanisms, biomarkers, and therapeutic implications\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"虽聚焦精神疾病，但详述了微生物失调导致全身炎症（IL-6, TNF-α）和代谢紊乱（SCFA, 色氨酸）的通用机制。可用于综述背景部分类比说明微生物 - 免疫互作的生物学合理性，或作为方法学参考，强调多组学整合在解析复杂宿主 - 微生物关系中的挑战与策略。\"\n    },\n    {\n      \"source_handle\": \"P0021\",\n      \"paper_title\": \"Gut microbial species and metabolic pathways associated with response to treatment with immune checkpoint inhibitors in metastatic melanoma\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"在控制混杂因素后，确认特定菌种（S. parasanguinis, B. massiliensis）与黑色素瘤 ICI 响应正相关，并识别 17 个差异代谢通路。可用于综述提供经过校正的临床关联证据，支持从分类学标志物向功能代谢通路研究的转变，并强调控制临床混杂因素对提高结果可信度的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0022\",\n      \"paper_title\": \"The Gut Microbiome, Microsatellite Status and the Response to Immunotherapy in Colorectal Cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"综述结直肠癌中 dMMR 与 pMMR 亚型的微生物组差异及 FMT 早期试验。详述微生物通过 DC 激活、T 细胞浸润及代谢物（丁酸盐）调节 ICI 疗效的机制。可用于综述展示 MSI 状态作为关键分层因素，提供 CRC 特异性证据链，并讨论 FMT 在克服原发性耐药中的转化前景。\"\n    },\n    {\n      \"source_handle\": \"P0023\",\n      \"paper_title\": \"Biomarkers for Immune Checkpoint Inhibitors in Melanoma\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"总结黑色素瘤中微生物多样性及拟杆菌科丰度与 ICI 疗效的关联，及抗生素/无菌状态的负面影响。提及动物模型中双歧杆菌的作用。可用于综述确立黑色素瘤作为微生物组研究模型癌种的地位，提供早期关键观察性证据，并讨论多标志物联合预测的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0024\",\n      \"paper_title\": \"The human gut microbiome and its metabolic pathway dynamics before and during HIV antiretroviral therapy\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"描述 HIV 感染下微生物组失调及代谢通路（异丁醇途径）持续异常的特征。虽非肿瘤研究，但提供慢性炎症状态下微生物 - 代谢互作的类比案例。可用于综述讨论不同病理背景下微生物组改变的共性，或作为方法学参考，展示纵向追踪代谢通路动态变化的分析策略。\"\n    },\n    {\n      \"source_handle\": \"P0025\",\n      \"paper_title\": \"Safety and efficacy of antibody-drug conjugates plus immunotherapy in solid tumours: A Systematic review and meta-analysis.\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供 ADC+ICI 联合治疗的疗效与安全性基线数据（如 ILD 风险增加）。虽未涉及微生物组，但确立了强效联合方案下的毒性背景。可用于综述讨论在探索微生物组干预时，需考虑与其他联合策略（如 ADC）的毒性叠加效应，作为评估新型联合疗法安全性的参照系。\"\n    },\n    {\n      \"source_handle\": \"P0026\",\n      \"paper_title\": \"Clinical potential of the gut microbiome in oncology: a scoping review of treatment response, toxicity and biomarker development\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"范围综述汇总了菌株水平预测模型性能（AUC 0.73）、关键菌属（双歧杆菌等）及 FMT 临床试验结果。同时指出方法学异质性和缺乏外部验证的局限。可用于综述全面评估微生物组生物标志物的临床转化潜力，平衡展示阳性发现与当前证据的方法学缺陷及标准化需求。\"\n    },\n    {\n      \"source_handle\": \"P0027\",\n      \"paper_title\": \"Research on microbial communities in tumor microenvironments: cutting-edge dynamics and future trends from a bibliometric perspective\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"文献计量分析指出肿瘤内微生物与肠道菌群的重叠性及具核梭杆菌的双重作用。总结干预研究趋势及代谢物（丁酸、乳酸）的免疫调节角色。可用于综述讨论肿瘤内微生物生态位的独特性，警示低生物量样本的污染风险，并提供代谢介导机制的理论框架。\"\n    },\n    {\n      \"source_handle\": \"P0028\",\n      \"paper_title\": \"Bidirectional regulation of the gut microbiome-immune axis in the immune microenvironment of colorectal cancer and targeted interventions\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详述 CRC 中微生物代谢物（琥珀酸、SCFA）及抗原呈递调节 T 细胞功能的具体路径（如 Fn 抑制 cGAS-IFN-β，NaB 调节 Treg/Th17）。提及工程菌干预策略。可用于综述深入解析微生物 - 免疫互作的分子机制，特别是代谢物介导的信号通路，并展示前沿干预手段的潜力。\"\n    },\n    {\n      \"source_handle\": \"P0029\",\n      \"paper_title\": \"Enhancing Immune Response in Immunotherapy-Resistant Melanoma Through Fecal Microbiota Transplantation: A Systematic Review\",\n      \"chapter_ids\": [\n        \"CH04\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"系统综述显示 FMT 联合抗 PD-1 在黑色素瘤中 ORR 达 65%，机制涉及特定菌属富集、T 细胞激活及 SCFA 增加。强调供体选择及定植持久性的重要性。可用于综述提供 FMT 克服耐药的直接临床证据，讨论干预成功的关键要素（供体、定植）及安全性风险。\"\n    },\n    {\n      \"source_handle\": \"P0030\",\n      \"paper_title\": \"Efficacy and safety of adjuvant short-course immune checkpoint inhibitors following TACE combined with MWA in patients with BCLC A–B hepatocellular carcinoma: a single-arm, prospective, phase II study protocol\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"作为临床试验方案，定义了介入治疗（TACE/MWA）后辅助 ICI 的操作规范及理论机制（免疫原性细胞死亡）。虽无结果，但展示了局部治疗与免疫治疗协同的探索方向。可用于综述讨论肝癌辅助治疗领域的证据缺口，及局部治疗诱导抗原释放作为微生物组干预潜在协同机制的背景。\"\n    },\n    {\n      \"source_handle\": \"P0031\",\n      \"paper_title\": \"The Human Microbiome: A New Frontier in Precision Medicine\",\n      \"chapter_ids\": [\n        \"CH05\",\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"观点文章确认微生物组与 ICI 疗效及毒性的关联，强调因果推断困难及个体差异。可用于综述讨论部分，界定当前从观察到因果的转化瓶颈，强调标准化和纵向数据的重要性，并作为呼吁开展更严格临床试验的理论依据。\"\n    },\n    {\n      \"source_handle\": \"P0032\",\n      \"paper_title\": \"Relationship Between Gut Microbiota and Cancer Neuro‐Immunity\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提出神经免疫轴作为微生物调节 ICI 疗效的新机制，详述迷走神经反射、神经递质（NE, CGRP）及代谢物对 T 细胞/NK 细胞的调节作用。可用于综述拓展机制视野，超越传统免疫细胞互作，纳入神经系统介导的远程调控路径，解释微生物对全身免疫状态的复杂影响。\"\n    },\n    {\n      \"source_handle\": \"P0033\",\n      \"paper_title\": \"Longitudinal gut microbiome changes in immune checkpoint blockade-treated advanced melanoma\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"纵向队列显示治疗期间特定 SGBs（如产 SCFA 菌）的动态积累与长期 PFS 相关，且受临床情境（联合治疗、PPI）显著影响。可用于综述论证动态监测优于基线单次检测，揭示临床协变量对微生物轨迹的修饰作用，并提供代谢通路（多胺、SCFA）作为潜在介导因子的线索。\"\n    },\n    {\n      \"source_handle\": \"P0034\",\n      \"paper_title\": \"Rewiring tumor cytokine networks to enhance immune checkpoint blockade: mechanisms, engineering, and clinical translation\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"详述细胞因子网络（IL-6, IL-8, TGF-β）介导的免疫抑制机制及靶向策略。虽非直接微生物研究，但提供了 TME 免疫抑制背景的完整图景。可用于综述对比微生物组与其他 TME 调节因素，说明克服“冷肿瘤”微环境的多维策略，作为理解微生物作用的上游背景。\"\n    },\n    {\n      \"source_handle\": \"P0035\",\n      \"paper_title\": \"Effect of antibiotic, proton pump inhibitor, H2 blocker, metformin and statin use on outcomes with immune checkpoint inhibitors (ICIs) in patients (pts) with metastatic urothelial carcinoma (mUC) in a real-world setting.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"真实世界研究显示抗生素、PPI 和二甲双胍在特定时间窗使用与 mUC 患者 ICI 生存率下降相关，且效应具有时间特异性。可用于综述提供尿路上皮癌亚组的药物干扰证据，强调用药时机的重要性，并提示二甲双胍效应的复杂性（可能与既往认知冲突），需结合具体癌种解读。\"\n    },\n    {\n      \"source_handle\": \"P0036\",\n      \"paper_title\": \"The interplay between gut microbiota, antibiotics, and immune checkpoint inhibitors in patients with cancer: a narrative review with biological and clinical aspects.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"叙事综述汇总了特定菌属（Faecalibacterium, Akkermansia）与 ICI 疗效的关联，详述分子机制（PSA, Inosine, SCFA）及抗生素破坏这些通路的后果。可用于综述构建“药物 - 菌群 - 免疫”的完整逻辑链，提供具体的代谢物 - 受体互作细节，并作为抗生素负面影响的机制解释素材。\"\n    },\n    {\n      \"source_handle\": \"P0037\",\n      \"paper_title\": \"Exploring the Potential of Humoral Immune Response to Commensal Bifidobacterium as a Biomarker for Human Health, including Both Malignant and Non-Malignant Diseases: A Perspective on Detection Strategies and Future Directions\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"提出双歧杆菌通过抗原模拟激发体液免疫（抗体交叉识别肿瘤抗原）的新机制假说，补充传统 T 细胞机制。提供 FMT 逆转耐药的临床数据。可用于综述拓展机制维度，纳入体液免疫视角，解释预存免疫的重要性，并作为 FMT 临床转化的具体案例及安全性讨论素材。\"\n    },\n    {\n      \"source_handle\": \"P0038\",\n      \"paper_title\": \"Advances and prospects of biomarkers for immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述确认微生物组作为潜在生物标志物的地位，列举相关菌属及 FMT 尝试，但指出跨队列通用标志物缺失及标准化挑战。可用于综述讨论生物标志物开发的现状，强调多标志物联合预测的必要性，并作为方法学标准化和未来研究方向的背景依据。\"\n    },\n    {\n      \"source_handle\": \"P0039\",\n      \"paper_title\": \"The use of antibiotic, probiotic, and fecal microbiota transplantation in modulating immunotherapy efficacy and survival: a systematic review and meta-analysis of clinical outcomes\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"荟萃分析定量证实抗生素降低 ORR 和 OS，而益生菌和 FMT 改善结局。提供具体的效应量（OR, HR）。可用于综述提供最高等级的临床证据支持微生物组干预的价值，对比不同干预方向（破坏 vs 重塑）的后果，并作为临床实践建议（避免不必要抗生素）的核心依据。\"\n    },\n    {\n      \"source_handle\": \"P0040\",\n      \"paper_title\": \"Benefits of using probiotics as adjuvants in anticancer therapy (Review)\",\n      \"chapter_ids\": [\n        \"CH04\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"区分益生菌缓解毒性（支持性护理）与特定共生菌增强 ICI 疗效（免疫调节）的不同角色。详述 LGG 保护肠黏膜机制及 Akkermansia 促进 T 细胞浸润证据。可用于综述构建分类框架，明确不同微生物干预的临床目标，并提供具体的分子机制案例及安全性警示。\"\n    },\n    {\n      \"source_handle\": \"P0041\",\n      \"paper_title\": \"Interaction between drugs and the gut microbiome\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述药物（PPIs, 二甲双胍等）对菌群的重塑作用及其潜在机制（DC 成熟、代谢物调节）。指出不同研究间菌种重叠度低。可用于综述讨论非抗生素药物作为混杂因素的重要性，提供药物 - 微生物互作的广泛背景，并警示跨研究比较时的异质性及因果推断的局限。\"\n    },\n    {\n      \"source_handle\": \"P0042\",\n      \"paper_title\": \"Immuno-Oncology at the Crossroads: Confronting Challenges in the Quest for Effective Cancer Therapies\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述微生物组通过代谢物（SCFA, 肌醇）调节 T 细胞及 FMT 逆转耐药的证据，同时详述 TME 耐药机制。可用于综述整合微生物组与其他耐药因素（如抗原丢失），提供多维度的疗效决定因素图景，并作为讨论 AI 和多组学整合未来方向的背景素材。\"\n    },\n    {\n      \"source_handle\": \"P0043\",\n      \"paper_title\": \"Influence of Bacterial Metabolites on the Systemic Antitumor Immune Response after Radiation Therapy in Combination with Immune Checkpoint Inhibitors.\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"小鼠研究显示特定细菌代谢物可抑制放疗联合 ICI 的远隔效应，提示并非所有代谢物均有益。可用于综述警示微生物组作用的复杂性，区分整体菌群与特定代谢物的不同效应，并作为反面案例说明盲目补充代谢物或益生菌的潜在风险及机制特异性。\"\n    },\n    {\n      \"source_handle\": \"P0044\",\n      \"paper_title\": \"Combining immune checkpoint inhibitors with chemotherapy in advanced solid tumours: A review.\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述 ICI 联合化疗的临床疗效及序贯问题，提及化疗增强免疫原性。虽未直接涉及微生物，但确立了联合治疗的基线疗效。可用于综述讨论化疗对微生物组的潜在影响（如多样性降低）及其与 ICI 疗效的交互作用，作为评估联合策略复杂性的背景。\"\n    },\n    {\n      \"source_handle\": \"P0045\",\n      \"paper_title\": \"A pan-tumor prospective translational, Irish study, investigating the association of gut microbiome (GM) diversity with pathological complete response (pCR) after neoadjuvant treatment in early stage breast, rectal, and esophageal cancers.\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"研究方案摘要，旨在探索 GM 多样性与新辅助治疗 pCR 的关联。虽无结果，但展示了前瞻性研究设计及爱尔兰人群数据收集策略。可用于综述指出当前缺乏高质量前瞻性数据（特别是新辅助场景），强调正在进行的研究努力及未来结果对填补证据缺口的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0046\",\n      \"paper_title\": \"Microbiome and colorectal carcinogenesis: Linked mechanisms and racial differences\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"详述微生物（Fn, ETBF）通过 TIGIT 结合、Th17 炎症及 SCFA 调节免疫的机制，并指出种族间菌群差异。可用于综述深入解析 CRC 特异性机制，强调种族/地理因素对基线菌群及治疗反应的潜在影响，作为讨论生物标志物普适性限制及个性化策略的重要依据。\"\n    },\n    {\n      \"source_handle\": \"P0047\",\n      \"paper_title\": \"Tumor Immunotherapy and Microbiome: From Bench‐to‐Bedside Applications\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"全面综述肠道及肿瘤内微生物组与 ICI 疗效的关联、机制（代谢物、分子模拟）及干预策略（FMT, 工程菌）。可用于综述提供从基础机制到临床转化的全景图，列举关键菌属和代谢通路，并作为讨论肿瘤内微生物组独特作用及临床试验现状的核心参考。\"\n    },\n    {\n      \"source_handle\": \"P0048\",\n      \"paper_title\": \"Oral and Gut Health, (Neuro) Inflammation, and Central Sensitization in Chronic Pain: A Narrative Review of Mechanisms, Treatment Opportunities, and Research Agenda\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"虽聚焦疼痛，但详述 SCFA、胆汁酸通过 GPRs/TLRs 调节免疫及肠道屏障机制。可用于综述类比说明微生物代谢物调节全身免疫状态的通用生物学原理，强调情境依赖性（同一代谢物在不同疾病中效应可能相反），并作为讨论生活方式干预潜在价值的背景。\"\n    },\n    {\n      \"source_handle\": \"P0049\",\n      \"paper_title\": \"Gut microbiome and immune checkpoint inhibitor toxicity.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"发现 Ruminococcaceae 减少与严重 irAEs 相关，讨论 F. prausnitzii 结果的矛盾性。可用于综述论证微生物组失衡在 irAEs 发病中的作用，强调从群落水平而非单一物种理解毒性机制的重要性，并作为讨论菌株特异性及方法学挑战（低丰度菌群检测）的实例。\"\n    },\n    {\n      \"source_handle\": \"P0050\",\n      \"paper_title\": \"Artificial intelligence–enabled multi-omics biomarkers for immune checkpoint blockade: mechanisms, predictive modeling, and clinical translation\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述 AI 整合微生物组与其他组学数据预测 ICI 疗效的进展，提及 Bacteroides/Prevotella 富集与疗效关联及 FMT 潜力。可用于综述讨论高维数据处理方法，展示多模态模型优于单模态预测的优势，并作为未来精准医疗中微生物组数据整合应用的技术背景。\"\n    },\n    {\n      \"source_handle\": \"P0051\",\n      \"paper_title\": \"Cardiotoxicity Secondary to Immune Checkpoint Inhibitors in the Elderly: Safety in Real-World Data\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供老年实体瘤患者 ICI 心脏毒性的真实世界数据，显示既往心脏病史非独立危险因素。虽未涉及微生物，但确立了特定人群的安全性基线。可用于综述讨论 ICI 安全性时作为对照背景，提示在评估微生物组对毒性影响时需排除心血管基础疾病等混杂因素。\"\n    },\n    {\n      \"source_handle\": \"P0052\",\n      \"paper_title\": \"278 Systematic review and meta-analysis evaluating the impact of antibiotic use on clinical outcomes of non-small-cell lung cancer patients treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"荟萃分析证实抗生素暴露显著降低 NSCLC 患者 ICI 的 OS、PFS 及 ORR。提供大样本定量证据。可用于综述确立抗生素作为负面调节因子的强证据等级，支持“微生物完整性对疗效至关重要”的假设，并作为临床抗生素管理策略的核心依据。\"\n    },\n    {\n      \"source_handle\": \"P0053\",\n      \"paper_title\": \"Gut microbiome-driven modulation of the tumor immune microenvironment optimizes dual checkpoint blockade in advanced non-small-cell lung cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"发现高微生物多样性仅在不联合化疗时预测 I-N 疗效，联合化疗后该关联消失。链接 SCFA 菌与 CD8+ TIL 浸润。可用于综述论证临床决策（如加用化疗）可能覆盖微生物组效应，提示微生物标志物的情境依赖性，并提供代谢物介导免疫细胞招募的具体机制线索。\"\n    },\n    {\n      \"source_handle\": \"P0054\",\n      \"paper_title\": \"Artificial Intelligence–Enabled Multi-Omics for Predicting Immune Checkpoint Inhibitor Response and Resistance\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": 