        "content": "{\n  \"additions\": [\n    {\n      \"unit_key\": \"CH03:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0561\",\n          \"proposed_use\": \"引入分子模拟假说，解释预存微生物暴露史如何通过TCR交叉反应性重塑新抗原免疫原性，补充传统DC介导路径之外的宿主背景维度。\"\n        },\n        {\n          \"source_handle\": \"P0570\",\n          \"proposed_use\": \"提供非肽类糖类/脂质抗原（如Forssman抗原）通过微生物诱导天然抗体介导ADCC效应的实证，支撑“分子模拟”假说的非活菌依赖路径。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH03:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0582\",\n          \"proposed_use\": \"详述肌苷作为嘌呤代谢中间产物，既可通过腺苷A2A受体（A2AR）促进Th1分化，又直接进入肿瘤细胞抑制泛素激活酶UBA6，解除对MHC-I类分子加工的限制，从而增强内在免疫原性。\"\n        },\n        {\n          \"source_handle\": \"P0590\",\n          \"proposed_use\": \"梳理SCFAs与肌苷的浓度阈值及情境依赖性效应，解释代谢物在生理与炎症微环境中的双刃剑机制。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH03:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0557\",\n          \"proposed_use\": \"揭示ICT诱导肠道细菌经DC摄取迁移至肠系膜淋巴结的物理转移路径，填补“微生物存在”与“远端免疫”间的因果链条。\"\n        },\n        {\n          \"source_handle\": \"P0574\",\n          \"proposed_use\": \"批判性评估肠道屏障修复剂与有益信号“泄漏”之间的平衡难题，提供空间隔室差异视角，支撑易位调控策略的临床转化潜力讨论。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH03:4\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0577\",\n          \"proposed_use\": \"以MIMic一期试验报告了FMT+抗PD1在晚期黑色素瘤中的临床结果（ORR 65%、mPFS 29.6月、mOS 52.8月），并发现响应者富集SCFA产生菌，为临床前因果证据与人类观察性数据的证据等级差异提供直接对照。\"\n        },\n        {\n          \"source_handle\": \"P0583\",\n          \"proposed_use\": \"展示基于TCGA数据的计算预测模型（GEP/TIDE评分）关联特定菌群组合与免疫浸润特征，说明多组学整合预测的潜力与技术局限。\"\n        }\n      ]\n    }\n  ]\n}",
