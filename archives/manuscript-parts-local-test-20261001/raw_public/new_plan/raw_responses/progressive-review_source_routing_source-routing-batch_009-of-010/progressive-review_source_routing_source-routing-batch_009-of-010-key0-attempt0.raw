{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0481\",\n      \"paper_title\": \"A microbiota-derived bile acid overcomes antibiotic-induced hyporesponsiveness to immune checkpoint therapy by enhancing CD8+ T cell antitumor immunity\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该研究在小鼠模型中证实，抗生素耗竭次级胆汁酸 TDCA 导致 ICI 疗效下降，而补充 TDCA 可通过激活 TGR5 受体恢复 CD8+ T 细胞功能。此材料可用于 CH01 解释抗生素负面效应的代谢机制，在 CH03 阐述胆汁酸 -TGR5-CD8+ T 细胞轴的具体分子通路，并在 CH04 作为“代谢物替代疗法”优于活菌疗法的概念验证案例，强调其可逆性和特异性。\"\n    },\n    {\n      \"source_handle\": \"P0482\",\n      \"paper_title\": \"Harnessing Bacterial Extracellular Vesicle Immune Effects for Cancer Therapy\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述详述细菌胞外囊泡（bEVs）作为非活菌组分，通过 TLR/NOD 通路激活固有免疫或工程化重编程巨噬细胞以增强 ICI 疗效的机制。适用于 CH03 补充除代谢物外的另一种微生物介导机制（纳米囊泡递送 PAMPs），并在 CH04 对比 bEVs 与 FMT/益生菌在安全性、规模化生产及避免定植抵抗方面的优势，提供转化医学的新视角。\"\n    },\n    {\n      \"source_handle\": \"P0483\",\n      \"paper_title\": \"Advancing Cancer Treatment: A Review of Immune Checkpoint Inhibitors and Combination Strategies\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了双歧杆菌等特定菌群通过促进树突状细胞成熟增强 PD-L1 阻断疗效的临床前证据，并列出 SCFA、胆汁酸等关键代谢物。可用于 CH01 提供微生物干预可行性的背景支持，在 CH02 列举预测性菌种和代谢物特征，并在 CH03 构建“肠 - 代谢物 - 免疫”轴的宏观框架，同时对比放疗、代谢重编程等其他联合策略的异同。\"\n    },\n    {\n      \"source_handle\": \"P0484\",\n      \"paper_title\": \"The aging microbiome and response to immunotherapy: considerations for the treatment of older adults with cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述提出老年患者微生物组趋向“无响应者”特征（多样性降低、有益菌缺失）的假设，解释了年龄相关的 ICI 疗效差异。适用于 CH01 讨论宿主因素（年龄）与微生物组交互作用导致的疗效异质性，并在 CH05 指出当前证据在老年人群中的局限性，强调需针对特定人群开展前瞻性研究以验证微生物组作为年龄分层生物标志物的潜力。\"\n    },\n    {\n      \"source_handle\": \"P0485\",\n      \"paper_title\": \"Abstract B023: Delineating the role of the microbiome and tumor microenvironment interactions driving mucosal melanoma (MM) response and resistance to immune checkpoint inhibitor (ICI) treatment\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该初步队列研究发现黏膜黑色素瘤响应者肠道微生物组成差异及 CD56/CD20 高表达特征，提示微生物组与局部免疫状态的关联。可用于 CH02 展示罕见实体瘤亚型中微生物预测标志物的探索性证据，并在 CH05 强调肿瘤原发部位特异性对微生物组 - 免疫互作的影响，指出小样本观察性研究的局限及需进一步验证因果机制的需求。\"\n    },\n    {\n      \"source_handle\": \"P0486\",\n      \"paper_title\": \"Targeting Microbiome Metabolites: Reshaping Immunotherapy and Clinical Management Strategies for Colorectal Cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述详细解析结直肠癌中微生物代谢物（如丁酸盐、肌苷促进免疫；琥珀酸、次级胆汁酸抑制免疫）的双向调节机制，涉及 AHR、GPR43 等受体及表观遗传修饰。适用于 CH02 识别 CRC 特异性代谢标志物，在 CH03 阐明代谢物调控免疫细胞功能的具体分子路径，并在 CH04 评估益生菌、工程菌及代谢物补充剂在 CRC 中的转化策略与挑战。\"\n    },\n    {\n      \"source_handle\": \"P0487\",\n      \"paper_title\": \"Gut microecology empowers cancer immunotherapy: commensal microbiota-mediated mechanisms and translational prospects of PD-1/PD-L1 therapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述系统梳理了阿克曼氏菌、瘤胃球菌科等有益菌及其代谢物（SCFA、色氨酸衍生物）通过激活 DC、逆转 T 细胞耗竭及维持屏障功能增强 ICI 疗效的机制，同时提及促耐药菌属。可用于 CH02 汇总跨癌种的预测性菌群特征，在 CH03 整合免疫调节与代谢通路细节，并在 CH05 讨论从经验性 FMT 向基于 AI 和合成生物学的精准干预转化的技术瓶颈。\"\n    },\n    {\n      \"source_handle\": \"P0488\",\n      \"paper_title\": \"Gut Microbiome Dysbiosis and Its Impact on Reproductive Health: Mechanisms and Clinical Applications\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"虽聚焦生殖健康，该综述详述 SCFA 诱导 Treg 分化及 LPS 易位引发全身炎症的通用免疫机制。适用于 CH03 作为背景素材，解释肠道微生物通过系统性免疫调节（如 Treg/Th17 平衡、慢性低度炎症）影响宿主生理状态的生物学原理，为理解其在肿瘤微环境中类似但更具情境特异性的免疫调节作用提供基础理论支撑和类比依据。\"\n    },\n    {\n      \"source_handle\": \"P0489\",\n      \"paper_title\": \"Clinical impact of baseline and peri-treatment concomitant medication exposure and polypharmacy on outcomes of immune checkpoint inhibitor therapy: A real-world pan-tumor analysis.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该真实世界研究显示基线前 30 天内抗生素暴露及多药联用显著降低 ICI 客观缓解率和 PFS，为微生物组介导的疗效变异提供流行病学支持。适用于 CH01 量化临床用药实践对 ICI 结局的负面影响，并在 CH05 强调混杂因素（如感染严重程度、药物相互作用）对观察性关联解释的挑战，提示需严格控制用药史以解析微生物组的独立效应。\"\n    },\n    {\n      \"source_handle\": \"P0490\",\n      \"paper_title\": \"Enhancing cancer immunotherapy and antiangiogenic therapy by regulating gut microbes: Opportunities and challenges\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了特定菌群（双歧杆菌、阿克曼氏菌）与 ICI 疗效改善的临床观察数据，并探讨了微生物调节血管生成及免疫微环境的机制。适用于 CH01 提供微生物组作为预测因子的背景证据，在 CH02 列举潜在生物标志物，并在 CH04 评估 FMT、益生菌及饮食干预在联合抗血管生成治疗中的临床试验现状、安全性顾虑及个体化实施挑战。\"\n    },\n    {\n      \"source_handle\": \"P0491\",\n      \"paper_title\": \"Priming versus propagating: distinct immune effects of alpha- versus beta-particle emitting radiopharmaceuticals when combined with immune checkpoint inhibition in mice\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该小鼠研究发现α与β放射性药物通过不同免疫机制（致敏 vs. 扩增）协同 ICI，虽未直接涉及微生物，但揭示了肿瘤内在免疫原性决定治疗响应的关键原则。适用于 CH03 作为对照，强调除微生物外，肿瘤微环境特征（如免疫原性高低）也是决定 ICI 疗效的关键变量；在 CH05 提示未来研究需整合宿主肿瘤特征与微生物组数据以构建更全面的预测模型。\"\n    },\n    {\n      \"source_handle\": \"P0492\",\n      \"paper_title\": \"Gut microbiota of dogs with cancer receiving anti-EGFR/HER2 immunization reveals potential biomarkers of patient survival\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该兽医学研究识别出犬癌症免疫治疗中预测生存的特定肠道菌群标志物，部分菌属与人类研究一致。适用于 CH02 提供跨物种微生物组 - 免疫治疗关联的平行证据，支持微生物组作为通用预后工具的潜力；在 CH05 讨论物种差异、疫苗类型不同对结果外推的限制，以及小样本观察性研究在确立因果机制前的局限性。\"\n    },\n    {\n      \"source_handle\": \"P0493\",\n      \"paper_title\": \"Melanoma tumor microbiome as a predictor of anti-PD-1 and anti-CTLA-4 immunotherapy response.\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该研究发现黑色素瘤肿瘤内微生物组（而非仅肠道）特定物种丰度可预测 ICI 响应，并与免疫检查点基因表达相关。适用于 CH02 拓展微生物生态位概念，指出肿瘤局部菌群也是重要的预测维度；在 CH05 强调区分肠道与瘤内微生物来源的重要性，以及观察性关联在缺乏因果验证和功能机制解析时的解释局限。\"\n    },\n    {\n      \"source_handle\": \"P0494\",\n      \"paper_title\": \"Current status and future perspectives of multi‐modal bacteria‐based cancer therapies\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述详述梭菌、双歧杆菌等共生菌通过激活 cDCs、STING 通路及调节 PD-L2/RGMb 轴增强 ICI 疗效的机制，并列举多种细菌疗法的临床进展。适用于 CH02 确认有益菌种及其免疫调节功能，在 CH03 解析细菌 - 宿主互作的分子路径，并在 CH04 评估活菌疗法、工程菌及 AI 辅助设计在克服耐药性方面的转化前景与生物安全挑战。\"\n    },\n    {\n      \"source_handle\": \"P0495\",\n      \"paper_title\": \"Stool Microbiome Profiling of Patients with Metastatic Renal Cell Carcinoma Receiving Anti-PD-1 Immune Checkpoint Inhibitors.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"该研究在肾细胞癌队列中发现基线微生物多样性及阿克曼氏菌丰度与 ICI 疗效正相关，且治疗响应者中该菌动态增加。适用于 CH01 提供特定实体瘤（mRCC）中微生物组预测价值的实证数据，并在 CH02 将阿克曼氏菌列为关键预测性菌种，同时指出小样本回顾性分析在确立因果及排除混杂因素（如饮食、抗生素）方面的局限。\"\n    },\n    {\n      \"source_handle\": \"P0496\",\n      \"paper_title\": \"Reproducible stool metagenomic biomarkers linked to the melanoma immunotherapy positive outcome\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该宏基因组研究识别出普氏粪杆菌等稳健分类标志物及 SCFA 合成、Maillard 产物利用等功能通路，提出“功能分散”假说解释标志物异质性。适用于 CH02 提供经多队列验证的菌群特征，在 CH03 从功能基因角度阐释代谢机制，并在 CH05 论证从单一菌种向功能导向标志物转变的必要性，以解决跨研究结果不一致的问题。\"\n    },\n    {\n      \"source_handle\": \"P0497\",\n      \"paper_title\": \"Hidden army within: Harnessing the microbiome to improve cancer treatment outcomes\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了微生物组通过调节 T 细胞记忆、药物代谢及 TLR4 通路影响 ICI 和化疗疗效的证据，并讨论 FMT、噬菌体等干预策略。适用于 CH01 确立微生物组作为疗效调节因子的背景地位，在 CH03 提供免疫调节与药物代谢的机制假设，并在 CH04 概述当前临床转化面临的标准化、伦理及监管障碍，为未来方向提供框架。\"\n    },\n    {\n      \"source_handle\": \"P0498\",\n      \"paper_title\": \"Improved overall survival in an anti-PD-L1 treated cohort of newly diagnosed glioblastoma patients is associated with distinct immune, mutation, and gut microbiome features: a single arm prospective phase I/II trial\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该前瞻性试验发现胶质母细胞瘤患者基线 Bacillota 门富集与抗 PD-L1 生存获益及高免疫浸润评分（EIS）相关，提示菌群可能“预热”免疫系统。适用于 CH01 提供“冷”肿瘤中微生物组预测价值的罕见临床证据，在 CH02 识别特定门水平标志物，并在 CH03 提出菌群通过塑造基线肿瘤免疫微环境（如激活 DC/M1 巨噬细胞）间接增强 ICI 疗效的机制假说。\"\n    },\n    {\n      \"source_handle\": \"P0499\",\n      \"paper_title\": \"An Insight on Gut Flora, Colorectal Cancer Mechanism, and Treatment Strategies\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述详述结直肠癌中阿克曼氏菌、双歧杆菌等有益菌及具核梭杆菌等致病菌通过 TLR 信号、代谢物（如 SN-38 葡萄糖醛酸化）及炎症通路调节 ICI 和化疗疗效的机制。适用于 CH02 列举 CRC 特异性菌群标志物，在 CH03 解析细菌酶活性及免疫调节的具体路径，并在 CH04 评估益生菌、FMT 及饮食干预在 CRC 管理中的应用潜力与争议。\"\n    },\n    {\n      \"source_handle\": \"P0500\",\n      \"paper_title\": \"Branched chain amino acids recruit NKT cells to enhance breast cancer response to ⍺PD-1 immune checkpoint blockade following bariatric surgery 3947\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该研究揭示减肥手术通过改变肠道菌群增加支链氨基酸（BCAA），进而招募 NKT 细胞增强乳腺癌 ICI 疗效的机制。适用于 CH03 提供微生物代谢物（BCAA）介导特定免疫细胞（NKT）招募的具体案例，并在 CH04 展示非药物干预（手术）通过重塑微生物组改善治疗响应的独特策略，同时指出人类数据有限及需进一步解析受体机制的局限。\"\n    },\n    {\n      \"source_handle\": \"P0501\",\n      \"paper_title\": \"Microbiome and cancer immunotherapy: a bibliometric analysis\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该文献计量分析描绘了领域从“肠道菌群 -ICI 关联”向“精准预测”和“工程菌”演变的学术图谱，指出高影响力期刊偏倚及缺乏 RCT 等证据缺口。适用于 CH01 梳理研究热点与发展阶段，并在 CH05 批判性评估现有证据质量（如阴性结果发表难、地域代表性不均），为未来优先开展标准化 RCT 及多组学整合研究提供宏观依据。\"\n    },\n    {\n      \"source_handle\": \"P0502\",\n      \"paper_title\": \"The human microbiome: an emerging paradigm for better health\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该早期综述确认了肠道微生物组通过调节 T 细胞浸润影响 ICI 疗效的概念，并指出抗生素削弱疗效的现象。适用于 CH01 提供领域发展的历史背景和理论基础，并在 CH03 作为初步机制假说（T 细胞浸润）的来源，提示需结合后续更深入的分子机制研究来充实这一框架，同时强调微生物组平衡而非单一菌种作用的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0503\",\n      \"paper_title\": \"Microbiota-derived metabolites: Key modulators of cancer immunotherapies.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述系统区分了 SCFA、胆汁酸、色氨酸代谢物在不同癌种和 ICI 类型（PD-1 vs CTLA-4）中的双向调节作用及具体受体机制（如 GPR41/43, AHR, TGR5）。适用于 CH01 解释临床异质性，在 CH02/CH03 提供从代谢物到免疫表型的详细分子链条，并在 CH04 评估代谢物补充剂及活体生物制品（LBP）的临床试验进展与失败教训（如 SER-401）。\"\n    },\n    {\n      \"source_handle\": \"P0504\",\n      \"paper_title\": \"Killing cancer takes guts: lessons learned from the manipulation of gut microbiome and immunotherapy for the future of urothelial carcinoma\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦尿路上皮癌，汇总了阿克曼氏菌等菌属与 ICI 疗效的关联，详述 FMT、益生菌干预的早期临床数据及免疫相关不良事件（irAEs）的微生物预测特征。适用于 CH01/CH02 提供癌种特异性证据，在 CH03 解析微生物调节 T 细胞 priming 及代谢物（如 trigonelline）作用的机制，并在 CH04 讨论 FMT 制备标准、安全性及 irAEs 管理的临床转化挑战。\"\n    },\n    {\n      \"source_handle\": \"P0505\",\n      \"paper_title\": \"Combination therapy with levofloxacin and the probiotic Clostridium butyricum MIYAIRI 588 enhances immune checkpoint inhibitor efficacy\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该小鼠研究发现左氧氟沙星联合丁酸梭菌可增强 ICI 疗效并增加 CD8+ T 细胞浸润，但加重结肠炎，而广谱抗生素联合则无效。适用于 CH01 展示“抗生素 - 益生菌”精准组合策略的潜力，在 CH03 提示 T 细胞活化与 irAEs 风险的权衡机制，并在 CH04 强调干预策略需平衡抗肿瘤获益与炎症毒性，且特定抗生素选择至关重要。\"\n    },\n    {\n      \"source_handle\": \"P0506\",\n      \"paper_title\": \"Combination strategies of gut microbiota in cancer therapy through metabolic reprogramming and immune remodeling\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述详述双歧杆菌、阿克曼氏菌等通过 cGAS/STING 通路、分子模拟及代谢物信号增强 ICI 疗效的机制，并讨论 FMT 和益生菌的临床应用。适用于 CH01/CH02 汇总跨癌种证据，在 CH03 整合免疫重塑与代谢重编程的双重机制，并在 CH04 评估联合策略的可行性，同时指出动物模型数据向人类转化时的复杂性及个体差异挑战。\"\n    },\n    {\n      \"source_handle\": \"P0507\",\n      \"paper_title\": \"Research Progress of Metabolites of Intestinal Microbiota Reshaping Tumor Immune Microenvironment and Immunotherapy Response Through PD-1/PD-L1 Pathway\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述构建了微生物代谢物通过受体依赖信号和表观遗传编程重塑肿瘤免疫微环境（TIME）的理论框架，提出“冷 - 热”肿瘤转化概念。适用于 CH03 提供机制分类的高阶视角（信号转导 vs 表观修饰），并在 CH04 讨论 FMT 等策略在恢复 TIME 敏感性中的应用潜力，同时强调需进一步解析具体分子靶点以指导精准干预。\"\n    },\n    {\n      \"source_handle\": \"P0508\",\n      \"paper_title\": \"Impact of antibiotic use on survival in patients with advanced cancers treated on immune checkpoint inhibitor phase I clinical trials.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该研究尝试在泛实体瘤 I 期试验队列中评估抗生素对生存的影响，虽结果缺失但确立了研究范式。适用于 CH01 作为探索抗生素效应在非典型癌种（非 RCC/NSCLC）中普遍性的背景案例，并在 CH05 指出 I 期试验人群的选择偏倚及缺乏分层数据对结论外推的限制，强调需在更广泛人群中验证抗生素 - 微生物 -ICI 轴的临床意义。\"\n    },\n    {\n      \"source_handle\": \"P0509\",\n      \"paper_title\": \"The microbiome as a systems-level regulator of immune, metabolic, neural, and endocrine signaling in cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述提出微生物组通过免疫、代谢及神经轴（如迷走神经）系统性调节 ICI 疗效的整合框架，详述 MAMPs、代谢物及神经信号通路。适用于 CH01 确立系统性调节视角，在 CH02/CH03 提供多通路互作的机制细节，并在 CH05 批判性评估因果推断困难及方法学偏差，强调需考虑肿瘤类型特异性及个体差异对微生物效应的修饰作用。\"\n    },\n    {\n      \"source_handle\": \"P0510\",\n      \"paper_title\": \"Abstract C023: A microbiome-produced metabolite drives immunostimulatory macrophages and boosts response to immune checkpoint inhibitors in pancreatic cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该摘要报道微生物代谢物 TMAO 通过激活 I 型干扰素通路促进巨噬细胞免疫刺激性表型，从而增强胰腺癌 ICI 疗效，且患者体内 CutC 基因丰度与响应正相关。适用于 CH02 提供难治性肿瘤中潜在的微生物代谢标志物，并在 CH03 阐述 TMAO-IFN-巨噬细胞轴的具体机制，提示即使在免疫冷肿瘤中，靶向微生物代谢物也可能逆转耐药。\"\n    },\n    {\n      \"source_handle\": \"P0511\",\n      \"paper_title\": \"Meta-analysis of the gut microbiota in predicting response to cancer immunotherapy in metastatic melanoma\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该荟萃分析确认了普氏粪杆菌、维生素 B 代谢通路与黑色素瘤 ICI 响应的跨队列关联，但指出预测模型精度有限。适用于 CH01/CH02 提供经过统计综合的稳健标志物列表，在 CH03 提出维生素 B 代谢作为潜在机制线索，并在 CH05 强调功能层面（代谢通路）比单一物种更具泛化性，同时指出当前模型需整合多组学数据以提升预测力。\"\n    },\n    {\n      \"source_handle\": \"P0512\",\n      \"paper_title\": \"Moving on from Metchnikoff: thinking about microbiome therapeutics in cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该观点文章汇总了 FMT 传递敏感性及抗生素破坏疗效的关键证据，提出“后微生物组相互作用”范式，并讨论窄谱抗生素、益生元等干预策略。适用于 CH01 确立微生物组影响 ICI 的核心观察事实，在 CH03 提供 TILs 增加等初步机制解释，并在 CH04 评估不同干预工具（FMT vs 益生菌 vs 饮食）的优缺点及监管挑战，为未来治疗路线图提供参考。\"\n    },\n    {\n      \"source_handle\": \"P0513\",\n      \"paper_title\": \"Microbiome–Driven Carcinogenesis and Circulating Microbial Signals in Genitourinary Cancers\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述发现泌尿生殖肿瘤中循环 EV 相关细菌 DNA 信号（如厚壁菌门、拟杆菌纲）与 ICI 预后及免疫表型（Treg 浸润）相关。适用于 CH01/CH02 提供液体活检新维度的预测标志物，在 CH03 阐述微生物信号通过全身炎症及免疫微环境调节 ICI 疗效的机制，并在 CH05 强调低生物量样本检测的技术挑战及因果链条验证的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0514\",\n      \"paper_title\": \"Gut microbiota in colorectal cancer: a review of its influence on tumor immune surveillance and therapeutic response\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述详述结直肠癌中微生物多样性、特定菌群（阿克曼氏菌、具核梭杆菌）及代谢物（SCFA）通过调节 Treg/DC 功能及 Wnt 通路影响 ICI 疗效的机制。适用于 CH01/CH02 汇总 CRC 特异性证据，在 CH03 解析免疫细胞亚群及信号通路的中介作用，并在 CH04 评估 FMT 联合抗 PD-1 的协同效应及标准化方案缺失的现状，强调需区分肿瘤类型特异性。\"\n    },\n    {\n      \"source_handle\": \"P0515\",\n      \"paper_title\": \"Gut Microbiota-Derived Metabolites in Cancer Immunotherapy: Mechanisms and Clinical Potential\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述系统拆解 SCFA、胆汁酸、色氨酸代谢物三大类分子通过 HDAC 抑制、GPCR 激活及 AhR 途径调节 T 细胞、巨噬细胞功能的机制，并评估 FMT 及代谢物补充的临床潜力。适用于 CH02/CH03 提供分子层面的详细机制图谱，在 CH04 讨论从相关性向因果干预转化的难点（如药代动力学），并在 CH05 指出个体异质性及多组学整合的未来方向。\"\n    },\n    {\n      \"source_handle\": \"P0516\",\n      \"paper_title\": \"The gut microbiome and gastrointestinal cancers: mechanisms, biomarkers and therapeutic opportunities\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦胃肠道癌症，详述阿克曼氏菌等有益菌及具核梭杆菌通过免疫调节、炎症状态及酶活性影响 ICI 疗效的机制，并讨论抗生素干扰及 FMT 干预。适用于 CH01-CH04 提供癌种特异性的全面证据链（从标志物到机制再到干预），并在 CH05 指出方法学异质性、因果推断困难及全球代表性偏差等关键局限，为未来研究设定优先事项。\"\n    },\n    {\n      \"source_handle\": \"P0517\",\n      \"paper_title\": \"The effects of antibiotics on the efficacy of immune checkpoint inhibitors in patients with non-small-cell lung cancer differ based on PD-L1 expression.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该研究发现抗生素仅在 PD-L1 高表达（≥50%）的 NSCLC 患者中显著降低 ICI 疗效，揭示了宿主生物标志物对微生物干扰效应的修饰作用。适用于 CH01 提供抗生素负面影响的情境依赖性证据，并在 CH05 强调疗效异质性不仅源于微生物组本身，还受宿主肿瘤特征（如 PD-L1 状态）交互影响，提示未来研究需进行更精细的患者分层分析。\"\n    },\n    {\n      \"source_handle\": \"P0518\",\n      \"paper_title\": \"Regulation of PD‐1PD‐L1 Immune Checkpoints by Gut Microbiota Metabolites and Their Clinical Translational Research: A Review\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述详述微生物代谢物（丁酸盐、犬尿氨酸、胆汁酸）通过表观遗传（HDAC-FOXO1）、受体信号（AhR, FXR）及代谢重编程双向调节 PD-1/PD-L1 表达的机制，并评估生物标志物及干预策略。适用于 CH02/CH03 提供具体的分子调控路径，在 CH04 讨论从 FMT 向工程菌及精准代谢物补充的演进，并在 CH05 强调剂量及肿瘤类型依赖性带来的转化挑战。\"\n    },\n    {\n      \"source_handle\": \"P0519\",\n      \"paper_title\": \"Gut Microbiota Dysbiosis, Oxidative Stress, Inflammation, and Epigenetic Alterations in Metabolic Diseases\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"虽聚焦代谢病，该综述详述 SCFA 等代谢物通过抑制 HDAC 调节组蛋白乙酰化及 DNA 甲基化的表观遗传机制。适用于 CH03 作为通用生物学原理素材，解释肠道微生物如何通过表观遗传修饰影响宿主基因表达（如 T 细胞分化相关基因），为理解其在肿瘤免疫微环境中潜在的免疫调节作用提供机制类比和理论支撑，需注明疾病背景差异。\"\n    },\n    {\n      \"source_handle\": \"P0520\",\n      \"paper_title\": \"PD-1/PD-L1 Cancer Immunotherapeutics Reshape Tumor Microenvironment – Clinical Evidence and Molecular Mechanisms for AI-based Precision Medicine\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该综述列举了四种特定细菌（长双歧杆菌、普氏粪杆菌等）及其代谢物改善 ICI 疗效的临床关联，并详述泛素化修饰（UPS）调控 PD-1/PD-L1 稳定性的分子机制。适用于 CH01/CH02 提供具体菌种证据，在 CH03 提出微生物组可能通过影响宿主泛素化 machinery 间接调节免疫检查点的新颖机制假设，同时指出 AI 在解析复杂互作网络中的潜力。\"\n    },\n    {\n      \"source_handle\": \"P0521\",\n      \"paper_title\": \"The gut-tumor connection: the role of microbiota in cancer progression and treatment strategies\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述系统拆解了微生物通过免疫调节、代谢控制、空间易位及跨物种信号四大路径影响 ICI 疗效的机制，列举具体菌种、代谢物及 FMT 临床案例。适用于 CH01-CH04 提供从分类学到功能机制再到干预策略的全景式素材，并在 CH05 指出癌种特异性、双向性及方法学标准化缺失等关键挑战，为构建综合叙事提供核心框架。\"\n    },\n    {\n      \"source_handle\": \"P0522\",\n      \"paper_title\": \"The Impact of the Microbiome on Resistance to Cancer Treatment with Chemotherapeutic Agents and Immunotherapy\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了阿克曼氏菌、双歧杆菌等与 ICI 疗效正相关及拟杆菌等与耐药相关的临床数据，详述免疫调节（DC 成熟、T 细胞浸润）及代谢产物（SCFA 双重作用）机制，并记录抗生素负面影响及 FMT 逆转耐药案例。适用于 CH01-CH04 提供跨癌种的丰富证据和机制细节，特别强调 SCFA 在不同情境下的悖论效应，提醒避免过度简化。\"\n    },\n    {\n      \"source_handle\": \"P0523\",\n      \"paper_title\": \"Gut-targeted strategies at the intersection of radiotherapy and immunotherapy\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该评论文章详述微生物代谢物（SCFA、胆汁酸）的双向免疫调节机制，并批判性分析放疗诱导微生物改变的局限（如毒性、归因模糊）。适用于 CH01 提供代谢物介导效应的背景，在 CH03 解释机制的情境依赖性，并在 CH04 论证直接微生物调控（如口服万古霉素、噬菌体）相比依赖放疗非特异性效应更具可控性和安全性，提供策略比较视角。\"\n    },\n    {\n      \"source_handle\": \"P0524\",\n      \"paper_title\": \"Challenges and knowledge gaps with immune checkpoint inhibitors monotherapy in the management of patients with non-small-cell lung cancer: a survey of oncologist perceptions\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该调查显示 61% 肿瘤医生认为调节肠道菌群可增加 ICI 疗效，并将抗生素使用视为重要挑战。适用于 CH01 反映临床界面对微生物组干预潜力的认可度及证据不足的现状，并在 CH05 指出真实世界临床决策（如脑转移、合并症管理）与试验证据的差距，强调需开展针对复杂临床情境的研究以指导常规实践。\"\n    },\n    {\n      \"source_handle\": \"P0525\",\n      \"paper_title\": \"Modeling the effect of gut microbiome on therapeutic efficacy of immune checkpoint inhibitors against cancer.\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该计算模型研究预测初始有益菌水平及生长率是黑色素瘤 ICI 响应的关键决定因素，并提出通过调节菌群状态可转化无响应者。适用于 CH02 提供基于动力学的预测标志物视角，并在 CH03 展示理论机制模拟如何桥接临床异质性与微生物因素，同时强调模型假设依赖性及需实验验证因果链条的局限。\"\n    },\n    {\n      \"source_handle\": \"P0526\",\n      \"paper_title\": \"The role of the gut microbiome in regulating the response to immune checkpoint inhibitor therapy.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述确认微生物组组成差异是解释 ICI 预后异质性的关键因素，指出抗生素/PPI 等药物干扰及动态建模的重要性。适用于 CH01 确立微生物组 - 免疫轴的背景地位，在 CH03 引出需深入探讨的具体分子机制，并在 CH05 强调从静态组成分析向动态监测和干预转化的趋势，指出当前研究在特异性物种鉴定及因果验证上的空白。\"\n    },\n    {\n      \"source_handle\": \"P0527\",\n      \"paper_title\": \"Microbiome and gut-liver interactions: From mechanisms to therapies\",\n      \"chapter_ids\": [],\n      \"specific_usable_material\": \"该综述聚焦肝病而非实体瘤或 ICI 治疗，虽讨论胆汁酸代谢及肠道通透性等通用机制，但缺乏肿瘤免疫背景下的直接证据。鉴于其研究对象与综述主题（实体瘤 ICI 疗效）不匹配，且无法提供特异性机制或临床数据，故不纳入，以避免将肝病机制不当外推至肿瘤免疫场景。\"\n    },\n    {\n      \"source_handle\": \"P0528\",\n      \"paper_title\": \"Advances in Brain–Gut–Microbiome Interactions: A Comprehensive Update on Signaling Mechanisms, Disorders, and Therapeutic Implications\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该综述详述微生物通过代谢物（SCFA、色氨酸）及免疫途径（Treg 诱导）调节宿主生理的通用机制，虽未涉及肿瘤，但提供了基础生物学原理。适用于 CH03 作为背景素材，解释微生物系统性调节免疫稳态的能力，为理解其在肿瘤微环境中特异性免疫调节作用提供理论支撑，同时警示需区分神经/胃肠疾病机制与肿瘤免疫场景的差异。\"\n    },\n    {\n      \"source_handle\": \"P0529\",\n      \"paper_title\": \"Recent advances in understanding pancreatic cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该综述指出胰腺癌肿瘤内细菌清除可重编程微环境（减少 MDSCs、促进 CD8+ T 细胞）并上调 PD-1，理论上增强 ICI 疗效。适用于 CH01 提供“冷”肿瘤中微生物调节免疫状态的背景，在 CH02 提及肿瘤内菌群作为潜在靶点，并在 CH03 解析免疫抑制微环境构成及代谢串扰机制，强调 PDAC 特殊性对外推至所有实体瘤的限制。\"\n    },\n    {\n      \"source_handle\": \"P0530\",\n      \"paper_title\": \"Prediction, prevention, and precision treatment of immune checkpoint inhibitor neurological toxicity using autoantibodies, cytokines, and microbiota\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"该综述列举拟杆菌、链球菌等菌属与 ICI 诱导的免疫相关不良事件（irAEs）易感性的关联，虽无 n-irAEs 特异性签名，但提供了微生物调节宿主免疫（T/B 细胞交互）的机制线索。适用于 CH01/CH02 提供微生物预测毒性的证据，并在 CH03 解释微生物通过塑造宿主免疫基线影响 ICI 反应性和毒性的潜在路径，强调机制相通性。\"\n    },\n    {\n      \"source_handle\": \"P0531\",\n      \"paper_title\": \"Clinical utility of tumour mutational burden on efficacy of immune checkpoint inhibitors in malignant solid tumours: protocol for a systematic review and meta-analysis\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该方案确立了评估 TMB 与 ICI 疗效关联的分析框架及关键调节变量（测序技术、联合治疗）。适用于 CH05 作为对照基准，说明宿主基因组特征（TMB）与外在因素（微生物）交互作用的复杂性，指出方法学异质性（如阈值定义、平台差异）如何影响预测效能，强调未来研究需整合多维数据以解析耐药机制。\"\n    },\n    {\n      \"source_handle\": \"P0532\",\n      \"paper_title\": \"Focus on gut microbes: new direction in cancer treatment\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述详述双歧杆菌、阿克曼氏菌等通过 STING 通路、T 细胞浸润及代谢物（SCFA）增强 ICI 疗效的机制，列举具核梭杆菌耐药案例及 FMT 临床证据。适用于 CH01-CH04 提供从标志物到机制再到干预的全面素材，并在 CH05 讨论个体差异、安全性及 AI/合成生物学在精准医疗中的应用前景，强调从关联向因果转化的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0533\",\n      \"paper_title\": \"Tumor-Associated Microbiome: Where Do We Stand?\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该综述汇总多癌种中微生物组与 ICI 反应关联的观察性证据，提出交叉反应性 T 细胞、MAMPs 激活 DC 等机制假说，并报告 FMT 在黑色素瘤中的 I 期临床结果。适用于 CH01-CH03 提供跨癌种背景及机制框架，并在 CH04 作为微生物干预改善 ICI 疗效的直接临床证据案例，同时强调方法学局限及需结合最新文献更新结论。\"\n    },\n    {\n      \"source_handle\": \"P0534\",\n      \"paper_title\": \"Gut Microbiome Modulation and Outcomes of Immune Checkpoint Inhibitors in Solid Tumors: A Secondary Qualitative Review\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该定性综述提出从“分类学”向“功能/生态系统”范式转变，强调基线生态签名、抗生素干扰风险及治疗性工程潜力。适用于 CH01-CH04 整合临床观察为理论框架，解释生态韧性及癌症免疫循环概念，并在 CH05 批判性评估方法学缺陷（小样本、混杂因素），指出需开展标准化 RCT 以验证干预策略的临床效用。\"\n    },\n    {\n      \"source_handle\": \"P0535\",\n      \"paper_title\": \"Intratumoral Microbiota in Tumor: Current Understandings and Future Perspectives\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该综述详述瘤内细菌（如具核梭杆菌、双歧杆菌）通过直接调节 PD-L1、代谢物（琥珀酸、I3A）及 STING 通路影响 ICI 疗效的机制。适用于 CH02/CH03 拓展生态位概念，提供局部菌群介导免疫抑制或增强的具体路径，并在 CH04 讨论靶向瘤内菌的治疗策略，同时在 CH05 强调区分肠道与瘤内菌群及低生物量检测技术挑战的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0536\",\n      \"paper_title\": \"肠道菌群调控肿瘤免疫应答的机制及其临床转化潜力 (Mechanisms of Gut Microbiota Regulating Tumor Immune Response and Their Potential for Clinical Translation)\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"该中文综述概括了肠道菌群通过模式识别受体、SCFA 及色氨酸代谢物调控抗肿瘤免疫的机制，并提及 FMT 在黑色素瘤中的突破及抗生素负面效应。适用于 CH01 提供临床关联证据，在 CH03 构建机制分类框架，并在 CH04 概述微生物靶向策略（FMT、益生菌、饮食）的转化潜力与挑战，作为连接基础与临床的桥梁素材。\"\n    },\n    {\n      \"source_handle\": \"P0537\",\n      \"paper_title\": \"Impact of proton pump inhibitors on immunotherapy is modulated by prior chemotherapy and linked to gut microbiome–immune cell signatures\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"该研究发现 PPI 使