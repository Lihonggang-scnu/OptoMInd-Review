{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0121\",\n      \"paper_title\": \"Characterization of gut microbiota in patients with primary hepatocellular carcinoma received immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"提供 HCC 患者中 Faecalibacterium 富集与 PFS 延长、Bacteroidales 富集与耐药相关的观察性证据。作为肝癌特异性背景下微生物标志物的案例，用于对比其他实体瘤中同类菌属作用的异同，并提示口腔 - 肠道微生物同步变化的监测潜力。\"\n    },\n    {\n      \"source_handle\": \"P0122\",\n      \"paper_title\": \"Microbial Ecosystem Therapeutics 4 (MET4) elicits treatment-specific IgG responses associated with changes in gut microbiota in immune checkpoint inhibitor recipients with advanced solid tumors\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"记录 MET4 联合体干预后宿主产生特异性 IgG 及外周免疫细胞（B 细胞、Treg）重塑的现象，提出“佐剂样菌”触发异源免疫反应的假说。用于阐述微生物干预诱导全身性体液免疫的机制，并作为早期活体生物药临床试验的安全性及免疫原性参考。\"\n    },\n    {\n      \"source_handle\": \"P0123\",\n      \"paper_title\": \"Non-Small Cell Lung Cancer Patients Treated with Anti-PD1 Immunotherapy Show Distinct Microbial Signatures and Metabolic Pathways According to Clinical Outcomes\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"在 NSCLC 队列中识别 Alistipes 等有益菌与链球菌等有害菌，并发现代谢通路特征预测 PD-L1 状态优于分类学特征。提供化疗预处理及抗酸药使用干扰菌群并影响预后的证据，用于讨论功能特征作为生物标志物的潜力及混杂因素控制。\"\n    },\n    {\n      \"source_handle\": \"P0124\",\n      \"paper_title\": \"THE MICROBIOME–HOST AXIS IN CANCER THERAPY: MECHANISMS SHAPING IMMUNOTHERAPY EFFICACY AND TREATMENT TOXICITY\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述肌苷通过 A2A 受体增强 Th1 分化、SCFAs 通过表观遗传修饰增强 CD8+ T 细胞功能的具体机制，并提及瘤内微生物酶降解化疗药物的路径。用于构建代谢物介导免疫调节的理论框架，同时指出性别差异及长期菌群失调对幸存者健康的影响作为未来研究方向。\"\n    },\n    {\n      \"source_handle\": \"P0125\",\n      \"paper_title\": \"376 A phase I/II study of live biotherapeutic MRx0518 in combination with pembrolizumab in patients refractory to immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"描述 MRx0518 单菌株联合 PD-1 抑制剂治疗耐药实体瘤的 I/II 期试验设计及“耐药”的操作定义。虽无疗效结果，但提供了活体生物药克服耐药的临床转化路径实例，以及基于前体研究的免疫调节机制假设（减少 Treg、增加 Th1），用于展示早期干预策略的可行性与挑战。\"\n    },\n    {\n      \"source_handle\": \"P0126\",\n      \"paper_title\": \"More fuel for the fire: Gut microbes and toxicity to immune agonist antibodies in cancer\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"阐明肠道微生物通过 MyD88 通路介导免疫激动剂抗体（如抗 CD40/CD137）毒性的机制，对比其与 ICI 通过 STING 通路增强疗效的差异。用于解释微生物驱动过度炎症导致毒性的生物学路径，并警示广谱抗生素虽减毒但损害疗效的复杂性，引导至精准靶向策略。\"\n    },\n    {\n      \"source_handle\": \"P0127\",\n      \"paper_title\": \"Efficacy of immune checkpoint inhibitors in microsatellite unstable/mismatch repair-deficient advanced pancreatic adenocarcinoma: an AGEO European Cohort.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供 MSI/dMMR 胰腺癌患者对 ICI 高响应率的临床数据，作为“冷”肿瘤在特定分子亚型下转化为“热”肿瘤的极端案例。虽无菌群数据，但确立了分子标志物对疗效的决定性作用及治疗时机的重要性，用于对比讨论为何需引入微生物组作为补充预测因子以解释剩余异质性。\"\n    },\n    {\n      \"source_handle\": \"P0128\",\n      \"paper_title\": \"Harnessing the microbiome for cancer therapy\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"构建微生物组通过调节特定免疫细胞（CD8+ T、MDSCs 等）及屏障完整性影响 ICI 疗效的概念框架。列举粪菌移植、饮食等干预策略，并指出当前机制研究多基于动物模型及缺乏标准化方法的局限，用于综述背景引入及方法学反思。\"\n    },\n    {\n      \"source_handle\": \"P0129\",\n      \"paper_title\": \"Relating Gut Microbiome and Its Modulating Factors to Immunotherapy in Solid Tumors: A Systematic Review\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"汇总厚壁菌门/疣微菌门富集与良好疗效正相关、变形菌门与不良疗效负相关的跨癌种观察性证据。明确抗生素使用时机（治疗前 2 个月内）的负面效应及植物性饮食的潜在益处，用于确立微生物群作为生物标志物的临床关联强度及生活方式干预的逻辑基础。\"\n    },\n    {\n      \"source_handle\": \"P0130\",\n      \"paper_title\": \"Gut microbiome modulates efficacy of immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"综述双歧杆菌、AKK 等促进疗效及拟杆菌属作用矛盾的具体证据，详细阐述通过增强 DC 成熟、调节 Treg 分化及分子模拟介导效应的机制。用于区分不同 ICI 类型（PD-1 vs CTLA-4）受微生物影响的差异性，并展示物种水平一致性与冲突性的现状。\"\n    },\n    {\n      \"source_handle\": \"P0131\",\n      \"paper_title\": \"The Emerging Role of the Gut Microbiome in the Cancer Response to Immune Checkpoint Inhibitors: A Narrative Review\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"将影响 ICI 疗效的微生物因素分类为基线组成、菌群失调及抗生素诱导变化三个维度，确立微生物组作为关键生物标志物的地位。用于综述引言部分构建逻辑框架，并引出优化菌群组成作为未来干预方向的理论依据及当前证据缺口。\"\n    },\n    {\n      \"source_handle\": \"P0132\",\n      \"paper_title\": \"Human Microbiome and Its Medical Applications\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"列举 Roseburia hominis 等与 ICI 响应相关的菌属，阐述通过 cGAS/STING 轴激活 DC 及 CD8+ T 细胞的机制。介绍工程菌递送纳米抗体或 GM-CSF 的前沿策略及肿瘤内微生物组的存在，用于补充代谢与免疫互作机制及合成生物学干预的新视角。\"\n    },\n    {\n      \"source_handle\": \"P0133\",\n      \"paper_title\": \"Predictive Biomarkers and Resistance Mechanisms of Checkpoint Inhibitors in Malignant Solid Tumors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"列出 Akkermansia、Faecalibacterium 等有益菌及大肠杆菌等耐药相关菌，阐述通过增加 IL-2/IFN-γ、调节代谢产物介导效应的机制。结合现有标志物（PD-L1、TMB）的局限性，论证引入微生物组作为多模态预测工具的必要性及克服耐药的潜在路径。\"\n    },\n    {\n      \"source_handle\": \"P0134\",\n      \"paper_title\": \"Fluctuations in Gut Microbiome Composition During Immune Checkpoint Inhibitor Therapy\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"提供 NSCLC 患者治疗期间微生物组动态变化（波动 vs 稳定）与疗效相关的纵向观察证据，指出响应者中 Clostridium sensu stricto 1 增加及无响应者中 Akkermansia 减少的趋势。用于论证将治疗期间微生物组监测纳入疗效评估体系的潜力及动态生物标志物的价值。\"\n    },\n    {\n      \"source_handle\": \"P0135\",\n      \"paper_title\": \"Impact of Proton Pump Inhibitor Use on Progression-Free and Overall Survival in Cancer Patients Undergoing Immune Checkpoint Inhibitor Therapy: A Systematic Review and Meta-Analysis of Recent Studies\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"荟萃分析证实 PPI 使用与 ICI 治疗后 OS 缩短显著相关（HR=1.18），提出 PPI 通过改变肠道 pH 导致菌群失调、促进 Treg 分化从而抑制抗肿瘤免疫的机制假说。用于提供临床流行病学证据，强调常规药物管理对维持菌群完整性及 ICI 疗效的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0136\",\n      \"paper_title\": \"Gut microbiota influences the efficiency of immune checkpoint inhibitors by modulating the immune system (Review)\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"汇总 Akkermansia/Bifidobacterium 与疗效正相关及抗生素负面影响的观察数据，详述 SCFAs、PSA 等代谢物调节 Treg/Th17 分化的机制。指出不同肿瘤类型结果异质性及益生菌效果的双面性，用于全面映射微生物 - 免疫互作景观及干预策略的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0137\",\n      \"paper_title\": \"Gut metatranscriptomics based de novo assembly reveals microbial signatures predicting immunotherapy outcomes in non-small cell lung cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"利用宏转录组学发现放线菌/古菌高转录活性与短 PFS 相关，而厚壁菌代谢活跃与长 PFS 相关，揭示微生物功能状态（转录活性）比静态丰度更具预测价值。提出 DNA 修复/应激反应通路与疗效的关联，用于论证从“存在”到“活跃”的研究范式转变及功能机制线索。\"\n    },\n    {\n      \"source_handle\": \"P0138\",\n      \"paper_title\": \"770 Analysis of gut microbiome in patients receiving adoptive T-cell therapy (ACT) across different solid tumour types\",\n      \"chapter_ids\": [\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"作为 ACT 治疗背景下微生物组变化的早期探索性证据，提示淋巴清除前抗生素使用对菌群的干扰及响应者/非响应者菌群分布差异。虽样本量小且非 ICI 直接研究，但可用于讨论不同免疫治疗策略下微生物组影响的异同及药物暴露作为关键混杂因素的方法学警示。\"\n    },\n    {\n      \"source_handle\": \"P0139\",\n      \"paper_title\": \"Immunotherapy resistance in non-small cell lung cancer: from mechanisms to therapeutic opportunities\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"阐述微生物失调通过色氨酸代谢途径（IDO1 激活、犬尿氨酸积累）抑制 T 细胞并促进 Treg 分化的机制，提出补充益生菌及联合 IDO 抑制剂逆转耐药的策略。结合 NSCLC 亚型特征，用于深入解析代谢介导的耐药机制及针对性干预方案的未来方向。\"\n    },\n    {\n      \"source_handle\": \"P0140\",\n      \"paper_title\": \"Gut microbiome and metabolic health: mechanisms and precision interventions\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"详述 LPS 介导的系统性炎症及 SCFAs/胆汁酸通过 GPCR 和表观遗传调控宿主免疫的通用机制，提出“精准微生物组干预三角形”概念。虽聚焦代谢疾病，但为理解微生物组塑造全身免疫状态及炎症水平提供背景，用于类比解释肿瘤免疫微环境的调节基础及个体化干预框架。\"\n    },\n    {\n      \"source_handle\": \"P0141\",\n      \"paper_title\": \"Genetic heterogeneity of colorectal cancer and the microbiome\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"在结直肠癌背景下，确认 Akkermansia、厚壁菌门与 ICI 疗效正相关，变形菌门与耐药相关。阐述通过增强 CD8+ T 细胞浸润、维持屏障完整性及丁酸盐抑制 HDAC 等机制，并指出 Fusobacterium 等致病菌的基因毒性作用，用于细化特定癌种中微生物标志物及机制的特异性。\"\n    },\n    {\n      \"source_handle\": \"P0142\",\n      \"paper_title\": \"Optimizing Cancer Treatment Through Gut Microbiome Modulation\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"跨癌种汇总 Akkermansia、Faecalibacterium 等有益菌及肌苷、SCFAs 等代谢物介导 T 细胞激活、屏障修复的机制。列举正在进行的 FMT、益生菌及工程菌临床试验，用于展示从机制发现到临床转化的全景图，并强调宿主代谢状态对微生物 - 治疗互作的影响。\"\n    },\n    {\n      \"source_handle\": \"P0143\",\n      \"paper_title\": \"Impact of CBM588 on gut microbiome composition and dysbiosis in patients receiving frontline immune checkpoint inhibitor (ICI) combinations for metastatic renal cell carcinoma (mRCC).\",\n      \"chapter_ids\": [\n        \"CH04\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"报告 mRCC 患者中益生菌 CBM588 阻止有益菌 Eubacterium siraeum 耗竭并改善 F/B 比率的早期临床数据。虽未直接报告疗效终点，但提供了特定菌株逆转 ICI 诱导菌群失调的实证，用于支持益生菌作为辅助干预措施的可行性及特定微生物标志物的动态监测价值。\"\n    },\n    {\n      \"source_handle\": \"P0144\",\n      \"paper_title\": \"Gut Microbiome Control of Tumor Immune Checkpoint Inhibitor Response: Mechanistic Insights and Clinical Translation\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统梳理 Akkermansia 等标志物及 SCFAs、肌苷、色氨酸衍生物通过 PRR 信号、T 细胞重编程介导疗效的机制，同时讨论微生物群与 irAEs（结肠炎、肺炎）的关联。评估 FMT 转化潜力及标准化挑战，用于构建从分子机制到临床安全性及转化瓶颈的完整证据链。\"\n    },\n    {\n      \"source_handle\": \"P0145\",\n      \"paper_title\": \"Microbiome-Gut-Liver Axis in Chronic Inflammation and Cancer Immunotherapy: Multi-omics Insights and a Translational Roadmap Toward Personalized Medicine.\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"聚焦肝癌，阐述菌群失调通过胆汁酸代谢改变、屏障受损引发全身炎症及特定代谢物调控 T 细胞的机制。讨论 FMT、工程菌及多组学整合在个性化医疗中的转化路线图，用于提供器官特异性轴（肠 - 肝）的机制细节及未来精准干预的技术路径。\"\n    },\n    {\n      \"source_handle\": \"P0146\",\n      \"paper_title\": \"Gut microbiota shapes cancer immunotherapy responses\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"全面综述 Akkermansia、双歧杆菌等标志物及分子模拟、代谢物调节、TLS 重塑等机制，涵盖 FMT、饮食及工程菌干预策略。强调癌种特异性及方法学异质性对结果的影响，用于作为核心参考源映射微生物 -ICI 互作的全景，并指出标准化与因果验证的未来方向。\"\n    },\n    {\n      \"source_handle\": \"P0147\",\n      \"paper_title\": \"Tumor associated depression, gut microbiota, and immune checkpoint inhibitor sensitivity\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提出心理因素（抑郁）通过肠 - 脑轴改变菌群组成、激活 HPA 轴及色氨酸代谢途径，进而抑制 T 细胞功能并降低 ICI 敏感性的假说。用于拓展宿主因素维度，解释非肿瘤生物学因素如何通过微生物中介影响疗效，并提示心理 - 微生物联合干预的潜在价值。\"\n    },\n    {\n      \"source_handle\": \"P0148\",\n      \"paper_title\": \"Response to immune checkpoint inhibition is associated with the gut microbiome in advanced KRAS-mutated non-small cell lung cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"在 KRAS 突变 NSCLC 亚群中，发现 SCFA 产生菌及 Akkermansia 与响应相关，而拟杆菌属与无响应相关。指出响应者中促炎通路富集挑战“健康菌群”假说，并关联特定菌群与 irAEs，用于论证肿瘤基因型对微生物标志物的修饰作用及炎症信号在疗效中的双重角色。\"\n    },\n    {\n      \"source_handle\": \"P0149\",\n      \"paper_title\": \"Immune checkpoint inhibitor-induced myocarditis is dependent on CD8 T cell-derived TNF and TNFR2 signaling.\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"揭示 ICI 诱导心肌炎依赖 CD8+ T 细胞来源的 TNF 及 TNFR2 信号，而非直接细胞毒性。虽未涉及菌群，但提供了 irAEs 的特定细胞因子机制，用于对比讨论微生物群可能通过调节全身炎症水平或 TNF 表达间接影响心脏安全性，丰富毒性机制的多层次理解。\"\n    },\n    {\n      \"source_handle\": \"P0150\",\n      \"paper_title\": \"Understanding the role of the gut microbiome in solid tumor responses to immune checkpoint inhibitors for personalized therapeutic strategies: a review\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"汇总抗生素负面影响及 FMT/LBP 干预数据，详述 Enterococcus MDP、肌苷等通过 STING/NOD2/A2AR 通路调节免疫的机制。分析 SER-401 试验失败原因（万古霉素预处理），用于强调宿主微环境对干预效果的决定性作用，并提供预测模型性能及癌症类型异质性的关键参考。\"\n    },\n    {\n      \"source_handle\": \"P0151\",\n      \"paper_title\": \"Unraveling the gut microbiome's contribution to pancreatic ductal adenocarcinoma: mechanistic insights and therapeutic perspectives\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"聚焦胰腺癌，阐述 TMAO 激活 I 型干扰素、LPS 上调 PD-L1 及真菌 - 宿主互作介导 ICI 疗效的机制。讨论抗生素使用的矛盾结果及 FMT、益生菌等干预策略，用于解析“冷”肿瘤中微生物调节的特殊性及多机制（代谢、免疫细胞、抗原呈递）协同作用的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0152\",\n      \"paper_title\": \"Natural polysaccharides as immune adjuvants to overcome immune checkpoint inhibitor resistance: mechanistic insights, clinical evidence, and translational challenges\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"详述天然多糖通过富集 Akkermansia/双歧杆菌及增加 SCFAs 重塑菌群，进而逆转 TAM 极化、减轻 T 细胞耗竭的机制。指出过度发酵在失调肠道中的潜在风险，用于提供饮食/补充剂干预的具体生化路径及安全性边界，展示从机制到转化的技术挑战。\"\n    },\n    {\n      \"source_handle\": \"P0153\",\n      \"paper_title\": \"Abstract C065: Impact of polyethylene glycol bowel preparation on the gut microbiome composition and response to immune checkpoint inhibition\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供 PEG 肠道准备导致 NSCLC 患者 PFS 缩短及小鼠模型中抗 PD-1 疗效削弱的证据，机制涉及紧密连接破坏及记忆 T 细胞减少。用于警示常规医疗操作作为负面调节因子的风险，强调基线微生物组稳定性对疗效评估的重要性及屏障完整性在机制中的关键角色。\"\n    },\n    {\n      \"source_handle\": \"P0154\",\n      \"paper_title\": \"Symbiotic bacteria-mediated imbalance and repair of immune homeostasis: exploring novel mechanisms of microbiome-host interactions in atopic dermatitis\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"虽聚焦特应性皮炎，但详述共生菌通过 SCFAs、色氨酸衍生物及表面分子调节 Th1/Th2/Treg 平衡及 DC 活化的通用机制。用于类比解释微生物组在非肿瘤背景下塑造适应性免疫的原理，为理解肠道微生物远程调节肿瘤免疫微环境提供基础免疫学理论支撑及跨疾病机制参考。\"\n    },\n    {\n      \"source_handle\": \"P0155\",\n      \"paper_title\": \"Dietary compounds and patterns associated with immune checkpoint inhibitor (ICI) outcomes in advanced non-small cell lung cancer (NSCLC).\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"在 NSCLC 中发现高脂低淀粉饮食与 PFS 改善相关，富集 Ruminococcus 等有益菌；高淀粉/蔗糖饮食与预后差及 Prevotella 富集相关。提供饮食模式通过特定菌群介导疗效的实证，用于论证营养干预的癌种特异性及西方饮食增加 irAEs 风险的安全性考量。\"\n    },\n    {\n      \"source_handle\": \"P0156\",\n      \"paper_title\": \"Gut microbiome changes and cancer immunotherapy outcomes associated with dietary interventions: a systematic review of preclinical and clinical evidence\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"系统综述高纤维饮食（OR=5.79）、禁食及生酮饮食对 ICI 疗效的影响，指出 SCFA 产生菌（Faecalibacterium）及乳酸菌的中介作用。强调动物与人类证据的差异及 FFQ 测量偏差，用于确立饮食作为关键可修饰因素的地位及机制路径（SCFA-H2S-免疫调节）的跨物种一致性。\"\n    },\n    {\n      \"source_handle\": \"P0157\",\n      \"paper_title\": \"Overcoming Resistance Mechanisms to Immune Checkpoint Inhibitors: Leveraging the Anti-Tumor Immune Response\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"总结微生物通过抗原交叉反应、细胞因子诱导及代谢物调节三条路径影响免疫，引用 FMT 及丁酸梭菌益生菌提高 ORR 的临床数据。指出抗生素、PPIs 及类固醇的负面干扰，用于构建克服耐药的綜合策略框架，并区分不同合并用药对微生物介导疗效的具体影响。\"\n    },\n    {\n      \"source_handle\": \"P0158\",\n      \"paper_title\": \"Resistance mechanisms in melanoma to immuneoncologic therapy with checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"聚焦黑色素瘤，确认 Raecalibacterium/厚壁菌门与生存获益相关，拟杆菌属作用存在争议。阐述抗原交叉呈递、代谢竞争及 IDO 介导的色氨酸耗竭机制，指出益生菌可能降低多样性从而削弱疗效的风险。用于展示特定癌种中微生物标志物的共识与冲突，及干预策略的潜在陷阱。\"\n    },\n    {\n      \"source_handle\": \"P0159\",\n      \"paper_title\": \"The Association of Gut Microbiomes in Skin Cancer: Systematic Review and Meta–analysis\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"荟萃分析确认 Ruminococcaceae、Faecalibacterium 与黑色素瘤 ICI 响应正相关，Bacteroidales 与耐药相关。阐述“肠 - 皮轴”机制，包括 SCFAs 调节全身炎症及局部皮肤微生物（S. aureus）的作用。用于提供皮肤癌特异性证据，区分全身与局部微生物组角色，并评估 FMT/益生菌的转化现状。\"\n    },\n    {\n      \"source_handle\": \"P0160\",\n      \"paper_title\": \"β-Catenin in Dendritic Cells Negatively Regulates CD8 T Cell Immune Responses through the Immune Checkpoint Molecule Tim-3\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"揭示 DC 中β-catenin 信号通过上调 Tim-3 抑制 CD8+ T 细胞反应的机制，证明抗 Tim-3 抗体主要靶向 DC 而非 T 细胞。虽未直接涉及菌群，但提供了 APC 功能障碍导致 ICI 耐药的分子路径，用于类比推测微生物可能通过调节 DC 代谢或信号通路（如 Wnt）影响检查点表达及联合治疗策略。\"\n    },\n    {\n      \"source_handle\": \"P0161\",\n      \"paper_title\": \"Modulation of gut microbiota: a novel approach to enhancing the effects of immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"比较 FMT、益生菌（CBM588）及饮食干预的临床效果，详述分子模拟、PRR 激活、代谢物调节及细菌易位五大机制。指出益生菌菌株特异性及 FMT 供体选择标准的不一致性，用于评估不同调节策略的有效性及安全性，并构建机制多样性与临床转化挑战的综合视图。\"\n    },\n    {\n      \"source_handle\": \"P0162\",\n      \"paper_title\": \"Gut microbiome-mediated primary and acquired resistance to immune checkpoint inhibitors in MSI-H/dMMR colorectal cancer: mechanisms, biomarkers, and therapeutic implications-a narrative review\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"针对 MSI-H/dMMR 结直肠癌，区分原发性（免疫排斥、髓系抑制）与获得性（动态重塑、抗生素干扰）耐药机制。系统解析 SCFA、胆汁酸、色氨酸、肌苷及多胺五种代谢通路的双向调节作用，用于构建精细的耐药时间维度分类及功能性生物标志物开发的理论框架。\"\n    },\n    {\n      \"source_handle\": \"P0163\",\n      \"paper_title\": \"Intratumoral microbiota: implications for cancer progression and treatment\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"综述瘤内微生物（如 Fusobacterium, Saccharopolyspora）与 ICI 疗效的关联，阐述 Fn 结合 TIGIT 抑制 NK/T 细胞、STING 轴激活及代谢物（ILA, Formate）增强 CD8+ T 细胞功能的机制。区分肠道菌群易位与原位定植的作用，用于补充肿瘤微环境内微生物直接调节免疫的局部机制及工程菌干预策略。\"\n    },\n    {\n      \"source_handle\": \"P0164\",\n      \"paper_title\": \"Gut Microbiota Biomarkers in Patients with Hepatocellular Carcinoma in the Era of Immune Checkpoint Inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"汇总 HCC 中 Akkermansia/Faecalibacterium（有益）与 E. coli/Veillonellaceae（有害）的标志物证据，详述 SCFAs、肌苷、色氨酸代谢物及 TMAO 调节 T 细胞/巨噬细胞的分子机制。评估机器学习预测模型的跨队列泛化能力及 FMT/MET40 干预前景，用于提供肝癌特异性全景及方法学标准化挑战。\"\n    },\n    {\n      \"source_handle\": \"P0165\",\n      \"paper_title\": \"Exploring the regulatory mechanism of intestinal flora based on PD-1 receptor/ligand targeted cancer immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"列举 Akkermansia、双歧杆菌等有益菌及 Bacteroidales、Roseburia 等耐药标志物，阐述肌苷/SCFAs 增强 T 细胞毒性、DC 成熟及 Treg/CD8+ 比例调节机制。关联特定菌群与 irAEs（结肠炎）发生率，用于构建抗 PD-1 治疗中微生物决定因素的“谁”与“如何”，并纳入安全性维度。\"\n    },\n    {\n      \"source_handle\": \"P0166\",\n      \"paper_title\": \"Immune checkpoint blockade induces gut microbiota translocation that augments extraintestinal anti-tumor immunity\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供肠道细菌通过 DC 摄取迁移至 MLN 进而重塑肿瘤引流淋巴结免疫环境的物理转移机制证据。证明 E. faecalis 等特定菌种回补可恢复联合 ICI 疗效，填补“微生物存在”与“远端免疫”间的因果链条。用于解释肠道菌群影响远处肿瘤的直接物理路径，区别于单纯代谢或抗原模拟机制。\"\n    },\n    {\n      \"source_handle\": \"P0167\",\n      \"paper_title\": \"Health-related quality of life in cancer patients treated with immune checkpoint inhibitors in randomised controlled trials: A systematic review and meta-analysis.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"荟萃分析证实 ICI 相比化疗显著改善晚期实体瘤患者生活质量（QoL）及延缓临床恶化。虽无菌群数据，但确立了 ICI 的整体临床获益基线，用于讨论微生态干预在维持或进一步提升 QoL 方面的潜在价值，并作为评估非生存性获益（如 irAEs 管理）的参照标准。\"\n    },\n    {\n      \"source_handle\": \"P0168\",\n      \"paper_title\": \"Advances in Immunotherapeutics in Pancreatic Ductal Adenocarcinoma\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"提供 PDAC 小鼠模型中抗生素清除菌群增强 PD-1 疗效的证据，描述 TME 免疫表型改变（CD8+ T 细胞浸润增加）。综述疫苗联合 ICI 的早期临床结果，用于解析“冷”肿瘤中微生物调节的特殊性（可能与其他癌种相反）及联合策略（疫苗 +I CI+ 微生物调节）的潜在协同机制。\"\n    },\n    {\n      \"source_handle\": \"P0169\",\n      \"paper_title\": \"Biomarkers for predicting the efficacy of immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"确认 Akkermansia、双歧杆菌、Faecalibacterium 等与良好响应相关，阐述通过增强 DC 功能及 CD8+ T 细胞浸润介导效应的宏观机制。对比 PD-L1、TMB 等传统标志物的局限性，用于论证微生物组作为补充预测因子的地位及“微生物 - 宿主免疫”交互作用的叙事逻辑。\"\n    },\n    {\n      \"source_handle\": \"P0170\",\n      \"paper_title\": \"Enterotype-specific microbial biomarkers of immune checkpoint inhibitor response revealed by large-scale integrated metagenomic analysis\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"发现 Collinsella（E2 肠型）与 Bacteroides（E1 肠型）分别在不同群落背景下预测 ICI 响应，揭示微生物标志物的肠型依赖性。提出 pH 响应脂质免疫原及 SCFA/胆汁酸代谢的潜在机制，用于解释单一物种标志物在不同研究中结果不一致的原因，强调群落背景在生物标志物开发中的关键作用。\"\n    },\n    {\n      \"source_handle\": \"P0171\",\n      \"paper_title\": \"The gut microbiome and response to immune checkpoint inhibitors: preclinical and clinical strategies\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统列出 Akkermansia、双歧杆菌等有益菌及 Bacteroidales、大肠杆菌等有害菌，阐述 DC 成熟、T 细胞募集及 Treg 调节机制。讨论采样方法、测序技术及混杂因素对结果一致性的影响，用于作为核心参考源构建微生物 -ICI 互作的基础框架，并指出临床前与临床数据差异的方法学根源。\"\n    },\n    {\n      \"source_handle\": \"P0172\",\n      \"paper_title\": \"From mechanisms to precision medicine: the role of organoids in studying the gut microbiota-tumor microenvironment axis\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述类器官模型揭示菌群失调与 MHC-I 表达降低、CD8+ T 细胞浸润减少的关联，详述 SCFAs、色氨酸代谢物通过 AhR 等受体调节免疫的机制。指出类器官缺乏完整免