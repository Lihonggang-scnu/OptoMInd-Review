        "content": "{\n  \"additions\": [\n    {\n      \"unit_key\": \"CH04:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0583\",\n          \"proposed_use\": \"提供FMT-LUMINate试验中NSCLC与黑色素瘤队列的直接对比数据，阐明单药ICI背景下的高ORR（80%）与零3级AE安全窗口，以及双免疫背景下65%的3级以上irAE风险（含心肌炎），支撑概念验证阶段的风险-获益平衡讨论。\"\n        },\n        {\n          \"source_handle\": \"P0577\",\n          \"proposed_use\": \"报告MIMic一期试验中口服健康供体FMT联合抗PD-1在晚期黑色素瘤中的长期生存数据（mOS 52.8个月）及安全性轮廓，作为FMT从短期响应向长期生存转化的关键临床证据。\"\n        },\n        {\n          \"source_handle\": \"P0578\",\n          \"proposed_use\": \"展示MITRIC二期篮子试验中FMT在ICI耐药实体瘤中的阴性结果（ORR 0%，mPFS 1.5个月），说明在快速进展/高负荷耐药状态下外源菌群定植失败与内源性抑制性网络占据主导导致疗效有限。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH04:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0596\",\n          \"proposed_use\": \"展示CBM588（产丁酸梭菌联合体）联合双免疫在mRCC中的阳性信号（ORR 58%-74%），结合宏基因组中Eubacterium siraeum保护与F/B比率纠正，推导短链脂肪酸介导的免疫稳态恢复假说。\"\n        },\n        {\n          \"source_handle\": \"P0125\",\n          \"proposed_use\": \"报告MRx0518（粪肠球菌单株）联合PD-1在ICI耐药实体瘤中的安全性轮廓与42% DCR，说明单株LBP在难治人群中的耐受性，但PFS较短提示单靶点激活不足以克服复杂耐药网络。\"\n        },\n        {\n          \"source_handle\": \"P0586\",\n          \"proposed_use\": \"对比MET4等联合体定植率低、代谢物改变仅见于亚组的现象，指出商业产品缺乏菌株活性保障与生态位竞争能力，解释为何部分观察性研究显示无效或负面关联。\"\n        },\n        {\n          \"source_handle\": \"P0390\",\n          \"proposed_use\": \"揭示商业混合益生菌在黑色素瘤患者中与较差ICI预后相关的观察性证据及小鼠模型机制（IFN-γ+ T细胞频率降低），作为“定义明确菌株有益但通用益生菌可能有害”的关键反例对照。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH04:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0401\",\n          \"proposed_use\": \"引用P0401队列数据，展示高纤维摄入如何同步提升粪便丙酸、富集Ruminococcus并上调肿瘤内适应性免疫基因，建立饮食-菌群-转录组的证据链。\"\n        },\n        {\n          \"source_handle\": \"P0156\",\n          \"proposed_use\": \"汇总P0156的OR=5.79合并效应量，结合禁食/高纤维动物模型中SCFA介导的抗肿瘤效应，论证饮食作为低成本辅助策略的生物学合理性。\"\n        },\n        {\n          \"source_handle\": \"P0473\",\n          \"proposed_use\": \"基于P0473综述，指出SCFAs/肌苷等虽具明确受体靶点，但人体TME内浓度阈值不明，直接补充面临生物利用度挑战，呼吁开发原位代谢物传感器与个体化营养算法。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"CH04:4\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0387\",\n          \"proposed_use\": \"系统对比FMT、LBPs与定义菌群三类干预的临床证据等级，剖析SER-401试验因万古霉素预处理导致定植失败的设计陷阱，提出“生态药理学”框架以指导未来精准工程与监管标准制定。\"\n        },\n        {\n          \"source_handle\": \"P0573\",\n          \"proposed_use\": \"基于系统综述确认目前无已完成的微生物群干预ICI治疗实体瘤的III期随机对照试验；JCOG2007为化疗-免疫联合试验的附属微生物组分析，非纯微生物干预；呼吁开展多中心、纵向、标准化队列研究。\"\n        },\n        {\n          \"source_handle\": \"P0546\",\n          \"proposed_use\": \"提出整合宏基因组/代谢组/AI预测模型的精准分型策略，呼吁设计包含实时微生物监测、预设irAE管理预案的大型III期试验，推动从经验性补充向精准医学转变。\"\n        }\n      ]\n    }\n  ]\n}",
