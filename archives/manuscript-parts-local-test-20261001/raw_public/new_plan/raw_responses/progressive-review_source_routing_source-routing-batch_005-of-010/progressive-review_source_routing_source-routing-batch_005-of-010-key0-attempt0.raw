{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0241\",\n      \"paper_title\": \"Association of Helicobacter pylori infection with survival outcomes in advanced gastric cancer patients treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"提供晚期胃癌患者中幽门螺杆菌活性感染与 ICI 疗效负相关的临床观察数据（DCR 47.1% vs 72.1%），作为特定病原体抑制免疫治疗的癌种特异性证据。其讨论的 Treg 诱导及 DC 功能受损机制假说，可用于解释消化道常驻菌如何通过局部微环境调节全身免疫响应，补充非小细胞肺癌之外的胃癌视角。\"\n    },\n    {\n      \"source_handle\": \"P0242\",\n      \"paper_title\": \"Targeting PD-L2/RGMb overcomes microbiome-related immunotherapy resistance\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"阐明微生物群通过下调树突状细胞表面 PD-L2 表达，解除其对 T 细胞 RGMb 受体的抑制，从而增强抗肿瘤免疫的具体分子机制。该研究还证实联合靶向 PD-L2/RGMb 轴可克服由非响应者菌群介导的耐药性，为开发不依赖 FMT 的精准联合疗法提供了临床前概念验证。\"\n    },\n    {\n      \"source_handle\": \"P0243\",\n      \"paper_title\": \"371 The association of the gut microbiota and clinical response to immune checkpoint inhibitors in patients with advanced cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供小样本队列中肠道微生物α多样性与 ICI 临床获益及外周血免疫表型（Treg 减少、炎症因子降低）关联的初步数据。尽管统计效力有限，但其提出的“高多样性 - 低免疫抑制”假设路径及特定菌属（如 Fusicatenibacter）线索，可作为构建微生物 - 宿主免疫互作机制模型的探索性依据。\"\n    },\n    {\n      \"source_handle\": \"P0244\",\n      \"paper_title\": \"805 Safety and emerging evidence of immune modulation of the live biotherapeutic MRx0518 in the neoadjuvant setting for patients awaiting surgical removal of solid tumours\",\n      \"chapter_ids\": [\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"报告活体生物制剂 MRx0518 在实体瘤患者新辅助治疗中的初步安全性及肿瘤组织免疫基因表达变化（如 NK/CD8+ T 细胞相关通路上调）。虽未直接测试与 ICI 联用的疗效，但该数据连接了临床前机制与早期人体免疫调节证据，支持 LBP 作为潜在免疫佐剂的开发路径。\"\n    },\n    {\n      \"source_handle\": \"P0245\",\n      \"paper_title\": \"Immune checkpoint blockade resistance in lung cancer: emerging mechanisms and therapeutic opportunities\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"将肠道微生物组置于肺癌 ICB 耐药的“宿主和微环境因素”框架中，强调其与肿瘤内在机制及缺氧等微环境压力的协同作用。虽未深入具体菌种机制，但为综述提供了将微生物组视为多因素耐药网络关键一环的理论背景，支持个性化免疫治疗的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0246\",\n      \"paper_title\": \"Five-year survival outcomes in NSCLC patients with concurrent GERD on proton pump inhibitors receiving pembrolizumab or nivolumab: A global study.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供大规模真实世界证据，显示 PPI 使用与 NSCLC 患者 ICI 治疗后 5 年生存率显著下降（约 9 个百分点）相关。文中引用的机制假说（PPI 致胃酸抑制引发菌群失调，削弱 Akkermansia 等有益菌介导的 CD8+ T 细胞激活）连接了药物干扰、微生物改变与临床结局，警示临床用药对微生态的潜在影响。\"\n    },\n    {\n      \"source_handle\": \"P0247\",\n      \"paper_title\": \"Friends close, enemies closer: the complex role of the microbiome in antitumor immunity\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统拆解微生物组调节 ICI 疗效的三大中介机制：代谢物（如丁酸、色氨酸衍生物）、抗原模拟及肿瘤内定植。特别强调同一菌属（如乳酸杆菌）在不同癌种中效应的双向性及菌株特异性，为解释临床观察结果的异质性提供了概念框架，并指出方法学标准化（如空间成像）的未来方向。\"\n    },\n    {\n      \"source_handle\": \"P0248\",\n      \"paper_title\": \"A Literature Review on the Impact of the Gut Microbiome on Cancer Treatment Efficacy, Disease Evolution and Toxicity: The Implications for Hematological Malignancies\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"虽聚焦血液肿瘤，但其详述的短链脂肪酸（SCFAs）调节 Treg/Th17 平衡及细菌易位机制，为实体瘤中微生物 - 免疫互作提供了通用的生物学合理性背景。可作为对比素材，说明某些免疫调节通路（如 IL-12 依赖途径）在不同肿瘤类型中的保守性或差异性。\"\n    },\n    {\n      \"source_handle\": \"P0249\",\n      \"paper_title\": \"Abstract 3523: A Black Raspberry dietary intervention to modify the gut microbiome and improve the response to immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"展示黑覆盆子饮食干预在人体中虽未显著改变标志性菌 Akkermansia，但其粪便移植到人源化小鼠模型后显示出增强 ICI 抗肿瘤效果的潜力。该研究提供了“饮食 - 菌群功能重塑 - 疗效改善”的完整转化链条案例，提示整体菌群功能而非单一菌种丰度可能是饮食干预的关键。\"\n    },\n    {\n      \"source_handle\": \"P0250\",\n      \"paper_title\": \"Exploring the role of the gut microbiome in modulating response to anti-PD-1 immunotherapy in melanoma patients\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"系统梳理黑色素瘤中微生物组通过调节 T 细胞活化及代谢物（SCFAs）影响抗 PD-1 疗效的机制图谱，列举了 Akkermansia、Bifidobacterium 等关键菌属。同时评估了 FMT、饮食及益生菌干预的早期证据与风险，为讨论微生物组作为预测标志物及治疗靶点的可行性提供综合背景。\"\n    },\n    {\n      \"source_handle\": \"P0251\",\n      \"paper_title\": \"Microbial mechanisms to improve immune checkpoint blockade responsiveness\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详细解析特定效应分子（如 cdAMP、肌苷、SagA 肽聚糖）及其宿主受体（STING、A2AR、NOD2）介导 ICB 增敏的具体信号通路。对比了生态方法（FMT）与还原论方法（工程菌、小分子）的优劣，为理解从菌群关联到分子机制的转化逻辑及未来治疗策略选择提供核心素材。\"\n    },\n    {\n      \"source_handle\": \"P0252\",\n      \"paper_title\": \"The Influence of Diet and Probiotics on the Response of Solid Tumours to Immunotherapy: Present and Future Perspectives\",\n      \"chapter_ids\": [\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"分类总结了地中海饮食、素食、Omega-3 及多酚等膳食因素通过调节微生物组影响 ICI 响应的宏观证据。虽缺乏具体分子机制细节，但构建了“饮食 - 微生物组 - 免疫调节 - 疗效”的逻辑框架，可作为讨论非药物干预策略及生活方式因素对治疗结局潜在影响的背景素材。\"\n    },\n    {\n      \"source_handle\": \"P0253\",\n      \"paper_title\": \"Role of gut microbiome on immunotherapy efficacy in melanoma\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"列举黑色素瘤中响应者富集的特定菌属（如 Bifidobacterium, Faecalibacterium）及无响应者富集菌属，提供具体的分类学证据。同时描述了细菌成分促进 CD8+ T 细胞浸润及抗生素破坏菌群导致免疫抑制的机制线索，并指出当前 FMT 及益生菌临床数据的局限性，支持未来标准化研究方向。\"\n    },\n    {\n      \"source_handle\": \"P0254\",\n      \"paper_title\": \"Obesity, cancer, and response to immune checkpoint inhibitors: Could the gut microbiota be the mechanistic link?\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"探讨“肥胖悖论”中肠道微生物组的潜在中介作用，汇总了肥胖相关菌群（如 Bifidobacterium, Akkermansia）与 ICI 疗效改善的关联证据。提出 SCFAs 调节瘦素水平及肥胖诱导炎症重塑肿瘤微环境的机制假说，同时指出部分肥胖相关菌（如 Blautia）可能与不良预后相关，强调宿主代谢状态的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0255\",\n      \"paper_title\": \"[Tracking Research Progress in the Modulatory Role of Gut Microbiome in Immune Checkpoint Inhibitors Applied in Cancer Treatment].\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"结构化区分了不同 ICI 类型（PD-1 vs CTLA-4 vs CD47）对应的特异性菌群特征及机制路径（如 STING、肌苷-A2AR 轴）。总结了 FMT 及益生菌临床试验现状，并指出测序方法不统一、人鼠菌群差异及个体基线异质性等关键局限，为综述提供全面的机制分类及转化挑战视角。\"\n    },\n    {\n      \"source_handle\": \"P0256\",\n      \"paper_title\": \"The Utilisation of Immune Checkpoint Inhibitors in Triple-Negative Breast Cancer\",\n      \"chapter_ids\": [\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"确立三阴性乳腺癌中 ICI 疗效的临床基线及耐药现状，指出尽管联合化疗有效但仍存在阴性结局。虽未涉及微生物组，但可作为背景素材，说明在特定实体瘤亚型中探索额外调节因子（如微生物组）以解释疗效异质性的临床必要性，界定综述关注的临床问题范围。\"\n    },\n    {\n      \"source_handle\": \"P0257\",\n      \"paper_title\": \"Gut microbiota reshaping the pancreatic cancer immune microenvironment: new avenues for immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"聚焦胰腺癌这一“冷肿瘤”，详述微生物群通过 TLR 信号激活 DC、SCFAs 增强 CD8+ T 细胞及代谢物（TMAO、胆汁酸）重编程巨噬细胞的具体机制。提供 Vancomycin 联合 ICI 试验失败的负面案例，强调精准筛选菌株而非广谱抗菌的重要性，并对比不同 ICI 靶点受微生物影响的差异。\"\n    },\n    {\n      \"source_handle\": \"P0258\",\n      \"paper_title\": \"Effect of gut microbiota on immune checkpoint inhibitor (ICI) based cancer immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供微生物组调节 ICI 疗效的三大核心机制框架：分子模拟致交叉反应 T 细胞启动、MAMPs 激活先天免疫及代谢物（SCFAs）信号传导。列举具体响应/耐药相关菌属，并概述 FMT、益生菌等干预策略的现状与争议，强调个体差异及标准化缺失是阻碍临床转化的关键挑战。\"\n    },\n    {\n      \"source_handle\": \"P0259\",\n      \"paper_title\": \"Grade 3 and Grade 4 Cutaneous toxicities in patients across multiple solid tumour types receiving checkpoint inhibitor therapy: An observational study. The experience of a single large specialist institution.\",\n      \"chapter_ids\": [\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"提供实体瘤患者 ICI 治疗中严重皮肤毒性（G3/4）的发生率及导致治疗中断的真实世界数据。虽未直接涉及微生物机制，但确立了毒性管理对治疗持续性及生存结局的制约背景，为后续讨论微生物组是否通过调节免疫稳态影响毒性 - 疗效权衡提供临床基准参照。\"\n    },\n    {\n      \"source_handle\": \"P0260\",\n      \"paper_title\": \"The Evolving Landscape of Immunotoxicity: Charting Mechanisms and Future Strategies for Immune Checkpoint Inhibitor Adverse Events\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"指出 Akkermansia muciniphila 等高丰度菌群在延长 NSCLC 患者生存期的同时可能增加免疫相关不良反应（irAEs）风险，揭示微生物组介导疗效与毒性的“双刃剑”效应。提出 Th17/Treg 平衡失调作为潜在共同机制，强调在追求疗效增强时需兼顾安全性管理的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0261\",\n      \"paper_title\": \"Facts and Hopes for Gut Microbiota Interventions in Cancer Immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统阐述微生物组影响 ICI 疗效的三大机制类别（直接 T 细胞刺激、分子模拟、代谢物调节），并列举具体分子（STING、NOD2、腺苷受体）。汇总 FMT 及定义菌群 consortia 的早期临床试验结果，同时批判性分析队列异质性导致生物标志物发现困难的原因，为转化研究提供事实与希望并存的视角。\"\n    },\n    {\n      \"source_handle\": \"P0262\",\n      \"paper_title\": \"The role of the bacterial microbiome in the treatment of cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"提出微生物组影响癌症治疗的三大机制框架：代谢调节、免疫反应激活及细菌易位。列举 Akkermansia、Bifidobacterium 等与 ICI 响应正相关的标志物，并对比其在化疗、放疗中的不同作用。指出局部肿瘤微生物组作为独立预后因子的潜力，扩展了仅关注肠道菌群的视野。\"\n    },\n    {\n      \"source_handle\": \"P0263\",\n      \"paper_title\": \"Latest evidence on clinical outcomes and prognostic factors of advanced urothelial carcinoma in the era of immune checkpoint inhibitors: a narrative review.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"汇总尿路上皮癌中伴随用药（抗生素、PPIs、皮质类固醇）通过改变肠道菌群负向影响 ICI 疗效的临床证据，并提及益生菌（CBM588）改善疗效的初步随机试验数据。虽机制细节有限，但提供了特定癌种下药物 - 菌群 - 疗效互作的临床实例及正在进行的干预试验线索。\"\n    },\n    {\n      \"source_handle\": \"P0264\",\n      \"paper_title\": \"Systematic evaluation of immune regulation and modulation\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"确立微生物组作为免疫调节关键因素的生物学基础，指出其通过教育浸润免疫细胞产生炎症介质促进抗肿瘤免疫。强调当前证据多来自动物模型及临床数据有限的现状，并提出多组学整合分析及标准化采样流程的方法学建议，为理解微生物组 -ICI 互作的研究设计提供背景框架。\"\n    },\n    {\n      \"source_handle\": \"P0265\",\n      \"paper_title\": \"The Challenge for Development of Valuable Immuno-Oncology Biomarkers\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供黑色素瘤中响应者肠道菌群多样性更高及梭菌属富集的观察性证据，同时指出头颈癌唾液样本中未发现类似关联，提示微生物标志物的肿瘤类型及采样部位特异性。强调单一标志物（包括微生物组）在复杂肿瘤免疫微环境中的预测局限性，支持多组学整合分析的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0266\",\n      \"paper_title\": \"Antibiotics impair immune checkpoint inhibitor effectiveness in Hispanic patients with non‐small cell lung cancer (AB‐CLICaP)\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供拉丁美洲 NSCLC 人群中抗生素暴露显著降低总生存期（OS）但不影响 PFS 的特异性数据，提示地域或人群特征可能影响微生物扰动的临床后果。引用文献构建“抗生素 - 有益菌耗竭 - 免疫激活受损”的理论链条，支持在资源有限地区优化抗生素选择策略的临床启示。\"\n    },\n    {\n      \"source_handle\": \"P0267\",\n      \"paper_title\": \"Immune‐related adverse events of antibody‐based biological medicines in cancer therapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"确认特定菌属（Ruminococcaceae, Akkermansia）与 ICI 响应及 irAEs（特别是结肠炎）的双重关联，并提及 FMT 在难治性黑色素瘤中的应用案例。阐述分子模拟及 Th1/TLR 介导的先天免疫激活作为潜在机制，同时强调微生物组异质性导致单一指标不可靠，需结合多变量分析。\"\n    },\n    {\n      \"source_handle\": \"P0268\",\n      \"paper_title\": \"Molecular studies on the impact of microbiome on anticancer drug resistance\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详述微生物代谢物（SCFAs、琥珀酸、次级胆汁酸）通过调节 cGAS-干扰素通路、T 细胞浸润及抗原呈递影响 ICI 耐药的分子机制。提出“肠道 - 肿瘤易位轴”概念，即菌群失调导致肿瘤内定植并驱动局部免疫抑制。评估 FMT 及益生菌干预的 inconsistent 结果，强调情境依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0269\",\n      \"paper_title\": \"'Know thyself' – host factors influencing cancer response to immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"结构化综述宿主因素（含微生物组）对 ICI 疗效的影响，列举 Akkermansia、Bifidobacterium 等候选菌属及代谢物（肌苷、马尿酸）介导的机制假说。指出不同研究间微生物信号的不一致性及方法学异质性（测序、采样），强调需标准化协议以推动生物标志物开发。\"\n    },\n    {\n      \"source_handle\": \"P0270\",\n      \"paper_title\": \"Composition of gastrointestinal microbiota in association with treatment response in individuals with metastatic castrate resistant prostate cancer progressing on enzalutamide and initiating treatment with anti-PD-1 (pembrolizumab)\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供 mCRPC 患者中特有的微生物标志物（S. salivarius 正向，A. muciniphila 负向），挑战了跨癌种通用标志物的假设。提出既往内分泌治疗可能重塑菌群 -ICI 反应关系，并推测肌苷在前列腺癌中可能促进转移的相反机制。纵向数据显示 ICI 治疗期间菌群稳定性，支持基线菌群决定论。\"\n    },\n    {\n      \"source_handle\": \"P0271\",\n      \"paper_title\": \"The role of the gut microbiome on the efficacy of immune checkpoint inhibitors in Japanese responder patients with advanced non-small cell lung cancer.\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供日本 NSCLC 患者中特定菌属（Lactobacillus, Clostridium 正向；Bilophila 负向）与 ICI 疗效关联的小样本观察数据。尽管统计效力有限，但其发现的 Bilophila 高丰度与较差预后关联及其他菌属的趋势，为探讨种族差异及菌种特异性对疗效影响提供了亚洲人群的独特视角及机制假说。\"\n    },\n    {\n      \"source_handle\": \"P0272\",\n      \"paper_title\": \"Combined or Sequential Treatment with Immune Checkpoint Inhibitors and Car-T Cell Therapies for the Management of Haematological Malignancies: A Systematic Review\",\n      \"chapter_ids\": [\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"虽聚焦血液肿瘤，但其关于 ICI 联合 CAR-T 在 B-NHL 中未显著优于单药的发现，可作为对比案例，说明 ICI 疗效增强并非在所有免疫治疗场景中通用。其揭示的 PD-1 通路阻断促进 T 细胞再扩增机制，有助于理解 ICI 解除免疫抑制的基本生物学原理，作为背景参照。\"\n    },\n    {\n      \"source_handle\": \"P0273\",\n      \"paper_title\": \"The Gut Microbiome and Cancer Immunotherapy: Can We Use the Gut Microbiome as a Predictive Biomarker for Clinical Response in Cancer Immunotherapy?\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"汇总多项临床研究，确认 Faecalibacterium、Akkermansia 等高丰度及高多样性与 ICI 良好响应相关，并指出 Bacteroidales 与非响应相关。重点引用 FMT 临床试验（Baruch et al., Davar et al.）中难治患者恢复响应的因果证据，观察到 CD8+ T 细胞激活增加，为微生物组介导疗效提供最强临床间接证据。\"\n    },\n    {\n      \"source_handle\": \"P0274\",\n      \"paper_title\": \"Microbiome and cancer: mechanistic insights, diagnostic potential, and therapeutic strategies\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详述微生物组增强 ICI 疗效的四大机制：DC 活化、T 细胞启动、代谢物调节及抗原模拟。列举关键受益/受损菌属及 FMT 早期临床证据。强调 SCFAs 等代谢物的情境依赖性（促免疫或抑制），并讨论肿瘤内微生物组及诊断标志物潜力，为构建机制框架及转化策略提供全面素材。\"\n    },\n    {\n      \"source_handle\": \"P0275\",\n      \"paper_title\": \"The association between antibiotic use and outcomes of HCC patients treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供 HCC 患者中抗生素使用未显著影响 ICI 疗效（OS, PFS, ORR）的阴性结果，与其他实体瘤形成对比。提出肝硬化背景下的基线免疫抑制及特定菌群组成可能使抗生素扰动不产生额外负面效应，甚至可能消除某些抑制性菌群的独特机制假说，支持肿瘤类型特异性观点。\"\n    },\n    {\n      \"source_handle\": \"P0276\",\n      \"paper_title\": \"Tarloxotinib targets tumor hypoxia to improve therapeutic efficacy of immune checkpoint inhibition in a TLR9 dependent manner\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"虽非直接研究微生物，但阐明缺氧靶向药通过激活 TLR9/MyD88 通路及重塑肿瘤微环境（减少 MDSC/Treg）增强 ICI 疗效的机制。可作为非微生物因素（物理化学性质）调节免疫响应的平行案例，对比说明先天免疫识别在克服耐药中的通用重要性，丰富机制讨论维度。\"\n    },\n    {\n      \"source_handle\": \"P0277\",\n      \"paper_title\": \"Impact of influenza vaccination on survival of patients with advanced cancer receiving immune checkpoint inhibitors (INVIDIa-2): final results of the multicentre, prospective, observational study\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供流感疫苗接种与部分实体瘤（肺癌、肾癌）患者 ICI 生存获益相关的观察性证据。提出“旁观者效应”及免疫超激活假说，认为非特异性抗病毒免疫可增强抗肿瘤反应。虽非微生物直接作用，但为系统性免疫刺激（包括可能的微生物抗原交叉反应）增强疗效提供了理论参照及瘤种异质性案例。\"\n    },\n    {\n      \"source_handle\": \"P0278\",\n      \"paper_title\": \"Immune checkpoint inhibitor-associated gastrointestinal adverse events in patients with colorectal cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供 MSI-H 结直肠癌患者 ICI 相关结肠炎的低发生率及轻度特征数据。构建“肿瘤微环境 - 肠道微生物组 - 免疫疗效/毒性”理论框架，阐述微生物代谢物（SCFAs、胆汁酸）重塑巨噬细胞及 T 细胞组成进而影响疗效及 irAEs 风险的机制假说，为特定癌种下的毒性 - 疗效平衡提供背景。\"\n    },\n    {\n      \"source_handle\": \"P0279\",\n      \"paper_title\": \"Microbiome-selective DNA Pol IIIC inhibitors in oncology infection management\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"引入 DNA Pol IIIC 抑制剂作为“微生物组保护性”抗生素新类别，对比传统广谱抗生素导致的群落崩溃。提供其保留拟杆菌门/厚壁菌门及减少肠杆菌目扩张的具体数据，支持保留微生物多样性以维持 CD8+ T 细胞激活的机制背景，为临床感染管理中平衡抗感染与免疫保护提供策略依据。\"\n    },\n    {\n      \"source_handle\": \"P0280\",\n      \"paper_title\": \"Insights into the Relationship Between the Gut Microbiome and Immune Checkpoint Inhibitors in Solid Tumors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"绘制跨癌种（黑色素瘤、肺癌、RCC、GI 癌）的微生物标志物地图，列举一致性及异质性菌属。详述 SCFA 介导的组蛋白去乙酰化、代谢物诱导 T 细胞激活及 PD-L2 调节等机制。强调地理、饮食及抗生素等混杂因素对结果的影响，为构建生物标志物表格及讨论标准化挑战提供高层级素材。\"\n    },\n    {\n      \"source_handle\": \"P0281\",\n      \"paper_title\": \"The Oral–Gut Microbiome–Brain Axis in Cognition\",\n      \"chapter_ids\": [],\n      \"specific_usable_material\": \"该研究聚焦神经退行性疾病及认知功能，虽涉及肠道微生物组产生 SCFAs 及抗生素影响的一般性描述，但未涉及肿瘤微环境、T 细胞浸润或 ICI 耐药机制。其关于神经炎症的讨论与实体瘤免疫治疗缺乏直接关联，故不纳入本综述。\"\n    },\n    {\n      \"source_handle\": \"P0282\",\n      \"paper_title\": \"The Impact of Gut Microbiota-Derived Metabolites on the Tumor Immune Microenvironment\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"聚焦微生物代谢物（SCFAs、肌苷、色氨酸衍生物）通过代谢重编程、表观遗传修饰及受体信号（mTOR, A2A, AhR）直接调节 T 细胞及巨噬细胞功能的分子机制。区分肠道菌群与肿瘤内微生物组的空间作用，指出某些代谢物（如色氨酸衍生物在 PDAC 中）的双重角色，为机制章节提供深度生化解释。\"\n    },\n    {\n      \"source_handle\": \"P0283\",\n      \"paper_title\": \"Gut microbiome and serum short-chain fatty acids are associated with responses to chemo- or targeted therapies in Chinese patients with lung cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供肺癌化疗/靶向治疗中微生物组及血清异丁酸与疗效关联的证据，发现 Parasutterella 富集与良好反应相关。揭示异丁酸通过 GPCR-HAT-组蛋白乙酰化轴直接作用于肿瘤细胞的非免疫机制，区别于 ICI 研究中的免疫调节机制，展示了不同治疗模式下微生物影响的异同及情境依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0284\",\n      \"paper_title\": \"Metagenomics and culturomics reveal the dual role of the gut microbiome in the development of immune-related toxicities and the efficacy of immune checkpoint inhibitors in cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"揭示 Paraclostridium bifermentans 的双重角色：活菌破坏上皮屏障致结肠炎，而其分泌的小分子代谢物增强 ICI 疗效。通过 FMT 及小鼠模型证实这种“毒性 - 疗效”解耦机制，强调培养组学在发现低丰度功能菌中的价值，为理解微生物组介导的复杂生理效应提供具体分子案例。\"\n    },\n    {\n      \"source_handle\": \"P0285\",\n      \"paper_title\": \"Breakthroughs in immune checkpoint therapy: overcoming NSCLC immune checkpoint therapy resistance with novel techniques\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"综述 NSCLC 中克服 ICI 耐药的新策略，明确提及肠道微生物群通过 SCFAs 及 PD-L2-RGMB 轴调节疗效的机制。虽为综述性质，但其整合的 TME 重塑及免疫监视背景，有助于理解微生物群在复杂宿主环境中发挥作用的上下文，并列举联合化疗、放疗等对比策略，突显微生物调节的独特性。\"\n    },\n    {\n      \"source_handle\": \"P0286\",\n      \"paper_title\": \"Immunological Drug–Drug Interactions in Immune Checkpoint Inhibitor Therapy: Mechanisms, Clinical Evidence, and Artificial Intelligence\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"明确将微生物群介导的相互作用列为免疫药 - 药相互作用（iDDIs）的核心机制，汇总抗生素及 PPIs 通过破坏菌群多样性、减少有益菌从而削弱 CD8+ T 细胞活化的证据。强调暴露时间窗（30-90 天）的重要性及观察性数据的混杂偏倚，为临床用药管理及机制解释提供系统性框架。\"\n    },\n    {\n      \"source_handle\": \"P0287\",\n      \"paper_title\": \"Bacteria in cancer therapy: A new generation of weapons\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"虽聚焦外源性细菌疗法，但其关于双歧杆菌增强 DC 功能、促进 CD8+ T 细胞浸润及与 PD-L1 抗体协同作用的论述，直接关联内源性菌群机制。详述 TLR/STING 通路激活及检查点分子下调等分子机制，为解释为何特定菌群存在会影响 ICI 疗效提供理论基石及工程菌开发思路。\"\n    },\n    {\n      \"source_handle\": \"P0288\",\n      \"paper_title\": \"Impact of Patient Characteristics on the Outcomes of Patients with Gastrointestinal Cancers Treated with Immune Checkpoint Inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供 GI 肿瘤中特定菌群（Lachnospiraceae, Bifidobacterium 有益；Veillonellaceae 有害）与 ICI 疗效关联的证据，并确认近期抗生素使用恶化 OS。详述全身因素（肌少症、肝转移）通过改变免疫细胞功能间接影响疗效的机制，为理解微生物组与宿主生理状态互作提供多维背景。\"\n    },\n    {\n      \"source_handle\": \"P0289\",\n      \"paper_title\": \"Microbiome Landscape and Association with Response to Immune Checkpoint Inhibitors in Advanced Solid Tumors: A SCRUM-Japan MONSTAR-SCREEN Study\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"跨癌种数据显示α多样性与 ICI 疗效整体无显著关联，但在特定癌种或治疗模式下呈异质性。识别粪便中高比例口腔细菌（尤其在 PPI 使用者中）为负面预测因子，提出 PPI 致胃酸抑制促进口腔菌易位进而削弱疗效的机制路径，解释了部分研究结果不一致的原因及药物 - 菌群互作的具体情境。\"\n    },\n    {\n      \"source_handle\": \"P0290\",\n      \"paper_title\": \"Abstract A14: Meta-analysis improves identification of microbiome associations with antitumor response in melanoma, lung, and kidney cancer patients treated with checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"通过大样本荟萃分析证实特定细菌签名与 ICI 响应的关联，但强调需经多重检验校正以排除假阳性。发现α多样性并非稳定预测因子，提示物种组成及功能比整体多样性更重要。开发并验证了优于传统文献指数的复合预测模型，为生物标志物构建及方法学标准化提供实证支持。\"\n    },\n    {\n      \"source_handle\": \"P0291\",\n      \"paper_title\": \"Role of the intestinal microbiome and microbial-derived metabolites in immune checkpoint blockade immunotherapy of cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统综述微生物组及代谢物（丙酸、肌苷）与 ICI 疗效/毒性的关联，区分抗原依赖（分子模拟）与非依赖（DC 激活）两大机制路径。详述抗生素负面影响及 FMT 初步疗效，指出当前证据的不一致性及方法学挑战，为构建机制框架及讨论转化瓶颈提供基础性文本。\"\n    },\n    {\n      \"source_handle\": \"P0292\",\n      \"paper_title\": \"Predictive impact of sarcopenia in solid cancers treated with immune checkpoint inhibitors: a meta‐analysis\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供肌少症显著降低 ICI 疗效的荟萃分析证据，提出肌源性细胞因子（如 IL-15）调节 T/NK 细胞的机制假说。虽不直接涉及菌群，但作为“宿主全身状态影响免疫治疗”的平行案例，可与菌群 - 免疫轴形成类比，支持多维度生物标志物组合及器官间串扰在疗效调节中的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0293\",\n      \"paper_title\": \"Gut microbiota's role in NAFLD- and HBV/HCV-related hepatocellular carcinoma: Mechanisms and therapeutic implications.\",\n 