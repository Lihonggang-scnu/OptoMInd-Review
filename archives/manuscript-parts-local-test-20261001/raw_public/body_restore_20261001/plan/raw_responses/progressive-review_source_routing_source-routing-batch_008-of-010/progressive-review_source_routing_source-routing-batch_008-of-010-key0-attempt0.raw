{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0421\",\n      \"paper_title\": \"The impact of sarcopenia on the efficacy and safety of immune checkpoint inhibitors in patients with solid tumours\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究提供了肌肉减少症这一非微生物类宿主因素对 ICI 疗效影响的实证数据，显示低肌肉量在肺癌中未降低 PFS 且不增加毒性。可用于 Ch4 讨论宿主因素异质性，作为对比案例说明并非所有传统不良预后因素在免疫治疗中均呈负面效应，避免将疗效差异单一归因于微生物组。\"\n    },\n    {\n      \"source_handle\": \"P0422\",\n      \"paper_title\": \"Gut Associated Metabolites Enhance PD-L1 Blockade Efficacy in Prostate Cancer\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究在前列腺癌模型中揭示了特定花生四烯酸代谢物（16(R)-HETE, 6-Keto-PGE1）通过上调外泌体 PD-L1 增强抗 PD-L1 疗效的机制。可用于 Ch3 阐述“肠 - 肿瘤代谢轴”的具体分子路径，展示代谢物如何通过调节检查点靶点密度而非直接激活 T 细胞来介导疗效，同时注明其肿瘤类型特异性。\"\n    },\n    {\n      \"source_handle\": \"P0423\",\n      \"paper_title\": \"Targeting molecular pathways to control immune checkpoint inhibitor toxicities\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述建立了微生物组与 irAEs 发生之间的分子联系，指出 IL-6、IL-17 及整合素通路是关键介质。可用于 Ch3 解释微生物驱动的系统性炎症如何作为疗效/毒性的共同中介变量；在 Ch4 中用于强调评估疗效时需考虑微生物组介导的免疫毒性负担，区分抗肿瘤免疫与自身免疫反应的机制重叠。\"\n    },\n    {\n      \"source_handle\": \"P0424\",\n      \"paper_title\": \"Gut microbiota and metabolites associate with outcomes of immune checkpoint inhibitor–treated unresectable hepatocellular carcinoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究在 HCC 队列中识别出 Lachnoclostridium 富集与次级胆汁酸水平升高及良好预后的关联。可用于 Ch2 提供肝癌特异性的微生物预测因子证据；在 Ch3 中作为“微生物 - 胆汁酸轴”的实例，说明特定菌属可能通过代谢转化（如 CDCA 转 UDCA）介导免疫调节，同时指出其病毒相关 HCC 背景的局限性。\"\n    },\n    {\n      \"source_handle\": \"P0425\",\n      \"paper_title\": \"Microbial dysbiosis and childhood asthma development: Integrated role of the airway and gut microbiome, environmental exposures, and host metabolic and immune response\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述详细描述了 SCFAs 通过抑制 NF-κB、促进 Tregs 分化调节免疫的机制，虽基于哮喘模型，但提供了通用的“微生物 - 代谢 - 免疫”通路框架。可用于 Ch3 作为背景机制素材，解释肠道菌群代谢物如何系统性重塑适应性免疫稳态，类比其在肿瘤微环境中可能的免疫调节作用，需注明疾病背景差异。\"\n    },\n    {\n      \"source_handle\": \"P0426\",\n      \"paper_title\": \"1038P Impact of metastatic location on immune-checkpoint inhibitors efficacy in patients with different solid tumours\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现转移灶数量（≥3）显著降低 ICI 疗效，但单发转移部位类型无影响。可用于 Ch4 界定临床预后基线，说明解剖学微环境差异未必主导疗效变异，从而凸显系统性因素（如微生物组）在解释剩余疗效异质性中的潜在重要性，并提示在分析微生物效应时需校正肿瘤负荷。\"\n    },\n    {\n      \"source_handle\": \"P0427\",\n      \"paper_title\": \"Abstract 2377: Gut microbiome modulation by a black raspberry nectar for improving anti-PD1 therapy effectiveness in pre-clinical cancer models\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该摘要报道黑树莓花蜜通过增加 Lachnospiraceae/Blautia 及 L-肉碱水平增强抗 PD-1 疗效的临床前证据。可用于 Ch5 展示饮食干预作为非抗生素类调节策略的潜力；在 Ch3 中提出 L-肉碱作为非传统 SCFA 的潜在代谢介导机制，强调需进一步验证其因果性及在人类中的转化价值。\"\n    },\n    {\n      \"source_handle\": \"P0428\",\n      \"paper_title\": \"Comparison of baseline gut microbiome features between response subgroups of patients (pts) with advanced melanoma undergoing immune checkpoint inhibitor (ICI) therapy.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究发现黑色素瘤响应者中 SCFA 产生菌（如 F. prausnitzii）丰度更高，且与较低 irAEs 风险相关。可用于 Ch2 提供特定功能菌群而非整体多样性作为预测因子的证据；在 Ch3 中探讨 SCFAs 在平衡抗肿瘤免疫与免疫毒性中的双重角色，提示疗效与安全性可能受同一微生物机制调控。\"\n    },\n    {\n      \"source_handle\": \"P0429\",\n      \"paper_title\": \"Enfortumab vedotin following platinum-based chemotherapy and immune checkpoint inhibitors for advanced urothelial carcinoma: response, survival and safety analysis from a multicentre real-world Japanese cohort.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究提供了尿路上皮癌 ICI 失败后使用 ADC 药物的真实世界疗效数据。可用于 Ch4 作为背景参照，说明 ICI 耐药后的治疗格局及生存基线，帮助界定微生物组干预旨在改善的初始 ICI 响应率或延缓耐药发生的临床意义，但不直接涉及微生物机制。\"\n    },\n    {\n      \"source_handle\": \"P0430\",\n      \"paper_title\": \"Microbiome bacterial influencers of host immunity and response to immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述系统总结了不同癌种中与 ICI 疗效相关的菌属（如 Ruminococcaceae, Akkermansiaceae）及其机制（TLR 激活、代谢物调节）。可用于 Ch2/Ch3 提供跨癌种的关联证据与分子路径；在 Ch5 评估 FMT/益生菌现状；在 Ch6 指出方法学异质性及缺乏标准化分析工具的挑战，支持未来研究方向。\"\n    },\n    {\n      \"source_handle\": \"P0431\",\n      \"paper_title\": \"β-catenin in dendritic cells negatively regulates CD8 T cell immune responses through the immune checkpoint molecule Tim-3 4802\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究阐明 DC 内β-catenin 信号通过上调 Tim-3 抑制 CD8+ T 细胞的机制。可用于 Ch3 作为非微生物类宿主免疫检查点调控的对照案例，说明除肠道菌群外，DC 功能状态也是影响 T 细胞活化的关键内在因素，丰富对免疫检查点网络复杂性的理解，但不直接涉及微生物互作。\"\n    },\n    {\n      \"source_handle\": \"P0432\",\n      \"paper_title\": \"The gut microbiome affects response of treatments in HER2‐negative advanced gastric cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现胃癌中 Lactobacillus 丰度与 ICI 疗效正相关，且联合治疗的微生物特征不同于单药。可用于 Ch2 提供胃癌特异性预测因子；在 Ch4 强调治疗情境依赖性，说明化疗联合 ICI 可能重塑微生物组效应，警示不能将单药研究的结论简单外推至联合治疗场景。\"\n    },\n    {\n      \"source_handle\": \"P0433\",\n      \"paper_title\": \"The relationship between gut microbiota and cancer immune response and immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述整合了微生物组与 ICI 疗效的临床关联、具体代谢机制（SCFAs, TMAO, 色氨酸）及干预策略。可用于 Ch2/Ch3 提供全面的机制框架与证据汇总；在 Ch5 讨论 FMT/益生菌的临床进展；在 Ch6 指出 SCFAs 双重作用及标准化缺失等争议，支持对现有证据局限性的综合判断。\"\n    },\n    {\n      \"source_handle\": \"P0434\",\n      \"paper_title\": \"Abstract PS2-07-12: Gut microbiome composition predicts pathologic complete response in patients with early-stage HER2-positive breast cancer receiving neoadjuvant HER2-targeted therapy +/- immunotherapy with pembrolizumab\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该摘要报道乳腺癌新辅助治疗中特定微生物特征预测 pCR，且含免疫治疗组与不含组特征不同。可用于 Ch2 提供乳腺癌领域的临床关联证据；在 Ch4 说明治疗干预本身可重塑微生物组并改变其与疗效的关联模式，提示在评估微生物标志物时需严格区分治疗背景。\"\n    },\n    {\n      \"source_handle\": \"P0435\",\n      \"paper_title\": \"A comprehensive review of mechanisms underlying resistance to immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述详述了微生物组通过调节髓系细胞、T 细胞激活及代谢产物（丁酸盐）影响 ICI 耐药的机制。可用于 Ch3 解释微生物介导的免疫调节路径；在 Ch4 中作为背景，区分微生物机制与其他内在耐药机制（如抗原丢失），强调微生物组在获得性耐药中的潜在角色及癌种特异性。\"\n    },\n    {\n      \"source_handle\": \"P0436\",\n      \"paper_title\": \"Abstract 6699: Delineating germline, tumor and extrinsic factors driving mucosal melanoma (MM) risk and response to immune checkpoint inhibitor (ICI) treatment\",\n      \"chapter_ids\": [\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该摘要描述了黏膜黑色素瘤研究中肠道与局部微生物组同步采集及多组学整合的设计。可用于 Ch6 作为方法学参考，展示在罕见肿瘤亚型中如何区分全身与局部微生物信号，并指出当前研究多处于基线数据采集阶段，强调未来需功能验证及大样本队列以克服异质性挑战。\"\n    },\n    {\n      \"source_handle\": \"P0437\",\n      \"paper_title\": \"Gene-level gut microbiome signatures as predictive biomarkers for response to immune checkpoint inhibitors across multiple cancer types\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现基因水平微生物特征（如 nitrilase 通路）在联合免疫治疗中比分类学特征更具跨癌种预测力。可用于 Ch2 提供高分辨率生物标志物证据；在 Ch3 提出氮代谢等潜在机制；在 Ch4 强调治疗策略（联合 vs 单药）和宿主年龄对微生物信号泛化性的关键修饰作用。\"\n    },\n    {\n      \"source_handle\": \"P0438\",\n      \"paper_title\": \"Gastrointestinal cancer resistance to treatment: the role of microbiota\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦消化道肿瘤，详述了微生物通过代谢物、免疫细胞训练及特定病原体（如 H. pylori）调节免疫的机制。可用于 Ch3 提供 GI 癌特异性的机制细节（如 MDSC 招募）；在 Ch4 中提醒注意致病菌驱动炎症与共生菌代谢调节的区别，避免将感染相关机制泛化为普遍规律。\"\n    },\n    {\n      \"source_handle\": \"P0439\",\n      \"paper_title\": \"Harnessing the gut microbiome for improved immune checkpoint inhibition in colorectal cancer immunotherapy: a narrative Review.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦 MSS/pMMR 结直肠癌，总结了特定菌种（Akkermansia, Fusobacterium）与疗效的关联及代谢/免疫机制。可用于 Ch2/Ch3 提供难治亚型的证据；在 Ch5 讨论非抗生素干预策略；在 Ch6 指出 Akkermansia 作用的矛盾发现及安全挑战，强调菌株特异性及宿主因素的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0440\",\n      \"paper_title\": \"An observational study to evaluate pattern of usage of immune checkpoint inhibitors in the 1st line treatment of various advanced solid tumors, their efficacy and their toxicity profile.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究提供了真实世界中 ICI 一线治疗的疗效与毒性基线数据。可用于 Ch4 作为临床背景参照，说明不同人群中的实际疗效分布及常见 irAEs 类型，帮助界定微生物组研究需解释的疗效变异范围，并提示毒性管理在评估整体治疗获益中的重要性，但不涉及微生物机制。\"\n    },\n    {\n      \"source_handle\": \"P0441\",\n      \"paper_title\": \"Immune checkpoint inhibitors (ICIs) as \\\"chemotherapy (Ctx) sensitization\\\" strategy in advanced solid tumours\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现实体瘤中 ICI 序贯化疗未显示普遍增敏效果。可用于 Ch4 作为阴性对照案例，说明 ICI 并不自动增强后续化疗疗效，提示任何微生物介导的增敏效应可能是高度特异或条件依赖的，需在特定亚群或联合方案中验证，避免过度泛化“增敏”概念。\"\n    },\n    {\n      \"source_handle\": \"P0442\",\n      \"paper_title\": \"The microbiome and gynaecological cancer development, prevention and therapy\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述提及 A. muciniphila 通过 FMT 恢复 PD-1 疗效的小鼠证据及双歧杆菌的免疫调节作用。可用于 Ch3 提供特定菌株介导疗效的机制线索；在 Ch5 讨论 FMT 及工程菌在妇科肿瘤背景下的转化潜力，需注明主要基于临床前数据且需验证其在实体瘤中的普适性。\"\n    },\n    {\n      \"source_handle\": \"P0443\",\n      \"paper_title\": \"Non-small cell lung cancer patients treated with Anti-PD1 immunotherapy show distinct microbial signatures and metabolic pathways according to progression-free survival and PD-L1 status\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究在 NSCLC 中识别出 Alistipes（有益）和 Streptococcus（有害）等物种水平标志物，并发现化疗虽扰动菌群但不消除预测信号。可用于 Ch2 提供稳健的物种级证据；在 Ch3 提出菌群网络结构假说；在 Ch4 讨论化疗预处理对微生物组的影响及种族/方法学导致的异质性。\"\n    },\n    {\n      \"source_handle\": \"P0444\",\n      \"paper_title\": \"Microbial metabolic pathways guide response to immune checkpoint blockade therapy.\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该论文阐明 MEP 通路（促 Vδ2 T 细胞）与核黄素通路（抑 CD4+ T 细胞）双向调节 ICB 疗效的机制。可用于 Ch3 详细解释代谢功能而非物种组成如何特异性调控人类特有 T 细胞亚群；在 Ch2 提供功能性菌群失调与预后关联的证据，强调代谢通路分析在预测模型中的优势。\"\n    },\n    {\n      \"source_handle\": \"P0445\",\n      \"paper_title\": \"The future of affordable cancer immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述讨论了微生物组疗法（如 FMT、SCFA 监测）作为低成本干预策略的潜力。可用于 Ch5 评估经济可及性对转化的影响，对比昂贵细胞疗法；在 Ch6 指出标准化困难及种族差异带来的挑战，强调在资源有限环境中开发简便微生物标志物或干预手段的现实意义。\"\n    },\n    {\n      \"source_handle\": \"P0446\",\n      \"paper_title\": \"Multi-omics analysis of saccharomyces boulardii supplementation reveals coordinated microbiome, metabolic, and immune signaling changes accompanying tumor suppression\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该研究显示 S. boulardii 通过产生 AhR 配体（5-HIAA, IPA）抑制结直肠癌生长。可用于 Ch3 阐述益生菌通过色氨酸 -AhR 轴调节全身免疫的具体机制；在 Ch5 作为标准化益生菌优于 FMT 的可行性案例，提示其安全性及可扩展性，但需注明主要基于临床前模型。\"\n    },\n    {\n      \"source_handle\": \"P0447\",\n      \"paper_title\": \"Microbial metabolites and their influence on the tumor microenvironment\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述详述了 SCFAs、胆汁酸等代谢物通过重塑免疫细胞代谢状态影响 TME 的机制。可用于 Ch3 提供代谢重编程（如糖酵解、FAO）的具体分子路径；在 Ch6 指出单一代谢物靶点（如 IDO1）临床试验失败的教训，强调需考虑代谢网络复杂性及情境依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0448\",\n      \"paper_title\": \"Role of gut microbiome in the outcome of lymphoma patients treated with checkpoint inhibitors—The MicroLinf Study\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现淋巴瘤中 Lachnospira 与疗效正相关。可用于 Ch4 作为对比案例，说明血液系统恶性肿瘤中可能存在不同于实体瘤的微生物驱动因素，强调肿瘤微环境特异性，警示在综合实体瘤证据时不应直接外推淋巴瘤数据，需区分疾病类型。\"\n    },\n    {\n      \"source_handle\": \"P0449\",\n      \"paper_title\": \"Gut Microbiota Metabolites and Chronic Diseases: Interactions, Mechanisms, and Therapeutic Strategies\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述详述了 SCFAs、胆汁酸在慢性病中调节免疫的通用机制。可用于 Ch3 作为背景素材，解释微生物代谢物如何通过保守的免疫通路（如 NF-κB, NLRP3）塑造宿主免疫稳态，为推测其在肿瘤免疫治疗中的潜在作用提供生物学合理性，需注明非肿瘤背景。\"\n    },\n    {\n      \"source_handle\": \"P0450\",\n      \"paper_title\": \"Gut Microbiota and Response to Immunotherapeutic Drugs in Oncology: More Questions Than Answers\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了早期研究中不一致的菌群 - 疗效关联及转化障碍。可用于 Ch2 展示领域早期的异质性现状；在 Ch6 重点讨论机制不明、制剂标准化难及监管挑战，支持“问题多于答案”的判断，提醒在综合证据时需警惕发表偏倚及小样本研究的局限性。\"\n    },\n    {\n      \"source_handle\": \"P0451\",\n      \"paper_title\": \"Harnessing the Gut Microbiome in Cancer Immunotherapy: Mechanisms, Challenges, and Routes to Personalized Medicine—A Systematic Review\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该系统综述总结了特定代谢物（SCFAs, I3A）及菌株的机制证据与干预挑战。可用于 Ch3 提供机制细节；在 Ch5 评估个性化医疗路径；在 Ch6 指出缺乏实时监测工具及剂量标准化问题，强调未来需结合 AI/ML 及严格试验设计以推动临床转化。\"\n    },\n    {\n      \"source_handle\": \"P0452\",\n      \"paper_title\": \"Sucralose and the Gut–Immune Axis: Emerging Evidence Linking Dysbiosis, Barrier Alterations, and Implications for Colitis and Colorectal Cancer Immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述指出三氯蔗糖通过减少精氨酸/瓜氨酸削弱 CD8+ T 细胞功能从而降低 ICI 疗效。可用于 Ch4 讨论饮食成分作为负面调节因子的风险；在 Ch3 提供具体的代谢限制机制（氨基酸代谢），提示非药物因素对微生物组介导疗效的显著干扰，需注明人类证据的局限性。\"\n    },\n    {\n      \"source_handle\": \"P0453\",\n      \"paper_title\": \"Effect of dual immune checkpoint inhibitors (ICI) by the time of infusion in advanced non–small cell lung cancer (NSCLC): A secondary analysis of CCTG BR34 trial.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现双免疫治疗下午输注疗效更佳，与单药研究结果不同。可用于 Ch4 说明宿主节律对疗效的修饰作用具有方案特异性，提示在探讨微生物组等时间依赖性因素时，需考虑给药方案及肿瘤类型的交互影响，避免简单外推单一机制。\"\n    },\n    {\n      \"source_handle\": \"P0454\",\n      \"paper_title\": \"Eating away cancer: the potential of diet and the microbiome for shaping immunotherapy outcome\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述总结了高纤维饮食与 ICB 疗效的正向关联及商业益生菌的潜在风险。可用于 Ch4 讨论饮食作为可调节因素的重要性；在 Ch3 提供饮食 - 微生物 - 免疫轴的机制框架；在 Ch5 区分天然发酵食品与补充剂的差异，强调需警惕非特异性益生菌干预的负面效应。\"\n    },\n    {\n      \"source_handle\": \"P0455\",\n      \"paper_title\": \"Gut microbiome in gastrointestinal neoplasms: from mechanisms to precision therapeutic strategies\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦 GI 肿瘤，详述了 FMT 恢复敏感性及特定菌（F. nucleatum）致耐药的机制。可用于 Ch2/Ch3 提供消化道肿瘤特异性的证据与路径；在 Ch5 评估工程菌及 FMT 的转化现状，指出供体筛选及安全性挑战，强调 GI 肿瘤中微生物作用的独特性。\"\n    },\n    {\n      \"source_handle\": \"P0456\",\n      \"paper_title\": \"The Resistance Mechanisms of Checkpoint Inhibitors in Solid Tumors\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述将微生物群列为 ICI 耐药机制之一，并详述了交叉反应等假说。可用于 Ch3 提供微生物与其他耐药机制（如 TME、基因突变）并列的框架；在 Ch4 强调微生物只是多因素网络中的一环，需结合内在肿瘤特征综合评估耐药原因，避免单一归因。\"\n    },\n    {\n      \"source_handle\": \"P0457\",\n      \"paper_title\": \"The tumor microbiome and cancer immunotherapy: A systematic review of a new frontier beyond the gut.\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦肿瘤内微生物群而非肠道菌群，提出局部免疫调节机制。可用于 Ch3 作为肠道全身效应之外的局部机制补充，区分作用部位；在 Ch6 指出空间异质性及功能验证的不足，提示未来需整合局部与全身微生物数据以全面解析免疫调节网络。\"\n    },\n    {\n      \"source_handle\": \"P0458\",\n      \"paper_title\": \"Examining the impact of the microbiome on cancer immunotherapy outcomes: A review\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述概括了有益菌属及三大机制路径（代谢物、细胞因子、抗原呈递）。可用于 Ch2/Ch3 提供结构化框架及关键菌种列表；在 Ch5 讨论干预策略及转化挑战，强调个体差异及伦理考量，适合作为构建综述逻辑骨架的基础素材，但需注意其概括性。\"\n    },\n    {\n      \"source_handle\": \"P0459\",\n      \"paper_title\": \"The circadian-microbiome-immune axis in colorectal cancer: mechanisms of spatiotemporal immunosuppression and chronotherapeutic horizons\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述提出昼夜节律 - 微生物 - 免疫轴假说，描述 TCA 代谢物介导的时相性免疫抑制。可用于 Ch3 提供时间生物学视角的机制假说；在 Ch4 讨论睡眠剥夺等宿主行为对微生物组及疗效的潜在影响，强调时间维度在解释疗效异质性中的重要性及临床前证据的局限。\"\n    },\n    {\n      \"source_handle\": \"P0460\",\n      \"paper_title\": \"Therapeutic targeting of the host-microbiota-immune axis: implications for precision health\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述总结了厚壁菌门成员与 ICI 疗效的关联及代谢/屏障机制。可用于 Ch2 提供关联证据；在 Ch3 详述丁酸盐促进 Treg/CD8+ T 细胞的具体路径；在 Ch5 讨论 FMT 及饮食干预的通用机制，强调需区分观察性关联与因果机制，并关注具体物种功能。\"\n    },\n    {\n      \"source_handle\": \"P0461\",\n      \"paper_title\": \"Immune checkpoint inhibitors in melanoma: mechanisms, immune cell interactions, and the tumour microenvironment\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦皮肤微生物组及 TME 机制，未涉及肠道菌群。可用于 Ch4 作为对比案例，说明不同解剖部位微生物（皮肤 vs 肠道）对免疫治疗的独立或协同影响，强调解剖特异性，避免将皮肤微生物发现直接等同于肠道机制，丰富对微环境多样性的理解。\"\n    },\n    {\n      \"source_handle\": \"P0462\",\n      \"paper_title\": \"Gut microbiome metabolites, molecular mimicry, and species-level variation drive long-term efficacy and adverse event outcomes in lung cancer survivors\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该研究提出分子模拟机制及菌株特异性影响，关联 SCFAs 与长期获益。可用于 Ch2 提供长期生存者的微生物特征；在 Ch3 详述抗原交叉反应介导疗效或 irAEs 的免疫学机制；在 Ch5 提出“智能 FMT”概念，强调需基于菌株动力学及抗原谱进行精准干预。\"\n    },\n    {\n      \"source_handle\": \"P0463\",\n      \"paper_title\": \"The Great Debate at 'Immunotherapy Bridge', Naples, December 5, 2019\",\n      \"chapter_ids\": [\n        \"Ch6_Challenges\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该辩论报告指出了菌种特异性证据不足及饮食直接免疫调节的争议。可用于 Ch6 反映领域早期对“组成 vs 功能”的争论，提示单一菌种标志物的局限性；在 Ch4 引入饮食作为独立于微生物组的潜在调节因子，强调需综合考虑多种宿主因素及干预策略的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0464\",\n      \"paper_title\": \"Potential mechanisms and targeting strategies of the gut microbiota in antitumor immunity and immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详述了四大类机制（先天/适应性免疫、代谢物、屏障）及具体菌株作用。可用于 Ch3 提供全面的机制分类及分子细节；在 Ch2 连接特定菌与 ICI 反应率；在 Ch5 总结 FMT、工程菌等策略的临床进展，强调需区分不同 ICI 药物（PD-1 vs CTLA-4）的微生物依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0465\",\n      \"paper_title\": \"Development of a novel immune-related toxicity grading system for predicting outcomes in patients with solid tumours treated with immune checkpoint inhibitors (ICI).\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现多器官 irAEs 比单一毒性更能预测生存获益。可用于 Ch4 支持“毒性 - 疗效”正相关现象，提示系统性免疫激活的重要性，为微生物组可能通过调节全身免疫状态同时影响疗效与毒性的假说提供临床表型依据，但需注明未直接检测微生物。\"\n    },\n    {\n      \"source_handle\": \"P0466\",\n      \"paper_title\": \"Shaping the Future of Immunotherapy Targets and Biomarkers in Melanoma and Non-Melanoma Cutaneous Cancers\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述总结了黑色素瘤中微生物组与疗效的关联及 FMT 初步数据。可用于 Ch2 提供皮肤癌领域的临床证据；在 Ch3 讨论代谢物及抗原交叉反应假说；在 Ch5 评估 FMT 逆转耐药的潜力，强调需区分黑色素瘤特异性发现与其他实体瘤的异同，避免过度泛化。\"\n    },\n    {\n      \"source_handle\": \"P0467\",\n      \"paper_title\": \"Managing Resistance to Immune Checkpoint Inhibitors in Lung Cancer: Treatment and Novel Strategies.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦肺癌耐药机制及治疗策略，未直接涉及微生物组。可用于 Ch4 提供肺癌背景下的耐药分类框架，说明微生物组可能通过调节 TME 或 T 细胞启动间接影响疗效，但需明确区分通用策略与微生物特异性发现，避免无依据的关联推断。\"\n    },\n    {\n      \"source_handle\": \"P0468\",\n      \"paper_title\": \"From Womb to World: Unravelling the Microbiota′s Impact on Health and Disease\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了微生物多样性、特定菌属与 ICI 疗效的关联及 FMT 潜力。可用于 Ch2/Ch3 提供基础关联证据及机制线索；在 Ch5 讨论 FMT 临床转化；在 Ch6 指出方法学异质性及因果推断局限，适合作为构建领域背景及挑战讨论的综合素材，需注意其叙事性质。\"\n    },\n    {\n      \"source_handle\": \"P0469\",\n      \"paper_title\": \"Gut microbiota-mediated immunomodulation in tumor\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述详述了 PAMPs 及代谢物介导的免疫调节机制及临床队列数据。可用于 Ch2 提供多癌种关联证据；在 Ch3 构建微生物 - 免疫互作概念模型（TLR/NF-kB, GPRs）；在 Ch6 讨论抗生素干扰及 FMT 潜力，强调需结合临床数据谨慎推断动物实验机制的人体适用性。\"\n    },\n    {\n      \"source_handle\": \"P0470\",\n      \"paper_title\": \"The impact of gut microbiota modulation on responses to immune checkpoint inhibitors in cancer.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该荟萃分析提供了特定菌属富集、抗生素暴露及 FMT 与 ICI 疗效的定量关联证据。可用于 Ch2 确立微生物组作为关键决定因素的统计学支持；在 Ch6 指出异质性及缺乏 irAEs 定量数据等局限，强调群体水平关联不能直接推断个体因果机制，需进一步分层分析。\"\n    },\n    {\n      \"source_handle\": \"P0471\",\n      \"paper_title\": \"Gut Microbiota and Cancer: From Pathogenesis to Therapy\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了早期关键研究，指出特定菌群（Akkermansia, Bifidobacterium）与 ICI 疗效关联及 TNF 等机制。可用于 Ch2 提供里程碑式临床证据；在 Ch3 解释免疫细胞浸润及细胞因子机制；在 Ch5 讨论益生菌及 FMT 的现状与挑战，需注意其 2019 年发表的时效性。\"\n    },\n    {\n      \"source_handle\": \"P0472\",\n      \"paper_title\": \"Immunometabolism: The role of gut‐derived microbial metabolites in optimising immune response during check