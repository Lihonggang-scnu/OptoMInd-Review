        "content": "```json\n{\n  \"additions\": [\n    {\n      \"unit_key\": \"Ch3_Mechanisms:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0369\",\n          \"proposed_use\": \"补充SCFAs、胆汁酸及色氨酸衍生物通过HDAC抑制、GPCR与AhR通路重塑免疫微环境的具体分子路径，解释同一代谢物在不同浓度或微环境下的双向调节作用。\"\n        },\n        {\n          \"source_handle\": \"P0413\",\n          \"proposed_use\": \"提供丁酸盐在抗PD-1治疗中促进CD8+ T细胞功能、而在抗CTLA-4治疗中可能增强Treg分化导致疗效受损的对照证据，支撑剂量与治疗靶点依赖性的综合判断。\"\n        },\n        {\n          \"source_handle\": \"P0326\",\n          \"proposed_use\": \"指出粪便/血清短链脂肪酸水平与ICI预后的关联存在方向矛盾（如抗CTLA-4队列中低丁酸预后更优），提示需从分类学转向功能代谢组学作为更稳健的预测维度。\"\n        },\n        {\n          \"source_handle\": \"P0391\",\n          \"proposed_use\": \"构建“微生物来源-介质-宿主受体-TME组分-结果”的五要素框架，将肠道代谢信号与局部肿瘤微环境重编程相连接，解释全身性代谢物如何转化为局部抗肿瘤表型。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch3_Mechanisms:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0388\",\n          \"proposed_use\": \"提供分段丝状菌（SFB）诱导肠道固有层Th17细胞迁移至远端肿瘤并转化为促炎Th1-like细胞的实证，阐明抗原交叉反应与CD4/CD8协作介导ICI疗效增强的细胞级联机制。\"\n        },\n        {\n          \"source_handle\": \"P0391\",\n          \"proposed_use\": \"区分肠道菌群远程信号与瘤内微生物局部效应的空间差异，说明微生物易位至次级淋巴器官后如何通过代谢梯度与表面蛋白互作直接启动适应性免疫应答。\"\n        },\n        {\n          \"source_handle\": \"P0364\",\n          \"proposed_use\": \"提出跨队列“功能趋同”假说，解释为何不同研究中响应相关菌种各异但均富集于免疫调节共生菌，支持微生物群通过共享免疫通路（如DC成熟、CD8+ T细胞致敏）发挥作用的理论框架。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch3_Mechanisms:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0363\",\n          \"proposed_use\": \"明确排除肿瘤内微生物组干扰，聚焦肠道系统性影响；批判性评估现有临床关联多为观察性数据，FMT等证据来自小规模概念验证试验，强调缺乏前瞻性验证与技术标准化不足的方法学局限。\"\n        },\n        {\n          \"source_handle\": \"P0398\",\n          \"proposed_use\": \"展示宏基因组荟萃分析中微生物标志物的治疗情境依赖性（如ICI单药中SCFA产生菌为积极标志物，而ICI+FMT中部分双歧杆菌反与非响应相关），揭示生态位竞争与代谢产物变化对因果推断的挑战。\"\n        },\n        {\n          \"source_handle\": \"P0356\",\n          \"proposed_use\": \"指出HCC等实体