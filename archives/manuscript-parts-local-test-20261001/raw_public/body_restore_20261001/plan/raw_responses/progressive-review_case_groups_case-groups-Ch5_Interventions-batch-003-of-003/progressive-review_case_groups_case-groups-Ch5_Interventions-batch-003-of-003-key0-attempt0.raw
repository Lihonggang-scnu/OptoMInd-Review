        "content": "{\n  \"additions\": [\n    {\n      \"unit_key\": \"Ch5_Interventions:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0212\",\n          \"proposed_use\": \"提供FMT联合ICI的汇总疗效数据（ORR 43%）及亚组分析，用于论证不同供体来源与给药途径对临床结局的趋势性影响，并量化安全性边界。\"\n        },\n        {\n          \"source_handle\": \"P0058\",\n          \"proposed_use\": \"补充消化道肿瘤中抗生素预处理FMT（A-FMT）的早期可行性与微生物组趋同证据，作为对比健康供体FMT在特定解剖部位定植策略的对照案例。\"\n        },\n        {\n          \"source_handle\": \"P0533\",\n          \"proposed_use\": \"提供FMT联合抗PD-1在难治性黑色素瘤患者中的I期临床试验数据，展示肿瘤放射学反应与CD8+ T细胞浸润增加的直接关联，用于论证FMT作为克服ICI原发性耐药的临床可行性及免疫重塑表型。\"\n        },\n        {\n          \"source_handle\": \"P0329\",\n          \"proposed_use\": \"基于418名NSCLC患者基线宏基因组数据构建机器学习预测模型，模拟健康供体FMT与治疗性菌群组合的定植依赖性响应提升，用于补充计算生物学视角下FMT疗效预测与精准供体匹配的方法学对照。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch5_Interventions:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0009\",\n          \"proposed_use\": \"提供MB097九菌株联合制剂的临床前机制与MELODY-1试验背景，用于说明从相关性发现到标准化定义菌群（LBP）转化的具体路径及当前局限。\"\n        },\n        {\n          \"source_handle\": \"P0122\",\n          \"proposed_use\": \"展示MET4联合体诱导宿主特异性IgG及外周免疫亚群重塑的早期人体数据，用于补充活体生物药除局部代谢物外的体液免疫调节维度及个体反应异质性。\"\n        },\n        {\n          \"source_handle\": \"P0473\",\n          \"proposed_use\": \"提供MaaT034共培养微生物组生态系统的体外机制证据，展示其通过分泌抗炎代谢物（SCFAs、吲哚）修复肠道屏障并增强抗PD-1介导的树突状细胞成熟与T细胞激活，用于说明标准化定义菌群（LBP）向工业化产品演进的技术路径。\"\n        },\n        {\n          \"source_handle\": \"P0150\",\n          \"proposed_use\": \"分析SER-401因万古霉素预处理导致目标厚壁菌门孢子定植失败、引发系统性炎症且疗效不优于安慰剂的案例，用于阐释抗生素预处理策略的双刃剑效应及LBP在GMP生产、冻干复苏与胃酸耐受方面面临的工程化瓶颈。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch5_Interventions:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0198\",\n          \"proposed_use\": \"提供限时进食（TRE）通过重塑色氨酸代谢物改善肾癌ICI响应的因果链条，作为非药物饮食干预克服原发耐药的实证案例及代谢重编程机制例证。\"\n        },\n        {\n          \"source_handle\": \"P0201\",\n          \"proposed_use