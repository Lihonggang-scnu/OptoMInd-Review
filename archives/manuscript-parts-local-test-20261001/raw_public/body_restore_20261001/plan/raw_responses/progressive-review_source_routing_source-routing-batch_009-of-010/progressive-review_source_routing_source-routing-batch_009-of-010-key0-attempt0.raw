{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0481\",\n      \"paper_title\": \"A microbiota-derived bile acid overcomes antibiotic-induced hyporesponsiveness to immune checkpoint therapy by enhancing CD8+ T cell antitumor immunity\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该研究在小鼠模型中证实，抗生素导致次级胆汁酸 TDCA 耗竭，削弱 CD8+ T 细胞功能及 ICI 疗效；补充 TDCA 可通过激活 TGR5 受体逆转此效应。可用于阐述“菌群 - 代谢物 - 免疫”的具体分子机制，解释抗生素负面影响的代谢基础，并作为代谢物替代疗法优于活菌疗法的概念验证案例，同时提示不同胆汁酸在不同肿瘤中的情境依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0482\",\n      \"paper_title\": \"Harnessing Bacterial Extracellular Vesicle Immune Effects for Cancer Therapy\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述详述细菌胞外囊泡（bEVs）作为非活菌组分，通过 TLR/NOD 通路激活固有免疫或工程化重编程巨噬细胞以增强 ICI 疗效的机制。可用于扩展除代谢物外的微生物作用载体视角，对比 bEVs 与活菌疗法在安全性、定植难度及规模化生产上的优劣，并指出从动物模型向人类转化时面临的药代动力学及免疫原性挑战。\"\n    },\n    {\n      \"source_handle\": \"P0483\",\n      \"paper_title\": \"Advancing Cancer Treatment: A Review of Immune Checkpoint Inhibitors and Combination Strategies\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了双歧杆菌等特定菌属通过促进树突状细胞成熟增强 PD-L1 阻断疗效的临床前及临床证据，并列出 SCFAs、胆汁酸等关键代谢物。可用于构建“肠 - 代谢物 - 免疫”轴的宏观框架，提供特定菌株与免疫细胞互作的实例，并将微生物调节策略置于放疗、代谢重编程等其他联合治疗背景下进行对比，强调肿瘤类型特异性。\"\n    },\n    {\n      \"source_handle\": \"P0484\",\n      \"paper_title\": \"The aging microbiome and response to immunotherapy: considerations for the treatment of older adults with cancer\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述提出衰老导致微生物组向“无响应者”特征偏移的概念模型，解释了老年患者 ICI 疗效较低的潜在宿主 - 微生物交互机制。可用于讨论年龄作为关键宿主因素如何修饰微生物组效应，强调在临床试验中纳入老年人群的必要性，并指出当前证据多基于推论而非直接干预数据，提示需关注衰老相关的生理变化对微生物介导疗效的特异性影响。\"\n    },\n    {\n      \"source_handle\": \"P0485\",\n      \"paper_title\": \"Abstract B023: Delineating the role of the microbiome and tumor microenvironment interactions driving mucosal melanoma (MM) response and resistance to immune checkpoint inhibitor (ICI) treatment\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该初步队列研究发现黏膜黑色素瘤响应者与非响应者间肠道菌群组成存在差异，且响应者中 CD56/CD20 表达升高。可用于展示罕见实体瘤亚型中微生物组与临床结局的关联证据，强调不同解剖部位肿瘤的微生物特征及基因组背景（如 UV 损伤 vs MMR 缺陷）对 ICI 响应的修饰作用，提示肿瘤异质性是解释微生物效应不一致的重要因素。\"\n    },\n    {\n      \"source_handle\": \"P0486\",\n      \"paper_title\": \"Targeting Microbiome Metabolites: Reshaping Immunotherapy and Clinical Management Strategies for Colorectal Cancer\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述详细解析结直肠癌中微生物代谢物（如丁酸盐、肌苷促进免疫；琥珀酸、次级胆汁酸抑制免疫）通过表观遗传修饰、受体激活及信号通路调控 T 细胞功能的具体机制。可用于构建从代谢物到免疫细胞功能的完整因果链条，评估益生菌、工程菌及代谢物补充剂的干预潜力，并指出多数机制基于动物模型，人类临床验证及标准化检测仍是主要挑战。\"\n    },\n    {\n      \"source_handle\": \"P0487\",\n      \"paper_title\": \"Gut microecology empowers cancer immunotherapy: commensal microbiota-mediated mechanisms and translational prospects of PD-1/PD-L1 therapy\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述列举了阿克曼氏菌、瘤胃球菌科等与 ICI 正相关的微生物特征，并详述 SCFAs 抑制 HDACs、色氨酸衍生物激活 AHR 等分子机制及 FMT 临床试验进展。可用于梳理有益菌群清单及其免疫调节路径（如 CXCL3-PD-L1 轴），对比 FMT 与合成生物学策略的转化现状，同时指出当前临床数据多来自小队列，缺乏标准化方案及大规模验证。\"\n    },\n    {\n      \"source_handle\": \"P0488\",\n      \"paper_title\": \"Gut Microbiome Dysbiosis and Its Impact on Reproductive Health: Mechanisms and Clinical Applications\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"虽聚焦生殖健康，该文详述 SCFAs 通过表观遗传控制 Foxp3 表达促进 Treg 分化及 LPS 易位引发全身炎症的通用免疫机制。可用于类比解释肠道微生物如何通过系统性免疫调节（如 Treg/Th17 平衡、屏障完整性）影响远端组织微环境，为理解微生物组在肿瘤免疫中的非特异性全身调节作用提供生理学背景，但需明确区分生殖与肿瘤微环境的差异。\"\n    },\n    {\n      \"source_handle\": \"P0489\",\n      \"paper_title\": \"Clinical impact of baseline and peri-treatment concomitant medication exposure and polypharmacy on outcomes of immune checkpoint inhibitor therapy: A real-world pan-tumor analysis.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该真实世界研究显示，ICI 启动前 30 天内抗生素暴露及基线多药联用（≥5 种）显著降低客观缓解率及无进展生存期。可作为抗生素破坏菌群进而削弱 ICI 疗效的强流行病学支持证据，用于论证药物 - 微生物 - 免疫轴的临床后果，并提示在评估 ICI 疗效时需考虑患者整体用药负担及抗生素种类、时机对菌群扰动的异质性影响。\"\n    },\n    {\n      \"source_handle\": \"P0490\",\n      \"paper_title\": \"Enhancing cancer immunotherapy and antiangiogenic therapy by regulating gut microbes: Opportunities and challenges\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述总结了双歧杆菌、阿克曼氏菌等特定菌群及代谢物与 ICI 疗效改善的临床关联，详述 DC 成熟、T 细胞激活及血管生成调节机制，并列出多项联合抗血管生成药物的临床试验。可用于提供微生物调节 ICI 疗效的广泛临床前及早期临床证据，对比不同干预策略（FMT、饮食、益生菌）的优劣，并强调种属差异及个体变异性对转化应用的限制。\"\n    },\n    {\n      \"source_handle\": \"P0491\",\n      \"paper_title\": \"Priming versus propagating: distinct immune effects of alpha- versus beta-particle emitting radiopharmaceuticals when combined with immune checkpoint inhibition in mice\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该小鼠研究发现α与β发射体联合 ICI 时分别启动免疫致敏与扩展现有免疫应答的不同机制，且效应依赖肿瘤免疫原性。虽未直接涉及微生物，但揭示了肿瘤内在免疫状态及治疗物理特性对 ICI 疗效的关键决定作用，可作为非微生物因素的重要对照，提示在讨论微生物调节机制时需考虑肿瘤微环境基础状态及联合治疗方式的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0492\",\n      \"paper_title\": \"Gut microbiota of dogs with cancer receiving anti-EGFR/HER2 immunization reveals potential biomarkers of patient survival\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该兽医学研究首次发现犬基线肠道菌群特定分类群与免疫治疗生存期相关，部分菌属与人类研究结果一致。可作为跨物种微生物组 - 免疫治疗关联的平行证据，支持微生物组作为普适性预后标志物的潜力，同时提示不同物种及免疫治疗机制下微生物效应的保守性与差异性，并警示 16S 测序分辨率及饮食等混杂因素对结果解释的限制。\"\n    },\n    {\n      \"source_handle\": \"P0493\",\n      \"paper_title\": \"Melanoma tumor microbiome as a predictor of anti-PD-1 and anti-CTLA-4 immunotherapy response.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该研究识别出黑色素瘤肿瘤内微生物群（而非仅肠道）特定物种与 ICI 响应及免疫检查点分子表达的相关性。可用于拓展微生物生态位视角，论证肿瘤局部微生物群作为独立预测因子的价值，提示微生物可能通过调节局部受体表达影响免疫状态，同时强调不同解剖部位微生物群落结构的异质性及测序技术对结果的可比性挑战。\"\n    },\n    {\n      \"source_handle\": \"P0494\",\n      \"paper_title\": \"Current status and future perspectives of multi‐modal bacteria‐based cancer therapies\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详述粪梭菌、双歧杆菌等通过 cDCs 迁移、STING 通路及 PD-L2/RGMb 轴增强 ICI 响应的机制，并列举多种细菌疗法临床试验。可用于支持特定共生菌作为疗效预测标志物的论点，解析微生物克服耐药的分子路径，并展示活菌疗法与 ICI 联合的临床现状及 AI 辅助设计的未来方向，同时指出不同癌种间疗效差异及生物安全挑战。\"\n    },\n    {\n      \"source_handle\": \"P0495\",\n      \"paper_title\": \"Stool Microbiome Profiling of Patients with Metastatic Renal Cell Carcinoma Receiving Anti-PD-1 Immune Checkpoint Inhibitors.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究在转移性肾细胞癌队列中证实基线微生物多样性及阿克曼氏菌丰度增加与 ICI 疗效正相关。可作为特定癌种（RCC）中微生物组预测价值的实证数据，支持多样性及特定菌种动态变化作为响应标志物的观点，提示黏液降解菌可能通过增强免疫浸润介导疗效，但需注明样本量有限且仅为观察性关联，因果机制尚待验证。\"\n    },\n    {\n      \"source_handle\": \"P0496\",\n      \"paper_title\": \"Reproducible stool metagenomic biomarkers linked to the melanoma immunotherapy positive outcome\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该研究通过多队列验证识别出普氏粪杆菌等稳健分类标志物及 SCFA 合成、Maillard 产物利用等功能通路，提出“功能分散假说”解释菌种标志物不一致性。可用于提供高置信度生物标志物清单，从功能基因组角度解析微生物介导免疫的代谢机制，并论证为何单一菌种补充可能不如功能导向策略有效，提示供体特异性及定植抵抗是 FMT 异质性的来源。\"\n    },\n    {\n      \"source_handle\": \"P0497\",\n      \"paper_title\": \"Hidden army within: Harnessing the microbiome to improve cancer treatment outcomes\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了特定菌群与 ICI 及化疗疗效的关联证据，概述 SCFAs 调节 T 细胞记忆、TLR4 通路诱导自噬等机制，并讨论 FMT、噬菌体等干预策略的临床转化障碍。可用于构建微生物影响多种治疗模式的综合背景，提供机制假设线索及干预手段的理论依据，同时强调方法标准化、生物标志物验证及伦理监管是当前从基础研究向临床实践过渡的关键瓶颈。\"\n    },\n    {\n      \"source_handle\": \"P0498\",\n      \"paper_title\": \"Improved overall survival in an anti-PD-L1 treated cohort of newly diagnosed glioblastoma patients is associated with distinct immune, mutation, and gut microbiome features: a single arm prospective phase I/II trial\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该前瞻性试验发现胶质母细胞瘤患者基线 Bacillota 门富集与抗 PD-L1 生存获益及高免疫浸润评分（EIS）相关，且 EIS 仅在免疫治疗背景下预测生存。可用于提供“冷”肿瘤中微生物组通过“预热”免疫微环境（激活 DC、M1 巨噬细胞）增强 ICI 疗效的具体案例，强调微生物效应的情境依赖性（依赖免疫治疗背景），并提示粪便样本可能无法完全代表局部微环境。\"\n    },\n    {\n      \"source_handle\": \"P0499\",\n      \"paper_title\": \"An Insight on Gut Flora, Colorectal Cancer Mechanism, and Treatment Strategies\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详述结直肠癌中阿克曼氏菌等有益菌及具核梭杆菌等致病菌对 ICI 及化疗疗效的双向调节机制，包括 TLR 信号激活、药物代谢酶活性及炎症微环境塑造。可用于列举 CRC 特异性菌群标志物及其分子作用路径，对比不同治疗模式下微生物作用的异同，并指出饮食（红肉、纤维）作为关键混杂因素对微生物组及治疗易感性的塑造作用。\"\n    },\n    {\n      \"source_handle\": \"P0500\",\n      \"paper_title\": \"Branched chain amino acids recruit NKT cells to enhance breast cancer response to ⍺PD-1 immune checkpoint blockade following bariatric surgery 3947\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该研究揭示减肥手术通过改变肠道菌群增加支链氨基酸（BCAA），进而招募 NKT 细胞增强乳腺癌抗 PD-1 疗效的机制。可用于提供“宿主生理改变 - 菌群代谢 - 特定免疫细胞招募”的完整因果链条案例，证明非药物干预（手术/FMT）可通过代谢重编程增敏 ICI，同时提示该机制在乳腺癌模型中的特异性及人类数据有限的局限性。\"\n    },\n    {\n      \"source_handle\": \"P0501\",\n      \"paper_title\": \"Microbiome and cancer immunotherapy: a bibliometric analysis\",\n      \"chapter_ids\": [\n        \"Ch6_Challenges\",\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该文献计量分析描绘了领域从“关联发现”向“精准预测”和“工程菌”演变的学术谱系，指出当前证据多为相关性、缺乏 RCT、存在发表偏倚及地域代表性不足。可用于宏观评估证据质量与局限性，论证为何需从分类学导向转向功能/代谢物导向，并为未来研究方向（如核心功能菌株鉴定、多组学整合、安全性管理）提供结构化建议。\"\n    },\n    {\n      \"source_handle\": \"P0502\",\n      \"paper_title\": \"The human microbiome: an emerging paradigm for better health\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述确认微生物组在调节 ICI 疗效中的关键作用，指出抗生素削弱疗效而特定菌群增强 T 细胞浸润。可用于提供临床异质性的背景解释，确立“恢复健康菌群可增强疗效”的概念框架，并提示未来精准医疗需依赖伴随诊断识别微生物缺陷。需注意其机制描述较宏观，缺乏具体分子路径细节，主要作为概念引入而非深度机制证据。\"\n    },\n    {\n      \"source_handle\": \"P0503\",\n      \"paper_title\": \"Microbiota-derived metabolites: Key modulators of cancer immunotherapies.\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详细区分 SCFAs、色氨酸衍生物、胆汁酸等代谢物在不同肿瘤及 ICI 靶点下的双向调节作用（如 SCFAs 在 NSCLC 有益但在黑色素瘤抗 CTLA-4 中可能有害），并解析 GPR41/43、AHR、TGR5 等受体机制。可用于解释临床结果异质性的代谢基础，论证从“分类学”向“功能/代谢物”范式转变的必要性，并评估活体生物制品及后生元干预的成败案例。\"\n    },\n    {\n      \"source_handle\": \"P0504\",\n      \"paper_title\": \"Killing cancer takes guts: lessons learned from the manipulation of gut microbiome and immunotherapy for the future of urothelial carcinoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦尿路上皮癌，总结阿克曼氏菌等与预后的关联及 FMT、益生菌干预的早期试验数据，详述 T 细胞启动、DC 成熟及代谢产物（如 trigonelline）调节机制。可用于构建 UC 特异性微生物景观，展示该癌种特有的微生物 - 免疫互作模式，并讨论 FMT 制备标准化、供体筛选及 irAEs 风险管理等临床转化实操挑战。\"\n    },\n    {\n      \"source_handle\": \"P0505\",\n      \"paper_title\": \"Combination therapy with levofloxacin and the probiotic Clostridium butyricum MIYAIRI 588 enhances immune checkpoint inhibitor efficacy\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该小鼠研究显示左氧氟沙星联合丁酸梭菌可增强 ICI 疗效且依赖 CD8+ T 细胞，而广谱抗生素联合则无效甚至加重结肠炎。可提供“特定抗生素 + 益生菌”精准调控策略的实证案例，证明并非所有抗生素均有害，关键在于清除竞争性菌群并补充功能菌，同时警示免疫激活增强可能伴随 irAEs（结肠炎）风险增加的权衡问题。\"\n    },\n    {\n      \"source_handle\": \"P0506\",\n      \"paper_title\": \"Combination strategies of gut microbiota in cancer therapy through metabolic reprogramming and immune remodeling\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详述双歧杆菌等通过 cGAS/STING 通路、交叉反应抗原呈递及代谢物信号增强 ICI 疗效的机制，并讨论 FMT 及益生菌临床试验。可用于构建多层次的机制框架（直接免疫激活、分子模拟、代谢调节），提供具体分子通路细节，并对比不同干预策略在恢复菌群及克服耐药中的潜力，同时指出动物模型数据向人类转化的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0507\",\n      \"paper_title\": \"Research Progress of Metabolites of Intestinal Microbiota Reshaping Tumor Immune Microenvironment and Immunotherapy Response Through PD-1/PD-L1 Pathway\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述提出受体依赖信号传导与表观遗传编程两大机制类别，概述代谢物重塑肿瘤免疫微环境（TIME）从“冷”变“热”的过程。可用于提供理论框架以分类解释微生物代谢物的作用模式，区分直接信号互作与广泛表观遗传修饰，并作为连接基础机制与 FMT 等临床策略的桥梁，但需注意其缺乏具体分子细节及定量效应数据。\"\n    },\n    {\n      \"source_handle\": \"P0508\",\n      \"paper_title\": \"Impact of antibiotic use on survival in patients with advanced cancers treated on immune checkpoint inhibitor phase I clinical trials.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该研究在泛实体瘤 I 期试验队列中探索抗生素对生存的影响，虽结果缺失但设计涵盖多癌种。可作为抗生素 - 菌群 -ICI 轴在广泛实体瘤中普遍性假设的背景素材，提示 I 期试验人群经过严格筛选且多线治疗史可能引入选择偏倚，需谨慎外推至常规治疗人群，并强调需进一步验证抗生素效应在不同癌种中的异质性。\"\n    },\n    {\n      \"source_handle\": \"P0509\",\n      \"paper_title\": \"The microbiome as a systems-level regulator of immune, metabolic, neural, and endocrine signaling in cancer\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述提出微生物通过免疫、代谢及神经轴（如迷走神经）系统性调节 ICI 疗效的框架，详述 MAMPs 激活 TLRs/NLRs 及代谢物调节表观遗传的机制。可用于构建多系统信号整合的宏观机制视图，特别强调神经 - 免疫轴在胶质瘤等特定肿瘤中的作用，并指出当前证据多为动物模型及观察性研究，缺乏大规模临床验证及标准化检测流程。\"\n    },\n    {\n      \"source_handle\": \"P0510\",\n      \"paper_title\": \"Abstract C023: A microbiome-produced metabolite drives immunostimulatory macrophages and boosts response to immune checkpoint inhibitors in pancreatic cancer\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该摘要报告 TMAO 通过增强 I 型干扰素通路促进巨噬细胞免疫刺激性表型，从而在胰腺癌中增敏 ICB，且患者体内产 TMAO 菌与响应正相关。可提供难治性肿瘤中代谢物介导免疫重塑的具体机制案例，证明微生物代谢物可主动驱动免疫刺激而非仅作为标志物，但需注明限于胰腺癌模型及摘要数据，人类因果证据及安全性尚待确认。\"\n    },\n    {\n      \"source_handle\": \"P0511\",\n      \"paper_title\": \"Meta-analysis of the gut microbiota in predicting response to cancer immunotherapy in metastatic melanoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该荟萃分析确认普氏粪杆菌富集及维生素 B 代谢通路增强与黑色素瘤 ICI 响应跨队列一致，但预测模型准确度中等。可提供高置信度分类及功能标志物清单，支持功能层面（代谢潜力）比单一物种更具泛化性的观点，并指出全球微生物结构差异及多重检验未校正等局限，提示需整合多组学数据以提升预测力。\"\n    },\n    {\n      \"source_handle\": \"P0512\",\n      \"paper_title\": \"Moving on from Metchnikoff: thinking about microbiome therapeutics in cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该观点文章汇总 FMT 传递敏感性及高多样性菌群关联的关键证据，提出通过增加肿瘤浸润淋巴细胞（TILs）及维持多样性介导疗效的机制假设。可用于确立微生物组影响 ICI 疗效的核心流行病学及动物模型证据链，对比益生菌、FMT 及窄谱抗生素等干预手段的优劣，并强调“后微生物组相互作用”范式及标准化检测流程的缺失。\"\n    },\n    {\n      \"source_handle\": \"P0513\",\n      \"paper_title\": \"Microbiome–Driven Carcinogenesis and Circulating Microbial Signals in Genitourinary Cancers\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述发现尿路上皮癌及肾癌中循环 EV 相关细菌 DNA 信号（厚壁菌门/拟杆菌纲）与 ICI 预后及免疫表型（Treg 浸润）相关。可提供泌尿生殖肿瘤特异性微生物信号与疗效关联的案例，论证循环微生物信号作为反映肿瘤免疫微环境的系统性读数的潜力，同时警示低生物量样本污染风险及 EV 分离技术差异对结果可比性的影响。\"\n    },\n    {\n      \"source_handle\": \"P0514\",\n      \"paper_title\": \"Gut microbiota in colorectal cancer: a review of its influence on tumor immune surveillance and therapeutic response\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详述结直肠癌中阿克曼氏菌等有益菌及 SCFAs 通过促进 DC 成熟、调节 Treg 分化及 Wnt/β-catenin 通路影响 ICI 响应的机制。可提供 CRC 特异性菌群 - 疗效关联及分子路径细节，讨论 FMT 联合抗 PD-1 的协同效应，并指出不同研究间结果矛盾（如拟杆菌属的双重角色）及检测方法学差异导致的异质性挑战。\"\n    },\n    {\n      \"source_handle\": \"P0515\",\n      \"paper_title\": \"Gut Microbiota-Derived Metabolites in Cancer Immunotherapy: Mechanisms and Clinical Potential\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述系统拆解 SCFAs、胆汁酸及色氨酸代谢物通过 HDAC 抑制、GPCR 激活及 AhR 途径调节 T 细胞、巨噬细胞及 DC 功能的机制。可用于构建“微生物组成 - 代谢物 - 免疫调节 - 临床疗效”的逻辑框架，评估 FMT 及代谢物补充的临床潜力，并强调因果关系验证、个体异质性及药代动力学知识不足是当前转化主要障碍。\"\n    },\n    {\n      \"source_handle\": \"P0516\",\n      \"paper_title\": \"The gut microbiome and gastrointestinal cancers: mechanisms, biomarkers and therapeutic opportunities\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述聚焦胃肠道癌症，列举阿克曼氏菌等与 ICI 响应正相关及具核梭杆菌通过 Fap2-TIGIT 轴抑制免疫的机制，并讨论抗生素负面影响及 FMT 逆转耐药证据。可提供 GI 癌特异性微生物指纹及免疫抑制机制细节，对比不同治疗模式（化疗/放疗）中微生物作用的异同，并指出饮食、PPIs 等可调节因素对微生物组及预后的塑造作用。\"\n    },\n    {\n      \"source_handle\": \"P0517\",\n      \"paper_title\": \"The effects of antibiotics on the efficacy of immune checkpoint inhibitors in patients with non-small-cell lung cancer differ based on PD-L1 expression.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该研究发现抗生素仅在 PD-L1 高表达（≥50%）NSCLC 患者中显著降低 OS，而在低表达人群中无影响。可提供宿主生物标志物（PD-L1）修饰抗生素/微生物组效应的关键临床证据，解释疗效异质性来源，提示高 PD-L1 患者可能对菌群扰动更敏感，但需注明限于 NSCLC 单药治疗及回顾性设计，具体分子机制尚待阐明。\"\n    },\n    {\n      \"source_handle\": \"P0518\",\n      \"paper_title\": \"Regulation of PD‐1PD‐L1 Immune Checkpoints by Gut Microbiota Metabolites and Their Clinical Translational Research: A Review\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详述丁酸盐通过 HDAC-FOXO1 轴、色氨酸代谢物通过 AhR 及胆汁酸通过 FXR/TGR5 调节 PD-1/PD-L1 表达及 T 细胞功能的双向机制。可提供代谢物调控免疫检查点的分子图谱，解释剂量及肿瘤类型依赖性效应，并评估基于代谢物的生物标志物及 FMT、工程菌等干预策略的临床转化现状，强调情境复杂性避免单一方向简化。\"\n    },\n    {\n      \"source_handle\": \"P0519\",\n      \"paper_title\": \"Gut Microbiota Dysbiosis, Oxidative Stress, Inflammation, and Epigenetic Alterations in Metabolic Diseases\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"虽聚焦代谢病，该文详述 SCFAs 抑制 HDAC 导致组蛋白乙酰化及 LPS 诱导 NF-κB 表观遗传调控的通用机制。可用于类比解释菌群失调通过表观遗传修饰塑造抑制性免疫微环境的潜在路径，为理解膳食纤维/益生菌通过表观遗传增敏 ICI 提供理论基础，但需明确区分代谢组织与肿瘤微环境的差异及缺乏肿瘤特异性数据。\"\n    },\n    {\n      \"source_handle\": \"P0520\",\n      \"paper_title\": \"PD-1/PD-L1 Cancer Immunotherapeutics Reshape Tumor Microenvironment – Clinical Evidence and Molecular Mechanisms for AI-based Precision Medicine\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述列举双歧杆菌等四种细菌及 SCFAs 改善 ICI 疗效的临床关联，并详述泛素化修饰（UPS）调控 PD-1/PD-L1 稳定性的分子机制。可提供特定菌种与临床响应的定量关联证据，揭示微生物可能通过影响宿主泛素化机器间接调节 ICI 疗效的潜在路径，并讨论 AI 在整合多组学数据预测响应及设计新型疗法中的应用前景与挑战。\"\n    },\n    {\n      \"source_handle\": \"P0521\",\n      \"paper_title\": \"The gut-tumor connection: the role of microbiota in cancer progression and treatment strategies\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述拆解免疫调节、代谢控制、空间易位及跨物种信号四大机制路径，详述肌苷、SCFAs 等代谢物作用及 FMT 逆转耐药案例。可提供从分子到细胞层面的完整机制解释，论证肠道菌通过血液/淋巴易位直接影响 TME 的可能性，并对比饮食、工程菌等干预策略，强调癌种特异性及代谢物双向作用的情境依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0522\",\n      \"paper_title\": \"The Impact of the Microbiome on Resistance to Cancer Treatment with Chemotherapeutic Agents and Immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述汇总阿克曼氏菌等与 NSCLC、RCC 及黑色素瘤 ICI 获益正相关的临床数据，详述 SCFAs 通过 GPR109a 调节代谢及免疫细胞互作机制，并记录抗生素负面效应及 FMT 恢复疗效案例。可提供跨癌种的具体菌群标志物及免疫调节细节，呈现丁酸在化学预防与 ICI 疗效中的悖论效应，并指出 FMT 缺乏大规模 RCT 证据的局限。\"\n    },\n    {\n      \"source_handle\": \"P0523\",\n      \"paper_title\": \"Gut-targeted strategies at the intersection of radiotherapy and immunotherapy\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该评论文章详述 SCFAs 及胆汁酸双向调节 DC 成熟及 T 细胞分化的机制，并批判性分析放疗诱导微生物改变的局限（毒性、归因模糊）。可提供代谢物上下文依赖性机制的详细解释，论证为何单一干预可能产生相反结果，并支持直接微生物调控（如口服万古霉素、LBP）作为比放疗非特异性效应更可控的替代策略。\"\n    },\n    {\n      \"source_handle\": \"P0524\",\n      \"paper_title\": \"Challenges and knowledge gaps with immune checkpoint inhibitors monotherapy in the management of patients with non-small-cell lung cancer: a survey of oncologist perceptions\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该调查显示 61% 肿瘤医生认为调节肠道菌群可增加 ICI 疗效，并将疗效预测及脑转移管理列为关键未满足需求。可提供临床界面对微生物组干预潜力的认知现状及证据不足以指导决策的现状，反映真实世界临床决策与试验证据的差距，并确认抗生素及 PPIs 作为潜在疗效调节因素的临床关注度，但需注意数据基于主观意见而非客观机制。\"\n    },\n    {\n      \"source_handle\": \"P0525\",\n      \"paper_title\": \"Modeling the effect of gut microbiome on therapeutic efficacy of immune checkpoint inhibitors against cancer.\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该计算模型研究预测初始有益菌水平及生长率是黑色素瘤抗 PD-1 响应的关键预测因子，并提出通过调节初始状态将无响应者转为响应者的理论机制。可提供微生物动力学参数作为生物标志物的理论依据，展示计算模型在 bridging 临床异质性与微生物因素中的作用，但需注明结果为模拟预测而非独立前瞻性验证，因果链条基于模型假设。\"\n    },\n    {\n      \"source_handle\": \"P0526\",\n      \"paper_title\": \"The role of the gut microbiome in regulating the response to immune checkpoint inhibitor therapy.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述确认微生物组组成差异是解释 ICI 预后异质性的重要因素，指出抗生素/PPIs 等药物干扰及动态建模的必要性。可作为宏观背景框架引入微生物组 - 免疫轴的重要性，提示需关注特异性物种鉴定及动态变化，但需注明其缺乏具体因果证据链及效应量数据，主要作为引出后续详细机制研究的起点。\"\n    },\n    {\n      \"source_handle\": \"P0527\",\n      \"paper_title\": \"Microbiome and gut-liver interactions: From mechanisms to therapies\",\n      \"chapter_ids\": [],\n      \"specific_usable_material\": \"该文聚焦肝病而非实体瘤或 ICI 治疗，虽讨论胆汁酸代谢及肠道通透性等通用机制，但缺乏肿瘤免疫背景下的直接证据。其关于微生物调节免疫的描述主要基于肝病病理，不能直接外推至 ICI 疗效机制，故不纳入核心论证，仅可作为理解肠 - 肝轴一般原理的极边缘参考，避免混淆疾病语境。\"\n    },\n    {\n      \"source_handle\": \"P0528\",\n      \"paper_title\": \"Advances in Brain–Gut–Microbiome Interactions: A Comprehensive Update on Signaling Mechanisms, Disorders, and Therapeutic Implications\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"虽未涉及肿瘤，该文详述微生物通过 SCFAs、色氨酸代谢物调节神经炎症及胶质细胞活化的通用机制，及多组学整合趋势。可提供微生物系统性调节免疫稳态的基础生物学原理（如 Treg 诱导、屏障控制），作为理解 ICI 研究中特异性免疫微环境变化的背景对照，并警示饮食等混杂因素及动物模型向人类转化的因果推断局限。\"\n    },\n    {\n      \"source_handle\": \"P0529\",\n      \"paper_title\": \"Recent advances in understanding pancreatic cancer\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述指出 PDAC 肿瘤内细菌清除可重编程微环境，减少 MDSCs 并促进 CD8+ T 细胞活化，理论上增强 ICI 疗效。可提供 PDAC 这一“冷”肿瘤中微生物调节免疫的具体案例，详述 KRAS 驱动髓系募集及代谢串扰机制，解释单纯 ICI 失败原因，但需注明多为前临床及观察性数据，临床转化及因果关系尚待大规模试验确证。\"\n    },\n    {\n      \"source_handle\": \"P0530\",\n      \"paper_title\": \"Prediction, prevention, and precision treatment of immune checkpoint inhibitor neurological toxicity using autoantibodies, cytokines, and microbiota\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述列举拟杆菌等与广义 irAEs 易感性相关的菌属，详述 ICI 打破免疫耐受的 T/B 细胞机制。可提供微生物组调节宿主免疫系统进而影响 ICI 反应性及毒性的背景框架，提示微生物可能通过 PRRs 刺激 GALT 影响初始细胞 priming，但需明确目前尚无 n-irAEs 特异性微生物签名，且机制多基于宿主免疫变化而非直接微生物分子互作。\"\n    },\n    {\n      \"source_handle\": \"P0531\",\n      \"paper_title\": \"Clinical utility of tumour mutational burden on efficacy of immune checkpoint inhibitors in malignant solid tumours: protocol for a systematic review and meta-analysis\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该方案确立 TMB 作为预测因子的分析框架及关键混杂因素（测序技术、联合治疗）。虽不直接涉及微生物，但可作为宿主基因组因素与外在微生物因素交互作用的对照基准，解释为何单纯依赖 TMB 预测存在不确定性，并提示方法学异质性（如阈值定义、平台差异）是导致不同研究结果不一致的重要原因，需在未来微生物研究中规避。\"\n    },\n    {\n      \"source_handle\": \"P0532\",\n      \"paper_title\": \"Focus on gut microbes: new direction in cancer treatment\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述列举双歧杆菌等有益菌及具核梭杆菌通过 STING 通路、T 细胞耗竭逆转调节 ICI 疗效的机制，并讨论 FMT 及工程菌前景。可提供关键微生物标志物清单及具体分子机制（如 FAP2-TIGIT 轴），展示微生物通过生物物理特性（ECM 刚度）影响治疗的新视角，并指出个体差异、安全性及标准化缺失是当前转化主要瓶颈。\"\n    },\n    {\n      \"source_handle\": \"P0533\",\n      \"paper_title\": \"Tumor-Associated Microbiome: Where Do We Stand?\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述汇总多癌种中微生物组与 ICI 反应关联，提出交叉反应 T 细胞激活、MAMPs 激活 DC 及 MDSC 招募等机制假说，并报告 FMT 诱导肿瘤反应的 I 期试验结果。可提供跨癌种普遍性证据及具体生物学路径解释，区分肠道与肿瘤局部微生物组作用，并指出方法学局限（测序技术、偏倚控制）及 FMT 早期阶段的不确定性。\"\n    },\n    {\n      \"source_handle\": \"P0534\",\n      \"paper_title\": \"Gut Microbiome Modulation and Outcomes of Immune Checkpoint Inhibitors in Solid Tumors: A Secondary Qualitative Review\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该定性综述提出从“分类学”向“功能/生态系统”范式转变，指出响应者具高多样性及特定有益菌，强调生态韧性理论。可提供微生物组作为宿主生物标志物的合理性论证，解释为何单一菌种补充效果不佳（需生态整体调节），并批判性评估当前证据的方法学缺陷（小样本、混杂因素控制不足）及干预试验的早期性质。\"\n    },\n    {\n      \"source_handle\": \"P0535\",\n      \"paper_title\": \"Intratumoral Microbiota in Tumor: Current Understandings and Future Perspectives\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述详述肿瘤内细菌（如具核梭杆菌上调 PD-L1、双歧杆菌激活 STING）调节 ICI 疗效的机制，区分其与肠道菌群的不同生态位。可提供局部微生物生态影响治疗响应的具体分子路径（代谢、信号、细胞招募），论证瘤内微生物作为独立预测因子的价值，并强调低生物量样本污染风险及严格对照设置的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0536\",\n      \"paper_title\": \"肠道菌群调控肿瘤免疫应答的机制及其临床转化潜力 (Mechanisms of Gut Microbiota Regulating Tumor Immune Response and Their Potential for Clinical Translation)\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该中文综述概括 PRR 信号、SCFAs 及色氨酸代谢物调控抗肿瘤免疫的机制，并提及 FMT 在黑色素瘤的突破及抗生素负面效应。可作为机制分类框架及临床转化策略的背景素材，提供从基础机制到应用的整体视野，但需注明基于摘要信息，缺乏具体分子细节及不同肿瘤类型异质性分析，需结合其他全文文献补充实证强度。\"\n    },\n    {\n      \"source_handle\": \"P0537\",\n      \"paper_title\": \"Impact of proton pump inhibitors on immunotherapy is modulated by prior chemotherapy and linked to gut microbiome–immune cell signatures\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究发现 PPI 降低 ICI 疗效但近期化疗可消除此效应，并关联 PPI 相关菌群变化与特定 T 细胞亚群。可提供药物 - 微生物 - 免疫交互作用的实证案例，解释既往 PPI 研究结果异质性（化疗时序调节），提示 H2B 可能为更安全替代，但需注明微生物 - 免疫关联基于极小样本，仅为假设生成且存在残留混杂风险。\"\n    },\n    {\n      \"source_handle\": \"P0538\",\n      \"paper_title\": \"Infiltration characteristics and regulatory mechanisms of CD8+ T lymphocytes in solid tumors: spatial distribution, biological functions, and interactions with the immune microenvironment\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述详述实体瘤微环境中代谢竞争（乳酸、腺苷）、免疫抑制细胞网络及物理屏障阻碍 CD8+ T 细胞功能的机制。虽未直接涉及菌群，但提供了菌群代谢物（如 SCFAs）可能作用的下游靶点场景，有助于假设菌群通过拮抗抑制性信号或调节髓系细胞增敏 ICI，并定义原发/继发性耐药机制以定位菌群潜在作用环节。\"\n    },\n    {\n      \"source_handle\": \"P0539\",\n      \"paper_title\": \"The silent pharmacist: Harnessing the gut microbiome to improve therapy in hematologic malignancies\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"虽聚焦血液肿瘤，该综述详述阿克曼氏菌等通过 SCFAs、T 细胞分化及屏障完整性调节 ICI 疗效的机制。可作为跨体系类比素材，支持微生物组成分与疗效正相关的论点，提供具体有益菌种及免疫调节通路细节（Th17/Treg 平衡），但需明确指出疾病背景差异，强调机制相似性而非结果直接等同，并提示血液与实体瘤微环境差异。\"\n    },\n    {\n      \"source_handle\": \"P0540\",\n      \"paper_title\": \"The mechanisms and therapeutic potential of the microbiome-immune interface in cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述列举阿克曼氏菌等与 ICI 响应相关的菌种，提出代谢物影响抗原呈递及 T 细胞激活的机制假设，并概述 FMT 及工程菌等干预策略。可提供关键微生物候选名单及机制假设框架，用于讨论微生物信号转化为免疫调节的潜在生物学路径，并指出精确分子机制尚不明确及临床转化面临标准化、监管及个体多样性等实际障碍。\"\n    }\n  ]\n}",
