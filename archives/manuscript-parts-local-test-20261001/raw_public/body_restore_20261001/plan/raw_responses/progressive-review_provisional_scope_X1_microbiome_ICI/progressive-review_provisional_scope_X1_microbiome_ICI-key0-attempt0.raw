{
  "choices": [
    {
      "message": {
        "content": "{\n  \"review_title\": \"肠道微生物组调节实体瘤免疫检查点抑制剂疗效的机制与临床转化：系统综述\",\n  \"central_question\": \"肠道微生物组如何通过特定菌群、代谢产物及免疫调节机制影响实体瘤患者对免疫检查点抑制剂（ICI）的治疗反应，且哪些干预策略具有临床转化潜力？\",\n  \"provisional_scope\": \"本综述涵盖实体瘤（如黑色素瘤、非小细胞肺癌、肾细胞癌、结直肠癌等）患者接受免疫检查点抑制剂（PD-1/PD-L1、CTLA-4 抑制剂）治疗的情境。重点分析肠道微生物组组成（分类学）、功能（代谢通路）及特定代谢产物（如短链脂肪酸、肌苷、胆汁酸）与 ICI 疗效（ORR、PFS、OS）及毒性（irAEs）的关联。纳入临床观察性研究、干预性试验（FMT、益生菌、饮食）及机制研究（动物模型、体外实验）。排除血液系统恶性肿瘤、非 ICI 免疫疗法（如 CAR-T，除非作为对比背景）及纯方法学论文。\",\n  \"material_theme_inventory\": [\n    {\n      \"theme\": \"临床关联证据\",\n      \"description\": \"特定菌属（如 Akkermansia, Bifidobacterium, Faecalibacterium）与 ICI 疗效正相关；抗生素暴露与疗效负相关；不同瘤种间存在异质性。\",\n      \"key_sources\": [\n        \"P0014\",\n        \"P0033\",\n        \"P0092\",\n        \"P0298\",\n        \"P0543\",\n        \"P0585\"\n      ]\n    },\n    {\n      \"theme\": \"介导机制\",\n      \"description\": \"微生物代谢物（SCFAs、肌苷、色氨酸衍生物）通过调节树突状细胞成熟、CD8+ T 细胞活化及免疫检查点表达发挥作用；抗原模拟假说。\",\n      \"key_sources\": [\n        \"P0009\",\n        \"P0114\",\n        \"P0196\",\n        \"P0447\",\n        \"P0503\",\n        \"P0582\"\n      ]\n    },\n    {\n      \"theme\": \"干预策略\",\n      \"description\": \"粪菌移植（FMT）在部分瘤种中显示逆转耐药潜力，但结果不一；益生菌/益生元/饮食干预处于早期探索阶段；缺乏标准化方案。\",\n      \"key_sources\": [\n        \"P0029\",\n        \"P0178\",\n        \"P0577\",\n        \"P0578\",\n        \"P0583\"\n      ]\n    },\n    {\n      \"theme\": \"情境调节因素\",\n      \"description\": \"肿瘤类型、ICI 方案（单药 vs 联合）、抗生素使用时机、宿主饮食及遗传背景显著影响微生物组效应。\",\n      \"key_sources\": [\n        \"P0002\",\n        \"P0398\",\n        \"P0489\",\n        \"P0575\",\n        \"P0585\"\n      ]\n    },\n    {\n      \"theme\": \"方法学与挑战\",\n      \"description\": \"缺乏大规模 III 期 RCT 验证；代谢物定量数据不足；因果推断困难；供体筛选与安全性问题。\",\n      \"key_sources\": [\n        \"P0001\",\n        \"P0354\",\n        \"P0501\",\n        \"P0574\"\n      ]\n    }\n  ],\n  \"provisional_outline\": {\n    \"chapters\": [\n      {\n        \"chapter_id\": \"Ch1_Intro\",\n        \"title\": \"引言：实体瘤免疫治疗的瓶颈与微生物组视角\",\n        \"purpose\": \"确立 ICI 疗效异质性的临床背景，引出肠道微生物组作为关键调节因子的理论依据。\",\n        \"question\": \"为何需要关注肠道微生物组在 ICI 疗效中的作用？\"\n      },\n      {\n        \"chapter_id\": \"Ch2_Clinical\",\n        \"title\": \"肠道微生物组与 ICI 疗效的临床关联证据\",\n        \"purpose\": \"综合不同实体瘤中微生物特征（多样性、特定菌属）与临床结局（生存、响应）的关联数据。\",\n        \"question\": \"哪些微生物特征 consistently 预测 ICI 疗效？\"\n      },\n      {\n        \"chapter_id\": \"Ch3_Mechanisms\",\n        \"title\": \"微生物调节免疫治疗的分子与细胞机制\",\n        \"purpose\": \"解析代谢物、免疫细胞互作及抗原模拟等具体生物学路径。\",\n        \"question\": \"微生物组通过哪些具体机制介导 ICI 疗效？\"\n      },\n      {\n        \"chapter_id\": \"Ch4_Context\",\n        \"title\": \"影响微生物组效应的情境因素\",\n        \"purpose\": \"讨论肿瘤类型、治疗方案、抗生素时机及宿主因素对微生物 - 免疫互作的修饰作用。\",\n        \"question\": \"为何微生物组效应在不同研究间存在异质性？\"\n      },\n      {\n        \"chapter_id\": \"Ch5_Interventions\",\n        \"title\": \"微生物组干预策略的临床转化现状\",\n        \"purpose\": \"评估 FMT、益生菌、饮食等干预手段的安全性、有效性及试验进展。\",\n        \"question\": \"目前有哪些微生物组干预手段可用于增强 ICI 疗效？\"\n      },\n      {\n        \"chapter_id\": \"Ch6_Challenges\",\n        \"title\": \"方法学挑战与未来研究方向\",\n        \"purpose\": \"指出当前证据局限（如缺乏 III 期 RCT、代谢物定量不足），提出标准化与精准医疗建议。\",\n        \"question\": \"实现微生物组导向的精准免疫治疗面临哪些障碍？\"\n      },\n      {\n        \"chapter_id\": \"Ch7_Conclusion\",\n        \"title\": \"结论\",\n        \"purpose\": \"总结核心发现，强调因果验证与临床转化的必要性。\",\n        \"question\": \"肠道微生物组在 ICI 治疗中的最终临床定位是什么？\"\n      }\n    ]\n  },\n  \"cross_chapter_rules\": [\n    \"在 Ch2 中报告关联时，必须区分观察性研究与干预性研究，避免将相关性解读为因果性。\",\n    \"在 Ch3 中讨论机制时，需明确区分动物模型证据与人类临床证据，注明种属差异。\",\n    \"在 Ch4 中分析异质性时，需结合 Ch2 中的瘤种特异性数据，避免过度泛化单一菌属的作用。\",\n    \"在 Ch5 中评估干预措施时，需引用 Ch6 中提到的安全性与标准化挑战，平衡疗效与风险。\",\n    \"所有章节引用 P0577、P0578、P0583 等试验数据时，需明确其试验分期（I/II 期），不得暗示为确证性 III 期结果。\"\n  ],\n  \"grouped_screening_notes\": [\n    {\n      \"category\": \"纳入\",\n      \"reason\": \"直接研究实体瘤 ICI 治疗中肠道微生物组与疗效/机制的关联。\",\n      \"examples\": [\n        \"P0014\",\n        \"P0092\",\n        \"P0582\",\n        \"P0585\"\n      ]\n    },\n    {\n      \"category\": \"纳入（背景/对比）\",\n      \"reason\": \"提供微生物组一般机制、非 ICI 免疫疗法对比或方法学背景。\",\n      \"examples\": [\n        \"P0001\",\n        \"P0346\",\n        \"P0501\"\n      ]\n    },\n    {\n      \"category\": \"排除\",\n      \"reason\": \"仅关注血液肿瘤、非免疫治疗、纯毒性无疗效数据或纯方法学无生物学洞察。\",\n      \"examples\": [\n        \"P0272\",\n        \"P0404\",\n        \"P0531\"\n      ]\n    },\n    {\n      \"category\": \"谨慎使用\",\n      \"reason\": \"动物模型为主、样本量极小或结果存在显著冲突，需注明局限性。\",\n      \"examples\": [\n        \"P0578\",\n        \"P0580\",\n        \"P0581\"\n      ]\n    }\n  ],\n  \"supplement_requests\": [\n    {\n      \"gap_id\": \"large_scale_rct_results\",\n      \"gap_question\": \"是否存在已完成的、大规模随机对照 III 期试验证实微生物组干预在 ICI 治疗患者中的疗效？\",\n      \"success_criteria\": \"识别出已完成的 III 期 RCT 及其主要结局数据。\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"intended_use\": \"clinical_evidence\",\n      \"targeted_queries\": \"phase III randomized controlled trial fecal microbiota transplantation immune checkpoint inhibitor cancer\",\n      \"optional reuse_plan_facet_ids\": [\n        \"F1\"\n      ],\n      \"known_papers\": [\n        \"P0577\",\n        \"P0578\",\n        \"P0583\"\n      ],\n      \"reviewed_references\": [\n        \"P0584\"\n      ]\n    },\n    {\n      \"gap_id\": \"specific_metabolite_quantification\",\n      \"gap_question\": \"人体肿瘤微环境或血清中关键代谢物（如肌苷、短链脂肪酸）的具体生理浓度是多少，且是否与 ICI 响应直接相关？\",\n      \"success_criteria\": \"提供人类样本中特定代谢物的定量数据及其与临床结局的统计关联。\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"intended_use\": \"mechanism\",\n      \"targeted_queries\": \"inosine concentration human tumor microenvironment immune checkpoint inhibitor response\",\n      \"optional reuse_plan_facet_ids\": [\n        \"F2\"\n      ],\n      \"known_papers\": [\n        \"P0580\",\n        \"P0581\",\n        \"P0582\"\n      ],\n      \"reviewed_references\": []\n    }\n  ],\n  \"directed_reads\": [\n    {\n      \"paper_id\": \"P0582\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"questions\": \"肌苷是直接作用于肿瘤细胞还是免疫细胞？其具体分子靶点（如 UBA6）在人体肿瘤中的表达情况如何？\",\n      \"required_outputs\": \"机制路径图、靶点蛋白名称、人体数据关联性强度。\",\n      \"knowledge_gap\": \"肌苷调节 ICI 疗效的具体分子机制及人体验证数据。\",\n      \"reason\": \"该论文提供了肌苷通过抑制 UBA6 增强免疫原性的关键机制，是 Ch3 的核心素材。\"\n    },\n    {\n      \"paper_id\": \"P0585\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch4_Context\"\n      ],\n      \"questions\": \"在不同免疫检查点抑制剂组合方案（PD-1 单药 vs. PD-1+CTLA-4）下，微生物关联特征有何差异？\",\n      \"required_outputs\": \"不同方案下显著菌属对比表、风险比数据。\",\n      \"knowledge_gap\": \"治疗方案特异性对微生物组 - 疗效关联的修饰作用。\",\n      \"reason\": \"该研究基于 III 期试验（JCOG2007）的附属分析，提供高质量临床证据，适合 Ch2 和 Ch4。\"\n    }\n  ],\n  \"manuscript_parts_plan\": {\n    \"context\": \"本综述面向肿瘤学家、免疫学家及转化医学研究人员，旨在系统评估肠道微生物组调节实体瘤免疫检查点抑制剂疗效的临床证据与生物学机制。综述将区分观察性关联与因果证据，强调肿瘤类型特异性及干预策略的转化现状，为未来精准免疫治疗提供理论依据与研究方向。\",\n    \"abstract\": {\n      \"purpose\": \"提供关于微生物组在 ICI 疗效中作用、关键机制及临床转化状态的简明总结。\",\n      \"focus\": [\n        \"微生物组 -ICI 临床关联\",\n        \"代谢物介导机制\",\n        \"干预性试验结果\"\n      ],\n      \"boundary\": [\n        \"仅限实体瘤\",\n        \"仅限 ICI 疗法\",\n        \"包含人类及临床前证据\"\n      ],\n      \"placement\": {\n        \"mode\": \"standalone\",\n        \"anchor\": \"manuscript_start\"\n      },\n      \"finalize_from\": [\n        \"provisional_scope\",\n        \"material_theme_inventory\"\n      ]\n    },\n    \"introduction\": {\n      \"purpose\": \"建立 ICI 耐药性的临床问题背景，引入微生物组作为可调节因子的理论依据，明确综述范围与核心论点。\",\n      \"focus\": [\n        \"ICI 治疗局限性\",\n        \"微生物组调节 rationale\",\n        \"综述结构概览\"\n      ],\n      \"boundary\": [\n        \"排除血液系统恶性肿瘤\",\n        \"聚焦肠道微生物组\",\n        \"不预设单一因果机制\"\n      ],\n      \"placement\": {\n        \"mode\": \"standalone\",\n        \"anchor\": \"after_abstract\"\n      },\n      \"finalize_from\": [\n        \"central_question\",\n        \"provisional_outline\"\n      ]\n    },\n    \"conclusion\": {\n      \"purpose\": \"综合证据强度，指出关键知识缺口（如 III 期 RCT、代谢物定量），提出标准化与未来研究优先事项。\",\n      \"focus\": [\n        \"证据总结\",\n        \"临床转化障碍\",\n        \"研究优先级建议\"\n      ],\n      \"boundary\": [\n        \"无新原始数据\",\n        \"基于综合材料\",\n        \"不夸大未证实疗法\"\n      ],\n      \"placement\": {\n        \"mode\": \"standalone\",\n        \"anchor\": \"manuscript_end\"\n      },\n      \"finalize_from\": [\n        \"provisional_outline\",\n        \"supplement_requests\"\n      ]\n    }\n  }\n}",
        "reasoning_content": "Thinking Process:\n\n1.  **Analyze the Request:**\n    *   **Task:** Provisional Scope Planning for a systematic review.\n    *   **Topic:** How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors (ICIs) in solid tumours, and what mechanisms mediate that effect?\n    *   **Input:** A large candidate pool of 585 papers (P0001 to P0585), with detailed planning summaries, facet contributions, scope interpretation cautions, and broader review uses for each. Some papers have `supplement_material_status` indicating gaps (e.g., specific metabolite quantification, large-scale RCT results).\n    *   **Output Format:** JSON only. Must include `review_title`, `central_question`, `provisional_scope`, `material_theme_inventory`, `provisional_outline` (chapters with chapter_id/title/purpose/question), `cross_chapter_rules`, `grouped_screening_notes`, `supplement_requests`, `directed_reads`, and `manuscript_parts_plan`.\n    *   **Constraints:**\n        *   Do not write a Q&A list.\n        *   Chapter organization depends on research question, disciplinary context, and available material.\n        *   Do not assume a single paradigm fits all topics.\n        *   Theory, concepts, methodology, and design research should be organized by their actual argumentative structure.\n        *   Central thesis must be supported by connections, differences, or evolution in the material.\n        *   Judge relevance based on research question and material itself.\n        *   Do not exaggerate uses of sources (check against actual research object, setting, methods, results, limitations).\n        *   Distinguish association vs. causal evidence, mechanisms vs. explanations, transfer vs. application, validation vs. uncertainty.\n        *   Do not upgrade unmet needs to field-level 缺失 (gap) judgments.\n        *   `manuscript_parts_plan` must follow the specific contract (context, abstract, introduction, conclusion; specific fields like purpose, focus, boundary, placement, finalize_from).\n        *   `placement.mode` should prefer `standalone` if no explicit article location is confirmed (software execution boundary).\n        *   Retain source metadata (source_handle, paper_id).\n        *   Screen all items semantically.\n        *   Plan for ~150+ papers if material is sufficient (quality goal, not counting threshold).\n        *   Do not force use of irrelevant papers.\n        *   Grouped non-use reasons are fine.\n        *   `supplement_requests` must have `gap_id`, `gap_question`, `success_criteria`, `chapter_ids`, `intended_use`, `targeted_queries`, `optional reuse_plan_facet_ids`, `known_papers`, `reviewed_references`.\n        *   `directed_reads` must have `paper_id`, `chapter_ids`, `questions`, `required_outputs`, `knowledge_gap`, `reason`.\n\n2.  **Synthesize Material & Identify Themes:**\n    *   **Core Question:** Gut microbiome -> ICI efficacy in solid tumors -> Mechanisms.\n    *   **Key Findings from Pool:**\n        *   **Association:** Specific taxa (e.g., *Akkermansia*, *Bifidobacterium*, *Faecalibacterium*, *Ruminococcaceae*) often correlate with better response (P0014, P0033, P0092, P0146, P0298, P0543). Antibiotics generally negatively impact efficacy (P0007, P0236, P0402, P0576).\n        *   **Mechanisms:** Metabolites (SCFAs, inosine, bile acids, tryptophan derivatives) are key mediators (P0092, P0196, P0447, P0503, P0559, P0582). Immune modulation (DC maturation, CD8+ T cell priming, Treg/Th17 balance) is the downstream effect (P0009, P0114, P0251, P0464). Antigen mimicry is a proposed mechanism (P0190, P0561).\n        *   **Interventions:** FMT shows promise but results are heterogeneous (positive in melanoma P0577, negative/limited in mixed solid tumors P0578). Probiotics/Prebiotics/Diet show potential but lack standardization (P0343, P0544, P0573).\n        *   **Context/Heterogeneity:** Effects are tumor-type specific (Melanoma vs. NSCLC vs. RCC vs. CRC) (P0098, P0298, P0585). Timing of antibiotic exposure matters (P0575). Host factors (diet, genetics, age) modulate the effect (P0346, P0484).\n        *   **Gaps:** Lack of large-scale Phase III RCTs confirming efficacy (P0577, P0578, P0583, P0584). Lack of direct quantification of specific metabolites (inosine, SCFAs) in human TME correlating with response (P0580, P0581, P0582). Mechanistic causality in humans vs. mice (P0002, P0092).\n    *   **Themes for Inventory:**\n        1.  Clinical Associations (Taxa, Diversity, Antibiotics).\n        2.  Mechanistic Pathways (Metabolites, Immune Cells, Signaling).\n        3.  Interventional Strategies (FMT, Probiotics, Diet).\n        4.  Contextual Modulators (Tumor Type, Timing, Host Factors).\n        5.  Methodological Challenges & Future Directions.\n\n3.  **Draft Provisional Scope & Thesis:**\n    *   **Scope:** Solid tumors treated with ICIs (PD-1/PD-L1, CTLA-4). Focus on gut microbiome (composition, function, metabolites). Include clinical evidence (observational, interventional) and mechanistic evidence (preclinical, translational).\n    *   **Thesis:** The gut microbiome modulates ICI efficacy in solid tumors primarily through metabolite-mediated immune reprogramming (e.g., SCFAs, inosine) and antigen-specific T cell priming, but clinical translation is hindered by tumor-type heterogeneity, lack of standardized interventions, and insufficient causal evidence in humans.\n    *   **Outline:**\n        1.  Introduction (Background, Rationale).\n        2.  Clinical Evidence of Microbiome-ICI Association (Taxa, Antibiotics).\n        3.  Mechanistic Pathways (Metabolites, Immune Modulation, Antigen Mimicry).\n        4.  Contextual Determinants (Tumor Type, Timing, Host Factors).\n        5.  Interventional Strategies (FMT, Probiotics, Diet).\n        6.  Methodological Challenges & Future Directions.\n        7.  Conclusion.\n\n4.  **Screening Notes:**\n    *   **Exclude:** Papers focusing solely on hematological malignancies (unless comparative context), non-ICI therapies (unless mechanistic overlap), purely methodological papers without biological insight, papers with no data on efficacy/mechanism (e.g., purely safety/toxicity without efficacy link, though some toxicity papers are relevant for the 'balance' argument).\n    *   **Include:** Solid tumor ICI studies, mechanistic studies linking microbiome to immunity/ICI, intervention trials (FMT, etc.).\n    *   **Caution:** Distinguish association vs. causation. Note tumor specificity.\n\n5.  **Supplement Requests & Directed Reads:**\n    *   **Gap 1 (Phase III RCTs):** Need confirmation of completed large-scale Phase III RCTs. Current material shows Phase I/II (P0577, P0578, P0583).\n    *   **Gap 2 (Metabolite Quantification):** Need direct quantification of specific metabolites (inosine, SCFAs) in human TME/serum correlating with response. Current material often relies on proxies or mouse models (P0580, P0581, P0582).\n    *   **Directed Reads:** Specific papers needing deeper dive into mechanism details or specific tumor subtypes (e.g., P0582 for inosine mechanism, P0585 for NSCLC specific data).\n\n6.  **Manuscript Parts Plan:**\n    *   Follow the contract strictly. `placement.mode` = `standalone`.\n    *   `context`: Describe the review's purpose and audience.\n    *   `abstract`: Summarize key findings and implications.\n    *   `introduction`: Set the stage, define scope, state thesis.\n    *   `conclusion`: Synthesize evidence, highlight gaps, suggest future directions.\n    *   Ensure `focus` and `boundary` are specific to the material (e.g., \"solid tumors\", \"ICI efficacy\", \"metabolite mechanisms\").\n\n7.  **Refine JSON Structure:**\n    *   Ensure all required keys are present.\n    *   Check `supplement_requests` structure (gap_id, etc.).\n    *   Check `directed_reads` structure.\n    *   Check `manuscript_parts_plan` structure (context string, parts with purpose/focus/boundary/placement/finalize_from).\n    *   Ensure `provisional_outline` chapters have `chapter_id`, `title`, `purpose`, `question`.\n    *   Ensure `material_theme_inventory` reflects the synthesized themes.\n    *   Ensure `grouped_screening_notes` categorizes excluded/included logic.\n\n8.  **Final Review against Constraints:**\n    *   No Q&A list.\n    *   Chinese for planning content (titles, purposes, etc.), keep original paper titles/IDs.\n    *   Do not exaggerate source capabilities.\n    *   Check `placement.mode` preference for `standalone`.\n    *   Ensure `manuscript_parts_plan` is complete and valid.\n\n*(Self-Correction during drafting)*: I need to make sure I don't claim Phase III trials exist if the material says they don't (P0577, P0578, P0583, P0584 all indicate Phase I/II or lack of Phase III). The supplement request should target this gap. I need to ensure the `manuscript_parts_plan` fields are arrays of strings where required, and strings where required. `focus`, `boundary`, `finalize_from` must be string arrays. `purpose` is a string. `placement` is an object.\n\n*(Refining Manuscript Parts Plan)*:\n*   `context`: \"This review targets oncologists and immunologists seeking to understand the translational potential of microbiome modulation in solid tumor immunotherapy. It synthesizes clinical associations, mechanistic pathways, and interventional trial data.\"\n*   `abstract`: `purpose`: \"Provide a concise summary of the microbiome's role in ICI efficacy, key mechanisms, and clinical status.\" `focus`: [\n  \"Microbiome-ICI association\",\n  \"Metabolite mechanisms\",\n  \"Interventional trial outcomes\"\n]. `boundary`: [\n  \"Solid tumors only\",\n  \"ICI therapies\",\n  \"Human and preclinical evidence\"\n]. `placement`: `standalone`. `finalize_from`: [\n  \"provisional_scope\",\n  \"material_theme_inventory\"\n].\n*   `introduction`: `purpose`: \"Establish the clinical problem of ICI resistance and introduce the microbiome as a modifiable factor.\" `focus`: [\n  \"ICI limitations\",\n