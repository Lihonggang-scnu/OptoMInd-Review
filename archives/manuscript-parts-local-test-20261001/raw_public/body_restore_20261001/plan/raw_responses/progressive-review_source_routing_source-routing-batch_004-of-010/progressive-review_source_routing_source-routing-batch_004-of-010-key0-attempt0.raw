{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0181\",\n      \"paper_title\": \"A specific enterotype derived from gut microbiome of older individuals enables favorable responses to immune checkpoint blockade therapy.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究识别出老年患者特有的“衰老富集肠型”，并通过小鼠 FMT 实验验证其能重塑肿瘤微环境（增加细胞毒性 T 细胞标记）从而增强 ICB 疗效。此材料可用于 Ch4 讨论宿主因素（年龄）如何作为关键情境变量修饰微生物组 - 免疫互作，挑战“免疫衰老必然导致疗效降低”的传统观点，并强调微生物特征在不同年龄层中的特异性。\"\n    },\n    {\n      \"source_handle\": \"P0182\",\n      \"paper_title\": \"The Gut Microbiome Associates with Immune Checkpoint Inhibition Outcomes in Patients with Advanced Non–Small Cell Lung Cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该日本 NSCLC 队列研究提供了 Ruminococcaceae UCG 13 和 Agathobacter 富集与更好临床结局（ORR, PFS, OS）相关的观察性证据，并指出基线抗生素使用会削弱这种关联。材料可用于 Ch2 列举特定菌属作为疗效预测因子的实例，同时在 Ch4 中作为抗生素干扰微生物组结构进而影响疗效的典型情境案例，强调人群特异性和混杂控制的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0183\",\n      \"paper_title\": \"Microbial Influence on Immune Checkpoint Inhibitor Therapy in Non-Small Cell Carcinoma: The Gut–Lung-Immune Axis\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述详细阐述了“肠 - 肺 - 免疫轴”机制，包括肠道代谢物（SCFAs）系统性调节、抗原激活树突状细胞招募 T 细胞至肺部、分子模拟及肿瘤内微生物直接调节局部免疫。材料可用于 Ch3 构建多层次机制框架，区分全身性与局部微环境作用；同时在 Ch6 中作为方法学挑战的案例，指出跨解剖部位（肠 vs 肺 vs 瘤内）微生物检测的标准化难题及低生物量测序的技术局限。\"\n    },\n    {\n      \"source_handle\": \"P0184\",\n      \"paper_title\": \"The science of tumor-infiltrating lymphocytes (TIL): perspectives from the SITC Surgery Committee\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"虽然主要聚焦 TIL 疗法，但该综述提及有利的肠道微生物组组成与增强的全身性及抗肿瘤免疫力相关，可能通过调节肿瘤免疫微环境发挥作用。材料可用于 Ch2 背景部分，简要说明微生物组在广义癌症免疫治疗（包括细胞疗法）中的潜在调节角色，作为支持微生物组重要性的旁证，但需明确其非 ICI 特异性机制细节的局限性。\"\n    },\n    {\n      \"source_handle\": \"P0185\",\n      \"paper_title\": \"Impact of Concomitant Proton Pump Inhibitor Use on the Efficacy of Immune Checkpoint Inhibitors Across Multiple Cancer Types.\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该大规模观察性研究显示 PPIs 伴随使用与多种实体瘤患者 ICI 治疗后死亡率增加及 ICU 入院率升高显著相关。材料可用于 Ch4 讨论药物 - 微生物相互作用的情境因素，作为临床观察到的负面效应实例，提示 PPIs 可能通过改变胃酸环境进而影响肠道微生物组完整性，最终削弱 ICI 疗效，强调共用药管理在解释疗效异质性中的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0186\",\n      \"paper_title\": \"Abstract 2861: Comparative genomics of gut commensal Lachnospiraceae and their associations with cancer treatment response with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究通过比较基因组学发现毛螺菌科内不同菌株（Blautia obeum/massiliensis vs Agathobacter rectalis）对 ICI 疗效影响的差异性，并预测了乙酸生产、叶酸合成、L-鼠李糖及胆汁酸转化等四种潜在分子机制。材料可用于 Ch3 深入解析菌株特异性效应，说明同一科属内功能异质性，并提出具体的代谢通路假设（如 T 细胞能量供应、MAMP 激活），尽管需注明这些机制尚属基因组预测而非体内验证。\"\n    },\n    {\n      \"source_handle\": \"P0187\",\n      \"paper_title\": \"Prognostic Factors for Checkpoint Inhibitor Based Immunotherapy: An Update With New Evidences\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了不同癌症类型中与 CTLA-4 或 PD-1/PD-L1 阻断响应相关的具体菌属（如 Bacteroides, Bifidobacterium, A. muciniphila），并指出抗生素使用导致原发耐药。材料可用于 Ch2 对比不同 ICI 类别的微生物标志物差异，同时在 Ch3 中提供机制假说（如 DC 功能增强、T 细胞 priming），并强调不同研究间因种族、饮食或癌种导致的发现不一致性，作为背景复杂性素材。\"\n    },\n    {\n      \"source_handle\": \"P0188\",\n      \"paper_title\": \"Intestinal fungal signatures and their impact on immune checkpoint inhibitor efficacy: a multi-cohort meta-analysis\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该荟萃分析揭示了肠道真菌（而非仅细菌）与 ICI 疗效的关联，发现黑色素瘤中 Aspergillus avenaceus 正向关联而 Debaryomyces hansenii 负向关联，并通过小鼠实验证实后者通过减少 CD8+ T 细胞浸润抑制疗效。材料可用于 Ch2 拓展生物标志物视野至真菌界，展示癌症类型依赖性；在 Ch3 中提供真菌调节 TME 的具体机制证据（如趋化因子下调），并讨论细菌 - 真菌互作网络的复杂性。\"\n    },\n    {\n      \"source_handle\": \"P0189\",\n      \"paper_title\": \"Reprogramming the tumor microenvironment: synergistic mechanisms of antibody–drug conjugates and immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"虽未直接研究菌群，但该综述详述了 ADCs 诱导免疫原性细胞死亡（ICD）释放 DAMPs 从而“加热”冷肿瘤微环境的机制，为理解 ICI 起效所需的微环境前提提供背景。材料可用于 Ch3 对比不同联合策略（如 ADC+ICI vs 微生物调节）在重塑 TME 方面的异同，说明为何某些患者需先通过外部干预（化疗/放疗/微生物）创造适宜免疫微环境才能从 ICI 获益。\"\n    },\n    {\n      \"source_handle\": \"P0190\",\n      \"paper_title\": \"Outer Membrane Vesicles From The Gut Microbiome Contribute to Tumor Immunity by Eliciting Cross-Reactive T Cells\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究证明了肠道细菌外膜囊泡（OMVs）可通过分子模拟机制诱导交叉反应性 T 细胞，使其从肠道迁移至肿瘤部位并抑制生长，且无需活菌定植。材料可用于 Ch3 详细阐述“抗原特异性 T 细胞诱导”这一具体生物学路径，区分于代谢物介导或佐剂效应，并强调微生物衍生物（OMVs）作为稳定免疫调节载体的潜力，为解释临床高多样性菌群与疗效关联提供分子层面的因果链条假设。\"\n    },\n    {\n      \"source_handle\": \"P0191\",\n      \"paper_title\": \"The Role of Immune Checkpoint Inhibitors in Renal Cancer: Innovation, Resistance Mechanisms, and Next-generation Strategies\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述总结了肾细胞癌中 Akkermansia muciniphila 等有益菌与 ICI 疗效的正相关性，并提及短链脂肪酸、色氨酸代谢物等潜在调节机制及 FMT/益生菌干预策略。材料可用于 Ch2 提供 RCC 特定癌种的临床关联证据，同时在 Ch3 中概括代谢物介导的免疫调节路径，作为连接临床观察与机制探索的桥梁，但需注明其多为综述性总结而非原始机制验证。\"\n    },\n    {\n      \"source_handle\": \"P0192\",\n      \"paper_title\": \"Gut microbiota influence immunotherapy responses: mechanisms and therapeutic strategies\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述系统阐述了微生物调节 ICI 疗效的分子机制（如肌苷/A2AR 通路、SCFAs/HDAC 抑制、抗原交叉反应）及临床干预策略（FMT、益生菌、工程菌）。材料可用于 Ch3 构建详细的信号通路图景，区分不同代谢物的作用靶点；在 Ch5 中评估各类干预手段的原理、优缺点及临床试验状态，特别是关于疗效与毒性耦合（efficacy-toxicity coupling）的讨论，为转化医学提供全面背景。\"\n    },\n    {\n      \"source_handle\": \"P0193\",\n      \"paper_title\": \"Veillonella and Streptococcus are associated with aging of the gut microbiota and affect the efficacy of immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该小样本研究发现 Veillonella 和 Streptococcus 在老年实体瘤患者中与 ICI 疗效呈差异化关联，并提出 Streptococcus 可能通过诱导 CD8+ T 细胞浸润增强疗效的假说。材料可用于 Ch4 讨论老龄化背景下微生物组特征的特殊性及其对疗效的修饰作用，提示年龄是重要的分层变量，同时指出小样本观察性研究的局限性，避免过度解读特定菌属的因果效应。\"\n    },\n    {\n      \"source_handle\": \"P0194\",\n      \"paper_title\": \"Microbiome-Driven Diagnostic and Therapeutic Strategies in Cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述列举了 Akkermansia, Faecalibacterium 等与 ICI 疗效正相关的具体菌种，并从免疫调节（T 细胞浸润）、代谢产物（SCFA）及屏障功能角度解释机制。材料可用于 Ch2 提供跨癌种的临床关联证据汇总，支持特定有益菌群促进疗效的观点；在 Ch3 中整合多重机制路径，说明微生物如何通过多层面（免疫、代谢、物理屏障）协同调节抗肿瘤免疫反应。\"\n    },\n    {\n      \"source_handle\": \"P0195\",\n      \"paper_title\": \"The microbial metabolite desaminotyrosine enhances T-cell priming and cancer immunotherapy with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该研究揭示了微生物代谢物 DAT 通过宿主 IFN-I 信号通路增强 DC 成熟和 T 细胞活化，并在抗生素诱导菌群失调的小鼠模型中部分恢复 ICI 疗效。材料可用于 Ch3 详细解析“代谢物 - 宿主受体 - 免疫细胞”的具体分子路径，特别是 IFN-I 的关键作用；在 Ch5 中作为单一代谢物补充策略的实证案例，讨论其在菌群受损情境下的补救潜力及不加重 irAEs 的安全性特征。\"\n    },\n    {\n      \"source_handle\": \"P0196\",\n      \"paper_title\": \"Emerging Roles of Immunometabolism and Microbiota Crosstalk in Cancer Therapy: A Comprehensive Review\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述引入免疫代谢视角，解释了 TME 内代谢竞争（如乳酸、葡萄糖缺乏）如何削弱免疫细胞对微生物信号的响应，并详述 SCFAs、色氨酸代谢物等通过表观遗传和受体信号调节免疫的机制。材料可用于 Ch3 构建“微生物 - 代谢 - 免疫”互作的复杂框架，说明为何有益菌群在某些代谢抑制环境下失效；在 Ch6 中指出当前机制研究多基于临床前模型，缺乏人体内定量数据及通路冗余带来的转化挑战。\"\n    },\n    {\n      \"source_handle\": \"P0197\",\n      \"paper_title\": \"Abstract 2210: Microbiome profiling reveals that fecal microbiota transplantation (FMT) modulates response and toxicity when combined with immunotherapy in patients with lung cancer and melanoma (FMT-LUMINate NCT04951583)\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该早期临床试验显示 FMT 联合 ICI 在 NSCLC 和黑色素瘤中取得高 ORR，但双药联合组出现严重 irAEs（如心肌炎），且 P. copri 定植与毒性相关。材料可用于 Ch5 评估 FMT 的临床获益/风险平衡，强调 ICI 方案（单药 vs 双药）对毒性谱的修饰作用；在 Ch4 中作为情境因素案例，说明供体特异性菌群和宿主免疫状态共同决定干预结局，提示精准供体筛选的必要性。\"\n    },\n    {\n      \"source_handle\": \"P0198\",\n      \"paper_title\": \"73 Fasting mediated gut microbiome modulation improves response to immune checkpoint therapy in Renal Cell Cancer\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究发现限时进食通过重塑肠道微生物组（改变色氨酸代谢物）增强肾癌小鼠对 ICI 的响应，并通过 FMT 验证了微生物介导的因果性。材料可用于 Ch5 展示非药物饮食干预策略的潜力，连接临床观察与动物实验因果链；在 Ch3 中作为代谢重编程机制的实例，说明外部生活方式干预如何通过微生物代谢环境改变克服免疫耐药，尽管具体代谢通路细节尚待解析。\"\n    },\n    {\n      \"source_handle\": \"P0199\",\n      \"paper_title\": \"Baseline gut microbiota composition is associated with oral mucositis and tumour recurrence in patients with head and neck cancer: a pilot study\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该小样本试点研究发现基线 Faecalibacterium 等菌属与头颈癌放化疗后低复发风险相关，并提示其免疫调节功能。材料可用于 Ch2 作为微生物组影响实体瘤治疗预后（虽非 ICI 但为放化疗）的旁证，支持特定有益菌改善治疗结局的生物学合理性，同时强调小样本观察性研究的局限性及不同治疗模态（放疗 vs ICI）下微生物标志物的潜在差异。\"\n    },\n    {\n      \"source_handle\": \"P0200\",\n      \"paper_title\": \"Integrative stratification of response to immunotherapy using host and microbial signatures in patients with advanced non-small cell lung cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该研究开发了基于 Faecalibacterium 等菌属比率的微生物评分，发现响应者治疗后菌群向健康状态回归，且该评分与 TMB 互补提高分层准确性。材料可用于 Ch2 展示动态纵向微生物特征作为疗效预测因子的价值，区别于静态基线分析；在 Ch6 中作为多模态生物标志物整合的成功案例，同时指出评分系统依赖特定标记物选择及缺乏外部验证的方法学挑战。\"\n    },\n    {\n      \"source_handle\": \"P0201\",\n      \"paper_title\": \"A Natural Polyphenol Exerts Antitumor Activity and Circumvents Anti–PD-1 Resistance through Effects on the Gut Microbiota\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究证实天然多酚 castalagin 通过特异性富集 Ruminococcus 菌属，改变胆汁酸代谢并增加 CD8+ T 细胞浸润，从而逆转小鼠抗 PD-1 耐药。材料可用于 Ch5 提供益生元干预克服原发耐药的实证案例，展示“饮食 - 菌群 - 代谢 - 免疫”完整链条；在 Ch3 中解析微生物 - 宿主代谢互作（胆汁酸）及 TME 重塑的具体机制，强调特定化合物与菌株的特异性结合关系。\"\n    },\n    {\n      \"source_handle\": \"P0202\",\n      \"paper_title\": \"Novel Biomarkers and Druggable Targets in Advanced Melanoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述指出高 Alpha 多样性及特定菌属丰度与黑色素瘤抗 PD-1 响应相关，抗生素使用削弱疗效，并提出微生物通过增加 CD8+ T 细胞浸润增强免疫的机制假说。材料可用于 Ch2 列举黑色素瘤领域的经典微生物标志物及抗生素负面影响；在 Ch3 中提供“微生物-T 细胞浸润”这一关键机制假说，同时注明其多为观察性关联，具体分子通路尚待阐明。\"\n    },\n    {\n      \"source_handle\": \"P0203\",\n      \"paper_title\": \"The impact of the human gut microbiome in the treatment of autoimmune disease\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"虽聚焦自身免疫病，但该综述引用了肿瘤学领域 FMT 及 A. muciniphila 增强 ICI 疗效的动物模型证据，并探讨了微生物效应因子及 T 细胞浸润等潜在机制。材料可用于 Ch3 作为跨疾病免疫调节机制的类比参考，说明微生物组通过调节宿主免疫细胞浸润影响治疗反应的通用原理，但需明确区分肿瘤与自身免疫病病理环境的差异，避免直接外推机制细节。\"\n    },\n    {\n      \"source_handle\": \"P0204\",\n      \"paper_title\": \"Characterizations of multi-kingdom gut microbiota in immune checkpoint inhibitor-treated hepatocellular carcinoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该 HCC 研究发现细菌和代谢物多样性及组成与 ICI 疗效显著相关，而真菌差异较小，并构建了基于 18 种细菌的预测模型。材料可用于 Ch2 提供肝癌特定癌种的多界微生物组关联证据，强调细菌和代谢物的主导作用；在 Ch6 中作为多组学整合分析的方法学案例，展示如何从复杂生态系统中提取预测信号，同时指出模型缺乏外部验证及真菌作用相对次要的发现。\"\n    },\n    {\n      \"source_handle\": \"P0205\",\n      \"paper_title\": \"Correlation of distribution characteristics and dynamic changes of gut microbiota with the efficacy of immunotherapy in EGFR-mutated non-small cell lung cancer\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该研究发现 EGFR 突变 NSCLC 患者中抗生素使用显著恶化 PFS，而益生菌无效，且响应者具有独特的微生物标志物（如 Bradyrhizobium）和代谢物谱，不同于 EGFR 野生型。材料可用于 Ch4 讨论肿瘤驱动基因突变作为关键情境因素，修饰微生物组与 ICI 疗效的关联，提示“通用”生物标志物可能不适用；在 Ch2 中提供特定分子亚群的临床关联数据，强调亚组分析的重要性。\"\n    },\n    {\n      \"source_handle\": \"P0206\",\n      \"paper_title\": \"Microbiome and Cancers, With Focus on Genitourinary Tumors\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述总结了泌尿生殖系统肿瘤中抗生素使用预测 ICI 耐药的临床证据，并详述了 A. muciniphila 产生 SCFAs 通过 GPR41/43 和 HDAC 抑制增强 T 细胞功能的机制模型。材料可用于 Ch2 提供 RCC 和尿路上皮癌的临床关联数据；在 Ch3 中解析 SCFAs 介导的具体分子通路（组蛋白乙酰化、趋化因子表达），作为连接细菌存在与 T 细胞功能的桥梁，尽管需注明其为基于文献的综合模型。\"\n    },\n    {\n      \"source_handle\": \"P0207\",\n      \"paper_title\": \"IUPHAR Review: Targeted Therapies of Signaling Pathways Based on the Gut Microbiome in Autism Spectrum Disorders: Mechanistic and Therapeutic Applications.\",\n      \"chapter_ids\": [],\n      \"specific_usable_material\": \"该论文主要关注自闭症谱系障碍（ASD）的神经发育机制，虽涉及微生物代谢物（SCFAs）和免疫信号，但其病理生理背景（神经炎症 vs 肿瘤免疫微环境）与实体瘤 ICI 疗效存在本质差异。SCFAs 在 ASD 和肿瘤中的作用可能截然相反，直接外推风险极高，故不纳入本综述。\"\n    },\n    {\n      \"source_handle\": \"P0208\",\n      \"paper_title\": \"Gut Microbiome Alterations in Colorectal Cancer: Mechanisms, Therapeutic Strategies, and Precision Oncology Perspectives\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述详细描述了结直肠癌中有益菌（Akkermansia, Faecalibacterium）与 ICI 疗效正相关，致病菌与耐药相关，并区分了 MSI/MSS 亚型下的微生物特征差异。材料可用于 Ch2 提供 CRC 特定癌种的临床关联及亚型特异性证据；在 Ch3 中阐述免疫细胞调节、SCFAs 作用及屏障完整性等多重机制，强调微生物效应在不同分子亚型（如 MSS 耐药）中的情境依赖性。\"\n    },\n    {\n      \"source_handle\": \"P0209\",\n      \"paper_title\": \"Abstract 4611: Microbiome-derived indole metabolites and response to immune checkpoint inhibitors in patients with hepatocellular carcinoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该摘要报告 HCC 患者血清吲哚丙酸（IPA）水平与 ICI 持久响应正相关，并关联 Pasteurellaceae 和 Lachnospiraceae 科细菌。材料可用于 Ch2 提供 HCC 中特定微生物代谢物作为预测标志物的临床观察证据；在 Ch3 中作为色氨酸 - 吲哚通路介导免疫调节（如激活 CD8+ T 细胞）的具体案例，尽管需注明其机制主要基于计算预测和小样本验证，因果链条尚待完全证实。\"\n    },\n    {\n      \"source_handle\": \"P0210\",\n      \"paper_title\": \"Early Prediction of Anti-PD-1 Therapy Response in Hepatocellular Carcinoma Using Gut Microbiota Biomarkers\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该研究利用神经网络从低丰度微生物特征中提取预测信号，构建了 HCC 患者抗 PD-1 疗效预测模型（AUROC 0.784）。材料可用于 Ch2 展示微生物组作为非侵入性生物标志物的预测潜力，特别是利用稀有菌种信息的策略；在 Ch6 中作为数据分析方法学案例，强调模型选择对结论的影响及缺乏独立外部验证的局限性，提示需谨慎评估泛化能力。\"\n    },\n    {\n      \"source_handle\": \"P0211\",\n      \"paper_title\": \"Helicobacter pylori serology is associated with worse overall survival in patients with melanoma treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现 H. pylori 血清阳性与黑色素瘤及 NSCLC 患者 ICI 治疗后 OS 缩短相关，且该效应独立于粪便微生物组多样性改变。材料可用于 Ch4 讨论非肠道共生菌因素（如上消化道病原体）作为全身免疫调节因子的作用，提示慢性感染可能通过改变 DC 功能或巨噬细胞极化间接影响 ICI 疗效，扩展了“微生物组”研究的解剖边界和机制视角。\"\n    },\n    {\n      \"source_handle\": \"P0212\",\n      \"paper_title\": \"Microbiota boost immunotherapy? A meta-analysis dives into fecal microbiota transplantation and immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该荟萃分析证实 FMT 联合 ICI 在实体瘤中提升 ORR（43%），尤其在双药联合背景下（60%），但指出高异质性和缺乏标准化协议。材料可用于 Ch5 提供 FMT 临床有效性的汇总证据，评估不同给药途径和供体来源的趋势；在 Ch6 中强调当前临床转化的主要瓶颈（异质性、机制不明、缺乏大规模 RCT），作为未来研究方向的关键依据。\"\n    },\n    {\n      \"source_handle\": \"P0213\",\n      \"paper_title\": \"Antibiotic-Related Changes in Microbiome: The Hidden Villain behind Colorectal Carcinoma Immunotherapy Failure\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述总结了抗生素使用导致实体瘤 ICI 疗效降低的临床证据，并详述了其机制：破坏有益菌（如 Akkermansia）导致 DC 功能受损、CD8+ T 细胞招募减少及 Treg 扩张。材料可用于 Ch4 作为抗生素干扰微生物组进而影响疗效的核心情境因素证据；在 Ch3 中提供细胞和分子层面的机制解释（IL-12 分泌、趋化受体表达），连接菌群失调与免疫抑制状态。\"\n    },\n    {\n      \"source_handle\": \"P0214\",\n      \"paper_title\": \"The role of the gut microbiome in immune modulation: implications for autoimmune diseases and cancer therapy\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述列举了 Akkermansia, Faecalibacterium 等与 ICI 疗效正相关的菌种，并详述其通过增强 DC 活性、促进 T 细胞浸润及 SCFAs 表观遗传修饰发挥作用的机制。材料可用于 Ch2 提供跨癌种的临床观察证据汇总；在 Ch3 中整合免疫细胞活化和表观遗传调控机制，同时指出 Bifidobacterium 在人体试验中效果不一致的情境依赖性，提醒避免过度泛化单一菌种作用。\"\n    },\n    {\n      \"source_handle\": \"P0215\",\n      \"paper_title\": \"Microbiome Modulation for the Treatment of Solid Neoplasms\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该综述总结了 Ruminococcaceae, Akkermansia 等与 ICI 疗效相关的临床证据，并讨论了饮食纤维、FMT 等干预策略的早期试验结果及方法学挑战（如小样本、缺乏标准化）。材料可用于 Ch5 概述当前微生物调节治疗的临床现状和具体干预手段；在 Ch6 中强调从临床前发现到临床验证的差距，指出大型 RCT 缺乏及单一生物标志物效用冲突等关键局限。\"\n    },\n    {\n      \"source_handle\": \"P0216\",\n      \"paper_title\": \"Perspective on the Role of Gut Microbiome in the Treatment of Hepatocellular Carcinoma with Immune Checkpoint Inhibitors\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述提供了 HCC 中预测 ICI 响应的具体微生物指纹（如 Akkermansia 富集，Prevotella 减少），并阐述了肠 - 肝轴、次级胆汁酸及 T 细胞调节等机制。材料可用于 Ch2 提供肝癌特定癌种的微生物标志物证据；在 Ch3 中解析肝脏特异性机制（如 LPS 易位致慢性炎症、胆汁酸/mTOR 通路），强调解剖部位特异性对微生物 - 免疫互作的影响。\"\n    },\n    {\n      \"source_handle\": \"P0217\",\n      \"paper_title\": \"Myokine-mediated mechanisms of immune checkpoint inhibitors-associated colorectal injury and repair in rectal cancer\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述描述了肠道菌群失调导致 LPS 易位激活 TLR4/NF-κB 通路加剧 ICI 结肠炎的机制，并引入肌动蛋白介导的“肌肉 - 肠道”轴。材料可用于 Ch3 补充微生物失调放大 ICI 毒性的炎症级联机制；在 Ch4 中讨论宿主全身状态（如肌肉健康）作为情境因素，通过内分泌信号调节肠道免疫微环境，进而影响 ICI 治疗窗口和毒性谱，拓展宿主 - 微生物互作维度。\"\n    },\n    {\n      \"source_handle\": \"P0218\",\n      \"paper_title\": \"Commensal Bifidobacterium Strains Enhance the Efficacy of Neo-Epitope Based Cancer Vaccines\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该小鼠研究发现双歧杆菌通过维持 Muribaculaceae 水平和潜在的“分子模拟”机制增强癌症疫苗疗效，增加特异性 T 细胞反应。材料可用于 Ch3 作为微生物调节非 ICI 类免疫疗法（疫苗）的机制案例，提供分子模拟和菌群稳态维持的假说线索，尽管需注明其基于小鼠模型且双歧杆菌未定植，机制多为相关性分析和生物信息学预测。\"\n    },\n    {\n      \"source_handle\": \"P0219\",\n      \"paper_title\": \"Peripheral blood CD3+HLADR+ cells and associated gut microbiome species predict response and overall survival to immune checkpoint blockade\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究发现外周血活化 T 细胞（CD3+HLA-DR+）与特定肠道菌（Burkholderiales, B. vulgatus）丰度相关，且联合评分预测 OS 优于单一指标。材料可用于 Ch2 展示“免疫 - 微生物”联合生物标志物的构建策略及预测价值；在 Ch3 中提出微生物可能通过调节 T 细胞活化水平（抑制过度炎症或促进有效激活）介导疗效的假设，强调全身免疫状态与菌群的协同作用。\"\n    },\n    {\n      \"source_handle\": \"P0220\",\n      \"paper_title\": \"A Review of Gut Microbiota‐Derived Metabolites in Tumor Progression and Cancer Therapy\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述详细列举了 SCFAs、肌苷、MDP 等代谢物增强 ICI 疗效的分子机制（如 HDAC 抑制、A2AR 通路、NOD2 激活），并讨论了 TMAO 等代谢物的矛盾功能。材料可用于 Ch3 构建代谢物介导的多层次机制框架，区分不同代谢物的受体和信号通路；在 Ch5 中作为靶向代谢物干预策略的理论基础，同时强调代谢物作用的情境依赖性（促癌 vs 抑癌）。\"\n    },\n    {\n      \"source_handle\": \"P0221\",\n      \"paper_title\": \"Exploring the Frequency and Risk Factors of Hyperprogressive Disease in Patients with Advanced Melanoma Treated with Immune Checkpoint Inhibitors\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该研究发现低嗜酸性粒细胞计数与黑色素瘤患者 ICI 治疗后超进展（HPD）相关，提示宿主先天免疫状态影响疗效异常。材料可用于 Ch4 讨论宿主免疫基础状态作为情境因素，解释为何部分患者出现反常快速进展，虽未直接涉及微生物组，但为理解宿主免疫微环境对 ICI 响应的复杂调节提供了重要背景，暗示微生物组可能通过类似途径影响免疫稳态。\"\n    },\n    {\n      \"source_handle\": \"P0222\",\n      \"paper_title\": \"The intratumoral microbiota: a new horizon in cancer immunology\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\",\n        \"Ch2_Clinical\"\n      ],\n      \"specific_usable_material\": \"该综述阐述了瘤内微生物群通过 PRRs 激活、代谢物（SCFAs, I3A）表观遗传调控及诱导三级淋巴结构等机制调节抗肿瘤免疫，并指出其作为 ICB 疗效预测标志物的潜力。材料可用于 Ch3 补充局部微环境中微生物直接作用的机制，区别于肠道菌群的远端效应；在 Ch2 中提供瘤内微生物作为独立预测因子的临床证据，强调解剖部位（瘤内 vs 肠道）微生物作用的互补性。\"\n    },\n    {\n      \"source_handle\": \"P0223\",\n      \"paper_title\": \"Association of SCFA in gut microbiome and clinical response in solid cancer patients treated with andi-PD-1 antibody\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究发现实体瘤患者粪便 SCFA 水平与抗 PD-1 治疗响应率正相关，响应者 fSCFA 显著高于非响应者。材料可用于 Ch2 提供微生物代谢产物与临床结局直接关联的实证数据，支持 SCFA 作为预测标志物；在 Ch3 中作为代谢物介导效应的具体实例，提示 SCFA 可能是连接微生物群与宿主免疫反应的关键化学介质，尽管需注明其为观察性关联且样本量有限。\"\n    },\n    {\n      \"source_handle\": \"P0224\",\n      \"paper_title\": \"From Alpha Diversity to Zeitgebers: Functional Implications and Potential Mechanisms Linking the Gut Microbiome to Sleep and Circadian Disruption (Part II)\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该综述详述了睡眠/昼夜节律紊乱通过 HPA 轴、TLR4/LPS 信号及胆汁酸受体等途径导致肠道炎症和屏障受损的机制。材料可用于 Ch4 讨论生活方式因素（睡眠）作为情境变量，通过改变肠道环境（炎症、代谢物谱）间接影响全身免疫状态，从而可能修饰 ICI 疗效，提供非药物宿主因素调节微生物 - 免疫轴的理论框架。\"\n    },\n    {\n      \"source_handle\": \"P0225\",\n      \"paper_title\": \"Investigating Chronic Toxicity, Diet, Patient-Reported Outcomes and the Microbiome in Immunotherapy-Treated Metastatic Melanoma Survivors: A New Frontier\",\n      \"chapter_ids\": [\n        \"Ch4_Context\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该横断面研究发现黑色素瘤幸存者慢性毒性状态与特定微生物组结构（F/B 比值升高）及高糖饮食相关。材料可用于 Ch4 讨论 ICI 长期治疗后微生物组重塑现象及其与慢性副作用的关联，提示饮食行为作为可干预因素；在 Ch6 中强调横断面设计的局限性（无法推断因果）及幸存者偏倚，指出未来需纵向研究解析微生物组在长期毒性中的角色。\"\n    },\n    {\n      \"source_handle\": \"P0226\",\n      \"paper_title\": \"Combined immune checkpoint inhibitors and ablative radiotherapy in metastatic cancers: a meta-analysis of prospective clinical trials\",\n      \"chapter_ids\": [\n        \"Ch4_Context\"\n      ],\n      \"specific_usable_material\": \"该荟萃分析量化了 ICI 联合放疗的疗效（OS, PFS）和毒性，指出高剂量和双靶点与更好 OS 相关但毒性更高。材料可用于 Ch4 作为背景参照，设定标准联合治疗的临床预期基线，讨论治疗强度（放疗剂量、ICI 方案）对预后的修饰作用，为评估微生物组干预是否能提供“更温和但有效”的替代或辅助手段提供对比框架，尽管未直接涉及微生物机制。\"\n    },\n    {\n      \"source_handle\": \"P0227\",\n      \"paper_title\": \"Abstract 6469: Longitudinal loss of microbiome stability is associated with poor response to immune checkpoint inhibitors in lung cancer and melanoma\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch6_Challenges\"\n      ],\n      \"specific_usable_material\": \"该研究发现治疗早期微生物稳定性丧失与 NSCLC 和黑色素瘤患者 ICI 耐药相关，而非仅依赖静态菌属丰度。材料可用于 Ch2 引入“微生物稳定性”作为动态预测因子的新概念，解释部分基线菌群健康者仍耐药的现象；在 Ch6 中强调纵向监测的重要性及机器学习在提取动态信号中的应用，同时指出摘要缺乏详细机制解释及因果方向未明的局限。\"\n    },\n    {\n      \"source_handle\": \"P0228\",\n      \"paper_title\": \"The Gut Microbiome and Epigenomic Reprogramming: Mechanisms, Interactions, and Implications for Human Health and Disease\",\n      \"chapter_ids\": [\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述详述了微生物代谢物（丁酸、PSA、次级胆汁酸）通过抑制 HDAC、诱导 DNA 去甲基化等表观遗传机制调节 Tregs 功能的分子路径。材料可用于 Ch3 构建“微生物 - 表观遗传 - 免疫”三角关系理论框架，解释微生物如何通过染色质重塑影响免疫细胞可塑性和功能，为 ICI 疗效依赖微生物组提供基础生物学原理，尽管需注明其多为通用免疫调节机制而非 ICI 特异性验证。\"\n    },\n    {\n      \"source_handle\": \"P0229\",\n      \"paper_title\": \"The role of gut microbiota in cancer treatment: friend or foe?\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述列举了 Bacteroides, Akkermansia 等与 ICI 疗效相关的菌种，详述了 Th1 反应诱导、T 细胞募集等机制，并评估了 FMT、益生菌等干预策略的现状。材料可用于 Ch2 提供经典菌种列表及跨癌种证据；在 Ch3 中整合免疫和代谢机制；在 Ch5 中讨论临床转化挑战（如 FMT 安全性、益生菌效果不一致），作为全面背景素材连接基础发现与临床应用。\"\n    },\n    {\n      \"source_handle\": \"P0230\",\n      \"paper_title\": \"283 Safety and efficacy signals in the complete phase I study of live biotherapeutic MRx0518 in combination with pembrolizumab in patients refractory to immune checkpoint inhibitors (ICIs)\",\n      \"chapter_ids\": [\n        \"Ch5_Interventions\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该 I 期研究显示单菌株疗法 MRx0518 联合帕博利珠单抗在难治性实体瘤中实现 42% 疾病控制率，机制涉及激活 TLR5 诱导 NFκB 及 T 细胞浸润。材料可用于 Ch5 提供活体生物药（LBP）临床转化的早期实证，展示单菌株策略的可行性；在 Ch3 中解析 TLR5 信号通路连接先天免疫与适应性免疫的具体机制，作为微生物干预克服耐药的潜在路径。\"\n    },\n    {\n      \"source_handle\": \"P0231\",\n      \"paper_title\": \"Potential role of gut microbes in the efficacy and toxicity of immune checkpoints inhibitors\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\",\n        \"Ch5_Interventions\"\n      ],\n      \"specific_usable_material\": \"该综述汇总了不同实体瘤中与 ICI 疗效及 irAEs 相关的微生物门类及菌种，概述了 SCFAs、肌苷等代谢物调节免疫的机制，并总结了 FMT 等干预手段。材料可用于 Ch2 提供跨癌种微生物标志物列表；在 Ch3 中构建从菌群组成到免疫功能的理论连接；在 Ch5 中评估各类干预策略的利弊，作为全面背景素材支持综述各章节的论证。\"\n    },\n    {\n      \"source_handle\": \"P0232\",\n      \"paper_title\": \"Multidimensional analysis of the impact of Gemmatimonas, Rhodothermus, and Sutterella on drug and treatment response in colorectal cancer\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该研究基于计算预测发现结直肠癌微生物亚型（C1/C2）与免疫治疗反应预测指标（T-cell-inflamed GEP, TIDE）相关，C1 亚型高 T 细胞炎症特征暗示对 ICI 敏感。材料可用于 Ch2 提供微生物组分层患者免疫微环境的实例，支持其作为预测生物标志物的潜力；在 Ch3 中提示特定菌群（如 Gemmatimonas）可能通过塑造免疫细胞组成（巨噬细胞 vs mDCs）间接影响疗效的线索。\"\n    },\n    {\n      \"source_handle\": \"P0233\",\n      \"paper_title\": \"Association of intra-tumoral microbiome and response to immune checkpoint inhibitors (ICIs) in patients with metastatic renal cell carcinoma (mRCC).\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该小样本研究发现 mRCC 肿瘤内嗜麦芽窄食单胞菌和棒状杆菌与 ICI 响应正相关，提示肿瘤局部微生物可能独立于肠道菌群调节疗效。材料可用于 Ch2 提供肿瘤内微生物组作为预测标志物的实证，区分肠道与瘤内作用域；在 Ch3 中结合 BCG 历史背景，提出棒状杆菌可能通过增强局部免疫反应促进 ICI 疗效的假设，强调解剖部位特异性。\"\n    },\n    {\n      \"source_handle\": \"P0234\",\n      \"paper_title\": \"Biomarkers of immune checkpoint inhibitor efficacy in cancer.\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述提供了抗生素使用缩短实体瘤患者 PFS/OS 的人类临床证据，并指出响应者粪便中 Akkermansia muciniphila 丰度更高，且无菌小鼠 FMT 实验证实因果性。材料可用于 Ch2 提供人类队列中负面（抗生素）和正面（特定菌种）关联证据；在 Ch3 中作为从相关性到因果性的关键实验支持，说明微生物通过增强抗肿瘤免疫介导疗效的初步机制。\"\n    },\n    {\n      \"source_handle\": \"P0235\",\n      \"paper_title\": \"T cell receptor therapy against melanoma—Immunotherapy for the future?\",\n      \"chapter_ids\": [\n        \"Ch2_Clinical\",\n        \"Ch3_Mechanisms\"\n      ],\n      \"specific_usable_material\": \"该综述指出黑色素瘤 ICI 响应者中富集 Ruminococcaceae, Bifidobacterium 等菌，而非响应者富集 Bacteroidales，并提出有利菌群通过增强抗原呈递和 T 细胞功能促进疗效的机制。材料可用于 Ch2 提供黑色素瘤领域的经典微生物标志物证据；在 Ch3 中结合 TME 抑制机制（MDSCs, Tregs），讨论微生物可能通过改善抗原呈递和效应 T 细胞功能克服微环境抑制的潜在路径。\"\n    },\n    {\n      \"source_handle\": \"P0236\",\n      \"paper_title