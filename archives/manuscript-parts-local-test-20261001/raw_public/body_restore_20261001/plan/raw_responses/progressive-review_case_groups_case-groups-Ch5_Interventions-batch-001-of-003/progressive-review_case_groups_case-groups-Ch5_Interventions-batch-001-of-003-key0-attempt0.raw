        "content": "{\n  \"additions\": [\n    {\n      \"unit_key\": \"Ch5_Interventions:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0212\",\n          \"proposed_use\": \"提供FMT联合ICI的汇总疗效数据（ORR 43%）及亚组分析，用于论证不同供体来源与给药途径对临床结局的趋势性影响，并量化安全性边界。\"\n        },\n        {\n          \"source_handle\": \"P0058\",\n          \"proposed_use\": \"补充消化道肿瘤中抗生素预处理FMT（A-FMT）的早期可行性与微生物组趋同证据，作为对比健康供体FMT在特定解剖部位定植策略的对照案例。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch5_Interventions:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0009\",\n          \"proposed_use\": \"提供MB097九菌株联合制剂的临床前机制与MELODY-1试验背景，用于说明从相关性发现到标准化定义菌群（LBP）转化的具体路径及当前局限。\"\n        },\n        {\n          \"source_handle\": \"P0122\",\n          \"proposed_use\": \"展示MET4联合体诱导宿主特异性IgG及外周免疫亚群重塑的早期人体数据，用于补充活体生物药除局部代谢物外的体液免疫调节维度及个体反应异质性。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch5_Interventions:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0198\",\n          \"proposed_use\": \"提供限时进食（TRE）通过重塑色氨酸代谢物改善肾癌ICI响应的因果链条，作为非药物饮食干预克服原发耐药的实证案例及代谢重编程机制例证。\"\n        },\n        {\n          \"source_handle\": \"P0201\",\n          \"proposed_use\": \"展示天然多酚castalagin特异性结合Ruminococcus并逆转抗PD-1耐药的小鼠模型证据，用于阐释植物源性益生元通过靶向特定菌属改变胆汁酸代谢的机制。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch5_Interventions:4\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0017\",\n          \"proposed_use\": \"提供结肠炎型irAEs患者粪便特征及小鼠FMT致致死性结肠炎的因果验证，用于界定微生物组干预的安全毒性谱系及产丁酸菌缺失的潜在病理关联。\"\n        },\n        {\n          \"source_handle\": \"P0600\",\n          \"proposed_use\": \"基于系统评价结论明确截至2026年中尚无完成的大规模Phase III RCT证实任何微生态干预在ICI中的生存获益，用于支撑III期确证缺口与标准化范式呼吁。\"\n        }\n      ]\n    }\n  ]\n}",
