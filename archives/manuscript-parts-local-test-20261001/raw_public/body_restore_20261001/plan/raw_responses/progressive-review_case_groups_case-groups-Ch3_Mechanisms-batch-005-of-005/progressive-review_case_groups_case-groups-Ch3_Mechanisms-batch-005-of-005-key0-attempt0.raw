        "content": "{\n  \"additions\": [\n    {\n      \"unit_key\": \"Ch3_Mechanisms:1\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0582\",\n          \"proposed_use\": \"提供肌苷通过直接抑制肿瘤细胞UBA6泛素激活酶活性，解除其对炎症信号通路抑制的核心因果机制证据，并连接CheckMate 025队列中人类生存获益数据。\"\n        },\n        {\n          \"source_handle\": \"P0541\",\n          \"proposed_use\": \"补充微生物群对肿瘤细胞表观遗传和基因表达的直接影响机制，特别是DC介导的细菌长距离迁移路径，作为代谢物调节之外的物理桥接证据。\"\n        },\n        {\n          \"source_handle\": \"P0570\",\n          \"proposed_use\": \"提供非肽类分子模拟假说（微生物诱导天然抗糖脂抗体/ADCC），解释部分无法用T细胞肽识别解释的微生物效应，丰富体液免疫调节视角。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch3_Mechanisms:2\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0563\",\n          \"proposed_use\": \"详细拆解SCFAs、胆汁酸等关键代谢物对T细胞、巨噬细胞的具体分子作用路径（HDAC抑制、GPR激活），并关联具体癌症类型和临床结局，支撑剂量依赖性与双向调节综合判断。\"\n        },\n        {\n          \"source_handle\": \"P0559\",\n          \"proposed_use\": \"绘制微生物代谢物调节ICI疗效的高阶机制图谱，区分不同ICI靶点（PD-1 vs CTLA-4）下的代谢物效应差异，警示避免跨癌种简单外推单一代谢物的功能。\"\n        },\n        {\n          \"source_handle\": \"P0553\",\n          \"proposed_use\": \"解析结直肠癌中微生物代谢物（丁酸盐、色氨酸衍生物、胆汁酸）的双向免疫调节机制，包括具体信号通路（TLR5, AHR, cGAS-STING），作为代谢物情境依赖性的核心例证。\"\n        }\n      ]\n    },\n    {\n      \"unit_key\": \"Ch3_Mechanisms:3\",\n      \"studies\": [\n        {\n          \"source_handle\": \"P0589\",\n          \"proposed_use\": \"提供NSCLC中微生物组信号与疗效/毒性关联的具体案例及边界（如Akkermansia非单调效应），强调缺乏同一患者多层面闭合链条及定量验证的证据缺口。\"\n        },\n        {\n          \"source_handle\": \"P0574\",\n          \"proposed_use\": \"提出整合性框架将菌群失调定义为生态韧性破坏，引入TOPOSCORE评分工具，并详述胆汁酸代谢、屏障功能及Tr17细胞迁移机制，解释代理标志物的局限性。\"\n        },\n        {\n          \"source_handle\": \"P0542\",\n          \"proposed_use\": \"展示健康人体内‘菌群-代谢（脂质/氨基酸）-免疫’轴的关联模式，作为非药物干预下菌群调节免疫的典型参照，同时警示健康人数据外推至ICI治疗情境时的局限性。\"\n        }\n      ]\n    }\n  ]\n}",
