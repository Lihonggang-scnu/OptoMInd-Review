        "content": "{\n  \"chapter_id\": \"Ch3_Mechanisms\",\n  \"chapter_argument\": \"肠道微生物组通过代谢物 - 受体信号轴、免疫细胞物理迁移及抗原模拟三条核心路径调节 ICI 疗效；临床前模型已确立因果链条，但人类证据仍受限于替代标志物（如 UBA6）与绝对浓度测量缺口，需建立从机制到临床转化的审慎评估框架。\",\n  \"units\": [\n    {\n      \"unit_id\": \"Ch3_Mechanisms_U01\",\n      \"focus\": \"阐明代谢物 - 受体信号轴如何直接调控肿瘤细胞内在免疫原性及微环境重塑，区分不同代谢物的双向效应与情境依赖性。\",\n      \"paragraph_tasks\": [\n        {\n          \"paragraph_id\": \"Ch3_Mechanisms_U01_P01\",\n          \"source_uses\": [\n            {\n              \"source_handle\": \"P0582\",\n              \"role\": \"主论据\",\n              \"use\": \"提供肌苷抑制 UBA6 增强肿瘤免疫原性的分子机制及 CheckMate 025 队列生存数据\"\n            },\n            {\n              \"source_handle\": \"P0617\",\n              \"role\": \"临床验证\",\n              \"use\": \"提供肌苷联合 ICI 的 II 期临床试验证据，支撑其转化潜力\"\n            },\n            {\n              \"source_handle\": \"P0635\",\n              \"role\": \"代理标志物\",\n              \"use\": \"说明 UBA6 在胰腺癌中的预后价值，作为肌苷效应的下游代理指标\"\n            },\n            {\n              \"source_handle\": \"P0570\",\n              \"role\": \"补充机制\",\n              \"use\": \"提供非肽类分子模拟（抗糖脂抗体）作为代谢物之外的肿瘤内在调节补充视角\"\n            }\n          ]\n        },\n        {\n          \"paragraph_id\": \"Ch3_Mechanisms_U01_P02\",\n          \"source_uses\": [\n            {\n              \"source_handle\": \"P0486\",\n              \"role\": \"主论据\",\n              \"use\": \"综述 CRC 中代谢物重塑免疫微环境的机制框架\"\n            },\n            {\n              \"source_handle\": \"P0447\",\n              \"role\": \"背景\",\n              \"use\": \"提供微生物代谢物影响 TME 的一般性机制背景\"\n            },\n            {\n              \"source_handle\": \"P0357\",\n              \"role\": \"干预关联\",\n              \"use\": \"关联益生菌使用与代谢物介导的免疫相互作用\"\n            },\n            {\n              \"source_handle\": \"P0075\",\n              \"role\": \"例证\",\n              \"use\": \"阐释丁酸/戊酸浓度依赖性（>10mM vs >2.5μM）对 CD8+ T 细胞与 Treg 的双向调节\"\n            },\n            {\n              \"source_handle\": \"P0092\",\n              \"role\": \"临床关联\",\n              \"use\": \"提供粪便丙酸/丁酸浓度预测 PFS 的观察性队列证据\"\n            },\n            {\n              \"source_handle\": \"P0220\",\n              \"role\": \"比较\",\n              \"use\": \"对比 SCFAs、肌苷、胆汁酸在不同微环境下的促炎/抑炎矛盾证据\"\n            },\n            {\n              \"source_handle\": \"P0282\",\n              \"role\": \"机制细节\",\n              \"use\": \"细化色氨酸衍生物经 AhR 及肌苷经 A2AR-cAMP 通路的具体分子路径\"\n            },\n            {\n              \"source_handle\": \"P0180\",\n              \"role\": \"机制细节\",\n              \"use\": \"解析次级胆汁酸通过 FXR/TGR5 调节 Th17/Treg 平衡的通用原理\"\n            },\n            {\n              \"source_handle\": \"P0369\",\n              \"role\": \"机制细节\",\n              \"use\": \"补充 HDAC 抑制、GPCR 与 AhR 通路重塑免疫微环境的具体路径\"\n            },\n            {\n              \"source_handle\": \"P0413\",\n              \"role\": \"比较\",\n              \"use\": \"对比丁酸盐在抗 PD-1 与抗 CTLA-4 治疗中的相反效应（促进 CD8+ vs 增强 Treg）\"\n            },\n            {\n              \"source_handle\": \"P0326\",\n              \"role\": \"局限\",\n              \"use\": \"指出粪便/血清 SCFA 水平与预后关联的方向矛盾，提示功能代谢组学优于分类学\"\n            },\n            {\n              \"source_handle\": \"P0391\",\n              \"role\": \"框架\",\n              \"use\": \"构建“微生物来源 - 介质 - 宿主受体-TME 组分 - 结果”五要素框架连接全身代谢与局部表型\"\n            },\n            {\n              \"source_handle\": \"P0503\",\n              \"role\": \"比较\",\n              \"use\": \"阐释 SCFAs 与胆汁酸在抗 PD-1 和抗 CTLA-4 治疗中的双向调节差异\"\n            },\n            {\n              \"source_handle\": \"P0518\",\n              \"role\": \"机制细节\",\n              \"use\": \"提供代谢物调控 PD-1/PD-L1 表达的具体分子图谱（HDAC-FOXO1 等）\"\n            },\n            {\n              \"source_handle\": \"P0541\",\n              \"role\": \"补充机制\",\n              \"use\": \"补充微生物群对肿瘤细胞表观遗传和基因表达的直接影响机制\"\n            }\n          ]\n        }\n      ],\n      \"table_tasks\": [\n        {\n          \"table_id\": \"Ch3_Mechanisms_U01_T01\",\n          \"purpose\": \"比较关键微生物代谢物的受体靶点、免疫效应及治疗情境依赖性\",\n          \"columns\": [\n            \"代谢物类别\",\n            \"关键受体/靶点\",\n            \"对 ICI 疗效的影响\",\n            \"情境/剂量依赖性\"\n          ],\n          \"row_tasks\": [\n            {\n              \"content\": \"肌苷（Inosine）\",\n              \"source_uses\": [\n                {\n                  \"source_handle\": \"P0582\",\n                  \"role\": \"比较\",\n                  \"use\": \"提供 UBA6 抑制靶点及增强免疫原性结论\"\n                }\n              ]\n            },\n            {\n              \"content\": \"短链脂肪酸（SCFAs）\",\n              \"source_uses\": [\n                {\n                  \"source_handle\": \"P0075\",\n                  \"role\": \"比较\",\n                  \"use\": \"提供浓度依赖性双向调节（HDAC 抑制 vs Treg 分化）数据\"\n                },\n                {\n                  \"source_handle\": \"P0413\",\n                  \"role\": \"比较\",\n                  \"use\": \"提供抗 PD-1 与抗 CTLA-4 背景下的效应差异\"\n                }\n              ]\n            },\n            {\n              \"content\": \"胆汁酸（Bile Acids）\",\n              \"source_uses\": [\n                {\n                  \"source_handle\": \"P0180\",\n                  \"role\": \"比较\",\n                  \"use\": \"提供 FXR/TGR5 受体及 Th17/Treg 平衡调节结论\"\n                },\n                {\n                  \"source_handle\": \"P0503\",\n                  \"role\": \"比较\",\n                  \"use\": \"提供不同 ICI 靶点下的调节差异\"\n                }\n              ]\n            },\n            {\n              \"content\": \"色氨酸衍生物\",\n              \"source_uses\": [\n                {\n                  \"source_handle\": \"P0282\",\n                  \"role\": \"比较\",\n                  \"use\": \"提供 AhR 受体及巨噬细胞极化路径\"\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"unit_id\": \"Ch3_Mechanisms_U02\",\n      \"focus\": \"解析免疫细胞