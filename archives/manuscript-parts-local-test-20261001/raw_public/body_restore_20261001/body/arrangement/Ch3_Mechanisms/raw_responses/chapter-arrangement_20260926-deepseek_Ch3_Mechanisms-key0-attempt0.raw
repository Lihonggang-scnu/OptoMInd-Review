 {\n          \"paragraph_id\": \"Ch3_Mechanisms_U03_P02\",\n          \"source_uses\": [\n            {\n              \"source_handle\": \"P0589\",\n              \"role\": \"主论据\",\n              \"use\": \"指出 NSCLC 中微生物组信号的临床相关性边界及证据异质性\"\n            },\n            {\n              \"source_handle\": \"P0640\",\n              \"role\": \"机制背景\",\n              \"use\": \"提供嘌呤代谢检查点防止自身免疫的机制，对比宿主与菌群代谢来源\"\n            },\n            {\n              \"source_handle\": \"P0642\",\n              \"role\": \"方法学\",\n              \"use\": \"提供 SCFA 定量方法的改进方案，论证标准化 LC-MS/GC-MS 参数的必要性\"\n            },\n            {\n              \"source_handle\": \"P0626\",\n              \"role\": \"干预例证\",\n              \"use\": \"展示工程化益生菌通过代谢重编程调节 TME 的实证，提示转化路径\"\n            },\n            {\n              \"source_handle\": \"P0080\",\n              \"role\": \"转化缺口\",\n              \"use\": \"阐释宏基因组推断（lpxM 基因）与实际代谢物浓度（LPS 蛋白）的转化缺口\"\n            },\n            {\n              \"source_handle\": \"P0076\",\n              \"role\": \"方法学\",\n              \"use\": \"补充代谢组学技术挑战（参考数据库、异构体）及绝对浓度基准缺失问题\"\n            },\n            {\n              \"source_handle\": \"P0264\",\n              \"role\": \"方法学\",\n              \"use\": \"指出 16S 测序缺乏绝对定量标准，强调宏基因组/转录组整合前提\"\n            },\n            {\n              \"source_handle\": \"P0272\",\n              \"role\": \"方法学\",\n              \"use\": \"补充靶向代谢组学在血清/TME 样本中的基质干扰及健康基线缺失挑战\"\n            },\n            {\n              \"source_handle\": \"P0356\",\n              \"role\": \"方法学\",\n              \"use\": \"指出 HCC 中测序技术异质性及健康基线参考范围缺失\"\n            },\n            {\n              \"source_handle\": \"P0476\",\n              \"role\": \"方法学\",\n              \"use\": \"指出文献多采用中位数分层未报告绝对浓度值及 TME 浓度数据匮乏\"\n            },\n            {\n              \"source_handle\": \"P0444\",\n              \"role\": \"转化缺口\",\n              \"use\": \"补充 MEP 通路基因富集但 HMBPP 因化学不稳定性难检测的定量测量必要性\"\n            },\n          