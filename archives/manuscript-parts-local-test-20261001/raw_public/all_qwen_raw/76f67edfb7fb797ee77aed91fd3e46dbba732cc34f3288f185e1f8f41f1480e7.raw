{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n  \"source_handle\": \"P0421\",\n  \"paper_title\": \"The impact of sarcopenia on the efficacy and safety of immune checkpoint inhibitors in patients with solid tumours\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该回顾性研究指出低肌肉量（肌肉减少症）并不必然导致 ICI 疗效下降或毒性增加，甚至在肺癌亚组中与较好 PFS 相关。此发现作为非微生物类宿主因素的反例，用于综述局限性章节，强调在评估微生物组效应时需区分并控制其他身体成分变量，避免将宿主异质性简单归因于菌群。\"\n},\n    {\n  \"source_handle\": \"P0422\",\n  \"paper_title\": \"Gut Associated Metabolites Enhance PD-L1 Blockade Efficacy in Prostate Cancer\",\n  \"chapter_ids\": [\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该研究在前列腺癌模型中揭示特定花生四烯酸代谢物（16(R)-HETE, 6-Keto-PGE1）通过上调外泌体 PD-L1 增强抗 PD-L1 疗效。此材料用于机制章节，提供“肠 - 肿瘤代谢轴”的具体分子路径，展示代谢物如何通过改变检查点分子密度而非直接激活免疫细胞来介导疗效，补充传统免疫激活机制之外的视角。\"\n},\n    {\n  \"source_handle\": \"P0423\",\n  \"paper_title\": \"Targeting molecular pathways to control immune checkpoint inhibitor toxicities\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述将微生物组与特定细胞因子（IL-6, IL-17）及整合素通路联系起来，主要聚焦 irAEs 机制。用于机制章节作为背景，说明微生物组通过系统性炎症调节免疫稳态的潜在路径；同时在局限性章节指出，多数机制证据侧重于毒性控制而非直接抗肿瘤增效，提示疗效与毒性机制可能存在分离。\"\n},\n    {\n  \"source_handle\": \"P0424\",\n  \"paper_title\": \"Gut microbiota and metabolites associate with outcomes of immune checkpoint inhibitor–treated unresectable hepatocellular carcinoma\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该研究在 HCC 队列中识别 Lachnoclostridium 富集与次级胆汁酸（UDCA/UCA）水平升高及良好 ICI 预后相关。用于特征章节提供肝癌特异性菌群标志物案例；用于机制章节提出“微生物 - 胆汁酸轴”假说，即特定菌群通过代谢转化影响局部免疫微环境，但需注明其为观察性关联且受地域限制。\"\n},\n    {\n  \"source_handle\": \"P0425\",\n  \"paper_title\": \"Microbial dysbiosis and childhood asthma development: Integrated role of the airway and gut microbiome, environmental exposures, and host metabolic and immune response\",\n  \"chapter_ids\": [\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该综述详细阐述 SCFAs 通过抑制 NF-κB、促进 Tregs 分化调节免疫的机制，虽基于哮喘模型。用于机制章节作为理论背景，解释“肠 - 肺轴”及微生物代谢物系统性调节适应性免疫的通用生物学原理，为理解其在肿瘤免疫中的潜在作用提供类比支持，但需明确其非肿瘤直接证据。\"\n},\n    {\n  \"source_handle\": \"P0426\",\n  \"paper_title\": \"1038P Impact of metastatic location on immune-checkpoint inhibitors efficacy in patients with different solid tumours\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究发现转移灶数量（≥3）显著降低 ICI 疗效，但单发转移部位类型无影响。用于局限性章节，强调肿瘤负荷和解剖学因素是强效混杂变量，在评估微生物组预测价值时必须加以控制；同时提示单纯解剖位置差异可能不足以解释疗效异质性，需关注更具系统性的生物标志物。\"\n},\n    {\n  \"source_handle\": \"P0427\",\n  \"paper_title\": \"Abstract 2377: Gut microbiome modulation by a black raspberry nectar for improving anti-PD1 therapy effectiveness in pre-clinical cancer models\",\n  \"chapter_ids\": [\n    \"CH04\",\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该摘要报道黑树莓花蜜通过增加 Lachnospiraceae/Blautia 及 L-肉碱水平增强小鼠抗 PD-1 疗效。用于干预章节作为饮食调节微生物组的临床前案例，展示非益生菌类天然产物的潜力；用于机制章节提出 L-肉碱作为潜在新型代谢介质的假设，区别于传统的 SCFA 或肌苷通路。\"\n},\n    {\n  \"source_handle\": \"P0428\",\n  \"paper_title\": \"Comparison of baseline gut microbiome features between response subgroups of patients (pts) with advanced melanoma undergoing immune checkpoint inhibitor (ICI) therapy.\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该研究发现黑色素瘤响应者中 SCFA 产生菌（如 F. prausnitzii）丰度更高，且与较低 irAEs 风险相关。用于特征章节提供特定功能菌群（而非单纯多样性）作为预测因子的证据；用于机制章节探讨 SCFAs 在平衡抗肿瘤免疫与免疫毒性中的双重作用，提示疗效与安全性可能共享部分微生物机制。\"\n},\n    {\n  \"source_handle\": \"P0429\",\n  \"paper_title\": \"Enfortumab vedotin following platinum-based chemotherapy and immune checkpoint inhibitors for advanced urothelial carcinoma: response, survival and safety analysis from a multicentre real-world Japanese cohort.\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究提供尿路上皮癌 ICI 失败后使用 ADC 药物的真实世界数据，未涉及微生物组。用于局限性章节作为背景参照，说明在 ICI 耐药后的治疗场景中，目前主要依赖非微生物机制的替代疗法，反衬出基于微生物组的增敏策略在临床转化上的缺口及未来作为联合治疗方向的必要性。\"\n},\n    {\n  \"source_handle\": \"P0430\",\n  \"paper_title\": \"Microbiome bacterial influencers of host immunity and response to immunotherapy\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述系统总结了跨癌种有益/有害菌属（如 Ruminococcaceae, Akkermansia）及机制（TLR 激活、代谢物调节 T 细胞）。用于特征章节提供跨癌种菌群图谱；用于机制章节详述先天免疫激活与代谢调节路径；用于干预章节评估 FMT 和益生菌的临床前及早期临床证据，指出标准化与因果验证的不足。\"\n},\n    {\n  \"source_handle\": \"P0431\",\n  \"paper_title\": \"β-catenin in dendritic cells negatively regulates CD8 T cell immune responses through the immune checkpoint molecule Tim-3 4802\",\n  \"chapter_ids\": [\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该研究揭示 DC 内β-catenin 通过上调 Tim-3 抑制 CD8+ T 细胞。用于机制章节，虽未直接涉及肠道菌群，但提供了抗原呈递细胞（DC）功能状态决定检查点分子表达及 T 细胞活化的具体分子路径，作为理解微生物组可能通过调节 DC 成熟度间接影响 ICI 疗效的旁证机制。\"\n},\n    {\n  \"source_handle\": \"P0432\",\n  \"paper_title\": \"The gut microbiome affects response of treatments in HER2‐negative advanced gastric cancer\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该研究发现胃癌中 Lactobacillus 丰度与 ICI 疗效正相关，且联合治疗具有独特菌群特征。用于特征章节提供胃癌特异性标志物及治疗特异性（单药 vs 联合）的菌群差异证据；用于机制章节指出不同疗法对应不同代谢通路（如氨基酸 vs 核苷酸代谢），强调机制的情境依赖性。\"\n},\n    {\n  \"source_handle\": \"P0433\",\n  \"paper_title\": \"The relationship between gut microbiota and cancer immune response and immunotherapy\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述全面整合了菌群特征（Faecalibacterium, Akkermansia）、机制（SCFAs, TMAO, AhR 通路）及干预（FMT, 益生菌）。用于特征章节提供跨癌种标志物汇总；用于机制章节详述代谢物 - 受体互作细节；用于干预章节总结临床转化现状；用于局限性章节指出 SCFA 双重作用及标准化挑战，强调证据异质性。\"\n},\n    {\n  \"source_handle\": \"P0434\",\n  \"paper_title\": \"Abstract PS2-07-12: Gut microbiome composition predicts pathologic complete response in patients with early-stage HER2-positive breast cancer receiving neoadjuvant HER2-targeted therapy +/- immunotherapy with pembrolizumab\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该摘要报道 HER2+ 乳腺癌新辅助治疗中，特定微生物特征预测 pCR，且含免疫治疗组与不含组菌群响应模式不同。用于特征章节提供乳腺癌及新辅助场景下的预测标志物证据；用于局限性章节强调治疗背景（是否联合 ICI）对菌群 - 疗效关联的显著影响，提示标志物具有高度情境特异性。\"\n},\n    {\n  \"source_handle\": \"P0435\",\n  \"paper_title\": \"A comprehensive review of mechanisms underlying resistance to immune checkpoint inhibitors\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述详述微生物组通过调节髓系细胞、T 细胞激活及代谢（丁酸盐限制 HDAC）影响 ICI 耐药的机制。用于机制章节提供具体的免疫细胞亚群调控路径；用于局限性章节对比微生物机制与其他耐药机制（如抗原丢失），强调微生物组仅是复杂耐药网络的一部分，需综合考量。\"\n},\n    {\n  \"source_handle\": \"P0436\",\n  \"paper_title\": \"Abstract 6699: Delineating germline, tumor and extrinsic factors driving mucosal melanoma (MM) risk and response to immune checkpoint inhibitor (ICI) treatment\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该摘要描述黏膜黑色素瘤队列的多组学采集方案（粪便 + 黏膜拭子），尚无结果。用于局限性章节作为方法学参考，指出当前研究多局限于肠道菌群，忽视肿瘤局部微生物组，提示未来需整合空间多组学以解析局部与全身微生物信号的交互作用及研究设计挑战。\"\n},\n    {\n  \"source_handle\": \"P0437\",\n  \"paper_title\": \"Gene-level gut microbiome signatures as predictive biomarkers for response to immune checkpoint inhibitors across multiple cancer types\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该研究发现基因水平微生物特征（如 nitrilase 通路）比物种水平更能预测 CICB 疗效，且受年龄和治疗策略影响。用于特征章节论证功能基因作为生物标志物的优越性；用于机制章节提出氮代谢等特定通路介导疗效的假设，并强调宿主因素（年龄）对微生物 - 免疫互作的修饰作用。\"\n},\n    {\n  \"source_handle\": \"P0438\",\n  \"paper_title\": \"Gastrointestinal cancer resistance to treatment: the role of microbiota\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述聚焦消化道肿瘤，详述菌群通过代谢物、免疫细胞训练及特定病原体（如 H. pylori, Fn）影响耐药的机制。用于机制章节提供 GI 癌特异性机制（如 MDSC 招募、NK 抑制）；用于局限性章节指出多数机制基于感染模型或临床前数据，外推至非 GI 实体瘤需谨慎。\"\n},\n    {\n  \"source_handle\": \"P0439\",\n  \"paper_title\": \"Harnessing the gut microbiome for improved immune checkpoint inhibition in colorectal cancer immunotherapy: a narrative Review.\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述聚焦 MSS/pMMR 结直肠癌，总结有益菌（Akkermansia, Bifidobacterium）及机制（SCFAs, TLR4）。用于特征章节提供难治亚型标志物；用于机制章节详述代谢与免疫细胞极化路径；用于干预章节评估非抗生素策略；用于局限性章节指出 Akkermansia 作用的矛盾性及 FMT 安全挑战。\"\n},\n    {\n  \"source_handle\": \"P0440\",\n  \"paper_title\": \"An observational study to evaluate pattern of usage of immune checkpoint inhibitors in the 1st line treatment of various advanced solid tumors, their efficacy and their toxicity profile.\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究提供 ICI 一线治疗的真实世界疗效与毒性基线数据，未涉及微生物组。用于局限性章节作为临床背景参照，说明在缺乏微生物分层的情况下，总体人群响应率有限且毒性普遍，反衬出引入微生物组进行患者分层或干预以提升治疗窗口的潜在临床价值。\"\n},\n    {\n  \"source_handle\": \"P0441\",\n  \"paper_title\": \"Immune checkpoint inhibitors (ICIs) as \\\"chemotherapy (Ctx) sensitization\\\" strategy in advanced solid tumours\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究发现实体瘤中 ICI 序贯化疗未显示普遍增敏效果。用于局限性章节作为阴性对照，提示若无特定生物标志物（如特定微生物组）指导，ICI 的增敏作用可能不明显，强调未来研究需识别能预测这种协同效应的微生物特征，而非假设普遍适用。\"\n},\n    {\n  \"source_handle\": \"P0442\",\n  \"paper_title\": \"The microbiome and gynaecological cancer development, prevention and therapy\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述提及 A. muciniphila 恢复 PD-1 疗效的小鼠 FMT 证据。用于机制章节提供特定菌株逆转耐药的临床前案例；用于干预章节讨论 FMT 及工程菌在妇科肿瘤背景下的潜力，但需注明主要证据来自动物模型，人类临床数据有限，且需区分妇科特异性与通用机制。\"\n},\n    {\n  \"source_handle\": \"P0443\",\n  \"paper_title\": \"Non-small cell lung cancer patients treated with Anti-PD1 immunotherapy show distinct microbial signatures and metabolic pathways according to progression-free survival and PD-L1 status\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究在 NSCLC 中识别 Alistipes（有益）和 Streptococcus（有害）物种水平标志物，并量化预测效能。用于特征章节提供高分辨率物种标志物及机器学习预测案例；用于机制章节探讨菌群网络结构与代谢通路的作用；用于局限性章节指出种族差异及化疗预处理对菌群的扰动但不消除预测力。\"\n},\n    {\n  \"source_handle\": \"P0444\",\n  \"paper_title\": \"Microbial metabolic pathways guide response to immune checkpoint blockade therapy.\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该论文提出 MEP 通路（HMBPP 激活 Vδ2 T 细胞）促免疫，核黄素通路（5-OP-RU 激活 MAIT 细胞）抑免疫的双向机制。用于特征章节论证功能通路优于物种组成；用于机制章节详述人类特有 T 细胞亚群（Vδ2, MAIT）受微生物代谢物特异性调控的分子路径，提供精细机制解释。\"\n},\n    {\n  \"source_handle\": \"P0445\",\n  \"paper_title\": \"The future of affordable cancer immunotherapy\",\n  \"chapter_ids\": [\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述讨论微生物组疗法（FMT, SCFA 监测）作为低成本增强 ICI 疗效策略的潜力。用于干预章节提供卫生经济学视角，强调微生物干预的可及性优势；用于局限性章节指出当前证据多为观察性或早期试验，标准化困难，且不同地域菌群差异可能限制通用型低成本方案的推广。\"\n},\n    {\n  \"source_handle\": \"P0446\",\n  \"paper_title\": \"Multi-omics analysis of saccharomyces boulardii supplementation reveals coordinated microbiome, metabolic, and immune signaling changes accompanying tumor suppression\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该研究显示 S. boulardii 通过产生 5-HIAA 及间接促进 IPA（AhR 配体）抑制结肠癌生长。用于机制章节提供益生菌通过色氨酸-AhR 轴调节全身免疫的具体多组学证据；用于干预章节对比 FMT，展示市售益生菌作为标准化、安全干预手段的可行性及明确生物学功能。\"\n},\n    {\n  \"source_handle\": \"P0447\",\n  \"paper_title\": \"Microbial metabolites and their influence on the tumor microenvironment\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述详述 SCFAs、胆汁酸、色氨酸代谢物通过重塑免疫细胞代谢（糖酵解、OXPHOS）影响 TME。用于机制章节提供代谢重编程的具体分子路径；用于局限性章节指出单一代谢物靶点（如 IDO1 抑制剂）临床失败的教训，强调代谢网络的复杂性和情境依赖性，避免过度简化机制。\"\n},\n    {\n  \"source_handle\": \"P0448\",\n  \"paper_title\": \"Role of gut microbiome in the outcome of lymphoma patients treated with checkpoint inhibitors—The MicroLinf Study\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究发现淋巴瘤中 Lachnospira（有益）和 Enterobacteriaceae（有害）与疗效相关。用于局限性章节作为跨癌种对比案例，提示血液肿瘤与实体瘤可能存在不同的微生物驱动因素，强调在综合实体瘤证据时需注意肿瘤类型特异性，避免将实体瘤结论泛化至所有癌症。\"\n},\n    {\n  \"source_handle\": \"P0449\",\n  \"paper_title\": \"Gut Microbiota Metabolites and Chronic Diseases: Interactions, Mechanisms, and Therapeutic Strategies\",\n  \"chapter_ids\": [\n    \"CH03\"\n  ],\n  \"specific_usable_material\": \"该综述详述 SCFAs、胆汁酸在慢性病中调节免疫（Th17/Treg 平衡）的机制。用于机制章节作为基础生物学背景，解释微生物代谢物塑造全身免疫稳态的通用原理，为理解其在肿瘤免疫中的潜在作用提供理论支撑，但需明确其非肿瘤直接证据，仅作为机制合理性的旁证。\"\n},\n    {\n  \"source_handle\": \"P0450\",\n  \"paper_title\": \"Gut Microbiota and Response to Immunotherapeutic Drugs in Oncology: More Questions Than Answers\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述列举与 ICI 疗效相关的菌种但强调结果不一致性及机制未知。用于特征章节展示早期研究的异质性；用于局限性章节核心素材，指出当前领域“问题多于答案”的现状，强调缺乏标准化、因果证据不足及转化障碍（监管、IP），界定研究成熟度。\"\n},\n    {\n  \"source_handle\": \"P0451\",\n  \"paper_title\": \"Harnessing the Gut Microbiome in Cancer Immunotherapy: Mechanisms, Challenges, and Routes to Personalized Medicine—A Systematic Review\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该系统综述整合菌群特征、机制（SCFAs, PSA, I3A）及个性化医疗挑战。用于特征章节提供标志物汇总；用于机制章节详述受体互作；用于干预章节讨论 FMT 及益生菌的个性化需求；用于局限性章节指出临床数据有限、递送难题及需 AI/ML 整合多组学以优化预测。\"\n},\n    {\n  \"source_handle\": \"P0452\",\n  \"paper_title\": \"Sucralose and the Gut–Immune Axis: Emerging Evidence Linking Dysbiosis, Barrier Alterations, and Implications for Colitis and Colorectal Cancer Immunotherapy\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述提出三氯蔗糖通过减少精氨酸/瓜氨酸限制 CD8+ T 细胞功能从而削弱 ICI 疗效。用于机制章节提供饮食成分负面调节的具体代谢路径；用于干预章节提示饮食监测的重要性；用于局限性章节强调人类证据多为观察性，且效应具有剂量和基线依赖性，需进一步验证因果。\"\n},\n    {\n  \"source_handle\": \"P0453\",\n  \"paper_title\": \"Effect of dual immune checkpoint inhibitors (ICI) by the time of infusion in advanced non–small cell lung cancer (NSCLC): A secondary analysis of CCTG BR34 trial.\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究发现双免疫下午输注优于上午，与单药研究结果相反。用于局限性章节作为宿主因素（昼夜节律）影响疗效的异质性案例，提示时间生物学效应具有方案特异性，不能简单外推，且在评估微生物组效应时需考虑此类时间维度混杂因素。\"\n},\n    {\n  \"source_handle\": \"P0454\",\n  \"paper_title\": \"Eating away cancer: the potential of diet and the microbiome for shaping immunotherapy outcome\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述总结高纤维/植物饮食与 ICI 疗效正相关，商业益生菌可能有害。用于机制章节详述饮食 - 菌群 - 免疫轴；用于干预章节对比天然饮食与补充剂的风险收益；用于局限性章节指出多数证据来自黑色素瘤观察性研究或临床前模型，缺乏人类 RCT，且效应具有肿瘤特异性。\"\n},\n    {\n  \"source_handle\": \"P0455\",\n  \"paper_title\": \"Gut microbiome in gastrointestinal neoplasms: from mechanisms to precision therapeutic strategies\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述聚焦 GI 肿瘤，详述 FMT 恢复敏感性及工程菌策略。用于特征章节提供 GI 癌特异性标志物；用于机制章节阐述免疫重塑与屏障功能路径；用于干预章节评估 FMT 供体筛选及工程菌的临床前进展，强调 GI 肿瘤中微生物干预的特殊重要性及转化挑战。\"\n},\n    {\n  \"source_handle\": \"P0456\",\n  \"paper_title\": \"The Resistance Mechanisms of Checkpoint Inhibitors in Solid Tumors\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述将微生物群列为耐药机制之一，与其他机制（TME, 自噬）并列。用于机制章节提供交叉反应等假说；用于局限性章节构建多层次耐药网络框架，强调微生物只是众多因素之一，需结合肿瘤内在机制综合理解耐药，避免单一归因。\"\n},\n    {\n  \"source_handle\": \"P0457\",\n  \"paper_title\": \"The tumor microbiome and cancer immunotherapy: A systematic review of a new frontier beyond the gut.\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述聚焦肿瘤内微生物组而非肠道。用于机制章节提供局部免疫调节（Th1 极化，Treg 募集）的对照机制，丰富对微生物空间异质性的理解；用于局限性章节指出当前研究多忽视肿瘤驻留菌群，提示未来需整合肠道与肿瘤内微生物信号以全面解析疗效差异。\"\n},\n    {\n  \"source_handle\": \"P0458\",\n  \"paper_title\": \"Examining the impact of the microbiome on cancer immunotherapy outcomes: A review\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述提供有益菌（Akkermansia, Bifidobacterium）及三大机制类别（代谢物、细胞因子、抗原呈递）的框架。用于特征章节列举关键菌属；用于机制章节提供结构化分类；用于干预章节讨论 FMT 及饮食挑战，强调从临床前到临床转化的个体差异及伦理考量。\"\n},\n    {\n  \"source_handle\": \"P0459\",\n  \"paper_title\": \"The circadian-microbiome-immune axis in colorectal cancer: mechanisms of spatiotemporal immunosuppression and chronotherapeutic horizons\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述提出昼夜节律 - 微生物 - 免疫轴，详述 TCA 代谢物及 MDSC 时相性积累机制。用于机制章节提供时间生物学维度的具体假说；用于局限性章节强调所有证据基于小鼠模型，人类验证缺乏，且最佳给药窗口未定，提示未来需探索时间治疗学与微生物干预的结合。\"\n},\n    {\n  \"source_handle\": \"P0460\",\n  \"paper_title\": \"Therapeutic targeting of the host-microbiota-immune axis: implications for precision health\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述列举厚壁菌门（Faecalibacterium）与 ICI 疗效正相关及丁酸盐机制。用于特征章节提供关联证据；用于机制章节详述代谢物、抗原呈递及屏障功能路径；用于干预章节讨论 FMT 因果支持及益生菌通用机制，强调需区分观察性关联与因果机制。\"\n},\n    {\n  \"source_handle\": \"P0461\",\n  \"paper_title\": \"Immune checkpoint inhibitors in melanoma: mechanisms, immune cell interactions, and the tumour microenvironment\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述聚焦皮肤微生物组及 TME 机制，未涉及肠道。用于局限性章节作为解剖部位特异性案例，提示皮肤局部微生物与肠道微生物可能通过不同机制影响疗效，强调在讨论微生物组时需明确生态位，避免混淆局部与全身效应。\"\n},\n    {\n      \"source_handle\": \"P0462\",\n      \"paper_title\": \"Gut microbiome metabolites, molecular mimicry, and species-level variation drive long-term efficacy and adverse event outcomes in lung cancer survivors\",\n      \"chapter_ids\": [\n  \"CH02\",\n  \"CH03\",\n  \"CH04\"\n],\n      \"specific_usable_material\": \"该研究提出 SCFAs 预测长期疗效，分子模拟介导 irAEs 或疗效，及菌株特异性作用。用于特征章节提供长期获益者微生物特征；用于机制章节详述抗原交叉反应及菌株变异机制；用于干预章节提出“智能 FMT\"概念，强调需筛选无自身免疫模拟且高产 SCFA 的菌株。\"\n    },\n    {\n  \"source_handle\": \"P0463\",\n  \"paper_title\": \"The Great Debate at'Immunotherapy Bridge', Naples, December 5, 2019\",\n  \"chapter_ids\": [\n    \"CH03\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该辩论报告提出菌种特异性证据不足，饮食可能通过非微生物途径直接调节免疫。用于机制章节引入“功能优于组成”观点及饮食直接效应假说；用于局限性章节展示领域内关于微生物 vs 饮食主导作用的争议，提示需考虑非微生物介导的饮食效应。\"\n},\n    {\n  \"source_handle\": \"P0464\",\n  \"paper_title\": \"Potential mechanisms and targeting strategies of the gut microbiota in antitumor immunity and immunotherapy\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述详述四大机制（先天免疫激活、适应性免疫调节、代谢物、屏障）及特定菌株（Bifidobacterium, A. muciniphila）作用。用于特征章节提供菌株 - 疗效关联；用于机制章节提供全面分子通路；用于干预章节总结 FMT、工程菌及临床试验现状，强调菌株特异性及双刃剑效应。\"\n},\n    {\n  \"source_handle\": \"P0465\",\n  \"paper_title\": \"Development of a novel immune-related toxicity grading system for predicting outcomes in patients with solid tumours treated with immune checkpoint inhibitors (ICI).\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该研究发现多器官 irAEs 比单一毒性更能预测生存。用于局限性章节作为临床现象证据，支持“系统性免疫激活带来生存获益”观点，提示微生物组可能通过调节全身免疫稳态同时影响疗效与毒性，但需明确该研究未直接检测微生物组，仅为表型关联。\"\n},\n    {\n  \"source_handle\": \"P0466\",\n  \"paper_title\": \"Shaping the Future of Immunotherapy Targets and Biomarkers in Melanoma and Non-Melanoma Cutaneous Cancers\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\"\n  ],\n  \"specific_usable_material\": \"该综述总结黑色素瘤中双歧杆菌/Ruminococcaceae 与疗效相关，FMT 可逆转耐药。用于特征章节提供皮肤癌特异性证据；用于机制章节详述代谢物及抗原交叉反应假说；用于干预章节提供 FMT 临床概念验证数据，强调其在克服耐药中的潜力及个体差异挑战。\"\n},\n    {\n  \"source_handle\": \"P0467\",\n  \"paper_title\": \"Managing Resistance to Immune Checkpoint Inhibitors in Lung Cancer: Treatment and Novel Strategies.\",\n  \"chapter_ids\": [\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述聚焦肺癌耐药机制及联合策略，未直接涉及微生物组。用于局限性章节提供通用耐药框架，提示微生物组可能通过调节 TME 或 T 细胞启动影响耐药，但需结合其他文献证实，强调在肺癌背景下需区分微生物特异性机制与通用耐药路径。\"\n},\n    {\n  \"source_handle\": \"P0468\",\n  \"paper_title\": \"From Womb to World: Unravelling the Microbiota′s Impact on Health and Disease\",\n  \"chapter_ids\": [\n    \"CH02\",\n    \"CH03\",\n    \"CH04\",\n    \"CH05\"\n  ],\n  \"specific_usable_material\": \"该综述汇总微生物多样性、特定菌属与 ICI 疗效关联及 FMT 潜力。用于特征章节提供关联证据；用于机制章节提及 T 细胞激活路径；用于干预章节介绍 FMT 临床转化；用于局限性章节强调方法学异质性（测序、分析）导致结果不可比，需标准化。\"\n},\n    {\n  \"source_handle\": \"P0469\",\n  \"paper