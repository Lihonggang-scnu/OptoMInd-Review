        "content": "```json\n{\n  \"supplement_requests\": [\n    {\n      \"gap_id\": \"CH02_CH03_tme_metabolite_quant\",\n      \"gap_question\": \"Are there any studies that directly measured absolute concentrations (μM, ng/mL) of microbial metabolites (inosine, SCFAs, bile acids) within human tumor tissue microenvironment and statistically correlated these tissue levels with ICI treatment outcomes (ORR, PFS, OS)?\",\n      \"success_criteria\": \"Identification of at least one clinical study reporting quantitative metabolite concentrations in human tumor biopsy tissue (not just plasma/serum/stool) with statistical correlation to ICI efficacy endpoints.\",\n      \"intended_use\": \"quantification\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"targeted_queries\": [\n        {\n          \"query_type\": \"keyword\",\n          \"query_text\": \"tumor tissue metabolomics absolute concentration immune checkpoint inhibitor response biopsy LC-MS\"\n        },\n        {\n          \"query_type\": \"question\",\n          \"query_text\": \"Which clinical studies have measured endogenous metabolite concentrations directly in human tumor tissue samples from ICI-treated patients and correlated these with clinical outcomes?\"\n        }\n      ]\n    },\n    {\n      \"gap_id\": \"CH04_fmt_mature_os\",\n      \"gap_question\": \"Are there any updated overall survival data from randomized FMT trials (e.g., TACITO, FMT-LUMINate) with longer follow-up beyond the initial publications, or any newly published Phase II/III randomized trials with OS endpoints?\",\n      \"success_criteria\": \"Identification of mature OS data from existing randomized FMT trials or new randomized trial publications with OS hazard ratios and confidence intervals.\",\n      \"intended_use\": \"quantification\",\n      \"chapter_ids\": [\n        \"CH04\",\n        \"CH05\"\n      ],\n      \"targeted_queries\": [\n        {\n          \"query_type\": \"keyword\",