  "choices": [
    {
      "message": {
        "content": "{\n  \"chapter_proposals\": [\n    {\n      \"chapter_id\": \"CH04\",\n      \"title\": \"治疗干预：FMT、益生菌与饮食的临床可行性\",\n      \"purpose\": \"评估微生物干预（FMT、活体生物药、饮食）在临床实践中可靠增强 ICI 疗效的可行性，平衡疗效信号与安全性风险及异质性挑战。\",\n      \"scope\": \"涵盖实体瘤患者中微生物干预的人类临床数据（I/II 期试验为主），包括粪菌移植（FMT）、定义菌群/单菌株制剂（LBPs）、饮食及代谢物补充。排除纯临床前工程菌研究（除非已进入早期临床），排除仅关注血液系统恶性肿瘤且无实体瘤机制迁移证据的研究。明确区分一线增强与耐药逆转场景。\",\n      \"excluded_source_handles\": [],\n      \"substantive_threads\": [\n        {\n          \"theme\": \"粪菌移植（FMT）：疗效信号与安全性权衡\",\n          \"argument\": \"FMT 在早期试验中显示出克服 ICI 耐药的潜力，但疗效可靠性受供体特征、受体基线及 ICI 方案调节，且伴随方案依赖性毒性风险。\",\n          \"evidence_synthesis\": [\n            {\n              \"claim\": \"FMT 联合 ICI 在特定队列中显示高客观缓解率（ORR），但数据限于单臂或小型随机试验。\",\n              \"support\": \"FMT-LUMINate II 期试验显示，NSCLC 队列（一线抗 PD-1）ORR 达 80%，黑色素瘤队列（一线双 ICI）ORR 达 75%（P0583, P0589, chapter_tool_materials）。MIMic 试验在黑色素瘤中报告 ORR 65% 及长期生存信号（P0577）。\",\n              \"condition\": \"NSCLC 数据来自 PD-L1 高表达人群；黑色素瘤数据来自双免疫检查点抑制剂（抗 PD-1+ 抗 CTLA-4）背景。\"\n            },\n            {\n              \"claim\": \"安全性信号因 ICI 方案而异，双 ICI 背景下严重免疫相关不良事件（irAEs）风险显著增加。\",\n              \"support\": \"FMT-LUMINate 黑色素瘤双 ICI 组中 65% 患者发生≥3 级 irAEs（包括心肌炎、结肠炎），起病早于历史对照；而 NSCLC 单药组未观察到≥3 级 AE（P0583, P0589, chapter_tool_materials）。\",\n              \"condition\": \"毒性风险与特定供体微生物特征（如 Prevotella spp. 富集）及双 ICI 免疫激活强度相关，非 FMT 普遍现象。\"\n            },\n            {\n              \"claim\": \"FMT 在快速进展的难治性人群中可能无效，提示患者选择的重要性。\",\n              \"support\": \"MITRIC 试验在 ICI 耐药实体瘤队列中报告 ORR 0%，中位 PFS 仅 1.5 个月，仅持久定植者获益（P0578）。\",\n              \"condition\": \"受试者为快速进展的难治性患者，基线髓系细胞高表达预示不良预后。\"\n            }\n          ],\n          \"source_handles\": [\n            \"P0583\",\n            \"P0589\",\n            \"P0577\",\n            \"P0578\",\n            \"P0029\",\n            \"P0212\",\n            \"P0304\",\n            \"P0387\",\n            \"P0573\"\n          ]\n        },\n        {\n          \"theme\": \"活体生物药（LBPs）：标准化与早期临床验证\",\n          \"argument\": \"定义菌群和单菌株制剂旨在解决 FMT 异质性问题，但临床证据仍处于早期阶段，疗效尚未确证。\",\n          \"evidence_synthesis\": [\n            {\n              \"claim\": \"单菌株制剂在特定癌种中显示安全性及初步免疫调节信号，但疗效终点数据有限。\",\n              \"support\": \"MRx0518（Enterococcus gallinarum）在 ICI 难治性实体瘤 I 期研究中显示 42% 疾病控制率及肿瘤免疫基因表达变化（P0125, P0230, P0244）。CBM588 在 mRCC 中逆转菌群失调但未直接报告疗效终点（P0006, P0143）。\",\n              \"condition\": \"样本量小（n=12 至 n=100 不等），多为安全性或生物标志物终点，缺乏 III 期生存数据。\"\n            },\n            {\n              \"claim\": \"共培养菌群制剂试图模拟响应者菌群功能，但临床转化尚处临床前或早期临床阶段。\",\n              \"support\": \"MaaT034 在无菌鼠中定植并产生 SCFA/吲哚，临床测试正在进行（P0473, P0552）。SER-401 试验因万古霉素预处理导致失败，提示方案细节关键（P0150）。\",\n              \"condition\": \"多数数据来自临床前模型或早期安全性试验，疗效尚未在随机对照中证实。\"\n            }\n          ],\n          \"source_handles\": [\n            \"P0125\",\n            \"P0230\",\n            \"P0244\",\n            \"P0006\",\n            \"P0143\",\n            \"P0473\",\n            \"P0552\",\n            \"P0150\",\n            \"P0009\",\n            \"P0122\"\n          ]\n        },\n        {\n          \"theme\": \"饮食与代谢物干预：潜力与复杂性\",\n          \"argument\": \"饮食调节和特定代谢物补充提供非活菌干预路径，但证据多为观察性或临床前，商业益生菌可能存在风险。\",\n          \"evidence_synthesis\": [\n            {\n              \"claim\": \"高纤维饮食与 ICI 疗效改善相关，但商业益生菌补充剂可能干扰内源性菌群有益作用。\",\n              \"support\": \"观察性研究显示高纤维饮食与黑色素瘤/NSCLC 患者 PFS 改善相关（P0401, P0156）。商业益生菌使用与较差反应相关，小鼠模型显示其降低肿瘤微环境 IFN-γ+ T 细胞频率（P0390, P0357, P0454）。\",\n              \"condition\": \"饮食数据多为观察性关联；益生菌风险取决于菌株特异性及宿主基线菌群状态。\"\n            },\n            {\n              \"claim\": \"特定微生物代谢物（如肌苷）作为补充剂在早期临床试验中显示生存获益信号。\",\n              \"support\": \"II 期 RCT 证实外源性肌苷联合 ICI 显著延长晚期实体瘤患者中位 PFS（7.00 vs 4.40 个月），尤其在肺癌亚组，且不增加严重毒性（P0591）。机制涉及抑制肿瘤细胞 UBA6（P0582）。\",\n              \"condition\": \"单中心试验，OS 无显著差异，需多中心 III 期验证；肌苷来源包括饮食/内源性，非特异性菌群产物。\"\n            }\n          ],\n          \"source_handles\": [\n            \"P0401\",\n            \"P0156\",\n            \"P0390\",\n            \"P0357\",\n            \"P0454\",\n            \"P0591\",\n            \"P0582\",\n            \"P0198\",\n            \"P0201\",\n            \"P0452\"\n          ]\n        },\n        {\n          \"theme\": \"临床转化障碍：标准化、监管与证据等级\",\n          \"argument\": \"当前干预措施缺乏标准化方案及 III 期确证证据，监管路径复杂，限制了临床常规应用。\",\n          \"evidence_synthesis\": [\n            {\n              \"claim\": \"缺乏完成的大型 III 期随机对照试验证实生存获益，现有证据限于 I/II 期试验和荟萃分析。\",\n              \"support\": \"综述确认无完成 III 期 RCT（P0355, P0586, P0215）。荟萃分析显示 FMT 提高 ORR 但异质性高（P0212, P0470）。\",\n              \"condition\": \"证据等级低于标准抗肿瘤药物，不能视为标准护理。\"\n            },\n            {\n              \"claim\": \"供体筛选、菌株效力和给药方案缺乏标准化，监管挑战（FDA/EMA 活生物治疗产品指南）待解决。\",\n              \"support\": \"FMT 供体差异导致疗效/毒性不一致（P0583, P0573）。监管框架仍在演变中（P0387, P0445）。\",\n              \"condition\": \"不同研究间 FMT 制备、给药途径及抗生素预处理方案差异巨大。\"\n            }\n          ],\n          \"source_handles\": [\n            \"P0355\",\n            \"P0586\",\n            \"P0215\",\n            \"P0212\",\n            \"P0470\",\n            \"P0573\",\n            \"P0387\",\n            \"P0445\",\n            \"P0546\",\n            \"P0572\"\n          ]\n        }\n      ],\n      \"transition_logic\": \"本章承接 CH03 所述分子机制，将理论通路转化为临床干预策略的评估。通过展示 FMT 及 LBPs 的早期临床数据，论证机制见解向治疗转化的初步可行性，同时揭示安全性与标准化缺口。本章结论（缺乏 III 期确证、方案异质性）直接导向 CH05 对研究优先级（大型 RCT、生物标志物验证）及方法学挑战的讨论，避免在 CH05 重复陈述证据缺口现状。\",\n      \"supplement_requests\": [\n        {\n          \"question\": \"是否有最新发布的 III 期随机对照试验（2024-2025）证实微生物干预在实体瘤 ICI 治疗中的生存获益？\",\n          \"reason\": \"L1 outline 及多来源（P0355, P0586）确认无完成 III 期 RCT，但需确保检索截至 2025 年末无遗漏，以维持结论准确性。\"\n        },\n        {\n          \"question\": \"FMT-LUMINate 试验的最终总生存期（OS）数据是否已公布？\",\n          \"reason\": \"现有材料仅提供 ORR 和 PFS/安全性信号，OS 数据对于评估临床获益至关重要。\"\n        },\n        {\n          \"question\": \"是否有针对特定菌株（如 CBM588, MRx0518）的 II 期以上疗效数据更新？\",\n          \"reason\": \"现有材料多为 I 期或摘要级数据，需确认是否有更高级别证据支持其疗效主张。\"\n        }\n      ],\n      \"directed_reads\": [\n        \"P0583\",\n        \"P0589\",\n        \"P0591\",\n        \"P0577\",\n        \"P0578\"\n      ]\n    }\n  ],\n  \"screened_sources\": []\n}",
        "reasoning_content": "Thinking Process:\n\n1.  **Analyze the Request:**\n    *   **Role:** Academic Review Planning Editor (学术综述规划编辑).\n    *   **Goal:** Create a chapter proposal (chapter_proposals) for a specific chapter (CH04) of a long-form review on \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\".\n    *   **Input:** Research question, chapter details (CH04: Treatment Interventions: FMT, Probiotics, Diet), shared Level 1 outline, source routing (a large list of sources with specific usable material and limits), chapter tool materials (specific data on FMT-LUMINate trial).\n    *   **Constraints:**\n        *   Return JSON only.\n        *   Chinese language for content (titles, arguments, etc.).\n        *   Do not write Q&A lists.\n        *   Organize based on research question, disciplinary context, and available material (not a fixed template).\n        *   Center on the user's research question, propose an organizing perspective and synthetic judgment.\n        *   Do not simply summarize paper by paper.\n        *   Distinguish association vs. causation, mechanism vs. explanation, migration vs. application, validation vs. uncertainty.\n        *   Preserve source metadata (source_handle, paper_id, etc.) but do not copy the full source_routing ledger again; only cite necessary handles in specific cases.\n        *   Correct overclaims in the L1 outline based on routed evidence.\n        *   Include substantive_threads, scope, boundaries, transitions, excluded sources (if any), and supplement requests.\n        *   Respect the `manuscript_parts_boundary` (Introduction/Conclusion boundaries).\n        *   CH04 Focus: Clinical feasibility of microbiome interventions (FMT, probiotics, diet) to reliably enhance ICI efficacy.\n        *   Key Evidence to integrate: FMT-LUMINate Phase 2 data (NSCLC ORR 80%, Melanoma ORR 75%, high irAEs in melanoma dual-ICI), engineered bacteria (SYNB1891, MRx0518 Phase 1/Ib), lack of Phase 3 RCTs, donor specificity (Prevotella linked to toxicity), no standardized protocols.\n        *   Handle `chapter_tool_materials` data (FMT-LUMINate specifics) accurately.\n        *   Ensure `source_routing` is respected (use assigned sources, note exclusions if truly out of scope).\n        *   Avoid inflating gaps into field-level judgments (e.g., \"no Phase 3\" is a confirmed limit, not a search failure).\n        *   Maintain distinction between observation (antibiotics) and intervention (FMT/probiotics).\n        *   Ensure conditions (tumor type, ICI regimen, donor status) are embedded in substantive points, not just in a limitation field.\n\n2.  **Evaluate CH04 Scope & L1 Outline:**\n    *   **L1 Title:** 治疗干预：FMT、益生菌与饮食的临床可行性 (Treatment Interventions: Clinical Feasibility of FMT, Probiotics, and Diet).\n    *   **L1 Purpose:** Assess feasibility of reliably enhancing ICI efficacy in clinical practice.\n    *   **L1 Evidence Base:** FMT-LUMINate Phase 2 (NSCLC ORR 80%, Melanoma ORR 75%, 65% ≥G3 irAEs in melanoma dual-ICI), Engineered bacteria (SYNB1891, MRx0518 Phase 1/Ib).\n    *   **L1 Scope Adjustment:** All FMT data is Phase 2 single-arm or small RCT; safety signals vary by ICI regimen (dual-ICI higher toxicity); donor microbial features (Prevotella spp.) linked to toxicity; no standardized protocol.\n    *   **Critique/Refinement:** The L1 outline is generally sound but needs to ensure the distinction between \"efficacy enhancement\" (ORR/PFS) and \"safety/toxicity\" (irAEs) is central, as the FMT-LUMINate data shows a trade-off. It also needs to categorize interventions by maturity (FMT vs. Defined Consortia vs. Single Strain vs. Diet). The \"reliability\" aspect in the research question is key – current evidence suggests *potential* but not yet *reliability* due to heterogeneity.\n    *   **Source Routing:** Many sources are assigned to CH04 (e.g., P0006, P0009, P0028, P0029, P0039, P0040, P0047, P0058, P0063, P0064, P0066, P0071, P0075, P0077, P0090, P0091, P0093, P0096, P0110, P0112, P0113, P0116, P0118, P0120, P0122, P0125, P0129, P0132, P0136, P0139, P0142, P0143, P0144, P0145, P0146, P0150, P0151, P0152, P0156, P0157, P0161, P0162, P0163, P0171, P0174, P0175, P0177, P0178, P0192, P0194, P0197, P0198, P0201, P0208, P0212, P0215, P0216, P0222, P0229, P0230, P0231, P0242, P0244, P0249, P0250, P0252, P0255, P0257, P0261, P0262, P0263, P0268, P0273, P0274, P0285, P0287, P0294, P0296, P0303, P0304, P0305, P0306, P0307, P0309, P0316, P0317, P0319, P0320, P0321, P0322, P0324, P0325, P0328, P0329, P0333, P0335, P0336, P0338, P0341, P0342, P0343, P0351, P0355, P0356, P0357, P0358, P0359, P0363, P0369, P0370, P0375, P0377, P0379, P0380, P0381, P0383, P0384, P0386, P0387, P0389, P0390, P0392, P0397, P0401, P0402, P0403, P0406, P0407, P0408, P0409, P0413, P0414, P0417, P0427, P0430, P0433, P0439, P0442, P0445, P0446, P0451, P0452, P0454, P0455, P0458, P0460, P0462, P0464, P0466, P0468, P0469, P0470, P0471, P0472, P0473, P0477, P0481, P0482, P0486, P0487, P0490, P0494, P0497, P0499, P0500, P0503, P0504, P0505, P0506, P0507, P0512, P0514, P0515, P0518, P0521, P0522, P0523, P0532, P0533, P0536, P0540, P0543, P0544, P0546, P0549, P0550, P0552, P0553, P0555, P0556, P0557, P0563, P0567, P0572, P0573, P0574, P0576, P0577, P0578, P0582, P0583, P0584, P0586, P0587, P0589, P0591).\n    *   **Strategy:** I cannot list all these in the `substantive_threads` individually. I need to group them by intervention type and evidence level. I will select key representative sources for specific claims (e.g., FMT-LUMINate, MRx0518, Diet meta-analyses). I need to ensure the `chapter_tool_materials` data (FMT-LUMINate specifics) is integrated accurately.\n    *   **Correction:** The L1 outline mentions \"FMT-LUMINate Phase 2\". The `chapter_tool_materials` confirms this (NCT04951583). I need to make sure the ORR and safety data are cited correctly (NSCLC 80%, Melanoma 75%, 65% ≥G3 irAEs in melanoma dual-ICI).\n    *   **Synthesis:** The chapter should argue that while early signals are promising (especially FMT in refractory cases or specific combinations), *reliability* is compromised by heterogeneity (donor, recipient, ICI regimen) and safety concerns (irAEs). It should categorize interventions by \"Community Transfer\" (FMT), \"Defined Consortia/Single Strain\" (LBPs), and \"Diet/Prebiotics\".\n    *   **Limitations:** Must emphasize that Phase 3 RCTs are missing (confirmed in CH01/CH05 but relevant here for feasibility). Must distinguish between \"overcoming resistance\" (refractory setting) vs. \"first-line enhancement\".\n\n3.  **Drafting the Chapter Proposal:**\n    *   **Title:** 治疗干预：FMT、益生菌与饮食的临床可行性 (Keep L1 title).\n    *   **Purpose:** Evaluate the clinical feasibility and reliability of microbiome interventions to enhance ICI efficacy, balancing efficacy signals against safety risks and heterogeneity.\n    *   **Scope:** Focus on human interventional data (FMT, LBPs, Diet) in solid tumors. Exclude purely preclinical engineering unless linked to early clinical trials. Include safety (irAEs) as a critical feasibility component.\n    *   **Substantive Threads:**\n        1.  **FMT: Efficacy Signals vs. Safety Trade-offs.** Use FMT-LUMINate (P0583, P0589, tool material) and other Phase 1/2 trials (P0029, P0212, P0577, P0578). Highlight the NSCLC vs. Melanoma difference and the dual-ICI toxicity risk (Prevotella link).\n        2.  **Defined Microbiome Therapeutics (LBPs):** Single strain (MRx0518 P0125, P0230, CBM588 P0006, P0143) vs. Consortia (SER-401 lessons P0150, MaaT034 P0473, P0552). Discuss standardization advantages over FMT.\n        3.  **Diet and Prebiotics:** Fiber (P0401, P0156), Probiotics (controversial, P0390, P0357), Specific metabolites (Inosine P0591, P0582). Discuss the \"commercial probiotic\" risk vs. targeted dietary changes.\n        4.  **Implementation Barriers:** Donor screening, regulatory status (FDA/E