{
  "choices": [
    {
      "message": {
        "content": "{\n  \"source_routes\": [\n    {\n      \"source_handle\": \"P0241\",\n      \"paper_title\": \"Association of Helicobacter pylori infection with survival outcomes in advanced gastric cancer patients treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\"\n      ],\n      \"specific_usable_material\": \"提供晚期胃癌患者中幽门螺杆菌活性感染与 ICI 疗效负相关的临床观察数据（DCR 47.1% vs 72.1%），支持特定病原体抑制免疫治疗响应的假设。可用于 CH01 展示消化道肿瘤中微生物扰动的负面效应，或 CH02 作为“有害菌群”的特例，对比非小细胞肺癌中的血清学证据，强调检测时机（现症 vs 既往）对结果解释的影响及单中心回顾性研究的局限。\"\n    },\n    {\n      \"source_handle\": \"P0242\",\n      \"paper_title\": \"Targeting PD-L2/RGMb overcomes microbiome-related immunotherapy resistance\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"阐明微生物群通过下调树突状细胞 PD-L2 表达、减少其与 T 细胞 RGMb 结合从而解除免疫抑制的分子机制，并鉴定出 C. cateniformis 为关键效应菌。适用于 CH03 详述非代谢物依赖的免疫检查点调节通路；在 CH04 中作为克服耐药的策略案例，展示抗 PD-L2/RGMb 联合疗法在定植非响应者菌群小鼠模型中的有效性，同时指出该机制的肿瘤类型特异性及人体转化尚待验证。\"\n    },\n    {\n      \"source_handle\": \"P0243\",\n      \"paper_title\": \"371 The association of the gut microbiota and clinical response to immune checkpoint inhibitors in patients with advanced cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供小样本队列中肠道微生物α多样性与 ICI 临床获益及外周免疫表型（Treg 减少、炎症因子降低）关联的初步数据。可用于 CH01 说明多样性作为预测因子的争议性（本研究中生存分析未达显著），或在 CH03 构建“高多样性 - 低免疫抑制”的假说路径。需强调其探索性性质、样本量限制及未区分肿瘤类型的混杂风险，避免过度解读因果。\"\n    },\n    {\n      \"source_handle\": \"P0244\",\n      \"paper_title\": \"805 Safety and emerging evidence of immune modulation of the live biotherapeutic MRx0518 in the neoadjuvant setting for patients awaiting surgical removal of solid tumours\",\n      \"chapter_ids\": [\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"报告活体生物制剂 MRx0518 在实体瘤新辅助治疗中的初步人体安全性及肿瘤组织免疫基因表达变化（如 NK/CD8+ T 细胞相关基因上调）。适用于 CH04 展示从临床前到早期的转化路径，说明特定菌株（Enterococcus gallinarum）作为单一干预手段重塑肿瘤微环境转录特征的潜力。需明确其仅为单药安全性数据，缺乏与 ICI 联用的疗效终点，且样本量极小，结果具探索性。\"\n    },\n    {\n      \"source_handle\": \"P0245\",\n      \"paper_title\": \"Immune checkpoint blockade resistance in lung cancer: emerging mechanisms and therapeutic opportunities\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"将肠道微生物组置于肺癌 ICB 耐药的微环境因素框架中，提出其与肿瘤内在机制及缺氧等压力协同作用的假设。适用于 CH01 背景部分确立微生物组作为关键非肿瘤细胞因素的地位，或在 CH03 讨论多因素交互导致耐药的复杂网络。需指出其为综述性质，未提供具体菌种或分子通路的原始数据，主要价值在于概念整合而非机制确证。\"\n    },\n    {\n      \"source_handle\": \"P0246\",\n      \"paper_title\": \"Five-year survival outcomes in NSCLC patients with concurrent GERD on proton pump inhibitors receiving pembrolizumab or nivolumab: A global study.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供大规模真实世界证据，显示 PPI 使用与 NSCLC 患者 ICI 治疗后 5 年生存率显著下降（37.2% vs 28.3%）的关联。适用于 CH01 论证药物介导的微生物扰动对临床结局的负面影响；在 CH03 中引用其提出的机制假说（PPI 致多样性降低、有益菌如 A. muciniphila 减少），连接临床表型与潜在的微生物 - 免疫轴改变，同时强调观察性设计无法排除混杂因素。\"\n    },\n    {\n      \"source_handle\": \"P0247\",\n      \"paper_title\": \"Friends close, enemies closer: the complex role of the microbiome in antitumor immunity\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统拆解微生物组调节 ICI 疗效的三大中介机制（代谢物、抗原模拟、局部定植），并强调菌株特异性和宿主背景导致的效应异质性（如乳酸杆菌在不同癌种中的相反作用）。适用于 CH03 构建精细的机制分类框架，或在 CH05 解释为何现有生物标志物难以复现及研究结果不一致的原因。需区分其综述性质，避免将小鼠模型数据直接等同于人体确证机制。\"\n    },\n    {\n      \"source_handle\": \"P0248\",\n      \"paper_title\": \"A Literature Review on the Impact of the Gut Microbiome on Cancer Treatment Efficacy, Disease Evolution and Toxicity: The Implications for Hematological Malignancies\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"虽聚焦血液肿瘤，但提供了微生物组通过 SCFA 产生、T 细胞调节等通用机制影响免疫治疗的理论框架，列举了双歧杆菌等候选菌属。适用于 CH03 作为背景素材，对比实体瘤中相似或相异的机制路径，说明微生物 - 免疫互作的生物学普遍性。需严格限定其证据来源多为血液瘤或小鼠模型，不可直接外推至实体瘤 ICI 疗效的确切因果链。\"\n    },\n    {\n      \"source_handle\": \"P0249\",\n      \"paper_title\": \"Abstract 3523: A Black Raspberry dietary intervention to modify the gut microbiome and improve the response to immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"展示黑覆盆子饮食干预在人体中未显著改变 A. muciniphila 丰度，但在人源化小鼠模型中增强了 ICI 抗肿瘤效果的案例。适用于 CH04 讨论饮食干预的复杂性，即人体菌群组成变化与功能输出（肿瘤控制）可能存在解耦，或需依赖菌群互作网络而非单一菌种。需强调其初步性、高危人群而非癌症患者的局限性及统计效力的不足。\"\n    },\n    {\n      \"source_handle\": \"P0250\",\n      \"paper_title\": \"Exploring the role of the gut microbiome in modulating response to anti-PD-1 immunotherapy in melanoma patients\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"全面综述黑色素瘤中微生物组组成、代谢物与抗 PD-1 疗效的关联及机制，涵盖 FMT、饮食等干预策略。适用于 CH02 列举特定响应菌属（如 A. muciniphila），CH03 详述 T 细胞活化及代谢物介导的基因调控路径，或 CH04 评估 FMT 和益生菌的潜力与风险。需指出其主要基于黑色素瘤数据，跨癌种外推需谨慎，且部分机制源于动物模型。\"\n    },\n    {\n      \"source_handle\": \"P0251\",\n      \"paper_title\": \"Microbial mechanisms to improve immune checkpoint blockade responsiveness\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"详细解析特定效应分子（如 cdAMP、肌苷、SagA）及其宿主受体（STING、A2AR、NOD2）介导 ICB 响应的具体信号通路。适用于 CH03 核心部分，提供从微生物代谢物/蛋白到宿主免疫激活的分子层面解释，区分不同菌株的特异性机制（如双歧杆菌 vs 肠球菌）。需强调多数机制基于小鼠模型，且单一代谢物可能不足以重现体内复杂生态效应。\"\n    },\n    {\n      \"source_handle\": \"P0252\",\n      \"paper_title\": \"The Influence of Diet and Probiotics on the Response of Solid Tumours to Immunotherapy: Present and Future Perspectives\",\n      \"chapter_ids\": [\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"分类梳理地中海饮食、素食、Omega-3 等膳食因素及益生菌对 ICI 疗效的潜在调节作用，提出“饮食 - 微生物组 - 免疫”的概念框架。适用于 CH04 概述非药物干预策略的种类及其理论依据，作为讨论生活方式因素如何作为辅助治疗手段的起点。需指出其仅为摘要级综述，缺乏具体分子机制细节和定量疗效数据，主要提供方向性指引。\"\n    },\n    {\n      \"source_handle\": \"P0253\",\n      \"paper_title\": \"Role of gut microbiome on immunotherapy efficacy in melanoma\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"列举黑色素瘤中响应者富集的菌属（如 Bifidobacterium, Faecalibacterium）及无响应者富集的菌属，并概述细菌成分促进 T 细胞浸润等机制。适用于 CH02 提供具体菌属名单，CH03 简述免疫激活途径，或 CH05 讨论当前证据多为关联性而非因果性及临床干预数据有限的现状。需强调其核心证据集中在黑色素瘤，外推至其他实体瘤需谨慎。\"\n    },\n    {\n      \"source_handle\": \"P0254\",\n      \"paper_title\": \"Obesity, cancer, and response to immune checkpoint inhibitors: Could the gut microbiota be the mechanistic link?\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"探讨“肥胖悖论”中微生物组作为机械连接点的假设，综述 SCFA 调节瘦素、炎症因子等潜在通路，并指出肥胖相关菌群与 ICI 响应菌群的重叠与分歧。适用于 CH03 构建宿主代谢状态 - 微生物组 - 免疫治疗响应的整合模型，或在 CH05 讨论 BMI 作为指标的局限性及微生物组信号的复杂性（如某些肥胖菌可能有害）。需明确其为叙述性综述，缺乏直接因果证据。\"\n    },\n    {\n      \"source_handle\": \"P0255\",\n      \"paper_title\": \"[Tracking Research Progress in the Modulatory Role of Gut Microbiome in Immune Checkpoint Inhibitors Applied in Cancer Treatment].\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"结构化总结不同 ICI 类型（PD-1 vs CTLA-4）对应的菌群特征差异及潜在机制（如肌苷-A2AR 轴、STING 通路），并列出正在进行的 FMT/益生菌临床试验。适用于 CH02 对比不同药物下的菌群标志物，CH03 详述免疫细胞活化及代谢途径，或 CH04 展示临床转化现状。需注意 CTLA-4 相关证据的矛盾性及多数机制源于小鼠模型。\"\n    },\n    {\n      \"source_handle\": \"P0256\",\n      \"paper_title\": \"The Utilisation of Immune Checkpoint Inhibitors in Triple-Negative Breast Cancer\",\n      \"chapter_ids\": [\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"概述三阴性乳腺癌中 ICI 治疗的临床现状（单药 vs 联合化疗）及存在的阴性结局，确立该亚群中疗效变异性的临床问题。适用于 CH01 背景部分，说明为何在特定实体瘤亚型中探索微生物组等调节因素具有必要性，作为引入微生物组话题的临床需求依据。需明确其未涉及微生物组数据，仅提供疗效变异的临床背景。\"\n    },\n    {\n      \"source_handle\": \"P0257\",\n      \"paper_title\": \"Gut microbiota reshaping the pancreatic cancer immune microenvironment: new avenues for immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"聚焦胰腺癌，详述微生物组通过 TLR 信号、SCFA 及代谢物（TMAO）重塑免疫微环境的具体机制，并提及 Vancomycin 联合 ICI 试验失败的案例。适用于 CH02 列举胰腺癌特异性菌群特征，CH03 深入解析“冷肿瘤”中微生物介导的免疫激活路径，或 CH04 作为干预策略复杂性的反例，说明广谱抗菌未必有效。需强调多数机制基于小鼠模型及胰腺癌的特殊性。\"\n    },\n    {\n      \"source_handle\": \"P0258\",\n      \"paper_title\": \"Effect of gut microbiota on immune checkpoint inhibitor (ICI) based cancer immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述微生物组通过分子模拟、DC 激活及代谢物信号调节 ICI 疗效的三大机制，并列出响应/耐药相关菌属及争议点。适用于 CH02 提供候选菌属列表，CH03 构建理论框架，或 CH05 讨论个体差异及研究结果不一致的原因。需指出其为叙述性综述，机制多源于小鼠模型，且存在种间效应冲突（如拟杆菌属的作用）。\"\n    },\n    {\n      \"source_handle\": \"P0259\",\n      \"paper_title\": \"Grade 3 and Grade 4 Cutaneous toxicities in patients across multiple solid tumour types receiving checkpoint inhibitor therapy: An observational study. The experience of a single large specialist institution.\",\n      \"chapter_ids\": [\n        \"CH01\"\n      ],\n      \"specific_usable_material\": \"提供实体瘤患者中 ICI 致严重皮肤毒性（G3/4）的发生率（1.7%）及导致治疗中断的数据，确立安全性对疗效实现的制约背景。适用于 CH01 讨论临床实践中毒性管理对治疗持续性的影响，作为评估微生物组是否通过减轻毒性间接改善生存的现实约束条件。需明确其未涉及微生物组机制，仅提供毒性负担的基线数据。\"\n    },\n    {\n      \"source_handle\": \"P0260\",\n      \"paper_title\": \"The Evolving Landscape of Immunotoxicity: Charting Mechanisms and Future Strategies for Immune Checkpoint Inhibitor Adverse Events\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"讨论微生物组在 ICI 疗效与毒性（irAEs）中的双重作用，特别提及 A. muciniphila 既延长生存又增加 irAE 风险的观察。适用于 CH03 阐述微生物调节免疫平衡的复杂性，或 CH05 强调开发微生物干预时需权衡获益与风险。需指出其主要关注毒性，疗效机制描述较笼统，且多为相关性而非确证因果。\"\n    },\n    {\n      \"source_handle\": \"P0261\",\n      \"paper_title\": \"Facts and Hopes for Gut Microbiota Interventions in Cancer Immunotherapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"系统梳理微生物组介导 ICI 疗效的三大机制类别（直接 T 细胞刺激、分子模拟、代谢物），并汇总早期 FMT/菌群制剂临床试验结果。适用于 CH02 列举关键菌属，CH03 详述分子通路（如 STING、NOD2），或 CH04 评估转化潜力及队列异质性导致的生物标志物不一致问题。需区分人类观察性关联与小鼠因果证据，避免过度推断单一菌属的普适性。\"\n    },\n    {\n      \"source_handle\": \"P0262\",\n      \"paper_title\": \"The role of the bacterial microbiome in the treatment of cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"提出微生物组影响 ICI 疗效的三大机制框架（代谢、免疫反应、易位），并列举特定菌属标志物及抗生素负面影响数据。适用于 CH02 提供菌属列表，CH03 构建理论分类，或 CH04 讨论 FMT 等干预手段。需强调其包含大量小鼠模型数据，且不同癌种间标志物定义存在不一致性，机制多为假设性。\"\n    },\n    {\n      \"source_handle\": \"P0263\",\n      \"paper_title\": \"Latest evidence on clinical outcomes and prognostic factors of advanced urothelial carcinoma in the era of immune checkpoint inhibitors: a narrative review.\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"汇总尿路上皮癌中伴随用药（抗生素、PPIs）通过改变菌群负向影响 ICI 疗效的临床证据，并提及益生菌 CBM588 的初步试验数据。适用于 CH01 展示药物 - 微生物 - 疗效的临床关联链，或 CH04 作为干预策略的早期探索案例。需指出其机制描述停留在假设层面，且益生菌数据主要来自肾癌，外推至尿路上皮癌需谨慎。\"\n    },\n    {\n      \"source_handle\": \"P0264\",\n      \"paper_title\": \"Systematic evaluation of immune regulation and modulation\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"确立微生物组作为免疫调节关键因素的生物学基础，强调当前证据主要来自动物模型，并提出系统性免疫监测和数据整合的方法学建议。适用于 CH03 提供微生物组 - 免疫系统互作的概念框架，或 CH05 讨论标准化采样、测序及多组学整合分析的必要性。需明确其缺乏实体瘤 ICI 疗效的具体临床数据，主要价值在于方法学指导。\"\n    },\n    {\n      \"source_handle\": \"P0265\",\n      \"paper_title\": \"The Challenge for Development of Valuable Immuno-Oncology Biomarkers\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供黑色素瘤中响应者菌群多样性更高及梭菌属富集的观察证据，同时指出头颈癌唾液样本中未发现类似关联，强调肿瘤类型和采样部位的特异性。适用于 CH02 展示生物标志物的异质性，或 CH05 讨论单一标志物的局限性及多组学整合的必要性。需明确其为早期探索性发现，机制描述笼统，且受限于样本来源差异。\"\n    },\n    {\n      \"source_handle\": \"P0266\",\n      \"paper_title\": \"Antibiotics impair immune checkpoint inhibitor effectiveness in Hispanic patients with non‐small cell lung cancer (AB‐CLICaP)\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供拉丁美洲 NSCLC 人群中抗生素暴露显著降低 OS 但未影响 PFS 的观察数据，提示地域/人群特异性及统计效能差异。适用于 CH01 讨论抗生素影响疗效的异质性，或 CH03 引用其提出的广谱抗生素破坏有益菌（双歧杆菌等）的理论背景。需强调其回顾性设计、小样本量及未直接测量菌群的局限，结果仅显示关联。\"\n    },\n    {\n      \"source_handle\": \"P0267\",\n      \"paper_title\": \"Immune‐related adverse events of antibody‐based biological medicines in cancer therapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"确认微生物组在 ICI 疗效和 irAEs（特别是结肠炎）中的作用，列举关键菌属及 FMT 案例，并强调异质性挑战。适用于 CH02 提供菌群与响应/毒性关联的证据，CH03 阐述先天免疫激活及抗原模拟机制，或 CH05 讨论临床前模型局限性及微生物组异质性对转化的阻碍。需指出多数发现基于观察性研究，因果机制仍需验证。\"\n    },\n    {\n      \"source_handle\": \"P0268\",\n      \"paper_title\": \"Molecular studies on the impact of microbiome on anticancer drug resistance\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详细解析微生物代谢物（SCFAs、琥珀酸）及菌群易位通过 cGAS-干扰素β通路等机制调节 ICI 耐受的分子网络，并评估 FMT/益生菌的干预现状。适用于 CH02 列举具体菌属与代谢物，CH03 构建复杂的信号通路图谱，或 CH04 讨论干预策略的情境依赖性及潜在风险。需强调其情境依赖性（宿主状态、饮食等）及多数证据源于临床前模型。\"\n    },\n    {\n      \"source_handle\": \"P0269\",\n      \"paper_title\": \"'Know thyself' – host factors influencing cancer response to immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"结构化综述宿主因素（含微生物组）对 ICI 疗效的影响，列出候选菌属及三大机制假说（代谢物、先天免疫、分子模拟），并指出研究间的不一致性。适用于 CH02 汇编候选菌属，CH03 探讨具体分子路径，或 CH05 强调标准化协议及多因素整合分析的必要性。需明确其为叙述性综述，机制多基于小鼠模型，且缺乏统一共识。\"\n    },\n    {\n      \"source_handle\": \"P0270\",\n      \"paper_title\": \"Composition of gastrointestinal microbiota in association with treatment response in individuals with metastatic castrate resistant prostate cancer progressing on enzalutamide and initiating treatment with anti-PD-1 (pembrolizumab)\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供 mCRPC 患者中特定菌群（S. salivarius 正向，A. muciniphila 负向）与 ICI 疗效关联的独特数据，挑战通用标志物假设，并指出既往内分泌治疗可能重塑菌群背景。适用于 CH02 展示癌种特异性标志物及通用指数失效的反例，或 CH05 讨论治疗史对微生物组 - 疗效关系的修饰作用。需强调其小样本量及 A. muciniphila 负向关联的情境特殊性。\"\n    },\n    {\n      \"source_handle\": \"P0271\",\n      \"paper_title\": \"The role of the gut microbiome on the efficacy of immune checkpoint inhibitors in Japanese responder patients with advanced non-small cell lung cancer.\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"提供日本 NSCLC 患者中特定菌属（Lactobacillus 正向趋势，Bilophila 负向关联）与 TTF 的观察数据，尽管部分未达统计显著。适用于 CH02 补充亚洲人群数据及菌种特异性效应的案例，或 CH05 讨论小样本研究的探索性价值及单次采样的局限性。需强调其幸存者偏差风险及机制推测性质，避免夸大统计效力不足的结果。\"\n    },\n    {\n      \"source_handle\": \"P0272\",\n      \"paper_title\": \"Combined or Sequential Treatment with Immune Checkpoint Inhibitors and Car-T Cell Therapies for the Management of Haematological Malignancies: A Systematic Review\",\n      \"chapter_ids\": [],\n      \"specific_usable_material\": \"该研究聚焦血液系统恶性肿瘤中 ICI 与 CAR-T 的联合治疗，未涉及实体瘤或肠道微生物组机制。其关于 ICI 在血液瘤中疗效有限的结论虽具对比价值，但缺乏微生物组相关数据，无法直接回答用户关于实体瘤中微生物组调节 ICI 疗效及机制的核心问题，故不纳入本次规划。\"\n    },\n    {\n      \"source_handle\": \"P0273\",\n      \"paper_title\": \"The Gut Microbiome and Cancer Immunotherapy: Can We Use the Gut Microbiome as a Predictive Biomarker for Clinical Response in Cancer Immunotherapy?\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"汇总多项临床研究数据，确认特定菌群（Faecalibacterium, Akkermansia）与 ICI 响应及 FMT 恢复敏感性的关联，并指出抗生素的负面影响。适用于 CH02 提供临床证据支持生物标志物假设，CH03 引用 FMT 后免疫表型变化作为因果间接证据，或 CH04 评估 FMT 的初步临床转化潜力。需强调其仅纳入临床研究，机制解析受限于观察性设计及样本量。\"\n    },\n    {\n      \"source_handle\": \"P0274\",\n      \"paper_title\": \"Microbiome and cancer: mechanistic insights, diagnostic potential, and therapeutic strategies\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详尽阐述微生物组增强 ICI 疗效的四大机制（DC 活化、T 细胞启动、代谢物调节、抗原模拟），并列出关键菌属及 FMT 早期证据。适用于 CH02 提供菌属列表，CH03 构建详细的分子细胞解释框架，或 CH04 讨论治疗策略的挑战。需强调其情境依赖性（如 SCFAs 的双重作用）及 FMT 尚处早期试验阶段，避免过度推断临床普及度。\"\n    },\n    {\n      \"source_handle\": \"P0275\",\n      \"paper_title\": \"The association between antibiotic use and outcomes of HCC patients treated with immune checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供 HCC 患者中抗生素使用未显著影响 ICI 疗效（OS, PFS, ORR）的阴性结果，提出肝硬化背景下的独特免疫微环境可能修饰微生物 - 药物互作。适用于 CH01 展示肿瘤类型特异性及非普遍负面效应的反例，或 CH03 讨论宿主基础疾病（肝硬化）对微生物组介导效应的潜在修饰机制。需强调其回顾性设计及机制解释的理论推测性质。\"\n    },\n    {\n      \"source_handle\": \"P0276\",\n      \"paper_title\": \"Tarloxotinib targets tumor hypoxia to improve therapeutic efficacy of immune checkpoint inhibition in a TLR9 dependent manner\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"阐明缺氧靶向药 Tarloxotinib 通过激活 TLR9/MyD88 通路促进 CD8+ T 细胞浸润从而克服 ICI 耐药的机制，虽非直接微生物研究。适用于 CH03 作为非微生物因素（缺氧、先天免疫信号）调节 ICI 疗效的对比案例，说明 TME 重塑的多元途径，或与微生物介导的免疫激活机制进行类比讨论。需明确其为小鼠模型数据，且机制特异于 TLR9 通路。\"\n    },\n    {\n      \"source_handle\": \"P0277\",\n      \"paper_title\": \"Impact of influenza vaccination on survival of patients with advanced cancer receiving immune checkpoint inhibitors (INVIDIa-2): final results of the multicentre, prospective, observational study\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供流感疫苗接种与部分实体瘤患者 ICI 生存获益关联的观察数据，提出“旁观者效应”及免疫超激活假说。适用于 CH03 讨论非靶向肿瘤抗原的外部免疫刺激（类比微生物抗原交叉反应）增强抗肿瘤免疫的潜在机制，或作为系统性炎症调节疗效的理论参照。需强调其观察性设计及肿瘤类型异质性，机制解释缺乏直接生物标志物支持。\"\n    },\n    {\n      \"source_handle\": \"P0278\",\n      \"paper_title\": \"Immune checkpoint inhibitor-associated gastrointestinal adverse events in patients with colorectal cancer\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供 MSI-H 结直肠癌患者中 ICI 相关结肠炎发生率（3.8%）及严重程度数据，并构建“微生物组 -TME- 疗效/毒性”的理论框架。适用于 CH01 提供特定癌种的毒性基线，或 CH03 引用其关于微生物代谢物重塑免疫细胞组成的机制假说，解释微生物组如何间接影响疗效与 irAEs 风险。需明确其机制描述基于文献综述，本研究未提供直接微生物数据。\"\n    },\n    {\n      \"source_handle\": \"P0279\",\n      \"paper_title\": \"Microbiome-selective DNA Pol IIIC inhibitors in oncology infection management\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"引入 DNA Pol IIIC 抑制剂作为“微生物组保护性”抗生素的新兴类别，对比传统广谱抗生素对菌群多样性的破坏。适用于 CH01 讨论减轻抗生素负面影响的潜在策略，或 CH03 阐述保留微生物多样性对维持 CD8+ T 细胞激活的重要性。需指出其观点性文章性质，数据多基于初步报告，且未直接提供 ICI 疗效的临床终点数据。\"\n    },\n    {\n      \"source_handle\": \"P0280\",\n      \"paper_title\": \"Insights into the Relationship Between the Gut Microbiome and Immune Checkpoint Inhibitors in Solid Tumors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"绘制跨癌种微生物信号图谱，总结 SCFA 介导的表观遗传调节及代谢物诱导 T 细胞激活等机制，并强调地理/饮食混杂因素。适用于 CH02 构建按癌种分类的生物标志物表，CH03 解释生物学合理性，或 CH05 讨论标准化挑战及未来方向。需明确其为叙述性综述，机制多源于小鼠模型，且关联受患者背景影响大。\"\n    },\n    {\n      \"source_handle\": \"P0281\",\n      \"paper_title\": \"The Oral–Gut Microbiome–Brain Axis in Cognition\",\n      \"chapter_ids\": [],\n      \"specific_usable_material\": \"该研究聚焦口腔 - 肠道微生物组与认知功能及神经退行性疾病的关系，未涉及肿瘤免疫治疗或 ICI 疗效机制。虽提及 SCFA 的一般免疫调节功能，但语境为神经/代谢健康，缺乏肿瘤微环境、T 细胞浸润等关键要素，无法直接回答用户关于实体瘤中微生物组调节 ICI 疗效的问题，故不纳入。\"\n    },\n    {\n      \"source_handle\": \"P0282\",\n      \"paper_title\": \"The Impact of Gut Microbiota-Derived Metabolites on the Tumor Immune Microenvironment\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"深入解析微生物代谢物（SCFAs、肌苷、色氨酸衍生物）通过代谢重编程、表观遗传修饰及受体信号（mTOR, A2A, AhR）直接调节 T 细胞和巨噬细胞功能的机制。适用于 CH03 核心部分，构建“微生物代谢物 - 受体/酶 - 免疫细胞功能 - 治疗效果”的逻辑链条，区分不同代谢物的情境依赖性作用。需强调其多基于小鼠模型，且肿瘤内微生物来源尚存争议。\"\n    },\n    {\n      \"source_handle\": \"P0283\",\n      \"paper_title\": \"Gut microbiome and serum short-chain fatty acids are associated with responses to chemo- or targeted therapies in Chinese patients with lung cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供肺癌化疗/靶向治疗中微生物组特征（Parasutterella 富集）及异丁酸通过 GPCR-HAT 轴促进组蛋白乙酰化增强疗效的证据，补充非 ICI 治疗背景下的微生物作用。适用于 CH02 对比不同治疗模式下的菌群预测因子，或 CH03 展示微生物代谢物直接作用于肿瘤细胞的非免疫调节机制。需强调其混合治疗队列及体外验证的局限性，避免简单外推至 ICI。\"\n    },\n    {\n      \"source_handle\": \"P0284\",\n      \"paper_title\": \"Metagenomics and culturomics reveal the dual role of the gut microbiome in the development of immune-related toxicities and the efficacy of immune checkpoint inhibitors in cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"揭示 Paraclostridium bifermentans 通过活菌破坏屏障致毒性、分泌代谢物增强 ICI 疗效的“双重角色”机制，并提供 FMT 转移表型的证据。适用于 CH02 展示特定菌种与疗效/毒性的复杂关联，或 CH03 详述活菌与代谢物介导的不同生理效应，强调机制的分离性。需指出其代谢物身份未明，且小鼠模型存在局限性，临床关联需考虑混杂因素。\"\n    },\n    {\n      \"source_handle\": \"P0285\",\n      \"paper_title\": \"Breakthroughs in immune checkpoint therapy: overcoming NSCLC immune checkpoint therapy resistance with novel techniques\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"综述 NSCLC 中微生物组通过代谢物（丁酸盐）及特定轴（PD-L2-RGMB）调节 ICI 疗效的机制，并提及联合治疗失败案例。适用于 CH03 提供具体的效应分子和临床关联证据，或 CH04 讨论单一靶点联合策略的局限性。需明确其为综述性质，机制描述基于引用研究，且 NSCLC 数据外推至其他实体瘤需谨慎。\"\n    },\n    {\n      \"source_handle\": \"P0286\",\n      \"paper_title\": \"Immunological Drug–Drug Interactions in Immune Checkpoint Inhibitor Therapy: Mechanisms, Clinical Evidence, and Artificial Intelligence\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"汇总抗生素和 PPIs 通过破坏菌群多样性、减少有益菌从而削弱 ICI 疗效的观察性证据及时间窗细节，并阐述微生物介导的 iDDIs 机制。适用于 CH01 提供具体的负面效应证据及暴露时间敏感性，或 CH03 详述微生物衍生物支持免疫启动的分子细胞机制。需强调其观察性数据性质及混杂偏倚风险，避免视为确凿因果证据。\"\n    },\n    {\n      \"source_handle\": \"P0287\",\n      \"paper_title\": \"Bacteria in cancer therapy: A new generation of weapons\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"综述外源性细菌疗法及共生菌（双歧杆菌）通过 TLR/STING 通路激活免疫、下调检查点分子从而增强 ICI 疗效的机制，并提及早期临床试验。适用于 CH03 提供细菌 - 宿主互作的理论框架，或 CH04 展示活菌制剂作为干预策略的潜力。需区分治疗性细菌与自然共生菌群的差异，并强调多数证据源于小鼠模型及早期试验。\"\n    },\n    {\n      \"source_handle\": \"P0288\",\n      \"paper_title\": \"Impact of Patient Characteristics on the Outcomes of Patients with Gastrointestinal Cancers Treated with Immune Checkpoint Inhibitors\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供胃肠道肿瘤中特定菌群（Lachnospiraceae 有益，Veillonellaceae 有害）及近期抗生素使用恶化 OS 的临床证据，并详述全身因素（肌少症、肝转移）通过免疫细胞功能间接影响疗效的机制。适用于 CH01 支持菌群组成直接影响 GI 肿瘤 ICI 疗效的观点，或 CH03 解释生理状态与微生物组互作的免疫学路径。需指出其多为回顾性数据，因果推断依赖动物模型。\"\n    },\n    {\n      \"source_handle\": \"P0289\",\n      \"paper_title\": \"Microbiome Landscape and Association with Response to Immune Checkpoint Inhibitors in Advanced Solid Tumors: A SCRUM-Japan MONSTAR-SCREEN Study\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供跨癌种微生物组基线数据，显示α多样性与疗效整体关联不显著，但粪便口腔细菌富集（尤其 PPI 使用者中）与 PFS 缩短相关。适用于 CH01 讨论通用生物标志物的局限性，CH02 提出口腔细菌作为负面预测因子的新视角，或 CH03 阐述 PPI 致胃酸抑制促进口腔菌易位进而削弱疗效的机制路径。需强调其观察性设计及亚组分析统计效力限制。\"\n    },\n    {\n      \"source_handle\": \"P0290\",\n      \"paper_title\": \"Abstract A14: Meta-analysis improves identification of microbiome associations with antitumor response in melanoma, lung, and kidney cancer patients treated with checkpoint inhibitors\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"通过荟萃分析证实特定细菌签名与 ICI 反应的关联，但指出需经多重检验校正，且发现α多样性并非稳定预测因子。适用于 CH02 展示大样本整合后更可靠的菌属签名及复合指数优势，或 CH05 反驳“多样性越高越好”的简单观点，强调物种组成与功能的重要性。需明确其为摘要级数据，缺乏具体效应量及功能通路细节，且未外部验证。\"\n    },\n    {\n      \"source_handle\": \"P0291\",\n      \"paper_title\": \"Role of the intestinal microbiome and microbial-derived metabolites in immune checkpoint blockade immunotherapy of cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"全面综述微生物组及代谢物（丙酸、肌苷）与 ICI 响应/毒性的关联，提出抗原依赖与非依赖两大机制路径，并讨论抗生素及 FMT 的影响。适用于 CH02 汇编已知微生物相关因子，CH03 详述分子模拟及免疫细胞参与的理论框架，或 CH05 强调研究间的不一致性及 FMT 的初步性。需区分小鼠与人类数据，避免将新兴假说过度泛化。\"\n    },\n    {\n      \"source_handle\": \"P0292\",\n      \"paper_title\": \"Predictive impact of sarcopenia in solid cancers treated with immune checkpoint inhibitors: a meta‐analysis\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"提供肌少症降低 ICI 疗效的荟萃分析证据，并提出肌源性细胞因子（如 IL-15）调节抗肿瘤免疫的机制假说。适用于 CH03 作为“宿主全身状态 - 免疫轴”的类比案例，说明除微生物组外，远端器官（肌肉）亦可通过分泌因子调制 ICI 效应，丰富对宿主微环境复杂性的理解。需明确其未涉及微生物组，仅提供宿主生理状态影响的背景线索。\"\n    },\n    {\n      \"source_handle\": \"P0293\",\n      \"paper_title\": \"Gut microbiota's role in NAFLD- and HBV/HCV-related hepatocellular carcinoma: Mechanisms and therapeutic implications.\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"综述 HCC 中微生物组通过 LPS-TLR4 信号及胆汁酸失调诱导免疫抑制微环境的机制，提及 SCFA 的抗炎作用。适用于 CH03 作为背景素材，解释慢性肝病背景下微生物组失调导致的系统性炎症和免疫抑制可能构成 ICI 抵抗的风险因素，或提供代谢物调节肿瘤微环境的实例。需明确其未直接涉及 ICI 疗效数据，主要提供基础机制框架。\"\n    },\n    {\n      \"source_handle\": \"P0294\",\n      \"paper_title\": \"The role of the gut microbiome in modulating immunotherapy efficacy in colorectal cancer\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"全面综述结直肠癌中微生物组组成、多样性与 ICI 疗效的关联及多种机制（SCFAs 抑制 NF-κB、免疫细胞调节、信号通路调控），并介绍 FMT/益生菌干预结果。适用于 CH02 提供 CRC 特异性菌群证据，CH03 详述分子靶点及通路，或 CH04 评估干预策略的早期临床结果。需强调其针对 CRC 的特异性及早期试验的局限性，避免直接外推至其他实体瘤。\"\n    },\n    {\n      \"source_handle\": \"P0295\",\n      \"paper_title\": \"Checkpoint inhibitor responses can be regulated by the gut microbiota – A systematic review\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"系统综述列出跨癌种与 ICI 疗效相关的细菌物种清单（如 F. prausnitzii 有益，B. obeum 不利），并讨论方法学局限性。适用于 CH02 构建观察性关联的证据基础，支持或反驳特定生物标志物假设，或 CH05 解释测序技术差异及采样策略（粪便 vs 黏膜）导致的结果不一致性。需明确其仅提供关联列表，未深入解析分子机制，且受原始研究定义影响大。\"\n    },\n    {\n      \"source_handle\": \"P0296\",\n      \"paper_title\": \"Microbiota: A key factor affecting and regulating the efficacy of immunotherapy\",\n      \"chapter_ids\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"提出微生物组通过“微生物 - 宿主信号传导”和“向肿瘤易位”两大路径调节 ICI 疗效的概念框架，并展望调节策略。适用于 CH03 作为机制章节的分类框架，引导对具体分子机制的深入挖掘，或 CH04 讨论转化医学挑战。需明确其为摘要级综述，缺乏具体分子细节，主要提供方向性指引及概念定义。\"\n    },\n    {\n      \"source_handle\": \"P0297\",\n      \"paper_title\": \"The gut microbiome in lung cancer: from pathogenesis to precision therapy\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"specific_usable_material\": \"详述肺癌中肠道微生物组特征（A. muciniphila, SCFA 产生菌）与 ICI 疗效的关联及机制（代谢物调节、免疫细胞启动、细菌易位），并讨论干预策略。适用于 CH02 提供肺癌特异性生物标志物，CH03 解析肠 - 肺轴的具体生物学路径，或 CH04 展示饮食/FMT 等干预的临床探索。需强调其为叙述性综述，机制多源于小鼠模型，外推至其他实体瘤需谨慎。\"\n    },\n    {\n      \"source_handle\": \"P0298\",\n      \"paper_title\": \"Gut microbial signatures and immunotherapy outcomes in NSCLC and melanoma: a systematic review and meta-analysis\",\n      \"chapter_ids\": [\n        \"CH01\",\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"通过荟萃分析定量证实高α多样性、Akkermansia 及 Faecalibacterium 与 NSCLC/黑色素瘤 ICI 疗效改善的关联，并提出可能的免疫调节机制假说。适用于 CH01 提供中等证据等级的定量关联数据，CH02 确认关键菌属的预后价值，或 CH03 引用作者提出的 T 细胞招募及屏障功能假说。需明确其关联非因果，且机制解释为推测性，仅限 NSCLC 和黑色素瘤。\"\n    },\n    {\n      \"source_handle\": \"P0299\",\n      \"paper_title\": \"Impact of Periodontal Host-Modulation Therapies on Oral–Gut Microbiome Axis in Periodontitis Patients with Hematological Diseases: A Narrative Review\",\n      \"chapter_ids\": [\n        \"CH03\"\n      ],\n      \"specific_usable_material\": \"虽聚焦血液病，但详述口 - 肠轴机制（牙周病原体易位致全身炎症）及免疫治疗对菌群的影响。适用于 CH03 作为理解微生物组通过系统性炎症途径间接影响免疫治疗微环境的理论参考，或讨论宿主调节疗法维持微生态平衡的潜力。需严格限定其对象为血液病患者，机制链条部分基于推测，不可直接外推至实体瘤 ICI 疗效的具体调节方向。\"\n    },\n    {\n      \"source_handle\": \"P0300\",\n      \"paper_title\": \"[Intestinal microbiom modulates the response to antitumor immunotherapy].\",\n      \"chapter_ids\": [\n        \"CH02\",\n        \"CH03\",\n        \"CH05\"\n      ],\n      \"specific_usable_material\": \"综述黑色素瘤、肺癌及肾癌中特定微生物签名（Faecalibacterium, Akkermansia 等）与 ICI 响应的关联，描述 T 细胞刺激及代谢物产生机制，并记录抗生素的负面影响。适用于 CH02 列举候选生物标志物，CH03 提供机制背景（如增加γ干扰素分泌），或 CH05 强调标志物的异质性及标准化需求。需明确其为 2020 年叙述性综述，机制多外推自小鼠模型，且标志物未普遍复现。\"\n    }\n  ]\n}",
