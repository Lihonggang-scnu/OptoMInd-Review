{
  "choices": [
    {
      "message": {
        "content": "{\n  \"chapter_proposals\": [\n    {\n      \"chapter_id\": \"CH01\",\n      \"title\": \"临床证据格局：抗生素时机、FMT 试验与观察性数据\",\n      \"purpose\": \"评估微生物扰动与 ICI 结局关联的临床证据强度，明确 III 期 RCT 缺失的现状，确立抗生素管理作为当前唯一基于观察性证据的临床建议，同时界定 FMT 等干预措施的早期试验性质。\",\n      \"scope\": \"涵盖实体瘤患者中抗生素、PPI、FMT 及益生菌等微生物调节因素与 ICI 疗效（OS, PFS, ORR）及安全性的临床关联与干预数据。排除纯临床前机制研究（归入 CH03）及非 ICI 治疗数据（除非作为对照基线）。明确陈述截至 2025 年末无完成的大型 III 期 RCT 证实生存获益。\",\n      \"excluded_source_handles\": [\n        {\n          \"source_handle\": \"P0030\",\n          \"reason\": \"仅为试验方案（Protocol），无结果数据，无法提供疗效证据，仅可作为背景提及在研状态。\"\n        },\n        {\n          \"source_handle\": \"P0138\",\n          \"reason\": \"聚焦 ACT/TILs 治疗而非 ICI，且样本量极小（n=3），与本章 ICI 核心主题关联较弱。\"\n        },\n        {\n          \"source_handle\": \"P0226\",\n          \"reason\": \"聚焦放疗联合 ICI，未涉及微生物组数据，仅作为联合治疗背景，非本章核心证据。\"\n        },\n        {\n          \"source_handle\": \"P0256\",\n          \"reason\": \"仅概述 TNBC 中 ICI 临床现状，无微生物组数据，仅作为疾病背景。\"\n        },\n        {\n          \"source_handle\": \"P0259\",\n          \"reason\": \"仅报告皮肤毒性发生率，无微生物组关联，非本章核心证据。\"\n        },\n        {\n          \"source_handle\": \"P0340\",\n          \"reason\": \"聚焦 HCC 中 ICI 联合抗 VEGF 及 TACE，未涉及微生物组，仅作为肿瘤负荷背景。\"\n        },\n        {\n          \"source_handle\": \"P0344\",\n          \"reason\": \"聚焦 PDL1 阴性/低 TMB 肿瘤，无微生物组数据，仅作为疗效异质性背景。\"\n        },\n        {\n          \"source_handle\": \"P0405\",\n          \"reason\": \"聚焦 irLI 发生率及与疗效关联，无微生物组数据，仅作为毒性背景。\"\n        },\n        {\n          \"source_handle\": \"P0508\",\n          \"reason\": \"结果缺失，仅确立研究范式，无法提供具体证据。\"\n        },\n        {\n          \"source_handle\": \"P0558\",\n          \"reason\": \"聚焦给药时间（昼夜节律），未涉及微生物组，仅作为混杂因素背景。\"\n        }\n      ],\n      \"substantive_threads\": [\n        {\n          \"thread_title\": \"抗生素暴露的观察性关联与时序依赖性\",\n          \"argument\": \"大样本回顾性队列与荟萃分析一致显示抗生素暴露与 ICI 疗效降低（OS/PFS）相关，但关联强度具有显著的时序依赖性和肿瘤类型异质性。ICI 启动后 60 天内暴露风险最高，提示存在关键免疫致敏窗口。\",\n          \"evidence_mapping\": [\n            {\n              \"source_handle\": \"P0575\",\n              \"role\": \"核心证据\",\n              \"detail\": \"多中心队列（n=21,108）量化 ICI 后 60 天内抗生素暴露使死亡风险增加 27%（HR 1.27），而 ICI 前暴露无显著长期影响。\"\n            },\n            {\n              \"source_handle\": \"P0100\",\n              \"role\": \"支持证据\",\n              \"detail\": \"独立队列确认 ICI 启动后 60 天内使用显著降低 ORR，治疗前使用无显著影响。\"\n            },\n            {\n              \"source_handle\": \"P0052\",\n              \"role\": \"汇总证据\",\n              \"detail\": \"NSCLC 荟萃分析量化抗生素与 OS/PFS/ORR 降低的强关联，确立其作为预后因素的地位。\"\n            },\n            {\n              \"source_handle\": \"P0068\",\n              \"role\": \"汇总证据\",\n              \"detail\": \"跨癌种荟萃分析确认抗生素与生存率降低的普遍关联，同时揭示研究间高异质性。\"\n            },\n            {\n              \"source_handle\": \"P0547\",\n              \"role\": \"异质性证据\",\n              \"detail\": \"系统综述指出黑色素瘤中无显著关联的例外，挑战普遍性假设，提示肿瘤类型特异性。\"\n            },\n            {\n              \"source_handle\": \"P0275\",\n              \"role\": \"反例证据\",\n              \"detail\": \"HCC 患者中抗生素未显著影响 ICI 疗效，提示肝硬化背景可能修饰微生物 - 药物互作。\"\n            },\n            {\n              \"source_handle\": \"P0007\",\n              \"role\": \"混杂因素\",\n              \"detail\": \"回顾性研究量化抗生素、PPIs 和类固醇使用与死亡风险增加关联，强调基线疾病严重程度的混杂可能。\"\n            },\n            {\n              \"source_handle\": \"P0012\",\n              \"role\": \"对比证据\",\n              \"detail\": \"抗生素使用也与 TKI 疗效降低相关，提示抗生素对多种疗法的普遍负面影响可能不仅限于免疫调节。\"\n            }\n          ],\n          \"conditions_and_limits\": \"所有抗生素证据均为观察性关联，不能确立因果关系。需明确标注研究多为回顾性，存在适应症偏倚（病情重者更易用抗生素）。肿瘤类型异质性（如黑色素瘤 vs 头颈癌）需具体陈述，不可泛化。\"\n        },\n        {\n          \"thread_title\": \"微生物干预（FMT/LBP）的早期临床信号与安全性\",\n          \"argument\": \"FMT 及活体生物药在 I/II 期试验中显示克服 ICI 耐药的潜力（高 ORR），但缺乏 III 期生存获益证实，且伴随方案依赖性毒性风险（尤其是双免疫治疗背景下）。\",\n          \"evidence_mapping\": [\n            {\n              \"source_handle\": \"P0583\",\n              \"role\": \"核心试验\",\n              \"detail\": \"FMT-LUMINate II 期试验显示 NSCLC ORR 80%，黑色素瘤 ORR 75%，但黑色素瘤双药组 65% 发生≥3 级 irAE。\"\n            },\n            {\n              \"source_handle\": \"P0577\",\n              \"role\": \"支持试验\",\n              \"detail\": \"MIMic I 期试验报道 FMT 联合抗 PD-1 在黑色素瘤中 ORR 65%，mOS 52.8 个月，提示临床可行性。\"\n            },\n            {\n              \"source_handle\": \"P0197\",\n              \"role\": \"支持试验\",\n              \"detail\": \"FMT-LUMINate 早期数据确认 NSCLC 与黑色素瘤 ORR 及毒性谱系差异，响应者特征包括多胺和胆汁酸升高。\"\n            },\n            {\n              \"source_handle\": \"P0578\",\n              \"role\": \"阴性/限制证据\",\n              \"detail\": \"MITRIC IIa 期试验在 ICI 耐药实体瘤中 ORR 0%，提示 FMT 在非选择性快速进展人群中无效，强调患者选择重要性。\"\n            },\n            {\n              \"source_handle\": \"P0230\",\n              \"role\": \"替代干预\",\n              \"detail\": \"单菌株疗法 MRx0518 I 期研究显示 42% 疾病控制率，提供定义菌群策略的初步证据。\"\n            },\n            {\n              \"source_handle\": \"P0039\",\n              \"role\": \"汇总证据\",\n              \"detail\": \"Meta 分析量化 FMT/益生菌与 ORR 提高的关联，但结论指出证据不足以支持常规临床应用。\"\n            },\n            {\n              \"source_handle\": \"P0212\",\n              \"role\": \"汇总证据\",\n              \"detail\": \"FMT 荟萃分析显示总 ORR 43%，双药联合时提升至 60%，但报告较高 irAE 发生率（3-4 级 37%）。\"\n            },\n            {\n              \"source_handle\": \"P0591\",\n              \"role\": \"代谢干预\",\n              \"detail\": \"肌苷 II 期 RCT 证实联合 ICI 延长 PFS，提供非菌群直接干预的代谢策略证据。\"\n            }\n          ],\n          \"conditions_and_limits\": \"所有 FMT 数据为 I/II 期单臂或小型随机试验，样本量小。需明确陈述无完成的大型 III 期 RCT 证实生存获益（基于 Tool Material）。安全性信号因 ICI 方案（单药 vs 双药）而异，不可泛化毒性风险。\"\n        },\n        {\n          \"thread_title\": \"伴随用药（PPI/类固醇/阿片类）的混杂与调节效应\",\n          \"argument\": \"PPI、类固醇及阿片类药物使用与 ICI 疗效降低相关，可能通过破坏微生物群或直接免疫抑制介导。这些药物作为关键混杂因素，需在临床证据解读中严格控制。\",\n          \"evidence_mapping\": [\n            {\n              \"source_handle\": \"P0135\",\n              \"role\": \"核心证据\",\n              \"detail\": \"荟萃分析证实 PPI 使用与 ICI 治疗后 OS 缩短（HR=1.18）显著相关，提出菌群失调机制假说。\"\n            },\n            {\n              \"source_handle\": \"P0185\",\n              \"role\": \"真实世界证据\",\n              \"detail\": \"TriNetX 大数据显示 PPI 与多种实体瘤死亡率显著增加（HR 1.3-1.9）及 ICU 入院率升高相关。\"\n            },\n            {\n              \"source_handle\": \"P0339\",\n              \"role\": \"时序证据\",\n              \"detail\": \"荟萃分析指出 PPI 仅在 ICI 前长期使用时显著影响疗效，提示时间累积的菌群失调是中介因素。\"\n            },\n            {\n              \"source_handle\": \"P0107\",\n              \"role\": \"交互作用\",\n              \"detail\": \"回顾性研究提示抗生素与皮质类固醇协同抑制免疫治疗，强调多重免疫抑制因素的复杂交互。\"\n            },\n            {\n              \"source_handle\": \"P0016\",\n              \"role\": \"阿片类证据\",\n              \"detail\": \"系统综述汇总阿片类药物使用与 ICI 疗效降低的观察性关联，提出肠道稳态破坏假设。\"\n            },\n            {\n              \"source_handle\": \"P0489\",\n              \"role\": \"多药联用\",\n              \"detail\": \"真实世界研究显示 ICI 启动前 30 天内抗生素暴露与 ORR 降低相关，且多药联用独立预测生存恶化。\"\n            },\n            {\n              \"source_handle\": \"P0088\",\n              \"role\": \"毒性证据\",\n              \"detail\": \"药物警戒分析提供 ICIs 与 PPIs 联用导致不良反应报告率显著增加的流行病学证据。\"\n            }\n          ],\n          \"conditions_and_limits\": \"PPI 及类固醇证据多为观察性关联，存在适应症偏倚（如胃病患者基线健康状况差）。需区分药物直接免疫抑制与微生物组介导效应。\"\n        },\n        {\n          \"thread_title\": \"证据天花板、异质性与方法学局限\",\n          \"argument\": \"当前临床证据受限于观察性设计、小样本干预试验及缺乏标准化。肿瘤类型、检测方法及人群特征导致结果高度异质性，无 III 期 RCT 证实生存获益是领域确认现状。\",\n          \"evidence_mapping\": [\n            {\n              \"source_handle\": \"P0501\",\n              \"role\": \"领域评估\",\n              \"detail\": \"文献计量分析指出缺乏 RCT 及阴性结果发表偏倚，揭示当前研究过度依赖观察性数据。\"\n            },\n            {\n              \"source_handle\": \"P0534\",\n              \"role\": \"方法学批判\",\n              \"detail\": \"定性综述提出从分类学向功能/生态系统范式转变，批判现有证据的小样本及混杂因素局限。\"\n            },\n            {\n              \"source_handle\": \"P0327\",\n              \"role\": \"阴性证据\",\n              \"detail\": \"NSCLC 患者中基线微生物组成与 ICI 反应无显著关联的阴性结果，提示可能需要更复杂模型或动态监测。\"\n            },\n            {\n              \"source_handle\": \"P0301\",\n              \"role\": \"癌种特异性\",\n              \"detail\": \"HCC 背景下微生物组与 ICI 疗效无显著关联的阴性证据，指出肝硬化导致的背景菌群失调可能干扰预测标志物普适性。\"\n            },\n            {\n              \"source_handle\": \"P0524\",\n              \"role\": \"临床认知\",\n              \"detail\": \"调查显示 61% 肿瘤医生认为调节菌群可增加 ICI 疗效，但将疗效预测列为首要未满足需求，反映证据缺口。\"\n            },\n            {\n              \"source_handle\": \"P0355\",\n              \"role\": \"状态综述\",\n              \"detail\": \"状态综述指出黑色素瘤数据过多而其他肿瘤证据不足，强调当前证据等级多为观察性或早期试验。\"\n            }\n          ],\n          \"conditions_and_limits\": \"明确陈述 III 期 RCT 缺失为确认的领域限制，非检索不足。阴性结果（如 HCC, NSCLC 部分研究）需作为异质性证据保留，不强行解释为阳性。\"\n        }\n      ],\n      \"transition_logic\": \"本章确立了微生物调节 ICI 疗效的临床关联强度（抗生素强关联，FMT 早期信号）及证据天花板（无 III 期 RCT）。然而，关联背后的具体微生物特征（哪些菌？哪些代谢物？）尚不明确，且观察性数据无法解释因果机制。下一章（CH02）将深入识别与反应或耐药相关的特定微生物特征（菌分类群与代谢物），为本章观察到的临床现象提供生物学标记物基础。\",\n      \"directed_reads\": [\n        \"在陈述抗生素效应时，必须使用‘关联（associated with）’而非‘导致（causes）’，并明确标注回顾性研究设计及潜在混杂因素（如感染严重程度）。\",\n        \"关于 FMT 疗效，需明确区分 I/II 期试验的 ORR 数据与 III 期生存数据（缺失）的差距，不可将早期信号表述为确证疗效。\",\n        \"整合研究条件（如肿瘤类型、ICI 方案、抗生素时机）进入正文论述，例如‘在 NSCLC 中...而在黑色素瘤中...'，避免脱离条件的效果排名。\",\n        \"引用 Tool Material 确认的‘无完成 III 期 RCT'事实，将其作为本章结论的证据天花板，而非临时缺口。\",\n        \"处理阴性结果（如 P0275, P0301, P0327）时，将其作为异质性证据，说明微生物效应的情境依赖性，而非证据失效。\"\n      ],\n      \"supplement_requests\": []\n    }\n  ],\n  \"screened_sources\": [\n    {\n      \"source_handle\": \"P0030\",\n      \"reason\": \"仅为试验方案，无结果数据。\"\n    },\n    {\n      \"source_handle\": \"P0138\",\n      \"reason\": \"聚焦 ACT/TILs 治疗，非 ICI 核心主题。\"\n    },\n    {\n      \"source_handle\": \"P0226\",\n      \"reason\": \"聚焦放疗联合 ICI，无微生物组数据。\"\n    },\n    {\n      \"source_handle\": \"P0256\",\n      \"reason\": \"无微生物组数据，仅疾病背景。\"\n    },\n    {\n      \"source_handle\": \"P0259\",\n      \"reason\": \"仅报告毒性发生率，无微生物组关联。\"\n    },\n    {\n      \"source_handle\": \"P0340\",\n      \"reason\": \"聚焦联合治疗，无微生物组数据。\"\n    },\n    {\n      \"source_handle\": \"P0344\",\n      \"reason\": \"无微生物组数据，仅疗效异质性背景。\"\n    },\n    {\n      \"source_handle\": \"P0405\",\n      \"reason\": \"无微生物组数据，仅毒性背景。\"\n    },\n    {\n      \"source_handle\": \"P0508\",\n      \"reason\": \"结果缺失。\"\n    },\n    {\n      \"source_handle\": \"P0558\",\n      \"reason\": \"聚焦给药时间，无微生物组数据。\"\n    }\n  ]\n}",
        "reasoning_content": "The user wants a chapter proposal for Chapter 1 (CH01) of a review on \"How does the gut microbiome modulate the efficacy of immune checkpoint inhibitors in solid tumours, and what mechanisms mediate that effect?\".\nThe specific task is to generate the `chapter_proposals` for CH01 based on the provided `source_routing` and `shared_level1_outline`.\nI need to follow the specific constraints:\n1.  **Role**: Academic Review Planning Editor.\n2.  **Output**: JSON only.\n3.  **Language**: Chinese (for planning content), keep original titles/names.\n4.  **Content**:\n    *   Develop a substantive proposal for CH01.\n    *   Include `chapter_id`, `title`, `purpose`, `scope`, `substantive_threads`, `supplement_requests`, `directed_reads`.\n    *   Handle `excluded_source_handles` if necessary (with reasons).\n    *   Ensure the proposal reflects the \"evidence ceiling\" (no Phase III RCTs) as per the `scope_adjustment`.\n    *   Use the `source_routing` ledger to select relevant sources (do not discard routed sources unless genuinely out of scope).\n    *   Distinguish between association and causation, observation and intervention.\n    *   Preserve source metadata (source_handle).\n    *   Do not write a Q&A list.\n    *   Focus on argument structure, research differences, connections, and valuable gaps.\n    *   Correct any overclaims from the L1 outline based on routed evidence.\n    *   Ensure conditions (study type, population, setting) are integrated into the substantive points, not just in a limitation field.\n\n**Chapter 1 Focus**: \"Clinical Evidence Landscape: Antibiotic Timing, FMT Trials, and Observational Data\".\n**Key Arguments**:\n1.  Antibiotic exposure (especially post-ICI initiation) is associated with worse survival (Observational).\n2.  FMT shows promise in early trials (Phase I/II) but lacks Phase III confirmation and has safety signals (Interventional).\n3.  Other drug interactions (PPIs, steroids) confound or modulate effects.\n4.  Heterogeneity across tumor types (e.g., Melanoma/NSCLC vs. others) and study designs limits generalizability.\n5.  **Crucial Constraint**: Explicitly state the lack of completed Phase III RCTs as a confirmed field status, not a temporary gap.\n\n**Source Selection**:\nI need to pick sources from the `source_routing` list that are assigned to CH01 (or CH01+others).\nKey sources for CH01 based on routing:\n*   P0003 (Breast cancer, small sample)\n*   P0007 (Retrospective, ABX/PPI/Steroids)\n*   P0008 (Pediatric, limited evidence)\n*   P0012 (TKI vs ICI, ABX)\n*   P0014 (A. muciniphila, clinical + mice)\n*   P0016 (Opioids)\n*   P0022 (CRC review)\n*   P0023 (Melanoma review)\n*   P0025 (ADC+ICI meta)\n*   P0030 (HCC trial protocol)\n*   P0031 (Viewpoint)\n*   P0035 (mUC, real-world)\n*   P0036 (Narrative review)\n*   P0039 (Meta-analysis ABX/FMT)\n*   P0044 (Chemo+ICI review)\n*   P0052 (NSCLC Meta-analysis ABX)\n*   P0053 (NSCLC, chemo combo)\n*   P0060 (Melanoma adjuvant)\n*   P0061 (Retrospective ABX duration)\n*   P0068 (Meta-analysis ABX)\n*   P0069 (CRC resistance)\n*   P0074 (Review causality)\n*   P0078 (Review practice-changing)\n*   P0081 (Meta-analysis drug effects)\n*   P0088 (PPI pharmacovigilance)\n*   P0089 (Pancreatic review)\n*   P0090 (mRCC review)\n*   P0094 (Hyperprogression)\n*   P0100 (ABX timing)\n*   P0107 (ABX + Steroids)\n*   P0108 (PPI review)\n*   P0121 (HCC cohort)\n*   P0123 (NSCLC signatures)\n*   P0127 (Pancreatic MSI)\n*   P0129 (Systematic review)\n*   P0131 (Narrative review)\n*   P0133 (Biomarkers review)\n*   P0134 (Fluctuations)\n*   P0135 (PPI Meta-analysis)\n*   P0136 (Review immune system)\n*   P0138 (ACT therapy)\n*   P0146 (Review shapes response)\n*   P0148 (KRAS NSCLC)\n*   P0150 (Review personalized)\n*   P0153 (PEG bowel prep)\n*   P0155 (Diet NSCLC)\n*   P0157 (Review resistance)\n*   P0159 (Skin cancer meta)\n*   P0164 (HCC review)\n*   P0167 (QoL meta)\n*   P0168 (PDAC review)\n*   P0169 (Biomarkers revie