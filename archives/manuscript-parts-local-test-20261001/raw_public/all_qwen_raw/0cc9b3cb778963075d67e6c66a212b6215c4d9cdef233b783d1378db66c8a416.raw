  "choices": [
    {
      "message": {
        "content": "```json\n{\n  \"shared_outline\": {\n    \"review_argument\": \"肠道微生物群通过免疫调节和代谢信号通路调节实体瘤 ICI 疗效，但临床证据仍限于观察性关联和早期干预试验。抗生素在 ICI 启动后 60 天内使用与死亡率增加显著相关（HR 1.27），提示存在关键时间窗口；FMT 在 II 期试验中显示高 ORR（NSCLC 80%，黑色素瘤 75%），但伴随方案依赖性毒性风险。机制上，肌苷通过抑制肿瘤细胞 UBA6 增强免疫原性，但人体肿瘤微环境绝对浓度数据缺失，现有证据为血浆分层关联及 UBA6 蛋白表达代理。关键限制在于：无完成 III 期 RCT 证实生存获益；代谢物浓度量化不足；干预方案缺乏标准化。临床转化需谨慎抗生素使用，优先开展 III 期随机试验并建立标准化生物标志物。\",\n    \"chapter_sequence\": [\n      \"CH01\",\n      \"CH02\",\n      \"CH03\",\n      \"CH04\",\n      \"CH05\"\n    ],\n    \"concept_definitions\": {\n      \"实体瘤\": \"排除血液系统恶性肿瘤，除非机制见解可直接转移至实体瘤通路\",\n      \"临床证据等级\": \"观察性关联（抗生素暴露）与干预性数据（FMT）需明确区分讨论\",\n      \"机制证据物种\": \"小鼠模型因果证据与人类观察性关联需明确标注物种差异\",\n      \"代谢物浓度\": \"血浆分层关联（高/低按中位数）不等同于肿瘤微环境绝对浓度（μM, ng/mL）\"\n    },\n    \"transition_logic\": \"CH01 确立临床关联强度与证据天花板→CH02 识别具体微生物特征→CH03 阐明分子机制→CH04 评估干预可行性→CH05 综合局限性与转化方向，形成从现象到机制到应用的完整论证链\"\n  },\n  \"chapters\": [\n    {\n      \"chapter_id\": \"CH01\",\n      \"title\": \"临床证据格局：抗生素时机、FMT 试验与观察性数据\",\n      \"coordinated_scope\": \"评估微生物扰动与 ICI 结局关联的临床证据强度，明确 III 期 RCT 缺失的现状。涵盖抗生素暴露时序依赖性（ICI 启动后 60 天内 HR 1.27）、FMT II 期试验 ORR 数据（NSCLC 80%，黑色素瘤 75%）、伴随用药（PPI/类固醇）混杂效应。明确陈述截至 2025 年末无完成的大型 III 期 RCT 证实生存获益为领域确认现状，非检索失败。排除纯临床前机制研究及非 ICI 治疗数据。\",\n      \"boundary_with_CH02\": \"CH01 聚焦临床结局关联（OS/PFS/ORR），CH02 聚焦微生物分类群与代谢物特征识别\",\n      \"boundary_with_CH04\": \"CH01 陈述 FMT 试验结果作为证据现状，CH04 深入评估干预可行性、安全性与标准化挑战\",\n      \"primary_sources\": [\n        \"P0575\",\n        \"P0100\",\n        \"P0052\",\n        \"P0583\",\n        \"P0577\",\n        \"P0039\",\n        \"P0135\",\n        \"P0007\"\n      ],\n      \"excluded_sources\": [\n        \"P0030\",\n        \"P0138\",\n        \"P0226\",\n        \"P0256\",\n        \"P0259\",\n        \"P0340\",\n        \"P0344\",\n        \"P0405\",\n        \"P0508\",\n        \"P0558\"\n      ],\n      \"evidence_ceiling_statement\": \"经补充检索确认（CorpusId:285298099），截至 2025 年末无完成的大型 III 期 RCT 证实微生物干预在 ICI 治疗实体瘤患者中的可重复生存获益，此为本章结论的证据天花板，非临时缺口\"\n    },\n    {\n      \"chapter_id\": \"CH02\",\n      \"title\": \"微生物特征：预测 ICI 反应的菌分类群与代谢物\",\n      \"coordinated_scope\": \"识别与反应或耐药相关的特定微生物特征，标注浓度数据的局限性。涵盖人类临床队列中的肠道微生物组特征（菌属/种、功能通路、代谢物），重点包括黑色素瘤、NSCLC、RCC、CRC 等实体瘤。明确标注肌苷与 SCFA 的人体肿瘤微环境绝对浓度数据缺失现状（现有数据为血浆分层关联及 UBA6 蛋白表达代理）。排除非 ICI 治疗、非人类及非肠道微生物组作为主要预测因子的研究。\",\n      \"boundary_with_CH01\": \"CH02 聚焦微生物特征识别，CH01 聚焦临床结局关联\",\n      \"boundary_with_CH03\": \"CH02 陈述微生物 - 临床结局关联，CH03 深入分子机制通路（免疫细胞、代谢物受体、屏障功能）\",\n      \"primary_sources\": [\n        \"P0582\",\n        \"P0092\",\n        \"P0002\",\n        \"P0478\",\n        \"P0545\",\n        \"P0298\",\n        \"P0437\",\n        \"P0204\",\n        \"P0569\",\n        \"P0182\"\n      ],\n      \"excluded_sources\": [\n        \"P0095\",\n        \"P0492\",\n        \"P0283\",\n        \"P0530\"\n      ],\n      \"concentration_limit_statement\": \"肌苷浓度数据为中位数分层而非绝对值（μM, ng/mL）；人体肿瘤组织内肌苷未直接测量；SCFA 在人体 TME 中的浓度及局部效应数据缺失\"\n    },\n    {\n      \"chapter_id\": \"CH03\",\n      \"title\": \"机制通路：免疫、代谢与屏障功能的分子中介\",\n      \"coordinated_scope\": \"阐明介导微生物群 -ICI 相互作用的生物机制，区分小鼠与人类证据，明确代谢物浓度数据的局限性。涵盖免疫细胞调节（DC、T 细胞、Treg/Th17）、微生物代谢物信号（肌苷、SCFA、色氨酸、胆汁酸）、肠道屏障与细菌易位。重点标注机制证据的物种来源（小鼠 vs 人类）及肿瘤类型特异性。排除纯临床结局统计而无机制探讨的研究。\",\n      \"boundary_with_CH02\": \"CH03 深入分子机制通路，CH02 聚焦微生物特征与临床结局关联\",\n      \"boundary_with_CH04\": \"CH03 阐述生物学机制，CH04 评估基于机制的干预策略临床可行性\",\n      \"primary_sources\": [\n        \"P0582\",\n        \"P0092\",\n        \"P0223\",\n        \"P0195\",\n        \"P0196\",\n        \"P0220\",\n        \"P0559\",\n        \"P0014\",\n        \"P0023\",\n        \"P0114\",\n        \"P0166\",\n        \"P0590\"\n      ],\n      \"excluded_sources\": [],\n      \"species_limit_statement\": \"机制证据主要来自小鼠模型（B16, 4T1, MC38）；人体验证限于 UBA6 蛋白表达关联（n=22）；需明确标注物种差异和肿瘤类型特异性（UBA6 表达水平决定肌苷疗效）\"\n    },\n    {\n      \"chapter_id\": \"CH04\",\n      \"title\": \"治疗干预：FMT、益生菌与饮食的临床可行性\",\n      \"coordinated_scope\": \"评估微生物干预在临床实践中可靠增强 ICI 疗效的可行性，平衡疗效信号与安全性风险及异质性挑战。涵盖实体瘤患者中微生物干预的人类临床数据（I/II 期试验为主），包括粪菌移植（FMT）、定义菌群/单菌株制剂（LBPs）、饮食及代谢物补充。明确区分一线增强与耐药逆转场景。排除纯临床前工程菌研究（除非已进入早期临床），排除仅关注血液系统恶性肿瘤且无实体瘤机制迁移证据的研究。\",\n      \"boundary_with_CH01\": \"CH04 深入评估干预可行性、安全性与标准化，CH01 陈述试验结果作为证据现状\",\n      \"boundary_with_CH03\": \"CH04 评估基于机制的干预策略临床转化，CH03 阐述生物学机制\",\n      \"primary_sources\": [\n        \"P0583\",\n        \"P0589\",\n        \"P0577\",\n        \"P0578\",\n        \"P0230\",\n        \"P0039\",\n        \"P0212\",\n        \"P0591\",\n        \"P0401\",\n        \"P0156\",\n        \"P0390\"\n      ],\n      \"excluded_sources\": [],\n      \"safety_limit_statement\": \"所有 FMT 数据为 I/II 期单臂或小型随机试验，样本量小；安全性信号因 ICI 方案（单药 vs 双药）而异，不可泛化毒性风险；无标准化方案\"\n    },\n    {\n      \"chapter_id\": \"CH05\",\n      \"title\": \"局限性、异质性与转化研究方向\",\n      \"coordinated_scope\": \"综合评估当前证据的成熟度，明确方法学挑战、机制不确定性及临床转化障碍，为未来研究优先级提供依据。涵盖 III 期 RCT 缺失的现状确认（呼应 CH01）、观察性与干预性证据的等级差异、微生物组研究的方法学异质性、代谢物量化的技术缺口、干预策略的安全性与标准化挑战，以及宿主混杂因素的控制需求。排除将临床前机制直接外推为临床事实的过度断言。\",\n      \"boundary_with_CH01\": \"CH05 综合全篇证据局限性，CH01 已确认 III 期 RCT 缺失为领域现状，CH05 不将其作为新发现重复陈述\",\n      \"boundary_with_CH02_CH03_CH04\": \"CH05 批判性综合前文证据缺口，不重复具体机制或干预细节\",\n      \"primary_sources\": [\n        \"P0501\",\n        \"P0578\",\n        \"P0583\",\n        \"P0589\",\n        \"P0591\",\n        \"P0001\",\n        \"P0355\",\n        \"P0478\",\n        \"P0545\",\n        \"P0364\"\n      ],\n      \"excluded_sources\": [\n        \"P0020\",\n        \"P0024\",\n        \"P0048\",\n        \"P0051\",\n        \"P0099\",\n        \"P0184\",\n        \"P0199\",\n        \"P0302\",\n        \"P0315\",\n        \"P0340\",\n        \"P0344\",\n        \"P0371\",\n        \"P0373\",\n        \"P0378\",\n        \"P0404\",\n        \"P0405\",\n        \"P0410\",\n        \"P0411\",\n        \"P0421\",\n        \"P0426\",\n        \"P0429\",\n        \"P0440\",\n        \"P0441\",\n        \"P0453\",\n        \"P0461\",\n        \"P0465\",\n        \"P0467\",\n        \"P0480\",\n        \"P0488\",\n        \"P0491\",\n        \"P0492\",\n        \"P0508\",\n        \"P0519\",\n        \"P0527\",\n        \"P0528\",\n        \"P0531\",\n        \"P0538\",\n        \"P0551\",\n        \"P0558\",\n        \"P0579\",\n        \"P0580\",\n        \"P0581\"\n      ],\n      \"gap_prioritization_statement\": \"III 期 RCT 缺失为确认的领域限制，非检索不足；需优先搜索补充数据以获取肌苷绝对浓度；强调观察性关联与因果机制的区分\"\n    }\n  ],\n  \"supplement_requests\": [\n    {\n      \"gap_id\": \"case_E_phase3_rct\",\n      \"question\": \"是否有最新发布的 III 期随机对照试验（2024-2025）证实微生物干预在实体瘤 ICI 治疗中的生存获益？\",\n      \"rationale\": \"L1 outline 及多来源（P0355, P0586）确认无完成 III 期 RCT，但需确保检索截至 2025 年末无遗漏，以维持结论准确性。补充检索确认 III 期 RCT 缺失为领域现状而非检索失败，CH01 需明确陈述此证据天花板，不将其表述为临时缺口。\",\n      \"priority\": \"high\",\n      \"known_papers\": [\n        \"CorpusId:285298099\"\n      ],\n      \"assigned_chapters\": [\n        \"CH01\",\n        \"CH05\"\n      ],\n      \"status\": \"unmet\",\n      \"judgment_note\": \"经三次补充检索确认，截至 2025 年末无完成的大型 III 期 RCT 证实微生物干预在 ICI 治疗实体瘤患者中的可重复生存获益。现有证据限于 I/II 期试验和荟萃分析。此确认为领域现状，非检索不足。\"\n    },\n    {\n      \"gap_id\": \"case_C2_inosine_tme\",\n      \"question\": \"是否有研究直接测量了接受 ICI 治疗的实体瘤患者肿瘤组织微环境（TME）内的肌苷或 SCFA 绝对浓度（μM, ng/mL），并与临床结局（ORR, PFS）进行了统计关联？\",\n      \"rationale\": \"现有材料（如 CheckMate 025 分析）仅提供血浆肌苷分层数据，缺乏 TME 局部浓度及绝对定量值，限制了机制转化的精确性。肌苷浓度数据为高/低分层（中位数划分），非绝对浓度（μM, ng/mL）；人体肿瘤组织内肌苷测量缺失，UBA6 蛋白表达作为代理标志物。\",\n      \"priority\": \"high\",\n      \"known_papers\": [\n        \"CorpusId:252309032\"\n      ],\n      \"assigned_chapters\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"status\": \"partial\",\n      \"judgment_note\": \"经三次补充检索，确认人体 TME 内肌苷和 SCFA 的绝对定量浓度数据缺失。现有数据为血浆分层（高/低按中位数）及 UBA6 蛋白表达代理（n=22）。P0591 提供外源性肌苷联合 ICI 的 II 期 RCT 数据（PFS 7.00 vs 4.40 个月），但未测量内源性浓度。\"\n    },\n    {\n      \"gap_id\": \"case_C2_serum_tissue_metabolite\",\n      \"question\": \"是否存在配对的血清 - 肿瘤组织代谢组学研究，能够建立系统循环水平与肿瘤局部微环境代谢物浓度的关联？\",\n      \"rationale\": \"用于评估血浆生物标志物是否能准确反映肿瘤微环境内的免疫调节状态。\",\n      \"priority\": \"medium\",\n      \"known_papers\": [],\n      \"assigned_chapters\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"status\": \"unmet\",\n      \"judgment_note\": \"未找到匹配研究，但不等于该研究不存在。未被满足的需求只约束本次可写的结论范围，不得升级为领域层面的缺失判断。\"\n    },\n    {\n      \"gap_id\": \"case_C4_fmt_os_data\",\n      \"question\": \"FMT-LUMINate 试验的最终总生存期（OS）数据是否已公布？\",\n      \"rationale\": \"现有材料仅提供 ORR 和 PFS/安全性信号，OS 数据对于评估临床获益至关重要。\",\n      \"priority\": \"medium\",\n      \"known_papers\": [\n        \"P0583\",\n        \"P0589\"\n      ],\n      \"assigned_chapters\": [\n        \"CH04\"\n      ],\n      \"status\": \"unmet\",\n      \"judgment_note\": \"现有材料仅提供 ORR（NSCLC 80%，黑色素瘤 75%）和安全性数据（黑色素瘤双 ICI 组 65%≥3 级 irAE），OS 数据未公布。\"\n    },\n    {\n      \"gap_id\": \"case_C4_lbp_phase2_data\",\n      \"question\": \"是否有针对特定菌株（如 CBM588, MRx0518）的 II 期以上疗效数据更新？\",\n      \"rationale\": \"现有材料多为 I 期或摘要级数据，需确认是否有更高级别证据支持其疗效主张。\",\n      \"priority\": \"medium\",\n      \"known_papers\": [\n        \"P0230\",\n        \"P0244\",\n        \"P0006\",\n        \"P0143\"\n      ],\n      \"assigned_chapters\": [\n        \"CH04\"\n      ],\n      \"status\": \"unmet\",\n      \"judgment_note\": \"现有材料多为 I 期或摘要级数据，无 II 期以上疗效数据更新。\"\n    }\n  ],\n  \"directed_reads\": [\n    {\n      \"source_handle\": \"P0575\",\n      \"paper_title\": \"Antibiotic Timing and Survival After Immune Checkpoint Inhibitor Initiation in Patients With Cancer\",\n      \"assigned_chapters\": [\n        \"CH01\"\n      ],\n      \"reading_focus\": \"重点阅读多中心队列（n=21,108）中 ICI 后 60 天内抗生素暴露使死亡风险增加 27%（HR 1.27）的定量数据，以及肿瘤类型亚组分析（头颈癌、RCC、乳腺癌显著，肺癌、黑色素瘤不显著）。明确标注研究为回顾性观察性设计，存在适应症偏倚。\",\n      \"interpretation_limits\": [\n        \"所有抗生素证据均为观察性关联，不能确立因果关系\",\n        \"需明确标注研究多为回顾性，存在适应症偏倚（病情重者更易用抗生素）\",\n        \"肿瘤类型异质性（如黑色素瘤 vs 头颈癌）需具体陈述，不可泛化\"\n      ]\n    },\n    {\n      \"source_handle\": \"P0582\",\n      \"paper_title\": \"Inhibition of UBA6 by inosine augments tumour immunogenicity and responses\",\n      \"assigned_chapters\": [\n        \"CH02\",\n        \"CH03\"\n      ],\n      \"reading_focus\": \"重点阅读 CheckMate 025 队列代谢组学分析（n=394 nivolumab）中血浆肌苷分层关联数据（高/低按中位数，非绝对浓度），以及人类肿瘤组织 UBA6 蛋白表达作为肌苷效应代理的具体验证方法（n=22）及局限性。\",\n      \"interpretation_limits\": [\n        \"肌苷浓度数据为中位数分层而非绝对值（μM, ng/mL）\",\n        \"人体肿瘤组织内肌苷未直接测量，UBA6 蛋白表达作为代理标志物\",\n        \"机制证据主要来自小鼠模型，人体验证限于 UBA6 蛋白表达关联\"\n      ]\n    },\n    {\n      \"source_handle\": \"P0583\",\n      \"paper_title\": \"Fecal microbiota transplantation plus immunotherapy in non-small cell lung cancer and melanoma: the phase 2 FMT-LUMINate trial\",\n      \"assigned_chapters\": [\n        \"CH01\",\n        \"CH04\"\n      ],\n      \"reading_focus\": \"关注 NSCLC 队列（ORR 80%）与黑色素瘤队列（ORR 75%）的 ORR 数据差异，以及黑色素瘤双 ICI 组 65% 发生≥3 级 irAE 的安全性信号。重点阅读其提出的'有害病原体清除而非供体菌定植'的新机制框架，作为 FMT 机制的传统观点挑战。\",\n      \"interpretation_limits\": [\n        \"所有 FMT 数据为 I/II 期单臂或小型随机试验，样本量小\",\n        \"安全性信号因 ICI 方案（单药 vs 双药）而异，不可泛化毒性风险\",\n        \"NSCLC 数据来自 PD-L1 高表达人群；黑色素瘤数据来自双免疫检查点抑制剂背景\"\n      ]\n    },\n    {\n      \"source_handle\": \"P0591\",\n      \"paper_title\": \"Inosine enhances the efficacy of immune‐checkpoint inhibitors in advanced solid tumors: A randomized, controlled, Phase 2 study\",\n      \"assigned_chapters\": [\n        \"CH03\",\n        \"CH04\"\n      ],\n      \"reading_focus\": \"确认外源性肌苷联合 ICI 的临床 PFS 数据（7.00 vs 4.40 个月）及亚组分析（肺癌亚组获益更强），作为代谢干预的人体证据。注意其为单中心 II 期 RCT，OS 无显著差异。\",\n      \"interpretation_limits\": [\n        \"单中心试验，OS 无显著差异，需多中心 III 期验证\",\n        \"肌苷来源包括饮食/内源性，非特异性菌群产物\",\n        \"机制描述主要基于文献，本研究未提供直接的分子或免疫学机制证据\"\n      ]\n    },\n    {\n      \"source_handle\": \"P0590\",\n      \"paper_title\": \"Gut-associated checkpoint as a prognostic biomarker in metastatic renal cell carcinoma (mRCC): Results from a randomized first-line clinical trial.\",\n      \"assigned_chapters\": [\n        \"CH03\"\n      ],\n      \"reading_focus\": \"重点阅读 sMAdCAM-1 与 PFS/OS 关联的统计细节及非线性关系描述，作为屏障标志物的人体证据。注意其为 JAVELIN Renal 101 试验的生物标志物分析，非微生物干预试验。\",\n      \"interpretation_limits\": [\n        \"sMAdCAM-1 作为分层标志物需在独立队列中验证；当前验证队列样本量小\",\n        \"非线性关系的存在意味着简单的二分法（高/低）可能丢失部分信息\",\n        \"验证正在进行中，因此目前证据等级限于单中心/单试验内部验证\"\n      ]\n    }\n  ],\n  \"harmonization_notes\": {\n    \"scope_boundaries\": [\n      \"CH01 与 CH04 关于 FMT 数据的分工：CH01 陈述 FMT-LUMINate 等 II 期试验的 ORR 数据作为临床证据格局的一部分，CH04 深入评估 FMT 的干预可行性、安全性（方案依赖性毒性）、标准化挑战及供体筛选问题\",\n      \"CH02 与 CH03 关于代谢物的分工：CH02 陈述肌苷、SCFA 与临床结局的关联（血浆分层），CH03 深入分子机制（UBA6 抑制、HDAC 抑制、受体信号），并明确标注人体 TME 绝对浓度数据缺失\",\n      \"CH01 与 CH05 关于 III 期 RCT 缺失的分工：CH01 明确陈述截至 2025 年末无完成的大型 III 期 RCT 为领域确认现状（基于 CorpusId:285298099），CH05 综合全篇证据局限性时不将其作为新发现重复陈述，而是聚焦方法学异质性、代谢物量化缺口、干预标准化挑战等其他局限\"\n    ],\n    \"source_assignment_principles\": [\n      \"优先人类临床数据用于疗效主张；临床前数据主要用于机制解释\",\n      \"排除仅关注血液系统恶性肿瘤的研究，除非机制见解明确链接至实体瘤通路\",\n      \"标注缺乏临床混杂因素调整（如感染严重程度、体能状态）的抗生素效应研究\",\n      \"区分观察性关联（抗生素）与干预性数据（FMT）讨论疗效\",\n      \"明确标注物种差异（小鼠 vs 人类）和肿瘤类型特异性（如黑色素瘤 vs NSCLC）于所有机制主张\",\n      \"不泛化代谢物效应（如丁酸盐）而不指定背景（ICI 类型、浓度、肿瘤类型）\"\n    ],\n    \"supplement_consolidation\": [\n      \"合并三次 case_E_phase3_rct 补充检索结果为单一高优先级缺口，确认 III 期 RCT 缺失为领域现状而非检索失败\",\n      \"合并三次 case_C2_inosine_tme 补充检索结果为单一高优先级缺口，确认人体 TME 绝对浓度数据缺失，现有数据为血浆分层及 UBA6 蛋白表达代理\",\n      \"保留 case_C2_serum_tissue_metabolite、case_C4_fmt_os_data、case_C4_lbp_phase2_data 为中优先级缺口，明确未被满足的需求只约束本次可写的结论范围，不得升级为领域层面的缺失判断\"\n    ],\n    \"directed_read_assignment\": [\n      \"P0575（抗生素时机）分配至 CH01，聚焦临床证据格局中的时序依赖性\",\n      \"P0582（肌苷/UBA6）分配至 CH02/CH03，聚焦微生物特征与机制通路的衔接\",\n      \"P0583（FMT-LUMINate）分配至 CH01/CH04，CH01 陈述 ORR 数据，CH04 评估干预可行性与安全性\",\n      \"P0591（肌苷 II 期 RCT）分配至 CH03/CH04，CH03 阐述代谢干预机制，CH04 评估临床转化\",\n      \"P0590（sMAdCAM-1）分配至 CH03，聚焦屏障功能机制的人体证据\"\n    ],\n    \"contradiction_resolution\": [\n      \"关于黑色素瘤对抗生素的敏感性：P0575 显示黑色素瘤 HR 1.07（无统计学意义），与 P0547 系统综述指出的黑色素瘤中无显著关联一致，CH01 需明确陈述肿瘤类型异质性，不可泛化抗生素效应\",\n      \"关于 FMT 疗效：P0583 显示高 ORR（NSCLC 80%，黑色素瘤 75%），但 P0578（MITRIC 试验）显示 OR