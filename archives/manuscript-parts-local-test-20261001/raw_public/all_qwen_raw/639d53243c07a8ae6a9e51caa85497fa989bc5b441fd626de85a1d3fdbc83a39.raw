      "message": {
        "content": "{\n  \"chapter_proposals\": [\n    {\n      \"chapter_id\": \"CH02\",\n      \"title\": \"微生物特征：预测 ICI 反应的菌分类群与代谢物\",\n      \"purpose\": \"综合实体瘤 ICI 治疗中与健康/疾病状态相关的微生物分类学特征及代谢物证据，区分观察性关联与因果机制，明确浓度数据的分层局限性与组织微环境测量的缺失。\",\n      \"scope\": \"涵盖人类临床队列（观察性与干预性基线）中的肠道微生物组特征（菌属/种、功能通路、代谢物），重点包括黑色素瘤、NSCLC、RCC、CRC 等实体瘤。排除非 ICI 治疗（如单纯化疗/靶向）、非人类（如犬类）及非肠道微生物组（如纯口腔/瘤内且无肠道关联）作为主要预测因子的研究。明确标注肌苷与 SCFA 的人体肿瘤微环境绝对浓度数据缺失现状。\",\n      \"excluded_source_handles\": [\n        \"P0095\",\n        \"P0492\",\n        \"P0283\",\n        \"P0530\"\n      ],\n      \"substantive_threads\": [\n        {\n          \"thread_title\": \"分类学标志物的异质性与“功能趋同”假说\",\n          \"argument\": \"尽管特定菌属（如*Akkermansia*, *Faecalibacterium*, *Bifidobacterium*）在多个队列中与响应正相关，但跨研究重复性低，受地域、饮食及测序方法影响显著。证据支持从“单一物种标签”转向“功能通路稳定性”的视角，即不同菌群可能通过收敛的代谢功能（如 SCFA 合成、核苷酸代谢）调节免疫。\",\n          \"evidence_handles\": [\n            \"P0002\",\n            \"P0478\",\n            \"P0545\",\n            \"P0298\",\n            \"P0364\",\n            \"P0420\",\n            \"P0496\"\n          ],\n          \"limits\": \"多数发现基于 16S rRNA 测序，种/株水平分辨率不足；跨队列验证常因批次效应失败；关联不等于因果驱动。\"\n        },\n        {\n          \"thread_title\": \"代谢物介导的免疫调节与浓度数据局限\",\n          \"argument\": \"微生物代谢物（肌苷、SCFA、胆汁酸）是连接菌群与宿主免疫的关键中介。然而，人体证据多为血浆分层关联（如 CheckMate 025 中肌苷高/低分层），缺乏肿瘤微环境（TME）内的绝对定量浓度（μM, ng/mL）。肌苷通过抑制肿瘤细胞 UBA6 增强免疫原性的机制在人体中仅通过 UBA6 蛋白表达代理验证，SCFA 在人体 TME 中的浓度及局部效应数据缺失。\",\n          \"evidence_handles\": [\n            \"P0582\",\n            \"P0092\",\n            \"P0223\",\n            \"P0326\",\n            \"P0424\",\n            \"P0503\",\n            \"P0559\"\n          ],\n          \"limits\": \"肌苷浓度数据为中位数分层而非绝对值；人体肿瘤组织内肌苷未直接测量；SCFA 效应具有双向性（取决于 ICI 类型及浓度）；多数机制证据源自小鼠模型。\"\n        },\n        {\n          \"thread_title\": \"功能基因组与多组学整合的预测优势\",\n          \"argument\": \"相比静态分类学丰度，微生物功能基因（如氮代谢、ABC 转运蛋白）及多组学特征（菌群 + 代谢物 + 宿主免疫）显示出更稳健的跨癌种预测能力。机器学习模型整合微生物特征与传统标志物（TMB, PD-L1）可提高预测精度，但需警惕过拟合及缺乏外部验证。\",\n          \"evidence_handles\": [\n            \"P0437\",\n            \"P0097\",\n            \"P0204\",\n            \"P0393\",\n            \"P0111\",\n            \"P0050\"\n          ],\n          \"limits\": \"功能预测多基于宏基因组推断（如 PICRUSt），非实际转录/蛋白活性；模型多在回顾性队列开发，前瞻性验证不足。\"\n        },\n        {\n          \"thread_title\": \"临床情境与宿主因素的修饰作用\",\n          \"argument\": \"微生物标志物的预测价值受肿瘤类型（如黑色素瘤 vs. NSCLC）、治疗阶段（新辅助 vs. 晚期）、既往治疗（抗生素、PPI、化疗）及宿主因素（年龄、饮食）显著修饰。例如，新辅助治疗中低多样性可能预示更好反应，与晚期治疗相反；抗生素暴露可消除 PPI 的负面影响。\",\n          \"evidence_handles\": [\n            \"P0569\",\n            \"P0181\",\n            \"P0155\",\n            \"P0537\",\n            \"P0205\",\n            \"P0270\",\n            \"P0585\"\n          ],\n          \"limits\": \"亚组分析样本量常较小；混杂因素（如感染严重程度）难以完全控制；不同研究对“响应者”定义不一致。\"\n        }\n      ],\n      \"supplement_requests\": [\n        {\n          \"question\": \"是否有研究直接测量了接受 ICI 治疗的实体瘤患者肿瘤组织微环境（TME）内的肌苷或 SCFA 绝对浓度（μM, ng/mg），并与临床结局（ORR, PFS）进行了统计关联？\",\n          \"rationale\": \"现有材料（如 CheckMate 025 分析）仅提供血浆肌苷分层数据，缺乏 TME 局部浓度及绝对定量值，限制了机制转化的精确性。\",\n          \"priority\": \"high\"\n        },\n        {\n          \"question\": \"是否存在配对的血清 - 肿瘤组织代谢组学研究，能够建立系统循环水平与肿瘤局部微环境代谢物浓度的关联？\",\n          \"rationale\": \"用于评估血浆生物标志物是否能准确反映肿瘤微环境内的免疫调节状态。\",\n          \"priority\": \"medium\"\n        }\n      ],\n      \"directed_reads\": [\n        \"P0582\",\n        \"P0092\",\n        \"P0204\",\n        \"P0424\",\n        \"P0569\",\n        \"P0585\"\n      ]\n    }\n  ],\n  \"screened_sources\": [\n    {\n      \"source_handle\": \"P0095\",\n      \"reason\": \"研究对象为口腔微生物组，治疗方法为新辅助化疗/放化疗而非 ICI，不符合“肠道微生物组调节实体瘤 ICI 疗效”的核心范围，仅可作为机制类比但非直接证据。\"\n    },\n    {\n      \"source_handle\": \"P0492\",\n      \"reason\": \"研究对象为犬癌症，治疗手段为抗 EGFR/HER2 免疫疫苗而非人类 ICI，物种与治疗类型差异过大，不可直接外推。\"\n    },\n    {\n      \"source_handle\": \"P0283\",\n      \"reason\": \"研究对象为肺癌化疗/靶向治疗队列，未涉及免疫检查点抑制剂（ICI），虽涉及微生物代谢物但治疗背景不符。\"\n    },\n    {\n      \"source_handle\": \"P0530\",\n      \"reason\": \"主要聚焦于免疫治疗神经系统毒性（n-irAEs）的生物标志物，明确指出无特定微生物签名与 n-irAEs 直接相关，对 CH02 疗效预测主题贡献有限。\"\n    }\n  ]\n}",
