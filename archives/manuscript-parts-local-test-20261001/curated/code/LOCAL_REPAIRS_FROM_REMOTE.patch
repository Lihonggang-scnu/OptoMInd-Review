+    invalid["owner_status"] = "updated"
+    invalid["response"] = {"status": "updated", "updated_plan": {
+        "units": [{"unit_id": "U01", "cases": [{"source_handle": "P0615"}]}],
+    }}
+    assert planning._reuse_cached_owner_revision(invalid, cached["cache_inputs"]) is None
