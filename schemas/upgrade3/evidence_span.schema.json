{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optomind.upgrade3.evidence_span.v1",
  "title": "EVIDENCE_SPAN",
  "type": "object",
  "required": [
    "schema_version",
    "envelope",
    "span_id",
    "paper_id",
    "document_id",
    "chunk_id",
    "char_start",
    "char_end",
    "quote",
    "quote_sha256",
    "section",
    "pdf_page",
    "parser_version",
    "source_path",
    "source_sha256",
    "checked_at",
    "version_id",
    "source_provenance",
    "pdf_page_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "optomind.upgrade3.evidence_span.v1"
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "span_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "quote_sha256": {
      "$ref": "#/$defs/hash"
    },
    "section": {
      "type": "string"
    },
    "pdf_page": {
      "type": "integer",
      "minimum": 1
    },
    "pdf_page_kind": {
      "const": "physical"
    },
    "logical_page": {
      "type": "integer",
      "minimum": 1
    },
    "logical_page_source": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/hash"
    },
    "canonical_text_hash": {
      "$ref": "#/$defs/hash"
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "source_provenance": {
      "$ref": "#/$defs/source_provenance"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "envelope": {
      "type": "object",
      "required": [
        "run_id",
        "generation_id",
        "attempt_id",
        "artifact_id",
        "producer",
        "parent_artifact_hashes",
        "created_at",
        "content_sha256",
        "policy_sha256",
        "prompt_manifest_hash",
        "model_manifest_hash",
        "material_snapshot_hash"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "parent_artifact_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        },
        "content_sha256": {
          "$ref": "#/$defs/hash"
        },
        "policy_sha256": {
          "$ref": "#/$defs/hash"
        },
        "prompt_manifest_hash": {
          "type": "string",
          "minLength": 1
        },
        "model_manifest_hash": {
          "type": "string",
          "minLength": 1
        },
        "material_snapshot_hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": true
    },
    "source_provenance": {
      "type": "object",
      "required": [
        "document_id",
        "version_id",
        "raw_sha256",
        "canonical_text_sha256",
        "parser",
        "source_path"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_text_sha256": {
          "$ref": "#/$defs/hash"
        },
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "notes": "pdf bbox可空但必须有不可歧义页与字符定位",
  "x_producer_consumer": true
}
