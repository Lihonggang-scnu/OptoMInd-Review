{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "optomind.upgrade3.manuscript_manifest.v1",
 "title": "MANUSCRIPT_MANIFEST",
 "type": "object",
 "required": [
  "schema_version",
  "envelope",
  "manifest_id",
  "generation_id",
  "sections",
  "abstract",
  "citations",
  "figures",
  "compile",
  "translation",
  "visual"
 ],
 "properties": {
  "schema_version": {
   "const": "optomind.upgrade3.manuscript_manifest.v1"
  },
  "envelope": {
   "type": "object",
   "required": [
    "run_id",
    "generation_id",
    "attempt_id",
    "artifact_id",
    "producer",
    "created_at",
    "content_sha256",
    "policy_sha256",
    "prompt_manifest_hash",
    "model_manifest_hash",
    "material_snapshot_hash"
   ],
   "properties": {
    "run_id": {
     "type": "string"
    },
    "generation_id": {
     "type": "string"
    },
    "attempt_id": {
     "type": "string"
    },
    "artifact_id": {
     "type": "string"
    },
    "producer": {
     "type": "string"
    },
    "created_at": {
     "type": "string"
    },
    "content_sha256": {
     "type": "string"
    },
    "policy_sha256": {
     "type": "string"
    },
    "prompt_manifest_hash": {
     "type": "string"
    },
    "model_manifest_hash": {
     "type": "string"
    },
    "material_snapshot_hash": {
     "type": "string"
    }
   }
  },
  "compile": {
   "enum": [
    "not_started",
    "failed",
    "compiled"
   ]
  },
  "translation": {
   "enum": [
    "not_requested",
    "not_run",
    "passed",
    "degraded",
    "failed"
   ]
  },
  "visual": {
   "enum": [
    "not_requested",
    "not_run",
    "passed",
    "degraded",
    "failed"
   ]
  }
 },
 "notes": "section id唯一",
 "x_producer_consumer": true
}