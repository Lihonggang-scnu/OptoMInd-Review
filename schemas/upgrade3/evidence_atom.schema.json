{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optomind.upgrade3.evidence_atom.v1",
  "title": "EVIDENCE_ATOM",
  "type": "object",
  "required": [
    "schema_version",
    "envelope",
    "atom_id",
    "span",
    "experiment",
    "field",
    "role_provenance",
    "permission_receipt",
    "permission_ceiling",
    "source_resolution_status",
    "claim_input_status",
    "source_provenance",
    "authorable",
    "binding_required",
    "permission_receipt_interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "optomind.upgrade3.evidence_atom.v1"
    },
    "atom_id": {
      "type": "string",
      "pattern": "^atom_[0-9a-f]{24}$"
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "span": {
      "$ref": "#/$defs/evidence_span"
    },
    "source_provenance": {
      "$ref": "#/$defs/source_provenance"
    },
    "experiment": {
      "type": "object",
      "required": [
        "experiment_id",
        "sim_or_experiment",
        "experiment_level"
      ],
      "properties": {
        "experiment_id": {
          "type": "string"
        },
        "sim_or_experiment": {
          "enum": [
            "simulation",
            "experiment",
            "not_reported"
          ]
        },
        "experiment_level": {
          "enum": [
            "material_device",
            "full_system",
            "not_reported"
          ]
        }
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "status",
        "value",
        "source_value",
        "extracted_value",
        "value_binding_status",
        "anchor_quote",
        "condition_ids",
        "condition_atom_ids"
      ],
      "properties": {
        "name": {
          "enum": [
            "method",
            "results",
            "conditions",
            "limitations"
          ]
        },
        "status": {
          "enum": [
            "reported",
            "not_reported",
            "not_applicable",
            "conflicting"
          ]
        },
        "value": {
          "type": "string"
        },
        "source_value": {
          "type": "string",
          "minLength": 1
        },
        "extracted_value": {
          "type": "string",
          "minLength": 1
        },
        "value_binding_status": {
          "enum": [
            "locally_verified",
            "rejected_value_binding"
          ]
        },
        "anchor_quote": {
          "type": "string"
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition_atom_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "role_provenance": {
      "type": "object",
      "required": [
        "paper_id",
        "chunk_id",
        "scope_verdict",
        "source_depth",
        "roles",
        "scope_receipt_hash",
        "scope_receipt_object_sha256",
        "scope_receipt_source",
        "scope_receipt_source_path",
        "scope_receipt_source_sha256",
        "scope_receipt_permission",
        "scope_receipt_source_depth",
        "scope_receipt_paper_id",
        "scope_receipt_chunk_id",
        "domain_contract_hash",
        "domain_contract_object_sha256",
        "domain_contract_source",
        "domain_contract_source_path",
        "domain_contract_source_sha256",
        "owner_text_sha256",
        "owner_kb",
        "owner_kb_path",
        "owner_source_path",
        "owner_source_sha256",
        "owner_object_sha256"
      ],
      "properties": {
        "paper_id": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "scope_verdict": {
          "enum": [
            "direct",
            "adjacent",
            "background",
            "uncertain",
            "out_of_scope"
          ]
        },
        "source_depth": {
          "enum": [
            "metadata",
            "abstract",
            "abstract_claim",
            "structured_snippet",
            "partial_fulltext",
            "fulltext"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "scope_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "scope_receipt_object_sha256": {
          "$ref": "#/$defs/hash"
        },
        "scope_receipt_source": {
          "type": "string",
          "minLength": 1
        },
        "scope_receipt_source_path": {
          "type": "string",
          "minLength": 1
        },
        "scope_receipt_source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "scope_receipt_permission": {
          "type": "string",
          "minLength": 1
        },
        "scope_receipt_source_depth": {
          "type": "string",
          "minLength": 1
        },
        "scope_receipt_paper_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_receipt_chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "domain_contract_hash": {
          "$ref": "#/$defs/hash"
        },
        "domain_contract_object_sha256": {
          "$ref": "#/$defs/hash"
        },
        "domain_contract_source": {
          "type": "string",
          "minLength": 1
        },
        "domain_contract_source_path": {
          "type": "string",
          "minLength": 1
        },
        "domain_contract_source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "owner_text_sha256": {
          "$ref": "#/$defs/hash"
        },
        "owner_kb": {
          "type": "string",
          "minLength": 1
        },
        "owner_kb_path": {
          "type": "string",
          "minLength": 1
        },
        "owner_source_path": {
          "type": "string",
          "minLength": 1
        },
        "owner_source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "owner_object_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": true
    },
    "permission_receipt": {
      "type": "object",
      "required": [
        "effective_permission",
        "source_cap",
        "scope_cap",
        "claim_role_cap",
        "writable"
      ],
      "properties": {
        "effective_permission": {
          "enum": [
            "discovery_only",
            "background_only",
            "reported_only",
            "qualified_support",
            "direct_support"
          ]
        },
        "source_cap": {
          "enum": [
            "discovery_only",
            "background_only",
            "reported_only",
            "qualified_support",
            "direct_support"
          ]
        },
        "scope_cap": {
          "enum": [
            "discovery_only",
            "background_only",
            "reported_only",
            "qualified_support",
            "direct_support"
          ]
        },
        "claim_role_cap": {
          "enum": [
            "discovery_only",
            "background_only",
            "reported_only",
            "qualified_support",
            "direct_support"
          ]
        },
        "writable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "permission_ceiling": {
      "enum": [
        "discovery_only",
        "background_only",
        "reported_only",
        "qualified_support",
        "direct_support"
      ]
    },
    "source_resolution_status": {
      "enum": [
        "current",
        "needs_source",
        "stale",
        "conflict",
        "inventory_only"
      ]
    },
    "claim_input_status": {
      "enum": [
        "eligible_for_claim_audit",
        "inventory_only",
        "needs_source",
        "stale",
        "rejected_scope",
        "rejected_permission",
        "rejected_nonreported",
        "rejected_identity",
        "rejected_unknown_enum",
        "rejected_contract",
        "rejected_value_binding"
      ]
    },
    "authorable": {
      "const": false
    },
    "binding_required": {
      "const": true
    },
    "permission_receipt_interpretation": {
      "const": "claim_audit_ceiling_only"
    }
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "run_id",
        "generation_id",
        "attempt_id",
        "artifact_id",
        "producer",
        "parent_artifact_hashes",
        "created_at",
        "content_sha256",
        "policy_sha256",
        "prompt_manifest_hash",
        "model_manifest_hash",
        "material_snapshot_hash"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "parent_artifact_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "$ref": "#/$defs/hash"
        },
        "policy_sha256": {
          "type": "string",
          "$ref": "#/$defs/hash"
        },
        "prompt_manifest_hash": {
          "type": "string",
          "minLength": 1
        },
        "model_manifest_hash": {
          "type": "string",
          "minLength": 1
        },
        "material_snapshot_hash": {
          "type": "string",
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": true
    },
    "evidence_span": {
      "type": "object",
      "required": [
        "schema_version",
        "envelope",
        "span_id",
        "paper_id",
        "document_id",
        "chunk_id",
        "char_start",
        "char_end",
        "quote",
        "quote_sha256",
        "section",
        "pdf_page",
        "parser_version",
        "source_path",
        "source_sha256",
        "checked_at",
        "version_id",
        "source_provenance",
        "pdf_page_kind"
      ],
      "properties": {
        "schema_version": {
          "const": "optomind.upgrade3.evidence_span.v1"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        },
        "span_id": {
          "type": "string"
        },
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "section": {
          "type": "string"
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "pdf_page_kind": {
          "const": "physical"
        },
        "logical_page": {
          "type": "integer",
          "minimum": 1
        },
        "logical_page_source": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_text_hash": {
          "$ref": "#/$defs/hash"
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "source_provenance": {
          "$ref": "#/$defs/source_provenance"
        },
        "checked_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_provenance": {
      "type": "object",
      "required": [
        "document_id",
        "version_id",
        "raw_sha256",
        "canonical_text_sha256",
        "parser",
        "source_path"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_text_sha256": {
          "$ref": "#/$defs/hash"
        },
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
