{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "post_body_manuscript_parts_plan",
  "description": "A new complete responsibility card generated only after actual BODY. No early-planning inheritance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "abstract",
    "introduction",
    "conclusion"
  ],
  "properties": {
    "context": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "$ref": "#/$defs/part"
    },
    "introduction": {
      "$ref": "#/$defs/part"
    },
    "conclusion": {
      "$ref": "#/$defs/part"
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "focus",
        "boundary",
        "placement",
        "finalize_from"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finalize_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "anchor"
          ],
          "properties": {
            "mode": {
              "enum": [
                "standalone",
                "embedded",
                "distributed"
              ]
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
