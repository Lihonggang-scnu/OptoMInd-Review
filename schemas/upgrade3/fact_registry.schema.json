{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "optomind.upgrade3.fact_registry.v1",
 "title": "FACT_REGISTRY",
 "type": "object",
 "required": [
  "schema_version",
  "envelope",
  "registry_id",
  "facts",
  "audited_count",
  "status"
 ],
 "properties": {
  "schema_version": {
   "const": "optomind.upgrade3.fact_registry.v1"
  },
  "envelope": {
   "type": "object",
   "required": [
    "run_id",
    "generation_id",
    "attempt_id",
    "artifact_id",
    "producer",
    "created_at",
    "content_sha256",
    "policy_sha256",
    "prompt_manifest_hash",
    "model_manifest_hash",
    "material_snapshot_hash"
   ],
   "properties": {
    "run_id": {
     "type": "string"
    },
    "generation_id": {
     "type": "string"
    },
    "attempt_id": {
     "type": "string"
    },
    "artifact_id": {
     "type": "string"
    },
    "producer": {
     "type": "string"
    },
    "created_at": {
     "type": "string"
    },
    "content_sha256": {
     "type": "string"
    },
    "policy_sha256": {
     "type": "string"
    },
    "prompt_manifest_hash": {
     "type": "string"
    },
    "model_manifest_hash": {
     "type": "string"
    },
    "material_snapshot_hash": {
     "type": "string"
    }
   }
  },
  "audited_count": {
   "type": "integer"
  },
  "facts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "fact_id",
     "claim_id",
     "source_span_id",
     "metric",
     "field_status"
    ],
    "props": {
     "field_status": {
      "enum": [
       "reported",
       "not_reported",
       "not_applicable",
       "conflicting"
      ]
     }
    }
   }
  }
 },
 "notes": "合法空集=status+audited_count=0；数字必须带source_span与条件字段",
 "x_producer_consumer": true
}