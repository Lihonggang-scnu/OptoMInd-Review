{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "optomind.upgrade3.stage_receipt.v1",
 "title": "STAGE_RECEIPT",
 "type": "object",
 "required": [
  "schema_version",
  "envelope",
  "receipt_id",
  "stage_id",
  "generation_id",
  "execution",
  "science",
  "stop_reason",
  "consumed_artifact_hashes",
  "cost_micro_cny"
 ],
 "properties": {
  "schema_version": {
   "const": "optomind.upgrade3.stage_receipt.v1"
  },
  "envelope": {
   "type": "object",
   "required": [
    "run_id",
    "generation_id",
    "attempt_id",
    "artifact_id",
    "producer",
    "created_at",
    "content_sha256",
    "policy_sha256",
    "prompt_manifest_hash",
    "model_manifest_hash",
    "material_snapshot_hash"
   ],
   "properties": {
    "run_id": {
     "type": "string"
    },
    "generation_id": {
     "type": "string"
    },
    "attempt_id": {
     "type": "string"
    },
    "artifact_id": {
     "type": "string"
    },
    "producer": {
     "type": "string"
    },
    "created_at": {
     "type": "string"
    },
    "content_sha256": {
     "type": "string"
    },
    "policy_sha256": {
     "type": "string"
    },
    "prompt_manifest_hash": {
     "type": "string"
    },
    "model_manifest_hash": {
     "type": "string"
    },
    "material_snapshot_hash": {
     "type": "string"
    }
   }
  },
  "execution": {
   "enum": [
    "pending",
    "running",
    "waiting",
    "succeeded",
    "failed",
    "cancelled"
   ]
  },
  "science": {
   "enum": [
    "not_evaluated",
    "needs_evidence",
    "revision_required",
    "passed"
   ]
  },
  "stop_reason": {
   "enum": [
    null,
    "transport_error",
    "auth_error",
    "rate_limit",
    "schema_invalid",
    "max_iters",
    "token_limit",
    "budget_exhausted",
    "no_gain",
    "evidence_insufficient",
    "review_unavailable",
    "approval_required"
   ]
  }
 },
 "notes": "succeeded+passed+facts=0矛盾；acceptance failed+admission full矛盾",
 "x_producer_consumer": true
}