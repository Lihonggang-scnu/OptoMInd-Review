{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "optomind.upgrade3.terminal_manifest.v1",
 "title": "TERMINAL_MANIFEST",
 "type": "object",
 "required": [
  "schema_version",
  "envelope",
  "manifest_id",
  "generation_id",
  "code_sha256",
  "policy_sha256",
  "model_manifest_hash",
  "material_snapshot_hash",
  "inputs_sha256",
  "pdf_sha256",
  "delivery_status"
 ],
 "properties": {
  "schema_version": {
   "const": "optomind.upgrade3.terminal_manifest.v1"
  },
  "envelope": {
   "type": "object",
   "required": [
    "run_id",
    "generation_id",
    "attempt_id",
    "artifact_id",
    "producer",
    "created_at",
    "content_sha256",
    "policy_sha256",
    "prompt_manifest_hash",
    "model_manifest_hash",
    "material_snapshot_hash"
   ],
   "properties": {
    "run_id": {
     "type": "string"
    },
    "generation_id": {
     "type": "string"
    },
    "attempt_id": {
     "type": "string"
    },
    "artifact_id": {
     "type": "string"
    },
    "producer": {
     "type": "string"
    },
    "created_at": {
     "type": "string"
    },
    "content_sha256": {
     "type": "string"
    },
    "policy_sha256": {
     "type": "string"
    },
    "prompt_manifest_hash": {
     "type": "string"
    },
    "model_manifest_hash": {
     "type": "string"
    },
    "material_snapshot_hash": {
     "type": "string"
    }
   }
  },
  "delivery_status": {
   "enum": [
    "failed",
    "degraded",
    "passed"
   ]
  }
 },
 "notes": "每generation只允许一次commit；指纹不得为空/unknown",
 "x_producer_consumer": true
}